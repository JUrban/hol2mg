// Per-profile carriers for the multivariate profile (docs/DESIGN.md 24.2): group subtype
// carrier nonemptiness (trivial group on choose_in A (fun _ => True)), needed by
// _literal_typing.mg.  Generated by a one-off script; checked like any hand proof.
Theorem grp_choose_unique : forall A:set, forall P:set -> prop, forall a :e A, P a -> (forall x :e A, P x -> x = a) -> choose_in A P = a.
let A. let P. let a. assume Ha. assume HPa. assume Hu.
claim Hex: exists x :e A, P x. { witness a. apply andI. - exact Ha. - exact HPa. }
claim Hsp: choose_in A P :e A /\ P (choose_in A P). { exact (choose_in_spec A P Hex). }
exact (Hu (choose_in A P) (andEL (choose_in A P :e A) (P (choose_in A P)) Hsp) (andER (choose_in A P :e A) (P (choose_in A P)) Hsp)).
Qed.

Theorem hl_FST_pair2 : forall A B:set, forall a :e A, forall b :e B, hl_FST A B (a,b) = a.
let A. let B. let a. assume Ha. let b. assume Hb.
claim Hab: (a,b) :e A :*: B. { exact (tuple_2_setprod A B a Ha b Hb). }
claim HF: (fun x :e A => if exists y :e B, (a,b) = hl_pair A B x y then 1 else 0) :e 2 :^: A.
{ exact (lam_Pi A (fun _:set => 2) (fun x:set => if exists y :e B, (a,b) = hl_pair A B x y then 1 else 0) (fun x:set => fun H_ : x :e A => If_in_2 (exists y :e B, (a,b) = hl_pair A B x y))). }
claim Hca: exists y :e B, (a,b) = hl_pair A B a y.
{ witness b. apply andI. - exact Hb. - exact (eq_sym_i (hl_pair A B a b) ((a,b)) (hl_pair_ap A B a Ha b Hb)). }
claim HPa: (fun x :e A => if exists y :e B, (a,b) = hl_pair A B x y then 1 else 0) a = 1.
{ exact (eq_trans_i ((fun x :e A => if exists y :e B, (a,b) = hl_pair A B x y then 1 else 0) a) (if exists y :e B, (a,b) = hl_pair A B a y then 1 else 0) 1 (beta A (fun x:set => if exists y :e B, (a,b) = hl_pair A B x y then 1 else 0) a Ha) (If_i_1 (exists y :e B, (a,b) = hl_pair A B a y) 1 0 Hca)). }
claim Hu: forall x :e A, (fun x :e A => if exists y :e B, (a,b) = hl_pair A B x y then 1 else 0) x = 1 -> x = a.
{ let x. assume Hx. assume H1.
  claim Hq: exists y :e B, (a,b) = hl_pair A B x y.
  { exact (iffEL ((if exists y :e B, (a,b) = hl_pair A B x y then 1 else 0) = 1) (exists y :e B, (a,b) = hl_pair A B x y) (If_1_iff (exists y :e B, (a,b) = hl_pair A B x y)) (eq_trans_i (if exists y :e B, (a,b) = hl_pair A B x y then 1 else 0) ((fun x :e A => if exists y :e B, (a,b) = hl_pair A B x y then 1 else 0) x) 1 (eq_sym_i ((fun x :e A => if exists y :e B, (a,b) = hl_pair A B x y then 1 else 0) x) (if exists y :e B, (a,b) = hl_pair A B x y then 1 else 0) (beta A (fun x:set => if exists y :e B, (a,b) = hl_pair A B x y then 1 else 0) x Hx)) H1)). }
  apply Hq. let y. assume Hy0. apply Hy0. assume Hy Heq.
  claim Heq2: (a,b) = (x,y). { exact (eq_trans_i ((a,b)) (hl_pair A B x y) ((x,y)) Heq (hl_pair_ap A B x Hx y Hy)). }
  exact (eq_sym_i a x (eq_trans_i a ((a,b) 0) x (eq_sym_i ((a,b) 0) a (tuple_2_0_eq a b)) (eq_trans_i ((a,b) 0) ((x,y) 0) x (f_equal (fun hl__t:set => hl__t 0) ((a,b)) ((x,y)) Heq2) (tuple_2_0_eq x y)))). }
claim H1: hl_FST A B (a,b) = hl_select A (fun x :e A => if exists y :e B, (a,b) = hl_pair A B x y then 1 else 0). { exact (hl_FST_unfold A B ((a,b)) Hab). }
claim H2: hl_select A (fun x :e A => if exists y :e B, (a,b) = hl_pair A B x y then 1 else 0) = choose_in A (fun x:set => (fun x :e A => if exists y :e B, (a,b) = hl_pair A B x y then 1 else 0) x = 1). { exact (hl_select_eq A (fun x :e A => if exists y :e B, (a,b) = hl_pair A B x y then 1 else 0) HF). }
claim H3: choose_in A (fun x:set => (fun x :e A => if exists y :e B, (a,b) = hl_pair A B x y then 1 else 0) x = 1) = a. { exact (grp_choose_unique A (fun x:set => (fun x :e A => if exists y :e B, (a,b) = hl_pair A B x y then 1 else 0) x = 1) a Ha HPa Hu). }
exact (eq_trans_i (hl_FST A B ((a,b))) (hl_select A (fun x :e A => if exists y :e B, (a,b) = hl_pair A B x y then 1 else 0)) a H1 (eq_trans_i (hl_select A (fun x :e A => if exists y :e B, (a,b) = hl_pair A B x y then 1 else 0)) (choose_in A (fun x:set => (fun x :e A => if exists y :e B, (a,b) = hl_pair A B x y then 1 else 0) x = 1)) a H2 H3)).
Qed.

Theorem hl_SND_pair2 : forall A B:set, forall a :e A, forall b :e B, hl_SND A B (a,b) = b.
let A. let B. let a. assume Ha. let b. assume Hb.
claim Hab: (a,b) :e A :*: B. { exact (tuple_2_setprod A B a Ha b Hb). }
claim HF: (fun y :e B => if exists x :e A, (a,b) = hl_pair A B x y then 1 else 0) :e 2 :^: B.
{ exact (lam_Pi B (fun _:set => 2) (fun y:set => if exists x :e A, (a,b) = hl_pair A B x y then 1 else 0) (fun y:set => fun H_ : y :e B => If_in_2 (exists x :e A, (a,b) = hl_pair A B x y))). }
claim Hca: exists x :e A, (a,b) = hl_pair A B x b.
{ witness a. apply andI. - exact Ha. - exact (eq_sym_i (hl_pair A B a b) ((a,b)) (hl_pair_ap A B a Ha b Hb)). }
claim HPa: (fun y :e B => if exists x :e A, (a,b) = hl_pair A B x y then 1 else 0) b = 1.
{ exact (eq_trans_i ((fun y :e B => if exists x :e A, (a,b) = hl_pair A B x y then 1 else 0) b) (if exists x :e A, (a,b) = hl_pair A B x b then 1 else 0) 1 (beta B (fun y:set => if exists x :e A, (a,b) = hl_pair A B x y then 1 else 0) b Hb) (If_i_1 (exists x :e A, (a,b) = hl_pair A B x b) 1 0 Hca)). }
claim Hu: forall y :e B, (fun y :e B => if exists x :e A, (a,b) = hl_pair A B x y then 1 else 0) y = 1 -> y = b.
{ let y. assume Hy. assume H1.
  claim Hq: exists x :e A, (a,b) = hl_pair A B x y.
  { exact (iffEL ((if exists x :e A, (a,b) = hl_pair A B x y then 1 else 0) = 1) (exists x :e A, (a,b) = hl_pair A B x y) (If_1_iff (exists x :e A, (a,b) = hl_pair A B x y)) (eq_trans_i (if exists x :e A, (a,b) = hl_pair A B x y then 1 else 0) ((fun y :e B => if exists x :e A, (a,b) = hl_pair A B x y then 1 else 0) y) 1 (eq_sym_i ((fun y :e B => if exists x :e A, (a,b) = hl_pair A B x y then 1 else 0) y) (if exists x :e A, (a,b) = hl_pair A B x y then 1 else 0) (beta B (fun y:set => if exists x :e A, (a,b) = hl_pair A B x y then 1 else 0) y Hy)) H1)). }
  apply Hq. let x. assume Hx0. apply Hx0. assume Hx Heq.
  claim Heq2: (a,b) = (x,y). { exact (eq_trans_i ((a,b)) (hl_pair A B x y) ((x,y)) Heq (hl_pair_ap A B x Hx y Hy)). }
  exact (eq_sym_i b y (eq_trans_i b ((a,b) 1) y (eq_sym_i ((a,b) 1) b (tuple_2_1_eq a b)) (eq_trans_i ((a,b) 1) ((x,y) 1) y (f_equal (fun hl__t:set => hl__t 1) ((a,b)) ((x,y)) Heq2) (tuple_2_1_eq x y)))). }
claim H1: hl_SND A B (a,b) = hl_select B (fun y :e B => if exists x :e A, (a,b) = hl_pair A B x y then 1 else 0). { exact (hl_SND_unfold A B ((a,b)) Hab). }
claim H2: hl_select B (fun y :e B => if exists x :e A, (a,b) = hl_pair A B x y then 1 else 0) = choose_in B (fun y:set => (fun y :e B => if exists x :e A, (a,b) = hl_pair A B x y then 1 else 0) y = 1). { exact (hl_select_eq B (fun y :e B => if exists x :e A, (a,b) = hl_pair A B x y then 1 else 0) HF). }
claim H3: choose_in B (fun y:set => (fun y :e B => if exists x :e A, (a,b) = hl_pair A B x y then 1 else 0) y = 1) = b. { exact (grp_choose_unique B (fun y:set => (fun y :e B => if exists x :e A, (a,b) = hl_pair A B x y then 1 else 0) y = 1) b Hb HPa Hu). }
exact (eq_trans_i (hl_SND A B ((a,b))) (hl_select B (fun y :e B => if exists x :e A, (a,b) = hl_pair A B x y then 1 else 0)) b H1 (eq_trans_i (hl_select B (fun y :e B => if exists x :e A, (a,b) = hl_pair A B x y then 1 else 0)) (choose_in B (fun y:set => (fun y :e B => if exists x :e A, (a,b) = hl_pair A B x y then 1 else 0) y = 1)) b H2 H3)).
Qed.

Theorem hl_ty_group_nonempty : forall A:set, A <> Empty -> hl_ty_group A <> Empty.
