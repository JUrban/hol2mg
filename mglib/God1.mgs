Axiom god1_endomorphism_power_kernel_strict_before_terminal_power : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall u : set -> set , forall q :e omega , module_endomorphism K addK mulK E addE smul u -> endomorphism_natural_power K addK mulK E addE smul u q <> (fun x :e E => module_zero E addE) -> endomorphism_natural_power K addK mulK E addE smul u (ordsucc q) = (fun x :e E => module_zero E addE) -> forall i :e ordsucc q , endomorphism_power_kernel K addK mulK E addE smul u i <> endomorphism_power_kernel K addK mulK E addE smul u (ordsucc i).
Axiom god1_basis_tail_endomorphism_pointwise_power_zero : forall K , forall add mul : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall n :e omega , forall b u : set -> set , forall r :e omega , module_basis K add mul E addE smul (ordsucc n) b -> module_endomorphism K add mul E addE smul u -> u (b 0) = module_zero E addE -> (forall y :e E , endomorphism_natural_power K add mul E addE smul u r y = module_zero E addE) -> forall z :e K :^: n , endomorphism_natural_power K add mul (K :^: n) (module_power_addition n add) (module_power_left_scalar n mul) (god1_canonical_matrix_endomorphism K add mul n (matrix_submatrix n n ordsucc ordsucc (endomorphism_coordinate_matrix K add mul E addE smul (ordsucc n) b u))) r z = module_zero (K :^: n) (module_power_addition n add).
Axiom god1_pointwise_power_zero_endomorphism_has_flag_basis : forall n :e omega , forall K , forall add mul : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall a u : set -> set , forall r :e omega , field K add mul -> module_basis K add mul E addE smul n a -> module_endomorphism K add mul E addE smul u -> (forall x :e E , endomorphism_natural_power K add mul E addE smul u r x = module_zero E addE) -> exists b : set -> set , module_basis K add mul E addE smul n b /\ forall j :e n , linear_combination K add mul E addE smul (ordsucc j) b (u (b j)).
Axiom god1_upper_triangular_diagonal_entry_characteristic_root : forall K , forall add mul : set -> set -> set , forall n :e omega , forall A :e square_matrix_ring K n , field K add mul -> upper_triangular_matrix K add n A -> forall j :e n , polynomial_zero K add mul K add mul 1 (matrix_characteristic_polynomial K add mul n A) (fun _ : set => matrix_entry A j j).
Axiom god1_nilpotently_shifted_stable_submodule_dimension_bound : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall n :e omega , forall a u : set -> set , forall F , forall p :e omega , forall b : set -> set , forall lambda :e K , forall r :e omega , field K addK mulK -> module_basis K addK mulK E addE smul n a -> module_endomorphism K addK mulK E addE smul u -> polynomial_splits_over K addK mulK (endomorphism_characteristic_polynomial K addK mulK E addE smul n a u) -> endomorphism_characteristic_polynomial K addK mulK E addE smul n a u <> (fun exponent :e omega :^: 1 => ring_zero K addK) -> submodule K addK mulK E addE smul F -> module_basis K addK mulK F addE smul p b -> (forall x :e F , u x :e F) -> (forall x :e F , endomorphism_natural_power K addK mulK E addE smul (endomorphism_shift K addK mulK E addE smul u lambda) r x = module_zero E addE) -> p c= polynomial_root_multiplicity K addK mulK (endomorphism_characteristic_polynomial K addK mulK E addE smul n a u) lambda.
