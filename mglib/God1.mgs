Axiom god1_endomorphism_shift_reconstruction : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall u : set -> set , forall lambda :e K , forall x :e E , left_module K addK mulK E addE smul -> module_endomorphism K addK mulK E addE smul u -> addE (endomorphism_shift K addK mulK E addE smul u lambda x) (smul lambda x) = u x.
Axiom god1_block_chain_basis_gives_jordan_coordinate_matrix : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall n r :e omega , forall sizes :e omega :^: r , forall lambda :e K :^: r , forall b u : set -> set , field K addK mulK -> (forall k :e r , 0 :e sizes k) -> ring_finite_sum omega add_SNo r (fun k => sizes k) = n -> module_basis K addK mulK E addE smul n b -> module_endomorphism K addK mulK E addE smul u -> (forall k :e r , forall j :e sizes k , u (b (add_nat (natural_indexed_sum k (fun h => sizes h)) j)) = addE (if 0 :e j then b (add_nat (natural_indexed_sum k (fun h => sizes h)) (Union j)) else module_zero E addE) (smul (lambda k) (b (add_nat (natural_indexed_sum k (fun h => sizes h)) j)))) -> jordan_canonical_matrix K addK mulK n (endomorphism_coordinate_matrix K addK mulK E addE smul n b u).
Axiom god1_if_same_else_congruence : forall P : prop , forall x y z : set , (P -> x = y) -> (if P then x else z) = (if P then y else z).
Axiom god1_block_chain_basis_gives_jordan_coordinate_matrix_pointwise : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall n r :e omega , forall sizes lambda b u : set -> set , field K addK mulK -> (forall k :e r , sizes k :e omega) -> (forall k :e r , lambda k :e K) -> (forall k :e r , 0 :e sizes k) -> ring_finite_sum omega add_SNo r sizes = n -> module_basis K addK mulK E addE smul n b -> module_endomorphism K addK mulK E addE smul u -> (forall k :e r , forall j :e sizes k , u (b (add_nat (natural_indexed_sum k sizes) j)) = addE (if 0 :e j then b (add_nat (natural_indexed_sum k sizes) (Union j)) else module_zero E addE) (smul (lambda k) (b (add_nat (natural_indexed_sum k sizes) j)))) -> jordan_canonical_matrix K addK mulK n (endomorphism_coordinate_matrix K addK mulK E addE smul n b u).
Axiom god1_dependent_sigma_fiberwise_bijection : forall I , forall J H : set -> set , forall phi : set -> set -> set , (forall i :e I , bij (J i) (H i) (phi i)) -> bij (Sigma_ i :e I , J i) (Sigma_ i :e I , H i) (fun z => (z 0,phi (z 0) (z 1))).
