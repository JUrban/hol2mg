Section form29.
Definition is_max : set -> set -> prop := fun A m => m :e A /\ upper_bound A m.
Definition is_min : set -> set -> prop := fun A m => m :e A /\ lower_bound A m.
Definition has_max : set -> prop := fun A => exists m :e R , is_max A m.
Definition has_min : set -> prop := fun A => exists m :e R , is_min A m.
Definition max : set -> set := fun A => Eps_i (fun m => m :e R /\ is_max A m).
Definition min : set -> set := fun A => Eps_i (fun m => m :e R /\ is_min A m).
Axiom max_spec : forall A , has_max A -> max A :e R /\ is_max A (max A).
Axiom min_spec : forall A , has_min A -> min A :e R /\ is_min A (min A).
Axiom has_lub_of_has_max : forall A , has_max A -> has_lub A.
Axiom has_glb_of_has_min : forall A , has_min A -> has_glb A.
Axiom max_eq_sup : forall A , has_max A -> has_lub A -> max A = sup A.
Axiom min_eq_inf : forall A , has_min A -> has_glb A -> min A = inf A.
End form29.
Section form30.
