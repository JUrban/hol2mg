Axiom god1_endomorphism_finitely_supported_sum_evaluation : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall I , forall F : set -> set , left_module K addK mulK E addE smul -> finite I -> (forall i :e I , F i :e module_endomorphism_ring K addK mulK E addE smul) -> forall x :e E , module_finitely_supported_sum E addE I (fun i => F i x) = ring_finite_sum (module_endomorphism_ring K addK mulK E addE smul) (module_homomorphism_addition E addE) I F x.
Definition god1_complementary_finite_product : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> set -> set := fun K add mul I b i => ring_finite_product K add mul I (fun j => if j = i then ring_one K mul else b j).
