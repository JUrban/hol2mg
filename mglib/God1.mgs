Axiom god1_polynomial_taylor_evaluation_monomial_bounded : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall n :e omega , forall c x y :e K , forall r :e ordsucc n , polynomial_evaluation K add mul K add mul 1 (god1_polynomial_monomial K add 1 c (fun i :e 1 => r)) (fun i => add x y) = polynomial_taylor_evaluation_sum K add mul n x y (god1_polynomial_monomial K add 1 c (fun i :e 1 => r)).
Axiom god1_one_variable_polynomial_evaluation_additive_homomorphism_raw : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall x :e K , group_homomorphism (multivariate_polynomial_ring K add 1) (polynomial_addition K add 1) K add (fun f => polynomial_evaluation K add mul K add mul 1 f (fun i => x)).
Axiom god1_polynomial_taylor_degree_coefficient_monomial : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall f :e multivariate_polynomial_ring K add 1 , forall n :e omega , polynomial_total_degree K add 1 f = n -> forall x y :e K , forall exponent :e omega :^: 1 , polynomial_evaluation K add mul K add mul 1 (god1_polynomial_monomial K add 1 (f exponent) exponent) (fun i => add x y) = polynomial_taylor_evaluation_sum K add mul n x y (god1_polynomial_monomial K add 1 (f exponent) exponent).
Axiom god1_polynomial_taylor_evaluation_of_total_degree : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall f :e multivariate_polynomial_ring K add 1 , forall n :e omega , polynomial_total_degree K add 1 f = n -> forall x y :e K , polynomial_evaluation K add mul K add mul 1 f (fun i => add x y) = polynomial_taylor_evaluation_sum K add mul n x y f.
Axiom god1_polynomial_taylor_coefficient_zero : forall K , forall add mul : set -> set -> set , ring K add mul -> forall f :e multivariate_polynomial_ring K add 1 , polynomial_taylor_coefficient K add f 0 = f.
Axiom god1_polynomial_derived_natural_multiple : forall K , forall add mul : set -> set -> set , ring K add mul -> forall f :e multivariate_polynomial_ring K add 1 , forall m :e omega , polynomial_derived K add (ring_nat_multiple (multivariate_polynomial_ring K add 1) (polynomial_addition K add 1) m f) = ring_nat_multiple (multivariate_polynomial_ring K add 1) (polynomial_addition K add 1) m (polynomial_derived K add f).
Axiom god1_polynomial_taylor_factorial_multiple : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall f :e multivariate_polynomial_ring K add 1 , forall k :e omega , ring_nat_multiple (multivariate_polynomial_ring K add 1) (polynomial_addition K add 1) (factorial k) (polynomial_taylor_coefficient K add f k) = iterated_polynomial_derivative K add f k.
Axiom god1_polynomial_taylor_factorial_identity : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall f :e multivariate_polynomial_ring K add 1 , forall k :e omega , polynomial_multiplication K add mul 1 (polynomial_constant K add mul 1 (ring_nat_multiple K add (factorial k) (ring_one K mul))) (polynomial_taylor_coefficient K add f k) = iterated_polynomial_derivative K add f k.
Axiom god1_s30_theorem4_taylor_formula : forall K , forall add mul : set -> set -> set , forall f :e multivariate_polynomial_ring K add 1 , forall n :e omega , commutative_ring K add mul -> polynomial_total_degree K add 1 f = n -> (forall x y :e K , polynomial_evaluation K add mul K add mul 1 f (fun i => add x y) = ring_finite_sum K add (ordsucc n) (fun k => mul (polynomial_evaluation K add mul K add mul 1 (polynomial_taylor_coefficient K add f k) (fun i => x)) (ring_nat_power K add mul y k))) /\ forall k :e ordsucc n , polynomial_multiplication K add mul 1 (polynomial_constant K add mul 1 (ring_nat_multiple K add (factorial k) (ring_one K mul))) (polynomial_taylor_coefficient K add f k) = iterated_polynomial_derivative K add f k.
Definition field_characteristic : set -> (set -> set -> set) -> (set -> set -> set) -> set := fun K add mul => Eps_i (fun p => p :e omega /\ {r :e int|group_int_power K add (ring_one K mul) r = ring_zero K add} = {mul_SNo p z|z :e int}).
Axiom god1_s7_example8_subgroups_of_integers_interface : forall I , subgroup int add_SNo I -> exists p :e omega , I = {mul_SNo p z|z :e int} /\ forall q :e omega , I = {mul_SNo q z|z :e int} -> q = p.
Axiom god1_group_homomorphism_integer_power : forall G , forall opG : set -> set -> set , forall H , forall opH : set -> set -> set , forall phi : set -> set , group_homomorphism G opG H opH phi -> forall x :e G , forall n :e int , phi (group_int_power G opG x n) = group_int_power H opH (phi x) n.
Axiom god1_ring_integer_scalar_product : forall K , forall add mul : set -> set -> set , ring K add mul -> forall r s :e int , group_int_power K add (ring_one K mul) (mul_SNo r s) = mul (group_int_power K add (ring_one K mul) r) (group_int_power K add (ring_one K mul) s).
Axiom god1_field_characteristic_zero_or_prime_and_scalar_criterion : forall K , forall add mul : set -> set -> set , field K add mul -> (field_characteristic K add mul = 0 \/ prime_nat (field_characteristic K add mul)) /\ forall r :e int , (group_int_power K add (ring_one K mul) r = ring_zero K add <-> exists z :e int , r = mul_SNo (field_characteristic K add mul) z).
Definition polynomial_divides : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> prop := fun K add mul g f => exists q :e multivariate_polynomial_ring K add 1 , f = polynomial_multiplication K add mul 1 g q.
Definition polynomial_root_multiplicity : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set := fun K add mul f a => if f = (fun exponent :e omega :^: 1 => ring_zero K add) then omega else Eps_i (fun r => r :e omega /\ polynomial_divides K add mul (ring_nat_power (multivariate_polynomial_ring K add 1) (polynomial_addition K add 1) (polynomial_multiplication K add mul 1) (polynomial_addition K add 1 (polynomial_indeterminate K add mul 1 0) (ring_negation (multivariate_polynomial_ring K add 1) (polynomial_addition K add 1) (polynomial_constant K add mul 1 a))) r) f /\ forall s :e omega , polynomial_divides K add mul (ring_nat_power (multivariate_polynomial_ring K add 1) (polynomial_addition K add 1) (polynomial_multiplication K add mul 1) (polynomial_addition K add 1 (polynomial_indeterminate K add mul 1 0) (ring_negation (multivariate_polynomial_ring K add 1) (polynomial_addition K add 1) (polynomial_constant K add mul 1 a))) s) f -> s c= r).
Axiom god1_s30_theorem5_root_iff_linear_factor : forall K , forall add mul : set -> set -> set , forall f :e multivariate_polynomial_ring K add 1 , forall a :e K , commutative_ring K add mul -> (polynomial_zero K add mul K add mul 1 f (fun i => a) <-> polynomial_divides K add mul (polynomial_addition K add 1 (polynomial_indeterminate K add mul 1 0) (ring_negation (multivariate_polynomial_ring K add 1) (polynomial_addition K add 1) (polynomial_constant K add mul 1 a))) f).
Definition ring_divides : set -> (set -> set -> set) -> set -> set -> prop := fun K mul d x => d :e K /\ x :e K /\ exists q :e K , x = mul q d.
Definition ideal_generated_by_finite_family : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> set := fun K add mul I x => {y :e K|exists coeff :e K :^: I , y = module_finitely_supported_sum K add I (fun i => mul (coeff i) (x i))}.
Axiom god1_ring_divides_iff_principal_ideal_membership : forall K , forall add mul : set -> set -> set , ring K add mul -> forall d x :e K , (ring_divides K mul d x <-> x :e principal_ideal K add mul d).
Axiom god1_ideal_generated_by_finite_family_equals_regular_span : forall K , forall add mul : set -> set -> set , forall n :e omega , forall x :e K :^: n , ring K add mul -> ideal_generated_by_finite_family K add mul n (fun i => x i) = submodule_generated_by_family K add mul K add mul n (fun i => x i).
Axiom god1_ideal_generated_by_finite_family_is_two_sided_ideal : forall K , forall add mul : set -> set -> set , forall n :e omega , forall x :e K :^: n , commutative_ring K add mul -> two_sided_ideal K add mul (ideal_generated_by_finite_family K add mul n (fun i => x i)).
Axiom god1_ideal_generated_by_finite_family_membership : forall K , forall add mul : set -> set -> set , forall n :e omega , forall x :e K :^: n , forall y :e K , (y :e ideal_generated_by_finite_family K add mul n (fun i => x i) <-> exists coeff :e K :^: n , y = module_finitely_supported_sum K add n (fun i => mul (coeff i) (x i))).
Axiom god1_ideal_generated_by_finite_family_contains_generators : forall K , forall add mul : set -> set -> set , forall n :e omega , forall x :e K :^: n , ring K add mul -> forall i :e n , x i :e ideal_generated_by_finite_family K add mul n (fun j => x j).
Axiom god1_ideal_generated_by_finite_family_is_least_left_ideal : forall K , forall add mul : set -> set -> set , forall n :e omega , forall x :e K :^: n , ring K add mul -> forall J , left_ideal K add mul J -> (forall i :e n , x i :e J) -> ideal_generated_by_finite_family K add mul n (fun i => x i) c= J.
Axiom god1_principal_ideal_contains_generator : forall K , forall add mul : set -> set -> set , ring K add mul -> forall d :e K , d :e principal_ideal K add mul d.
Axiom god1_ring_divides_transitive : forall K , forall add mul : set -> set -> set , ring K add mul -> forall a b c :e K , ring_divides K mul a b -> ring_divides K mul b c -> ring_divides K mul a c.
Definition highest_common_factor : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> set -> prop := fun K add mul I x d => d :e K /\ ideal_generated_by_finite_family K add mul I x = principal_ideal K add mul d.
Axiom god1_highest_common_factor_divisor_characterization : forall K , forall add mul : set -> set -> set , forall n :e omega , forall x :e K :^: n , commutative_ring K add mul -> forall d :e K , highest_common_factor K add mul n (fun i => x i) d -> forall m :e K , ((forall i :e n , ring_divides K mul m (x i)) <-> ring_divides K mul m d).
Axiom god1_hcf_existence_bezout_and_divisor_characterization : forall K , forall add mul : set -> set -> set , forall n :e omega , forall x :e K :^: n , principal_ideal_domain K add mul -> exists d :e K , highest_common_factor K add mul n (fun i => x i) d /\ (exists coeff :e K :^: n , d = module_finitely_supported_sum K add n (fun i => mul (coeff i) (x i))) /\ forall m :e K , ((forall i :e n , ring_divides K mul m (x i)) <-> ring_divides K mul m d).
Definition coprime_family : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> prop := fun K add mul I x => highest_common_factor K add mul I x (ring_one K mul).
Definition coprime_elements : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> prop := fun K add mul x y => coprime_family K add mul 2 (fun i => if i = 0 then x else y).
Axiom god1_principal_ideal_of_unit_is_whole_ring : forall K , forall add mul : set -> set -> set , ring K add mul -> forall d , ring_unit K add mul d -> principal_ideal K add mul d = K.
Axiom god1_ring_unit_iff_divides_one : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall d :e K , (ring_unit K add mul d <-> ring_divides K mul d (ring_one K mul)).
Axiom god1_s31_theorem1_coprime_characterizations : forall K , forall add mul : set -> set -> set , forall n :e omega , forall x :e K :^: n , principal_ideal_domain K add mul -> (coprime_family K add mul n (fun i => x i) <-> forall d :e K , (forall i :e n , ring_divides K mul d (x i)) -> ring_unit K add mul d) /\ ((forall d :e K , (forall i :e n , ring_divides K mul d (x i)) -> ring_unit K add mul d) <-> exists coeff :e K :^: n , module_finitely_supported_sum K add n (fun i => mul (coeff i) (x i)) = ring_one K mul) /\ ((exists coeff :e K :^: n , module_finitely_supported_sum K add n (fun i => mul (coeff i) (x i)) = ring_one K mul) <-> forall y :e K , exists coeff :e K :^: n , module_finitely_supported_sum K add n (fun i => mul (coeff i) (x i)) = y).
Axiom god1_ideal_generated_by_finite_family_family_congr : forall K , forall add mul : set -> set -> set , forall n :e omega , forall x y : set -> set , (forall i :e n , x i = y i) -> ideal_generated_by_finite_family K add mul n x = ideal_generated_by_finite_family K add mul n y.
Axiom god1_coprime_family_family_congr : forall K , forall add mul : set -> set -> set , forall n :e omega , forall x y : set -> set , (forall i :e n , x i = y i) -> (coprime_family K add mul n x <-> coprime_family K add mul n y).
Axiom god1_s31_theorem1_bezout_coprime_interface : forall K , forall add mul : set -> set -> set , forall x y :e K , principal_ideal_domain K add mul -> (coprime_elements K add mul x y <-> exists u v :e K , add (mul u x) (mul v y) = ring_one K mul).
Axiom god1_s31_theorem2_euclid_coprime_divisor_lemma : forall K , forall add mul : set -> set -> set , forall x y d :e K , principal_ideal_domain K add mul -> x <> ring_zero K add -> y <> ring_zero K add -> ring_divides K mul d (mul x y) -> coprime_elements K add mul d x -> ring_divides K mul d y.
Definition least_common_multiple : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> set -> prop := fun K add mul I x m => m :e K /\ {y :e K|forall i :e I , y :e principal_ideal K add mul (x i)} = principal_ideal K add mul m.
Axiom god1_coprime_product_is_lcm_core : forall K , forall add mul : set -> set -> set , forall x y :e K , principal_ideal_domain K add mul -> coprime_elements K add mul x y -> least_common_multiple K add mul 2 (fun i => if i = 0 then x else y) (mul x y).
Axiom god1_two_element_hcf_bezout_coefficients : forall K , forall add mul : set -> set -> set , forall x y d :e K , ring K add mul -> highest_common_factor K add mul 2 (fun i => if i = 0 then x else y) d -> exists u v :e K , add (mul u x) (mul v y) = d.
Axiom god1_hcf_quotients_are_coprime_core : forall K , forall add mul : set -> set -> set , forall x y d xp yp :e K , principal_ideal_domain K add mul -> x <> ring_zero K add -> highest_common_factor K add mul 2 (fun i => if i = 0 then x else y) d -> x = mul xp d -> y = mul yp d -> coprime_elements K add mul xp yp.
Axiom god1_scaled_coprime_product_is_lcm_core : forall K , forall add mul : set -> set -> set , forall x y d xp yp :e K , principal_ideal_domain K add mul -> d <> ring_zero K add -> x = mul xp d -> y = mul yp d -> coprime_elements K add mul xp yp -> least_common_multiple K add mul 2 (fun i => if i = 0 then x else y) (mul (mul xp yp) d).
Axiom god1_two_element_hcf_factorization : forall K , forall add mul : set -> set -> set , forall x y :e K , principal_ideal_domain K add mul -> exists d xp yp :e K , highest_common_factor K add mul 2 (fun i => if i = 0 then x else y) d /\ x = mul xp d /\ y = mul yp d.
Axiom god1_principal_ideal_unit_multiple : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall u d :e K , ring_unit K add mul u -> principal_ideal K add mul (mul u d) = principal_ideal K add mul d.
Axiom god1_s31_theorem3_hcf_lcm_product : forall K , forall add mul : set -> set -> set , forall x y :e K , principal_ideal_domain K add mul -> x <> ring_zero K add -> y <> ring_zero K add -> exists d m :e K , highest_common_factor K add mul 2 (fun i => if i = 0 then x else y) d /\ least_common_multiple K add mul 2 (fun i => if i = 0 then x else y) m /\ mul x y = mul m d.
Axiom god1_s31_lemma1_quotients_by_hcf_are_coprime : forall K , forall add mul : set -> set -> set , forall x y d xp yp :e K , principal_ideal_domain K add mul -> x <> ring_zero K add -> y <> ring_zero K add -> highest_common_factor K add mul 2 (fun i => if i = 0 then x else y) d -> x = mul xp d -> y = mul yp d -> coprime_elements K add mul xp yp.
Axiom god1_s31_lemma2_product_is_lcm_of_coprime_elements : forall K , forall add mul : set -> set -> set , forall x y :e K , principal_ideal_domain K add mul -> coprime_elements K add mul x y -> least_common_multiple K add mul 2 (fun i => if i = 0 then x else y) (mul x y).
Axiom god1_coprime_elements_common_divisor_characterization : forall K , forall add mul : set -> set -> set , forall x y :e K , principal_ideal_domain K add mul -> (coprime_elements K add mul x y <-> forall d :e K , ring_divides K mul d x /\ ring_divides K mul d y -> ring_unit K add mul d).
Axiom god1_coprime_elements_symmetric : forall K , forall add mul : set -> set -> set , forall x y :e K , principal_ideal_domain K add mul -> (coprime_elements K add mul x y <-> coprime_elements K add mul y x).
Axiom god1_coprime_elements_right_product : forall K , forall add mul : set -> set -> set , forall a b c :e K , principal_ideal_domain K add mul -> b <> ring_zero K add -> c <> ring_zero K add -> coprime_elements K add mul a b -> coprime_elements K add mul a c -> coprime_elements K add mul a (mul b c).
Axiom god1_ring_finite_product_nonzero_over_integral_domain : forall K , forall add mul : set -> set -> set , integral_domain K add mul -> forall n :e omega , forall f : set -> set , (forall i :e n , f i :e K) -> (forall i :e n , f i <> ring_zero K add) -> ring_finite_product K add mul n f <> ring_zero K add.
Axiom god1_coprime_elements_finite_product : forall K , forall add mul : set -> set -> set , principal_ideal_domain K add mul -> forall a :e K , forall n :e omega , forall f : set -> set , (forall i :e n , f i :e K) -> (forall i :e n , f i <> ring_zero K add) -> (forall i :e n , coprime_elements K add mul a (f i)) -> coprime_elements K add mul a (ring_finite_product K add mul n f).
Axiom god1_lcm_extend_family_by_coprime_last : forall K , forall add mul : set -> set -> set , forall n :e omega , forall f : set -> set , forall p :e K , f n :e K -> principal_ideal_domain K add mul -> least_common_multiple K add mul n f p -> coprime_elements K add mul p (f n) -> least_common_multiple K add mul (ordsucc n) f (mul p (f n)).
Axiom god1_pairwise_coprime_finite_product_is_lcm_core : forall K , forall add mul : set -> set -> set , forall n :e omega , forall f : set -> set , principal_ideal_domain K add mul -> (forall i :e n , f i :e K) -> (forall i :e n , f i <> ring_zero K add) -> (forall i j :e n , i <> j -> coprime_elements K add mul (f i) (f j)) -> least_common_multiple K add mul n f (ring_finite_product K add mul n f).
Axiom god1_s31_theorem4_pairwise_coprime_product_is_lcm : forall K , forall add mul : set -> set -> set , forall n :e omega , forall x :e K :^: n , principal_ideal_domain K add mul -> (forall i :e n , x i <> ring_zero K add) -> (forall i j :e n , i <> j -> coprime_elements K add mul (x i) (x j)) -> least_common_multiple K add mul n (fun i => x i) (ring_finite_product K add mul n (fun i => x i)).
Axiom god1_commutative_ring_left_ideal_is_two_sided : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall I , left_ideal K add mul I -> two_sided_ideal K add mul I.
Axiom god1_principal_ideal_finitely_generated_module : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall a :e K , finitely_generated_module K add mul (principal_ideal K add mul a) add mul.
Axiom god1_principal_ideal_domain_left_noetherian : forall K , forall add mul : set -> set -> set , principal_ideal_domain K add mul -> left_noetherian_ring K add mul.
Definition extremal_element : set -> (set -> set -> set) -> (set -> set -> set) -> set -> prop := fun K add mul p => p :e K /\ p <> ring_zero K add /\ not (ring_unit K add mul p) /\ forall d :e K , ring_divides K mul d p -> ring_unit K add mul d \/ exists u :e K , ring_unit K add mul u /\ d = mul u p.
Definition factorization_into_extremals : set -> (set -> set -> set) -> (set -> set -> set) -> set -> prop := fun K add mul x => exists n :e omega , exists u :e K , exists p :e K :^: n , ring_unit K add mul u /\ (forall i :e n , extremal_element K add mul (p i)) /\ x = mul u (ring_finite_product K add mul n (fun i => p i)).
Axiom god1_unit_has_factorization_into_extremals : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x :e K , ring_unit K add mul x -> factorization_into_extremals K add mul x.
Axiom god1_factorization_into_extremals_append_extremal : forall K , forall add mul : set -> set -> set , ring K add mul -> forall z q :e K , factorization_into_extremals K add mul z -> extremal_element K add mul q -> factorization_into_extremals K add mul (mul z q).
Axiom god1_extremal_has_factorization_into_extremals : forall K , forall add mul : set -> set -> set , ring K add mul -> forall q :e K , extremal_element K add mul q -> factorization_into_extremals K add mul q.
Axiom god1_factorization_into_extremals_multiply_unit : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall z v :e K , factorization_into_extremals K add mul z -> ring_unit K add mul v -> factorization_into_extremals K add mul (mul z v).
Axiom god1_factorization_into_extremals_product : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall a b :e K , factorization_into_extremals K add mul a -> factorization_into_extremals K add mul b -> factorization_into_extremals K add mul (mul a b).
Axiom god1_nonextremal_nonunit_splits_into_two_nonunits : forall K , forall add mul : set -> set -> set , forall a :e K , principal_ideal_domain K add mul -> a <> ring_zero K add -> not (ring_unit K add mul a) -> not (extremal_element K add mul a) -> exists b c :e K , (a = mul b c /\ (not (ring_unit K add mul b) /\ not (ring_unit K add mul c))) /\ (b <> ring_zero K add /\ c <> ring_zero K add).
Axiom god1_nonunit_cofactor_strictly_enlarges_principal_ideal : forall K , forall add mul : set -> set -> set , integral_domain K add mul -> forall a b c :e K , a = mul b c -> b <> ring_zero K add -> not (ring_unit K add mul c) -> principal_ideal K add mul a c= principal_ideal K add mul b /\ principal_ideal K add mul b <> principal_ideal K add mul a.
Axiom god1_s31_lemma3_maximal_member_interface : forall K , forall add mul : set -> set -> set , forall X , principal_ideal_domain K add mul -> X <> 0 -> (forall I :e X , two_sided_ideal K add mul I) -> exists I :e X , forall J :e X , I c= J -> J = I.
Axiom god1_s31_remark2_pid_maximal_ideal_family_interface : forall K , forall add mul : set -> set -> set , forall X , principal_ideal_domain K add mul -> X <> 0 -> (forall I :e X , two_sided_ideal K add mul I) -> exists I :e X , forall J :e X , I c= J -> J = I.
Definition god1_nonfactorable_principal_ideal_family : set -> (set -> set -> set) -> (set -> set -> set) -> set := fun K add mul => {I :e Power K|exists a :e K , (a <> ring_zero K add /\ not (factorization_into_extremals K add mul a)) /\ I = principal_ideal K add mul a}.
Axiom god1_pid_nonzero_factorization_by_maximal_bad_ideal : forall K , forall add mul : set -> set -> set , forall x :e K , principal_ideal_domain K add mul -> x <> ring_zero K add -> factorization_into_extremals K add mul x.
Axiom god1_s31_theorem5_existence_of_extremal_factorization : forall K , forall add mul : set -> set -> set , forall x :e K , principal_ideal_domain K add mul -> x <> ring_zero K add -> factorization_into_extremals K add mul x.
Axiom god1_s31_lemma3_maximal_member_of_nonempty_ideal_family : forall K , forall add mul : set -> set -> set , forall X , principal_ideal_domain K add mul -> X <> 0 -> (forall I :e X , two_sided_ideal K add mul I) -> exists I :e X , forall J :e X , I c= J -> J = I.
Definition maximal_proper_ideal : set -> (set -> set -> set) -> (set -> set -> set) -> set -> prop := fun K add mul I => two_sided_ideal K add mul I /\ I <> K /\ forall J , two_sided_ideal K add mul J -> I c= J -> J = I \/ J = K.
Axiom god1_equal_nonzero_principal_ideals_give_unit_multiple : forall K , forall add mul : set -> set -> set , integral_domain K add mul -> forall p d :e K , p <> ring_zero K add -> principal_ideal K add mul d = principal_ideal K add mul p -> exists u :e K , ring_unit K add mul u /\ d = mul u p.
Axiom god1_extremal_divisor_condition_iff_maximal_principal_ideal : forall K , forall add mul : set -> set -> set , forall p :e K , principal_ideal_domain K add mul -> p <> ring_zero K add -> not (ring_unit K add mul p) -> ((forall d :e K , ring_divides K mul d p -> ring_unit K add mul d \/ exists u :e K , ring_unit K add mul u /\ d = mul u p) <-> maximal_proper_ideal K add mul (principal_ideal K add mul p)).
Axiom god1_extremal_coprime_or_divides : forall K , forall add mul : set -> set -> set , forall p x :e K , principal_ideal_domain K add mul -> extremal_element K add mul p -> ring_divides K mul p x \/ coprime_elements K add mul p x.
Axiom god1_ring_element_divides_zero : forall K , forall add mul : set -> set -> set , ring K add mul -> forall d :e K , ring_divides K mul d (ring_zero K add).
Axiom god1_extremal_divides_binary_product : forall K , forall add mul : set -> set -> set , forall p x y :e K , principal_ideal_domain K add mul -> extremal_element K add mul p -> ring_divides K mul p (mul x y) -> ring_divides K mul p x \/ ring_divides K mul p y.
Axiom god1_extremal_divides_finite_product : forall K , forall add mul : set -> set -> set , forall p :e K , principal_ideal_domain K add mul -> extremal_element K add mul p -> forall n :e omega , forall f : set -> set , (forall i :e n , f i :e K) -> ring_divides K mul p (ring_finite_product K add mul n f) -> exists i :e n , ring_divides K mul p (f i).
Axiom god1_extremal_unit_multiple : forall K , forall add mul : set -> set -> set , principal_ideal_domain K add mul -> forall q u p :e K , extremal_element K add mul q -> ring_unit K add mul u -> p = mul u q -> extremal_element K add mul p.
Axiom god1_finite_product_prime_property_implies_extremal : forall K , forall add mul : set -> set -> set , forall p :e K , principal_ideal_domain K add mul -> p <> ring_zero K add -> not (ring_unit K add mul p) -> (forall n :e omega , forall x :e K :^: n , ring_divides K mul p (ring_finite_product K add mul n (fun i => x i)) -> exists i :e n , ring_divides K mul p (x i)) -> extremal_element K add mul p.
Axiom god1_s31_theorem6_prime_divisor_interface : forall K , forall add mul : set -> set -> set , forall p :e K , principal_ideal_domain K add mul -> p <> ring_zero K add -> not (ring_unit K add mul p) -> (extremal_element K add mul p <-> forall n :e omega , forall x :e K :^: n , ring_divides K mul p (ring_finite_product K add mul n (fun i => x i)) -> exists i :e n , ring_divides K mul p (x i)).
Axiom god1_s31_theorem6_extremal_characterizations : forall K , forall add mul : set -> set -> set , forall p :e K , principal_ideal_domain K add mul -> p <> ring_zero K add -> not (ring_unit K add mul p) -> (extremal_element K add mul p <-> forall d :e K , ring_divides K mul d p -> ring_unit K add mul d \/ exists u :e K , ring_unit K add mul u /\ d = mul u p) /\ ((forall d :e K , ring_divides K mul d p -> ring_unit K add mul d \/ exists u :e K , ring_unit K add mul u /\ d = mul u p) <-> maximal_proper_ideal K add mul (principal_ideal K add mul p)) /\ (maximal_proper_ideal K add mul (principal_ideal K add mul p) <-> forall n :e omega , forall x :e K :^: n , ring_divides K mul p (ring_finite_product K add mul n (fun i => x i)) -> exists i :e n , ring_divides K mul p (x i)).
Axiom god1_s31_theorem6_corollary_coprime_to_each_factor : forall K , forall add mul : set -> set -> set , forall n :e omega , forall x :e K , forall y :e K :^: n , principal_ideal_domain K add mul -> x <> ring_zero K add -> (forall i :e n , y i <> ring_zero K add) -> (forall i :e n , coprime_elements K add mul x (y i)) -> coprime_elements K add mul x (ring_finite_product K add mul n (fun i => y i)).
Definition associated_elements : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> prop := fun K add mul x y => x :e K /\ y :e K /\ exists u :e K , ring_unit K add mul u /\ y = mul u x.
Axiom god1_extremal_divisor_is_associated : forall K , forall add mul : set -> set -> set , forall p q :e K , principal_ideal_domain K add mul -> extremal_element K add mul p -> extremal_element K add mul q -> ring_divides K mul p q -> associated_elements K add mul p q.
Axiom god1_finite_product_is_divisible_by_each_factor : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall n :e omega , forall f : set -> set , (forall i :e n , f i :e K) -> forall i :e n , ring_divides K mul (f i) (ring_finite_product K add mul n f).
Axiom god1_extremal_factor_matches_factor_of_equal_product : forall K , forall add mul : set -> set -> set , forall m n :e omega , forall p : set -> set , forall q : set -> set , principal_ideal_domain K add mul -> (forall i :e m , p i :e K) -> (forall j :e n , q j :e K) -> (forall i :e m , extremal_element K add mul (p i)) -> (forall j :e n , extremal_element K add mul (q j)) -> ring_finite_product K add mul m p = ring_finite_product K add mul n q -> forall i :e m , exists j :e n , associated_elements K add mul (p i) (q j).
Axiom god1_ring_divides_unit_multiple_iff : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall d u x :e K , ring_unit K add mul u -> (ring_divides K mul d (mul u x) <-> ring_divides K mul d x).
Axiom god1_swap_finite_family_factor_to_last : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall k , nat_p k -> forall j :e ordsucc k , forall q : set -> set , (forall i :e ordsucc k , q i :e K) -> (permutation_swap (ordsucc k) j k :e permutation_group (ordsucc k) /\ ring_finite_product K add mul (ordsucc k) q = ring_finite_product K add mul (ordsucc k) (fun i => q (permutation_swap (ordsucc k) j k i))) /\ q (permutation_swap (ordsucc k) j k k) = q j.
Axiom god1_cancel_associated_last_factors : forall K , forall add mul : set -> set -> set , integral_domain K add mul -> forall P Q p u v :e K , p <> ring_zero K add -> mul P p = mul u (mul Q (mul v p)) -> P = mul (mul u v) Q.
Axiom god1_extremal_finite_product_unit_implies_empty : forall K , forall add mul : set -> set -> set , principal_ideal_domain K add mul -> forall n :e omega , forall f : set -> set , (forall i :e n , f i :e K) -> (forall i :e n , extremal_element K add mul (f i)) -> ring_unit K add mul (ring_finite_product K add mul n f) -> n = 0.
Axiom god1_extremal_factorization_uniqueness_up_to_unit_core : forall K , forall add mul : set -> set -> set , principal_ideal_domain K add mul -> forall m :e omega , forall n :e omega , forall p q : set -> set , (forall i :e m , p i :e K) -> (forall j :e n , q j :e K) -> (forall i :e m , extremal_element K add mul (p i)) -> (forall j :e n , extremal_element K add mul (q j)) -> forall u :e K , ring_unit K add mul u -> ring_finite_product K add mul m p = mul u (ring_finite_product K add mul n q) -> m = n /\ exists sigma :e permutation_group n , forall i :e n , associated_elements K add mul (p i) (q (sigma i)).
Axiom god1_s31_theorem7_uniqueness_of_extremal_factorization : forall K , forall add mul : set -> set -> set , forall x :e K , forall m n :e omega , forall p :e K :^: m , forall q :e K :^: n , principal_ideal_domain K add mul -> x <> ring_zero K add -> not (ring_unit K add mul x) -> (forall i :e m , extremal_element K add mul (p i)) -> (forall j :e n , extremal_element K add mul (q j)) -> x = ring_finite_product K add mul m (fun i => p i) -> x = ring_finite_product K add mul n (fun j => q j) -> m = n /\ exists sigma :e permutation_group n , forall i :e n , associated_elements K add mul (p i) (q (sigma i)).
Axiom god1_extremal_factorization_append_with_fixed_length : forall K , forall add mul : set -> set -> set , ring K add mul -> forall n :e omega , forall u :e K , forall p :e K :^: n , forall q :e K , ring_unit K add mul u -> (forall i :e n , extremal_element K add mul (p i)) -> extremal_element K add mul q -> exists r :e K :^: ordsucc n , (forall i :e ordsucc n , extremal_element K add mul (r i)) /\ mul (mul u (ring_finite_product K add mul n (fun i => p i))) q = mul u (ring_finite_product K add mul (ordsucc n) (fun i => r i)).
Axiom god1_extremal_factorization_append_power_with_length : forall K , forall add mul : set -> set -> set , ring K add mul -> forall n :e omega , forall u :e K , forall p :e K :^: n , forall q :e K , ring_unit K add mul u -> (forall i :e n , extremal_element K add mul (p i)) -> extremal_element K add mul q -> forall s :e omega , exists m :e omega , m = add_nat n s /\ exists r :e K :^: m , (forall i :e m , extremal_element K add mul (r i)) /\ mul (mul u (ring_finite_product K add mul n (fun i => p i))) (ring_nat_power K add mul q s) = mul u (ring_finite_product K add mul m (fun i => r i)).
Axiom god1_unit_extremal_factorization_lengths_equal : forall K , forall add mul : set -> set -> set , principal_ideal_domain K add mul -> forall m n :e omega , forall u v :e K , forall p q : set -> set , (forall i :e m , p i :e K) -> (forall j :e n , q j :e K) -> (forall i :e m , extremal_element K add mul (p i)) -> (forall j :e n , extremal_element K add mul (q j)) -> ring_unit K add mul u -> ring_unit K add mul v -> mul u (ring_finite_product K add mul m p) = mul v (ring_finite_product K add mul n q) -> m = n.
Axiom god1_extremal_power_divisor_bounded_by_factorization_length : forall K , forall add mul : set -> set -> set , forall x p :e K , forall m :e omega , forall u :e K , forall f :e K :^: m , principal_ideal_domain K add mul -> x <> ring_zero K add -> extremal_element K add mul p -> ring_unit K add mul u -> (forall i :e m , extremal_element K add mul (f i)) -> x = mul u (ring_finite_product K add mul m (fun i => f i)) -> forall r :e omega , ring_divides K mul (ring_nat_power K add mul p r) x -> r c= m.
Axiom god1_natural_subset_implies_member_successor : forall r m , nat_p r -> nat_p m -> r c= m -> r :e ordsucc m.
Definition extremal_valuation : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set := fun K add mul p x => if x = ring_zero K add then omega else Eps_i (fun n => n :e omega /\ ring_divides K mul (ring_nat_power K add mul p n) x /\ forall r :e omega , ring_divides K mul (ring_nat_power K add mul p r) x -> r c= n).
Axiom god1_extremal_valuation_specification : forall K , forall add mul : set -> set -> set , forall p x :e K , principal_ideal_domain K add mul -> extremal_element K add mul p -> x <> ring_zero K add -> (extremal_valuation K add mul p x :e omega /\ ring_divides K mul (ring_nat_power K add mul p (extremal_valuation K add mul p x)) x) /\ forall r :e omega , ring_divides K mul (ring_nat_power K add mul p r) x -> r c= extremal_valuation K add mul p x.
Axiom god1_extremal_valuation_monotone_under_divisibility : forall K , forall add mul : set -> set -> set , forall p x y :e K , principal_ideal_domain K add mul -> extremal_element K add mul p -> x <> ring_zero K add -> y <> ring_zero K add -> ring_divides K mul x y -> extremal_valuation K add mul p x c= extremal_valuation K add mul p y.
Axiom god1_cancel_power_from_divided_product_factor : forall K , forall add mul : set -> set -> set , integral_domain K add mul -> forall p a a1 b :e K , forall r :e omega , p <> ring_zero K add -> a = mul a1 p -> ring_divides K mul (ring_nat_power K add mul p (ordsucc r)) (mul a b) -> ring_divides K mul (ring_nat_power K add mul p r) (mul a1 b).
Axiom god1_power_successor_divides_after_restoring_factor : forall K , forall add mul : set -> set -> set , ring K add mul -> forall p z z1 :e K , forall r :e omega , z = mul z1 p -> ring_divides K mul (ring_nat_power K add mul p r) z1 -> ring_divides K mul (ring_nat_power K add mul p (ordsucc r)) z.
Axiom god1_extremal_power_divides_product_split : forall K , forall add mul : set -> set -> set , forall p :e K , principal_ideal_domain K add mul -> extremal_element K add mul p -> forall r :e omega , forall a b :e K , ring_divides K mul (ring_nat_power K add mul p r) (mul a b) -> exists s :e omega , exists t :e omega , (r = add_nat s t /\ ring_divides K mul (ring_nat_power K add mul p s) a) /\ ring_divides K mul (ring_nat_power K add mul p t) b.
Axiom god1_product_of_divisible_extremal_powers : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall p x y :e K , forall s t :e omega , ring_divides K mul (ring_nat_power K add mul p s) x -> ring_divides K mul (ring_nat_power K add mul p t) y -> ring_divides K mul (ring_nat_power K add mul p (add_nat s t)) (mul x y).
Axiom god1_extremal_valuation_product : forall K , forall add mul : set -> set -> set , forall p x y :e K , principal_ideal_domain K add mul -> extremal_element K add mul p -> x <> ring_zero K add -> y <> ring_zero K add -> extremal_valuation K add mul p (mul x y) = add_nat (extremal_valuation K add mul p x) (extremal_valuation K add mul p y).
Axiom god1_natural_add_right_subset_cancel : forall a b c :e omega , add_nat a c c= add_nat b c -> a c= b.
Axiom god1_extremal_valuation_positive_of_divides : forall K , forall add mul : set -> set -> set , forall p x :e K , principal_ideal_domain K add mul -> extremal_element K add mul p -> x <> ring_zero K add -> ring_divides K mul p x -> 1 c= extremal_valuation K add mul p x.
Axiom god1_extremal_divides_of_positive_valuation : forall K , forall add mul : set -> set -> set , forall p x :e K , principal_ideal_domain K add mul -> extremal_element K add mul p -> x <> ring_zero K add -> 1 c= extremal_valuation K add mul p x -> ring_divides K mul p x.
Axiom god1_ring_unit_divides_every_element : forall K , forall add mul : set -> set -> set , ring K add mul -> forall u x :e K , ring_unit K add mul u -> ring_divides K mul u x.
Axiom god1_extremal_valuation_bounds_imply_divisibility : forall K , forall add mul : set -> set -> set , forall x y :e K , principal_ideal_domain K add mul -> x <> ring_zero K add -> y <> ring_zero K add -> (forall p :e K , extremal_element K add mul p -> extremal_valuation K add mul p x c= extremal_valuation K add mul p y) -> ring_divides K mul x y.
Axiom god1_extremal_valuation_divisibility_iff_bounds : forall K , forall add mul : set -> set -> set , forall x y :e K , principal_ideal_domain K add mul -> x <> ring_zero K add -> y <> ring_zero K add -> (ring_divides K mul x y <-> forall p :e K , extremal_element K add mul p -> extremal_valuation K add mul p x c= extremal_valuation K add mul p y).
Axiom god1_s31_lemma4_divisibility_by_extremal_valuations : forall K , forall add mul : set -> set -> set , forall x y :e K , principal_ideal_domain K add mul -> x <> ring_zero K add -> y <> ring_zero K add -> (ring_divides K mul x y <-> forall p :e K , extremal_element K add mul p -> extremal_valuation K add mul p x c= extremal_valuation K add mul p y).
Definition natural_minimum : set -> set -> set := fun n m => if n c= m then n else m.
Definition natural_maximum : set -> set -> set := fun n m => if n c= m then m else n.
Axiom god1_natural_minimum_in_and_bounds : forall a b :e omega , (natural_minimum a b :e omega /\ natural_minimum a b c= a) /\ natural_minimum a b c= b.
Axiom god1_natural_minimum_greatest_lower_bound : forall a b r :e omega , r c= a -> r c= b -> r c= natural_minimum a b.
Axiom god1_natural_maximum_in_and_bounds : forall a b :e omega , (natural_maximum a b :e omega /\ a c= natural_maximum a b) /\ b c= natural_maximum a b.
Axiom god1_natural_maximum_least_upper_bound : forall a b r :e omega , a c= r -> b c= r -> natural_maximum a b c= r.
Axiom god1_natural_minimum_maximum_sum : forall a b :e omega , add_nat a b = add_nat (natural_maximum a b) (natural_minimum a b).
Axiom god1_integral_domain_nonzero_product : forall K , forall add mul : set -> set -> set , integral_domain K add mul -> forall x y :e K , x <> ring_zero K add -> y <> ring_zero K add -> mul x y <> ring_zero K add.
Axiom god1_nonzero_multiple_has_nonzero_divisor : forall K , forall add mul : set -> set -> set , ring K add mul -> forall d x :e K , x <> ring_zero K add -> ring_divides K mul d x -> d <> ring_zero K add.
Axiom god1_principal_ideals_equal_of_mutual_divisibility : forall K , forall add mul : set -> set -> set , ring K add mul -> forall d e :e K , ring_divides K mul d e -> ring_divides K mul e d -> principal_ideal K add mul d = principal_ideal K add mul e.
Axiom god1_mutual_divisibility_of_equal_principal_ideals : forall K , forall add mul : set -> set -> set , ring K add mul -> forall d e :e K , principal_ideal K add mul d = principal_ideal K add mul e -> ring_divides K mul d e /\ ring_divides K mul e d.
Axiom god1_extremal_valuations_equal_of_mutual_divisibility : forall K , forall add mul : set -> set -> set , forall a b :e K , principal_ideal_domain K add mul -> a <> ring_zero K add -> b <> ring_zero K add -> ring_divides K mul a b -> ring_divides K mul b a -> forall p :e K , extremal_element K add mul p -> extremal_valuation K add mul p a = extremal_valuation K add mul p b.
Axiom god1_ring_nat_power_addition : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x :e K , forall r s :e omega , mul (ring_nat_power K add mul x r) (ring_nat_power K add mul x s) = ring_nat_power K add mul x (add_nat r s).
Axiom god1_ring_nat_power_divides_of_exponent_subset : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x :e K , forall r s :e omega , r c= s -> ring_divides K mul (ring_nat_power K add mul x r) (ring_nat_power K add mul x s).
Axiom god1_extremal_valuation_in : forall K , forall add mul : set -> set -> set , forall p x :e K , principal_ideal_domain K add mul -> extremal_element K add mul p -> x <> ring_zero K add -> extremal_valuation K add mul p x :e omega.
Axiom god1_extremal_power_divides_at_most_valuation : forall K , forall add mul : set -> set -> set , forall p x :e K , forall r :e omega , principal_ideal_domain K add mul -> extremal_element K add mul p -> x <> ring_zero K add -> r c= extremal_valuation K add mul p x -> ring_divides K mul (ring_nat_power K add mul p r) x.
Axiom god1_two_element_hcf_extremal_valuation_minimum : forall K , forall add mul : set -> set -> set , forall x y d :e K , principal_ideal_domain K add mul -> x <> ring_zero K add -> y <> ring_zero K add -> highest_common_factor K add mul 2 (fun i => if i = 0 then x else y) d -> d <> ring_zero K add /\ forall p :e K , extremal_element K add mul p -> extremal_valuation K add mul p d = natural_minimum (extremal_valuation K add mul p x) (extremal_valuation K add mul p y).
Axiom god1_two_element_lcm_extremal_valuation_maximum : forall K , forall add mul : set -> set -> set , forall x y m :e K , principal_ideal_domain K add mul -> x <> ring_zero K add -> y <> ring_zero K add -> least_common_multiple K add mul 2 (fun i => if i = 0 then x else y) m -> m <> ring_zero K add /\ forall p :e K , extremal_element K add mul p -> extremal_valuation K add mul p m = natural_maximum (extremal_valuation K add mul p x) (extremal_valuation K add mul p y).
Axiom god1_two_element_hcf_lcm_exists : forall K , forall add mul : set -> set -> set , forall x y :e K , principal_ideal_domain K add mul -> x <> ring_zero K add -> y <> ring_zero K add -> exists d m :e K , highest_common_factor K add mul 2 (fun i => if i = 0 then x else y) d /\ least_common_multiple K add mul 2 (fun i => if i = 0 then x else y) m.
Axiom god1_two_element_hcf_iff_extremal_valuation_minimum : forall K , forall add mul : set -> set -> set , forall x y d :e K , principal_ideal_domain K add mul -> x <> ring_zero K add -> y <> ring_zero K add -> (highest_common_factor K add mul 2 (fun i => if i = 0 then x else y) d <-> d <> ring_zero K add /\ forall p :e K , extremal_element K add mul p -> extremal_valuation K add mul p d = natural_minimum (extremal_valuation K add mul p x) (extremal_valuation K add mul p y)).
Axiom god1_two_element_lcm_iff_extremal_valuation_maximum : forall K , forall add mul : set -> set -> set , forall x y m :e K , principal_ideal_domain K add mul -> x <> ring_zero K add -> y <> ring_zero K add -> (least_common_multiple K add mul 2 (fun i => if i = 0 then x else y) m <-> m <> ring_zero K add /\ forall p :e K , extremal_element K add mul p -> extremal_valuation K add mul p m = natural_maximum (extremal_valuation K add mul p x) (extremal_valuation K add mul p y)).
Axiom god1_common_divisor_iff_extremal_valuation_minimum_bound : forall K , forall add mul : set -> set -> set , forall x y z :e K , principal_ideal_domain K add mul -> x <> ring_zero K add -> y <> ring_zero K add -> z <> ring_zero K add -> ((ring_divides K mul z x /\ ring_divides K mul z y) <-> forall p :e K , extremal_element K add mul p -> extremal_valuation K add mul p z c= natural_minimum (extremal_valuation K add mul p x) (extremal_valuation K add mul p y)).
Axiom god1_hcf_and_lcm_by_extremal_valuations : forall K , forall add mul : set -> set -> set , forall x y d m :e K , principal_ideal_domain K add mul -> x <> ring_zero K add -> y <> ring_zero K add -> (highest_common_factor K add mul 2 (fun i => if i = 0 then x else y) d <-> d <> ring_zero K add /\ forall p :e K , extremal_element K add mul p -> extremal_valuation K add mul p d = natural_minimum (extremal_valuation K add mul p x) (extremal_valuation K add mul p y)) /\ (least_common_multiple K add mul 2 (fun i => if i = 0 then x else y) m <-> m <> ring_zero K add /\ forall p :e K , extremal_element K add mul p -> extremal_valuation K add mul p m = natural_maximum (extremal_valuation K add mul p x) (extremal_valuation K add mul p y)).
Axiom god1_fraction_class_member : forall K , forall add mul : set -> set -> set , forall a b :e K , b <> ring_zero K add -> fraction_class K add mul (a,b) :e fraction_field K add mul.
Axiom god1_module_finitely_supported_sum_natural_successor : forall G , forall op : set -> set -> set , abelian_group G op -> forall n :e omega , forall f : set -> set , (forall i :e ordsucc n , f i :e G) -> module_finitely_supported_sum G op (ordsucc n) f = op (module_finitely_supported_sum G op n f) (f n).
Axiom god1_fraction_two_denominator_bezout_split : forall K , forall add mul : set -> set -> set , integral_domain K add mul -> forall a b1 b2 u v :e K , b1 <> ring_zero K add -> b2 <> ring_zero K add -> add (mul u b2) (mul v b1) = ring_one K mul -> fraction_class K add mul (a,mul b1 b2) = fraction_addition K add mul (fraction_class K add mul (mul a u,b1)) (fraction_class K add mul (mul a v,b2)).
