Section form12.
Definition upper_bound : set -> set -> prop := fun S x => forall s :e S , s <= x.
Definition lower_bound : set -> set -> prop := fun S x => forall s :e S , x <= s.
Definition bounded_above : set -> prop := fun S => exists x :e R , upper_bound S x.
Definition bounded_below : set -> prop := fun S => exists x :e R , lower_bound S x.
Definition bounded : set -> prop := fun S => bounded_above S /\ bounded_below S.
Axiom upper_bound_Subq : forall S T x , T c= S -> upper_bound S x -> upper_bound T x.
Axiom lower_bound_Subq : forall S T x , T c= S -> lower_bound S x -> lower_bound T x.
Axiom bounded_above_Subq : forall S T , T c= S -> bounded_above S -> bounded_above T.
Axiom bounded_below_Subq : forall S T , T c= S -> bounded_below S -> bounded_below T.
Axiom upper_bound_Empty : forall x , upper_bound Empty x.
Axiom lower_bound_Empty : forall x , lower_bound Empty x.
Axiom upper_bound_Sing : forall x :e R , upper_bound {x} x.
Axiom lower_bound_Sing : forall x :e R , lower_bound {x} x.
Axiom bounded_above_Empty : bounded_above Empty.
Axiom bounded_below_Empty : bounded_below Empty.
Axiom bounded_Empty : bounded Empty.
Axiom bounded_above_Sing : forall x :e R , bounded_above {x}.
Axiom bounded_below_Sing : forall x :e R , bounded_below {x}.
Axiom bounded_Sing : forall x :e R , bounded {x}.
Definition nonempty : set -> prop := fun S => exists x , x :e S.
Definition is_lub : set -> set -> prop := fun S x => upper_bound S x /\ forall y :e R , upper_bound S y -> x <= y.
Definition is_glb : set -> set -> prop := fun S x => lower_bound S x /\ forall y :e R , lower_bound S y -> y <= x.
Axiom is_lub_upper_bound : forall S x , is_lub S x -> upper_bound S x.
Axiom is_lub_least : forall S x , is_lub S x -> forall y :e R , upper_bound S y -> x <= y.
Axiom is_glb_lower_bound : forall S x , is_glb S x -> lower_bound S x.
Axiom is_glb_greatest : forall S x , is_glb S x -> forall y :e R , lower_bound S y -> y <= x.
Axiom lub_unique_R : forall S , forall x y :e R , is_lub S x -> is_lub S y -> x = y.
Axiom glb_unique_R : forall S , forall x y :e R , is_glb S x -> is_glb S y -> x = y.
Axiom nonempty_Sing : forall x , nonempty {x}.
Axiom is_lub_Sing : forall x :e R , is_lub {x} x.
Axiom is_glb_Sing : forall x :e R , is_glb {x} x.
End form12.
Section form13.
Definition has_lub : set -> prop := fun S => exists x :e R , is_lub S x.
Definition has_glb : set -> prop := fun S => exists x :e R , is_glb S x.
Definition sup : set -> set := fun S => Eps_i (fun x => x :e R /\ is_lub S x).
Definition inf : set -> set := fun S => Eps_i (fun x => x :e R /\ is_glb S x).
Axiom sup_spec : forall S , has_lub S -> sup S :e R /\ is_lub S (sup S).
Axiom inf_spec : forall S , has_glb S -> inf S :e R /\ is_glb S (inf S).
Axiom has_lub_Sing : forall x :e R , has_lub {x}.
Axiom has_glb_Sing : forall x :e R , has_glb {x}.
Axiom bounded_above_of_is_lub : forall S , forall x :e R , is_lub S x -> bounded_above S.
Axiom bounded_below_of_is_glb : forall S , forall x :e R , is_glb S x -> bounded_below S.
Axiom bounded_above_of_has_lub : forall S , has_lub S -> bounded_above S.
Axiom bounded_below_of_has_glb : forall S , has_glb S -> bounded_below S.
Axiom is_lub_of_mem_upper_bound : forall S , forall x :e R , x :e S -> upper_bound S x -> is_lub S x.
Axiom is_glb_of_mem_lower_bound : forall S , forall x :e R , x :e S -> lower_bound S x -> is_glb S x.
Axiom lub_exists_of_mem_upper_bound : forall S , (exists x :e R , x :e S /\ upper_bound S x) -> exists x :e R , is_lub S x.
Axiom glb_exists_of_mem_lower_bound : forall S , (exists x :e R , x :e S /\ lower_bound S x) -> exists x :e R , is_glb S x.
Definition strict_upper_bound : set -> set -> prop := fun S y => forall s :e S , s < y.
Definition strict_lower_bound : set -> set -> prop := fun S y => forall s :e S , y < s.
Axiom strict_upper_bound_of_upper_bound_not_mem : forall S , S c= R -> forall y :e R , upper_bound S y -> y /:e S -> strict_upper_bound S y.
Axiom strict_lower_bound_of_lower_bound_not_mem : forall S , S c= R -> forall y :e R , lower_bound S y -> y /:e S -> strict_lower_bound S y.
Axiom lub_exists_ext_real : forall S , S c= R -> exists x :e ext_real , is_lub S x.
Axiom lub_exists_R : forall S , S c= R -> nonempty S -> bounded_above S -> exists x :e R , is_lub S x.
Axiom glb_exists_R_of_lub_exists_R : (forall S , S c= R -> nonempty S -> bounded_above S -> exists x :e R , is_lub S x) -> forall S , S c= R -> nonempty S -> bounded_below S -> exists x :e R , is_glb S x.
Axiom glb_exists_R : forall S , S c= R -> nonempty S -> bounded_below S -> exists x :e R , is_glb S x.
End form13.
