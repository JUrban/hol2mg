Definition matrix_row_linear_form : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set -> set -> set := fun K add mul p A i x => ring_finite_sum K add p (fun j => mul (matrix_entry A i j) (x j)).
Definition linear_system_rank : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set -> set := fun K add mul n p A => module_family_rank K add mul (right_module_dual K add mul (K :^: p) (module_power_addition p add) (fun x scalar => module_power_left_scalar p (opposite_ring_multiplication mul) scalar x)) (right_module_dual_addition (K :^: p) add) (right_module_dual_left_scalar (K :^: p) mul) n (fun i => fun x :e K :^: p => matrix_row_linear_form K add mul p A i x).
