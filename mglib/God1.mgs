Axiom god1_permutation_extend_word_letters : forall n , nat_p n -> forall f : set -> set , forall p , (forall i :e p , group_word_letter (permutation_group n) (permutation_composition n) (adjacent_transpositions n) (f i)) -> forall i :e p , group_word_letter (permutation_group (ordsucc n)) (permutation_composition (ordsucc n)) (adjacent_transpositions (ordsucc n)) (permutation_extend_last n (f i)).
Axiom god1_permutation_extend_represented_word : forall n , nat_p n -> forall z , group_word_represented (permutation_group n) (permutation_composition n) (adjacent_transpositions n) z -> group_word_represented (permutation_group (ordsucc n)) (permutation_composition (ordsucc n)) (adjacent_transpositions (ordsucc n)) (permutation_extend_last n z).
Axiom god1_generated_adjacent_words_extend_last : forall n , nat_p n -> forall z :e subgroup_generated_by (permutation_group n) (permutation_composition n) (adjacent_transpositions n) , permutation_extend_last n z :e subgroup_generated_by (permutation_group (ordsucc n)) (permutation_composition (ordsucc n)) (adjacent_transpositions (ordsucc n)).
Axiom god1_adjacent_generated_is_subgroup : forall n , subgroup (permutation_group n) (permutation_composition n) (subgroup_generated_by (permutation_group n) (permutation_composition n) (adjacent_transpositions n)).
Axiom god1_adjacent_generator_in_generated : forall n , forall t :e adjacent_transpositions n , t :e subgroup_generated_by (permutation_group n) (permutation_composition n) (adjacent_transpositions n).
Axiom god1_adjacent_generated_product_closed : forall n , forall x y :e subgroup_generated_by (permutation_group n) (permutation_composition n) (adjacent_transpositions n) , permutation_composition n x y :e subgroup_generated_by (permutation_group n) (permutation_composition n) (adjacent_transpositions n).
Axiom god1_adjacent_generated_inverse_closed : forall n , forall x :e subgroup_generated_by (permutation_group n) (permutation_composition n) (adjacent_transpositions n) , group_inverse (permutation_group n) (permutation_composition n) x :e subgroup_generated_by (permutation_group n) (permutation_composition n) (adjacent_transpositions n).
Axiom god1_group_inverse_left_cancels_product : forall G , forall mul : set -> set -> set , group G mul -> forall r s :e G , mul (group_inverse G mul r) (mul r s) = s.
Definition permutation_last_move : set -> set -> set -> set := fun n m i => permutation_composition (ordsucc n) (permutation_swap (ordsucc n) m (ordsucc m)) (permutation_extend_last n (permutation_swap n i m)).
Axiom god1_predecessor_in_successor_value : forall n m , n = ordsucc m -> m :e n.
Axiom god1_permutation_last_move_in : forall n m i , nat_p n -> nat_p m -> n = ordsucc m -> i :e n -> permutation_last_move n m i :e permutation_group (ordsucc n).
Axiom god1_permutation_last_move_maps_to_last : forall n m i , nat_p n -> nat_p m -> n = ordsucc m -> i :e n -> permutation_last_move n m i i = n.
Axiom god1_permutation_last_move_generated : forall n m i , nat_p n -> nat_p m -> n = ordsucc m -> i :e n -> (forall q :e permutation_group n , q :e subgroup_generated_by (permutation_group n) (permutation_composition n) (adjacent_transpositions n)) -> permutation_last_move n m i :e subgroup_generated_by (permutation_group (ordsucc n)) (permutation_composition (ordsucc n)) (adjacent_transpositions (ordsucc n)).
Axiom god1_permutation_last_move_corrects_last : forall n m i , nat_p n -> nat_p m -> n = ordsucc m -> i :e n -> forall s :e permutation_group (ordsucc n) , s n = i -> permutation_composition (ordsucc n) (permutation_last_move n m i) s n = n.
Axiom god1_symmetric_fixed_last_generated : forall n , nat_p n -> (forall q :e permutation_group n , q :e subgroup_generated_by (permutation_group n) (permutation_composition n) (adjacent_transpositions n)) -> forall s :e permutation_group (ordsucc n) , s n = n -> s :e subgroup_generated_by (permutation_group (ordsucc n)) (permutation_composition (ordsucc n)) (adjacent_transpositions (ordsucc n)).
Axiom god1_symmetric_movable_last_generated : forall n m i , nat_p n -> nat_p m -> n = ordsucc m -> i :e n -> (forall q :e permutation_group n , q :e subgroup_generated_by (permutation_group n) (permutation_composition n) (adjacent_transpositions n)) -> forall s :e permutation_group (ordsucc n) , s n = i -> s :e subgroup_generated_by (permutation_group (ordsucc n)) (permutation_composition (ordsucc n)) (adjacent_transpositions (ordsucc n)).
Axiom god1_permutation_empty_eq_identity : forall s :e permutation_group 0 , s = permutation_identity 0.
Axiom god1_symmetric_generation_zero : forall s :e permutation_group 0 , s :e subgroup_generated_by (permutation_group 0) (permutation_composition 0) (adjacent_transpositions 0).
Axiom god1_symmetric_generation_step : forall n , nat_p n -> (forall q :e permutation_group n , q :e subgroup_generated_by (permutation_group n) (permutation_composition n) (adjacent_transpositions n)) -> forall s :e permutation_group (ordsucc n) , s :e subgroup_generated_by (permutation_group (ordsucc n)) (permutation_composition (ordsucc n)) (adjacent_transpositions (ordsucc n)).
Axiom god1_symmetric_generation_all : forall n , nat_p n -> forall s :e permutation_group n , s :e subgroup_generated_by (permutation_group n) (permutation_composition n) (adjacent_transpositions n).
Axiom god1_symmetric_generated_eq : forall n , nat_p n -> subgroup_generated_by (permutation_group n) (permutation_composition n) (adjacent_transpositions n) = permutation_group n.
Axiom god1_s7_theorem3_symmetric_group_generated_by_transpositions : forall n :e omega , generating_set (permutation_group n) (permutation_composition n) (adjacent_transpositions n).
Definition left_coset : set -> (set -> set -> set) -> set -> set -> set := fun G mul H x => {mul x h|h :e H}.
Definition right_coset : set -> (set -> set -> set) -> set -> set -> set := fun G mul H x => {mul h x|h :e H}.
Definition left_coset_quotient : set -> (set -> set -> set) -> set -> set := fun G mul H => {left_coset G mul H x|x :e G}.
Definition right_coset_quotient : set -> (set -> set -> set) -> set -> set := fun G mul H => {right_coset G mul H x|x :e G}.
Definition left_coset_relation : set -> (set -> set -> set) -> set -> set -> set -> prop := fun G mul H x y => x :e G /\ y :e G /\ mul (group_inverse G mul x) y :e H.
Definition god1_s4_equivalence_relation : set -> (set -> set -> prop) -> prop := fun X R => (forall x :e X , R x x) /\ (forall x y :e X , R x y -> R y x) /\ (forall x y z :e X , R x y -> R y z -> R x z).
Axiom god1_left_coset_relation_intro : forall G , forall mul : set -> set -> set , forall H x y , x :e G -> y :e G -> mul (group_inverse G mul x) y :e H -> left_coset_relation G mul H x y.
Axiom god1_left_coset_relation_left_in : forall G , forall mul : set -> set -> set , forall H x y , left_coset_relation G mul H x y -> x :e G.
Axiom god1_left_coset_relation_right_in : forall G , forall mul : set -> set -> set , forall H x y , left_coset_relation G mul H x y -> y :e G.
Axiom god1_left_coset_relation_difference_in : forall G , forall mul : set -> set -> set , forall H x y , left_coset_relation G mul H x y -> mul (group_inverse G mul x) y :e H.
Axiom god1_group_inverse_difference_reverse : forall G , forall mul : set -> set -> set , group G mul -> forall x y :e G , group_inverse G mul (mul (group_inverse G mul x) y) = mul (group_inverse G mul y) x.
Axiom god1_group_difference_product : forall G , forall mul : set -> set -> set , group G mul -> forall x y z :e G , mul (mul (group_inverse G mul x) y) (mul (group_inverse G mul y) z) = mul (group_inverse G mul x) z.
Axiom god1_left_coset_relation_reflexive : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> forall x :e G , left_coset_relation G mul H x x.
Axiom god1_left_coset_relation_symmetric : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> forall x y :e G , left_coset_relation G mul H x y -> left_coset_relation G mul H y x.
Axiom god1_left_coset_relation_transitive : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> forall x y z :e G , left_coset_relation G mul H x y -> left_coset_relation G mul H y z -> left_coset_relation G mul H x z.
Axiom god1_left_coset_relation_is_equivalence : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> (forall x :e G , left_coset_relation G mul H x x) /\ (forall x y :e G , left_coset_relation G mul H x y -> left_coset_relation G mul H y x) /\ (forall x y z :e G , left_coset_relation G mul H x y -> left_coset_relation G mul H y z -> left_coset_relation G mul H x z).
Axiom god1_group_left_cancel : forall G , forall mul : set -> set -> set , group G mul -> forall x a b :e G , mul x a = mul x b -> a = b.
Axiom god1_left_coset_map_bijective : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> forall x :e G , bij H (left_coset G mul H x) (fun z => mul x z).
Axiom god1_left_cosets_equipotent_to_subgroup : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> forall x :e G , equip H (left_coset G mul H x).
Axiom god1_group_left_reconstruct : forall G , forall mul : set -> set -> set , group G mul -> forall x y :e G , mul x (mul (group_inverse G mul x) y) = y.
Axiom god1_left_coset_member_iff_relation : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> forall x y :e G , (y :e left_coset G mul H x <-> left_coset_relation G mul H x y).
Axiom god1_left_coset_eq_of_relation : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> forall x y :e G , left_coset_relation G mul H x y -> left_coset G mul H x = left_coset G mul H y.
Axiom god1_left_coset_subset : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> forall x :e G , left_coset G mul H x c= G.
Axiom god1_left_coset_size : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> forall r , equip H r -> forall x :e G , equip (left_coset G mul H x) r.
Axiom god1_left_coset_size_components : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> forall r , equip H r -> forall x :e G , left_coset G mul H x c= G /\ equip (left_coset G mul H x) r.
Axiom god1_left_coset_quotient_uniform_size : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> forall r , equip H r -> forall C :e left_coset_quotient G mul H , C c= G /\ equip C r.
Axiom god1_left_cosets_cover_group : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> forall x :e G , exists C :e left_coset_quotient G mul H , x :e C.
Axiom god1_left_cosets_unique_at_point : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> forall x :e G , forall C D :e left_coset_quotient G mul H , x :e C -> x :e D -> C = D.
Axiom god1_bijection_maps_subset : forall A B , forall f : set -> set , bij A B f -> forall X , X c= A -> forall x :e X , f x :e B.
Axiom god1_bijection_injective_subset : forall A B , forall f : set -> set , bij A B f -> forall X , X c= A -> forall x y :e X , f x = f y -> x = y.
Axiom god1_nat_equip_eq : forall n m , nat_p n -> nat_p m -> equip n m -> n = m.
Axiom god1_bij_domain_eq_subst : forall A B C , A = B -> forall f : set -> set , bij A C f -> bij B C f.
Axiom god1_bij_codomain_eq_subst : forall A B C , B = C -> forall f : set -> set , bij A B f -> bij A C f.
Axiom god1_equip_domain_eq_subst : forall A B C , A = B -> equip A C -> equip B C.
Axiom god1_equip_codomain_eq_subst : forall A B C , B = C -> equip A B -> equip A C.
Axiom god1_equip_eq_subst : forall A B C D , A = B -> C = D -> equip A C -> equip B D.
Axiom god1_disjoint_union_cardinality_zero : forall X , forall n :e omega , equip X n -> forall m :e omega , equip Empty m -> (forall y :e Empty , y /:e X) -> equip (X :\/: Empty) (add_nat n m).
Axiom god1_disjoint_union_cardinality_step : forall X , forall n :e omega , equip X n -> forall Y y , finite Y -> y /:e Y -> (forall m :e omega , equip Y m -> (forall z :e Y , z /:e X) -> equip (X :\/: Y) (add_nat n m)) -> forall m :e omega , equip (Y :\/: {y}) m -> (forall z :e Y :\/: {y} , z /:e X) -> equip (X :\/: (Y :\/: {y})) (add_nat n m).
Axiom god1_disjoint_union_cardinality : forall X , forall n :e omega , equip X n -> forall Y , finite Y -> forall m :e omega , equip Y m -> (forall y :e Y , y /:e X) -> equip (X :\/: Y) (add_nat n m).
Axiom god1_identity_famunion_adjoin : forall Q C , (\/_ D :e Q :\/: {C} , D) = (\/_ D :e Q , D) :\/: C.
Axiom god1_uniform_famunion_cardinality_zero : forall r :e omega , forall q :e omega , equip Empty q -> (forall C :e Empty , equip C r) -> (forall C D :e Empty , forall x , x :e C -> x :e D -> C = D) -> equip (\/_ C :e Empty , C) (mul_nat q r).
Axiom god1_uniform_famunion_cardinality_step : forall r :e omega , forall Q C , finite Q -> C /:e Q -> (forall q :e omega , equip Q q -> (forall D :e Q , equip D r) -> (forall D E :e Q , forall x , x :e D -> x :e E -> D = E) -> equip (\/_ D :e Q , D) (mul_nat q r)) -> forall q :e omega , equip (Q :\/: {C}) q -> (forall D :e Q :\/: {C} , equip D r) -> (forall D E :e Q :\/: {C} , forall x , x :e D -> x :e E -> D = E) -> equip (\/_ D :e Q :\/: {C} , D) (mul_nat q r).
Axiom god1_uniform_famunion_cardinality : forall Q , finite Q -> forall q r :e omega , equip Q q -> (forall C :e Q , equip C r) -> (forall C D :e Q , forall x , x :e C -> x :e D -> C = D) -> equip (\/_ C :e Q , C) (mul_nat q r).
Axiom god1_partition_famunion_eq : forall X Q , (forall C :e Q , C c= X) -> (forall x :e X , exists C :e Q , x :e C) -> X = (\/_ C :e Q , C).
Axiom god1_s5_theorem7_uniform_partition_cardinality : forall X Q , forall n q r :e omega , equip X n -> equip Q q -> (forall C :e Q , C c= X /\ equip C r) -> (forall x :e X , exists C :e Q , x :e C) -> (forall x :e X , forall C D :e Q , x :e C -> x :e D -> C = D) -> n = mul_nat q r.
Axiom god1_s7_theorem4_lagrange_cardinality_formula : forall G , forall mul : set -> set -> set , forall H , group G mul -> subgroup G mul H -> finite G -> forall n q r :e omega , equip G n -> equip (left_coset_quotient G mul H) q -> equip H r -> n = mul_nat q r.
Axiom god1_inverse_image_left_coset : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> forall x :e G , {group_inverse G mul z|z :e left_coset G mul H x} = right_coset G mul H (group_inverse G mul x).
Axiom god1_group_inverse_image_involutive : forall G , forall mul : set -> set -> set , group G mul -> forall C , C c= G -> {group_inverse G mul y|y :e {group_inverse G mul x|x :e C}} = C.
Axiom god1_group_inverse_image_injective_on_subsets : forall G , forall mul : set -> set -> set , group G mul -> forall C D , C c= G -> D c= G -> {group_inverse G mul z|z :e C} = {group_inverse G mul z|z :e D} -> C = D.
Axiom god1_left_coset_quotient_member_subset : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> forall C :e left_coset_quotient G mul H , C c= G.
Axiom god1_left_coset_inverse_image_in_right_quotient : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> forall C :e left_coset_quotient G mul H , {group_inverse G mul z|z :e C} :e right_coset_quotient G mul H.
Axiom god1_left_coset_inverse_image_surjective : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> forall D :e right_coset_quotient G mul H , exists C :e left_coset_quotient G mul H , {group_inverse G mul z|z :e C} = D.
Axiom god1_left_right_coset_inverse_image_bijective : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> bij (left_coset_quotient G mul H) (right_coset_quotient G mul H) (fun C => {group_inverse G mul z|z :e C}).
Axiom god1_left_and_right_coset_indices_equal : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> equip (left_coset_quotient G mul H) (right_coset_quotient G mul H).
Axiom god1_group_product_inverse_right_cancels : forall G , forall mul : set -> set -> set , group G mul -> forall a x :e G , mul (mul a x) (group_inverse G mul x) = a.
Axiom god1_group_right_cancel : forall G , forall mul : set -> set -> set , group G mul -> forall a b x :e G , mul a x = mul b x -> a = b.
Axiom god1_group_nat_power_identity_step : forall G , forall mul : set -> set -> set , group G mul -> forall n , nat_p n -> group_nat_power G mul (group_identity G mul) n = group_identity G mul -> group_nat_power G mul (group_identity G mul) (ordsucc n) = group_identity G mul.
Axiom god1_group_nat_power_identity : forall G , forall mul : set -> set -> set , group G mul -> forall n , nat_p n -> group_nat_power G mul (group_identity G mul) n = group_identity G mul.
Axiom god1_group_int_power_identity_nat : forall G , forall mul : set -> set -> set , group G mul -> forall n :e omega , group_int_power G mul (group_identity G mul) n = group_identity G mul.
Axiom god1_group_int_power_identity_negative_nat : forall G , forall mul : set -> set -> set , group G mul -> forall n :e omega , group_int_power G mul (group_identity G mul) (minus_SNo n) = group_identity G mul.
Axiom god1_group_int_power_identity : forall G , forall mul : set -> set -> set , group G mul -> forall q :e int , group_int_power G mul (group_identity G mul) q = group_identity G mul.
Axiom god1_surjection_gives_reverse_atleastp : forall X Y , forall f : set -> set , surj X Y f -> atleastp Y X.
Axiom god1_group_int_power_reduces_mod_period : forall G , forall mul : set -> set -> set , forall x , group G mul -> x :e G -> forall d :e omega , d <> 0 -> group_nat_power G mul x d = group_identity G mul -> forall p :e int , exists a :e d , group_int_power G mul x p = group_nat_power G mul x a.
Axiom god1_group_period_surjects_onto_cyclic_subgroup : forall G , forall mul : set -> set -> set , forall x , group G mul -> x :e G -> forall d :e omega , d <> 0 -> group_nat_power G mul x d = group_identity G mul -> surj d (cyclic_subgroup G mul x) (fun a => group_nat_power G mul x a).
Axiom god1_group_nat_power_in_cyclic_subgroup : forall G , forall mul : set -> set -> set , forall x , forall a :e omega , group_nat_power G mul x a :e cyclic_subgroup G mul x.
Axiom god1_group_power_strict_collision_gives_period : forall G , forall mul : set -> set -> set , forall x , group G mul -> x :e G -> forall r :e omega , forall a b :e ordsucc r , a :e b -> group_nat_power G mul x a = group_nat_power G mul x b -> exists d :e omega , d <> 0 /\ d c= r /\ group_nat_power G mul x d = group_identity G mul.
Axiom god1_finite_cyclic_subgroup_has_bounded_positive_period : forall G , forall mul : set -> set -> set , forall x , group G mul -> x :e G -> forall r :e omega , equip (cyclic_subgroup G mul x) r -> exists d :e omega , d <> 0 /\ d c= r /\ group_nat_power G mul x d = group_identity G mul.
Axiom god1_finite_cyclic_subgroup_cardinality_power_identity : forall G , forall mul : set -> set -> set , forall x , group G mul -> x :e G -> forall r :e omega , equip (cyclic_subgroup G mul x) r -> group_nat_power G mul x r = group_identity G mul.
Axiom god1_group_nat_power_multiple_of_period : forall G , forall mul : set -> set -> set , forall x , group G mul -> x :e G -> forall r q , nat_p r -> nat_p q -> group_nat_power G mul x r = group_identity G mul -> group_nat_power G mul x (mul_nat q r) = group_identity G mul.
Axiom god1_group_product_inverse_right_reconstructs : forall G , forall mul : set -> set -> set , group G mul -> forall a b :e G , mul (mul a (group_inverse G mul b)) b = a.
Axiom god1_finite_group_power_from_cyclic_period : forall G , forall mul : set -> set -> set , forall x , group G mul -> x :e G -> forall n :e omega , equip G n -> forall r :e omega , equip (cyclic_subgroup G mul x) r -> group_nat_power G mul x r = group_identity G mul -> group_nat_power G mul x n = group_identity G mul.
Axiom god1_cyclic_power_map_surjective : forall G , forall mul : set -> set -> set , forall x , group G mul -> x :e G -> cyclic_subgroup G mul x = G -> surj int G (fun q => group_int_power G mul x q).
Axiom god1_group_int_power_difference : forall G , forall mul : set -> set -> set , forall x , group G mul -> x :e G -> forall p q :e int , group_int_power G mul x (add_SNo p (minus_SNo q)) = mul (group_int_power G mul x p) (group_inverse G mul (group_int_power G mul x q)).
Axiom god1_group_int_powers_equal_iff_difference_identity : forall G , forall mul : set -> set -> set , forall x , group G mul -> x :e G -> forall p q :e int , (group_int_power G mul x p = group_int_power G mul x q <-> mul (group_int_power G mul x p) (group_inverse G mul (group_int_power G mul x q)) = group_identity G mul).
Axiom god1_group_int_powers_equal_iff_kernel_congruence : forall G , forall mul : set -> set -> set , forall x , group G mul -> x :e G -> forall p q :e int , forall s :e omega , (forall z :e int , (group_int_power G mul x z = group_identity G mul <-> exists k :e int , z = mul_SNo s k)) -> (group_int_power G mul x p = group_int_power G mul x q <-> exists k :e int , add_SNo p (minus_SNo q) = mul_SNo s k).
Axiom god1_finite_group_element_has_positive_int_period : forall G , forall mul : set -> set -> set , forall x , group G mul -> x :e G -> finite G -> exists s :e omega , s <> 0 /\ group_int_power G mul x s = group_identity G mul.
Axiom god1_kernel_generator_is_natural_period : forall G , forall mul : set -> set -> set , forall x , forall s :e omega , (forall q :e int , (group_int_power G mul x q = group_identity G mul <-> exists k :e int , q = mul_SNo s k)) -> group_nat_power G mul x s = group_identity G mul.
Axiom god1_finite_group_cardinality_power_identity_aux : forall G , forall mul : set -> set -> set , forall n :e omega , group G mul -> equip G n -> forall x :e G , finite G /\ group_nat_power G mul x n = group_identity G mul.
Axiom god1_s7_theorem5_finite_group_power_is_identity : forall G , forall mul : set -> set -> set , forall n :e omega , group G mul -> equip G n -> forall x :e G , group_nat_power G mul x n = group_identity G mul.
Axiom god1_s4_theorem2_classes_equip_image : forall A Q , forall f class_of : set -> set , (forall a :e A , class_of a :e Q) -> (forall C :e Q , exists a :e A , class_of a = C) -> (forall a b :e A , (class_of a = class_of b <-> f a = f b)) -> equip Q {f a|a :e A}.
Axiom god1_pair_fiber_bijective : forall a B , bij B {(a,b)|b :e B} (fun b => (a,b)).
Axiom god1_pair_fiber_equip : forall a B , equip {(a,b)|b :e B} B.
Axiom god1_setprod_empty_left : forall B , Empty :*: B = Empty.
Axiom god1_setprod_adjoin : forall A B a , (A :\/: {a}) :*: B = (A :*: B) :\/: {(a,b)|b :e B}.
Axiom god1_pair_fiber_disjoint_from_setprod : forall A B a , a /:e A -> forall z :e {(a,b)|b :e B} , z /:e A :*: B.
Axiom god1_setprod_cardinality_zero : forall B , forall m :e omega , equip B m -> forall n :e omega , equip Empty n -> equip (Empty :*: B) (mul_nat n m).
Axiom god1_setprod_cardinality_step : forall B , forall m :e omega , equip B m -> forall A a , finite A -> a /:e A -> (forall n :e omega , equip A n -> equip (A :*: B) (mul_nat n m)) -> forall n :e omega , equip (A :\/: {a}) n -> equip ((A :\/: {a}) :*: B) (mul_nat n m).
Axiom god1_setprod_cardinality : forall A B , forall n m :e omega , equip A n -> equip B m -> equip (A :*: B) (mul_nat n m).
Definition permutation_successor_correction : set -> set -> set := fun n s => permutation_composition (ordsucc n) (permutation_swap (ordsucc n) (s n) n) s.
Definition permutation_successor_code : set -> set -> set := fun n s => (s n,permutation_restrict_last n (permutation_successor_correction n s)).
Definition permutation_successor_decode : set -> set -> set := fun n w => permutation_composition (ordsucc n) (permutation_swap (ordsucc n) (w 0) n) (permutation_extend_last n (w 1)).
Axiom god1_permutation_successor_correction_unfold : forall n s , permutation_successor_correction n s = permutation_composition (ordsucc n) (permutation_swap (ordsucc n) (s n) n) s.
Axiom god1_permutation_successor_code_unfold : forall n s , permutation_successor_code n s = (s n,permutation_restrict_last n (permutation_successor_correction n s)).
Axiom god1_permutation_successor_decode_unfold : forall n w , permutation_successor_decode n w = permutation_composition (ordsucc n) (permutation_swap (ordsucc n) (w 0) n) (permutation_extend_last n (w 1)).
Axiom god1_permutation_value_in : forall X , forall s :e permutation_group X , forall x :e X , s x :e X.
Axiom god1_permutation_successor_correction_in : forall n , nat_p n -> forall s :e permutation_group (ordsucc n) , permutation_successor_correction n s :e permutation_group (ordsucc n).
Axiom god1_permutation_successor_correction_fixes_last : forall n , nat_p n -> forall s :e permutation_group (ordsucc n) , permutation_successor_correction n s n = n.
Axiom god1_permutation_successor_code_in : forall n , nat_p n -> forall s :e permutation_group (ordsucc n) , permutation_successor_code n s :e (ordsucc n) :*: permutation_group n.
Axiom god1_permutation_restrict_extend_last : forall n , nat_p n -> forall u :e permutation_group n , permutation_restrict_last n (permutation_extend_last n u) = u.
Axiom god1_permutation_successor_decode_in : forall n , nat_p n -> forall w :e (ordsucc n) :*: permutation_group n , permutation_successor_decode n w :e permutation_group (ordsucc n).
Axiom god1_permutation_successor_decode_at_last : forall n , nat_p n -> forall w :e (ordsucc n) :*: permutation_group n , permutation_successor_decode n w n = w 0.
Axiom god1_permutation_successor_code_first : forall n s , permutation_successor_code n s 0 = s n.
Axiom god1_permutation_successor_code_second : forall n s , permutation_successor_code n s 1 = permutation_restrict_last n (permutation_successor_correction n s).
Axiom god1_permutation_successor_correction_decode : forall n , nat_p n -> forall w :e (ordsucc n) :*: permutation_group n , permutation_successor_correction n (permutation_successor_decode n w) = permutation_extend_last n (w 1).
Axiom god1_permutation_successor_code_decode : forall n , nat_p n -> forall w :e (ordsucc n) :*: permutation_group n , permutation_successor_code n (permutation_successor_decode n w) = w.
Axiom god1_permutation_swap_correction_reconstructs : forall n , nat_p n -> forall s :e permutation_group (ordsucc n) , permutation_composition (ordsucc n) (permutation_swap (ordsucc n) (s n) n) (permutation_successor_correction n s) = s.
Axiom god1_permutation_successor_decode_code : forall n , nat_p n -> forall s :e permutation_group (ordsucc n) , permutation_successor_decode n (permutation_successor_code n s) = s.
Axiom god1_permutation_successor_bijective : forall n , nat_p n -> bij (permutation_group (ordsucc n)) ((ordsucc n) :*: permutation_group n) (fun s => permutation_successor_code n s).
Axiom god1_permutation_group_zero_equip_one : equip (permutation_group 0) 1.
Axiom god1_permutation_group_zero_order : equip (permutation_group 0) (factorial 0).
Axiom god1_permutation_successor_factorial_eq : forall n , nat_p n -> mul_nat (ordsucc n) (factorial n) = factorial (ordsucc n).
Axiom god1_permutation_group_ordinal_order_step : forall n , nat_p n -> equip (permutation_group n) (factorial n) -> equip (permutation_group (ordsucc n)) (factorial (ordsucc n)).
Axiom god1_permutation_group_ordinal_order : forall n , nat_p n -> equip (permutation_group n) (factorial n).
Definition permutation_relabel : set -> set -> (set -> set) -> set -> set := fun X Y f s => fun y :e Y => f (s (inv X f y)).
Definition permutation_unrelabel : set -> set -> (set -> set) -> set -> set := fun X Y f u => fun x :e X => inv X f (u (f x)).
Axiom god1_permutation_relabel_at : forall X Y , forall f : set -> set , forall s , forall y :e Y , permutation_relabel X Y f s y = f (s (inv X f y)).
Axiom god1_permutation_unrelabel_at : forall X Y , forall f : set -> set , forall u , forall x :e X , permutation_unrelabel X Y f u x = inv X f (u (f x)).
Axiom god1_permutation_relabel_raw_bijective : forall X Y , forall f : set -> set , bij X Y f -> forall s :e permutation_group X , bij Y Y (fun y => f (s (inv X f y))).
Axiom god1_permutation_relabel_in : forall X Y , forall f : set -> set , bij X Y f -> forall s :e permutation_group X , permutation_relabel X Y f s :e permutation_group Y.
Axiom god1_permutation_unrelabel_raw_bijective : forall X Y , forall f : set -> set , bij X Y f -> forall u :e permutation_group Y , bij X X (fun x => inv X f (u (f x))).
Axiom god1_permutation_unrelabel_in : forall X Y , forall f : set -> set , bij X Y f -> forall u :e permutation_group Y , permutation_unrelabel X Y f u :e permutation_group X.
Axiom god1_permutation_relabel_unrelabel : forall X Y , forall f : set -> set , bij X Y f -> forall u :e permutation_group Y , permutation_relabel X Y f (permutation_unrelabel X Y f u) = u.
Axiom god1_permutation_unrelabel_relabel : forall X Y , forall f : set -> set , bij X Y f -> forall s :e permutation_group X , permutation_unrelabel X Y f (permutation_relabel X Y f s) = s.
Axiom god1_permutation_relabel_bijective : forall X Y , forall f : set -> set , bij X Y f -> bij (permutation_group X) (permutation_group Y) (fun s => permutation_relabel X Y f s).
Axiom god1_permutation_groups_equip_of_equip : forall X Y , equip X Y -> equip (permutation_group X) (permutation_group Y).
Axiom god1_s7_permutation_group_order : forall X , forall n :e omega , equip X n -> equip (permutation_group X) (factorial n).
Definition group_homomorphism : set -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set) -> prop := fun G mulG H mulH f => group G mulG /\ group H mulH /\ (forall x :e G , f x :e H) /\ (forall x y :e G , f (mulG x y) = mulH (f x) (f y)).
Axiom god1_group_homomorphism_domain_group : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall f : set -> set , group_homomorphism G mulG H mulH f -> group G mulG.
Axiom god1_group_homomorphism_codomain_group : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall f : set -> set , group_homomorphism G mulG H mulH f -> group H mulH.
Axiom god1_group_homomorphism_maps_into : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall f : set -> set , group_homomorphism G mulG H mulH f -> forall x :e G , f x :e H.
Axiom god1_group_homomorphism_multiplies : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall f : set -> set , group_homomorphism G mulG H mulH f -> forall x y :e G , f (mulG x y) = mulH (f x) (f y).
Axiom god1_group_homomorphism_identity_image_idempotent : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall f : set -> set , group_homomorphism G mulG H mulH f -> f (group_identity G mulG) = mulH (f (group_identity G mulG)) (f (group_identity G mulG)).
Axiom god1_group_homomorphism_preserves_identity : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall f : set -> set , group_homomorphism G mulG H mulH f -> f (group_identity G mulG) = group_identity H mulH.
Axiom god1_group_homomorphism_inverse_image_left : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall f : set -> set , group_homomorphism G mulG H mulH f -> forall x :e G , mulH (f (group_inverse G mulG x)) (f x) = group_identity H mulH.
Axiom god1_group_homomorphism_preserves_inverse : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall f : set -> set , group_homomorphism G mulG H mulH f -> forall x :e G , f (group_inverse G mulG x) = group_inverse H mulH (f x).
Axiom god1_group_homomorphism_preserves_identity_and_inverse : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall f : set -> set , group_homomorphism G mulG H mulH f -> f (group_identity G mulG) = group_identity H mulH /\ forall x :e G , f (group_inverse G mulG x) = group_inverse H mulH (f x).
Axiom god1_group_homomorphism_composite_multiplies : forall M , forall mulM : set -> set -> set , forall N , forall mulN : set -> set -> set , forall P , forall mulP : set -> set -> set , forall f g : set -> set , group_homomorphism M mulM N mulN f -> group_homomorphism N mulN P mulP g -> forall x y :e M , g (f (mulM x y)) = mulP (g (f x)) (g (f y)).
Axiom god1_group_homomorphism_composite : forall M , forall mulM : set -> set -> set , forall N , forall mulN : set -> set -> set , forall P , forall mulP : set -> set -> set , forall f g : set -> set , group_homomorphism M mulM N mulN f -> group_homomorphism N mulN P mulP g -> group_homomorphism M mulM P mulP (fun x => g (f x)).
Axiom god1_bijective_group_homomorphism_inverse_multiplies : forall M , forall mulM : set -> set -> set , forall N , forall mulN : set -> set -> set , forall f : set -> set , group_homomorphism M mulM N mulN f -> bij M N f -> forall u v :e N , inv M f (mulN u v) = mulM (inv M f u) (inv M f v).
Axiom god1_bijective_group_homomorphism_inverse : forall M , forall mulM : set -> set -> set , forall N , forall mulN : set -> set -> set , forall f : set -> set , group_homomorphism M mulM N mulN f -> bij M N f -> group_homomorphism N mulN M mulM (inv M f).
Axiom god1_s7_theorem6_composite_and_inverse_homomorphisms : forall M , forall mulM : set -> set -> set , forall N , forall mulN : set -> set -> set , forall P , forall mulP : set -> set -> set , forall f g : set -> set , group_homomorphism M mulM N mulN f -> group_homomorphism N mulN P mulP g -> group_homomorphism M mulM P mulP (fun x => g (f x)) /\ (bij M N f -> group_homomorphism N mulN M mulM (inv M f)).
Definition group_isomorphism : set -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set) -> prop := fun G mulG H mulH f => group_homomorphism G mulG H mulH f /\ bij G H f.
Definition isomorphic_groups : set -> (set -> set -> set) -> set -> (set -> set -> set) -> prop := fun G mulG H mulH => exists f : set -> set , group_isomorphism G mulG H mulH f.
Axiom god1_group_isomorphism_homomorphism : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall f : set -> set , group_isomorphism G mulG H mulH f -> group_homomorphism G mulG H mulH f.
Axiom god1_group_isomorphism_bijective : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall f : set -> set , group_isomorphism G mulG H mulH f -> bij G H f.
Axiom god1_identity_group_homomorphism : forall G , forall mul : set -> set -> set , group G mul -> group_homomorphism G mul G mul (fun x => x).
Axiom god1_group_isomorphism_reflexive : forall G , forall mul : set -> set -> set , group G mul -> isomorphic_groups G mul G mul.
Axiom god1_group_isomorphism_symmetric : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , isomorphic_groups G mulG H mulH -> isomorphic_groups H mulH G mulG.
Axiom god1_group_isomorphism_transitive : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall K , forall mulK : set -> set -> set , isomorphic_groups G mulG H mulH -> isomorphic_groups H mulH K mulK -> isomorphic_groups G mulG K mulK.
Axiom god1_group_isomorphism_is_equivalence : (forall G , forall mul : set -> set -> set , group G mul -> isomorphic_groups G mul G mul) /\ (forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , isomorphic_groups G mulG H mulH -> isomorphic_groups H mulH G mulG) /\ (forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall K , forall mulK : set -> set -> set , isomorphic_groups G mulG H mulH -> isomorphic_groups H mulH K mulK -> isomorphic_groups G mulG K mulK).
Definition group_automorphism : set -> (set -> set -> set) -> (set -> set) -> prop := fun G mul f => group_isomorphism G mul G mul f.
Definition inner_automorphism : set -> (set -> set -> set) -> set -> (set -> set) -> prop := fun G mul a f => a :e G /\ forall x :e G , f x = mul (mul a x) (group_inverse G mul a).
Definition group_homomorphism_image : set -> (set -> set) -> set := fun G f => {f x|x :e G}.
Definition group_homomorphism_kernel : set -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set) -> set := fun G mulG H mulH f => {x :e G|f x = group_identity H mulH}.
Definition group_image_of_subset : set -> (set -> set) -> set := fun A f => {f x|x :e A}.
Definition group_preimage_of_subset : set -> set -> (set -> set) -> set := fun G B f => {x :e G|f x :e B}.
Axiom god1_group_homomorphism_image_subgroup : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall f : set -> set , group_homomorphism G mulG H mulH f -> forall A , subgroup G mulG A -> subgroup H mulH (group_image_of_subset A f).
Axiom god1_group_homomorphism_preimage_subgroup : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall f : set -> set , group_homomorphism G mulG H mulH f -> forall B , subgroup H mulH B -> subgroup G mulG (group_preimage_of_subset G B f).
Axiom god1_s7_theorem7_images_and_preimages_of_subgroups : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall f : set -> set , group_homomorphism G mulG H mulH f -> (forall A , subgroup G mulG A -> subgroup H mulH (group_image_of_subset A f)) /\ (forall B , subgroup H mulH B -> subgroup G mulG (group_preimage_of_subset G B f)).
Definition normal_subgroup : set -> (set -> set -> set) -> set -> prop := fun G mul N => subgroup G mul N /\ forall a :e G , forall x :e N , mul (mul a x) (group_inverse G mul a) :e N.
Axiom god1_group_homomorphism_kernel_elim : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall f : set -> set , forall x , x :e group_homomorphism_kernel G mulG H mulH f -> x :e G /\ f x = group_identity H mulH.
Axiom god1_group_homomorphism_kernel_intro : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall f : set -> set , forall x , x :e G -> f x = group_identity H mulH -> x :e group_homomorphism_kernel G mulG H mulH f.
Axiom god1_group_homomorphism_kernel_subgroup : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall f : set -> set , group_homomorphism G mulG H mulH f -> subgroup G mulG (group_homomorphism_kernel G mulG H mulH f).
Axiom god1_group_homomorphism_kernel_conjugate : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall f : set -> set , group_homomorphism G mulG H mulH f -> forall x :e group_homomorphism_kernel G mulG H mulH f , forall a :e G , f (mulG (mulG a x) (group_inverse G mulG a)) = group_identity H mulH.
Axiom god1_kernel_is_normal_subgroup : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall f : set -> set , group_homomorphism G mulG H mulH f -> normal_subgroup G mulG (group_homomorphism_kernel G mulG H mulH f).
Axiom god1_injection_injective : forall X Y , forall f : set -> set , inj X Y f -> forall x y :e X , f x = f y -> x = y.
Axiom god1_group_homomorphism_kernel_equation : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall f : set -> set , group_homomorphism G mulG H mulH f -> forall x :e G , (f x = group_identity H mulH <-> f x = f (group_identity G mulG)).
Axiom god1_injective_homomorphism_kernel_trivial : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall f : set -> set , group_homomorphism G mulG H mulH f -> inj G H f -> group_homomorphism_kernel G mulG H mulH f = {group_identity G mulG}.
Axiom god1_group_homomorphism_equal_images_difference_in_kernel : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall f : set -> set , group_homomorphism G mulG H mulH f -> forall x y :e G , f x = f y -> mulG x (group_inverse G mulG y) :e group_homomorphism_kernel G mulG H mulH f.
Axiom god1_trivial_kernel_homomorphism_injective : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall f : set -> set , group_homomorphism G mulG H mulH f -> group_homomorphism_kernel G mulG H mulH f = {group_identity G mulG} -> inj G H f.
Axiom god1_s7_theorem8_injective_iff_trivial_kernel : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall f : set -> set , group_homomorphism G mulG H mulH f -> (inj G H f <-> group_homomorphism_kernel G mulG H mulH f = {group_identity G mulG}).
Axiom god1_s2_theorem1_factor_through_surjection : forall A B C , forall p f : set -> set , surj A B p -> ((exists f' : set -> set , forall x :e A , f x = f' (p x)) <-> forall x y :e A , p x = p y -> f x = f y) /\ (forall f1 f2 : set -> set , (forall x :e A , f x = f1 (p x)) -> (forall x :e A , f x = f2 (p x)) -> forall b :e B , f1 b = f2 b).
Axiom god1_group_equal_iff_difference_identity : forall G , forall mul : set -> set -> set , group G mul -> forall x y :e G , (x = y <-> mul x (group_inverse G mul y) = group_identity G mul).
Axiom god1_group_homomorphism_equal_iff_difference_in_kernel : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall q : set -> set , group_homomorphism G mulG H mulH q -> forall x y :e G , (q x = q y <-> mulG x (group_inverse G mulG y) :e group_homomorphism_kernel G mulG H mulH q).
Axiom god1_factor_fiber_criterion_iff_kernel_inclusion : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall M , forall mulM : set -> set -> set , forall p f : set -> set , group_homomorphism G mulG H mulH p -> group_homomorphism G mulG M mulM f -> ((forall x y :e G , p x = p y -> f x = f y) <-> group_homomorphism_kernel G mulG H mulH p c= group_homomorphism_kernel G mulG M mulM f).
Axiom god1_factor_map_maps_into : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall M , forall mulM : set -> set -> set , forall p f f' : set -> set , group_homomorphism G mulG H mulH p -> group_homomorphism G mulG M mulM f -> surj G H p -> (forall x :e G , f x = f' (p x)) -> forall u :e H , f' u :e M.
Axiom god1_factor_map_multiplies : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall M , forall mulM : set -> set -> set , forall p f f' : set -> set , group_homomorphism G mulG H mulH p -> group_homomorphism G mulG M mulM f -> surj G H p -> (forall x :e G , f x = f' (p x)) -> forall u v :e H , f' (mulH u v) = mulM (f' u) (f' v).
Axiom god1_factor_map_is_group_homomorphism : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall M , forall mulM : set -> set -> set , forall p f f' : set -> set , group_homomorphism G mulG H mulH p -> group_homomorphism G mulG M mulM f -> surj G H p -> (forall x :e G , f x = f' (p x)) -> group_homomorphism H mulH M mulM f'.
Axiom god1_factorization_exists_iff_kernel_inclusion : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall M , forall mulM : set -> set -> set , forall p f : set -> set , group_homomorphism G mulG H mulH p -> group_homomorphism G mulG M mulM f -> surj G H p -> ((exists f' : set -> set , group_homomorphism H mulH M mulM f' /\ forall x :e G , f x = f' (p x)) <-> group_homomorphism_kernel G mulG H mulH p c= group_homomorphism_kernel G mulG M mulM f).
Axiom god1_factor_surjective_iff_original_surjective : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall M , forall mulM : set -> set -> set , forall p f f' : set -> set , group_homomorphism G mulG H mulH p -> group_homomorphism G mulG M mulM f -> surj G H p -> (forall x :e G , f x = f' (p x)) -> (surj H M f' <-> surj G M f).
Axiom god1_factor_injective_iff_kernels_equal : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall M , forall mulM : set -> set -> set , forall p f f' : set -> set , group_homomorphism G mulG H mulH p -> group_homomorphism G mulG M mulM f -> surj G H p -> group_homomorphism H mulH M mulM f' -> (forall x :e G , f x = f' (p x)) -> group_homomorphism_kernel G mulG H mulH p c= group_homomorphism_kernel G mulG M mulM f -> (inj H M f' <-> group_homomorphism_kernel G mulG H mulH p = group_homomorphism_kernel G mulG M mulM f).
Axiom god1_factorization_full : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall M , forall mulM : set -> set -> set , forall p f : set -> set , group_homomorphism G mulG H mulH p -> group_homomorphism G mulG M mulM f -> surj G H p -> group_homomorphism_kernel G mulG H mulH p c= group_homomorphism_kernel G mulG M mulM f -> exists f' : set -> set , group_homomorphism H mulH M mulM f' /\ (forall x :e G , f x = f' (p x)) /\ (forall h : set -> set , group_homomorphism H mulH M mulM h -> (forall x :e G , f x = h (p x)) -> forall u :e H , h u = f' u) /\ (inj H M f' <-> group_homomorphism_kernel G mulG H mulH p = group_homomorphism_kernel G mulG M mulM f) /\ (surj H M f' <-> surj G M f).
Axiom god1_s7_theorem9_factorization_of_group_homomorphism : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , forall M , forall mulM : set -> set -> set , forall p f : set -> set , group_homomorphism G mulG H mulH p -> group_homomorphism G mulG M mulM f -> surj G H p -> ((exists f' : set -> set , group_homomorphism H mulH M mulM f' /\ forall x :e G , f x = f' (p x)) <-> group_homomorphism_kernel G mulG H mulH p c= group_homomorphism_kernel G mulG M mulM f) /\ (group_homomorphism_kernel G mulG H mulH p c= group_homomorphism_kernel G mulG M mulM f -> exists f' : set -> set , group_homomorphism H mulH M mulM f' /\ (forall x :e G , f x = f' (p x)) /\ (forall h : set -> set , group_homomorphism H mulH M mulM h -> (forall x :e G , f x = h (p x)) -> forall u :e H , h u = f' u) /\ (inj H M f' <-> group_homomorphism_kernel G mulG H mulH p = group_homomorphism_kernel G mulG M mulM f) /\ (surj H M f' <-> surj G M f)).
Definition int_mod_class : set -> set -> set := fun p x => {y :e int|exists k :e int , y = add_SNo x (mul_SNo p k)}.
Definition int_mod_quotient : set -> set := fun p => {int_mod_class p x|x :e int}.
Definition int_mod_representative : set -> set -> set := fun p A => Eps_i (fun x => x :e int /\ A = int_mod_class p x).
Definition int_mod_addition : set -> set -> set -> set := fun p A B => int_mod_class p (add_SNo (int_mod_representative p A) (int_mod_representative p B)).
Axiom god1_int_mod_class_member_self : forall p :e omega , forall x :e int , x :e int_mod_class p x.
Axiom god1_int_mod_class_in_quotient : forall p :e omega , forall x :e int , int_mod_class p x :e int_mod_quotient p.
Axiom god1_int_mod_representative_data : forall p :e omega , forall A :e int_mod_quotient p , int_mod_representative p A :e int /\ A = int_mod_class p (int_mod_representative p A).
Axiom god1_int_mod_shift_sum_equation : forall p :e omega , forall x y k l z :e int , y = add_SNo x (mul_SNo p k) -> z = add_SNo y (mul_SNo p l) -> z = add_SNo x (mul_SNo p (add_SNo k l)).
Axiom god1_int_mod_class_membership_transport : forall p :e omega , forall x y k :e int , y = add_SNo x (mul_SNo p k) -> forall z :e int_mod_class p y , z :e int_mod_class p x.
Axiom god1_int_mod_reverse_shift : forall p :e omega , forall x y k :e int , y = add_SNo x (mul_SNo p k) -> x = add_SNo y (mul_SNo p (minus_SNo k)).
Axiom god1_int_mod_class_eq_of_shift : forall p :e omega , forall x y k :e int , y = add_SNo x (mul_SNo p k) -> int_mod_class p y = int_mod_class p x.
Axiom god1_int_mod_class_equal_gives_shift : forall p :e omega , forall x y :e int , int_mod_class p x = int_mod_class p y -> exists k :e int , y = add_SNo x (mul_SNo p k).
Axiom god1_int_mod_two_shifts_sum : forall p :e omega , forall x x' y y' k l :e int , x' = add_SNo x (mul_SNo p k) -> y' = add_SNo y (mul_SNo p l) -> add_SNo x' y' = add_SNo (add_SNo x y) (mul_SNo p (add_SNo k l)).
Axiom god1_int_mod_class_add_compatible : forall p :e omega , forall x x' y y' :e int , int_mod_class p x = int_mod_class p x' -> int_mod_class p y = int_mod_class p y' -> int_mod_class p (add_SNo x y) = int_mod_class p (add_SNo x' y').
Axiom god1_int_mod_addition_on_classes : forall p :e omega , forall x y :e int , int_mod_addition p (int_mod_class p x) (int_mod_class p y) = int_mod_class p (add_SNo x y).
Axiom god1_int_mod_addition_closed : forall p :e omega , forall A B :e int_mod_quotient p , int_mod_addition p A B :e int_mod_quotient p.
Axiom god1_int_mod_addition_associative_classes : forall p :e omega , forall x y z :e int , int_mod_addition p (int_mod_class p x) (int_mod_addition p (int_mod_class p y) (int_mod_class p z)) = int_mod_addition p (int_mod_addition p (int_mod_class p x) (int_mod_class p y)) (int_mod_class p z).
Axiom god1_int_mod_addition_associative : forall p :e omega , associative_on (int_mod_quotient p) (int_mod_addition p).
Axiom god1_int_mod_zero_neutral : forall p :e omega , neutral_element (int_mod_quotient p) (int_mod_addition p) (int_mod_class p 0).
Axiom god1_int_mod_class_inverse_left : forall p :e omega , forall x :e int , int_mod_addition p (int_mod_class p (minus_SNo x)) (int_mod_class p x) = int_mod_class p 0.
Axiom god1_int_mod_class_inverse_right : forall p :e omega , forall x :e int , int_mod_addition p (int_mod_class p x) (int_mod_class p (minus_SNo x)) = int_mod_class p 0.
Axiom god1_int_mod_reflection_exists : forall p :e omega , forall A :e int_mod_quotient p , exists R :e int_mod_quotient p , reflection (int_mod_quotient p) (int_mod_addition p) (int_mod_class p 0) A R.
Axiom god1_int_mod_quotient_group : forall p :e omega , group (int_mod_quotient p) (int_mod_addition p).
Axiom god1_integers_modulo_p_form_additive_group : forall p :e omega , group (int_mod_quotient p) (int_mod_addition p).
Axiom god1_integer_additive_group : group int add_SNo.
Axiom god1_integer_additive_identity : group_identity int add_SNo = 0.
Axiom god1_integer_additive_inverse : forall x :e int , group_inverse int add_SNo x = minus_SNo x.
Axiom god1_integer_subgroup_contains_natural_multiples : forall I , subgroup int add_SNo I -> forall p :e I , forall n , nat_p n -> mul_SNo p n :e I.
Axiom god1_integer_subgroup_contains_integer_multiples : forall I , subgroup int add_SNo I -> forall p :e I , forall k :e int , mul_SNo p k :e I.
Axiom god1_nontrivial_integer_subgroup_has_positive_natural : forall I , subgroup int add_SNo I -> forall z :e I , z <> 0 -> exists n , ordinal n /\ (n :e omega /\ (n <> 0 /\ n :e I)).
Axiom god1_subgroup_of_integers_is_multiple_set : forall I , subgroup int add_SNo I -> exists p :e omega , I = {mul_SNo p k|k :e int}.
Axiom god1_natural_in_own_integer_multiple_set : forall p :e omega , p :e {mul_SNo p k|k :e int}.
Axiom god1_integer_multiple_membership_gives_divisibility : forall p :e omega , forall z :e int , z :e {mul_SNo p k|k :e int} -> divides_int p z.
Axiom god1_zero_divides_integer_only_zero : forall z :e int , divides_int 0 z -> z = 0.
Axiom god1_natural_zero_or_positive : forall p :e omega , p = 0 \/ 0 :e p.
Axiom god1_natural_nonzero_is_positive : forall n :e omega , n <> 0 -> 0 < n.
Axiom god1_integer_multiple_set_generator_unique : forall p q :e omega , {mul_SNo p k|k :e int} = {mul_SNo q k|k :e int} -> p = q.
Axiom god1_subgroups_of_integers_classification_unique : forall I , subgroup int add_SNo I -> exists p :e omega , I = {mul_SNo p k|k :e int} /\ forall q :e omega , I = {mul_SNo q k|k :e int} -> q = p.
Axiom god1_integer_power_map_homomorphism : forall G , forall mul : set -> set -> set , forall x :e G , group G mul -> group_homomorphism int add_SNo G mul (fun n => group_int_power G mul x n).
Axiom god1_generator_powers_fill_group : forall G , forall mul : set -> set -> set , forall x :e G , group G mul -> (forall y :e G , exists n :e int , y = group_int_power G mul x n) -> cyclic_subgroup G mul x = G.
Axiom god1_power_map_kernel_is_multiple_set : forall G , forall mul : set -> set -> set , forall x :e G , group G mul -> exists p :e omega , group_homomorphism_kernel int add_SNo G mul (fun n => group_int_power G mul x n) = {mul_SNo p k|k :e int}.
Axiom god1_surjection_image_is_codomain : forall X Y , forall f : set -> set , surj X Y f -> {f x|x :e X} = Y.
Axiom god1_surj_codomain_eq_subst : forall X Y Z , forall f : set -> set , Y = Z -> surj X Y f -> surj X Z f.
Axiom god1_positive_periodic_generator_makes_group_finite : forall G , forall mul : set -> set -> set , forall x :e G , group G mul -> (forall y :e G , exists n :e int , y = group_int_power G mul x n) -> forall p :e omega , 0 :e p -> group_int_power G mul x p = group_identity G mul -> finite G.
Axiom god1_int_mod_quotient_identity : forall p :e omega , group_identity (int_mod_quotient p) (int_mod_addition p) = int_mod_class p 0.
Axiom god1_canonical_int_mod_homomorphism : forall p :e omega , group_homomorphism int add_SNo (int_mod_quotient p) (int_mod_addition p) (fun n => int_mod_class p n).
Axiom god1_canonical_int_mod_surjective : forall p :e omega , surj int (int_mod_quotient p) (fun n => int_mod_class p n).
Axiom god1_canonical_int_mod_kernel : forall p :e omega , group_homomorphism_kernel int add_SNo (int_mod_quotient p) (int_mod_addition p) (fun n => int_mod_class p n) = {mul_SNo p k|k :e int}.
Axiom god1_canonical_int_mod_map_full : forall p :e omega , group_homomorphism int add_SNo (int_mod_quotient p) (int_mod_addition p) (fun n => int_mod_class p n) /\ surj int (int_mod_quotient p) (fun n => int_mod_class p n) /\ group_homomorphism_kernel int add_SNo (int_mod_quotient p) (int_mod_addition p) (fun n => int_mod_class p n) = {mul_SNo p k|k :e int}.
Axiom god1_zero_integer_multiples_singleton : {mul_SNo 0 k|k :e int} = {0}.
Axiom god1_power_map_quotient_isomorphism : forall G , forall mul : set -> set -> set , forall x :e G , group G mul -> (forall y :e G , exists n :e int , y = group_int_power G mul x n) -> forall p :e omega , group_homomorphism_kernel int add_SNo G mul (fun n => group_int_power G mul x n) = {mul_SNo p k|k :e int} -> isomorphic_groups (int_mod_quotient p) (int_mod_addition p) G mul.
Axiom god1_power_map_trivial_kernel_isomorphism : forall G , forall mul : set -> set -> set , forall x :e G , group G mul -> (forall y :e G , exists n :e int , y = group_int_power G mul x n) -> group_homomorphism_kernel int add_SNo G mul (fun n => group_int_power G mul x n) = {0} -> isomorphic_groups G mul int add_SNo.
Axiom god1_integers_infinite : infinite int.
Axiom god1_finite_generator_kernel_cardinality : forall G , forall mul : set -> set -> set , forall x :e G , group G mul -> (forall y :e G , exists m :e int , y = group_int_power G mul x m) -> forall n :e omega , equip G n -> forall p :e omega , 0 :e p -> group_homomorphism_kernel int add_SNo G mul (fun m => group_int_power G mul x m) = {mul_SNo p k|k :e int} -> n = p.
Axiom god1_power_kernel_generator_is_period : forall G , forall mul : set -> set -> set , forall x :e G , forall p :e omega , group_homomorphism_kernel int add_SNo G mul (fun n => group_int_power G mul x n) = {mul_SNo p k|k :e int} -> group_int_power G mul x p = group_identity G mul.
Axiom god1_isomorphic_to_integers_is_infinite : forall G , forall mul : set -> set -> set , isomorphic_groups G mul int add_SNo -> infinite G.
Axiom god1_s7_theorem10_classification_of_cyclic_groups : (forall G , forall mul : set -> set -> set , cyclic_group G mul -> infinite G -> isomorphic_groups G mul int add_SNo) /\ (forall G , forall mul : set -> set -> set , cyclic_group G mul -> finite G -> exists p :e omega , equip G p /\ isomorphic_groups G mul (int_mod_quotient p) (int_mod_addition p)).
Axiom god1_equip_preserves_finiteness : forall X Y , equip X Y -> finite X -> finite Y.
Axiom god1_infinite_cyclic_group_classification : forall G , forall mul : set -> set -> set , cyclic_group G mul -> infinite G -> isomorphic_groups G mul int add_SNo.
Axiom god1_finite_cyclic_group_classification : forall G , forall mul : set -> set -> set , cyclic_group G mul -> finite G -> exists p :e omega , equip G p /\ isomorphic_groups G mul (int_mod_quotient p) (int_mod_addition p).
Axiom god1_finite_cyclic_group_at_its_cardinality : forall G , forall mul : set -> set -> set , cyclic_group G mul -> forall n :e omega , equip G n -> isomorphic_groups G mul (int_mod_quotient n) (int_mod_addition n).
Axiom god1_cyclic_groups_isomorphic_iff_equip : forall G , forall mulG : set -> set -> set , forall H , forall mulH : set -> set -> set , cyclic_group G mulG -> cyclic_group H mulH -> (isomorphic_groups G mulG H mulH <-> equip G H).
Definition group_element_order : set -> (set -> set -> set) -> set -> set -> prop := fun G mul x n => n :e omega /\ equip (cyclic_subgroup G mul x) n.
Axiom god1_natural_nonzero_contains_zero : forall n :e omega , n <> 0 -> 0 :e n.
Axiom god1_nonzero_integer_period_gives_positive_natural_period : forall G , forall mul : set -> set -> set , forall x :e G , group G mul -> forall q :e int , q <> 0 -> group_int_power G mul x q = group_identity G mul -> exists d :e omega , d <> 0 /\ group_nat_power G mul x d = group_identity G mul.
Axiom god1_positive_natural_period_makes_cyclic_subgroup_finite : forall G , forall mul : set -> set -> set , forall x :e G , group G mul -> forall d :e omega , d <> 0 -> group_nat_power G mul x d = group_identity G mul -> finite (cyclic_subgroup G mul x).
Axiom god1_element_finite_order_iff_nonzero_integer_period : forall G , forall mul : set -> set -> set , forall x :e G , group G mul -> ((exists n :e omega , group_element_order G mul x n) <-> exists q :e int , q <> 0 /\ group_int_power G mul x q = group_identity G mul).
Axiom god1_finite_element_order_specification : forall G , forall mul : set -> set -> set , forall x :e G , group G mul -> forall n :e omega , group_element_order G mul x n -> 0 :e n /\ group_nat_power G mul x n = group_identity G mul /\ forall p :e n , p <> 0 -> group_nat_power G mul x p <> group_identity G mul.
Axiom god1_finite_element_order_characterization : forall G , forall mul : set -> set -> set , forall x :e G , group G mul -> ((exists n :e omega , group_element_order G mul x n) <-> exists p :e int , p <> 0 /\ group_int_power G mul x p = group_identity G mul) /\ (forall n :e omega , group_element_order G mul x n -> 0 :e n /\ group_nat_power G mul x n = group_identity G mul /\ (forall p :e n , p <> 0 -> group_nat_power G mul x p <> group_identity G mul)).
Definition group_action : set -> (set -> set -> set) -> set -> (set -> set -> set) -> prop := fun G mul X act => group G mul /\ (forall s :e G , forall x :e X , act s x :e X) /\ (forall s t :e G , forall x :e X , act s (act t x) = act (mul s t) x) /\ (forall x :e X , act (group_identity G mul) x = x).
Definition action_stabilizer : set -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> set := fun G mul X act x => {s :e G|act s x = x}.
Definition action_orbit : set -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> set := fun G mul X act x => {act s x|s :e G}.
Axiom god1_group_action_group : forall G , forall mul : set -> set -> set , forall X , forall act : set -> set -> set , group_action G mul X act -> group G mul.
Axiom god1_group_action_closed : forall G , forall mul : set -> set -> set , forall X , forall act : set -> set -> set , group_action G mul X act -> forall s :e G , forall x :e X , act s x :e X.
Axiom god1_group_action_composition : forall G , forall mul : set -> set -> set , forall X , forall act : set -> set -> set , group_action G mul X act -> forall s t :e G , forall x :e X , act s (act t x) = act (mul s t) x.
Axiom god1_group_action_identity : forall G , forall mul : set -> set -> set , forall X , forall act : set -> set -> set , group_action G mul X act -> forall x :e X , act (group_identity G mul) x = x.
Axiom god1_group_action_inverse_left : forall G , forall mul : set -> set -> set , forall X , forall act : set -> set -> set , group_action G mul X act -> forall s :e G , forall x :e X , act (group_inverse G mul s) (act s x) = x.
Axiom god1_group_action_inverse_right : forall G , forall mul : set -> set -> set , forall X , forall act : set -> set -> set , group_action G mul X act -> forall s :e G , forall x :e X , act s (act (group_inverse G mul s) x) = x.
Axiom god1_group_action_map_bijective : forall G , forall mul : set -> set -> set , forall X , forall act : set -> set -> set , group_action G mul X act -> forall s :e G , bij X X (fun x => act s x).
Axiom god1_group_action_map_in_permutation_group : forall G , forall mul : set -> set -> set , forall X , forall act : set -> set -> set , group_action G mul X act -> forall s :e G , (fun x :e X => act s x) :e permutation_group X.
Axiom god1_group_action_map_multiplies : forall G , forall mul : set -> set -> set , forall X , forall act : set -> set -> set , group_action G mul X act -> forall s t :e G , (fun x :e X => act (mul s t) x) = permutation_composition X (fun x :e X => act s x) (fun x :e X => act t x).
Axiom god1_group_action_homomorphism : forall G , forall mul : set -> set -> set , forall X , forall act : set -> set -> set , group_action G mul X act -> group_homomorphism G mul (permutation_group X) (permutation_composition X) (fun s => fun x :e X => act s x).
Axiom god1_action_maps_are_permutations_and_form_homomorphism : forall G , forall mul : set -> set -> set , forall X , forall act : set -> set -> set , group_action G mul X act -> (forall s :e G , (fun x :e X => act s x) :e permutation_group X) /\ group_homomorphism G mul (permutation_group X) (permutation_composition X) (fun s => fun x :e X => act s x).
Axiom god1_action_stabilizer_is_subgroup : forall G , forall mul : set -> set -> set , forall X , forall act : set -> set -> set , group_action G mul X act -> forall x :e X , subgroup G mul (action_stabilizer G mul X act x).
Definition ring : set -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K add mul => abelian_group K add /\ law_of_composition K mul /\ associative_on K mul /\ (exists one :e K , neutral_element K mul one) /\ (forall x y z :e K , mul x (add y z) = add (mul x y) (mul x z) /\ mul (add x y) z = add (mul x z) (mul y z)).
Definition ring_zero : set -> (set -> set -> set) -> set := fun K add => group_identity K add.
Definition ring_one : set -> (set -> set -> set) -> set := fun K mul => Eps_i (fun one => neutral_element K mul one).
Definition ring_negation : set -> (set -> set -> set) -> set -> set := fun K add x => group_inverse K add x.
Definition commutative_ring : set -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K add mul => ring K add mul /\ commutative_on K mul.
Axiom god1_ring_additive_abelian_group : forall K , forall add mul : set -> set -> set , ring K add mul -> abelian_group K add.
Axiom god1_ring_additive_group : forall K , forall add mul : set -> set -> set , ring K add mul -> group K add.
Axiom god1_ring_multiplicative_identity_exists : forall K , forall add mul : set -> set -> set , ring K add mul -> exists one :e K , neutral_element K mul one.
Axiom god1_ring_multiplicative_identity_specification : forall K , forall add mul : set -> set -> set , ring K add mul -> neutral_element K mul (ring_one K mul).
Axiom god1_ring_zero_one_negation_specifications : forall K , forall add mul : set -> set -> set , ring K add mul -> neutral_element K add (ring_zero K add) /\ neutral_element K mul (ring_one K mul) /\ (forall x :e K , reflection K add (ring_zero K add) x (ring_negation K add x)).
Axiom god1_ring_multiplicative_law : forall K , forall add mul : set -> set -> set , ring K add mul -> law_of_composition K mul.
Axiom god1_ring_distributive_laws : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x y z :e K , mul x (add y z) = add (mul x y) (mul x z) /\ mul (add x y) z = add (mul x z) (mul y z).
Axiom god1_ring_zero_multiplication_left : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x :e K , mul (ring_zero K add) x = ring_zero K add.
Axiom god1_ring_minus_one_multiplication_left : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x :e K , mul (ring_negation K add (ring_one K mul)) x = ring_negation K add x.
Axiom god1_ring_minus_one_and_zero_multiplication : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x :e K , mul (ring_negation K add (ring_one K mul)) x = ring_negation K add x /\ mul (ring_zero K add) x = ring_zero K add.
Definition mapping_ring_addition : set -> (set -> set -> set) -> set -> set -> set := fun X add f g => fun x :e X => add (f x) (g x).
Definition mapping_ring_multiplication : set -> (set -> set -> set) -> set -> set -> set := fun X mul f g => fun x :e X => mul (f x) (g x).
Axiom god1_mapping_ring_addition_eval : forall X , forall add : set -> set -> set , forall f g , forall z :e X , mapping_ring_addition X add f g z = add (f z) (g z).
Axiom god1_mapping_ring_multiplication_eval : forall X , forall mul : set -> set -> set , forall f g , forall z :e X , mapping_ring_multiplication X mul f g z = mul (f z) (g z).
Axiom god1_mapping_ring_additive_group : forall X K , forall add mul : set -> set -> set , ring K add mul -> group (K :^: X) (mapping_ring_addition X add).
Axiom god1_mapping_ring_addition_commutative : forall X K , forall add mul : set -> set -> set , ring K add mul -> commutative_on (K :^: X) (mapping_ring_addition X add).
Axiom god1_mapping_ring_additive_abelian_group : forall X K , forall add mul : set -> set -> set , ring K add mul -> abelian_group (K :^: X) (mapping_ring_addition X add).
Axiom god1_mapping_ring_multiplicative_law : forall X K , forall add mul : set -> set -> set , ring K add mul -> law_of_composition (K :^: X) (mapping_ring_multiplication X mul).
Axiom god1_mapping_ring_multiplication_associative : forall X K , forall add mul : set -> set -> set , ring K add mul -> associative_on (K :^: X) (mapping_ring_multiplication X mul).
Axiom god1_mapping_ring_multiplicative_identity : forall X K , forall add mul : set -> set -> set , ring K add mul -> neutral_element (K :^: X) (mapping_ring_multiplication X mul) (fun z :e X => ring_one K mul).
Axiom god1_mapping_ring_multiplication_commutative : forall X K , forall add mul : set -> set -> set , commutative_ring K add mul -> commutative_on (K :^: X) (mapping_ring_multiplication X mul).
Axiom god1_mapping_ring_left_distributive_eval : forall X K , forall add mul : set -> set -> set , forall f g h :e (K :^: X) , forall z :e X , ring K add mul -> mapping_ring_multiplication X mul f (mapping_ring_addition X add g h) z = mapping_ring_addition X add (mapping_ring_multiplication X mul f g) (mapping_ring_multiplication X mul f h) z.
Axiom god1_mapping_ring_right_distributive_eval : forall X K , forall add mul : set -> set -> set , forall f g h :e (K :^: X) , forall z :e X , ring K add mul -> mapping_ring_multiplication X mul (mapping_ring_addition X add f g) h z = mapping_ring_addition X add (mapping_ring_multiplication X mul f h) (mapping_ring_multiplication X mul g h) z.
Axiom god1_mapping_ring_distributive_laws : forall X K , forall add mul : set -> set -> set , ring K add mul -> forall f g h :e (K :^: X) , mapping_ring_multiplication X mul f (mapping_ring_addition X add g h) = mapping_ring_addition X add (mapping_ring_multiplication X mul f g) (mapping_ring_multiplication X mul f h) /\ mapping_ring_multiplication X mul (mapping_ring_addition X add f g) h = mapping_ring_addition X add (mapping_ring_multiplication X mul f h) (mapping_ring_multiplication X mul g h).
Axiom god1_mapping_ring_ring : forall X K , forall add mul : set -> set -> set , ring K add mul -> ring (K :^: X) (mapping_ring_addition X add) (mapping_ring_multiplication X mul).
Axiom god1_mapping_ring_commutative_ring : forall X K , forall add mul : set -> set -> set , commutative_ring K add mul -> commutative_ring (K :^: X) (mapping_ring_addition X add) (mapping_ring_multiplication X mul).
Axiom god1_mapping_ring_is_ring : forall X K , forall add mul : set -> set -> set , ring K add mul -> ring (K :^: X) (mapping_ring_addition X add) (mapping_ring_multiplication X mul) /\ (commutative_ring K add mul -> commutative_ring (K :^: X) (mapping_ring_addition X add) (mapping_ring_multiplication X mul)).
Definition subring : set -> (set -> set -> set) -> (set -> set -> set) -> set -> prop := fun K add mul A => ring K add mul /\ A c= K /\ subgroup K add A /\ (forall x y :e A , mul x y :e A) /\ ring_one K mul :e A.
Axiom god1_subring_ambient_ring : forall K , forall add mul : set -> set -> set , forall A , subring K add mul A -> ring K add mul.
Axiom god1_subring_subset : forall K , forall add mul : set -> set -> set , forall A , subring K add mul A -> A c= K.
Axiom god1_subring_additive_subgroup : forall K , forall add mul : set -> set -> set , forall A , subring K add mul A -> subgroup K add A.
Axiom god1_subring_multiplication_closed : forall K , forall add mul : set -> set -> set , forall A , subring K add mul A -> forall x y :e A , mul x y :e A.
Axiom god1_subring_contains_one : forall K , forall add mul : set -> set -> set , forall A , subring K add mul A -> ring_one K mul :e A.
Axiom god1_ring_multiplicative_associative : forall K , forall add mul : set -> set -> set , ring K add mul -> associative_on K mul.
Axiom god1_subring_multiplicative_identity : forall K , forall add mul : set -> set -> set , forall A , subring K add mul A -> neutral_element A mul (ring_one K mul).
Axiom god1_subring_induced_ring_core : forall K , forall add mul : set -> set -> set , forall A , subring K add mul A -> ring A add mul.
Axiom god1_subring_induced_ring : forall K , forall add mul : set -> set -> set , forall A , subring K add mul A -> ring A add mul.
Axiom god1_subring_test_forward : forall K , forall add mul : set -> set -> set , forall A , subring K add mul A -> (forall x y :e A , add x y :e A /\ mul x y :e A) /\ ring_negation K add (ring_one K mul) :e A.
Axiom god1_subring_test_reverse : forall K , forall add mul : set -> set -> set , forall A , ring K add mul -> A c= K -> (forall x y :e A , add x y :e A /\ mul x y :e A) /\ ring_negation K add (ring_one K mul) :e A -> subring K add mul A.
Axiom god1_subring_test_using_minus_one : forall K , forall add mul : set -> set -> set , forall A , ring K add mul -> A c= K -> (subring K add mul A <-> (forall x y :e A , add x y :e A /\ mul x y :e A) /\ ring_negation K add (ring_one K mul) :e A).
Definition ring_unit : set -> (set -> set -> set) -> (set -> set -> set) -> set -> prop := fun K add mul x => x :e K /\ exists y :e K , mul y x = ring_one K mul /\ mul x y = ring_one K mul.
Definition ring_inverse : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set := fun K add mul x => Eps_i (fun y => y :e K /\ mul y x = ring_one K mul /\ mul x y = ring_one K mul).
Definition division_ring : set -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K add mul => ring K add mul /\ ring_one K mul <> ring_zero K add /\ forall x :e K , x <> ring_zero K add -> ring_unit K add mul x.
Definition field : set -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K add mul => division_ring K add mul /\ commutative_on K mul.
Definition integral_domain : set -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K add mul => commutative_ring K add mul /\ ring_one K mul <> ring_zero K add /\ forall u v :e K , mul u v = ring_zero K add -> u = ring_zero K add \/ v = ring_zero K add.
Definition ring_units : set -> (set -> set -> set) -> (set -> set -> set) -> set := fun K add mul => {x :e K|ring_unit K add mul x}.
Axiom god1_ring_unit_to_reflexible : forall K , forall add mul : set -> set -> set , forall x , ring_unit K add mul x -> reflexible K mul (ring_one K mul) x.
Axiom god1_reflexible_to_ring_unit : forall K , forall add mul : set -> set -> set , forall x , reflexible K mul (ring_one K mul) x -> ring_unit K add mul x.
Axiom god1_ring_inverse_specification : forall K , forall add mul : set -> set -> set , forall x , ring_unit K add mul x -> reflection K mul (ring_one K mul) x (ring_inverse K add mul x).
Axiom god1_ring_one_is_unit : forall K , forall add mul : set -> set -> set , ring K add mul -> ring_unit K add mul (ring_one K mul).
Axiom god1_ring_unit_product : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x y , ring_unit K add mul x -> ring_unit K add mul y -> ring_unit K add mul (mul x y).
Axiom god1_ring_inverse_is_unit : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x , ring_unit K add mul x -> ring_unit K add mul (ring_inverse K add mul x).
Axiom god1_ring_units_product_closed : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x y :e ring_units K add mul , mul x y :e ring_units K add mul.
Axiom god1_ring_units_inverse_closed : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x :e ring_units K add mul , ring_inverse K add mul x :e ring_units K add mul.
Axiom god1_ring_units_group_core : forall K , forall add mul : set -> set -> set , ring K add mul -> group (ring_units K add mul) mul.
Axiom god1_ring_units_one_neutral : forall K , forall add mul : set -> set -> set , ring K add mul -> neutral_element (ring_units K add mul) mul (ring_one K mul).
Axiom god1_ring_units_inverse_exists : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x :e ring_units K add mul , exists y :e ring_units K add mul , reflection (ring_units K add mul) mul (ring_one K mul) x y.
Axiom god1_ring_units_form_group : forall K , forall add mul : set -> set -> set , ring K add mul -> group (ring_units K add mul) mul.
Axiom god1_division_ring_ring : forall K , forall add mul : set -> set -> set , division_ring K add mul -> ring K add mul.
Axiom god1_division_ring_one_ne_zero : forall K , forall add mul : set -> set -> set , division_ring K add mul -> ring_one K mul <> ring_zero K add.
Axiom god1_division_ring_nonzero_is_unit : forall K , forall add mul : set -> set -> set , division_ring K add mul -> forall x :e K , x <> ring_zero K add -> ring_unit K add mul x.
Axiom god1_ring_unit_nonzero : forall K , forall add mul : set -> set -> set , ring K add mul -> ring_one K mul <> ring_zero K add -> forall x , ring_unit K add mul x -> x <> ring_zero K add.
Axiom god1_division_ring_units_core : forall K , forall add mul : set -> set -> set , division_ring K add mul -> ring_units K add mul = K :\: {ring_zero K add}.
Axiom god1_division_ring_units_are_nonzero_elements : forall K , forall add mul : set -> set -> set , division_ring K add mul -> ring_units K add mul = K :\: {ring_zero K add}.
Definition subfield : set -> (set -> set -> set) -> (set -> set -> set) -> set -> prop := fun K add mul A => field K add mul /\ subring K add mul A /\ forall x :e A , x <> ring_zero K add -> ring_inverse K add mul x :e A.
Axiom god1_subfield_ambient_field : forall K , forall add mul : set -> set -> set , forall A , subfield K add mul A -> field K add mul.
Axiom god1_subfield_subring : forall K , forall add mul : set -> set -> set , forall A , subfield K add mul A -> subring K add mul A.
Axiom god1_subfield_inverse_closed : forall K , forall add mul : set -> set -> set , forall A , subfield K add mul A -> forall x :e A , x <> ring_zero K add -> ring_inverse K add mul x :e A.
Axiom god1_field_division_ring : forall K , forall add mul : set -> set -> set , field K add mul -> division_ring K add mul.
Axiom god1_field_multiplication_commutative : forall K , forall add mul : set -> set -> set , field K add mul -> commutative_on K mul.
Axiom god1_subring_additive_zero_neutral : forall K , forall add mul : set -> set -> set , forall A , subring K add mul A -> neutral_element A add (ring_zero K add).
Axiom god1_subring_zero_eq : forall K , forall add mul : set -> set -> set , forall A , subring K add mul A -> ring_zero A add = ring_zero K add.
Axiom god1_subring_one_eq : forall K , forall add mul : set -> set -> set , forall A , subring K add mul A -> ring_one A mul = ring_one K mul.
Axiom god1_subfield_nonzero_is_unit : forall K , forall add mul : set -> set -> set , forall A , subfield K add mul A -> forall x :e A , x <> ring_zero A add -> ring_unit A add mul x.
Axiom god1_subfield_induced_field_core : forall K , forall add mul : set -> set -> set , forall A , subfield K add mul A -> field A add mul.
Axiom god1_subfield_induced_field : forall K , forall add mul : set -> set -> set , forall A , subfield K add mul A -> field A add mul.
Definition int_mod_multiplication : set -> set -> set -> set := fun p A B => int_mod_class p (mul_SNo (int_mod_representative p A) (int_mod_representative p B)).
Axiom god1_binary_operation_congruence : forall op : set -> set -> set , forall x x' y y' , x = x' -> y = y' -> op x y = op x' y'.
Axiom god1_int_mod_shift_product_left : forall p :e omega , forall x x' y k :e int , x' = add_SNo x (mul_SNo p k) -> mul_SNo x' y = add_SNo (mul_SNo x y) (mul_SNo p (mul_SNo k y)).
Axiom god1_int_mod_shift_product_right : forall p :e omega , forall x y y' l :e int , y' = add_SNo y (mul_SNo p l) -> mul_SNo x y' = add_SNo (mul_SNo x y) (mul_SNo p (mul_SNo x l)).
Axiom god1_int_mod_class_mul_compatible : forall p :e omega , forall x x' y y' :e int , int_mod_class p x = int_mod_class p x' -> int_mod_class p y = int_mod_class p y' -> int_mod_class p (mul_SNo x y) = int_mod_class p (mul_SNo x' y').
Axiom god1_int_mod_multiplication_on_classes : forall p :e omega , forall x y :e int , int_mod_multiplication p (int_mod_class p x) (int_mod_class p y) = int_mod_class p (mul_SNo x y).
Axiom god1_int_mod_multiplication_closed : forall p :e omega , forall A B :e int_mod_quotient p , int_mod_multiplication p A B :e int_mod_quotient p.
Axiom god1_int_mod_addition_commutative_classes : forall p :e omega , forall x y :e int , int_mod_addition p (int_mod_class p x) (int_mod_class p y) = int_mod_addition p (int_mod_class p y) (int_mod_class p x).
Axiom god1_int_mod_multiplication_commutative_classes : forall p :e omega , forall x y :e int , int_mod_multiplication p (int_mod_class p x) (int_mod_class p y) = int_mod_multiplication p (int_mod_class p y) (int_mod_class p x).
Axiom god1_int_mod_multiplication_associative_classes : forall p :e omega , forall x y z :e int , int_mod_multiplication p (int_mod_class p x) (int_mod_multiplication p (int_mod_class p y) (int_mod_class p z)) = int_mod_multiplication p (int_mod_multiplication p (int_mod_class p x) (int_mod_class p y)) (int_mod_class p z).
Axiom god1_int_mod_distributive_classes : forall p :e omega , forall x y z :e int , int_mod_multiplication p (int_mod_class p x) (int_mod_addition p (int_mod_class p y) (int_mod_class p z)) = int_mod_addition p (int_mod_multiplication p (int_mod_class p x) (int_mod_class p y)) (int_mod_multiplication p (int_mod_class p x) (int_mod_class p z)) /\ int_mod_multiplication p (int_mod_addition p (int_mod_class p x) (int_mod_class p y)) (int_mod_class p z) = int_mod_addition p (int_mod_multiplication p (int_mod_class p x) (int_mod_class p z)) (int_mod_multiplication p (int_mod_class p y) (int_mod_class p z)).
Axiom god1_int_mod_addition_commutative : forall p :e omega , commutative_on (int_mod_quotient p) (int_mod_addition p).
Axiom god1_int_mod_multiplication_commutative : forall p :e omega , commutative_on (int_mod_quotient p) (int_mod_multiplication p).
Axiom god1_int_mod_multiplication_associative : forall p :e omega , associative_on (int_mod_quotient p) (int_mod_multiplication p).
Axiom god1_int_mod_distributive : forall p :e omega , forall A B C :e int_mod_quotient p , int_mod_multiplication p A (int_mod_addition p B C) = int_mod_addition p (int_mod_multiplication p A B) (int_mod_multiplication p A C) /\ int_mod_multiplication p (int_mod_addition p A B) C = int_mod_addition p (int_mod_multiplication p A C) (int_mod_multiplication p B C).
Axiom god1_int_mod_one_neutral : forall p :e omega , neutral_element (int_mod_quotient p) (int_mod_multiplication p) (int_mod_class p 1).
Axiom god1_int_mod_additive_abelian_group : forall p :e omega , abelian_group (int_mod_quotient p) (int_mod_addition p).
Axiom god1_int_mod_commutative_ring_core : forall p :e omega , commutative_ring (int_mod_quotient p) (int_mod_addition p) (int_mod_multiplication p).
Axiom god1_integers_modulo_p_form_commutative_ring : forall p :e omega , commutative_ring (int_mod_quotient p) (int_mod_addition p) (int_mod_multiplication p).
Axiom god1_injection_restricts_across_fixed_adjoin : forall X y , y /:e X -> forall f : set -> set , inj (X :\/: {y}) (X :\/: {y}) f -> f y = y -> inj X X f.
Axiom god1_surjection_extends_across_fixed_adjoin : forall X y , y /:e X -> forall f : set -> set , inj (X :\/: {y}) (X :\/: {y}) f -> surj X X f -> f y = y -> surj (X :\/: {y}) (X :\/: {y}) f.
Axiom god1_swap_postcomposition_surjective_transfer : forall X a b , a :e X -> b :e X -> forall f : set -> set , (forall x :e X , f x :e X) -> surj X X (fun x => permutation_swap X a b (f x)) -> surj X X f.
Axiom god1_empty_self_injection_surjective : forall f : set -> set , inj 0 0 f -> surj 0 0 f.
Axiom god1_finite_self_injection_adjoin_step : forall X y , finite X -> y /:e X -> (forall f : set -> set , inj X X f -> surj X X f) -> forall f : set -> set , inj (X :\/: {y}) (X :\/: {y}) f -> surj (X :\/: {y}) (X :\/: {y}) f.
Axiom god1_finite_self_injection_surjective_core : forall X , finite X -> forall f : set -> set , inj X X f -> surj X X f.
Axiom god1_integral_domain_commutative_ring : forall K , forall add mul : set -> set -> set , integral_domain K add mul -> commutative_ring K add mul.
Axiom god1_integral_domain_one_ne_zero : forall K , forall add mul : set -> set -> set , integral_domain K add mul -> ring_one K mul <> ring_zero K add.
Axiom god1_integral_domain_zero_product : forall K , forall add mul : set -> set -> set , integral_domain K add mul -> forall u v :e K , mul u v = ring_zero K add -> u = ring_zero K add \/ v = ring_zero K add.
Axiom god1_commutative_ring_multiply_negation_right : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall x y :e K , mul x (ring_negation K add y) = ring_negation K add (mul x y).
Axiom god1_commutative_ring_equal_products_difference_zero : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall a x y :e K , mul a x = mul a y -> mul a (add x (ring_negation K add y)) = ring_zero K add.
Axiom god1_integral_domain_left_cancel : forall K , forall add mul : set -> set -> set , integral_domain K add mul -> forall a :e K , a <> ring_zero K add -> forall x y :e K , mul a x = mul a y -> x = y.
Axiom god1_integral_domain_left_multiplication_injective : forall K , forall add mul : set -> set -> set , integral_domain K add mul -> forall a :e K , a <> ring_zero K add -> inj K K (fun x => mul a x).
Axiom god1_finite_integral_domain_nonzero_unit : forall K , forall add mul : set -> set -> set , finite K -> integral_domain K add mul -> forall a :e K , a <> ring_zero K add -> ring_unit K add mul a.
Axiom god1_finite_integral_domain_field_core : forall K , forall add mul : set -> set -> set , finite K -> integral_domain K add mul -> field K add mul.
Axiom god1_s8_finite_integral_domain_field_interface : forall K , forall add mul : set -> set -> set , finite K -> integral_domain K add mul -> field K add mul.
Axiom god1_int_mod_modulus_nonzero : forall p :e omega , 1 :e p -> p <> 0.
Axiom god1_int_mod_quotient_eq_reduced_classes : forall p :e omega , 1 :e p -> int_mod_quotient p = {int_mod_class p r|r :e p}.
Axiom god1_int_mod_quotient_finite : forall p :e omega , 1 :e p -> finite (int_mod_quotient p).
Axiom god1_int_mod_class_eq_zero_iff_multiple : forall p :e omega , forall x :e int , (int_mod_class p x = int_mod_class p 0 <-> exists k :e int , x = mul_SNo p k).
Axiom god1_int_mod_ring_zero_eq_class_zero : forall p :e omega , ring_zero (int_mod_quotient p) (int_mod_addition p) = int_mod_class p 0.
Axiom god1_int_mod_ring_one_eq_class_one : forall p :e omega , ring_one (int_mod_quotient p) (int_mod_multiplication p) = int_mod_class p 1.
Axiom god1_int_mod_modulus_not_divide_one : forall p :e omega , 1 :e p -> ~ divides_int p 1.
Axiom god1_field_zero_product : forall K , forall add mul : set -> set -> set , field K add mul -> forall u v :e K , mul u v = ring_zero K add -> u = ring_zero K add \/ v = ring_zero K add.
Axiom god1_field_is_integral_domain : forall K , forall add mul : set -> set -> set , field K add mul -> integral_domain K add mul.
Axiom god1_int_multiple_witness_implies_divides : forall p x :e int , (exists k :e int , x = mul_SNo p k) -> divides_int p x.
Axiom god1_divides_implies_int_multiple_witness : forall p x :e int , divides_int p x -> exists k :e int , x = mul_SNo p k.
Axiom god1_int_multiple_witness_iff_divides : forall p x :e int , ((exists k :e int , x = mul_SNo p k) <-> divides_int p x).
Axiom god1_prime_iff_integer_product_divisibility : forall p :e omega , 1 :e p -> (prime_nat p <-> forall x y :e int , (exists k :e int , mul_SNo x y = mul_SNo p k) -> (exists k :e int , x = mul_SNo p k) \/ (exists k :e int , y = mul_SNo p k)).
Axiom god1_int_mod_ring_one_ne_zero : forall p :e omega , 1 :e p -> ring_one (int_mod_quotient p) (int_mod_multiplication p) <> ring_zero (int_mod_quotient p) (int_mod_addition p).
Axiom god1_int_mod_domain_implies_product_divisibility : forall p :e omega , integral_domain (int_mod_quotient p) (int_mod_addition p) (int_mod_multiplication p) -> forall x y :e int , (exists k :e int , mul_SNo x y = mul_SNo p k) -> (exists k :e int , x = mul_SNo p k) \/ (exists k :e int , y = mul_SNo p k).
Axiom god1_int_mod_product_divisibility_implies_zero_product : forall p :e omega , (forall x y :e int , (exists k :e int , mul_SNo x y = mul_SNo p k) -> (exists k :e int , x = mul_SNo p k) \/ (exists k :e int , y = mul_SNo p k)) -> forall A B :e int_mod_quotient p , int_mod_multiplication p A B = ring_zero (int_mod_quotient p) (int_mod_addition p) -> A = ring_zero (int_mod_quotient p) (int_mod_addition p) \/ B = ring_zero (int_mod_quotient p) (int_mod_addition p).
Axiom god1_int_mod_product_divisibility_implies_domain : forall p :e omega , 1 :e p -> (forall x y :e int , (exists k :e int , mul_SNo x y = mul_SNo p k) -> (exists k :e int , x = mul_SNo p k) \/ (exists k :e int , y = mul_SNo p k)) -> integral_domain (int_mod_quotient p) (int_mod_addition p) (int_mod_multiplication p).
Axiom god1_int_mod_integral_domain_iff_product_divisibility : forall p :e omega , 1 :e p -> (integral_domain (int_mod_quotient p) (int_mod_addition p) (int_mod_multiplication p) <-> forall x y :e int , (exists k :e int , mul_SNo x y = mul_SNo p k) -> (exists k :e int , x = mul_SNo p k) \/ (exists k :e int , y = mul_SNo p k)).
Axiom god1_int_mod_class_product_nonzero_iff_not_multiple : forall p :e omega , forall x y :e int , (int_mod_class p (mul_SNo x y) <> int_mod_class p 0 <-> ~ exists k :e int , mul_SNo x y = mul_SNo p k).
Axiom god1_int_mod_two_representatives : forall p :e omega , forall A B :e int_mod_quotient p , exists x y :e int , A = int_mod_class p x /\ B = int_mod_class p y.
Axiom god1_int_mod_integral_domain_iff_prime : forall p :e omega , 1 :e p -> (integral_domain (int_mod_quotient p) (int_mod_addition p) (int_mod_multiplication p) <-> prime_nat p).
Axiom god1_s8_theorem1_integers_mod_p_domain_field_prime : forall p :e omega , 1 :e p -> (integral_domain (int_mod_quotient p) (int_mod_addition p) (int_mod_multiplication p) <-> field (int_mod_quotient p) (int_mod_addition p) (int_mod_multiplication p)) /\ (field (int_mod_quotient p) (int_mod_addition p) (int_mod_multiplication p) <-> prime_nat p).
Axiom god1_s5_theorem4_finite_injection_is_surjection : forall X , forall f : set -> set , finite X -> inj X X f -> surj X X f.
Axiom god1_s8_theorem2_finite_integral_domain_is_field : forall K , forall add mul : set -> set -> set , finite K -> integral_domain K add mul -> field K add mul.
Definition ring_nat_power : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set := fun K add mul x n => nat_primrec (ring_one K mul) (fun i r => mul r x) n.
Definition finite_cardinality : set -> set := fun X => if X :e omega then X else Eps_i (fun n => n :e omega /\ equip X n).
Definition finite_enumeration : set -> set := fun X => if X :e omega then (fun i :e X => i) else Eps_i (fun f => f :e X :^: finite_cardinality X /\ bij (finite_cardinality X) X (fun i => f i)).
Definition ring_finite_sum : set -> (set -> set -> set) -> set -> (set -> set) -> set := fun K add I f => group_word_product K add (fun i => f (finite_enumeration I i)) (finite_cardinality I).
Definition ring_finite_product : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> set := fun K add mul I f => nat_primrec (ring_one K mul) (fun i r => mul r (f (finite_enumeration I i))) (finite_cardinality I).
Definition binomial_coefficient : set -> set -> set := fun n p => finite_cardinality {A :e Power n|equip A p}.
Definition ring_nat_multiple : set -> (set -> set -> set) -> set -> set -> set := fun K add n x => group_nat_power K add x n.
Axiom god1_finite_cardinality_natural : forall n :e omega , finite_cardinality n = n.
Axiom god1_finite_cardinality_specification : forall X , finite X -> finite_cardinality X :e omega /\ equip X (finite_cardinality X).
Axiom god1_finite_enumeration_natural_eval : forall n :e omega , forall i :e n , finite_enumeration n i = i.
Axiom god1_power_of_natural_finite : forall n :e omega , finite (Power n).
Axiom god1_binomial_subset_family_finite : forall n :e omega , forall p , finite {A :e Power n|equip A p}.
Axiom god1_binomial_coefficient_natural : forall n p :e omega , binomial_coefficient n p :e omega.
Axiom god1_ring_nat_power_zero : forall K , forall add mul : set -> set -> set , forall x , ring_nat_power K add mul x 0 = ring_one K mul.
Axiom god1_ring_nat_power_successor : forall K , forall add mul : set -> set -> set , forall x n , nat_p n -> ring_nat_power K add mul x (ordsucc n) = mul (ring_nat_power K add mul x n) x.
Axiom god1_ring_nat_power_in : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x :e K , forall n :e omega , ring_nat_power K add mul x n :e K.
Axiom god1_ring_nat_multiple_in : forall K , forall add mul : set -> set -> set , ring K add mul -> forall n :e omega , forall x :e K , ring_nat_multiple K add n x :e K.
Axiom god1_ring_finite_sum_natural : forall K , forall add : set -> set -> set , forall n :e omega , forall f : set -> set , ring_finite_sum K add n f = group_word_product K add f n.
Axiom god1_ring_finite_sum_natural_successor : forall K , forall add : set -> set -> set , forall n :e omega , forall f : set -> set , ring_finite_sum K add (ordsucc n) f = add (ring_finite_sum K add n f) (f n).
Axiom god1_positive_natural_successor_union : forall r :e omega , 0 :e r -> r = ordsucc (Union r).
Axiom god1_setminus_singleton_readd : forall A x , x :e A -> (A :\: {x}) :\/: {x} = A.
Axiom god1_adjoin_remove_singleton : forall A x , x /:e A -> (A :\/: {x}) :\: {x} = A.
Axiom god1_remove_new_point_subset : forall n , forall A :e Power (ordsucc n) , A :\: {n} c= n.
Axiom god1_subset_adjoin_new_point_power : forall n , forall C :e Power n , C :\/: {n} :e Power (ordsucc n).
Axiom god1_binomial_containing_new_point_bijection : forall n :e omega , forall r :e omega , 0 :e r -> bij {A :e {B :e Power (ordsucc n)|equip B r}|n :e A} {C :e Power n|equip C (Union r)} (fun A => A :\: {n}).
Axiom god1_subset_successor_without_new_point : forall n A , A c= ordsucc n -> n /:e A -> A c= n.
Axiom god1_binomial_family_split : forall n r , {A :e Power (ordsucc n)|equip A r} = {A :e Power n|equip A r} :\/: {A :e {B :e Power (ordsucc n)|equip B r}|n :e A}.
Axiom god1_binomial_pascal_interior : forall n :e omega , forall r :e omega , 0 :e r -> add_nat (binomial_coefficient n r) (binomial_coefficient n (Union r)) = binomial_coefficient (ordsucc n) r.
Axiom god1_bijection_adjoin_maps_into_finite_set : forall n :e omega , forall A :e Power n , forall y :e n , forall f : set -> set , bij (ordsucc n) (A :\/: {y}) f -> forall i :e ordsucc n , f i :e n.
Axiom god1_finite_subset_missing_point_contradiction : forall n :e omega , forall A :e Power n , forall y :e n , y /:e A -> equip A n -> False.
Axiom god1_finite_subset_equip_self : forall n :e omega , forall A :e Power n , equip A n -> A = n.
Axiom god1_finite_cardinality_eq_one_of_equip_singleton : forall X , equip X 1 -> finite_cardinality X = 1.
Axiom god1_binomial_zero_family_singleton : forall n :e omega , {A :e Power n|equip A 0} = {0}.
Axiom god1_binomial_diagonal_family_singleton : forall n :e omega , {A :e Power n|equip A n} = {n}.
Axiom god1_binomial_coefficient_zero : forall n :e omega , binomial_coefficient n 0 = 1.
Axiom god1_binomial_coefficient_diagonal : forall n :e omega , binomial_coefficient n n = 1.
Axiom god1_ring_additive_commutative : forall K , forall add mul : set -> set -> set , ring K add mul -> commutative_on K add.
Axiom god1_ring_finite_sum_zero_natural : forall K , forall add : set -> set -> set , forall f : set -> set , ring_finite_sum K add 0 f = group_identity K add.
Axiom god1_ring_finite_sum_in_natural : forall K , forall add mul : set -> set -> set , ring K add mul -> forall n :e omega , forall f : set -> set , (forall i :e n , f i :e K) -> ring_finite_sum K add n f :e K.
Axiom god1_ring_finite_sum_congr_natural : forall K , forall add : set -> set -> set , forall n :e omega , forall f g : set -> set , (forall i :e n , f i = g i) -> ring_finite_sum K add n f = ring_finite_sum K add n g.
Axiom god1_group_associative_reverse : forall K , forall add : set -> set -> set , group K add -> forall a b c :e K , add (add a b) c = add a (add b c).
Axiom god1_abelian_four_term_interchange : forall K , forall add : set -> set -> set , abelian_group K add -> forall a b c d :e K , add (add a b) (add c d) = add (add a c) (add b d).
Axiom god1_ring_finite_sum_head_tail_zero : forall K , forall add mul : set -> set -> set , ring K add mul -> forall f : set -> set , (forall i :e ordsucc 0 , f i :e K) -> ring_finite_sum K add (ordsucc 0) f = add (f 0) (ring_finite_sum K add 0 (fun i => f (ordsucc i))).
Axiom god1_ring_finite_sum_head_tail_step : forall K , forall add mul : set -> set -> set , ring K add mul -> forall f : set -> set , forall n , nat_p n -> ((forall i :e ordsucc n , f i :e K) -> ring_finite_sum K add (ordsucc n) f = add (f 0) (ring_finite_sum K add n (fun i => f (ordsucc i)))) -> (forall i :e ordsucc (ordsucc n) , f i :e K) -> ring_finite_sum K add (ordsucc (ordsucc n)) f = add (f 0) (ring_finite_sum K add (ordsucc n) (fun i => f (ordsucc i))).
Axiom god1_ring_finite_sum_head_tail : forall K , forall add mul : set -> set -> set , ring K add mul -> forall f : set -> set , forall n :e omega , (forall i :e ordsucc n , f i :e K) -> ring_finite_sum K add (ordsucc n) f = add (f 0) (ring_finite_sum K add n (fun i => f (ordsucc i))).
Axiom god1_ring_finite_sum_pointwise_add_zero : forall K , forall add mul : set -> set -> set , ring K add mul -> forall f g : set -> set , (forall i :e 0 , f i :e K) -> (forall i :e 0 , g i :e K) -> ring_finite_sum K add 0 (fun i => add (f i) (g i)) = add (ring_finite_sum K add 0 f) (ring_finite_sum K add 0 g).
Axiom god1_ring_finite_sum_pointwise_add_step : forall K , forall add mul : set -> set -> set , ring K add mul -> forall f g : set -> set , forall n , nat_p n -> ((forall i :e n , f i :e K) -> (forall i :e n , g i :e K) -> ring_finite_sum K add n (fun i => add (f i) (g i)) = add (ring_finite_sum K add n f) (ring_finite_sum K add n g)) -> (forall i :e ordsucc n , f i :e K) -> (forall i :e ordsucc n , g i :e K) -> ring_finite_sum K add (ordsucc n) (fun i => add (f i) (g i)) = add (ring_finite_sum K add (ordsucc n) f) (ring_finite_sum K add (ordsucc n) g).
Axiom god1_ring_finite_sum_pointwise_add : forall K , forall add mul : set -> set -> set , ring K add mul -> forall n :e omega , forall f g : set -> set , (forall i :e n , f i :e K) -> (forall i :e n , g i :e K) -> ring_finite_sum K add n (fun i => add (f i) (g i)) = add (ring_finite_sum K add n f) (ring_finite_sum K add n g).
Axiom god1_ring_nat_multiple_one : forall K , forall add mul : set -> set -> set , ring K add mul -> forall z :e K , ring_nat_multiple K add 1 z = z.
Axiom god1_ring_nat_multiple_add_coefficients : forall K , forall add mul : set -> set -> set , ring K add mul -> forall z :e K , forall a b :e omega , add (ring_nat_multiple K add a z) (ring_nat_multiple K add b z) = ring_nat_multiple K add (add_nat a b) z.
Axiom god1_ring_nat_multiple_right_mul_zero : forall K , forall add mul : set -> set -> set , ring K add mul -> forall z w :e K , mul (ring_nat_multiple K add 0 z) w = ring_nat_multiple K add 0 (mul z w).
Axiom god1_ring_nat_multiple_right_mul_step : forall K , forall add mul : set -> set -> set , ring K add mul -> forall z w :e K , forall n , nat_p n -> mul (ring_nat_multiple K add n z) w = ring_nat_multiple K add n (mul z w) -> mul (ring_nat_multiple K add (ordsucc n) z) w = ring_nat_multiple K add (ordsucc n) (mul z w).
Axiom god1_ring_nat_multiple_right_mul : forall K , forall add mul : set -> set -> set , ring K add mul -> forall z w :e K , forall n :e omega , mul (ring_nat_multiple K add n z) w = ring_nat_multiple K add n (mul z w).
Axiom god1_ring_finite_sum_right_mul_zero : forall K , forall add mul : set -> set -> set , ring K add mul -> forall f : set -> set , forall z :e K , (forall i :e 0 , f i :e K) -> mul (ring_finite_sum K add 0 f) z = ring_finite_sum K add 0 (fun i => mul (f i) z).
Axiom god1_ring_finite_sum_right_mul_step : forall K , forall add mul : set -> set -> set , ring K add mul -> forall f : set -> set , forall z :e K , forall n , nat_p n -> ((forall i :e n , f i :e K) -> mul (ring_finite_sum K add n f) z = ring_finite_sum K add n (fun i => mul (f i) z)) -> (forall i :e ordsucc n , f i :e K) -> mul (ring_finite_sum K add (ordsucc n) f) z = ring_finite_sum K add (ordsucc n) (fun i => mul (f i) z).
Axiom god1_ring_finite_sum_right_mul : forall K , forall add mul : set -> set -> set , ring K add mul -> forall n :e omega , forall f : set -> set , (forall i :e n , f i :e K) -> forall z :e K , mul (ring_finite_sum K add n f) z = ring_finite_sum K add n (fun i => mul (f i) z).
Axiom god1_nat_sub_witness_zero : forall n :e omega , nat_sub_witness 0 n = n.
Axiom god1_nat_sub_witness_successor_top : forall n :e omega , forall p :e ordsucc n , nat_sub_witness p (ordsucc n) = ordsucc (nat_sub_witness p n).
Axiom god1_nat_sub_witness_shift_both_successor : forall n :e omega , forall p :e ordsucc n , nat_sub_witness (ordsucc p) (ordsucc n) = nat_sub_witness p n.
Axiom god1_ring_multiplicative_associative_reverse : forall K , forall add mul : set -> set -> set , ring K add mul -> forall a b c :e K , mul (mul a b) c = mul a (mul b c).
Axiom god1_ring_nat_power_successor_reverse : forall K , forall add mul : set -> set -> set , forall x n , nat_p n -> mul (ring_nat_power K add mul x n) x = ring_nat_power K add mul x (ordsucc n).
Axiom god1_ring_power_commutes_with_element_zero : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x y :e K , mul x y = mul y x -> mul (ring_nat_power K add mul y 0) x = mul x (ring_nat_power K add mul y 0).
Axiom god1_ring_power_commutes_with_element_step : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x y :e K , mul x y = mul y x -> forall n , nat_p n -> mul (ring_nat_power K add mul y n) x = mul x (ring_nat_power K add mul y n) -> mul (ring_nat_power K add mul y (ordsucc n)) x = mul x (ring_nat_power K add mul y (ordsucc n)).
Axiom god1_ring_power_commutes_with_element : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x y :e K , mul x y = mul y x -> forall n :e omega , mul (ring_nat_power K add mul y n) x = mul x (ring_nat_power K add mul y n).
Axiom god1_ring_monomial_right_x : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x y :e K , mul x y = mul y x -> forall q p :e omega , mul (mul (ring_nat_power K add mul x q) (ring_nat_power K add mul y p)) x = mul (ring_nat_power K add mul x (ordsucc q)) (ring_nat_power K add mul y p).
Axiom god1_ring_monomial_right_y : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x y :e K , forall q p :e omega , mul (mul (ring_nat_power K add mul x q) (ring_nat_power K add mul y p)) y = mul (ring_nat_power K add mul x q) (ring_nat_power K add mul y (ordsucc p)).
Axiom god1_ring_finite_sum_adjacent_pairing_left : forall K , forall add mul : set -> set -> set , ring K add mul -> forall n :e omega , forall f g u : set -> set , (forall i :e ordsucc n , f i :e K) -> (forall i :e ordsucc n , g i :e K) -> add (ring_finite_sum K add n (fun i => f (ordsucc i))) (ring_finite_sum K add n g) = ring_finite_sum K add n (fun i => u (ordsucc i)) -> add (ring_finite_sum K add (ordsucc n) f) (ring_finite_sum K add (ordsucc n) g) = add (f 0) (add (ring_finite_sum K add n (fun i => u (ordsucc i))) (g n)).
Axiom god1_ring_finite_sum_adjacent_pairing_right : forall K , forall add mul : set -> set -> set , ring K add mul -> forall n :e omega , forall f g u : set -> set , (forall i :e ordsucc (ordsucc n) , u i :e K) -> u 0 = f 0 -> u (ordsucc n) = g n -> ring_finite_sum K add (ordsucc (ordsucc n)) u = add (f 0) (add (ring_finite_sum K add n (fun i => u (ordsucc i))) (g n)).
Axiom god1_ring_finite_sum_adjacent_pairing : forall K , forall add mul : set -> set -> set , ring K add mul -> forall n :e omega , forall f g u : set -> set , (forall i :e ordsucc n , f i :e K) -> (forall i :e ordsucc n , g i :e K) -> (forall i :e ordsucc (ordsucc n) , u i :e K) -> u 0 = f 0 -> (forall i :e n , u (ordsucc i) = add (f (ordsucc i)) (g i)) -> u (ordsucc n) = g n -> add (ring_finite_sum K add (ordsucc n) f) (ring_finite_sum K add (ordsucc n) g) = ring_finite_sum K add (ordsucc (ordsucc n)) u.
Definition god1_ring_binomial_term : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set -> set -> set := fun K add mul x y n p => ring_nat_multiple K add (binomial_coefficient n p) (mul (ring_nat_power K add mul x (nat_sub_witness p n)) (ring_nat_power K add mul y p)).
Definition god1_ring_binomial_first_step : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set -> set -> set := fun K add mul x y n p => ring_nat_multiple K add (binomial_coefficient n p) (mul (ring_nat_power K add mul x (nat_sub_witness p (ordsucc n))) (ring_nat_power K add mul y p)).
Definition god1_ring_binomial_second_step : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set -> set -> set := fun K add mul x y n p => ring_nat_multiple K add (binomial_coefficient n p) (mul (ring_nat_power K add mul x (nat_sub_witness (ordsucc p) (ordsucc n))) (ring_nat_power K add mul y (ordsucc p))).
Axiom god1_nat_sub_witness_bounded_natural : forall n :e omega , forall p :e ordsucc n , nat_sub_witness p n :e omega.
Axiom god1_ring_binomial_term_in : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x y :e K , forall n :e omega , forall p :e ordsucc n , god1_ring_binomial_term K add mul x y n p :e K.
Axiom god1_ring_binomial_first_step_in : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x y :e K , forall n :e omega , forall p :e ordsucc n , god1_ring_binomial_first_step K add mul x y n p :e K.
Axiom god1_ring_binomial_second_step_in : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x y :e K , forall n :e omega , forall p :e ordsucc n , god1_ring_binomial_second_step K add mul x y n p :e K.
Axiom god1_ring_binomial_term_right_x : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x y :e K , mul x y = mul y x -> forall n :e omega , forall p :e ordsucc n , mul (god1_ring_binomial_term K add mul x y n p) x = god1_ring_binomial_first_step K add mul x y n p.
Axiom god1_ring_binomial_term_right_y : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x y :e K , forall n :e omega , forall p :e ordsucc n , mul (god1_ring_binomial_term K add mul x y n p) y = god1_ring_binomial_second_step K add mul x y n p.
Axiom god1_binomial_pascal_successor_index : forall n :e omega , forall i :e n , add_nat (binomial_coefficient n (ordsucc i)) (binomial_coefficient n i) = binomial_coefficient (ordsucc n) (ordsucc i).
Axiom god1_ring_binomial_pairing_zero : forall K , forall add mul : set -> set -> set , forall x y n , n :e omega -> god1_ring_binomial_term K add mul x y (ordsucc n) 0 = god1_ring_binomial_first_step K add mul x y n 0.
Axiom god1_ring_binomial_pairing_last : forall K , forall add mul : set -> set -> set , forall x y n , n :e omega -> god1_ring_binomial_term K add mul x y (ordsucc n) (ordsucc n) = god1_ring_binomial_second_step K add mul x y n n.
Axiom god1_ring_binomial_pairing_middle : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x y :e K , forall n :e omega , forall i :e n , god1_ring_binomial_term K add mul x y (ordsucc n) (ordsucc i) = add (god1_ring_binomial_first_step K add mul x y n (ordsucc i)) (god1_ring_binomial_second_step K add mul x y n i).
Axiom god1_ring_binomial_step_pairing : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x y :e K , forall n :e omega , add (ring_finite_sum K add (ordsucc n) (fun p => god1_ring_binomial_first_step K add mul x y n p)) (ring_finite_sum K add (ordsucc n) (fun p => god1_ring_binomial_second_step K add mul x y n p)) = ring_finite_sum K add (ordsucc (ordsucc n)) (fun p => god1_ring_binomial_term K add mul x y (ordsucc n) p).
Axiom god1_ring_binomial_induction_expansion : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x y :e K , mul x y = mul y x -> forall n :e omega , ring_nat_power K add mul (add x y) n = ring_finite_sum K add (ordsucc n) (fun p => god1_ring_binomial_term K add mul x y n p) -> ring_nat_power K add mul (add x y) (ordsucc n) = add (ring_finite_sum K add (ordsucc n) (fun p => god1_ring_binomial_first_step K add mul x y n p)) (ring_finite_sum K add (ordsucc n) (fun p => god1_ring_binomial_second_step K add mul x y n p)).
Axiom god1_ring_binomial_induction_step : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x y :e K , mul x y = mul y x -> forall n :e omega , ring_nat_power K add mul (add x y) n = ring_finite_sum K add (ordsucc n) (fun p => god1_ring_binomial_term K add mul x y n p) -> ring_nat_power K add mul (add x y) (ordsucc n) = ring_finite_sum K add (ordsucc (ordsucc n)) (fun p => god1_ring_binomial_term K add mul x y (ordsucc n) p).
Axiom god1_ring_nat_power_one : forall K , forall add mul : set -> set -> set , ring K add mul -> forall z :e K , ring_nat_power K add mul z 1 = z.
Axiom god1_ring_binomial_zero_monomial : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x y :e K , mul (ring_nat_power K add mul x (nat_sub_witness 0 0)) (ring_nat_power K add mul y 0) = ring_one K mul.
Axiom god1_ring_binomial_term_zero_zero : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x y :e K , god1_ring_binomial_term K add mul x y 0 0 = ring_one K mul.
Axiom god1_ring_binomial_sum_zero : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x y :e K , ring_finite_sum K add (ordsucc 0) (fun p => god1_ring_binomial_term K add mul x y 0 p) = ring_one K mul.
Axiom god1_ring_binomial_base_zero : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x y :e K , ring_nat_power K add mul (add x y) 0 = ring_finite_sum K add (ordsucc 0) (fun p => god1_ring_binomial_term K add mul x y 0 p).
Axiom god1_ring_binomial_induction_step_nat : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x y :e K , mul x y = mul y x -> forall n , nat_p n -> ring_nat_power K add mul (add x y) n = ring_finite_sum K add (ordsucc n) (fun p => god1_ring_binomial_term K add mul x y n p) -> ring_nat_power K add mul (add x y) (ordsucc n) = ring_finite_sum K add (ordsucc (ordsucc n)) (fun p => god1_ring_binomial_term K add mul x y (ordsucc n) p).
Axiom god1_ring_binomial_theorem_core : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x y :e K , mul x y = mul y x -> forall n :e omega , ring_nat_power K add mul (add x y) n = ring_finite_sum K add (ordsucc n) (fun p => god1_ring_binomial_term K add mul x y n p).
Axiom god1_union_zero : Union 0 = 0.
Axiom god1_union_natural_in_omega : forall r :e omega , Union r :e omega.
Axiom god1_s8_theorem3_binomial_theorem : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x y :e K , mul x y = mul y x -> forall n :e omega , 0 :e n -> ring_nat_power K add mul (add x y) n = ring_finite_sum K add (ordsucc n) (fun p => ring_nat_multiple K add (binomial_coefficient n p) (mul (ring_nat_power K add mul x (nat_sub_witness p n)) (ring_nat_power K add mul y p))).
Axiom god1_abelian_word_product_adjacent_swap_end : forall G , forall op : set -> set -> set , abelian_group G op -> forall i , nat_p i -> forall f : set -> set , (forall k :e ordsucc (ordsucc i) , f k :e G) -> group_word_product G op (fun k => f (permutation_swap (ordsucc (ordsucc i)) i (ordsucc i) k)) (ordsucc (ordsucc i)) = group_word_product G op f (ordsucc (ordsucc i)).
Axiom god1_adjacent_map_eq_swap : forall n i , forall t : set -> set , i :e n -> ordsucc i :e n -> t i = ordsucc i -> t (ordsucc i) = i -> (forall k :e n , k <> i -> k <> ordsucc i -> t k = k) -> forall k :e n , t k = permutation_swap n i (ordsucc i) k.
