Definition divides_int : set -> set -> prop := fun m n => m :e int /\ n :e int /\ exists k :e int , m * k = n.
Axiom divides_int_ref : forall n :e int , divides_int n n.
Axiom divides_int_0 : forall n :e int , divides_int n 0.
Axiom divides_int_add_SNo : forall m n k , divides_int m n -> divides_int m k -> divides_int m (n + k).
Axiom divides_int_mul_SNo : forall m n m' n' , divides_int m m' -> divides_int n n' -> divides_int (m * n) (m' * n').
Axiom divides_nat_divides_int : forall m n , divides_nat m n -> divides_int m n.
Axiom divides_int_divides_nat : forall m n :e omega , divides_int m n -> divides_nat m n.
Axiom divides_int_minus_SNo : forall m n , divides_int m n -> divides_int m (- n).
