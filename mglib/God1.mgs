Axiom god1_adapted_basis_descent_step_specification : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall u F : set -> set , forall q :e omega , forall r :e q , forall p :e omega , forall b : set -> set , finite_dimensional_vector_space K addK mulK E addE smul -> module_endomorphism K addK mulK E addE smul u -> vector_subspace K addK mulK E addE smul (F (natural_difference (ordsucc q) r)) -> vector_subspace K addK mulK E addE smul (F (natural_difference (ordsucc q) (ordsucc r))) -> (forall x :e F (natural_difference (ordsucc q) r) , u x :e F (natural_difference (ordsucc q) (ordsucc r))) -> inj (F (natural_difference (ordsucc q) r)) (F (natural_difference (ordsucc q) (ordsucc r))) u -> module_basis K addK mulK (F (natural_difference (ordsucc q) r)) addE smul p b -> god1_adapted_basis_descent_step_index K addK mulK E addE smul u F q r p b :e omega /\ p c= god1_adapted_basis_descent_step_index K addK mulK E addE smul u F q r p b /\ module_basis K addK mulK (F (natural_difference (ordsucc q) (ordsucc r))) addE smul (god1_adapted_basis_descent_step_index K addK mulK E addE smul u F q r p b) (god1_adapted_basis_descent_step_family K addK mulK E addE smul u F q r p b) /\ forall i :e p , god1_adapted_basis_descent_step_family K addK mulK E addE smul u F q r p b i = u (b i).
