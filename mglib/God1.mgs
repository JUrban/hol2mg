Axiom god1_basis_tail_projection_intertwines_invariant_first_line : forall K , forall add mul : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall n :e omega , forall b u : set -> set , module_basis K add mul E addE smul (ordsucc n) b -> module_endomorphism K add mul E addE smul u -> u (b 0) = module_zero E addE -> forall y :e E , god1_basis_tail_projection K add mul E addE smul n b (u y) = god1_canonical_matrix_endomorphism K add mul n (matrix_submatrix n n ordsucc ordsucc (endomorphism_coordinate_matrix K add mul E addE smul (ordsucc n) b u)) (god1_basis_tail_projection K add mul E addE smul n b y).
