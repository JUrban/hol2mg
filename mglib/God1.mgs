Axiom lower_darboux_integral_Icc_Le_upper_darboux_integral_Icc : forall a b :e R , a <= b -> forall f : set -> set , bounded_fun (Icc a b) f -> lower_darboux_integral_Icc a b f <= upper_darboux_integral_Icc a b f.
