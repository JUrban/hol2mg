Axiom upper_darboux_sums_Icc_scale_neg : forall a b :e R , a <= b -> forall f : set -> set , bounded_fun (Icc a b) f -> forall alpha :e R , alpha < 0 -> upper_darboux_sums_Icc a b (fun x => alpha * (f x)) = mul_const_set alpha (lower_darboux_sums_Icc a b f).
Axiom bounded_above_neg_set_of_bounded_below : forall S , S c= R -> bounded_below S -> bounded_above (neg_set S).
Axiom has_lub_neg_set_of_has_glb : forall S , S c= R -> nonempty S -> has_glb S -> has_lub (neg_set S).
Axiom lower_darboux_integral_Icc_add_Le : forall a b :e R , a <= b -> forall f g : set -> set , bounded_fun (Icc a b) f -> bounded_fun (Icc a b) g -> lower_darboux_integral_Icc a b f + lower_darboux_integral_Icc a b g <= lower_darboux_integral_Icc a b (fun x => (f x) + (g x)).
