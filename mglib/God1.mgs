Axiom riemann_integrable_Icc_exists_partition_gap_lt : forall a b :e R , a <= b -> forall f : set -> set , riemann_integrable_Icc a b f -> forall eps :e R , 0 < eps -> exists n :e omega , exists p : set -> set , is_partition_seq_Icc a b n p /\ (darboux_sum_upper_seq f n p + (- (darboux_sum_lower_seq f n p))) < eps.
