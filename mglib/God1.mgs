Axiom god1_bilinear_mapping_determined_by_basis_values : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall Y , forall addY smulY : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall m n :e omega , forall a b : set -> set , forall f g : set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX m a -> module_basis K addK mulK Y addY smulY n b -> left_module K addK mulK M addM smulM -> bilinear_mapping K addK mulK X addX smulX Y addY smulY M addM smulM f -> bilinear_mapping K addK mulK X addX smulX Y addY smulY M addM smulM g -> (forall i :e m , forall j :e n , f (bilinear_tuple (a i) (b j)) = g (bilinear_tuple (a i) (b j))) -> forall z :e indexed_module_product 2 (fun i => if i = 0 then X else Y) , f z = g z.
Axiom god1_bilinear_form_with_prescribed_basis_values : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall Y , forall addY smulY : set -> set -> set , forall m n :e omega , forall a b : set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX m a -> module_basis K addK mulK Y addY smulY n b -> forall theta :e K :^: (m :*: n) , exists F :e multilinear_mapping_space K addK mulK 2 (fun i => if i = 0 then X else Y) (fun i x y => if i = 0 then addX x y else addY x y) (fun i scalar x => if i = 0 then smulX scalar x else smulY scalar x) K addK mulK , forall u :e m :*: n , F (bilinear_tuple (a (u 0)) (b (u 1))) = theta u.
Axiom god1_bilinear_basis_tuple_in : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall Y , forall addY smulY : set -> set -> set , forall m n , forall a b : set -> set , module_basis K addK mulK X addX smulX m a -> module_basis K addK mulK Y addY smulY n b -> forall u :e m :*: n , bilinear_tuple (a (u 0)) (b (u 1)) :e indexed_module_product 2 (fun i => if i = 0 then X else Y).
Definition bilinear_basis_coefficients : set -> set -> (set -> set) -> (set -> set) -> set -> set := fun m n a b F => fun u :e m :*: n => F (bilinear_tuple (a (u 0)) (b (u 1))).
Axiom god1_bilinear_basis_coefficients_eval : forall m n , forall a b : set -> set , forall F u , u :e m :*: n -> bilinear_basis_coefficients m n a b F u = F (bilinear_tuple (a (u 0)) (b (u 1))).
Axiom god1_bilinear_basis_coefficients_pair_eval : forall m n , forall a b : set -> set , forall F i j , i :e m -> j :e n -> bilinear_basis_coefficients m n a b F (i,j) = F (bilinear_tuple (a i) (b j)).
Axiom god1_bilinear_basis_coefficient_isomorphism : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall Y , forall addY smulY : set -> set -> set , forall m n :e omega , forall a b : set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX m a -> module_basis K addK mulK Y addY smulY n b -> module_isomorphism K addK mulK (multilinear_mapping_space K addK mulK 2 (fun i => if i = 0 then X else Y) (fun i x y => if i = 0 then addX x y else addY x y) (fun i scalar x => if i = 0 then smulX scalar x else smulY scalar x) K addK mulK) (multilinear_mapping_addition (indexed_module_product 2 (fun i => if i = 0 then X else Y)) addK) (multilinear_mapping_scalar (indexed_module_product 2 (fun i => if i = 0 then X else Y)) mulK) (K :^: (m :*: n)) (module_power_addition (m :*: n) addK) (module_power_left_scalar (m :*: n) mulK) (fun F => bilinear_basis_coefficients m n a b F).
Axiom god1_bilinear_tensor_form_in : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall Y , forall addY smulY : set -> set -> set , forall m n , forall a b : set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX m a -> module_basis K addK mulK Y addY smulY n b -> forall u :e m :*: n , (fun z :e indexed_module_product 2 (fun i => if i = 0 then X else Y) => mulK (basis_coordinate_function K addK mulK X addX smulX m a (u 0) (z 0)) (basis_coordinate_function K addK mulK Y addY smulY n b (u 1) (z 1))) :e multilinear_mapping_space K addK mulK 2 (fun i => if i = 0 then X else Y) (fun i x y => if i = 0 then addX x y else addY x y) (fun i scalar x => if i = 0 then smulX scalar x else smulY scalar x) K addK mulK.
Axiom god1_setprod_kronecker_product : forall K , forall addK mulK : set -> set -> set , forall A B , ring K addK mulK -> forall u :e A :*: B , forall v :e A :*: B , mulK (if u 0 = v 0 then ring_one K mulK else ring_zero K addK) (if u 1 = v 1 then ring_one K mulK else ring_zero K addK) = if v = u then ring_one K mulK else ring_zero K addK.
Axiom god1_bilinear_tensor_coefficients_canonical : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall Y , forall addY smulY : set -> set -> set , forall m n :e omega , forall a b : set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX m a -> module_basis K addK mulK Y addY smulY n b -> forall u :e m :*: n , bilinear_basis_coefficients m n a b (fun z :e indexed_module_product 2 (fun i => if i = 0 then X else Y) => mulK (basis_coordinate_function K addK mulK X addX smulX m a (u 0) (z 0)) (basis_coordinate_function K addK mulK Y addY smulY n b (u 1) (z 1))) = canonical_module_basis_vector K addK mulK (m :*: n) u.
Axiom god1_bilinear_tensor_basis : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall Y , forall addY smulY : set -> set -> set , forall m n :e omega , forall a b : set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX m a -> module_basis K addK mulK Y addY smulY n b -> module_basis K addK mulK (multilinear_mapping_space K addK mulK 2 (fun i => if i = 0 then X else Y) (fun i x y => if i = 0 then addX x y else addY x y) (fun i scalar x => if i = 0 then smulX scalar x else smulY scalar x) K addK mulK) (multilinear_mapping_addition (indexed_module_product 2 (fun i => if i = 0 then X else Y)) addK) (multilinear_mapping_scalar (indexed_module_product 2 (fun i => if i = 0 then X else Y)) mulK) (m :*: n) (fun u => fun z :e indexed_module_product 2 (fun i => if i = 0 then X else Y) => mulK (basis_coordinate_function K addK mulK X addX smulX m a (u 0) (z 0)) (basis_coordinate_function K addK mulK Y addY smulY n b (u 1) (z 1))).
Axiom god1_neq_two_one : 2 <> 1.
Axiom god1_trilinear_component_in : forall X Y Z , forall x :e X , forall y :e Y , forall z :e Z , forall i :e 3 , (if i = 0 then x else if i = 1 then y else z) :e (if i = 0 then X else if i = 1 then Y else Z).
Axiom god1_trilinear_tuple_in : forall X Y Z , forall x :e X , forall y :e Y , forall z :e Z , trilinear_tuple x y z :e indexed_module_product 3 (fun i => if i = 0 then X else if i = 1 then Y else Z).
Axiom god1_trilinear_tuple_eval_zero : forall x y z , trilinear_tuple x y z 0 = x.
Axiom god1_trilinear_tuple_eval_one : forall x y z , trilinear_tuple x y z 1 = y.
Axiom god1_trilinear_tuple_eval_two : forall x y z , trilinear_tuple x y z 2 = z.
Axiom god1_trilinear_tuple_update_zero : forall X Y Z , forall x :e X , forall y :e Y , forall z :e Z , forall u :e X , indexed_function_update 3 (trilinear_tuple x y z) 0 u = trilinear_tuple u y z.
Axiom god1_trilinear_tuple_update_one : forall X Y Z , forall x :e X , forall y :e Y , forall z :e Z , forall v :e Y , indexed_function_update 3 (trilinear_tuple x y z) 1 v = trilinear_tuple x v z.
Axiom god1_trilinear_tuple_update_two : forall X Y Z , forall x :e X , forall y :e Y , forall z :e Z , forall w :e Z , indexed_function_update 3 (trilinear_tuple x y z) 2 w = trilinear_tuple x y w.
Axiom god1_multilinear_mapping_coordinate_combination : forall K , forall addK mulK : set -> set -> set , forall I , forall X : set -> set , forall addX smulX : set -> set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , multilinear_mapping K addK mulK I X addX smulX M addM smulM f -> forall i :e I , forall x :e indexed_module_product I X , forall u v :e X i , forall scalar mu :e K , f (indexed_function_update I x i (addX i (smulX i scalar u) (smulX i mu v))) = addM (smulM scalar (f (indexed_function_update I x i u))) (smulM mu (f (indexed_function_update I x i v))).
Axiom god1_trilinear_first_slice_linear : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall Y , forall addY smulY : set -> set -> set , forall Z , forall addZ smulZ : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , left_module K addK mulK X addX smulX -> left_module K addK mulK Y addY smulY -> left_module K addK mulK Z addZ smulZ -> left_module K addK mulK M addM smulM -> trilinear_mapping K addK mulK X addX smulX Y addY smulY Z addZ smulZ M addM smulM f -> forall y :e Y , forall z :e Z , module_homomorphism K addK mulK X addX smulX M addM smulM (fun x => f (trilinear_tuple x y z)).
Axiom god1_trilinear_second_slice_linear : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall Y , forall addY smulY : set -> set -> set , forall Z , forall addZ smulZ : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , left_module K addK mulK X addX smulX -> left_module K addK mulK Y addY smulY -> left_module K addK mulK Z addZ smulZ -> left_module K addK mulK M addM smulM -> trilinear_mapping K addK mulK X addX smulX Y addY smulY Z addZ smulZ M addM smulM f -> forall x :e X , forall y :e Y , forall z :e Z , module_homomorphism K addK mulK Y addY smulY M addM smulM (fun y => f (trilinear_tuple x y z)).
Axiom god1_trilinear_third_slice_linear : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall Y , forall addY smulY : set -> set -> set , forall Z , forall addZ smulZ : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , left_module K addK mulK X addX smulX -> left_module K addK mulK Y addY smulY -> left_module K addK mulK Z addZ smulZ -> left_module K addK mulK M addM smulM -> trilinear_mapping K addK mulK X addX smulX Y addY smulY Z addZ smulZ M addM smulM f -> forall x :e X , forall y :e Y , forall z :e Z , module_homomorphism K addK mulK Z addZ smulZ M addM smulM (fun z => f (trilinear_tuple x y z)).
Axiom god1_bilinear_mapping_of_linear_slices : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall Y , forall addY smulY : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , commutative_ring K addK mulK -> left_module K addK mulK X addX smulX -> left_module K addK mulK Y addY smulY -> left_module K addK mulK M addM smulM -> (forall x :e X , forall y :e Y , module_homomorphism K addK mulK X addX smulX M addM smulM (fun u => f (bilinear_tuple u y))) -> (forall x :e X , forall y :e Y , module_homomorphism K addK mulK Y addY smulY M addM smulM (fun v => f (bilinear_tuple x v))) -> bilinear_mapping K addK mulK X addX smulX Y addY smulY M addM smulM f.
Axiom god1_trilinear_fixed_first_bilinear : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall Y , forall addY smulY : set -> set -> set , forall Z , forall addZ smulZ : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , commutative_ring K addK mulK -> left_module K addK mulK X addX smulX -> left_module K addK mulK Y addY smulY -> left_module K addK mulK Z addZ smulZ -> left_module K addK mulK M addM smulM -> trilinear_mapping K addK mulK X addX smulX Y addY smulY Z addZ smulZ M addM smulM f -> forall x :e X , bilinear_mapping K addK mulK Y addY smulY Z addZ smulZ M addM smulM (fun q : set => f (trilinear_tuple x (q 0) (q 1))).
Axiom god1_bilinear_basis_expansion_canonical : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall Y , forall addY smulY : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall m n :e omega , forall a b : set -> set , forall f : set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX m a -> module_basis K addK mulK Y addY smulY n b -> left_module K addK mulK M addM smulM -> bilinear_mapping K addK mulK X addX smulX Y addY smulY M addM smulM f -> forall x :e X , forall y :e Y , f (bilinear_tuple x y) = module_finitely_supported_sum M addM (m :*: n) (fun u => smulM (mulK (basis_coordinates K addK mulK X addX smulX m a x (u 0)) (basis_coordinates K addK mulK Y addY smulY n b y (u 1))) (f (bilinear_tuple (a (u 0)) (b (u 1))))).
Axiom god1_trilinear_fixed_first_basis_expansion : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall Y , forall addY smulY : set -> set -> set , forall Z , forall addZ smulZ : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall n p :e omega , forall b c : set -> set , forall f : set -> set , commutative_ring K addK mulK -> left_module K addK mulK X addX smulX -> module_basis K addK mulK Y addY smulY n b -> module_basis K addK mulK Z addZ smulZ p c -> left_module K addK mulK M addM smulM -> trilinear_mapping K addK mulK X addX smulX Y addY smulY Z addZ smulZ M addM smulM f -> forall x :e X , forall y :e Y , forall z :e Z , f (trilinear_tuple x y z) = module_finitely_supported_sum M addM (n :*: p) (fun u => smulM (mulK (basis_coordinates K addK mulK Y addY smulY n b y (u 0)) (basis_coordinates K addK mulK Z addZ smulZ p c z (u 1))) (f (trilinear_tuple x (b (u 0)) (c (u 1))))).
Axiom god1_trilinear_basis_expansion_canonical : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall Y , forall addY smulY : set -> set -> set , forall Z , forall addZ smulZ : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall m n p :e omega , forall a b c : set -> set , forall f : set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX m a -> module_basis K addK mulK Y addY smulY n b -> module_basis K addK mulK Z addZ smulZ p c -> left_module K addK mulK M addM smulM -> trilinear_mapping K addK mulK X addX smulX Y addY smulY Z addZ smulZ M addM smulM f -> forall x :e X , forall y :e Y , forall z :e Z , f (trilinear_tuple x y z) = module_finitely_supported_sum M addM (m :*: (n :*: p)) (fun u => smulM (mulK (basis_coordinates K addK mulK X addX smulX m a x (u 0)) (mulK (basis_coordinates K addK mulK Y addY smulY n b y (u 1 0)) (basis_coordinates K addK mulK Z addZ smulZ p c z (u 1 1)))) (f (trilinear_tuple (a (u 0)) (b (u 1 0)) (c (u 1 1))))).
Axiom god1_ring_finite_product_three : forall K , forall add mul : set -> set -> set , ring K add mul -> forall f : set -> set , f 0 :e K -> f 1 :e K -> f 2 :e K -> ring_finite_product K add mul 3 f = mul (f 0) (mul (f 1) (f 2)).
Axiom god1_module_homomorphism_transport : forall K , forall addK mulK : set -> set -> set , forall X X' , forall addX addX' smulX smulX' : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f g : set -> set , X = X' -> addX = addX' -> smulX = smulX' -> f = g -> module_homomorphism K addK mulK X addX smulX M addM smulM f -> module_homomorphism K addK mulK X' addX' smulX' M addM smulM g.
Axiom god1_three_linear_forms_family : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall Y , forall addY smulY : set -> set -> set , forall Z , forall addZ smulZ : set -> set -> set , forall u v w : set -> set , module_homomorphism K addK mulK X addX smulX K addK mulK u -> module_homomorphism K addK mulK Y addY smulY K addK mulK v -> module_homomorphism K addK mulK Z addZ smulZ K addK mulK w -> forall i :e 3 , module_homomorphism K addK mulK (if i = 0 then X else if i = 1 then Y else Z) (fun r s => if i = 0 then addX r s else if i = 1 then addY r s else addZ r s) (fun scalar r => if i = 0 then smulX scalar r else if i = 1 then smulY scalar r else smulZ scalar r) K addK mulK (fun r => if i = 0 then u r else if i = 1 then v r else w r).
Axiom god1_product_of_three_linear_forms_trilinear : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall Y , forall addY smulY : set -> set -> set , forall Z , forall addZ smulZ : set -> set -> set , forall u v w : set -> set , commutative_ring K addK mulK -> module_homomorphism K addK mulK X addX smulX K addK mulK u -> module_homomorphism K addK mulK Y addY smulY K addK mulK v -> module_homomorphism K addK mulK Z addZ smulZ K addK mulK w -> trilinear_mapping K addK mulK X addX smulX Y addY smulY Z addZ smulZ K addK mulK (fun z => mulK (u (z 0)) (mulK (v (z 1)) (w (z 2)))).
Axiom god1_trilinear_coordinate_product : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall Y , forall addY smulY : set -> set -> set , forall Z , forall addZ smulZ : set -> set -> set , forall m n p , forall a b c : set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX m a -> module_basis K addK mulK Y addY smulY n b -> module_basis K addK mulK Z addZ smulZ p c -> forall i :e m , forall j :e n , forall k :e p , trilinear_mapping K addK mulK X addX smulX Y addY smulY Z addZ smulZ K addK mulK (fun q => mulK (basis_coordinate_function K addK mulK X addX smulX m a i (q 0)) (mulK (basis_coordinate_function K addK mulK Y addY smulY n b j (q 1)) (basis_coordinate_function K addK mulK Z addZ smulZ p c k (q 2)))).
Axiom god1_trilinear_tuple_reconstruct : forall X Y Z , forall z :e indexed_module_product 3 (fun i => if i = 0 then X else if i = 1 then Y else Z) , z = trilinear_tuple (z 0) (z 1) (z 2).
Axiom god1_trilinear_coordinate_sum_is_trilinear : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall Y , forall addY smulY : set -> set -> set , forall Z , forall addZ smulZ : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall m n p :e omega , forall a b c : set -> set , forall coeff : set -> set -> set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX m a -> module_basis K addK mulK Y addY smulY n b -> module_basis K addK mulK Z addZ smulZ p c -> left_module K addK mulK M addM smulM -> (forall i :e m , forall j :e n , forall k :e p , coeff i j k :e M) -> trilinear_mapping K addK mulK X addX smulX Y addY smulY Z addZ smulZ M addM smulM (fun q => module_finitely_supported_sum M addM (m :*: (n :*: p)) (fun t => smulM (mulK (basis_coordinate_function K addK mulK X addX smulX m a (t 0) (q 0)) (mulK (basis_coordinate_function K addK mulK Y addY smulY n b (t 1 0) (q 1)) (basis_coordinate_function K addK mulK Z addZ smulZ p c (t 1 1) (q 2)))) (coeff (t 0) (t 1 0) (t 1 1)))).
Axiom god1_trilinear_coordinate_expansion_implies_mapping : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall Y , forall addY smulY : set -> set -> set , forall Z , forall addZ smulZ : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall m n p :e omega , forall a b c : set -> set , forall f : set -> set , forall coeff : set -> set -> set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX m a -> module_basis K addK mulK Y addY smulY n b -> module_basis K addK mulK Z addZ smulZ p c -> left_module K addK mulK M addM smulM -> (forall i :e m , forall j :e n , forall k :e p , coeff i j k :e M) -> (forall x :e X , forall y :e Y , forall z :e Z , f (trilinear_tuple x y z) = module_finitely_supported_sum M addM (m :*: (n :*: p)) (fun t => smulM (mulK (basis_coordinates K addK mulK X addX smulX m a x (t 0)) (mulK (basis_coordinates K addK mulK Y addY smulY n b y (t 1 0)) (basis_coordinates K addK mulK Z addZ smulZ p c z (t 1 1)))) (coeff (t 0) (t 1 0) (t 1 1)))) -> trilinear_mapping K addK mulK X addX smulX Y addY smulY Z addZ smulZ M addM smulM f.
Axiom god1_not_threefold_and_cases : forall A B C : prop , ~ (A /\ B /\ C) -> ~ A \/ (~ B \/ ~ C).
