Axiom lower_darboux_sums_Icc_scale_pos : forall a b :e R , a <= b -> forall f : set -> set , bounded_fun (Icc a b) f -> forall alpha :e R , 0 < alpha -> lower_darboux_sums_Icc a b (fun x => alpha * (f x)) = mul_const_set alpha (lower_darboux_sums_Icc a b f).
