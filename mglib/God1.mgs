Definition iterated_polynomial_derivative : set -> (set -> set -> set) -> set -> set -> set := fun K add f k => nat_primrec f (fun j g => polynomial_derived K add g) k.
Definition polynomial_derivative_iteration : set -> (set -> set -> set) -> set -> set -> set := fun K add f k => iterated_polynomial_derivative K add f k.
