Section form32.
Axiom abs_R_sub : forall x y :e R , abs_SNo (x + (- y)) <= abs_SNo x + abs_SNo y.
Axiom abs_R_rev_triangle : forall x y :e R , abs_SNo (abs_SNo x + (- (abs_SNo y))) <= abs_SNo (x + (- y)).
