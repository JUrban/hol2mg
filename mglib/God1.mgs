Section form70.
Definition Rn_dist : set -> set -> set -> set := fun n x y => norm_dist (Rn n) (Rn_add n) (Rn_neg n) (Rn_norm n) x y.
Axiom Rn_dist_is_metric : forall n :e omega , is_metric (Rn n) (Rn_dist n).
Axiom Rn_dist_eq_norm_sub : forall n :e omega , forall x :e Rn n , forall y :e Rn n , Rn_dist n x y = Rn_norm n (Rn_add n y (Rn_neg n x)).
Axiom Rn_dist_add_right : forall n :e omega , forall x :e Rn n , forall h :e Rn n , Rn_dist n x (Rn_add n x h) = Rn_norm n h.
Axiom Rn_dist_zero_left : forall n :e omega , forall h :e Rn n , Rn_dist n (Rn_zero n) h = Rn_norm n h.
Axiom Rn_dist_zero_right : forall n :e omega , forall h :e Rn n , Rn_dist n h (Rn_zero n) = Rn_norm n h.
Definition sv_deriv_error : set -> set -> (set -> set) -> set -> set -> set -> set := fun n m f x A h => Rn_add m (Rn_add m (f (Rn_add n x h)) (Rn_neg m (f x))) (Rn_neg m (A h)).
Definition sv_diffquot : set -> set -> (set -> set) -> set -> set -> set -> set := fun n m f x A h => (Rn_norm m (sv_deriv_error n m f x A h)) :/: (Rn_norm n h).
Definition sv_deriv_at : set -> set -> (set -> set) -> set -> set -> set -> prop := fun n m f U x A => n :e omega /\ m :e omega /\ ms_open (Rn n) (Rn_dist n) U /\ x :e U /\ (forall z :e U , f z :e (Rn m)) /\ A :e LXY (Rn n) (Rn_add n) (Rn_zero n) (Rn_neg n) (Rn_smul n) (Rn m) (Rn_add m) (Rn_zero m) (Rn_neg m) (Rn_smul m) /\ forall hseq : set -> set , (forall k :e omega , hseq k :e (Rn n) /\ hseq k <> (Rn_zero n) /\ (Rn_add n x (hseq k)) :e U) -> ms_seq_limit (Rn n) (Rn_dist n) hseq (Rn_zero n) -> seq_limit (fun k => sv_diffquot n m f x A (hseq k)) 0.
Definition sv_differentiable_at : set -> set -> (set -> set) -> set -> set -> prop := fun n m f U x => exists A :e LXY (Rn n) (Rn_add n) (Rn_zero n) (Rn_neg n) (Rn_smul n) (Rn m) (Rn_add m) (Rn_zero m) (Rn_neg m) (Rn_smul m) , sv_deriv_at n m f U x A.
Axiom sv_deriv_at_elim_lin : forall n m , forall f : set -> set , forall U , forall x , forall A , sv_deriv_at n m f U x A -> A :e LXY (Rn n) (Rn_add n) (Rn_zero n) (Rn_neg n) (Rn_smul n) (Rn m) (Rn_add m) (Rn_zero m) (Rn_neg m) (Rn_smul m).
Axiom sv_deriv_at_elim_limit : forall n m , forall f : set -> set , forall U , forall x , forall A , sv_deriv_at n m f U x A -> forall hseq : set -> set , (forall k :e omega , hseq k :e (Rn n) /\ hseq k <> (Rn_zero n) /\ (Rn_add n x (hseq k)) :e U) -> ms_seq_limit (Rn n) (Rn_dist n) hseq (Rn_zero n) -> seq_limit (fun k => sv_diffquot n m f x A (hseq k)) 0.
Axiom sv_deriv_at_elim_open : forall n m , forall f : set -> set , forall U , forall x , forall A , sv_deriv_at n m f U x A -> ms_open (Rn n) (Rn_dist n) U.
Axiom sv_deriv_at_elim_maps_to : forall n m , forall f : set -> set , forall U , forall x , forall A , sv_deriv_at n m f U x A -> forall z :e U , f z :e (Rn m).
Axiom sv_deriv_at_unique : forall n :e omega , forall m :e omega , forall f : set -> set , forall U , forall x :e U , forall A :e LXY (Rn n) (Rn_add n) (Rn_zero n) (Rn_neg n) (Rn_smul n) (Rn m) (Rn_add m) (Rn_zero m) (Rn_neg m) (Rn_smul m) , forall B :e LXY (Rn n) (Rn_add n) (Rn_zero n) (Rn_neg n) (Rn_smul n) (Rn m) (Rn_add m) (Rn_zero m) (Rn_neg m) (Rn_smul m) , ms_open (Rn n) (Rn_dist n) U -> (forall z :e U , f z :e (Rn m)) -> sv_deriv_at n m f U x A -> sv_deriv_at n m f U x B -> A = B.
