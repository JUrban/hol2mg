Axiom god1_matrix_rank_of_one_column_extension_dichotomy : forall K , forall addK mulK : set -> set -> set , forall n q :e omega , forall A :e matrix_space K n (ordsucc q) , forall B :e matrix_space K n q , division_ring K addK mulK -> (forall j :e q , matrix_column n B j = matrix_column n A (ordsucc j)) -> matrix_rank K addK mulK n q B = q -> matrix_rank K addK mulK n (ordsucc q) A = q \/ matrix_rank K addK mulK n (ordsucc q) A = ordsucc q.
Axiom god1_matrix_rank_not_full_iff_all_maximal_minors_zero : forall K , forall addK mulK : set -> set -> set , forall n p :e omega , forall A :e matrix_space K n p , field K addK mulK -> 0 :e p -> (matrix_rank K addK (opposite_ring_multiplication mulK) n p A <> p <-> forall rows :e n :^: p , inj p n (fun i => rows i) -> matrix_determinant K addK mulK p (matrix_submatrix p p (fun i => rows i) (fun j => j) A) = ring_zero K addK).
Axiom god1_affine_membership_coordinate_matrix_tail_column : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall n q :e omega , forall P Q : set -> set , forall R :e E , affine_space K addK mulK T addT smulT E action -> affine_basis K addK mulK T addT smulT E action n P -> (forall j :e ordsucc q , Q j :e E) -> forall j :e ordsucc q , matrix_column (ordsucc n) (affine_coordinate_matrix K addK mulK T addT smulT E action n q P Q) j = matrix_column (ordsucc n) (affine_membership_coordinate_matrix K addK mulK T addT smulT E action n (ordsucc q) P Q R) (ordsucc j).
