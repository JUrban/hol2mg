Definition matrix_vector_product : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set -> set -> set := fun K add mul n p A x => fun i :e n => ring_finite_sum K add p (fun j => mul (matrix_entry A i j) (x j)).
Definition linear_system : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set -> set -> prop := fun K add mul n p A b => A :e matrix_space K n p /\ b :e K :^: n.
Definition linear_system_solution : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set -> set -> set -> prop := fun K add mul n p A b x => linear_system K add mul n p A b /\ x :e K :^: p /\ matrix_vector_product K add mul n p A x = b.
Definition linear_system_solution_set : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set -> set -> set := fun K add mul n p A b => {x :e K :^: p|linear_system_solution K add mul n p A b x}.
