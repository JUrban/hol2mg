Axiom rect_Icc_R2_mem_coord1 : forall a b c d :e R , forall p :e (rect_Icc_R2 a b c d) , (p 1) :e (Icc c d).
Axiom exists_omega_ge_two : forall N0 :e omega , forall N1 :e omega , exists N :e omega , N0 <= N /\ N1 <= N.
Axiom omega_Le_tra : forall a :e omega , forall b :e omega , forall c :e omega , a <= b -> b <= c -> a <= c.
Axiom ms_seq_limit_of_pointwise_dist_Le_eps_ : forall X , forall d : set -> set -> set , forall x y : set -> set , forall l , is_metric X d -> ms_seq_limit X d x l -> (forall n :e omega , y n :e X) -> (forall n :e omega , d (x n) (y n) <= eps_ n) -> ms_seq_limit X d y l.
Axiom ms_seq_limit_Rn2_of_rect_coord_limits : forall a b c d :e R , forall x : set -> set , forall l0 :e (Icc a b) , forall l1 :e (Icc c d) , (forall n :e omega , x n :e (rect_Icc_R2 a b c d)) -> ms_seq_limit (Icc a b) dist_R (fun n : set => (x n) 0) l0 -> ms_seq_limit (Icc c d) dist_R (fun n : set => (x n) 1) l1 -> ms_seq_limit (Rn 2) (Rn_dist 2) x (R2_pair l0 l1).
Axiom rect_Icc_R2_ms_seq_compact : forall a b c d :e R , ms_seq_compact (Rn 2) (Rn_dist 2) (rect_Icc_R2 a b c d).
Definition ms_uniformly_continuous_on : (set -> set) -> set -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> prop := fun f X dX Y dY K => K c= X /\ (forall x :e K , f x :e Y) /\ forall eps :e R , 0 < eps -> exists delta :e R , 0 < delta /\ forall x :e K , forall y :e K , dX x y < delta -> dY (f x) (f y) < eps.
Axiom ms_uniformly_continuous_on_subq : forall f : set -> set , forall X Y K , forall dX dY : set -> set -> set , ms_uniformly_continuous_on f X dX Y dY K -> K c= X.
Axiom ms_uniformly_continuous_on_maps_to : forall f : set -> set , forall X Y K , forall dX dY : set -> set -> set , ms_uniformly_continuous_on f X dX Y dY K -> forall x :e K , f x :e Y.
Axiom ms_uniformly_continuous_on_exists_delta : forall f : set -> set , forall X Y K , forall dX dY : set -> set -> set , ms_uniformly_continuous_on f X dX Y dY K -> forall eps :e R , 0 < eps -> exists delta :e R , 0 < delta /\ forall x :e K , forall y :e K , dX x y < delta -> dY (f x) (f y) < eps.
Axiom ms_continuous_on_seq_compact_imp_uniformly_continuous : forall X Y , forall dX dY : set -> set -> set , forall f : set -> set , forall K , is_metric X dX -> is_metric Y dY -> ms_seq_compact X dX K -> ms_continuous_on f X dX Y dY K -> ms_uniformly_continuous_on f X dX Y dY K.
Axiom ms_continuous_on_rect_imp_uniformly_continuous_on : forall a b c d :e R , forall f : set -> set , ms_continuous_on f (Rn 2) (Rn_dist 2) R dist_R (rect_Icc_R2 a b c d) -> ms_uniformly_continuous_on f (Rn 2) (Rn_dist 2) R dist_R (rect_Icc_R2 a b c d).
Axiom ms_continuous_on_rect_imp_bounded_fun : forall a b c d :e R , a <= b -> c <= d -> forall f : set -> set , ms_continuous_on f (Rn 2) (Rn_dist 2) R dist_R (rect_Icc_R2 a b c d) -> bounded_fun (rect_Icc_R2 a b c d) f.
Axiom ms_continuous_on_rect_imp_continuous_on_slice_y : forall a b c d :e R , forall f : set -> set , ms_continuous_on f (Rn 2) (Rn_dist 2) R dist_R (rect_Icc_R2 a b c d) -> forall x :e (Icc a b) , continuous_on (fun y : set => f (R2_pair x y)) (Icc c d).
Axiom ms_continuous_on_rect_imp_continuous_on_slice_x : forall a b c d :e R , forall f : set -> set , ms_continuous_on f (Rn 2) (Rn_dist 2) R dist_R (rect_Icc_R2 a b c d) -> forall y :e (Icc c d) , continuous_on (fun x : set => f (R2_pair x y)) (Icc a b).
Axiom ms_continuous_on_rect_imp_riemann_integrable_slice_y : forall a b c d :e R , c <= d -> forall f : set -> set , ms_continuous_on f (Rn 2) (Rn_dist 2) R dist_R (rect_Icc_R2 a b c d) -> forall x :e (Icc a b) , riemann_integrable_Icc c d (fun y : set => f (R2_pair x y)).
Axiom ms_continuous_on_rect_imp_riemann_integrable_slice_x : forall a b c d :e R , a <= b -> forall f : set -> set , ms_continuous_on f (Rn 2) (Rn_dist 2) R dist_R (rect_Icc_R2 a b c d) -> forall y :e (Icc c d) , riemann_integrable_Icc a b (fun x : set => f (R2_pair x y)).
Axiom ms_continuous_on_rect_imp_slice_integral_y_in_R : forall a b c d :e R , c <= d -> forall f : set -> set , ms_continuous_on f (Rn 2) (Rn_dist 2) R dist_R (rect_Icc_R2 a b c d) -> forall x :e (Icc a b) , riemann_integral_Icc c d (fun y : set => f (R2_pair x y)) :e R.
Axiom ms_continuous_on_rect_imp_abs_slice_integral_y_bounded : forall a b c d :e R , a <= b -> c < d -> forall f : set -> set , ms_continuous_on f (Rn 2) (Rn_dist 2) R dist_R (rect_Icc_R2 a b c d) -> exists M :e R , forall x :e (Icc a b) , abs_SNo (riemann_integral_Icc c d (fun y : set => f (R2_pair x y))) <= M.
Axiom ms_continuous_on_rect_imp_bounded_fun_slice_integral_y : forall a b c d :e R , a <= b -> c < d -> forall f : set -> set , ms_continuous_on f (Rn 2) (Rn_dist 2) R dist_R (rect_Icc_R2 a b c d) -> bounded_fun (Icc a b) (fun x : set => riemann_integral_Icc c d (fun y : set => f (R2_pair x y))).
Axiom ms_continuous_on_rect_imp_continuous_on_slice_integral_y_Icc_strict : forall a b c d :e R , a <= b -> c < d -> forall f : set -> set , ms_continuous_on f (Rn 2) (Rn_dist 2) R dist_R (rect_Icc_R2 a b c d) -> continuous_on (fun x : set => riemann_integral_Icc c d (fun y : set => f (R2_pair x y))) (Icc a b).
Axiom ms_continuous_on_rect_imp_continuous_on_slice_integral_y_Icc : forall a b c d :e R , a <= b -> c <= d -> forall f : set -> set , ms_continuous_on f (Rn 2) (Rn_dist 2) R dist_R (rect_Icc_R2 a b c d) -> continuous_on (fun x : set => riemann_integral_Icc c d (fun y : set => f (R2_pair x y))) (Icc a b).
Definition leibniz_int_Icc : set -> set -> (set -> set) -> set -> set := fun a b f y => riemann_integral_Icc a b (fun x : set => f (R2_pair x y)).
Axiom leibniz_int_Icc_unfold : forall a b : set , forall f : set -> set , forall y , leibniz_int_Icc a b f y = riemann_integral_Icc a b (fun x : set => f (R2_pair x y)).
Axiom leibniz_int_Icc_self_eq_0 : forall a :e R , forall f : set -> set , forall y , leibniz_int_Icc a a f y = 0.
Axiom leibniz_integral_rule_Icc_self_a : forall a c d :e R , c < d -> forall f dfdy : set -> set , forall y :e (Icc c d) , deriv_at (leibniz_int_Icc a a f) (Icc c d) y (leibniz_int_Icc a a dfdy y).
Axiom ms_continuous_on_rect_imp_abs_leibniz_int_Icc_bounded : forall a b c d :e R , a < b -> c <= d -> forall f : set -> set , ms_continuous_on f (Rn 2) (Rn_dist 2) R dist_R (rect_Icc_R2 a b c d) -> exists M :e R , forall y :e (Icc c d) , abs_SNo (leibniz_int_Icc a b f y) <= M.
Axiom ms_continuous_on_rect_imp_bounded_fun_leibniz_int_Icc : forall a b c d :e R , a < b -> c <= d -> forall f : set -> set , ms_continuous_on f (Rn 2) (Rn_dist 2) R dist_R (rect_Icc_R2 a b c d) -> bounded_fun (Icc c d) (leibniz_int_Icc a b f).
Axiom ms_continuous_on_rect_imp_leibniz_int_Icc_in_R : forall a b c d :e R , a <= b -> forall f : set -> set , ms_continuous_on f (Rn 2) (Rn_dist 2) R dist_R (rect_Icc_R2 a b c d) -> forall y :e (Icc c d) , leibniz_int_Icc a b f y :e R.
Axiom ms_continuous_on_rect_imp_continuous_on_leibniz_int_Icc_strict : forall a b c d :e R , a < b -> c <= d -> forall f : set -> set , ms_continuous_on f (Rn 2) (Rn_dist 2) R dist_R (rect_Icc_R2 a b c d) -> continuous_on (leibniz_int_Icc a b f) (Icc c d).
Axiom continuous_on_leibniz_int_Icc_self : forall a c d :e R , c <= d -> forall f : set -> set , continuous_on (leibniz_int_Icc a a f) (Icc c d).
Axiom ms_continuous_on_rect_imp_continuous_on_leibniz_int_Icc : forall a b c d :e R , a <= b -> c <= d -> forall f : set -> set , ms_continuous_on f (Rn 2) (Rn_dist 2) R dist_R (rect_Icc_R2 a b c d) -> continuous_on (leibniz_int_Icc a b f) (Icc c d).
End form76.
Section form77.
Definition is_C1_path_Rn : set -> set -> set -> (set -> set) -> (set -> set) -> prop := fun n a b gamma gamma' => n :e omega /\ a :e R /\ b :e R /\ a <= b /\ (forall t :e (Icc a b) , gamma t :e (Rn n)) /\ (forall t :e (Icc a b) , gamma' t :e (Rn n)) /\ (forall t :e (Icc a b) , forall j :e n , deriv_at (fun s => (gamma s) j) (Icc a b) t ((gamma' t) j)) /\ (forall j :e n , continuous_on (fun t => (gamma' t) j) (Icc a b)).
Axiom C1_path_ab_le : forall n a b , forall gamma gamma' : set -> set , is_C1_path_Rn n a b gamma gamma' -> a <= b.
Definition is_smooth_path_Rn : set -> set -> set -> (set -> set) -> (set -> set) -> prop := fun n a b gamma gamma' => is_C1_path_Rn n a b gamma gamma' /\ (forall t :e (Icc a b) , gamma' t <> (Rn_zero n)).
Definition is_closed_path_Rn : set -> set -> set -> (set -> set) -> prop := fun n a b gamma => gamma a = gamma b.
Definition is_simple_path_Rn : set -> set -> set -> (set -> set) -> prop := fun n a b gamma => injective_on gamma (Icc a b) \/ (injective_on gamma ((Icc a b) :\: {b}) /\ gamma a = gamma b).
Definition path_length_Rn : set -> set -> set -> (set -> set) -> set := fun n a b gamma' => riemann_integral_Icc a b (fun t => Rn_norm n (gamma' t)).
Axiom path_length_Rn_self_eq_0 : forall n , forall a :e R , forall gamma' : set -> set , path_length_Rn n a a gamma' = 0.
End form77.
Section form78.
Definition line_integral_Rn : set -> set -> set -> (set -> set) -> (set -> set) -> (set -> set) -> set := fun n a b F gamma gamma' => riemann_integral_Icc a b (fun t => Rn_dot n (F (gamma t)) (gamma' t)).
Axiom line_integral_Rn_self_eq_0 : forall n , forall a :e R , forall F gamma gamma' : set -> set , line_integral_Rn n a a F gamma gamma' = 0.
Definition is_potential_of : set -> (set -> set) -> set -> (set -> set) -> prop := fun n phi U F => forall a b :e R , forall gamma gamma' : set -> set , is_C1_path_Rn n a b gamma gamma' -> (forall t :e (Icc a b) , gamma t :e U) -> line_integral_Rn n a b F gamma gamma' = (phi (gamma b)) + (- (phi (gamma a))).
Axiom line_integral_of_gradient_eq_endpoint_diff : forall n :e omega , forall a b :e R , a <= b -> forall U , forall F : set -> set , forall phi : set -> set , forall gamma gamma' : set -> set , is_C1_path_Rn n a b gamma gamma' -> (forall t :e (Icc a b) , gamma t :e U) -> is_potential_of n phi U F -> line_integral_Rn n a b F gamma gamma' = (phi (gamma b)) + (- (phi (gamma a))).
End form78.
Section form79.
Definition Rn_closed_rect : set -> set -> set -> set := fun n a b => {x :e (Rn n)|forall i :e n , x i :e (Icc (a i) (b i))}.
Definition Rn_open_rect : set -> set -> set -> set := fun n a b => {x :e (Rn n)|forall i :e n , x i :e (Ioo (a i) (b i))}.
Definition rect_part_Icc_R2 : (set -> set) -> set -> (set -> set) -> set -> set := fun p i q j => {pt :e (Rn 2)|(pt 0) :e (part_Icc p i) /\ (pt 1) :e (part_Icc q j)}.
Axiom R2_pair_mem_rect_part_Icc_R2 : forall p q : set -> set , forall i j , forall x :e R , forall y :e R , x :e (part_Icc p i) -> y :e (part_Icc q j) -> R2_pair x y :e (rect_part_Icc_R2 p i q j).
Axiom rect_part_Icc_R2_mono_right_Subq : forall p q r : set -> set , forall i j k , part_Icc q j c= part_Icc r k -> rect_part_Icc_R2 p i q j c= rect_part_Icc_R2 p i r k.
Axiom rect_part_Icc_R2_mono_left_Subq : forall p q r : set -> set , forall i j k , part_Icc p i c= part_Icc q j -> rect_part_Icc_R2 p i r k c= rect_part_Icc_R2 q j r k.
Axiom rect_part_Icc_R2_subq_rect_Icc_R2 : forall a1 b1 a2 b2 n m , forall p q : set -> set , is_partition_seq_Icc a1 b1 n p -> is_partition_seq_Icc a2 b2 m q -> forall i :e n , forall j :e m , rect_part_Icc_R2 p i q j c= rect_Icc_R2 a1 b1 a2 b2.
Axiom rect_part_Icc_R2_nonempty : forall a1 b1 a2 b2 n m , forall p q : set -> set , is_partition_seq_Icc a1 b1 n p -> is_partition_seq_Icc a2 b2 m q -> forall i :e n , forall j :e m , nonempty (rect_part_Icc_R2 p i q j).
Axiom bounded_fun_rect_part_Icc_R2 : forall a1 b1 a2 b2 n m , forall p q : set -> set , is_partition_seq_Icc a1 b1 n p -> is_partition_seq_Icc a2 b2 m q -> forall f : set -> set , bounded_fun (rect_Icc_R2 a1 b1 a2 b2) f -> forall i :e n , forall j :e m , bounded_fun (rect_part_Icc_R2 p i q j) f.
Axiom sup_on_Le_inf_on_add_two_eps_of_forall_dist_lt : forall D , forall f : set -> set , nonempty D -> bounded_fun D f -> forall eps :e R , 0 < eps -> (forall x :e D , forall y :e D , dist_R (f x) (f y) < eps) -> sup_on f D <= (inf_on f D) + (eps + eps).
Axiom Rn_dist_rect_part_Icc_R2_lt_of_uniform_steps_lt : forall a1 b1 a2 b2 :e R , a1 < b1 -> a2 < b2 -> forall nx ny :e omega , (nat_p nx /\ nx <> 0) -> (nat_p ny /\ ny <> 0) -> forall delta :e R , 0 < delta -> uniform_partition_step a1 b1 nx < (delta :/: 2) -> uniform_partition_step a2 b2 ny < (delta :/: 2) -> forall i :e nx , forall j :e ny , forall u :e rect_part_Icc_R2 (uniform_partition_seq_fun a1 b1 nx) i (uniform_partition_seq_fun a2 b2 ny) j , forall v :e rect_part_Icc_R2 (uniform_partition_seq_fun a1 b1 nx) i (uniform_partition_seq_fun a2 b2 ny) j , Rn_dist 2 u v < delta.
Definition rect_delta_part_R2 : (set -> set) -> set -> (set -> set) -> set -> set := fun p i q j => (delta_part p i) * (delta_part q j).
Axiom rect_delta_part_R2_pos : forall a1 b1 a2 b2 n m , forall p q : set -> set , is_partition_seq_Icc a1 b1 n p -> is_partition_seq_Icc a2 b2 m q -> forall i :e n , forall j :e m , 0 < rect_delta_part_R2 p i q j.
Axiom rect_delta_part_R2_nonneg : forall a1 b1 a2 b2 n m , forall p q : set -> set , is_partition_seq_Icc a1 b1 n p -> is_partition_seq_Icc a2 b2 m q -> forall i :e n , forall j :e m , 0 <= rect_delta_part_R2 p i q j.
Definition rect_len_R2 : set -> set -> set -> set -> set := fun a1 b1 a2 b2 => (b1 + (- a1)) * (b2 + (- a2)).
Axiom rect_len_R2_unfold : forall a1 b1 a2 b2 , rect_len_R2 a1 b1 a2 b2 = (b1 + (- a1)) * (b2 + (- a2)).
Axiom partial_sum_seq_delta_part_eq_len : forall a b :e R , forall n :e omega , forall p : set -> set , is_partition_seq_Icc a b n p -> partial_sum_seq (fun i : set => delta_part p i) n = b + (- a).
Axiom rect_delta_part_R2_total_area_eq : forall a1 b1 a2 b2 :e R , forall n :e omega , forall m :e omega , forall p q : set -> set , is_partition_seq_Icc a1 b1 n p -> is_partition_seq_Icc a2 b2 m q -> partial_sum_seq (fun i : set => partial_sum_seq (fun j : set => rect_delta_part_R2 p i q j) m) n = rect_len_R2 a1 b1 a2 b2.
Axiom inf_on_rect_part_Icc_R2_mono_right : forall a1 b1 a2 b2 n m M , forall f : set -> set , forall p q r : set -> set , is_partition_seq_Icc a1 b1 n p -> is_partition_seq_Icc a2 b2 m q -> is_partition_seq_Icc a2 b2 M r -> bounded_fun (rect_Icc_R2 a1 b1 a2 b2) f -> forall i :e n , forall j :e m , forall k :e M , part_Icc q j c= part_Icc r k -> inf_on f (rect_part_Icc_R2 p i r k) <= inf_on f (rect_part_Icc_R2 p i q j).
Axiom sup_on_rect_part_Icc_R2_mono_right : forall a1 b1 a2 b2 n m M , forall f : set -> set , forall p q r : set -> set , is_partition_seq_Icc a1 b1 n p -> is_partition_seq_Icc a2 b2 m q -> is_partition_seq_Icc a2 b2 M r -> bounded_fun (rect_Icc_R2 a1 b1 a2 b2) f -> forall i :e n , forall j :e m , forall k :e M , part_Icc q j c= part_Icc r k -> sup_on f (rect_part_Icc_R2 p i q j) <= sup_on f (rect_part_Icc_R2 p i r k).
Axiom inf_on_rect_part_Icc_R2_mono_left : forall a1 b1 a2 b2 n m N , forall f : set -> set , forall p q r : set -> set , is_partition_seq_Icc a1 b1 n p -> is_partition_seq_Icc a1 b1 N q -> is_partition_seq_Icc a2 b2 m r -> bounded_fun (rect_Icc_R2 a1 b1 a2 b2) f -> forall i :e n , forall j :e N , forall k :e m , part_Icc p i c= part_Icc q j -> inf_on f (rect_part_Icc_R2 q j r k) <= inf_on f (rect_part_Icc_R2 p i r k).
Axiom sup_on_rect_part_Icc_R2_mono_left : forall a1 b1 a2 b2 n m N , forall f : set -> set , forall p q r : set -> set , is_partition_seq_Icc a1 b1 n p -> is_partition_seq_Icc a1 b1 N q -> is_partition_seq_Icc a2 b2 m r -> bounded_fun (rect_Icc_R2 a1 b1 a2 b2) f -> forall i :e n , forall j :e N , forall k :e m , part_Icc p i c= part_Icc q j -> sup_on f (rect_part_Icc_R2 p i r k) <= sup_on f (rect_part_Icc_R2 q j r k).
Definition rect_darboux_term_lower_R2 : (set -> set) -> (set -> set) -> (set -> set) -> set -> set -> set := fun f p q i j => (inf_on f (rect_part_Icc_R2 p i q j)) * (rect_delta_part_R2 p i q j).
Definition rect_darboux_term_upper_R2 : (set -> set) -> (set -> set) -> (set -> set) -> set -> set -> set := fun f p q i j => (sup_on f (rect_part_Icc_R2 p i q j)) * (rect_delta_part_R2 p i q j).
Axiom rect_darboux_term_lower_R2_unfold : forall f : set -> set , forall p q : set -> set , forall i j , rect_darboux_term_lower_R2 f p q i j = (inf_on f (rect_part_Icc_R2 p i q j)) * (rect_delta_part_R2 p i q j).
Axiom rect_darboux_term_upper_R2_unfold : forall f : set -> set , forall p q : set -> set , forall i j , rect_darboux_term_upper_R2 f p q i j = (sup_on f (rect_part_Icc_R2 p i q j)) * (rect_delta_part_R2 p i q j).
Axiom rect_darboux_term_lower_R2_factor_left : forall a1 b1 a2 b2 n m , forall f : set -> set , forall p q : set -> set , is_partition_seq_Icc a1 b1 n p -> is_partition_seq_Icc a2 b2 m q -> bounded_fun (rect_Icc_R2 a1 b1 a2 b2) f -> forall i :e n , forall j :e m , rect_darboux_term_lower_R2 f p q i j = (delta_part p i) * ((inf_on f (rect_part_Icc_R2 p i q j)) * (delta_part q j)).
Axiom rect_darboux_term_upper_R2_factor_left : forall a1 b1 a2 b2 n m , forall f : set -> set , forall p q : set -> set , is_partition_seq_Icc a1 b1 n p -> is_partition_seq_Icc a2 b2 m q -> bounded_fun (rect_Icc_R2 a1 b1 a2 b2) f -> forall i :e n , forall j :e m , rect_darboux_term_upper_R2 f p q i j = (delta_part p i) * ((sup_on f (rect_part_Icc_R2 p i q j)) * (delta_part q j)).
Axiom rect_darboux_term_lower_Le_upper_R2 : forall a1 b1 a2 b2 n m , forall f : set -> set , forall p q : set -> set , is_partition_seq_Icc a1 b1 n p -> is_partition_seq_Icc a2 b2 m q -> bounded_fun (rect_Icc_R2 a1 b1 a2 b2) f -> forall i :e n , forall j :e m , rect_darboux_term_lower_R2 f p q i j <= rect_darboux_term_upper_R2 f p q i j.
Definition rect_darboux_sum_lower_seq_R2 : (set -> set) -> set -> (set -> set) -> set -> (set -> set) -> set := fun f n p m q => partial_sum_seq (fun i : set => partial_sum_seq (fun j : set => rect_darboux_term_lower_R2 f p q i j) m) n.
Definition rect_darboux_sum_upper_seq_R2 : (set -> set) -> set -> (set -> set) -> set -> (set -> set) -> set := fun f n p m q => partial_sum_seq (fun i : set => partial_sum_seq (fun j : set => rect_darboux_term_upper_R2 f p q i j) m) n.
Definition rect_darboux_inner_sum_lower_seq_R2 : (set -> set) -> (set -> set) -> set -> (set -> set) -> set -> set := fun f p i q m => partial_sum_seq (fun j : set => (inf_on f (rect_part_Icc_R2 p i q j)) * (delta_part q j)) m.
Definition rect_darboux_inner_sum_upper_seq_R2 : (set -> set) -> (set -> set) -> set -> (set -> set) -> set -> set := fun f p i q m => partial_sum_seq (fun j : set => (sup_on f (rect_part_Icc_R2 p i q j)) * (delta_part q j)) m.
Axiom rect_darboux_sum_lower_seq_R2_unfold : forall f : set -> set , forall n m :e omega , forall p q : set -> set , rect_darboux_sum_lower_seq_R2 f n p m q = partial_sum_seq (fun i : set => partial_sum_seq (fun j : set => rect_darboux_term_lower_R2 f p q i j) m) n.
Axiom rect_darboux_sum_upper_seq_R2_unfold : forall f : set -> set , forall n m :e omega , forall p q : set -> set , rect_darboux_sum_upper_seq_R2 f n p m q = partial_sum_seq (fun i : set => partial_sum_seq (fun j : set => rect_darboux_term_upper_R2 f p q i j) m) n.
Definition lower_darboux_sums_rect_Icc_R2 : set -> set -> set -> set -> (set -> set) -> set := fun a1 b1 a2 b2 f => {s :e R|exists n :e omega , exists p : set -> set , exists m :e omega , exists q : set -> set , is_partition_seq_Icc a1 b1 n p /\ is_partition_seq_Icc a2 b2 m q /\ s = rect_darboux_sum_lower_seq_R2 f n p m q}.
Definition upper_darboux_sums_rect_Icc_R2 : set -> set -> set -> set -> (set -> set) -> set := fun a1 b1 a2 b2 f => {s :e R|exists n :e omega , exists p : set -> set , exists m :e omega , exists q : set -> set , is_partition_seq_Icc a1 b1 n p /\ is_partition_seq_Icc a2 b2 m q /\ s = rect_darboux_sum_upper_seq_R2 f n p m q}.
Definition lower_darboux_integral_rect_Icc_R2 : set -> set -> set -> set -> (set -> set) -> set := fun a1 b1 a2 b2 f => sup (lower_darboux_sums_rect_Icc_R2 a1 b1 a2 b2 f).
Definition upper_darboux_integral_rect_Icc_R2 : set -> set -> set -> set -> (set -> set) -> set := fun a1 b1 a2 b2 f => inf (upper_darboux_sums_rect_Icc_R2 a1 b1 a2 b2 f).
Definition riemann_integrable_rect_Icc_R2 : set -> set -> set -> set -> (set -> set) -> prop := fun a1 b1 a2 b2 f => bounded_fun (rect_Icc_R2 a1 b1 a2 b2) f /\ lower_darboux_integral_rect_Icc_R2 a1 b1 a2 b2 f = upper_darboux_integral_rect_Icc_R2 a1 b1 a2 b2 f.
Definition riemann_integral_rect_Icc_R2 : set -> set -> set -> set -> (set -> set) -> set := fun a1 b1 a2 b2 f => lower_darboux_integral_rect_Icc_R2 a1 b1 a2 b2 f.
Axiom rect_delta_part_R2_R_closed : forall a1 b1 a2 b2 n m , forall p q : set -> set , is_partition_seq_Icc a1 b1 n p -> is_partition_seq_Icc a2 b2 m q -> forall i :e n , forall j :e m , rect_delta_part_R2 p i q j :e R.
Axiom rect_darboux_term_lower_R2_R_closed : forall a1 b1 a2 b2 n m , forall f : set -> set , forall p q : set -> set , is_partition_seq_Icc a1 b1 n p -> is_partition_seq_Icc a2 b2 m q -> bounded_fun (rect_Icc_R2 a1 b1 a2 b2) f -> forall i :e n , forall j :e m , rect_darboux_term_lower_R2 f p q i j :e R.
Axiom rect_darboux_term_upper_R2_R_closed : forall a1 b1 a2 b2 n m , forall f : set -> set , forall p q : set -> set , is_partition_seq_Icc a1 b1 n p -> is_partition_seq_Icc a2 b2 m q -> bounded_fun (rect_Icc_R2 a1 b1 a2 b2) f -> forall i :e n , forall j :e m , rect_darboux_term_upper_R2 f p q i j :e R.
Axiom rect_darboux_sum_lower_seq_R2_R_closed : forall a1 b1 a2 b2 n m , forall f : set -> set , forall p q : set -> set , is_partition_seq_Icc a1 b1 n p -> is_partition_seq_Icc a2 b2 m q -> bounded_fun (rect_Icc_R2 a1 b1 a2 b2) f -> rect_darboux_sum_lower_seq_R2 f n p m q :e R.
Axiom rect_darboux_sum_upper_seq_R2_R_closed : forall a1 b1 a2 b2 n m , forall f : set -> set , forall p q : set -> set , is_partition_seq_Icc a1 b1 n p -> is_partition_seq_Icc a2 b2 m q -> bounded_fun (rect_Icc_R2 a1 b1 a2 b2) f -> rect_darboux_sum_upper_seq_R2 f n p m q :e R.
Axiom rect_darboux_sum_lower_Le_upper_seq_R2 : forall a1 b1 a2 b2 n m , forall f : set -> set , forall p q : set -> set , is_partition_seq_Icc a1 b1 n p -> is_partition_seq_Icc a2 b2 m q -> bounded_fun (rect_Icc_R2 a1 b1 a2 b2) f -> rect_darboux_sum_lower_seq_R2 f n p m q <= rect_darboux_sum_upper_seq_R2 f n p m q.
Axiom lower_darboux_sums_rect_Icc_R2E : forall a1 b1 a2 b2 :e R , forall f : set -> set , forall s :e lower_darboux_sums_rect_Icc_R2 a1 b1 a2 b2 f , exists n :e omega , exists p : set -> set , exists m :e omega , exists q : set -> set , is_partition_seq_Icc a1 b1 n p /\ is_partition_seq_Icc a2 b2 m q /\ s = rect_darboux_sum_lower_seq_R2 f n p m q.
Axiom upper_darboux_sums_rect_Icc_R2E : forall a1 b1 a2 b2 :e R , forall f : set -> set , forall s :e upper_darboux_sums_rect_Icc_R2 a1 b1 a2 b2 f , exists n :e omega , exists p : set -> set , exists m :e omega , exists q : set -> set , is_partition_seq_Icc a1 b1 n p /\ is_partition_seq_Icc a2 b2 m q /\ s = rect_darboux_sum_upper_seq_R2 f n p m q.
Axiom lower_darboux_sums_rect_Icc_R2_subq_R : forall a1 b1 a2 b2 :e R , forall f : set -> set , lower_darboux_sums_rect_Icc_R2 a1 b1 a2 b2 f c= R.
Axiom upper_darboux_sums_rect_Icc_R2_subq_R : forall a1 b1 a2 b2 :e R , forall f : set -> set , upper_darboux_sums_rect_Icc_R2 a1 b1 a2 b2 f c= R.
