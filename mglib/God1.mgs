Axiom god1_positive_order_matrix_characteristic_polynomial_degree : forall K , forall add mul : set -> set -> set , forall n :e omega , forall A :e square_matrix_ring K n , field K add mul -> 0 :e n -> polynomial_total_degree K add 1 (matrix_characteristic_polynomial K add mul n A) = n.
Axiom god1_natural_indexed_sum_in_omega : forall n :e omega , forall f : set -> set , (forall i :e n , f i :e omega) -> natural_indexed_sum n f :e omega.
Axiom god1_natural_indexed_sum_monotone : forall n :e omega , forall f g : set -> set , (forall i :e n , f i :e omega) -> (forall i :e n , g i :e omega) -> (forall i :e n , f i c= g i) -> natural_indexed_sum n f c= natural_indexed_sum n g.
