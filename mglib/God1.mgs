Axiom god1_fraction_every_element_has_displayed_pair : forall K , forall add mul : set -> set -> set , forall x :e fraction_field K add mul , exists a :e K , exists b :e K , b <> ring_zero K add /\ x = fraction_class K add mul (a,b).
Axiom god1_s4_theorem3_binary_quotient_mapping_interface : forall X Y Z , forall RX RY RZ : set -> set -> prop , forall f : set -> set -> set , god1_s4_equivalence_relation X RX -> god1_s4_equivalence_relation Y RY -> god1_s4_equivalence_relation Z RZ -> (forall x :e X , forall y :e Y , f x y :e Z) -> (forall x x' :e X , forall y y' :e Y , RX x x' -> RY y y' -> RZ (f x y) (f x' y')) -> exists fbar : set -> set -> set , forall x :e X , forall y :e Y , fbar {x' :e X|RX x x'} {y' :e Y|RY y y'} = {z' :e Z|RZ (f x y) z'}.
Axiom god1_fraction_field_construction : forall K , forall add mul : set -> set -> set , integral_domain K add mul -> field (fraction_field K add mul) (fraction_addition K add mul) (fraction_multiplication K add mul) /\ ring_isomorphism K add mul {fraction_embedding K add mul a|a :e K} (fraction_addition K add mul) (fraction_multiplication K add mul) (fraction_embedding K add mul) /\ subring (fraction_field K add mul) (fraction_addition K add mul) (fraction_multiplication K add mul) {fraction_embedding K add mul a|a :e K} /\ forall x :e fraction_field K add mul , exists a :e K , exists b :e K , b <> ring_zero K add /\ x = fraction_multiplication K add mul (fraction_embedding K add mul a) (ring_inverse (fraction_field K add mul) (fraction_addition K add mul) (fraction_multiplication K add mul) (fraction_embedding K add mul b)).
Definition rational_function_field : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set := fun K add mul n => fraction_field (multivariate_polynomial_ring K add n) (polynomial_addition K add n) (polynomial_multiplication K add mul n).
Axiom god1_rational_function_field_properties : forall K , forall add mul : set -> set -> set , forall n :e omega , 0 :e n -> field K add mul -> field (rational_function_field K add mul n) (fraction_addition (multivariate_polynomial_ring K add n) (polynomial_addition K add n) (polynomial_multiplication K add mul n)) (fraction_multiplication (multivariate_polynomial_ring K add n) (polynomial_addition K add n) (polynomial_multiplication K add mul n)) /\ subring (rational_function_field K add mul n) (fraction_addition (multivariate_polynomial_ring K add n) (polynomial_addition K add n) (polynomial_multiplication K add mul n)) (fraction_multiplication (multivariate_polynomial_ring K add n) (polynomial_addition K add n) (polynomial_multiplication K add mul n)) {fraction_embedding (multivariate_polynomial_ring K add n) (polynomial_addition K add n) (polynomial_multiplication K add mul n) p|p :e multivariate_polynomial_ring K add n} /\ forall x :e rational_function_field K add mul n , exists p q :e multivariate_polynomial_ring K add n , q <> (fun exponent :e omega :^: n => ring_zero K add) /\ x = fraction_class (multivariate_polynomial_ring K add n) (polynomial_addition K add n) (polynomial_multiplication K add mul n) (p,q).
Definition ring_derivation : set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> prop := fun K add mul D => ring K add mul /\ (forall x :e K , D x :e K) /\ (forall x y :e K , D (add x y) = add (D x) (D y)) /\ forall x y :e K , D (mul x y) = add (mul (D x) y) (mul x (D y)).
Axiom god1_derivation_one_is_zero : forall K , forall add mul : set -> set -> set , forall D : set -> set , ring_derivation K add mul D -> D (ring_one K mul) = ring_zero K add.
Axiom god1_derivation_positive_power_product_step : forall K , forall add mul : set -> set -> set , forall D : set -> set , ring_derivation K add mul D -> forall x :e K , forall n :e omega , 0 :e n -> D (ring_nat_power K add mul x n) = add (mul (D (ring_nat_power K add mul x (Union n))) x) (mul (ring_nat_power K add mul x (Union n)) (D x)).
Axiom god1_derivation_natural_power_formula : forall K , forall add mul : set -> set -> set , forall D : set -> set , commutative_ring K add mul -> ring_derivation K add mul D -> forall x :e K , forall n :e omega , 0 :e n -> D (ring_nat_power K add mul x n) = mul (ring_nat_multiple K add n (ring_nat_power K add mul x (Union n))) (D x).
Axiom god1_derivation_of_one_and_natural_powers : forall K , forall add mul : set -> set -> set , forall D : set -> set , commutative_ring K add mul -> ring_derivation K add mul D -> D (ring_one K mul) = ring_zero K add /\ forall x :e K , forall n :e omega , 0 :e n -> D (ring_nat_power K add mul x n) = mul (ring_nat_multiple K add n (ring_nat_power K add mul x (Union n))) (D x).
Axiom god1_ring_derivation_additive_group_homomorphism : forall K , forall add mul : set -> set -> set , forall D : set -> set , ring_derivation K add mul D -> group_homomorphism K add K add D.
Axiom god1_ring_derivation_zero : forall K , forall add mul : set -> set -> set , forall D : set -> set , ring_derivation K add mul D -> D (ring_zero K add) = ring_zero K add.
Axiom god1_ring_derivation_ring : forall K , forall add mul : set -> set -> set , forall D : set -> set , ring_derivation K add mul D -> ring K add mul.
Axiom god1_ring_derivation_maps : forall K , forall add mul : set -> set -> set , forall D : set -> set , ring_derivation K add mul D -> forall x :e K , D x :e K.
Axiom god1_ring_derivation_addition : forall K , forall add mul : set -> set -> set , forall D : set -> set , ring_derivation K add mul D -> forall x y :e K , D (add x y) = add (D x) (D y).
Axiom god1_ring_derivation_leibniz : forall K , forall add mul : set -> set -> set , forall D : set -> set , ring_derivation K add mul D -> forall x y :e K , D (mul x y) = add (mul (D x) y) (mul x (D y)).
Axiom god1_ring_derivation_scalar_multiple : forall K , forall add mul : set -> set -> set , forall D : set -> set , commutative_ring K add mul -> ring_derivation K add mul D -> forall u :e K , ring_derivation K add mul (fun x => mul u (D x)).
Axiom god1_ring_derivation_sum : forall K , forall add mul : set -> set -> set , forall D1 D2 : set -> set , ring_derivation K add mul D1 -> ring_derivation K add mul D2 -> ring_derivation K add mul (fun x => add (D1 x) (D2 x)).
Axiom god1_ring_derivation_linear_combination : forall K , forall add mul : set -> set -> set , forall D1 D2 : set -> set , commutative_ring K add mul -> ring_derivation K add mul D1 -> ring_derivation K add mul D2 -> forall u1 u2 :e K , ring_derivation K add mul (fun x => add (mul u1 (D1 x)) (mul u2 (D2 x))).
Axiom god1_finite_index_almost_all_zero : forall I , finite I -> forall zero , forall f : set -> set , almost_all_zero I zero f.
Axiom god1_module_finitely_supported_sum_pointwise_zero_finite_index : forall M , forall addM : set -> set -> set , forall I , finite I -> forall f : set -> set , (forall i :e I , f i = module_zero M addM) -> module_finitely_supported_sum M addM I f = module_zero M addM.
Axiom god1_ring_zero_mapping_is_derivation : forall K , forall add mul : set -> set -> set , ring K add mul -> ring_derivation K add mul (fun _ : set => ring_zero K add).
Axiom god1_ring_derivation_pointwise_congr : forall K , forall add mul : set -> set -> set , forall D E : set -> set , ring_derivation K add mul D -> (forall x :e K , E x = D x) -> ring_derivation K add mul E.
Axiom god1_ring_derivation_natural_finite_sum : forall K , forall add mul : set -> set -> set , ring K add mul -> forall n :e omega , forall family : set -> set -> set , (forall i :e n , ring_derivation K add mul (family i)) -> ring_derivation K add mul (fun x => module_finitely_supported_sum K add n (fun i => family i x)).
Definition polynomial_coefficient_derivation : set -> (set -> set -> set) -> set -> (set -> set) -> set -> set := fun K add n D f => fun exponent :e omega :^: n => D (f exponent).
Axiom god1_polynomial_coefficient_derivation_member : forall K , forall add mul : set -> set -> set , forall n , forall D : set -> set , ring_derivation K add mul D -> forall f :e multivariate_polynomial_ring K add n , polynomial_coefficient_derivation K add n D f :e multivariate_polynomial_ring K add n.
Axiom god1_polynomial_coefficient_derivation_addition : forall K , forall add mul : set -> set -> set , forall n , forall D : set -> set , ring_derivation K add mul D -> forall f g :e multivariate_polynomial_ring K add n , polynomial_coefficient_derivation K add n D (polynomial_addition K add n f g) = polynomial_addition K add n (polynomial_coefficient_derivation K add n D f) (polynomial_coefficient_derivation K add n D g).
Axiom god1_derivation_module_finitely_supported_sum_product_rule : forall K , forall add mul : set -> set -> set , forall D : set -> set , ring_derivation K add mul D -> forall I , forall f g : set -> set , almost_all_zero I (ring_zero K add) (fun i => mul (f i) (g i)) -> almost_all_zero I (ring_zero K add) (fun i => mul (D (f i)) (g i)) -> almost_all_zero I (ring_zero K add) (fun i => mul (f i) (D (g i))) -> (forall i :e I , f i :e K) -> (forall i :e I , g i :e K) -> D (module_finitely_supported_sum K add I (fun i => mul (f i) (g i))) = add (module_finitely_supported_sum K add I (fun i => mul (D (f i)) (g i))) (module_finitely_supported_sum K add I (fun i => mul (f i) (D (g i)))).
Axiom god1_polynomial_coefficient_derivation_product_coefficient : forall K , forall add mul : set -> set -> set , forall n , forall D : set -> set , ring_derivation K add mul D -> forall f g :e multivariate_polynomial_ring K add n , forall exponent :e omega :^: n , D (module_finitely_supported_sum K add {w :e (omega :^: n) :*: (omega :^: n)|forall i :e n , add_SNo (w 0 i) (w 1 i) = exponent i} (fun w => mul (f (w 0)) (g (w 1)))) = add (module_finitely_supported_sum K add {w :e (omega :^: n) :*: (omega :^: n)|forall i :e n , add_SNo (w 0 i) (w 1 i) = exponent i} (fun w => mul (polynomial_coefficient_derivation K add n D f (w 0)) (g (w 1)))) (module_finitely_supported_sum K add {w :e (omega :^: n) :*: (omega :^: n)|forall i :e n , add_SNo (w 0 i) (w 1 i) = exponent i} (fun w => mul (f (w 0)) (polynomial_coefficient_derivation K add n D g (w 1)))).
Axiom god1_polynomial_coefficient_derivation_multiplication : forall K , forall add mul : set -> set -> set , forall n , forall D : set -> set , ring_derivation K add mul D -> forall f g :e multivariate_polynomial_ring K add n , polynomial_coefficient_derivation K add n D (polynomial_multiplication K add mul n f g) = polynomial_addition K add n (polynomial_multiplication K add mul n (polynomial_coefficient_derivation K add n D f) g) (polynomial_multiplication K add mul n f (polynomial_coefficient_derivation K add n D g)).
Axiom god1_polynomial_coefficient_derivation_is_derivation : forall K , forall add mul : set -> set -> set , forall n , forall D : set -> set , commutative_ring K add mul -> ring_derivation K add mul D -> ring_derivation (multivariate_polynomial_ring K add n) (polynomial_addition K add n) (polynomial_multiplication K add mul n) (polynomial_coefficient_derivation K add n D).
Definition increment_exponent_coordinate : set -> set -> (set -> set) -> set := fun n i exponent => fun j :e n => if j = i then ordsucc (exponent j) else exponent j.
Definition decrement_exponent_coordinate : set -> set -> (set -> set) -> set := fun n i exponent => fun j :e n => if j = i then Union (exponent j) else exponent j.
Definition polynomial_partial_derivative : set -> (set -> set -> set) -> set -> set -> set -> set := fun K add n i f => fun exponent :e omega :^: n => ring_nat_multiple K add (ordsucc (exponent i)) (f (increment_exponent_coordinate n i (fun j => exponent j))).
Definition polynomial_derived : set -> (set -> set -> set) -> set -> set := fun K add f => polynomial_partial_derivative K add 1 0 f.
Axiom god1_decrement_exponent_coordinate_member : forall n , forall i :e n , forall exponent :e omega :^: n , decrement_exponent_coordinate n i (fun j => exponent j) :e omega :^: n.
Axiom god1_decrement_increment_exponent_coordinate : forall n , forall i :e n , forall exponent :e omega :^: n , decrement_exponent_coordinate n i (fun j => increment_exponent_coordinate n i (fun k => exponent k) j) = exponent.
Axiom god1_ring_nat_multiple_add_elements : forall K , forall add mul : set -> set -> set , ring K add mul -> forall n :e omega , forall x y :e K , ring_nat_multiple K add n (add x y) = add (ring_nat_multiple K add n x) (ring_nat_multiple K add n y).
Axiom god1_increment_exponent_coordinate_member : forall n , forall i :e n , forall exponent :e omega :^: n , increment_exponent_coordinate n i (fun j => exponent j) :e omega :^: n.
Axiom god1_increment_decrement_exponent_coordinate_nonzero : forall n , forall i :e n , forall exponent :e omega :^: n , exponent i <> 0 -> increment_exponent_coordinate n i (fun j => decrement_exponent_coordinate n i (fun k => exponent k) j) = exponent.
Axiom god1_polynomial_partial_derivative_member : forall K , forall add mul : set -> set -> set , forall n , ring K add mul -> forall i :e n , forall f :e multivariate_polynomial_ring K add n , polynomial_partial_derivative K add n i f :e multivariate_polynomial_ring K add n.
Axiom god1_polynomial_derived_member : forall K , forall add mul : set -> set -> set , ring K add mul -> forall f :e multivariate_polynomial_ring K add 1 , polynomial_derived K add f :e multivariate_polynomial_ring K add 1.
Axiom god1_polynomial_partial_derivative_addition : forall K , forall add mul : set -> set -> set , forall n , ring K add mul -> forall i :e n , forall f g :e multivariate_polynomial_ring K add n , polynomial_partial_derivative K add n i (polynomial_addition K add n f g) = polynomial_addition K add n (polynomial_partial_derivative K add n i f) (polynomial_partial_derivative K add n i g).
