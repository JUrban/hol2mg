Axiom sv_deriv_at_segment_coord_dn0 : forall n :e omega , forall m :e omega , forall f : set -> set , forall U , sv_differentiable_on n m f U -> is_convex (Rn n) (Rn_add n) (Rn_zero n) (Rn_neg n) (Rn_smul n) U -> forall x :e U , forall y :e U , let gamma := (fun s : set => Rn_add n (Rn_smul n (1 + (- s)) x) (Rn_smul n s y)) in let d := Rn_add n y (Rn_neg n x) in forall t :e Icc 0 1 , forall j :e m , d <> (Rn_zero n) -> deriv_at (fun s : set => (f (gamma s)) j) (Icc 0 1) t (((sv_derivative_at n m f U (gamma t)) d) j).
Axiom sv_deriv_at_segment_coord : forall n :e omega , forall m :e omega , forall f : set -> set , forall U , sv_differentiable_on n m f U -> is_convex (Rn n) (Rn_add n) (Rn_zero n) (Rn_neg n) (Rn_smul n) U -> forall x :e U , forall y :e U , let gamma := (fun t : set => Rn_add n (Rn_smul n (1 + (- t)) x) (Rn_smul n t y)) in let d := Rn_add n y (Rn_neg n x) in forall t :e Icc 0 1 , forall j :e m , deriv_at (fun s : set => (f (gamma s)) j) (Icc 0 1) t (((sv_derivative_at n m f U (gamma t)) d) j).
Axiom sv_segment_data_for_mvtmv : forall n :e omega , forall m :e omega , forall f : set -> set , forall U , sv_differentiable_on n m f U -> is_convex (Rn n) (Rn_add n) (Rn_zero n) (Rn_neg n) (Rn_smul n) U -> forall x :e U , forall y :e U , let gamma := (fun t : set => Rn_add n (Rn_smul n (1 + (- t)) x) (Rn_smul n t y)) in let d := Rn_add n y (Rn_neg n x) in (forall t :e Icc 0 1 , gamma t :e U) /\ (forall j :e m , continuous_on (fun t : set => (f (gamma t)) j) (Icc 0 1)) /\ (forall t :e Ioo 0 1 , forall j :e m , deriv_at (fun s : set => (f (gamma s)) j) (Icc 0 1) t (((sv_derivative_at n m f U (gamma t)) d) j)).
