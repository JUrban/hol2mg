Axiom god1_multilinear_maps_equal_on_product_basis : forall K , forall addK mulK : set -> set -> set , forall p :e omega , forall X : set -> set , forall addX smulX : set -> set -> set -> set , forall n : set -> set , forall a : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f g : set -> set , (forall h :e p , n h :e omega /\ module_basis K addK mulK (X h) (addX h) (smulX h) (n h) (a h)) -> (exists idx :e (Pi_ h :e p , n h) , 0 = 0) -> left_module K addK mulK M addM smulM -> multilinear_mapping K addK mulK p X addX smulX M addM smulM f -> multilinear_mapping K addK mulK p X addX smulX M addM smulM g -> (forall idx :e (Pi_ h :e p , n h) , f (fun h :e p => a h (idx h)) = g (fun h :e p => a h (idx h))) -> forall x :e indexed_module_product p X , f x = g x.
