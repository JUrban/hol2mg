Axiom god1_primary_global_vector_to_component_index_evaluation : forall q , forall dimensions blocks : set -> set , forall sizes : set -> set -> set , forall p t i k j ell , god1_dependent_natural_sigma_block_enumeration q blocks t = (i,k) -> god1_dependent_natural_sigma_block_enumeration (natural_indexed_sum q blocks) (god1_primary_global_block_size q blocks sizes) p = (t,j) -> ell :e dimensions i -> bij (dimensions i) (Sigma_ h :e blocks i , sizes i h) (fun x => god1_dependent_natural_sigma_block_enumeration (blocks i) (sizes i) x) -> god1_dependent_natural_sigma_block_enumeration (blocks i) (sizes i) ell = (k,j) -> god1_primary_global_vector_to_component_index q dimensions blocks sizes p = (i,ell).
Axiom god1_primary_block_chain_bases_assemble_jordan_basis : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall n q :e omega , forall a u : set -> set , forall M dimensions blocks : set -> set , forall sizes B : set -> set -> set , forall roots : set -> set , field K addK mulK -> module_basis K addK mulK E addE smul n a -> module_endomorphism K addK mulK E addE smul u -> (forall i :e q , submodule K addK mulK E addE smul (M i)) -> direct_sum_decomposition K addK mulK E addE smul q M -> (forall i :e q , dimensions i :e omega) -> (forall i :e q , blocks i :e omega) -> (forall i :e q , forall k :e blocks i , sizes i k :e omega) -> (forall i :e q , roots i :e K) -> (forall i :e q , module_basis K addK mulK (M i) addE smul (dimensions i) (B i)) -> (forall i :e q , forall k :e blocks i , 0 :e sizes i k) -> (forall i :e q , ring_finite_sum omega add_SNo (blocks i) (fun k => sizes i k) = dimensions i) -> (forall i :e q , forall k :e blocks i , forall j :e sizes i k , u (B i (add_nat (natural_indexed_sum k (sizes i)) j)) = addE (if 0 :e j then B i (add_nat (natural_indexed_sum k (sizes i)) (Union j)) else module_zero E addE) (smul (roots i) (B i (add_nat (natural_indexed_sum k (sizes i)) j)))) -> exists b : set -> set , module_basis K addK mulK E addE smul n b /\ jordan_canonical_matrix K addK mulK n (endomorphism_coordinate_matrix K addK mulK E addE smul n b u).
Axiom god1_primary_component_has_ambient_jordan_chains : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall u : set -> set , forall M , forall lambda :e K , forall r :e omega , field K addK mulK -> left_module K addK mulK E addE smul -> module_endomorphism K addK mulK E addE smul u -> submodule K addK mulK E addE smul M -> 0 :e r -> finite_dimensional_vector_space K addK mulK M addE smul -> module_dimension K addK mulK M addE smul = r -> module_endomorphism K addK mulK M addE smul (endomorphism_shift K addK mulK E addE smul u lambda) -> nilpotent_endomorphism K addK mulK M addE smul (endomorphism_shift K addK mulK E addE smul u lambda) -> exists d :e omega , exists sizes B : set -> set , ((((forall k :e d , sizes k :e omega) /\ module_basis K addK mulK M addE smul r B) /\ (forall k :e d , 0 :e sizes k)) /\ ring_finite_sum omega add_SNo d (fun k => sizes k) = r) /\ forall k :e d , forall j :e sizes k , u (B (add_nat (natural_indexed_sum k sizes) j)) = addE (if 0 :e j then B (add_nat (natural_indexed_sum k sizes) (Union j)) else module_zero E addE) (smul lambda (B (add_nat (natural_indexed_sum k sizes) j))).
Axiom god1_positive_split_endomorphism_has_jordan_basis : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall n :e omega , forall a u : set -> set , field K addK mulK -> 0 :e n -> module_basis K addK mulK E addE smul n a -> module_endomorphism K addK mulK E addE smul u -> polynomial_splits_over K addK mulK (endomorphism_characteristic_polynomial K addK mulK E addE smul n a u) -> exists b : set -> set , module_basis K addK mulK E addE smul n b /\ jordan_canonical_matrix K addK mulK n (endomorphism_coordinate_matrix K addK mulK E addE smul n b u).
Axiom god1_s35_theorem4_jordan_canonical_form : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall n :e omega , forall a : set -> set , forall u : set -> set , field K addK mulK -> module_basis K addK mulK E addE smul n a -> module_endomorphism K addK mulK E addE smul u -> (endomorphism_has_all_eigenvalues_in_field K addK mulK E addE smul n a u <-> exists b : set -> set , module_basis K addK mulK E addE smul n b /\ jordan_canonical_matrix K addK mulK n (endomorphism_coordinate_matrix K addK mulK E addE smul n b u)).
Axiom god1_jordan_canonical_form_for_matrices : forall K , forall add mul : set -> set -> set , forall n :e omega , forall U :e square_matrix_ring K n , field K add mul -> polynomial_splits_over K add mul (matrix_characteristic_polynomial K add mul n U) -> exists P :e square_matrix_ring K n , invertible_matrix K add mul n P /\ jordan_canonical_matrix K add mul n (matrix_multiplication K add mul n n n (matrix_multiplication K add mul n n n P U) (matrix_inverse K add mul n P)).
Definition field_involution : set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> prop := fun K add mul star => field K add mul /\ ring_isomorphism K add mul K add mul star /\ forall x :e K , star (star x) = x.
Definition sesquilinear_form : set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K addK mulK star L addL smul f => left_vector_space K addK mulK L addL smul /\ (forall x y :e L , f x y :e K) /\ (forall x x' y :e L , f (addL x x') y = addK (f x y) (f x' y)) /\ (forall scalar :e K , forall x y :e L , f (smul scalar x) y = mulK scalar (f x y)) /\ (forall x y y' :e L , f x (addL y y') = addK (f x y) (f x y')) /\ forall scalar :e K , forall x y :e L , f x (smul scalar y) = mulK (star scalar) (f x y).
Definition hermitian_form : set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K addK mulK star L addL smul f => sesquilinear_form K addK mulK star L addL smul f /\ forall x y :e L , f x y = star (f y x).
Definition symmetric_bilinear_form : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K addK mulK L addL smul f => hermitian_form K addK mulK (fun x => x) L addL smul f.
Definition sesquilinear_form_matrix : set -> set -> (set -> set) -> (set -> set -> set) -> set := fun K n a f => fun z :e n :*: n => f (a (z 0)) (a (z 1)).
Definition hermitian_matrix : set -> (set -> set -> set) -> (set -> set) -> set -> set -> prop := fun K add star n A => A :e square_matrix_ring K n /\ forall i j :e n , matrix_entry A j i = star (matrix_entry A i j).
Definition symmetric_matrix : set -> set -> set -> prop := fun K n A => A :e square_matrix_ring K n /\ forall i j :e n , matrix_entry A j i = matrix_entry A i j.
Definition nondegenerate_sesquilinear_form : set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K addK mulK star L addL smul f => sesquilinear_form K addK mulK star L addL smul f /\ forall y :e L , (forall x :e L , f x y = ring_zero K addK) -> y = module_zero L addL.
Definition sesquilinear_dual_map : set -> set -> (set -> set -> set) -> set -> set := fun K L f y => fun x :e L => f x y.
Axiom god1_sesquilinear_form_second_argument_components : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , sesquilinear_form K addK mulK star L addL smul f -> (left_vector_space K addK mulK L addL smul /\ forall x y :e L , f x y :e K) /\ ((forall x y y' :e L , f x (addL y y') = addK (f x y) (f x y')) /\ forall scalar :e K , forall x y :e L , f x (smul scalar y) = mulK (star scalar) (f x y)).
Axiom god1_sesquilinear_form_second_argument_basis_expansion : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall n :e omega , forall a : set -> set , forall f : set -> set -> set , field_involution K addK mulK star -> module_basis K addK mulK L addL smul n a -> sesquilinear_form K addK mulK star L addL smul f -> forall x y :e L , f x y = ring_finite_sum K addK n (fun j => mulK (f x (a j)) (star (basis_coordinates K addK mulK L addL smul n a y j))).
Axiom god1_sesquilinear_form_matrix_entry : forall K n , forall a : set -> set , forall f : set -> set -> set , forall i j :e n , matrix_entry (sesquilinear_form_matrix K n a f) i j = f (a i) (a j).
Axiom god1_sesquilinear_dual_evaluation_coordinate_formula : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall n :e omega , forall a : set -> set , forall f : set -> set -> set , field_involution K addK mulK star -> module_basis K addK mulK L addL smul n a -> sesquilinear_form K addK mulK star L addL smul f -> forall y :e L , (fun i :e n => sesquilinear_dual_map K L f y (a i)) = matrix_vector_product K addK mulK n n (sesquilinear_form_matrix K n a f) (fun j :e n => star (basis_coordinates K addK mulK L addL smul n a y j)).
Axiom god1_bijection_cancel_precomposition : forall X Y Z , forall f g : set -> set , bij X Y f -> bij X Z (fun x => g (f x)) -> bij Y Z g.
Axiom god1_bijection_cancel_postcomposition : forall X Y Z , forall f g : set -> set , (forall x :e X , f x :e Y) -> bij Y Z g -> bij X Z (fun x => g (f x)) -> bij X Y f.
Axiom god1_finite_basis_coordinate_bijection : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall n :e omega , forall a : set -> set , module_basis K addK mulK L addL smul n a -> bij L (K :^: n) (fun x => fun i :e n => basis_coordinates K addK mulK L addL smul n a x i).
Axiom god1_finite_basis_dual_evaluation_bijection : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall n :e omega , forall a : set -> set , field K addK mulK -> module_basis K addK mulK L addL smul n a -> bij (commutative_module_dual K addK mulK L addL smul) (K :^: n) (fun u => fun i :e n => u (a i)).
Axiom god1_square_matrix_invertible_iff_vector_product_bijection : forall K , forall addK mulK : set -> set -> set , forall n :e omega , forall A :e square_matrix_ring K n , division_ring K addK mulK -> (invertible_matrix K addK mulK n A <-> bij (K :^: n) (K :^: n) (matrix_vector_product K addK mulK n n A)).
Axiom god1_field_involution_power_bijection : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall n :e omega , field_involution K addK mulK star -> bij (K :^: n) (K :^: n) (fun x => fun i :e n => star (x i)).
Axiom god1_sesquilinear_form_first_argument_homomorphism : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , field_involution K addK mulK star -> sesquilinear_form K addK mulK star L addL smul f -> forall y :e L , module_homomorphism K addK mulK L addL smul K addK mulK (fun x => f x y).
Axiom god1_sesquilinear_dual_map_in : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , field_involution K addK mulK star -> sesquilinear_form K addK mulK star L addL smul f -> forall y :e L , sesquilinear_dual_map K L f y :e commutative_module_dual K addK mulK L addL smul.
Axiom god1_sesquilinear_form_matrix_invertible_iff_dual_map_bijective : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall n :e omega , forall a : set -> set , forall f : set -> set -> set , field_involution K addK mulK star -> module_basis K addK mulK L addL smul n a -> sesquilinear_form K addK mulK star L addL smul f -> (invertible_matrix K addK mulK n (sesquilinear_form_matrix K n a f) <-> bij L (commutative_module_dual K addK mulK L addL smul) (fun y : set => sesquilinear_dual_map K L f y)).
Axiom god1_sesquilinear_form_second_argument_group_homomorphism : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , field_involution K addK mulK star -> sesquilinear_form K addK mulK star L addL smul f -> forall x :e L , group_homomorphism L addL K addK (fun y => f x y).
Axiom god1_sesquilinear_dual_map_injective_iff_right_radical_zero : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , field_involution K addK mulK star -> sesquilinear_form K addK mulK star L addL smul f -> (inj L (commutative_module_dual K addK mulK L addL smul) (fun y => sesquilinear_dual_map K L f y) <-> forall y :e L , (forall x :e L , f x y = ring_zero K addK) -> y = module_zero L addL).
Axiom god1_square_matrix_vector_product_injective_implies_invertible : forall K , forall add mul : set -> set -> set , forall n :e omega , forall A :e square_matrix_ring K n , field K add mul -> inj (K :^: n) (K :^: n) (matrix_vector_product K add mul n n A) -> invertible_matrix K add mul n A.
Axiom god1_injection_cancel_bijective_precomposition : forall X Y Z , forall f g : set -> set , bij X Y f -> (forall y :e Y , g y :e Z) -> inj X Z (fun x => g (f x)) -> inj Y Z g.
Axiom god1_sesquilinear_dual_map_injective_implies_matrix_invertible : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall n :e omega , forall a : set -> set , forall f : set -> set -> set , field_involution K addK mulK star -> module_basis K addK mulK L addL smul n a -> sesquilinear_form K addK mulK star L addL smul f -> inj L (commutative_module_dual K addK mulK L addL smul) (fun y => sesquilinear_dual_map K L f y) -> invertible_matrix K addK mulK n (sesquilinear_form_matrix K n a f).
Axiom god1_sesquilinear_form_right_radical_zero_iff_matrix_invertible : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall n :e omega , forall a : set -> set , forall f : set -> set -> set , field_involution K addK mulK star -> module_basis K addK mulK L addL smul n a -> sesquilinear_form K addK mulK star L addL smul f -> ((forall y :e L , (forall x :e L , f x y = ring_zero K addK) -> y = module_zero L addL) <-> invertible_matrix K addK mulK n (sesquilinear_form_matrix K n a f)).
Axiom god1_sesquilinear_form_left_radical_basis_interface : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall n :e omega , forall a : set -> set , forall f : set -> set -> set , field_involution K addK mulK star -> module_basis K addK mulK L addL smul n a -> sesquilinear_form K addK mulK star L addL smul f -> forall x :e L , ((forall y :e L , f x y = ring_zero K addK) <-> forall i :e n , f x (a i) = ring_zero K addK).
Axiom god1_sesquilinear_form_first_argument_basis_expansion : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall n :e omega , forall a : set -> set , forall f : set -> set -> set , field_involution K addK mulK star -> module_basis K addK mulK L addL smul n a -> sesquilinear_form K addK mulK star L addL smul f -> forall x y :e L , f x y = ring_finite_sum K addK n (fun j => mulK (basis_coordinates K addK mulK L addL smul n a x j) (f (a j) y)).
Axiom god1_sesquilinear_left_evaluation_coordinate_formula : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall n :e omega , forall a : set -> set , forall f : set -> set -> set , field_involution K addK mulK star -> module_basis K addK mulK L addL smul n a -> sesquilinear_form K addK mulK star L addL smul f -> forall x :e L , (fun i :e n => f x (a i)) = matrix_vector_product K addK mulK n n (matrix_transpose K n n (sesquilinear_form_matrix K n a f)) (fun j :e n => basis_coordinates K addK mulK L addL smul n a x j).
Axiom god1_square_matrix_transpose_invertible_iff : forall K , forall add mul : set -> set -> set , forall n :e omega , forall A :e square_matrix_ring K n , field K add mul -> (invertible_matrix K add mul n A <-> invertible_matrix K add mul n (matrix_transpose K n n A)).
Axiom god1_sesquilinear_left_evaluation_injective_iff_left_radical_zero : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall n :e omega , forall a : set -> set , forall f : set -> set -> set , field_involution K addK mulK star -> module_basis K addK mulK L addL smul n a -> sesquilinear_form K addK mulK star L addL smul f -> (inj L (K :^: n) (fun x => fun i :e n => f x (a i)) <-> forall x :e L , (forall y :e L , f x y = ring_zero K addK) -> x = module_zero L addL).
Axiom god1_sesquilinear_form_left_radical_zero_iff_matrix_invertible : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall n :e omega , forall a : set -> set , forall f : set -> set -> set , field_involution K addK mulK star -> module_basis K addK mulK L addL smul n a -> sesquilinear_form K addK mulK star L addL smul f -> ((forall x :e L , (forall y :e L , f x y = ring_zero K addK) -> x = module_zero L addL) <-> invertible_matrix K addK mulK n (sesquilinear_form_matrix K n a f)).
Axiom god1_s36_example5_sesquilinear_coordinate_system_interface : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall n :e omega , forall a : set -> set , forall f : set -> set -> set , field_involution K addK mulK star -> module_basis K addK mulK L addL smul n a -> sesquilinear_form K addK mulK star L addL smul f -> forall y :e L , ((forall x :e L , f x y = ring_zero K addK) <-> forall i :e n , f (a i) y = ring_zero K addK).
Axiom god1_s36_theorem1_nondegenerate_form_characterizations : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall n :e omega , forall a : set -> set , forall f : set -> set -> set , field_involution K addK mulK star -> module_basis K addK mulK L addL smul n a -> sesquilinear_form K addK mulK star L addL smul f -> let A := sesquilinear_form_matrix K n a f in (nondegenerate_sesquilinear_form K addK mulK star L addL smul f <-> forall x :e L , (forall y :e L , f x y = ring_zero K addK) -> x = module_zero L addL) /\ ((forall x :e L , (forall y :e L , f x y = ring_zero K addK) -> x = module_zero L addL) <-> invertible_matrix K addK mulK n A) /\ (invertible_matrix K addK mulK n A <-> bij L (commutative_module_dual K addK mulK L addL smul) (fun y => sesquilinear_dual_map K L f y)).
Definition adjoint_homomorphism : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> set -> set := fun K addK mulK L M f g u y => Eps_i (fun z => z :e L /\ forall x :e L , f x z = g (u x) y).
Definition matrix_adjoint : set -> (set -> set) -> set -> set -> set -> set := fun K star p q A => fun z :e q :*: p => star (matrix_entry A (z 1) (z 0)).
Axiom god1_matrix_adjoint_in : forall K , forall star : set -> set , forall p q , forall A :e matrix_space K p q , (forall x :e K , star x :e K) -> matrix_adjoint K star p q A :e matrix_space K q p.
Axiom god1_matrix_adjoint_entry : forall K , forall star : set -> set , forall p q A , forall i :e q , forall j :e p , matrix_entry (matrix_adjoint K star p q A) i j = star (matrix_entry A j i).
Axiom god1_matrix_extensionality : forall K p q , forall A B :e matrix_space K p q , (forall i :e p , forall j :e q , matrix_entry A i j = matrix_entry B i j) -> A = B.
Axiom god1_matrix_adjoint_addition : forall K , forall add mul : set -> set -> set , forall star : set -> set , forall p q , forall A B :e matrix_space K p q , field_involution K add mul star -> matrix_adjoint K star p q (matrix_addition K add p q A B) = matrix_addition K add q p (matrix_adjoint K star p q A) (matrix_adjoint K star p q B).
Axiom god1_matrix_adjoint_left_scalar : forall K , forall add mul : set -> set -> set , forall star : set -> set , forall p q , forall A :e matrix_space K p q , forall scalar :e K , field_involution K add mul star -> matrix_adjoint K star p q (matrix_left_scalar K mul p q scalar A) = matrix_left_scalar K mul q p (star scalar) (matrix_adjoint K star p q A).
Axiom god1_matrix_adjoint_involutive : forall K , forall add mul : set -> set -> set , forall star : set -> set , forall p q , forall A :e matrix_space K p q , field_involution K add mul star -> matrix_adjoint K star q p (matrix_adjoint K star p q A) = A.
Axiom god1_matrix_adjoint_unit : forall K , forall add mul : set -> set -> set , forall star : set -> set , forall p :e omega , field_involution K add mul star -> matrix_adjoint K star p p (unit_matrix K add mul p) = unit_matrix K add mul p.
Axiom god1_matrix_adjoint_multiplication : forall K , forall add mul : set -> set -> set , forall star : set -> set , forall p q r :e omega , forall A :e matrix_space K p q , forall B :e matrix_space K q r , field_involution K add mul star -> matrix_adjoint K star p r (matrix_multiplication K add mul p q r A B) = matrix_multiplication K add mul r q p (matrix_adjoint K star q r B) (matrix_adjoint K star p q A).
Axiom god1_adjoint_homomorphism_choice_specification : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L M , forall addL smulL addM smulM : set -> set -> set , forall f g : set -> set -> set , forall u : set -> set , field_involution K addK mulK star -> finite_dimensional_vector_space K addK mulK L addL smulL -> nondegenerate_sesquilinear_form K addK mulK star L addL smulL f -> sesquilinear_form K addK mulK star M addM smulM g -> module_homomorphism K addK mulK L addL smulL M addM smulM u -> forall y :e M , adjoint_homomorphism K addK mulK L M f g u y :e L /\ forall x :e L , f x (adjoint_homomorphism K addK mulK L M f g u y) = g (u x) y.
Axiom god1_adjoint_homomorphism_representative_unique : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L M , forall addL smulL addM smulM : set -> set -> set , forall f g : set -> set -> set , forall u : set -> set , field_involution K addK mulK star -> finite_dimensional_vector_space K addK mulK L addL smulL -> nondegenerate_sesquilinear_form K addK mulK star L addL smulL f -> sesquilinear_form K addK mulK star M addM smulM g -> module_homomorphism K addK mulK L addL smulL M addM smulM u -> forall y :e M , forall z :e L , (forall x :e L , f x z = g (u x) y) -> z = adjoint_homomorphism K addK mulK L M f g u y.
Axiom god1_adjoint_homomorphism_is_linear : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L M , forall addL smulL addM smulM : set -> set -> set , forall f g : set -> set -> set , forall u : set -> set , field_involution K addK mulK star -> finite_dimensional_vector_space K addK mulK L addL smulL -> finite_dimensional_vector_space K addK mulK M addM smulM -> nondegenerate_sesquilinear_form K addK mulK star L addL smulL f -> nondegenerate_sesquilinear_form K addK mulK star M addM smulM g -> module_homomorphism K addK mulK L addL smulL M addM smulM u -> module_homomorphism K addK mulK M addM smulM L addL smulL (fun y => adjoint_homomorphism K addK mulK L M f g u y).
Axiom god1_adjoint_homomorphism_exists_is_linear_and_unique : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L M , forall addL smulL addM smulM : set -> set -> set , forall f g : set -> set -> set , forall u : set -> set , field_involution K addK mulK star -> finite_dimensional_vector_space K addK mulK L addL smulL -> finite_dimensional_vector_space K addK mulK M addM smulM -> nondegenerate_sesquilinear_form K addK mulK star L addL smulL f -> nondegenerate_sesquilinear_form K addK mulK star M addM smulM g -> module_homomorphism K addK mulK L addL smulL M addM smulM u -> module_homomorphism K addK mulK M addM smulM L addL smulL (fun y => adjoint_homomorphism K addK mulK L M f g u y) /\ (forall x :e L , forall y :e M , f x (adjoint_homomorphism K addK mulK L M f g u y) = g (u x) y) /\ forall v : set -> set , (forall y :e M , v y :e L) -> (forall x :e L , forall y :e M , f x (v y) = g (u x) y) -> forall y :e M , v y = adjoint_homomorphism K addK mulK L M f g u y.
Axiom god1_matrix_adjoint_calculation_rules : forall K , forall add mul : set -> set -> set , forall star : set -> set , forall p q r :e omega , field_involution K add mul star -> (forall A B :e matrix_space K p q , matrix_adjoint K star p q (matrix_addition K add p q A B) = matrix_addition K add q p (matrix_adjoint K star p q A) (matrix_adjoint K star p q B)) /\ (forall A :e matrix_space K p q , forall scalar :e K , matrix_adjoint K star p q (matrix_left_scalar K mul p q scalar A) = matrix_left_scalar K mul q p (star scalar) (matrix_adjoint K star p q A)) /\ (forall A :e matrix_space K p q , forall B :e matrix_space K q r , matrix_adjoint K star p r (matrix_multiplication K add mul p q r A B) = matrix_multiplication K add mul r q p (matrix_adjoint K star q r B) (matrix_adjoint K star p q A)) /\ (forall A :e matrix_space K p q , matrix_adjoint K star q p (matrix_adjoint K star p q A) = A) /\ matrix_adjoint K star p p (unit_matrix K add mul p) = unit_matrix K add mul p.
Axiom god1_adjoint_homomorphism_calculation_rules : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L M N , forall addL smulL addM smulM addN smulN : set -> set -> set , forall f g h : set -> set -> set , forall u v : set -> set , field_involution K addK mulK star -> finite_dimensional_vector_space K addK mulK L addL smulL -> finite_dimensional_vector_space K addK mulK M addM smulM -> finite_dimensional_vector_space K addK mulK N addN smulN -> nondegenerate_sesquilinear_form K addK mulK star L addL smulL f -> nondegenerate_sesquilinear_form K addK mulK star M addM smulM g -> nondegenerate_sesquilinear_form K addK mulK star N addN smulN h -> hermitian_form K addK mulK star L addL smulL f -> hermitian_form K addK mulK star M addM smulM g -> hermitian_form K addK mulK star N addN smulN h -> module_homomorphism K addK mulK L addL smulL M addM smulM u -> module_homomorphism K addK mulK M addM smulM N addN smulN v -> (forall z :e N , adjoint_homomorphism K addK mulK L N f h (fun x : set => v (u x)) z = adjoint_homomorphism K addK mulK L M f g u (adjoint_homomorphism K addK mulK M N g h v z)) /\ forall x :e L , adjoint_homomorphism K addK mulK M L g f (fun y : set => adjoint_homomorphism K addK mulK L M f g u y) x = u x.
Definition hermitian_orthogonal : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> prop := fun K addK f x y => f x y = ring_zero K addK.
Definition hermitian_orthogonal_complement : set -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> set := fun K addK L f M => {x :e L|forall y :e M , f x y = ring_zero K addK}.
Axiom god1_nondegenerate_sesquilinear_dual_representation : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , field_involution K addK mulK star -> finite_dimensional_vector_space K addK mulK L addL smul -> nondegenerate_sesquilinear_form K addK mulK star L addL smul f -> forall u :e commutative_module_dual K addK mulK L addL smul , exists y :e L , sesquilinear_dual_map K L f y = u.
Axiom god1_s36_theorem2_double_orthogonal_complement : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , forall M , field_involution K addK mulK star -> finite_dimensional_vector_space K addK mulK L addL smul -> hermitian_form K addK mulK star L addL smul f -> nondegenerate_sesquilinear_form K addK mulK star L addL smul f -> vector_subspace K addK mulK L addL smul M -> hermitian_orthogonal_complement K addK L f (hermitian_orthogonal_complement K addK L f M) = M.
Axiom god1_sesquilinear_orthogonal_complement_is_vector_subspace : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , forall M , field_involution K addK mulK star -> sesquilinear_form K addK mulK star L addL smul f -> M c= L -> vector_subspace K addK mulK L addL smul (hermitian_orthogonal_complement K addK L f M).
Axiom god1_sesquilinear_orthogonal_complement_of_sum : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , forall M N , field_involution K addK mulK star -> sesquilinear_form K addK mulK star L addL smul f -> submodule K addK mulK L addL smul M -> submodule K addK mulK L addL smul N -> hermitian_orthogonal_complement K addK L f (submodule_sum K addK mulK L addL smul M N) = (hermitian_orthogonal_complement K addK L f M :/\: hermitian_orthogonal_complement K addK L f N).
Axiom god1_s36_theorem3_orthogonal_complement_sum_and_intersection : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , forall M N , field_involution K addK mulK star -> finite_dimensional_vector_space K addK mulK L addL smul -> hermitian_form K addK mulK star L addL smul f -> nondegenerate_sesquilinear_form K addK mulK star L addL smul f -> vector_subspace K addK mulK L addL smul M -> vector_subspace K addK mulK L addL smul N -> hermitian_orthogonal_complement K addK L f (submodule_sum K addK mulK L addL smul M N) = (hermitian_orthogonal_complement K addK L f M :/\: hermitian_orthogonal_complement K addK L f N) /\ hermitian_orthogonal_complement K addK L f (M :/\: N) = submodule_sum K addK mulK L addL smul (hermitian_orthogonal_complement K addK L f M) (hermitian_orthogonal_complement K addK L f N).
Axiom god1_field_involution_over_opposite_multiplication : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , field_involution K addK mulK star -> field_involution K addK (opposite_ring_multiplication mulK) star.
Axiom god1_sesquilinear_dual_map_opposite_semilinear : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , field_involution K addK mulK star -> sesquilinear_form K addK mulK star L addL smul f -> (forall y z :e L , sesquilinear_dual_map K L f (addL y z) = right_module_dual_addition L addK (sesquilinear_dual_map K L f y) (sesquilinear_dual_map K L f z)) /\ forall scalar :e K , forall y :e L , sesquilinear_dual_map K L f (smul scalar y) = right_module_dual_left_scalar L (opposite_ring_multiplication mulK) (star scalar) (sesquilinear_dual_map K L f y).
Axiom god1_orthogonal_complement_annihilator_bijection : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , forall M , field_involution K addK mulK star -> finite_dimensional_vector_space K addK mulK L addL smul -> hermitian_form K addK mulK star L addL smul f -> nondegenerate_sesquilinear_form K addK mulK star L addL smul f -> vector_subspace K addK mulK L addL smul M -> bij (hermitian_orthogonal_complement K addK L f M) (right_subspace_annihilator K addK (opposite_ring_multiplication mulK) L addL (fun x scalar => smul scalar x) M) (fun y => sesquilinear_dual_map K L f y).
Axiom god1_involutory_semilinear_bijection_transports_finite_basis : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall X Y , forall addX smulX addY smulY : set -> set -> set , forall n :e omega , forall a : set -> set , forall phi : set -> set , field_involution K addK mulK star -> left_module K addK mulK X addX smulX -> left_module K addK mulK Y addY smulY -> module_basis K addK mulK X addX smulX n a -> bij X Y phi -> (forall x y :e X , phi (addX x y) = addY (phi x) (phi y)) -> (forall scalar :e K , forall x :e X , phi (smulX scalar x) = smulY (star scalar) (phi x)) -> module_basis K addK mulK Y addY smulY n (fun i => phi (a i)).
Axiom god1_orthogonal_complement_annihilator_same_dimension : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , forall M , field_involution K addK mulK star -> finite_dimensional_vector_space K addK mulK L addL smul -> hermitian_form K addK mulK star L addL smul f -> nondegenerate_sesquilinear_form K addK mulK star L addL smul f -> vector_subspace K addK mulK L addL smul M -> module_dimension K addK mulK (hermitian_orthogonal_complement K addK L f M) addL smul = module_dimension K addK (opposite_ring_multiplication mulK) (right_subspace_annihilator K addK (opposite_ring_multiplication mulK) L addL (fun x scalar => smul scalar x) M) (right_module_dual_addition L addK) (right_module_dual_left_scalar L (opposite_ring_multiplication mulK)).
Axiom god1_s36_theorem4_dimension_of_orthogonal_complement : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , forall M , field_involution K addK mulK star -> finite_dimensional_vector_space K addK mulK L addL smul -> hermitian_form K addK mulK star L addL smul f -> nondegenerate_sesquilinear_form K addK mulK star L addL smul f -> vector_subspace K addK mulK L addL smul M -> add_SNo (module_dimension K addK mulK M addL smul) (module_dimension K addK mulK (hermitian_orthogonal_complement K addK L f M) addL smul) = module_dimension K addK mulK L addL smul.
Definition isotropic_subspace : set -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> prop := fun K addK L addL f M => M :/\: hermitian_orthogonal_complement K addK L f M <> {module_zero L addL}.
Definition isotropic_vector : set -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> prop := fun K addK L f x => x :e L /\ f x x = ring_zero K addK.
Definition isotropic_cone : set -> (set -> set -> set) -> set -> (set -> set -> set) -> set := fun K addK L f => {x :e L|f x x = ring_zero K addK}.
Definition orthogonal_projection : set -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> set := fun K addK L addL M f x => Eps_i (fun y => y :e M /\ forall z :e M , f (addL x (module_negation L addL y)) z = ring_zero K addK).
Axiom god1_submodule_induced_zero_agrees : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall A , submodule K addK mulK E addE smul A -> module_zero A addE = module_zero E addE.
Axiom god1_finite_left_space_zero_dimension_iff_singleton : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , finite_dimensional_vector_space K addK mulK E addE smul -> (module_dimension K addK mulK E addE smul = 0 <-> E = {module_zero E addE}).
Axiom god1_finite_left_space_dimension_is_natural : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , finite_dimensional_vector_space K addK mulK E addE smul -> module_dimension K addK mulK E addE smul :e omega.
Axiom god1_two_submodules_direct_sum_iff_intersection_and_sum : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall A B , submodule K addK mulK E addE smul A -> submodule K addK mulK E addE smul B -> (direct_sum_decomposition K addK mulK E addE smul 2 (fun i => if i = 0 then A else B) <-> {x :e A|x :e B} = {module_zero E addE} /\ submodule_sum K addK mulK E addE smul A B = E).
Axiom god1_hermitian_form_restricts_to_vector_subspace : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , forall M , hermitian_form K addK mulK star L addL smul f -> vector_subspace K addK mulK L addL smul M -> hermitian_form K addK mulK star M addL smul f.
Axiom god1_restricted_hermitian_nondegenerate_iff_trivial_intersection : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , forall M , field_involution K addK mulK star -> hermitian_form K addK mulK star L addL smul f -> vector_subspace K addK mulK L addL smul M -> (M :/\: hermitian_orthogonal_complement K addK L f M = {module_zero L addL} <-> nondegenerate_sesquilinear_form K addK mulK star M addL smul f).
Axiom god1_nondegenerate_restriction_implies_orthogonal_sum : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , forall M , field_involution K addK mulK star -> finite_dimensional_vector_space K addK mulK L addL smul -> hermitian_form K addK mulK star L addL smul f -> vector_subspace K addK mulK L addL smul M -> nondegenerate_sesquilinear_form K addK mulK star M addL smul f -> submodule_sum K addK mulK L addL smul M (hermitian_orthogonal_complement K addK L f M) = L.
Axiom god1_nondegenerate_orthogonal_sum_implies_trivial_intersection : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , forall M , field_involution K addK mulK star -> finite_dimensional_vector_space K addK mulK L addL smul -> hermitian_form K addK mulK star L addL smul f -> nondegenerate_sesquilinear_form K addK mulK star L addL smul f -> vector_subspace K addK mulK L addL smul M -> submodule_sum K addK mulK L addL smul M (hermitian_orthogonal_complement K addK L f M) = L -> M :/\: hermitian_orthogonal_complement K addK L f M = {module_zero L addL}.
Axiom god1_s36_theorem5_nonisotropic_subspace_characterizations : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , forall M , field_involution K addK mulK star -> finite_dimensional_vector_space K addK mulK L addL smul -> hermitian_form K addK mulK star L addL smul f -> vector_subspace K addK mulK L addL smul M -> ((M :/\: hermitian_orthogonal_complement K addK L f M = {module_zero L addL}) <-> nondegenerate_sesquilinear_form K addK mulK star M addL smul f) /\ (nondegenerate_sesquilinear_form K addK mulK star M addL smul f <-> direct_sum_decomposition K addK mulK L addL smul 2 (fun i => if i = 0 then M else hermitian_orthogonal_complement K addK L f M)) /\ (nondegenerate_sesquilinear_form K addK mulK star L addL smul f -> (submodule_sum K addK mulK L addL smul M (hermitian_orthogonal_complement K addK L f M) = L <-> M :/\: hermitian_orthogonal_complement K addK L f M = {module_zero L addL})).
Axiom god1_scalar_multiples_form_vector_subspace : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall a :e L , left_vector_space K addK mulK L addL smul -> vector_subspace K addK mulK L addL smul {smul scalar a|scalar :e K}.
Axiom god1_s36_theorem5_corollary_no_isotropic_vectors : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , field_involution K addK mulK star -> finite_dimensional_vector_space K addK mulK L addL smul -> hermitian_form K addK mulK star L addL smul f -> ((forall x :e L , f x x = ring_zero K addK -> x = module_zero L addL) <-> forall M , vector_subspace K addK mulK L addL smul M -> direct_sum_decomposition K addK mulK L addL smul 2 (fun i => if i = 0 then M else hermitian_orthogonal_complement K addK L f M)).
Axiom god1_orthogonal_projection_characterization : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , forall M , field_involution K addK mulK star -> finite_dimensional_vector_space K addK mulK L addL smul -> hermitian_form K addK mulK star L addL smul f -> vector_subspace K addK mulK L addL smul M -> nondegenerate_sesquilinear_form K addK mulK star M addL smul f -> forall x :e L , forall y , (y = orthogonal_projection K addK L addL M f x <-> y :e M /\ forall z :e M , f (addL x (module_negation L addL y)) z = ring_zero K addK).
Axiom god1_orthogonal_projection_onto_nonisotropic_line : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , forall a :e L , field_involution K addK mulK star -> hermitian_form K addK mulK star L addL smul f -> f a a <> ring_zero K addK -> let M := {smul scalar a|scalar :e K} in forall x :e L , orthogonal_projection K addK L addL M f x = smul (mulK (f x a) (ring_inverse K addK mulK (f a a))) a.
Axiom god1_algebraically_closed_polynomial_with_quadratic_coefficient_has_root : forall K , forall add mul : set -> set -> set , forall p :e multivariate_polynomial_ring K add 1 , algebraically_closed_field K add mul -> p (fun i :e 1 => 2) <> ring_zero K add -> exists scalar :e K , polynomial_evaluation K add mul K add mul 1 p (fun i => scalar) = ring_zero K add.
Axiom god1_commutative_ring_bilinear_quadratic_rearrangement : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall scalar A B C D :e K , add (add (mul scalar (mul scalar A)) (mul scalar B)) (add (mul scalar C) D) = add (mul A (mul scalar scalar)) (add (mul (add B C) scalar) D).
Axiom god1_algebraically_closed_quadratic_equation_has_root : forall K , forall add mul : set -> set -> set , algebraically_closed_field K add mul -> forall A B C :e K , A <> ring_zero K add -> exists scalar :e K , add (mul A (mul scalar scalar)) (add (mul B scalar) C) = ring_zero K add.
Axiom god1_algebraically_closed_symmetric_form_has_isotropic_vector : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , algebraically_closed_field K addK mulK -> symmetric_bilinear_form K addK mulK L addL smul f -> finite_dimensional_vector_space K addK mulK L addL smul -> 2 c= module_dimension K addK mulK L addL smul -> exists x :e L , x <> module_zero L addL /\ f x x = ring_zero K addK.
Definition orthogonal_basis_for_form : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> prop := fun K addK mulK L addL smul f n a => module_basis K addK mulK L addL smul n a /\ forall i j :e n , i <> j -> f (a i) (a j) = ring_zero K addK.
Axiom god1_field_characteristic_not_two_implies_two_nonzero : forall K , forall add mul : set -> set -> set , field K add mul -> field_characteristic K add mul <> 2 -> add (ring_one K mul) (ring_one K mul) <> ring_zero K add.
Axiom god1_hermitian_zero_diagonal_pair_sum : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , field_involution K addK mulK star -> hermitian_form K addK mulK star L addL smul f -> (forall x :e L , f x x = ring_zero K addK) -> forall x y :e L , addK (f x y) (star (f x y)) = ring_zero K addK.
Axiom god1_nonzero_hermitian_form_has_nonisotropic_vector_before_theorem6 : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , field_involution K addK mulK star -> hermitian_form K addK mulK star L addL smul f -> field_characteristic K addK mulK <> 2 -> (exists x y :e L , f x y <> ring_zero K addK) -> exists x :e L , f x x <> ring_zero K addK.
