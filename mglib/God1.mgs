Section NatRec.
Variable z : set.
Variable f : set -> set -> set.
Let F : set -> (set -> set) -> set := fun n g => if Union n :e n then f (Union n) (g (Union n)) else z.
Definition nat_primrec : set -> set := In_rec_i F.
Axiom nat_primrec_r : forall X : set , forall g h : set -> set , (forall x :e X , g x = h x) -> F X g = F X h.
Axiom nat_primrec_0 : nat_primrec 0 = z.
Axiom nat_primrec_S : forall n : set , nat_p n -> nat_primrec (ordsucc n) = f n (nat_primrec n).
End NatRec.
Section NatAdd.
Definition add_nat : set -> set -> set := fun n m : set => nat_primrec n (fun _ r => ordsucc r) m.
Infix + 360 right  := add_nat.
Axiom add_nat_0R : forall n : set , n + 0 = n.
Axiom add_nat_SR : forall n m : set , nat_p m -> n + ordsucc m = ordsucc (n + m).
Axiom add_nat_p : forall n : set , nat_p n -> forall m : set , nat_p m -> nat_p (n + m).
Axiom add_nat_1_1_2 : 1 + 1 = 2.
Axiom add_nat_asso : forall n : set , nat_p n -> forall m : set , nat_p m -> forall k : set , nat_p k -> (n + m) + k = n + (m + k).
Axiom add_nat_0L : forall m : set , nat_p m -> 0 + m = m.
Axiom add_nat_SL : forall n : set , nat_p n -> forall m : set , nat_p m -> ordsucc n + m = ordsucc (n + m).
Axiom add_nat_com : forall n : set , nat_p n -> forall m : set , nat_p m -> n + m = m + n.
Axiom add_nat_In_R : forall m , nat_p m -> forall k :e m , forall n , nat_p n -> k + n :e m + n.
Axiom add_nat_In_L : forall n , nat_p n -> forall m , nat_p m -> forall k :e m , n + k :e n + m.
Axiom add_nat_Subq_R : forall k , nat_p k -> forall m , nat_p m -> k c= m -> forall n , nat_p n -> k + n c= m + n.
Axiom add_nat_Subq_L : forall n , nat_p n -> forall k , nat_p k -> forall m , nat_p m -> k c= m -> n + k c= n + m.
Axiom add_nat_Subq_R' : forall m , nat_p m -> forall n , nat_p n -> m c= m + n.
Axiom nat_Subq_add_ex : forall n , nat_p n -> forall m , nat_p m -> n c= m -> exists k , nat_p k /\ m = k + n.
Axiom add_nat_cancel_R : forall k , nat_p k -> forall m , nat_p m -> forall n , nat_p n -> k + n = m + n -> k = m.
End NatAdd.
Section NatMul.
Infix + 360 right  := add_nat.
Definition mul_nat : set -> set -> set := fun n m : set => nat_primrec 0 (fun _ r => n + r) m.
Infix * 355 right  := mul_nat.
Axiom mul_nat_0R : forall n : set , n * 0 = 0.
Axiom mul_nat_SR : forall n m , nat_p m -> n * ordsucc m = n + n * m.
Axiom mul_nat_1R : forall n , n * 1 = n.
Axiom mul_nat_p : forall n : set , nat_p n -> forall m : set , nat_p m -> nat_p (n * m).
Axiom mul_nat_0L : forall m : set , nat_p m -> 0 * m = 0.
Axiom mul_nat_SL : forall n : set , nat_p n -> forall m : set , nat_p m -> ordsucc n * m = n * m + m.
Axiom mul_nat_com : forall n : set , nat_p n -> forall m : set , nat_p m -> n * m = m * n.
Axiom mul_add_nat_distrL : forall n : set , nat_p n -> forall m : set , nat_p m -> forall k : set , nat_p k -> n * (m + k) = n * m + n * k.
Axiom mul_nat_asso : forall n : set , nat_p n -> forall m : set , nat_p m -> forall k : set , nat_p k -> (n * m) * k = n * (m * k).
Axiom mul_nat_Subq_R : forall m n , nat_p m -> nat_p n -> m c= n -> forall k , nat_p k -> m * k c= n * k.
Axiom mul_nat_Subq_L : forall m n , nat_p m -> nat_p n -> m c= n -> forall k , nat_p k -> k * m c= k * n.
Axiom mul_nat_0_or_Subq : forall m , nat_p m -> forall n , nat_p n -> n = 0 \/ m c= m * n.
Axiom mul_nat_0_inv : forall m , nat_p m -> forall n , nat_p n -> m * n = 0 -> m = 0 \/ n = 0.
Axiom mul_nat_0m_1n_In : forall m , nat_p m -> forall n , nat_p n -> 0 :e m -> 1 :e n -> m :e m * n.
Axiom nat_le1_cases : forall m , nat_p m -> m c= 1 -> m = 0 \/ m = 1.
Definition Pi_nat : (set -> set) -> set -> set := fun f n => nat_primrec 1 (fun i r => r * f i) n.
Axiom Pi_nat_0 : forall f : set -> set , Pi_nat f 0 = 1.
Axiom Pi_nat_S : forall f : set -> set , forall n , nat_p n -> Pi_nat f (ordsucc n) = Pi_nat f n * f n.
Axiom Pi_nat_p : forall f : set -> set , forall n , nat_p n -> (forall i :e n , nat_p (f i)) -> nat_p (Pi_nat f n).
Axiom Pi_nat_0_inv : forall f : set -> set , forall n , nat_p n -> (forall i :e n , nat_p (f i)) -> Pi_nat f n = 0 -> (exists i :e n , f i = 0).
Definition exp_nat : set -> set -> set := fun n m : set => nat_primrec 1 (fun _ r => n * r) m.
Infix ^ 342 right  := exp_nat.
Axiom exp_nat_0 : forall n , n ^ 0 = 1.
Axiom exp_nat_S : forall n m , nat_p m -> n ^ (ordsucc m) = n * n ^ m.
Axiom exp_nat_p : forall n , nat_p n -> forall m , nat_p m -> nat_p (n ^ m).
Axiom exp_nat_1 : forall n , n ^ 1 = n.
End NatMul.
