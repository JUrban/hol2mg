Section form92.
Definition complex_partial_sum_seq : (set -> set) -> (set -> set) := fun x => fun n => nat_primrec 0 (fun i r => add_CSNo r (x i)) n.
Axiom complex_partial_sum_seq_0 : forall x : set -> set , complex_partial_sum_seq x 0 = 0.
Axiom complex_partial_sum_seq_S : forall x : set -> set , forall n :e omega , complex_partial_sum_seq x (ordsucc n) = add_CSNo (complex_partial_sum_seq x n) (x n).
Axiom complex_partial_sum_seq_in_complex : forall x : set -> set , (forall n :e omega , x n :e complex) -> forall n :e omega , complex_partial_sum_seq x n :e complex.
Axiom complex_partial_sum_seq_ext : forall x y : set -> set , forall n :e omega , (forall i :e n , x i = y i) -> complex_partial_sum_seq x n = complex_partial_sum_seq y n.
Axiom complex_partial_sum_seq_const_zero : forall n :e omega , complex_partial_sum_seq (fun i : set => 0) n = 0.
Axiom complex_partial_sum_seq_mul_const_left : forall c :e complex , forall y : set -> set , (forall n :e omega , y n :e complex) -> forall n :e omega , complex_partial_sum_seq (fun j : set => mul_CSNo c (y j)) n = mul_CSNo c (complex_partial_sum_seq y n).
Axiom complex_partial_sum_seq_mul_const_right : forall y : set -> set , forall c :e complex , (forall n :e omega , y n :e complex) -> forall n :e omega , complex_partial_sum_seq (fun j : set => mul_CSNo (y j) c) n = mul_CSNo (complex_partial_sum_seq y n) c.
Axiom complex_partial_sum_seq_add_nat_split : forall x : set -> set , (forall k :e omega , x k :e complex) -> forall M :e omega , forall n :e omega , complex_partial_sum_seq x (add_nat M n) = add_CSNo (complex_partial_sum_seq x M) (complex_partial_sum_seq (tail_series x M) n).
Axiom complex_partial_sum_seq_product : forall x : set -> set , forall y : set -> set , (forall i :e omega , x i :e complex) -> (forall j :e omega , y j :e complex) -> forall m :e omega , forall n :e omega , mul_CSNo (complex_partial_sum_seq x m) (complex_partial_sum_seq y n) = complex_partial_sum_seq (fun i : set => complex_partial_sum_seq (fun j : set => mul_CSNo (x i) (y j)) n) m.
Axiom complex_Re_add_CSNo : forall z :e complex , forall w :e complex , Re (add_CSNo z w) = Re z + Re w.
Axiom complex_Im_add_CSNo : forall z :e complex , forall w :e complex , Im (add_CSNo z w) = Im z + Im w.
Axiom complex_partial_sum_seq_Re : forall x : set -> set , (forall n :e omega , x n :e complex) -> forall n :e omega , Re (complex_partial_sum_seq x n) = partial_sum_seq (fun k : set => Re (x k)) n.
Axiom complex_partial_sum_seq_Im : forall x : set -> set , (forall n :e omega , x n :e complex) -> forall n :e omega , Im (complex_partial_sum_seq x n) = partial_sum_seq (fun k : set => Im (x k)) n.
Axiom complex_partial_sum_seq_add_split : forall x y : set -> set , (forall n :e omega , x n :e complex) -> (forall n :e omega , y n :e complex) -> forall n :e omega , complex_partial_sum_seq (fun i : set => add_CSNo (x i) (y i)) n = add_CSNo (complex_partial_sum_seq x n) (complex_partial_sum_seq y n).
Axiom complex_partial_sum_seq_double_swap : forall a : set -> set -> set , forall n :e omega , forall m :e omega , (forall i :e omega , forall j :e omega , a i j :e complex) -> complex_partial_sum_seq (fun i : set => complex_partial_sum_seq (fun j : set => a i j) m) n = complex_partial_sum_seq (fun j : set => complex_partial_sum_seq (fun i : set => a i j) n) m.
Axiom complex_add_CSNo_cancel_L : forall x :e complex , forall y :e complex , forall z :e complex , add_CSNo x y = add_CSNo x z -> y = z.
Axiom complex_partial_sum_seq_tail_series_eq : forall x : set -> set , (forall k :e omega , x k :e complex) -> forall M :e omega , forall n :e omega , complex_partial_sum_seq (tail_series x M) n = add_CSNo (complex_partial_sum_seq x (add_nat M n)) (minus_CSNo (complex_partial_sum_seq x M)).
Axiom complex_partial_sum_seq_mul_const_left_tail_series : forall c :e complex , forall y : set -> set , (forall n :e omega , y n :e complex) -> forall M :e omega , forall n :e omega , complex_partial_sum_seq (tail_series (fun j : set => mul_CSNo c (y j)) M) n = mul_CSNo c (complex_partial_sum_seq (tail_series y M) n).
Axiom complex_partial_sum_seq_mul_const_left_add_nat_split : forall c :e complex , forall y : set -> set , (forall n :e omega , y n :e complex) -> forall M :e omega , forall n :e omega , complex_partial_sum_seq (fun j : set => mul_CSNo c (y j)) (add_nat M n) = add_CSNo (complex_partial_sum_seq (fun j : set => mul_CSNo c (y j)) M) (mul_CSNo c (complex_partial_sum_seq (tail_series y M) n)).
Definition factorial : set -> set := fun n => nat_primrec 1 (fun i r => mul_SNo r (ordsucc i)) n.
Definition complex_exp : set -> set := fun z => ms_lim_seq complex dist_complex (complex_partial_sum_seq (fun n => div_CSNo (exp_CSNo_nat z n) (factorial n))).
Definition complex_cos : set -> set := fun z => div_CSNo (add_CSNo (complex_exp (mul_CSNo Complex_i z)) (complex_exp (minus_CSNo (mul_CSNo Complex_i z)))) 2.
Definition complex_sin : set -> set := fun z => div_CSNo (add_CSNo (complex_exp (mul_CSNo Complex_i z)) (minus_CSNo (complex_exp (minus_CSNo (mul_CSNo Complex_i z))))) (mul_CSNo 2 Complex_i).
Definition pi : set := 2 * Eps_i (fun y => y :e real /\ 0 < y /\ complex_cos y = 0 /\ forall z :e real , 0 < z -> complex_cos z = 0 -> y <= z).
Definition complex_cos_first_positive_real_zero_pred : set -> prop := fun y => y :e real /\ 0 < y /\ complex_cos y = 0 /\ forall z :e real , 0 < z -> complex_cos z = 0 -> y <= z.
Axiom complex_cos_first_positive_real_zero_pred_exists_of_exists : (exists y , y :e real /\ 0 < y /\ complex_cos y = 0 /\ forall z :e real , 0 < z -> complex_cos z = 0 -> y <= z) -> exists y , complex_cos_first_positive_real_zero_pred y.
Axiom complex_cos_first_positive_real_zero_choice_pred : (exists y , complex_cos_first_positive_real_zero_pred y) -> complex_cos_first_positive_real_zero_pred (Eps_i complex_cos_first_positive_real_zero_pred).
Axiom complex_cos_first_positive_real_zero_choice_pred_of_exists : (exists y , y :e real /\ 0 < y /\ complex_cos y = 0 /\ forall z :e real , 0 < z -> complex_cos z = 0 -> y <= z) -> complex_cos_first_positive_real_zero_pred (Eps_i complex_cos_first_positive_real_zero_pred).
Axiom complex_cos_first_positive_real_zero_exists_of_pred_exists : (exists y , complex_cos_first_positive_real_zero_pred y) -> exists y , y :e real /\ 0 < y /\ complex_cos y = 0 /\ forall z :e real , 0 < z -> complex_cos z = 0 -> y <= z.
Axiom complex_cos_first_positive_real_zero_choice_spec : (exists y , y :e real /\ 0 < y /\ complex_cos y = 0 /\ forall z :e real , 0 < z -> complex_cos z = 0 -> y <= z) -> (Eps_i (fun y => y :e real /\ 0 < y /\ complex_cos y = 0 /\ forall z :e real , 0 < z -> complex_cos z = 0 -> y <= z)) :e real /\ 0 < (Eps_i (fun y => y :e real /\ 0 < y /\ complex_cos y = 0 /\ forall z :e real , 0 < z -> complex_cos z = 0 -> y <= z)) /\ complex_cos (Eps_i (fun y => y :e real /\ 0 < y /\ complex_cos y = 0 /\ forall z :e real , 0 < z -> complex_cos z = 0 -> y <= z)) = 0 /\ forall z :e real , 0 < z -> complex_cos z = 0 -> (Eps_i (fun y => y :e real /\ 0 < y /\ complex_cos y = 0 /\ forall z :e real , 0 < z -> complex_cos z = 0 -> y <= z)) <= z.
Axiom complex_cos_first_positive_real_zero_choice_zero : (exists y , y :e real /\ 0 < y /\ complex_cos y = 0 /\ forall z :e real , 0 < z -> complex_cos z = 0 -> y <= z) -> complex_cos (Eps_i (fun y => y :e real /\ 0 < y /\ complex_cos y = 0 /\ forall z :e real , 0 < z -> complex_cos z = 0 -> y <= z)) = 0.
