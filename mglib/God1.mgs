Axiom ms_continuous_on_rect_subq_left : forall a t b c d :e R , t <= b -> forall f : set -> set , ms_continuous_on f (Rn 2) (Rn_dist 2) R dist_R (rect_Icc_R2 a b c d) -> ms_continuous_on f (Rn 2) (Rn_dist 2) R dist_R (rect_Icc_R2 a t c d).
Axiom leibniz_integral_rule_Icc_strict : forall a b c d :e R , a < b -> c < d -> forall f : set -> set , forall dfdy : set -> set , ms_continuous_on f (Rn 2) (Rn_dist 2) R dist_R (rect_Icc_R2 a b c d) -> ms_continuous_on dfdy (Rn 2) (Rn_dist 2) R dist_R (rect_Icc_R2 a b c d) -> (forall x :e (Icc a b) , forall y :e (Icc c d) , deriv_at (fun t : set => f (R2_pair x t)) (Icc c d) y (dfdy (R2_pair x y))) -> (forall y :e (Icc c d) , deriv_at (leibniz_int_Icc a b f) (Icc c d) y (leibniz_int_Icc a b dfdy y)).
Axiom leibniz_integral_rule_Icc : forall a b c d :e R , a <= b -> c < d -> forall f : set -> set , forall dfdy : set -> set , ms_continuous_on f (Rn 2) (Rn_dist 2) R dist_R (rect_Icc_R2 a b c d) -> ms_continuous_on dfdy (Rn 2) (Rn_dist 2) R dist_R (rect_Icc_R2 a b c d) -> (forall x :e (Icc a b) , forall y :e (Icc c d) , deriv_at (fun t : set => f (R2_pair x t)) (Icc c d) y (dfdy (R2_pair x y))) -> (forall y :e (Icc c d) , deriv_at (leibniz_int_Icc a b f) (Icc c d) y (leibniz_int_Icc a b dfdy y)).
