Axiom god1_inverse_reduced_rhs_affine_expansion : forall K , forall add mul : set -> set -> set , forall n p :e omega , forall A :e matrix_space K n p , forall cols :e p :^: n , division_ring K add mul -> inj n p (fun i => cols i) -> invertible_matrix K add mul n (matrix_submatrix n n (fun i => i) (fun j => cols j) A) -> forall b :e K :^: n , forall eta :e K :^: p , forall i :e n , matrix_vector_product K add mul n n (matrix_inverse K add mul n (matrix_submatrix n n (fun h => h) (fun h => cols h) A)) (module_power_addition n add b (group_inverse (K :^: n) (module_power_addition n add) (fun j :e n => module_finitely_supported_sum K add {k :e p|k /:e {cols h|h :e n}} (fun k => mul (matrix_entry A j k) (eta k))))) i = add (ring_finite_sum K add n (fun j => mul (matrix_entry (matrix_inverse K add mul n (matrix_submatrix n n (fun h => h) (fun h => cols h) A)) i j) (b j))) (module_finitely_supported_sum K add {k :e p|k /:e {cols h|h :e n}} (fun k => mul (ring_negation K add (matrix_entry (matrix_multiplication K add mul n n p (matrix_inverse K add mul n (matrix_submatrix n n (fun h => h) (fun h => cols h) A)) A) i k)) (eta k))).
Axiom god1_invertible_column_restriction_parametric_solution : forall K , forall add mul : set -> set -> set , forall n p :e omega , forall A :e matrix_space K n p , forall cols :e p :^: n , division_ring K add mul -> inj n p (fun i => cols i) -> invertible_matrix K add mul n (matrix_submatrix n n (fun i => i) (fun j => cols j) A) -> exists Lambda :e matrix_space K n p , forall b :e K :^: n , forall eta :e K :^: p , exists x :e K :^: p , (((linear_system_solution K add mul n p A b x /\ forall k :e p , k /:e {cols i|i :e n} -> x k = eta k) /\ forall i :e n , x (cols i) = add (ring_finite_sum K add n (fun j => mul (matrix_entry (matrix_inverse K add mul n (matrix_submatrix n n (fun h => h) (fun h => cols h) A)) i j) (b j))) (module_finitely_supported_sum K add {k :e p|k /:e {cols h|h :e n}} (fun k => mul (matrix_entry Lambda i k) (eta k)))) /\ forall y :e K :^: p , linear_system_solution K add mul n p A b y -> (forall k :e p , k /:e {cols i|i :e n} -> y k = eta k) -> y = x).
Axiom god1_invertible_column_restriction_affine_formula_projection : forall K , forall add mul : set -> set -> set , forall n p :e omega , forall A :e matrix_space K n p , forall cols :e p :^: n , division_ring K add mul -> inj n p (fun i => cols i) -> invertible_matrix K add mul n (matrix_submatrix n n (fun i => i) (fun j => cols j) A) -> exists Lambda :e matrix_space K n p , forall b :e K :^: n , forall eta :e K :^: p , exists x :e K :^: p , forall i :e n , x (cols i) = add (ring_finite_sum K add n (fun j => mul (matrix_entry (matrix_inverse K add mul n (matrix_submatrix n n (fun h => h) (fun h => cols h) A)) i j) (b j))) (module_finitely_supported_sum K add {k :e p|k /:e {cols h|h :e n}} (fun k => mul (matrix_entry Lambda i k) (eta k))).
Axiom god1_s20_theorem3_independent_system_reduces_to_cramer_system : forall K , forall add mul : set -> set -> set , forall n p :e omega , forall A :e matrix_space K n p , division_ring K add mul -> linearly_independent_family K add mul (right_module_dual K add mul (K :^: p) (module_power_addition p add) (fun x scalar => module_power_left_scalar p (opposite_ring_multiplication mul) scalar x)) (right_module_dual_addition (K :^: p) add) (right_module_dual_left_scalar (K :^: p) mul) n (fun i => fun x :e K :^: p => matrix_row_linear_form K add mul p A i x) -> exists cols :e p :^: n , inj n p (fun i => cols i) /\ invertible_matrix K add mul n (matrix_submatrix n n (fun i => i) (fun j => cols j) A) /\ exists Lambda :e matrix_space K n p , forall b :e K :^: n , forall eta :e K :^: p , exists x :e K :^: p , linear_system_solution K add mul n p A b x /\ (forall k :e p , k /:e {cols i|i :e n} -> x k = eta k) /\ (forall i :e n , x (cols i) = add (ring_finite_sum K add n (fun j => mul (matrix_entry (matrix_inverse K add mul n (matrix_submatrix n n (fun h => h) (fun h => cols h) A)) i j) (b j))) (module_finitely_supported_sum K add {k :e p|k /:e {cols h|h :e n}} (fun k => mul (matrix_entry Lambda i k) (eta k)))) /\ forall y :e K :^: p , linear_system_solution K add mul n p A b y -> (forall k :e p , k /:e {cols i|i :e n} -> y k = eta k) -> y = x.
Definition indexed_function_update : set -> set -> set -> set -> set := fun I x i y => fun j :e I => if j = i then y else x j.
Definition multilinear_mapping : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set -> set) -> (set -> set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> prop := fun K addK mulK I X addX smulX M addM smulM f => commutative_ring K addK mulK /\ (forall i :e I , left_module K addK mulK (X i) (addX i) (smulX i)) /\ left_module K addK mulK M addM smulM /\ (forall x :e indexed_module_product I X , f x :e M) /\ forall i :e I , forall x :e indexed_module_product I X , forall u v :e X i , forall scalar mu :e K , f (indexed_function_update I x i (addX i (smulX i scalar u) (smulX i mu v))) = addM (smulM scalar (f (indexed_function_update I x i u))) (smulM mu (f (indexed_function_update I x i v))).
Definition bilinear_mapping : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> prop := fun K addK mulK X addX smulX Y addY smulY M addM smulM f => multilinear_mapping K addK mulK 2 (fun i => if i = 0 then X else Y) (fun i x y => if i = 0 then addX x y else addY x y) (fun i scalar x => if i = 0 then smulX scalar x else smulY scalar x) M addM smulM f.
Definition bilinear_tuple : set -> set -> set := fun x y => fun i :e 2 => if i = 0 then x else y.
Definition trilinear_mapping : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> prop := fun K addK mulK X addX smulX Y addY smulY Z addZ smulZ M addM smulM f => multilinear_mapping K addK mulK 3 (fun i => if i = 0 then X else if i = 1 then Y else Z) (fun i x y => if i = 0 then addX x y else if i = 1 then addY x y else addZ x y) (fun i scalar x => if i = 0 then smulX scalar x else if i = 1 then smulY scalar x else smulZ scalar x) M addM smulM f.
Definition trilinear_tuple : set -> set -> set -> set := fun x y z => fun i :e 3 => if i = 0 then x else if i = 1 then y else z.
Definition multilinear_mapping_space : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set -> set) -> (set -> set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set := fun K addK mulK I X addX smulX M addM smulM => {f :e M :^: (indexed_module_product I X)|multilinear_mapping K addK mulK I X addX smulX M addM smulM (fun x => f x)}.
Definition multilinear_mapping_addition : set -> (set -> set -> set) -> set -> set -> set := fun D addM => module_homomorphism_addition D addM.
Definition multilinear_mapping_scalar : set -> (set -> set -> set) -> set -> set -> set := fun D smulM => module_homomorphism_scalar D smulM.
Axiom god1_if_member_by_cases : forall X , forall p : prop , forall a b , (p -> a :e X) -> (~ p -> b :e X) -> (if p then a else b) :e X.
Axiom god1_indexed_function_update_in : forall I , forall X : set -> set , forall x :e indexed_module_product I X , forall i :e I , forall u :e X i , indexed_function_update I x i u :e indexed_module_product I X.
Axiom god1_module_homomorphism_raw_pointwise_scalar : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall scalar :e K , forall f : set -> set , commutative_ring K addK mulK -> left_module K addK mulK L addL smulL -> left_module K addK mulK M addM smulM -> module_homomorphism K addK mulK L addL smulL M addM smulM f -> module_homomorphism K addK mulK L addL smulL M addM smulM (fun x => smulM scalar (f x)).
Axiom god1_module_homomorphism_raw_two_scalar_combination : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall scalar mu :e K , forall f g : set -> set , commutative_ring K addK mulK -> left_module K addK mulK L addL smulL -> left_module K addK mulK M addM smulM -> module_homomorphism K addK mulK L addL smulL M addM smulM f -> module_homomorphism K addK mulK L addL smulL M addM smulM g -> module_homomorphism K addK mulK L addL smulL M addM smulM (fun x => addM (smulM scalar (f x)) (smulM mu (g x))).
Axiom god1_multilinear_mapping_maps_into : forall K , forall addK mulK : set -> set -> set , forall I , forall X : set -> set , forall addX smulX : set -> set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , multilinear_mapping K addK mulK I X addX smulX M addM smulM f -> forall x :e indexed_module_product I X , f x :e M.
Axiom god1_multilinear_mapping_slice_linear : forall K , forall addK mulK : set -> set -> set , forall I , forall X : set -> set , forall addX smulX : set -> set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , (forall i :e I , left_module K addK mulK (X i) (addX i) (smulX i)) -> left_module K addK mulK M addM smulM -> multilinear_mapping K addK mulK I X addX smulX M addM smulM f -> forall i :e I , forall x :e indexed_module_product I X , module_homomorphism K addK mulK (X i) (addX i) (smulX i) M addM smulM (fun u => f (indexed_function_update I x i u)).
Axiom god1_linear_combination_of_multilinear_mappings : forall K , forall addK mulK : set -> set -> set , forall I , forall X : set -> set , forall addX smulX : set -> set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall scalar mu :e K , forall f g : set -> set , commutative_ring K addK mulK -> (forall i :e I , left_module K addK mulK (X i) (addX i) (smulX i)) -> left_module K addK mulK M addM smulM -> multilinear_mapping K addK mulK I X addX smulX M addM smulM f -> multilinear_mapping K addK mulK I X addX smulX M addM smulM g -> multilinear_mapping K addK mulK I X addX smulX M addM smulM (fun z => addM (smulM scalar (f z)) (smulM mu (g z))).
Axiom god1_multilinear_mapping_pointwise_transfer : forall K , forall addK mulK : set -> set -> set , forall I , forall X : set -> set , forall addX smulX : set -> set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f g : set -> set , commutative_ring K addK mulK -> (forall i :e I , left_module K addK mulK (X i) (addX i) (smulX i)) -> left_module K addK mulK M addM smulM -> multilinear_mapping K addK mulK I X addX smulX M addM smulM f -> (forall z :e indexed_module_product I X , g z :e M) -> (forall z :e indexed_module_product I X , g z = f z) -> multilinear_mapping K addK mulK I X addX smulX M addM smulM g.
Axiom god1_zero_multilinear_mapping_raw : forall K , forall addK mulK : set -> set -> set , forall I , forall X : set -> set , forall addX smulX : set -> set -> set -> set , forall M , forall addM smulM : set -> set -> set , commutative_ring K addK mulK -> (forall i :e I , left_module K addK mulK (X i) (addX i) (smulX i)) -> left_module K addK mulK M addM smulM -> multilinear_mapping K addK mulK I X addX smulX M addM smulM (fun z => module_zero M addM).
Axiom god1_zero_multilinear_mapping : forall K , forall addK mulK : set -> set -> set , forall I , forall X : set -> set , forall addX smulX : set -> set -> set -> set , forall M , forall addM smulM : set -> set -> set , commutative_ring K addK mulK -> (forall i :e I , left_module K addK mulK (X i) (addX i) (smulX i)) -> left_module K addK mulK M addM smulM -> multilinear_mapping K addK mulK I X addX smulX M addM smulM (fun z => module_homomorphism_zero (indexed_module_product I X) M addM z).
Axiom god1_multilinear_mappings_form_module : forall K , forall addK mulK : set -> set -> set , forall I , forall X : set -> set , forall addX smulX : set -> set -> set -> set , forall M , forall addM smulM : set -> set -> set , commutative_ring K addK mulK -> (forall i :e I , left_module K addK mulK (X i) (addX i) (smulX i)) -> left_module K addK mulK M addM smulM -> left_module K addK mulK (multilinear_mapping_space K addK mulK I X addX smulX M addM smulM) (multilinear_mapping_addition (indexed_module_product I X) addM) (multilinear_mapping_scalar (indexed_module_product I X) smulM).
Axiom god1_ring_finite_product_extract_index : forall K , forall add mul : set -> set -> set , forall p :e omega , forall i :e p , forall f : set -> set , commutative_ring K add mul -> (forall h :e p , f h :e K) -> ring_finite_product K add mul p f = mul (ring_finite_product K add mul (p :\: {i}) f) (f i).
Axiom god1_ring_finite_product_congr_finite : forall K , forall add mul : set -> set -> set , forall X , finite X -> forall f g : set -> set , (forall x :e X , f x = g x) -> ring_finite_product K add mul X f = ring_finite_product K add mul X g.
Axiom god1_indexed_function_update_eval : forall I x i u , forall j :e I , indexed_function_update I x i u j = if j = i then u else x j.
Axiom god1_ring_finite_product_coordinate_update_factor : forall K , forall add mul : set -> set -> set , forall p :e omega , forall X : set -> set , forall addX smulX : set -> set -> set -> set , forall u : set -> set -> set , commutative_ring K add mul -> (forall h :e p , module_homomorphism K add mul (X h) (addX h) (smulX h) K add mul (u h)) -> forall x :e indexed_module_product p X , forall i :e p , forall w :e X i , ring_finite_product K add mul p (fun h => u h (indexed_function_update p x i w h)) = mul (ring_finite_product K add mul (p :\: {i}) (fun h => u h (x h))) (u i w).
Definition commutative_module_dual : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set := fun K addK mulK X addX smulX => module_homomorphism_space K addK mulK X addX smulX K addK mulK.
Definition tensor_argument_family : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set -> set := fun K addK mulK X addX smulX p q h => if h :e {Inj0 i|i :e p} then commutative_module_dual K addK mulK X addX smulX else X.
Definition tensor_argument_addition : set -> (set -> set -> set) -> set -> set -> set -> set -> set -> set := fun X addX p q h x y => if h :e {Inj0 i|i :e p} then module_homomorphism_addition X addX x y else addX x y.
Definition tensor_argument_scalar : set -> (set -> set -> set) -> set -> set -> set -> set -> set -> set := fun X smulX p q h scalar x => if h :e {Inj0 i|i :e p} then module_homomorphism_scalar X smulX scalar x else smulX scalar x.
Definition tensor_space : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set := fun K addK mulK X addX smulX p q => multilinear_mapping_space K addK mulK (p :+: q) (tensor_argument_family K addK mulK X addX smulX p q) (tensor_argument_addition X addX p q) (tensor_argument_scalar X smulX p q) K addK mulK.
Definition tensor_product_of_multilinear_forms : set -> (set -> set -> set) -> set -> set -> (set -> set) -> (set -> set) -> (set -> set) -> (set -> set) -> set := fun K mul I J X Y f g => fun z :e indexed_module_product (I :+: J) (fun h => if h :e {Inj0 i|i :e I} then X (Unj h) else Y (Unj h)) => mul (f (fun i :e I => z (Inj0 i))) (g (fun j :e J => z (Inj1 j))).
Axiom god1_s21_example2_product_of_linear_forms_is_multilinear : forall K , forall add mul : set -> set -> set , forall p :e omega , forall X : set -> set , forall addX smulX : set -> set -> set -> set , forall u : set -> set -> set , commutative_ring K add mul -> (forall h :e p , module_homomorphism K add mul (X h) (addX h) (smulX h) K add mul (u h)) -> multilinear_mapping K add mul p X addX smulX K add mul (fun x => ring_finite_product K add mul p (fun h => u h (x h))).
Axiom god1_binary_function_eq_sym : forall f g : set -> set -> set , f = g -> g = f.
Axiom god1_binary_function_predicate_eq_subst : forall P : (set -> set -> set) -> prop , forall f g : set -> set -> set , f = g -> P f -> P g.
Axiom god1_sets_sum_module_family : forall K , forall add mul : set -> set -> set , forall I J , forall X Y : set -> set , forall addX smulX addY smulY : set -> set -> set -> set , (forall i :e I , left_module K add mul (X i) (addX i) (smulX i)) -> (forall j :e J , left_module K add mul (Y j) (addY j) (smulY j)) -> forall q :e I :+: J , left_module K add mul (if q :e {Inj0 i|i :e I} then X (Unj q) else Y (Unj q)) (fun a : set => fun b : set => if q :e {Inj0 i|i :e I} then addX (Unj q) a b else addY (Unj q) a b) (fun scalar : set => fun a : set => if q :e {Inj0 i|i :e I} then smulX (Unj q) scalar a else smulY (Unj q) scalar a).
Definition god1_sets_sum_left_restriction : set -> set -> set := fun I z => fun i :e I => z (Inj0 i).
