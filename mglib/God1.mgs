Axiom god1_inverse_selected_free_response : forall K , forall add mul : set -> set -> set , forall n p :e omega , forall A :e matrix_space K n p , forall cols :e p :^: n , division_ring K add mul -> inj n p (fun i => cols i) -> invertible_matrix K add mul n (matrix_submatrix n n (fun i => i) (fun j => cols j) A) -> forall eta :e K :^: p , forall i :e n , matrix_vector_product K add mul n n (matrix_inverse K add mul n (matrix_submatrix n n (fun h => h) (fun h => cols h) A)) (fun j :e n => module_finitely_supported_sum K add {k :e p|k /:e {cols h|h :e n}} (fun k => mul (matrix_entry A j k) (eta k))) i = module_finitely_supported_sum K add {k :e p|k /:e {cols h|h :e n}} (fun k => mul (matrix_entry (matrix_multiplication K add mul n n p (matrix_inverse K add mul n (matrix_submatrix n n (fun h => h) (fun h => cols h) A)) A) i k) (eta k)).
