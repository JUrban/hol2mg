Axiom ms_equicontinuous_on_imp_eps_delta_each : forall X , forall dX : set -> set -> set , forall Y , forall dY : set -> set -> set , forall K , forall fn : set -> set , ms_equicontinuous_on X dX Y dY K fn -> forall n :e omega , forall eps :e R , 0 < eps -> exists delta :e R , 0 < delta /\ forall x :e K , forall y :e K , dX x y < delta -> dY ((fn n) x) ((fn n) y) < eps.
Axiom ms_equicontinuous_on_imp_ms_continuous_on_each : forall X , forall dX : set -> set -> set , forall Y , forall dY : set -> set -> set , forall K , forall fn : set -> set , ms_equicontinuous_on X dX Y dY K fn -> forall n :e omega , ms_continuous_on (fun x : set => (fn n) x) K dX Y dY K.
Axiom ms_equicontinuous_on_imp_ms_uniformly_continuous_on_each : forall X , forall dX : set -> set -> set , forall Y , forall dY : set -> set -> set , forall K , forall fn : set -> set , ms_equicontinuous_on X dX Y dY K fn -> forall n :e omega , ms_uniformly_continuous_on (fun x : set => (fn n) x) K dX Y dY K.
Axiom ms_equicontinuous_on_restrict : forall X , forall dX : set -> set -> set , forall Y , forall dY : set -> set -> set , forall K , forall K' , forall fn : set -> set , K' c= K -> ms_equicontinuous_on X dX Y dY K fn -> ms_equicontinuous_on X dX Y dY K' fn.
Definition ms_pointwise_converges_to : set -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> (set -> set) -> set -> prop := fun X dX Y dY K fn f => K c= X /\ (forall n :e omega , fn n :e setexp Y X) /\ f :e setexp Y X /\ forall x :e K , ms_seq_limit Y dY (fun n : set => (fn n) x) (f x).
