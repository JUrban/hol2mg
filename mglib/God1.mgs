Definition god1_dependent_natural_sigma_block_enumeration : set -> (set -> set) -> set := fun m ell => Eps_i (fun phi => bij (natural_indexed_sum m ell) (Sigma_ j :e m , ell j) (fun x : set => phi x) /\ forall j :e m , forall k :e ell j , add_nat (natural_indexed_sum j ell) k :e natural_indexed_sum m ell /\ phi (add_nat (natural_indexed_sum j ell) k) = (j,k)).
Axiom god1_dependent_natural_sigma_block_enumeration_specification : forall m :e omega , forall ell : set -> set , (forall j :e m , ell j :e omega) -> bij (natural_indexed_sum m ell) (Sigma_ j :e m , ell j) (fun x => god1_dependent_natural_sigma_block_enumeration m ell x) /\ forall j :e m , forall k :e ell j , add_nat (natural_indexed_sum j ell) k :e natural_indexed_sum m ell /\ god1_dependent_natural_sigma_block_enumeration m ell (add_nat (natural_indexed_sum j ell) k) = (j,k).
Definition god1_primary_global_block_size : set -> (set -> set) -> (set -> set -> set) -> set -> set := fun q blocks sizes t => sizes ((god1_dependent_natural_sigma_block_enumeration q blocks t) 0) ((god1_dependent_natural_sigma_block_enumeration q blocks t) 1).
Definition god1_primary_global_block_root : set -> (set -> set) -> (set -> set) -> set -> set := fun q blocks roots t => roots ((god1_dependent_natural_sigma_block_enumeration q blocks t) 0).
Definition god1_primary_reassociated_vector_to_component_index : (set -> set) -> (set -> set) -> (set -> set -> set) -> set -> set := fun dimensions blocks sizes w => (w 0,inv (dimensions (w 0)) (fun x : set => god1_dependent_natural_sigma_block_enumeration (blocks (w 0)) (sizes (w 0)) x) (w 1)).
