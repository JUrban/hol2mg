Definition polynomial_root_set : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set := fun K add mul f => {a :e K|polynomial_zero K add mul K add mul 1 f (fun i => a)}.
Axiom god1_s28_lemma2_root_bound : forall K , forall add mul : set -> set -> set , forall f :e multivariate_polynomial_ring K add 1 , forall d :e omega , integral_domain K add mul -> polynomial_total_degree K add 1 f = d -> finite (polynomial_root_set K add mul f) /\ finite_cardinality (polynomial_root_set K add mul f) c= d.
Definition fraction_pairs : set -> (set -> set -> set) -> set := fun K add => K :*: (K :\: {ring_zero K add}).
Definition equivalent_fraction_pairs : set -> (set -> set -> set) -> set -> set -> prop := fun K mul p q => mul (p 0) (q 1) = mul (p 1) (q 0).
Definition fraction_class : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set := fun K add mul p => {q :e fraction_pairs K add|equivalent_fraction_pairs K mul p q}.
Definition fraction_field : set -> (set -> set -> set) -> (set -> set -> set) -> set := fun K add mul => {fraction_class K add mul p|p :e fraction_pairs K add}.
Definition fraction_representative : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set := fun K add mul x => Eps_i (fun p => p :e fraction_pairs K add /\ x = fraction_class K add mul p).
Definition fraction_addition : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set := fun K add mul x y => let p := fraction_representative K add mul x in let q := fraction_representative K add mul y in fraction_class K add mul (add (mul (p 0) (q 1)) (mul (p 1) (q 0)),mul (p 1) (q 1)).
Definition fraction_multiplication : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set := fun K add mul x y => let p := fraction_representative K add mul x in let q := fraction_representative K add mul y in fraction_class K add mul (mul (p 0) (q 0),mul (p 1) (q 1)).
Definition fraction_embedding : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set := fun K add mul a => fraction_class K add mul (a,ring_one K mul).
Axiom god1_fraction_pair_numerator_in : forall K , forall add : set -> set -> set , forall p :e fraction_pairs K add , p 0 :e K.
Axiom god1_fraction_pair_denominator_in : forall K , forall add : set -> set -> set , forall p :e fraction_pairs K add , p 1 :e K.
Axiom god1_fraction_pair_denominator_nonzero : forall K , forall add : set -> set -> set , forall p :e fraction_pairs K add , p 1 <> ring_zero K add.
Axiom god1_fraction_pair_intro : forall K , forall add : set -> set -> set , forall a :e K , forall b :e K , b <> ring_zero K add -> (a,b) :e fraction_pairs K add.
Axiom god1_fraction_denominator_product_nonzero : forall K , forall add mul : set -> set -> set , integral_domain K add mul -> forall p q :e fraction_pairs K add , mul (p 1) (q 1) <> ring_zero K add.
Axiom god1_fraction_pair_equivalence_relation : forall K , forall add mul : set -> set -> set , integral_domain K add mul -> god1_s4_equivalence_relation (fraction_pairs K add) (equivalent_fraction_pairs K mul).
Axiom god1_fraction_member_has_representative : forall K , forall add mul : set -> set -> set , forall x :e fraction_field K add mul , exists p :e fraction_pairs K add , x = fraction_class K add mul p.
Axiom god1_fraction_representative_specification : forall K , forall add mul : set -> set -> set , forall x :e fraction_field K add mul , fraction_representative K add mul x :e fraction_pairs K add /\ x = fraction_class K add mul (fraction_representative K add mul x).
Axiom god1_fraction_operations_closed : forall K , forall add mul : set -> set -> set , integral_domain K add mul -> forall x y :e fraction_field K add mul , fraction_addition K add mul x y :e fraction_field K add mul /\ fraction_multiplication K add mul x y :e fraction_field K add mul.
Axiom god1_equivalent_fraction_pair_tuples_iff : forall K , forall mul : set -> set -> set , forall a b c d , (equivalent_fraction_pairs K mul (a,b) (c,d) <-> mul a d = mul b c).
Axiom god1_fraction_classes_equal_iff_equivalent : forall K , forall add mul : set -> set -> set , integral_domain K add mul -> forall p q :e fraction_pairs K add , (fraction_class K add mul p = fraction_class K add mul q <-> equivalent_fraction_pairs K mul p q).
