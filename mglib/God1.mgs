Definition cyclic_subgroup : set -> (set -> set -> set) -> set -> set := fun G mul x => {group_int_power G mul x n|n :e int}.
Axiom god1_powers_form_cyclic_subgroup : forall G , forall mul : set -> set -> set , forall x :e G , group G mul -> subgroup G mul (cyclic_subgroup G mul x).
Definition cyclic_group : set -> (set -> set -> set) -> prop := fun G mul => group G mul /\ exists x :e G , forall y :e G , exists n :e int , y = group_int_power G mul x n.
Definition group_family_intersection : set -> (set -> set) -> set -> set := fun I H G => {x :e G|forall i :e I , x :e H i}.
Definition group_family_union : set -> (set -> set) -> set := fun I H => \/_ i :e I , H i.
Axiom god1_group_family_intersection_identity_components : forall G , forall mul : set -> set -> set , forall I , forall H : set -> set , (forall i :e I , subgroup G mul (H i)) -> forall i :e I , group_identity G mul :e H i.
Axiom god1_group_family_intersection_product_components : forall G , forall mul : set -> set -> set , forall I , forall H : set -> set , (forall i :e I , subgroup G mul (H i)) -> forall x y :e group_family_intersection I H G , forall i :e I , mul x y :e H i.
Axiom god1_group_family_intersection_inverse_components : forall G , forall mul : set -> set -> set , forall I , forall H : set -> set , (forall i :e I , subgroup G mul (H i)) -> forall x :e group_family_intersection I H G , forall i :e I , group_inverse G mul x :e H i.
Axiom god1_group_family_intersection_is_subgroup : forall G , forall mul : set -> set -> set , forall I , forall H : set -> set , group G mul -> (forall i :e I , subgroup G mul (H i)) -> subgroup G mul (group_family_intersection I H G).
Axiom god1_directed_group_family_union_is_subgroup : forall G , forall mul : set -> set -> set , forall I , forall H : set -> set , group G mul -> (forall i :e I , subgroup G mul (H i)) -> (exists i , i :e I) -> (forall i j :e I , exists k :e I , H i c= H k /\ H j c= H k) -> subgroup G mul (group_family_union I H).
Axiom god1_s7_theorem1_intersection_and_directed_union_subgroups : forall G , forall mul : set -> set -> set , forall I , forall H : set -> set , group G mul -> (forall i :e I , subgroup G mul (H i)) -> subgroup G mul (group_family_intersection I H G) /\ (((exists i , i :e I) /\ (forall i j :e I , exists k :e I , H i c= H k /\ H j c= H k)) -> subgroup G mul (group_family_union I H)).
Definition subgroup_generated_by : set -> (set -> set -> set) -> set -> set := fun G mul B => {x :e G|forall H :e Power G , subgroup G mul H -> B c= H -> x :e H}.
Axiom god1_generated_subgroup_identity_property : forall G , forall mul : set -> set -> set , forall B , forall H :e Power G , subgroup G mul H -> B c= H -> group_identity G mul :e H.
Axiom god1_generated_subgroup_product_property : forall G , forall mul : set -> set -> set , forall B , forall x y :e subgroup_generated_by G mul B , forall H :e Power G , subgroup G mul H -> B c= H -> mul x y :e H.
Axiom god1_generated_subgroup_inverse_property : forall G , forall mul : set -> set -> set , forall B , forall x :e subgroup_generated_by G mul B , forall H :e Power G , subgroup G mul H -> B c= H -> group_inverse G mul x :e H.
Axiom god1_generators_satisfy_generated_subgroup_property : forall G , forall mul : set -> set -> set , forall B , forall b :e B , forall H :e Power G , subgroup G mul H -> B c= H -> b :e H.
Axiom god1_generated_subgroup_is_smallest : forall G , forall mul : set -> set -> set , forall B , group G mul -> B c= G -> subgroup G mul (subgroup_generated_by G mul B) /\ B c= subgroup_generated_by G mul B /\ (forall H :e Power G , subgroup G mul H -> B c= H -> subgroup_generated_by G mul B c= H).
Definition group_word_product : set -> (set -> set -> set) -> (set -> set) -> set -> set := fun G mul f p => nat_primrec (group_identity G mul) (fun i r => mul r (f i)) p.
Definition group_word_letter : set -> (set -> set -> set) -> set -> set -> prop := fun G mul B a => a :e G /\ (a :e B \/ group_inverse G mul a :e B).
Definition group_word_represented : set -> (set -> set -> set) -> set -> set -> prop := fun G mul B z => exists p :e omega , exists f : set -> set , (forall i :e p , group_word_letter G mul B (f i)) /\ z = group_word_product G mul f p.
Definition group_words : set -> (set -> set -> set) -> set -> set := fun G mul B => {z :e G|group_word_represented G mul B z}.
Axiom god1_group_word_product_zero : forall G , forall mul : set -> set -> set , forall f : set -> set , group_word_product G mul f 0 = group_identity G mul.
Axiom god1_group_word_product_successor : forall G , forall mul : set -> set -> set , forall f : set -> set , forall n , nat_p n -> group_word_product G mul f (ordsucc n) = mul (group_word_product G mul f n) (f n).
