Definition determinant_3 : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set := fun K add mul A => add (add (mul (matrix_entry A 0 0) (mul (matrix_entry A 1 1) (matrix_entry A 2 2))) (mul (matrix_entry A 1 0) (mul (matrix_entry A 2 1) (matrix_entry A 0 2)))) (add (mul (matrix_entry A 2 0) (mul (matrix_entry A 0 1) (matrix_entry A 1 2))) (add (ring_negation K add (mul (matrix_entry A 0 0) (mul (matrix_entry A 2 1) (matrix_entry A 1 2)))) (add (ring_negation K add (mul (matrix_entry A 1 0) (mul (matrix_entry A 0 1) (matrix_entry A 2 2)))) (ring_negation K add (mul (matrix_entry A 2 0) (mul (matrix_entry A 1 1) (matrix_entry A 0 2))))))).
