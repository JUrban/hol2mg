Definition ms_uniformly_converges_to : set -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> (set -> set) -> set -> prop := fun X dX Y dY K fn f => K c= X /\ ((forall n :e omega , fn n :e setexp Y X) /\ f :e setexp Y X /\ forall eps :e R , 0 < eps -> exists N :e omega , forall n :e omega , N <= n -> forall x :e K , dY ((fn n) x) (f x) < eps).
