Definition fimage : (set -> set) -> set -> set := fun f D => {f x|x :e D}.
Definition R_fun : set -> (set -> set) -> prop := fun D f => forall x :e D , f x :e R.
Definition bounded_fun : set -> (set -> set) -> prop := fun D f => R_fun D f /\ exists M :e R , forall x :e D , abs_SNo (f x) <= M.
Axiom fimage_subq_R : forall D , forall f : set -> set , R_fun D f -> fimage f D c= R.
Axiom bounded_above_fimage_of_bounded_fun : forall D , forall f : set -> set , bounded_fun D f -> nonempty D -> bounded_above (fimage f D).
Axiom bounded_below_fimage_of_bounded_fun : forall D , forall f : set -> set , bounded_fun D f -> nonempty D -> bounded_below (fimage f D).
Definition sup_on : (set -> set) -> set -> set := fun f D => sup (fimage f D).
Definition inf_on : (set -> set) -> set -> set := fun f D => inf (fimage f D).
Axiom sup_on_spec : forall D , forall f : set -> set , nonempty D -> bounded_fun D f -> sup_on f D :e R /\ is_lub (fimage f D) (sup_on f D).
Axiom inf_on_spec : forall D , forall f : set -> set , nonempty D -> bounded_fun D f -> inf_on f D :e R /\ is_glb (fimage f D) (inf_on f D).
Axiom sup_on_Le_of_pointwise_Le : forall D , forall f g : set -> set , nonempty D -> bounded_fun D f -> bounded_fun D g -> (forall x :e D , f x <= g x) -> sup_on f D <= sup_on g D.
Axiom inf_on_Le_of_pointwise_Le : forall D , forall f g : set -> set , nonempty D -> bounded_fun D f -> bounded_fun D g -> (forall x :e D , f x <= g x) -> inf_on f D <= inf_on g D.
End form34.
Section form35.
Definition Icc : set -> set -> set := fun a b => {x :e R|a <= x /\ x <= b}.
Definition Ioo : set -> set -> set := fun a b => {x :e R|a < x /\ x < b}.
Definition Ioc : set -> set -> set := fun a b => {x :e R|a < x /\ x <= b}.
Definition Ico : set -> set -> set := fun a b => {x :e R|a <= x /\ x < b}.
Definition Ici : set -> set := fun a => {x :e R|a <= x}.
Definition Ioi : set -> set := fun a => {x :e R|a < x}.
Definition Iic : set -> set := fun b => {x :e R|x <= b}.
Definition Iio : set -> set := fun b => {x :e R|x < b}.
Axiom Icc_subq_R : forall a b , Icc a b c= R.
Axiom Ioo_subq_R : forall a b , Ioo a b c= R.
Axiom Ioc_subq_R : forall a b , Ioc a b c= R.
Axiom Ico_subq_R : forall a b , Ico a b c= R.
Axiom Ici_subq_R : forall a , Ici a c= R.
Axiom Ioi_subq_R : forall a , Ioi a c= R.
Axiom Iic_subq_R : forall b , Iic b c= R.
Axiom Iio_subq_R : forall b , Iio b c= R.
End form35.
Section form36.
Definition digit_p : set -> prop := fun d => d :e 10.
Definition digit_seq : (set -> set) -> prop := fun d => forall n :e omega , digit_p (d n).
Definition decimal_val : (set -> set) -> set := fun d => 0.
Axiom decimal_val_spec : forall d : set -> set , digit_seq d -> decimal_val d :e Icc 0 1.
End form36.
Section form37.
Definition dist_R : set -> set -> set := fun x y => abs_SNo (x + (- y)).
Axiom dist_R_sym : forall x y :e R , dist_R x y = dist_R y x.
Axiom dist_R_triangle : forall x y z :e R , dist_R x z <= dist_R x y + dist_R y z.
Axiom dist_R_add_right : forall x y z :e R , dist_R (x + z) (y + z) = dist_R x y.
Axiom dist_R_neg : forall x y :e R , dist_R (- x) (- y) = dist_R x y.
Definition R_seq : (set -> set) -> prop := fun x => forall n :e omega , x n :e R.
Axiom eps_n_in_R : forall n :e omega , eps_ n :e R.
Axiom eps_n_SNo : forall n :e omega , SNo (eps_ n).
Definition eventually_omega : (set -> prop) -> prop := fun P => exists N :e omega , forall n :e omega , N <= n -> P n.
Definition seq_limit : (set -> set) -> set -> prop := fun x l => R_seq x /\ l :e R /\ forall eps :e R , 0 < eps -> exists N :e omega , forall n :e omega , N <= n -> dist_R (x n) l < eps.
Axiom seq_limit_choose : forall x y : set -> set , forall l , seq_limit x l -> seq_limit y l -> forall p : set -> prop , seq_limit (fun n => if p n then x n else y n) l.
Axiom seq_limit_eq_subst : forall x : set -> set , forall l1 l2 , seq_limit x l1 -> l1 = l2 -> seq_limit x l2.
Definition convergent_seq : (set -> set) -> prop := fun x => exists l :e R , seq_limit x l.
Definition lim_seq : (set -> set) -> set := fun x => Eps_i (fun l => seq_limit x l).
Axiom lim_seq_spec : forall x : set -> set , convergent_seq x -> seq_limit x (lim_seq x).
Axiom seq_limit_unique : forall x : set -> set , forall l1 l2 , seq_limit x l1 -> seq_limit x l2 -> l1 = l2.
Definition bounded_seq : (set -> set) -> prop := fun x => exists B :e R , forall n :e omega , abs_SNo (x n) <= B.
Axiom seq_limit_imp_bounded : forall x : set -> set , forall l , seq_limit x l -> bounded_seq x.
Definition const_seq : set -> (set -> set) := fun c => fun n => c.
Axiom seq_limit_const : forall c :e R , seq_limit (const_seq c) c.
Definition seq_add : (set -> set) -> (set -> set) -> (set -> set) := fun x y => fun n => x n + y n.
Definition seq_mul : (set -> set) -> (set -> set) -> (set -> set) := fun x y => fun n => x n * y n.
Definition seq_neg : (set -> set) -> (set -> set) := fun x => fun n => - (x n).
Definition seq_sub : (set -> set) -> (set -> set) -> (set -> set) := fun x y => fun n => x n + (- (y n)).
Definition seq_scale : set -> (set -> set) -> (set -> set) := fun a x => fun n => a * (x n).
Axiom seq_limit_add : forall x y : set -> set , forall a b , seq_limit x a -> seq_limit y b -> seq_limit (seq_add x y) (a + b).
Axiom seq_limit_neg : forall x : set -> set , forall a , seq_limit x a -> seq_limit (seq_neg x) (- a).
Axiom seq_limit_sub : forall x y : set -> set , forall a b , seq_limit x a -> seq_limit y b -> seq_limit (seq_sub x y) (a + (- b)).
Axiom seq_limit_scale : forall a , forall x : set -> set , forall l , a :e R -> seq_limit x l -> seq_limit (seq_scale a x) (a * l).
Axiom seq_limit_mul : forall x y : set -> set , forall a b , seq_limit x a -> seq_limit y b -> seq_limit (seq_mul x y) (a * b).
Axiom seq_limit_recip : forall x : set -> set , forall l , seq_limit x l -> l <> 0 -> (forall n :e omega , x n <> 0) -> seq_limit (fun n => recip_SNo (x n)) (recip_SNo l).
Definition eventually_le : (set -> set) -> (set -> set) -> prop := fun x y => eventually_omega (fun n => x n <= y n).
Definition monotone_inc : (set -> set) -> prop := fun x => forall m :e omega , forall n :e omega , m <= n -> x m <= x n.
Definition monotone_dec : (set -> set) -> prop := fun x => forall m :e omega , forall n :e omega , m <= n -> x n <= x m.
Axiom monotone_inc_bounded_limit_sup : forall x : set -> set , R_seq x -> bounded_seq x -> monotone_inc x -> seq_limit x (sup (fimage x omega)).
Axiom monotone_dec_bounded_convergent : forall x : set -> set , R_seq x -> bounded_seq x -> monotone_dec x -> convergent_seq x.
End form37.
Section form38.
Definition between_seq : (set -> set) -> (set -> set) -> (set -> set) -> prop := fun a x b => R_seq a /\ R_seq x /\ R_seq b /\ forall n :e omega , a n <= x n /\ x n <= b n.
Axiom SNoLe_eq_substL38 : forall x y z , SNo x -> SNo y -> SNo z -> x = y -> x <= z -> y <= z.
Axiom SNoLe_eq_substR38 : forall x y z , SNo x -> SNo y -> SNo z -> x = y -> z <= x -> z <= y.
Axiom dist_R_lt_imp_bounds : forall u v eps :e R , dist_R u v < eps -> v + (- eps) <= u /\ u <= v + eps.
Axiom bounds_imp_dist_R_Le : forall u v eps :e R , v + (- eps) <= u -> u <= v + eps -> dist_R u v <= eps.
Axiom squeeze_lemma : forall a b x : set -> set , forall l , between_seq a x b -> seq_limit a l -> seq_limit b l -> seq_limit x l.
End form38.
Section form39.
Definition subseq_fun : (set -> set) -> prop := fun f => (forall n :e omega , f n :e omega) /\ (forall n :e omega , n <= f n) /\ (forall n :e omega , f n < f (ordsucc n)).
Definition subseq_of : (set -> set) -> (set -> set) -> prop := fun x y => exists f : set -> set , subseq_fun f /\ forall n :e omega , y n = x (f n).
Axiom seq_limit_subseq : forall x y : set -> set , forall l , subseq_of x y -> seq_limit x l -> seq_limit y l.
Axiom omega_lt_ordsucc : forall n :e omega , n < ordsucc n.
Axiom ordsucc_subseq_fun : subseq_fun (fun n => ordsucc n).
End form39.
Section form40.
Definition tail_set : (set -> set) -> set -> set := fun x n => {x k|k :e omega,n <= k}.
Definition sup_tail_seq : (set -> set) -> (set -> set) := fun x => fun n => sup (tail_set x n).
Definition inf_tail_seq : (set -> set) -> (set -> set) := fun x => fun n => inf (tail_set x n).
Definition limsup_seq : (set -> set) -> set := fun x => lim_seq (sup_tail_seq x).
Definition liminf_seq : (set -> set) -> set := fun x => lim_seq (inf_tail_seq x).
Axiom tail_set_sub : forall x : set -> set , forall m n :e omega , m <= n -> tail_set x n c= tail_set x m.
Axiom tail_set_subq_R : forall x : set -> set , R_seq x -> forall n :e omega , tail_set x n c= R.
Axiom tail_set_nonempty : forall x : set -> set , forall n :e omega , nonempty (tail_set x n).
Axiom tail_set_bounded_above : forall x : set -> set , R_seq x -> bounded_seq x -> forall n :e omega , bounded_above (tail_set x n).
Axiom tail_set_has_lub : forall x : set -> set , R_seq x -> bounded_seq x -> forall n :e omega , has_lub (tail_set x n).
Axiom tail_set_bounded_below : forall x : set -> set , R_seq x -> bounded_seq x -> forall n :e omega , bounded_below (tail_set x n).
Axiom tail_set_has_glb : forall x : set -> set , R_seq x -> bounded_seq x -> forall n :e omega , has_glb (tail_set x n).
Axiom sup_tail_seq_R_seq : forall x : set -> set , R_seq x -> bounded_seq x -> R_seq (sup_tail_seq x).
Axiom inf_tail_seq_R_seq : forall x : set -> set , R_seq x -> bounded_seq x -> R_seq (inf_tail_seq x).
Axiom sup_tail_seq_monotone_dec : forall x : set -> set , R_seq x -> bounded_seq x -> monotone_dec (sup_tail_seq x).
Axiom inf_tail_seq_monotone_inc : forall x : set -> set , R_seq x -> bounded_seq x -> monotone_inc (inf_tail_seq x).
Axiom sup_tail_seq_bounded_seq : forall x : set -> set , R_seq x -> bounded_seq x -> bounded_seq (sup_tail_seq x).
Axiom inf_tail_seq_bounded_seq : forall x : set -> set , R_seq x -> bounded_seq x -> bounded_seq (inf_tail_seq x).
Axiom sup_tail_seq_convergent : forall x : set -> set , R_seq x -> bounded_seq x -> convergent_seq (sup_tail_seq x).
Axiom inf_tail_seq_convergent : forall x : set -> set , R_seq x -> bounded_seq x -> convergent_seq (inf_tail_seq x).
Axiom limsup_seq_spec : forall x : set -> set , R_seq x -> bounded_seq x -> seq_limit (sup_tail_seq x) (limsup_seq x).
Axiom liminf_seq_spec : forall x : set -> set , R_seq x -> bounded_seq x -> seq_limit (inf_tail_seq x) (liminf_seq x).
Axiom liminf_le_limsup : forall x : set -> set , R_seq x -> bounded_seq x -> liminf_seq x <= limsup_seq x.
Axiom liminfsup_eq_imp_limit : forall x : set -> set , R_seq x -> bounded_seq x -> liminf_seq x = limsup_seq x -> seq_limit x (limsup_seq x).
Axiom limsup_seq_eq_of_seq_limit : forall x : set -> set , forall l , seq_limit x l -> limsup_seq x = l.
Axiom liminf_seq_eq_of_seq_limit : forall x : set -> set , forall l , seq_limit x l -> liminf_seq x = l.
Axiom liminfsup_eq_of_seq_limit : forall x : set -> set , forall l , seq_limit x l -> liminf_seq x = limsup_seq x.
Axiom exists_eps_n_lt : forall eps :e R , 0 < eps -> exists n :e omega , eps_ n < eps.
Axiom eps_decr_Le : forall m n :e omega , m <= n -> eps_ n <= eps_ m.
Axiom eps_seq_limit_0 : seq_limit (fun n => eps_ n) 0.
Axiom exists_k_tail_sup_close : forall x : set -> set , R_seq x -> bounded_seq x -> forall n :e omega , forall eps :e R , 0 < eps -> exists k :e omega , n <= k /\ (sup_tail_seq x n) + (- eps) < x k /\ x k <= sup_tail_seq x n.
Axiom exists_k_tail_inf_close : forall x : set -> set , R_seq x -> bounded_seq x -> forall n :e omega , forall eps :e R , 0 < eps -> exists k :e omega , n <= k /\ inf_tail_seq x n <= x k /\ x k < (inf_tail_seq x n) + eps.
Axiom subseq_limsup_seq : forall x : set -> set , R_seq x -> bounded_seq x -> exists y : set -> set , subseq_of x y /\ seq_limit y (limsup_seq x).
Axiom subseq_liminf_seq : forall x : set -> set , R_seq x -> bounded_seq x -> exists y : set -> set , subseq_of x y /\ seq_limit y (liminf_seq x).
Axiom liminfsupconv : forall x : set -> set , R_seq x -> bounded_seq x -> (convergent_seq x <-> liminf_seq x = limsup_seq x).
End form40.
Section form41.
Axiom R_seq_subseq_of : forall x y : set -> set , subseq_of x y -> R_seq x -> R_seq y.
Axiom bounded_seq_subseq_of : forall x y : set -> set , subseq_of x y -> bounded_seq x -> bounded_seq y.
Axiom tail_set_subseq_sub : forall x y : set -> set , subseq_of x y -> forall n :e omega , tail_set y n c= tail_set x n.
Axiom limsup_seq_subseq_le : forall x y : set -> set , R_seq x -> bounded_seq x -> subseq_of x y -> limsup_seq y <= limsup_seq x.
Axiom liminf_seq_subseq_ge : forall x y : set -> set , R_seq x -> bounded_seq x -> subseq_of x y -> liminf_seq x <= liminf_seq y.
Axiom subseq_liminf_limsup_chain : forall x y : set -> set , R_seq x -> bounded_seq x -> subseq_of x y -> liminf_seq x <= liminf_seq y /\ liminf_seq y <= limsup_seq y /\ limsup_seq y <= limsup_seq x.
Axiom bolzano_weierstrass_seq : forall x : set -> set , R_seq x -> bounded_seq x -> exists y : set -> set , subseq_of x y /\ convergent_seq y.
End form41.
Section form42.
Definition cauchy_seq : (set -> set) -> prop := fun x => R_seq x /\ forall eps :e R , 0 < eps -> exists N :e omega , forall m n :e omega , N <= m -> N <= n -> dist_R (x m) (x n) < eps.
Axiom cauchy_seq_subseq_of : forall x y : set -> set , cauchy_seq x -> subseq_of x y -> cauchy_seq y.
Axiom mem_singleton : forall x : set , x :e {x}.
Axiom mem_singleton_eq : forall x y : set , y :e {x} -> y = x.
Axiom finite_abs_bounded : forall x : set -> set , R_seq x -> forall X , X c= omega -> finite X -> exists B :e R , 0 <= B /\ forall n :e X , abs_SNo (x n) <= B.
Axiom seq_limit_imp_cauchy : forall x : set -> set , forall l , seq_limit x l -> cauchy_seq x.
Axiom cauchy_seq_imp_bounded : forall x : set -> set , cauchy_seq x -> bounded_seq x.
Axiom cauchy_subseq_limit_imp_limit : forall x y : set -> set , forall l , cauchy_seq x -> subseq_of x y -> seq_limit y l -> seq_limit x l.
Axiom convergent_seq_iff_cauchy_seq : forall x : set -> set , convergent_seq x <-> cauchy_seq x.
Axiom cauchy_seq_imp_convergent : forall x : set -> set , cauchy_seq x -> convergent_seq x.
End form42.
Section form43.
Definition partial_sum_seq : (set -> set) -> (set -> set) := fun x => fun n => nat_primrec 0 (fun i r => r + x i) n.
Definition convergent_series : (set -> set) -> prop := fun x => convergent_seq (partial_sum_seq x).
Definition cauchy_series : (set -> set) -> prop := fun x => cauchy_seq (partial_sum_seq x).
Definition sum_series : (set -> set) -> set := fun x => lim_seq (partial_sum_seq x).
Axiom convergent_series_iff_cauchy_series : forall x : set -> set , convergent_series x <-> cauchy_series x.
Axiom cauchy_series_imp_convergent_series : forall x : set -> set , cauchy_series x -> convergent_series x.
Axiom cauchy_series_imp_bounded_partial_sums : forall x : set -> set , cauchy_series x -> bounded_seq (partial_sum_seq x).
Axiom partial_sum_seq_0 : forall x : set -> set , partial_sum_seq x 0 = 0.
Axiom partial_sum_seq_S : forall x : set -> set , forall n :e omega , partial_sum_seq x (ordsucc n) = partial_sum_seq x n + x n.
Axiom partial_sum_seq_eq_of_eq_on : forall x y : set -> set , forall n :e omega , (forall k :e n , x k = y k) -> partial_sum_seq x n = partial_sum_seq y n.
Axiom partial_sum_seq_closed_of_R_on : forall x : set -> set , forall n :e omega , (forall k :e n , x k :e R) -> partial_sum_seq x n :e R.
Axiom partial_sum_seq_Le_of_term_Le_on : forall x y : set -> set , forall n :e omega , (forall k :e n , x k :e R) -> (forall k :e n , y k :e R) -> (forall k :e n , x k <= y k) -> partial_sum_seq x n <= partial_sum_seq y n.
Axiom partial_sum_seq_closed : forall x : set -> set , R_seq x -> forall n :e omega , partial_sum_seq x n :e R.
Axiom partial_sum_seq_R_seq : forall x : set -> set , R_seq x -> R_seq (partial_sum_seq x).
Axiom omega_SNoLe_Subq : forall m n :e omega , m <= n -> m c= n.
Axiom seq_limit_tail_imp_limit : forall x : set -> set , R_seq x -> forall M :e omega , forall l , seq_limit (fun n => x (add_nat M n)) l -> seq_limit x l.
Axiom convergent_series_imp_cauchy_series : forall x : set -> set , convergent_series x -> cauchy_series x.
Axiom convergent_series_imp_term_limit_0 : forall x : set -> set , R_seq x -> convergent_series x -> seq_limit x 0.
Axiom cauchy_series_imp_term_limit_0 : forall x : set -> set , R_seq x -> cauchy_series x -> seq_limit x 0.
Axiom convergent_series_imp_bounded_partial_sums : forall x : set -> set , convergent_series x -> bounded_seq (partial_sum_seq x).
Definition tail_series : (set -> set) -> set -> (set -> set) := fun x M => fun n => x (add_nat M n).
Axiom partial_sum_seq_tail_series_eq : forall x : set -> set , R_seq x -> forall M :e omega , forall n :e omega , partial_sum_seq (tail_series x M) n = partial_sum_seq x (add_nat M n) + (- (partial_sum_seq x M)).
Axiom seq_limit_abs : forall x : set -> set , forall a , seq_limit x a -> seq_limit (fun n => abs_SNo (x n)) (abs_SNo a).
Axiom Ioo_nonempty : forall a b :e R , a < b -> nonempty (Ioo a b).
Axiom Icc_nonempty : forall a b :e R , a <= b -> nonempty (Icc a b).
Axiom nonempty_fimage : forall D , forall f : set -> set , nonempty D -> nonempty (fimage f D).
Axiom exists_x_eps_from_inf : forall S , S c= R -> nonempty S -> has_glb S -> forall eps :e R , 0 < eps -> exists x :e S , inf S <= x /\ x < inf S + eps.
Axiom bounded_fun_of_pointwise_eq : forall D , forall f g : set -> set , bounded_fun D f -> (forall x :e D , f x = g x) -> bounded_fun D g.
Axiom partial_sum_seq_add_nat_split : forall x : set -> set , R_seq x -> forall M :e omega , forall n :e omega , partial_sum_seq x (add_nat M n) = partial_sum_seq x M + partial_sum_seq (tail_series x M) n.
Axiom partial_sum_seq_add_nat_split_prefix : forall x : set -> set , forall M n :e omega , (forall k :e add_nat M n , x k :e R) -> partial_sum_seq x (add_nat M n) = partial_sum_seq x M + partial_sum_seq (tail_series x M) n.
Axiom add_nat_const_subseq_fun : forall M :e omega , subseq_fun (fun n => add_nat M n).
Axiom tail_series_subseq_of : forall x : set -> set , forall M :e omega , subseq_of x (tail_series x M).
Axiom seq_limit_of_eq_on_omega : forall x y : set -> set , forall l , (forall n :e omega , x n = y n) -> seq_limit x l -> seq_limit y l.
Axiom convergent_series_tail_iff : forall x : set -> set , R_seq x -> forall M :e omega , convergent_series x <-> convergent_series (tail_series x M).
End form43.
Section form44.
Definition bounded_above_seq : (set -> set) -> prop := fun x => exists B :e R , forall n :e omega , x n <= B.
Definition nonneg_seq : (set -> set) -> prop := fun x => forall n :e omega , 0 <= x n.
Definition abs_seq : (set -> set) -> (set -> set) := fun x => fun n => abs_SNo (x n).
Definition absolutely_convergent_series : (set -> set) -> prop := fun x => convergent_series (abs_seq x).
Axiom R_seq_scale : forall a :e R , forall x : set -> set , R_seq x -> R_seq (seq_scale a x).
Axiom R_seq_add : forall x y : set -> set , R_seq x -> R_seq y -> R_seq (seq_add x y).
Axiom R_seq_abs : forall x : set -> set , R_seq x -> R_seq (abs_seq x).
Axiom abs_partial_sum_seq_le : forall x : set -> set , R_seq x -> forall n :e omega , abs_SNo (partial_sum_seq x n) <= partial_sum_seq (abs_seq x) n.
Axiom partial_sum_seq_scale_eq : forall a :e R , forall x : set -> set , R_seq x -> forall n :e omega , partial_sum_seq (seq_scale a x) n = a * (partial_sum_seq x n).
Axiom partial_sum_seq_scale_eq_on : forall a :e R , forall x : set -> set , forall n :e omega , (forall k :e n , x k :e R) -> partial_sum_seq (seq_scale a x) n = a * (partial_sum_seq x n).
Axiom partial_sum_seq_add_eq : forall x y : set -> set , R_seq x -> R_seq y -> forall n :e omega , partial_sum_seq (seq_add x y) n = partial_sum_seq x n + partial_sum_seq y n.
Axiom convergent_series_scale : forall a :e R , forall x : set -> set , R_seq x -> convergent_series x -> convergent_series (seq_scale a x).
Axiom sum_series_scale : forall a :e R , forall x : set -> set , R_seq x -> convergent_series x -> sum_series (seq_scale a x) = a * sum_series x.
Axiom convergent_series_add : forall x y : set -> set , R_seq x -> R_seq y -> convergent_series x -> convergent_series y -> convergent_series (seq_add x y).
Axiom sum_series_add : forall x y : set -> set , R_seq x -> R_seq y -> convergent_series x -> convergent_series y -> sum_series (seq_add x y) = sum_series x + sum_series y.
Axiom partial_sum_seq_nonneg : forall x : set -> set , R_seq x -> nonneg_seq x -> forall n :e omega , 0 <= partial_sum_seq x n.
Axiom partial_sum_seq_monotone_inc_nonneg : forall x : set -> set , R_seq x -> nonneg_seq x -> monotone_inc (partial_sum_seq x).
Axiom convergent_series_nonneg_iff_bounded_above : forall x : set -> set , R_seq x -> nonneg_seq x -> (convergent_series x <-> bounded_above_seq (partial_sum_seq x)).
Axiom tail_series_R_seq : forall x : set -> set , R_seq x -> forall M :e omega , R_seq (tail_series x M).
Axiom abs_partial_sum_tail_le : forall x : set -> set , R_seq x -> forall M :e omega , forall n :e omega , abs_SNo (partial_sum_seq (tail_series x M) n) <= partial_sum_seq (tail_series (abs_seq x) M) n.
Axiom dist_R_refl : forall x :e R , dist_R x x = 0.
Axiom dist_partial_sum_seq_le_abs_partial_sum_seq_le : forall x : set -> set , R_seq x -> forall m :e omega , forall n :e omega , m <= n -> dist_R (partial_sum_seq x n) (partial_sum_seq x m) <= dist_R (partial_sum_seq (abs_seq x) n) (partial_sum_seq (abs_seq x) m).
Axiom dist_partial_sum_seq_le_abs_partial_sum_seq : forall x : set -> set , R_seq x -> forall m :e omega , forall n :e omega , dist_R (partial_sum_seq x m) (partial_sum_seq x n) <= dist_R (partial_sum_seq (abs_seq x) m) (partial_sum_seq (abs_seq x) n).
Axiom absolutely_convergent_series_imp_convergent_series : forall x : set -> set , R_seq x -> absolutely_convergent_series x -> convergent_series x.
End form44.
Section form45.
Axiom partial_sum_seq_Le_of_term_Le_aux : forall x y : set -> set , R_seq x -> R_seq y -> (forall n :e omega , x n <= y n) -> forall n :e omega , partial_sum_seq x n <= partial_sum_seq y n.
Axiom partial_sum_seq_Le_of_term_Le_nonneg : forall x y : set -> set , R_seq x -> R_seq y -> nonneg_seq x -> (forall n :e omega , x n <= y n) -> forall n :e omega , partial_sum_seq x n <= partial_sum_seq y n.
Axiom partial_sum_seq_Le_of_term_Le : forall x y : set -> set , R_seq x -> R_seq y -> (forall n :e omega , x n <= y n) -> forall n :e omega , partial_sum_seq x n <= partial_sum_seq y n.
Axiom comparison_test_conv : forall x y : set -> set , R_seq x -> R_seq y -> nonneg_seq x -> (forall n :e omega , x n <= y n) -> convergent_series y -> convergent_series x.
Axiom comparison_test_div : forall x y : set -> set , R_seq x -> R_seq y -> nonneg_seq x -> (forall n :e omega , x n <= y n) -> ~ convergent_series x -> ~ convergent_series y.
End form45.
Section form46.
Definition pow_seq : set -> (set -> set) := fun c => fun n => c ^ n.
Axiom R_exp_nat_closed : forall c :e R , forall n :e omega , c ^ n :e R.
Axiom R_seq_pow_seq : forall c :e R , R_seq (pow_seq c).
Axiom pow_seq_limit_0_lt1 : forall c :e R , 0 < c -> c < 1 -> seq_limit (pow_seq c) 0.
End form46.
Section form47.
Axiom geom_partial_sum_mul : forall r :e R , forall k :e omega , (1 + (- r)) * (partial_sum_seq (pow_seq r) k) = 1 + (- (r ^ k)).
End form47.
Section form48.
Axiom omega_ge_1_ne0 : forall n :e omega , 1 <= n -> n <> 0.
Axiom pow_zero_ge1 : forall n :e omega , 1 <= n -> 0 ^ n = 0.
Axiom pow_seq_limit_zero : seq_limit (pow_seq 0) 0.
Axiom abs_pow_seq : forall r :e R , forall n :e omega , abs_SNo (r ^ n) = (abs_SNo r) ^ n.
Axiom pow_seq_limit_between_m1_1 : forall r :e R , - 1 < r -> r < 1 -> seq_limit (pow_seq r) 0.
Axiom geom_partial_sum_limit : forall r :e R , - 1 < r -> r < 1 -> seq_limit (partial_sum_seq (pow_seq r)) (1 :/: (1 + (- r))).
Axiom geometric_series_convergent : forall r :e R , - 1 < r -> r < 1 -> convergent_series (pow_seq r).
Axiom geometric_series_sum : forall r :e R , - 1 < r -> r < 1 -> sum_series (pow_seq r) = 1 :/: (1 + (- r)).
End form48.
Section form49.
Axiom pow_ge_1 : forall r :e R , 1 <= r -> forall n :e omega , 1 <= r ^ n.
Axiom not_pow_seq_limit_0_ge1 : forall r :e R , 1 <= r -> ~ seq_limit (pow_seq r) 0.
Axiom not_pow_seq_limit_0_le_m1 : forall r :e R , r <= - 1 -> ~ seq_limit (pow_seq r) 0.
Axiom geometric_series_diverge_ge1 : forall r :e R , 1 <= r -> ~ convergent_series (pow_seq r).
Axiom geometric_series_diverge_le_m1 : forall r :e R , r <= - 1 -> ~ convergent_series (pow_seq r).
End form49.
Section form50.
Definition ratio_abs_seq : (set -> set) -> (set -> set) := fun x => fun n => (abs_SNo (x (ordsucc n))) :/: (abs_SNo (x n)).
Axiom abs_pos_of_nonzero : forall x :e R , x <> 0 -> 0 < abs_SNo x.
Axiom ratio_abs_seq_pos : forall x : set -> set , R_seq x -> (forall n :e omega , x n <> 0) -> forall n :e omega , 0 < ratio_abs_seq x n.
Axiom ratio_abs_seq_nonneg : forall x : set -> set , R_seq x -> (forall n :e omega , x n <> 0) -> forall n :e omega , 0 <= ratio_abs_seq x n.
Axiom ratio_eventually_Le_of_limit_Lt : forall x : set -> set , R_seq x -> (forall n :e omega , x n <> 0) -> forall L r :e R , seq_limit (ratio_abs_seq x) L -> L < r -> exists N :e omega , forall n :e omega , N <= n -> ratio_abs_seq x n <= r.
Axiom ratio_eventually_Le_of_limit_Gt : forall x : set -> set , R_seq x -> (forall n :e omega , x n <> 0) -> forall L r :e R , seq_limit (ratio_abs_seq x) L -> r < L -> exists N :e omega , forall n :e omega , N <= n -> r <= ratio_abs_seq x n.
Axiom ratio_test_strong_conv : forall x : set -> set , R_seq x -> (forall n :e omega , x n <> 0) -> forall r :e R , 0 < r -> r < 1 -> (exists M :e omega , forall n :e omega , M <= n -> ratio_abs_seq x n <= r) -> absolutely_convergent_series x.
Axiom ratio_test_strong_div : forall x : set -> set , R_seq x -> (forall n :e omega , x n <> 0) -> forall r :e R , 1 < r -> (exists M :e omega , forall n :e omega , M <= n -> r <= ratio_abs_seq x n) -> ~ convergent_series x.
Axiom ratio_test_conv : forall x : set -> set , R_seq x -> (forall n :e omega , x n <> 0) -> forall L :e R , seq_limit (ratio_abs_seq x) L -> L < 1 -> absolutely_convergent_series x.
Axiom ratio_test_div : forall x : set -> set , R_seq x -> (forall n :e omega , x n <> 0) -> forall L :e R , seq_limit (ratio_abs_seq x) L -> 1 < L -> ~ convergent_series x.
End form50.
Section form51.
Definition alt_sign_seq : set -> set := fun n => (- 1) ^ (ordsucc n).
Definition alt_seq : (set -> set) -> (set -> set) := fun x => fun n => (alt_sign_seq n) * (x n).
Axiom pow_m1_two : (- 1) ^ 2 = 1.
Axiom pow_m1_SS : forall n :e omega , (- 1) ^ (ordsucc (ordsucc n)) = (- 1) ^ n.
Axiom pow_test_rewrite : (- 1) ^ (2 * 0) = (- 1) ^ 0.
Axiom mul2_ordsucc : forall k :e omega , 2 * (ordsucc k) = ordsucc (ordsucc (2 * k)).
Axiom pow_m1_even_0 : (- 1) ^ (2 * 0) = 1.
Axiom pow_m1_even : forall k :e omega , (- 1) ^ (2 * k) = 1.
Axiom pow_m1_odd : forall k :e omega , (- 1) ^ (ordsucc (2 * k)) = - 1.
Axiom omega_even_or_odd : forall n :e omega , exists k :e omega , n = 2 * k \/ n = ordsucc (2 * k).
Axiom alt_sign_even : forall k :e omega , alt_sign_seq (2 * k) = - 1.
Axiom alt_sign_odd : forall k :e omega , alt_sign_seq (ordsucc (2 * k)) = 1.
Axiom alt_sign_seq_R_seq : R_seq alt_sign_seq.
Axiom alt_seq_R_seq : forall x : set -> set , R_seq x -> R_seq (alt_seq x).
Axiom alt_seq_even_term : forall x : set -> set , R_seq x -> forall k :e omega , (alt_seq x) (2 * k) = - (x (2 * k)).
Axiom alt_seq_odd_term : forall x : set -> set , R_seq x -> forall k :e omega , (alt_seq x) (ordsucc (2 * k)) = x (ordsucc (2 * k)).
Axiom omega_le_mul2 : forall k :e omega , k <= 2 * k.
Axiom alt_partial_sum_even_step : forall x : set -> set , R_seq x -> (forall n :e omega , 0 <= x n) -> monotone_dec x -> forall k :e omega , partial_sum_seq (alt_seq x) (2 * (ordsucc k)) <= partial_sum_seq (alt_seq x) (2 * k).
Axiom alt_partial_sum_odd_step : forall x : set -> set , R_seq x -> (forall n :e omega , 0 <= x n) -> monotone_dec x -> forall k :e omega , partial_sum_seq (alt_seq x) (ordsucc (2 * k)) <= partial_sum_seq (alt_seq x) (ordsucc (2 * (ordsucc k))).
Axiom alt_partial_sum_odd_le_even : forall x : set -> set , R_seq x -> (forall n :e omega , 0 <= x n) -> forall k :e omega , partial_sum_seq (alt_seq x) (ordsucc (2 * k)) <= partial_sum_seq (alt_seq x) (2 * k).
Axiom alt_partial_sum_even_decrease : forall x : set -> set , R_seq x -> (forall n :e omega , 0 <= x n) -> monotone_dec x -> forall k :e omega , forall j :e omega , partial_sum_seq (alt_seq x) (2 * (add_nat k j)) <= partial_sum_seq (alt_seq x) (2 * k).
Axiom alt_partial_sum_odd_increase : forall x : set -> set , R_seq x -> (forall n :e omega , 0 <= x n) -> monotone_dec x -> forall k :e omega , forall j :e omega , partial_sum_seq (alt_seq x) (ordsucc (2 * k)) <= partial_sum_seq (alt_seq x) (ordsucc (2 * (add_nat k j))).
Axiom add_nat_mul2_distr : forall k j :e omega , add_nat (2 * k) (2 * j) = 2 * (add_nat k j).
Axiom add_nat_mul2_succ : forall k j :e omega , add_nat (ordsucc (2 * k)) (2 * j) = ordsucc (2 * (add_nat k j)).
Axiom alt_partial_sum_tail_bounds : forall x : set -> set , R_seq x -> (forall n :e omega , 0 <= x n) -> monotone_dec x -> forall k :e omega , forall n :e omega , 2 * k <= n -> partial_sum_seq (alt_seq x) (ordsucc (2 * k)) <= partial_sum_seq (alt_seq x) n /\ partial_sum_seq (alt_seq x) n <= partial_sum_seq (alt_seq x) (2 * k).
Axiom alternating_series_convergent : forall x : set -> set , R_seq x -> (forall n :e omega , 0 <= x n) -> monotone_dec x -> seq_limit x 0 -> convergent_series (alt_seq x).
End form51.
Section form52.
Definition cluster_point : set -> set -> prop := fun S x => x :e R /\ forall eps :e R , 0 < eps -> exists y :e S , y <> x /\ dist_R y x < eps.
Axiom cluster_point_iff_seq : forall S x : set , S c= R -> (cluster_point S x <-> exists a : set -> set , (forall n :e omega , a n :e S /\ a n <> x) /\ seq_limit a x).
Definition func_limit : (set -> set) -> set -> set -> set -> prop := fun f S c L => S c= R /\ cluster_point S c /\ (forall x :e S , f x :e R) /\ L :e R /\ forall eps :e R , 0 < eps -> exists delta :e R , 0 < delta /\ forall x :e S , x <> c -> dist_R x c < delta -> dist_R (f x) L < eps.
Axiom func_limit_unique : forall f : set -> set , forall S c L1 L2 : set , func_limit f S c L1 -> func_limit f S c L2 -> L1 = L2.
Axiom func_limit_imp_seq_limit : forall f : set -> set , forall S c L : set , func_limit f S c L -> forall a : set -> set , (forall n :e omega , a n :e S /\ a n <> c) -> seq_limit a c -> seq_limit (fun n => f (a n)) L.
Definition seq_func_limit : (set -> set) -> set -> set -> set -> prop := fun f S c L => S c= R /\ cluster_point S c /\ (forall x :e S , f x :e R) /\ L :e R /\ forall a : set -> set , (forall n :e omega , a n :e S /\ a n <> c) -> seq_limit a c -> seq_limit (fun n => f (a n)) L.
Axiom seq_func_limit_elim_Sc : forall f : set -> set , forall S c L , seq_func_limit f S c L -> S c= R.
Axiom seq_func_limit_elim_cluster : forall f : set -> set , forall S c L , seq_func_limit f S c L -> cluster_point S c.
Axiom seq_func_limit_elim_fR : forall f : set -> set , forall S c L , seq_func_limit f S c L -> forall x :e S , f x :e R.
Axiom seq_func_limit_elim_LR : forall f : set -> set , forall S c L , seq_func_limit f S c L -> L :e R.
Axiom seq_func_limit_elim_seq : forall f : set -> set , forall S c L , seq_func_limit f S c L -> forall a : set -> set , (forall n :e omega , a n :e S /\ a n <> c) -> seq_limit a c -> seq_limit (fun n => f (a n)) L.
Axiom seq_func_limit_unique : forall f : set -> set , forall S c L1 L2 , seq_func_limit f S c L1 -> seq_func_limit f S c L2 -> L1 = L2.
Axiom ms_seqflimit_lemma : forall f : set -> set , forall S c L : set , S c= R -> cluster_point S c -> (forall x :e S , f x :e R) -> L :e R -> ((forall eps :e R , 0 < eps -> exists delta :e R , 0 < delta /\ forall x :e S , x <> c -> dist_R x c < delta -> dist_R (f x) L < eps) <-> (forall a : set -> set , (forall n :e omega , a n :e S /\ a n <> c) -> seq_limit a c -> seq_limit (fun n => f (a n)) L)).
Axiom func_limit_imp_seq_func_limit : forall f : set -> set , forall S c L : set , func_limit f S c L -> seq_func_limit f S c L.
Axiom seq_func_limit_imp_func_limit : forall f : set -> set , forall S c L : set , seq_func_limit f S c L -> func_limit f S c L.
Axiom func_limit_iff_seq_func_limit : forall f : set -> set , forall S c L : set , func_limit f S c L <-> seq_func_limit f S c L.
End form52.
Section form53.
Definition continuous_at : (set -> set) -> set -> set -> prop := fun f S c => S c= R /\ c :e S /\ (forall x :e S , f x :e R) /\ forall eps :e R , 0 < eps -> exists delta :e R , 0 < delta /\ forall x :e S , dist_R x c < delta -> dist_R (f x) (f c) < eps.
Definition continuous_on : (set -> set) -> set -> prop := fun f S => forall c :e S , continuous_at f S c.
Axiom continuous_at_imp_func_limit : forall f : set -> set , forall S c , continuous_at f S c -> cluster_point S c -> func_limit f S c (f c).
Axiom func_limit_imp_continuous_at : forall f : set -> set , forall S c , func_limit f S c (f c) -> c :e S -> continuous_at f S c.
Axiom continuous_at_imp_seq_limit : forall f : set -> set , forall S c , continuous_at f S c -> forall a : set -> set , (forall n :e omega , a n :e S) -> seq_limit a c -> seq_limit (fun n => f (a n)) (f c).
Definition seq_continuous_at : (set -> set) -> set -> set -> prop := fun f S c => S c= R /\ c :e S /\ (forall x :e S , f x :e R) /\ forall a : set -> set , (forall n :e omega , a n :e S) -> seq_limit a c -> seq_limit (fun n => f (a n)) (f c).
Axiom continuous_at_imp_seq_continuous_at : forall f : set -> set , forall S c , continuous_at f S c -> seq_continuous_at f S c.
Axiom seq_continuous_at_imp_continuous_at : forall f : set -> set , forall S c , seq_continuous_at f S c -> continuous_at f S c.
Axiom continuous_at_iff_seq_continuous_at : forall f : set -> set , forall S c , continuous_at f S c <-> seq_continuous_at f S c.
Axiom continuous_at_minus : forall f : set -> set , forall S c , continuous_at f S c -> continuous_at (fun x => - (f x)) S c.
Axiom continuous_at_nbhd_nonzero : forall f : set -> set , forall S c , continuous_at f S c -> f c <> 0 -> exists delta :e R , 0 < delta /\ forall x :e S , dist_R x c < delta -> f x <> 0.
End form53.
Section form54.
Axiom continuous_at_iff_func_limit : forall f : set -> set , forall S c , cluster_point S c -> c :e S -> (continuous_at f S c <-> func_limit f S c (f c)).
Axiom continuous_at_imp_seq_func_limit : forall f : set -> set , forall S c , continuous_at f S c -> cluster_point S c -> seq_func_limit f S c (f c).
Axiom seq_func_limit_imp_continuous_at : forall f : set -> set , forall S c , seq_func_limit f S c (f c) -> c :e S -> continuous_at f S c.
End form54.
Section form55.
Definition uniformly_continuous_on : (set -> set) -> set -> prop := fun f S => S c= R /\ (forall x :e S , f x :e R) /\ forall eps :e R , 0 < eps -> exists delta :e R , 0 < delta /\ forall x :e S , forall y :e S , dist_R x y < delta -> dist_R (f x) (f y) < eps.
Axiom uniformly_continuous_on_imp_continuous_on : forall f : set -> set , forall S , uniformly_continuous_on f S -> continuous_on f S.
End form55.
Section form56.
Definition lipschitz_continuous_on : (set -> set) -> set -> prop := fun f S => S c= R /\ (forall x :e S , f x :e R) /\ exists K :e R , 0 < K /\ forall x :e S , forall y :e S , dist_R (f x) (f y) <= K * dist_R x y.
Axiom lipschitz_continuous_on_imp_uniformly_continuous_on : forall f : set -> set , forall S , lipschitz_continuous_on f S -> uniformly_continuous_on f S.
Axiom uniformly_continuous_on_imp_preserve_cauchy : forall f : set -> set , forall S , forall x : set -> set , uniformly_continuous_on f S -> (forall n :e omega , x n :e S) -> cauchy_seq x -> cauchy_seq (fun n => f (x n)).
Axiom seq_limit_dist_0_of_same_limit : forall x y : set -> set , forall l , seq_limit x l -> seq_limit y l -> seq_limit (fun n : set => dist_R (x n) (y n)) 0.
Axiom continuous_on_Icc_imp_uniformly_continuous_on : forall f : set -> set , forall a b :e R , continuous_on f (Icc a b) -> uniformly_continuous_on f (Icc a b).
End form56.
Section form57.
Axiom abs_Icc_le_abs_sum : forall a b :e R , forall x , x :e Icc a b -> abs_SNo x <= abs_SNo a + abs_SNo b.
Axiom Icc_seq_bounded : forall a b :e R , forall x : set -> set , (forall n :e omega , x n :e Icc a b) -> bounded_seq x.
End form57.
Section form58.
Axiom Icc_closed_seq_limit : forall a b :e R , forall x : set -> set , forall l , (forall n :e omega , x n :e Icc a b) -> seq_limit x l -> l :e Icc a b.
End form58.
Section form59.
Definition ms_seq_limit : set -> (set -> set -> set) -> (set -> set) -> set -> prop := fun X d x l => (forall n :e omega , x n :e X) /\ l :e X /\ forall eps :e R , 0 < eps -> exists N :e omega , forall n :e omega , N <= n -> d (x n) l < eps.
Definition ms_lim_seq : set -> (set -> set -> set) -> (set -> set) -> set := fun X d x => Eps_i (fun l => ms_seq_limit X d x l).
Definition ms_seq_compact : set -> (set -> set -> set) -> set -> prop := fun X d K => K c= X /\ forall x : set -> set , (forall n :e omega , x n :e K) -> exists xs : set -> set , subseq_of x xs /\ exists l :e K , ms_seq_limit X d xs l.
Definition ms_seq_continuous_on : (set -> set) -> set -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> prop := fun f X dX Y dY K => (forall x :e K , f x :e Y) /\ forall c :e K , forall a0 : set -> set , (forall n :e omega , a0 n :e K) -> ms_seq_limit X dX a0 c -> ms_seq_limit Y dY (fun n : set => f (a0 n)) (f c).
Axiom ms_seq_continuous_on_imp_image_seq_compact : forall X Y , forall dX dY : set -> set -> set , forall f : set -> set , forall K , ms_seq_compact X dX K -> ms_seq_continuous_on f X dX Y dY K -> ms_seq_compact Y dY {f x|x :e K}.
End form59.
Section form60.
Definition ms_continuous_at : (set -> set) -> set -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> prop := fun f X dX Y dY c => c :e X /\ (forall x :e X , f x :e Y) /\ forall eps :e R , 0 < eps -> exists delta :e R , 0 < delta /\ forall x :e X , dX x c < delta -> dY (f x) (f c) < eps.
Definition ms_continuous_on : (set -> set) -> set -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> prop := fun f X dX Y dY K => K c= X /\ forall c :e K , ms_continuous_at f X dX Y dY c.
Axiom ms_continuous_at_imp_ms_seq_continuous : forall f : set -> set , forall X Y , forall dX dY : set -> set -> set , forall c , ms_continuous_at f X dX Y dY c -> forall a0 : set -> set , (forall n :e omega , a0 n :e X) -> ms_seq_limit X dX a0 c -> ms_seq_limit Y dY (fun n : set => f (a0 n)) (f c).
Axiom ms_continuous_on_imp_ms_seq_continuous_on : forall f : set -> set , forall X Y , forall dX dY : set -> set -> set , forall K , ms_continuous_on f X dX Y dY K -> ms_seq_continuous_on f X dX Y dY K.
End form60.
Section form61.
Axiom ms_continuous_on_imp_image_seq_compact : forall X Y , forall dX dY : set -> set -> set , forall f : set -> set , forall K , ms_seq_compact X dX K -> ms_continuous_on f X dX Y dY K -> ms_seq_compact Y dY {f x|x :e K}.
End form61.
Section form62.
Axiom Icc_ms_seq_compact : forall a b :e R , ms_seq_compact (Icc a b) dist_R (Icc a b).
End form62.
Section form63.
Axiom continuous_at_imp_ms_continuous_at : forall f : set -> set , forall S , forall c , continuous_at f S c -> ms_continuous_at f S dist_R R dist_R c.
Axiom continuous_on_imp_ms_continuous_on_self : forall f : set -> set , forall S , continuous_on f S -> ms_continuous_on f S dist_R R dist_R S.
Axiom continuous_on_Icc_imp_fimage_ms_seq_compact : forall f : set -> set , forall a b :e R , continuous_on f (Icc a b) -> ms_seq_compact R dist_R {f x|x :e Icc a b}.
End form63.
Section form64.
Axiom ms_seq_compact_R_has_maxmin : forall A , ms_seq_compact R dist_R A -> nonempty A -> has_max A /\ has_min A.
Axiom continuous_on_Icc_attains_maxmin : forall f : set -> set , forall a b :e R , a <= b -> continuous_on f (Icc a b) -> (exists x :e Icc a b , is_max (fimage f (Icc a b)) (f x)) /\ (exists y :e Icc a b , is_min (fimage f (Icc a b)) (f y)).
End form64.
Section form65.
Axiom continuous_on_Icc_IVT : forall f : set -> set , forall a b :e R , forall y :e R , a < b -> continuous_on f (Icc a b) -> (f a < y /\ y < f b) \/ (f b < y /\ y < f a) -> exists c :e Ioo a b , f c = y.
Axiom continuous_on_Icc_IVT0 : forall f : set -> set , forall a b :e R , a < b -> continuous_on f (Icc a b) -> f a < 0 -> 0 < f b -> exists c :e Ioo a b , f c = 0.
End form65.
Section form66.
Axiom continuous_on_Icc_fimage_interval : forall f : set -> set , forall a b :e R , a <= b -> continuous_on f (Icc a b) -> exists m :e R , exists M :e R , fimage f (Icc a b) = Icc m M.
End form66.
Section form67.
Axiom zero_in_R : 0 :e R.
Axiom one_in_R : 1 :e R.
Axiom nonempty_R : nonempty R.
Definition is_metric : set -> (set -> set -> set) -> prop := fun X d => (forall x :e X , forall y :e X , d x y :e R) /\ ((forall x :e X , forall y :e X , 0 <= d x y) /\ ((forall x :e X , d x x = 0) /\ ((forall x :e X , forall y :e X , d x y = d y x) /\ ((forall x :e X , forall y :e X , forall z :e X , d x z <= d x y + d y z) /\ (forall x :e X , forall y :e X , d x y = 0 -> x = y))))).
Axiom is_metric_dR : forall X , forall d : set -> set -> set , is_metric X d -> forall x :e X , forall y :e X , d x y :e R.
Axiom is_metric_nonneg : forall X , forall d : set -> set -> set , is_metric X d -> forall x :e X , forall y :e X , 0 <= d x y.
Axiom is_metric_sep : forall X , forall d : set -> set -> set , is_metric X d -> forall x :e X , forall y :e X , d x y = 0 -> x = y.
Axiom is_metric_diag0 : forall X , forall d : set -> set -> set , is_metric X d -> forall x :e X , d x x = 0.
Axiom is_metric_sym : forall X , forall d : set -> set -> set , is_metric X d -> forall x :e X , forall y :e X , d x y = d y x.
Axiom is_metric_tri : forall X , forall d : set -> set -> set , is_metric X d -> forall x :e X , forall y :e X , forall z :e X , d x z <= d x y + d y z.
Definition ms_ball : set -> (set -> set -> set) -> set -> set -> set := fun X d x delta => {y :e X|d x y < delta}.
Definition ms_closed_ball : set -> (set -> set -> set) -> set -> set -> set := fun X d x delta => {y :e X|d x y <= delta}.
Definition ms_open : set -> (set -> set -> set) -> set -> prop := fun X d V => V c= X /\ forall x :e V , exists delta :e R , 0 < delta /\ forall y :e X , d x y < delta -> y :e V.
Definition ms_closed : set -> (set -> set -> set) -> set -> prop := fun X d E => E c= X /\ ms_open X d (X :\: E).
Axiom ms_open_Empty : forall X , forall d : set -> set -> set , is_metric X d -> ms_open X d Empty.
Axiom ms_open_X : forall X , forall d : set -> set -> set , is_metric X d -> ms_open X d X.
Axiom ms_open_binintersect : forall X , forall d : set -> set -> set , is_metric X d -> forall V W , ms_open X d V -> ms_open X d W -> ms_open X d (V :/\: W).
Axiom ms_open_Union : forall X , forall d : set -> set -> set , is_metric X d -> forall V , (forall U :e V , ms_open X d U) -> ms_open X d (Union V).
Axiom setminus_self_eq_Empty : forall X , X :\: X = Empty.
Axiom setminus_Empty_eq : forall X , X :\: Empty = X.
Axiom ms_closed_Empty : forall X , forall d : set -> set -> set , is_metric X d -> ms_closed X d Empty.
Axiom ms_closed_X : forall X , forall d : set -> set -> set , is_metric X d -> ms_closed X d X.
Axiom setminus_binunion_eq_binintersect_setminus : forall X A B , X :\: (A :\/: B) = (X :\: A) :/\: (X :\: B).
Axiom ms_closed_binunion : forall X , forall d : set -> set -> set , is_metric X d -> forall A B , ms_closed X d A -> ms_closed X d B -> ms_closed X d (A :\/: B).
Axiom ms_open_ball : forall X , forall d : set -> set -> set , is_metric X d -> forall x :e X , forall delta :e R , 0 < delta -> ms_open X d (ms_ball X d x delta).
Axiom is_metric_R_dist_R : is_metric R dist_R.
Definition ms_cauchy_seq : set -> (set -> set -> set) -> (set -> set) -> prop := fun X d x => (forall n :e omega , x n :e X) /\ forall eps :e R , 0 < eps -> exists N :e omega , forall m :e omega , forall n :e omega , N <= m -> N <= n -> d (x m) (x n) < eps.
Definition ms_complete : set -> (set -> set -> set) -> prop := fun X d => forall x : set -> set , ms_cauchy_seq X d x -> exists l :e X , ms_seq_limit X d x l.
Axiom ms_complete_R_dist_R : ms_complete R dist_R.
Definition ms_contraction : (set -> set) -> set -> (set -> set -> set) -> prop := fun phi X d => exists k :e R , (0 <= k /\ k < 1) /\ forall x :e X , forall y :e X , d (phi x) (phi y) <= k * d x y.
Definition dist_discrete : set -> set -> set := fun x y => if x = y then 0 else 1.
Axiom dist_discrete_def : forall x y , dist_discrete x y = if x = y then 0 else 1.
Axiom dist_discrete_is_metric : forall X , is_metric X dist_discrete.
Axiom ms_contraction_discrete_constant : forall X , nonempty X -> forall f : set -> set , (forall x :e X , f x :e X) -> ms_contraction f X dist_discrete -> exists c :e X , forall x :e X , f x = c.
Definition ms_fixed_point : (set -> set) -> set -> prop := fun phi x => phi x = x.
Definition ms_has_unique_fixed_point : (set -> set) -> set -> prop := fun phi X => exists x :e X , ms_fixed_point phi x /\ forall y :e X , ms_fixed_point phi y -> y = x.
Definition ms_iter_seq : (set -> set) -> set -> (set -> set) := fun phi x0 => fun n => nat_primrec x0 (fun _ r => phi r) n.
Axiom ms_iter_seq_0 : forall phi : set -> set , forall x0 , ms_iter_seq phi x0 0 = x0.
Axiom ms_iter_seq_S : forall phi : set -> set , forall x0 , forall n :e omega , ms_iter_seq phi x0 (ordsucc n) = phi (ms_iter_seq phi x0 n).
Axiom ms_iter_seq_inX : forall X , forall phi : set -> set , forall x0 , x0 :e X -> (forall x :e X , phi x :e X) -> forall n :e omega , ms_iter_seq phi x0 n :e X.
Axiom ms_contraction_fixed_point_exists_k0 : forall X , forall d : set -> set -> set , forall phi : set -> set , nonempty X -> is_metric X d -> (forall x :e X , phi x :e X) -> (forall x :e X , forall y :e X , d (phi x) (phi y) <= 0) -> exists c :e X , phi c = c.
Axiom ms_contraction_fixed_point_unique : forall X , forall d : set -> set -> set , forall phi : set -> set , is_metric X d -> (forall x :e X , phi x :e X) -> ms_contraction phi X d -> forall x :e X , phi x = x -> forall y :e X , phi y = y -> x = y.
Axiom ms_contraction_fixed_point_unique2 : forall X , forall d : set -> set -> set , forall phi : set -> set , is_metric X d -> (forall x :e X , phi x :e X) -> ms_contraction phi X d -> forall x :e X , ms_fixed_point phi x -> forall y :e X , ms_fixed_point phi y -> x = y.
Axiom SNoLe_eq_substL : forall x y z , SNo x -> SNo y -> SNo z -> x = y -> x <= z -> y <= z.
Axiom SNoLe_eq_substR0 : forall x y z , SNo x -> SNo y -> SNo z -> x = y -> z <= x -> z <= y.
Axiom ms_contraction_mapping_principle : forall X , forall d : set -> set -> set , forall phi : set -> set , nonempty X -> is_metric X d -> ms_contraction phi X d -> ms_complete X d -> (forall x :e X , phi x :e X) -> exists x :e X , phi x = x /\ forall y :e X , phi y = y -> y = x.
Axiom ms_contraction_fixed_point_exists : forall X , forall d : set -> set -> set , forall phi : set -> set , nonempty X -> is_metric X d -> ms_contraction phi X d -> ms_complete X d -> (forall x :e X , phi x :e X) -> exists x :e X , phi x = x.
Axiom ms_iter_seq_succ_arg : forall phi : set -> set , forall x , forall n , nat_p n -> ms_iter_seq phi (phi x) n = phi (ms_iter_seq phi x n).
Axiom ms_iter_seq_of_fixed_point : forall phi : set -> set , forall x , phi x = x -> forall n , nat_p n -> ms_iter_seq phi x n = x.
Axiom ms_summable_iterates_unique_fixed_point : forall X , forall d : set -> set -> set , forall f : set -> set , forall k : set -> set , nonempty X -> is_metric X d -> ms_complete X d -> (forall x :e X , f x :e X) -> R_seq k -> nonneg_seq k -> convergent_series k -> (forall n :e omega , forall x :e X , forall y :e X , d (ms_iter_seq f x (ordsucc n)) (ms_iter_seq f y (ordsucc n)) <= k n * d x y) -> ms_has_unique_fixed_point f X.
Axiom ms_contraction_iter_dist_fixed_point_le : forall X , forall d : set -> set -> set , forall f : set -> set , is_metric X d -> forall k :e R , 0 <= k -> k < 1 -> (forall x :e X , forall y :e X , d (f x) (f y) <= k * d x y) -> (forall x :e X , f x :e X) -> forall x0 :e X , forall x :e X , f x = x -> forall n :e omega , d (ms_iter_seq f x0 n) x <= (k ^ n) * d x0 x.
Axiom ms_contraction_fixed_point_gap_le : forall X , forall d : set -> set -> set , forall f : set -> set , is_metric X d -> forall k :e R , 0 <= k -> k < 1 -> (forall x :e X , forall y :e X , d (f x) (f y) <= k * d x y) -> (forall x :e X , f x :e X) -> forall x0 :e X , forall x :e X , f x = x -> d x0 x <= (d (f x0) x0) :/: (1 + (- k)).
Axiom ms_contraction_iter_dist_fixed_point_le_gap : forall X , forall d : set -> set -> set , forall f : set -> set , is_metric X d -> forall k :e R , 0 <= k -> k < 1 -> (forall x :e X , forall y :e X , d (f x) (f y) <= k * d x y) -> (forall x :e X , f x :e X) -> forall x0 :e X , forall x :e X , f x = x -> forall n :e omega , d (ms_iter_seq f x0 n) x <= (k ^ n) * ((d (f x0) x0) :/: (1 + (- k))).
Axiom ms_contraction_affine_R : forall k b :e R , 0 <= k -> k < 1 -> ms_contraction (fun x : set => k * x + b) R dist_R.
Axiom ms_fixed_point_affine_R_unique : forall k b :e R , 0 <= k -> k < 1 -> forall x :e R , (k * x + b) = x -> forall y :e R , (k * y + b) = y -> x = y.
Axiom ms_has_unique_fixed_point_affine_R : forall k b :e R , 0 <= k -> k < 1 -> ms_has_unique_fixed_point (fun x : set => k * x + b) R.
End form67.
Section form68.
Definition diffquot : (set -> set) -> set -> (set -> set) := fun f c => fun x => (f x + (- (f c))) :/: (x + (- c)).
Definition deriv_at : (set -> set) -> set -> set -> set -> prop := fun f I c L => I c= R /\ c :e I /\ (forall x :e I , f x :e R) /\ seq_func_limit (diffquot f c) I c L.
Axiom deriv_at_elim_Ic : forall f : set -> set , forall I c L , deriv_at f I c L -> I c= R /\ c :e I /\ (forall x :e I , f x :e R).
Axiom deriv_at_elim_seq : forall f : set -> set , forall I c L , deriv_at f I c L -> seq_func_limit (diffquot f c) I c L.
Definition differentiable_at : (set -> set) -> set -> set -> prop := fun f I c => exists L :e R , deriv_at f I c L.
Axiom deriv_at_unique : forall f : set -> set , forall I c L1 L2 , deriv_at f I c L1 -> deriv_at f I c L2 -> L1 = L2.
Axiom deriv_at_imp_continuous_at : forall f : set -> set , forall I c L , deriv_at f I c L -> continuous_at f I c.
Axiom deriv_at_scale : forall f : set -> set , forall I c L , deriv_at f I c L -> forall alpha :e R , deriv_at (fun x => alpha * (f x)) I c (alpha * L).
Axiom deriv_at_add : forall f g : set -> set , forall I c Lf Lg , deriv_at f I c Lf -> deriv_at g I c Lg -> deriv_at (fun x => f x + g x) I c (Lf + Lg).
End form68.
Section form69.
Axiom seq_limit_elim_R_seq : forall x : set -> set , forall l , seq_limit x l -> R_seq x.
Axiom seq_limit_elim_l_in_R : forall x : set -> set , forall l , seq_limit x l -> l :e R.
Axiom seq_limit_elim_eps : forall x : set -> set , forall l , seq_limit x l -> forall eps :e R , 0 < eps -> exists N :e omega , forall n :e omega , N <= n -> dist_R (x n) l < eps.
Axiom deriv_at_mul : forall f g : set -> set , forall I c Lf Lg , deriv_at f I c Lf -> deriv_at g I c Lg -> deriv_at (fun x => (f x) * (g x)) I c ((f c) * Lg + Lf * (g c)).
Axiom deriv_at_const : forall I : set , forall c k :e R , I c= R -> c :e I -> cluster_point I c -> deriv_at (fun x : set => k) I c 0.
Axiom deriv_at_id : forall I : set , forall c :e R , I c= R -> c :e I -> cluster_point I c -> deriv_at (fun x : set => x) I c 1.
Axiom div_cancel_mul_left : forall x y z , SNo x -> SNo y -> SNo z -> y <> 0 -> (x * y) :/: (y * z) = x :/: z.
Axiom seq_limit_div : forall x y : set -> set , forall a b , seq_limit x a -> seq_limit y b -> b <> 0 -> (forall n :e omega , y n <> 0) -> seq_limit (fun n => (x n) :/: (y n)) (a :/: b).
Axiom mul_SNo_eq_0_imp_L_eq_0 : forall x y , SNo x -> SNo y -> y <> 0 -> x * y = 0 -> x = 0.
Axiom mul_SNo_eq_0_imp_R_eq_0 : forall x y , SNo x -> SNo y -> x <> 0 -> x * y = 0 -> y = 0.
Axiom recip_SNo_sub_eq : forall u v , SNo u -> SNo v -> u <> 0 -> v <> 0 -> recip_SNo u + (- (recip_SNo v)) = (v + (- u)) :/: (u * v).
Axiom div_SNo_minus_num : forall x y , SNo x -> SNo y -> (- x) :/: y = - (x :/: y).
Axiom add_SNo_neg_swap : forall u v , SNo u -> SNo v -> v + (- u) = - (u + (- v)).
Axiom deriv_at_recip_comp : forall g : set -> set , forall I c Lg , (forall x :e I , g x <> 0) -> deriv_at g I c Lg -> deriv_at (fun x => recip_SNo (g x)) I c ((- Lg) :/: ((g c) * (g c))).
Axiom deriv_at_div : forall f g : set -> set , forall I c Lf Lg , (forall x :e I , g x <> 0) -> deriv_at f I c Lf -> deriv_at g I c Lg -> deriv_at (fun x => (f x) :/: (g x)) I c ((Lf * (g c) + (- ((f c) * Lg))) :/: ((g c) * (g c))).
Axiom deriv_at_chain : forall f : set -> set , forall I2 d Lf , deriv_at f I2 d Lf -> forall g : set -> set , forall I1 c Lg , deriv_at g I1 c Lg -> (forall x :e I1 , g x :e I2) -> g c = d -> deriv_at (fun x => f (g x)) I1 c (Lf * Lg).
End form69.
Section form70.
Definition differentiable_on : (set -> set) -> set -> prop := fun f I => forall c :e I , differentiable_at f I c.
Axiom R_two : 2 :e R.
Axiom Ioo_subq_Icc : forall a b :e R , Ioo a b c= Icc a b.
Axiom Icc_boundary_or_Ioo : forall a b :e R , forall x :e Icc a b , x :e Ioo a b \/ x = a \/ x = b.
Axiom continuous_at_elim_fR : forall f : set -> set , forall S c , continuous_at f S c -> forall x :e S , f x :e R.
Axiom continuous_on_elim_fR : forall f : set -> set , forall S , continuous_on f S -> forall x :e S , f x :e R.
Axiom deriv_at_Ioo_imp_Icc_of_continuous_on : forall f : set -> set , forall a b :e R , forall c L , a < b -> continuous_on f (Icc a b) -> c :e Ioo a b -> deriv_at f (Ioo a b) c L -> deriv_at f (Icc a b) c L.
Axiom omega_le_add_nat_L : forall n m :e omega , n <= add_nat n m.
Axiom omega_le_add_nat_R : forall n m :e omega , m <= add_nat n m.
Axiom div_SNo_minus_minus : forall x y , SNo x -> SNo y -> (- x) :/: (- y) = x :/: y.
Axiom fermat_max_Icc : forall f : set -> set , forall a b :e R , forall c L , a < b -> c :e Ioo a b -> deriv_at f (Icc a b) c L -> (forall x :e Icc a b , f x <= f c) -> L = 0.
Axiom fermat_min_Icc : forall f : set -> set , forall a b :e R , forall c L , a < b -> c :e Ioo a b -> deriv_at f (Icc a b) c L -> (forall x :e Icc a b , f c <= f x) -> L = 0.
Axiom Rolle_choose_extremum : forall f : set -> set , forall a b :e R , a < b -> continuous_on f (Icc a b) -> f a = f b -> exists c :e Ioo a b , is_max (fimage f (Icc a b)) (f c) \/ is_min (fimage f (Icc a b)) (f c).
Axiom Rolle_thm : forall f : set -> set , forall a b :e R , a < b -> continuous_on f (Icc a b) -> differentiable_on f (Ioo a b) -> f a = f b -> exists c :e (Ioo a b) , deriv_at f (Icc a b) c 0.
Axiom mean_value_thm : forall f : set -> set , forall a b :e R , a < b -> continuous_on f (Icc a b) -> differentiable_on f (Ioo a b) -> exists c :e (Ioo a b) , exists L :e R , deriv_at f (Icc a b) c L /\ f b + (- (f a)) = L * (b + (- a)).
Axiom cauchy_mean_value_thm : forall f phi : set -> set , forall a b :e R , a < b -> continuous_on f (Icc a b) -> continuous_on phi (Icc a b) -> differentiable_on f (Ioo a b) -> differentiable_on phi (Ioo a b) -> exists c :e (Ioo a b) , exists Lf Lphi :e R , deriv_at f (Icc a b) c Lf /\ deriv_at phi (Icc a b) c Lphi /\ (f b + (- (f a))) * Lphi = Lf * (phi b + (- (phi a))).
End form70.
Section form71.
Axiom deriv_zero_endpoints_eq_Icc : forall f : set -> set , forall a b :e R , a < b -> continuous_on f (Icc a b) -> differentiable_on f (Ioo a b) -> (forall c :e Ioo a b , deriv_at f (Icc a b) c 0) -> f a = f b.
Axiom Ioo_subinterval_subq : forall a b :e R , forall x y :e R , a <= x -> y <= b -> Ioo x y c= Ioo a b.
Axiom Icc_subinterval_subq : forall a b :e R , forall x y :e R , a <= x -> y <= b -> Icc x y c= Icc a b.
Axiom Icc_subq_Ioo_of_inner_bounds : forall a b x y :e R , a < x -> y < b -> Icc x y c= Ioo a b.
Axiom continuous_at_subq : forall f : set -> set , forall S T c , T c= S -> c :e T -> continuous_at f S c -> continuous_at f T c.
Axiom continuous_on_subq : forall f : set -> set , forall S T , T c= S -> continuous_on f S -> continuous_on f T.
Axiom continuous_on_Ioo_imp_continuous_on_Icc_inner : forall f : set -> set , forall a b x y :e R , a < x -> y < b -> continuous_on f (Ioo a b) -> continuous_on f (Icc x y).
Axiom cluster_point_Ioo : forall a b :e R , forall c :e Ioo a b , cluster_point (Ioo a b) c.
Axiom cluster_point_superset : forall S T c , T c= S -> cluster_point T c -> cluster_point S c.
Axiom cluster_point_Icc_left : forall a b :e R , a < b -> cluster_point (Icc a b) a.
Axiom cluster_point_Icc_right : forall a b :e R , a < b -> cluster_point (Icc a b) b.
Axiom cluster_point_Icc : forall a b :e R , a < b -> forall c :e Icc a b , cluster_point (Icc a b) c.
Axiom seq_func_limit_subq : forall g : set -> set , forall S T c L , T c= S -> seq_func_limit g S c L -> cluster_point T c -> seq_func_limit g T c L.
Axiom seq_func_limit_congr : forall f g : set -> set , forall S c L , (forall x :e S , g x = f x) -> seq_func_limit f S c L -> seq_func_limit g S c L.
Axiom deriv_at_congr : forall f g : set -> set , forall I c L , (forall x :e I , g x = f x) -> deriv_at f I c L -> deriv_at g I c L.
Axiom deriv_at_subq : forall f : set -> set , forall S T c L , T c= S -> c :e T -> cluster_point T c -> deriv_at f S c L -> deriv_at f T c L.
Axiom differentiable_on_subinterval_Ioo : forall f : set -> set , forall a b :e R , forall x y :e R , a <= x -> y <= b -> differentiable_on f (Ioo a b) -> differentiable_on f (Ioo x y).
Axiom deriv_zero_const_Icc : forall f : set -> set , forall a b :e R , a < b -> continuous_on f (Icc a b) -> differentiable_on f (Ioo a b) -> (forall c :e Ioo a b , deriv_at f (Ioo a b) c 0) -> forall x y :e Icc a b , f x = f y.
End form71.
Section form72.
Definition increasing_on : (set -> set) -> set -> prop := fun f I => forall x :e I , forall y :e I , x < y -> f x <= f y.
Definition decreasing_on : (set -> set) -> set -> prop := fun f I => forall x :e I , forall y :e I , x < y -> f y <= f x.
Definition strictly_increasing_on : (set -> set) -> set -> prop := fun f I => forall x :e I , forall y :e I , x < y -> f x < f y.
Definition strictly_decreasing_on : (set -> set) -> set -> prop := fun f I => forall x :e I , forall y :e I , x < y -> f y < f x.
Axiom deriv_nonneg_imp_increasing_Icc : forall f : set -> set , forall a b :e R , a < b -> continuous_on f (Icc a b) -> differentiable_on f (Ioo a b) -> (forall x y :e Icc a b , x < y -> forall c :e Ioo x y , forall L :e R , deriv_at f (Icc x y) c L -> 0 <= L) -> increasing_on f (Icc a b).
Axiom deriv_nonpos_imp_decreasing_Icc : forall f : set -> set , forall a b :e R , a < b -> continuous_on f (Icc a b) -> differentiable_on f (Ioo a b) -> (forall x y :e Icc a b , x < y -> forall c :e Ioo x y , forall L :e R , deriv_at f (Icc x y) c L -> L <= 0) -> decreasing_on f (Icc a b).
End form72.
Section form73.
Axiom deriv_pos_imp_strictly_increasing_Icc : forall f : set -> set , forall a b :e R , a < b -> continuous_on f (Icc a b) -> differentiable_on f (Ioo a b) -> (forall x y :e Icc a b , x < y -> forall c :e Ioo x y , forall L :e R , deriv_at f (Icc x y) c L -> 0 < L) -> strictly_increasing_on f (Icc a b).
Axiom deriv_neg_imp_strictly_decreasing_Icc : forall f : set -> set , forall a b :e R , a < b -> continuous_on f (Icc a b) -> differentiable_on f (Ioo a b) -> (forall x y :e Icc a b , x < y -> forall c :e Ioo x y , forall L :e R , deriv_at f (Icc x y) c L -> L < 0) -> strictly_decreasing_on f (Icc a b).
End form73.
Section form74.
Axiom dec_inc_min_Icc : forall f : set -> set , forall a b c :e R , a <= c -> c <= b -> decreasing_on f (Icc a c) -> increasing_on f (Icc c b) -> forall x :e Icc a b , f c <= f x.
Axiom inc_dec_max_Icc : forall f : set -> set , forall a b c :e R , a <= c -> c <= b -> increasing_on f (Icc a c) -> decreasing_on f (Icc c b) -> forall x :e Icc a b , f x <= f c.
Axiom first_derivative_test_min_Icc : forall f : set -> set , forall a b c :e R , a < c -> c < b -> continuous_on f (Icc a c) -> continuous_on f (Icc c b) -> differentiable_on f (Ioo a c) -> differentiable_on f (Ioo c b) -> (forall x y :e Icc a c , x < y -> forall d :e Ioo x y , forall L :e R , deriv_at f (Icc x y) d L -> L <= 0) -> (forall x y :e Icc c b , x < y -> forall d :e Ioo x y , forall L :e R , deriv_at f (Icc x y) d L -> 0 <= L) -> forall x :e Icc a b , f c <= f x.
Axiom first_derivative_test_max_Icc : forall f : set -> set , forall a b c :e R , a < c -> c < b -> continuous_on f (Icc a c) -> continuous_on f (Icc c b) -> differentiable_on f (Ioo a c) -> differentiable_on f (Ioo c b) -> (forall x y :e Icc a c , x < y -> forall d :e Ioo x y , forall L :e R , deriv_at f (Icc x y) d L -> 0 <= L) -> (forall x y :e Icc c b , x < y -> forall d :e Ioo x y , forall L :e R , deriv_at f (Icc x y) d L -> L <= 0) -> forall x :e Icc a b , f x <= f c.
End form74.
Section form75.
Axiom differentiable_on_imp_continuous_on : forall f : set -> set , forall I : set , differentiable_on f I -> continuous_on f I.
Axiom eps_shift_seq_limit_0 : forall M :e omega , seq_limit (fun n => eps_ (add_nat M n)) 0.
Axiom deriv_at_pos_exists_right_Icc : forall f : set -> set , forall a b :e R , forall L :e R , a < b -> deriv_at f (Icc a b) a L -> 0 < L -> exists x :e Icc a b , a < x /\ f a < f x.
Axiom deriv_at_neg_exists_left_Icc : forall f : set -> set , forall a b :e R , forall L :e R , a < b -> deriv_at f (Icc a b) b L -> L < 0 -> exists x :e Icc a b , x < b /\ f b < f x.
Axiom darboux_thm_Icc : forall f : set -> set , forall a b :e R , forall y :e R , a < b -> differentiable_on f (Icc a b) -> forall La Lb :e R , deriv_at f (Icc a b) a La -> deriv_at f (Icc a b) b Lb -> (La < y /\ y < Lb) \/ (y < La /\ Lb < y) -> exists c :e Ioo a b , deriv_at f (Icc a b) c y.
End form75.
Section form76.
Axiom continuous_on_Icc_imp_bounded_fun : forall f : set -> set , forall a b :e R , a <= b -> continuous_on f (Icc a b) -> bounded_fun (Icc a b) f.
Axiom seq_limit_of_pointwise_eq : forall x y : set -> set , forall l , seq_limit x l -> (forall n :e omega , y n = x n) -> seq_limit y l.
Axiom seq_limit_eventually_ge_of_lt_limit : forall x : set -> set , forall l m :e R , seq_limit x l -> m < l -> exists N :e omega , forall n :e omega , N <= n -> m <= x n.
Axiom seq_limit_eventually_le_of_limit_lt : forall x : set -> set , forall l m :e R , seq_limit x l -> l < m -> exists N :e omega , forall n :e omega , N <= n -> x n <= m.
Axiom seq_limit_of_eq_on_tail : forall x y : set -> set , forall l , seq_limit x l -> R_seq y -> (exists N0 :e omega , forall n :e omega , N0 <= n -> y n = x n) -> seq_limit y l.
Axiom seq_limit_neg_rev : forall x : set -> set , forall a , R_seq x -> seq_limit (seq_neg x) a -> seq_limit x (- a).
Axiom seq_limit_le : forall x y : set -> set , forall a b , seq_limit x a -> seq_limit y b -> eventually_le x y -> a <= b.
Axiom eventually_le_of_pointwise_le : forall x y : set -> set , (forall n :e omega , x n <= y n) -> eventually_le x y.
Axiom seq_limit_le_all : forall x y : set -> set , forall a b , seq_limit x a -> seq_limit y b -> (forall n :e omega , x n <= y n) -> a <= b.
Axiom seq_limit_nonneg : forall x : set -> set , forall a , seq_limit x a -> (forall n :e omega , 0 <= x n) -> 0 <= a.
Axiom inv_spec_of_witness : forall X , forall f : set -> set , forall y u , u :e X -> f u = y -> inv X f y :e X /\ f (inv X f y) = y.
Axiom inv_spec_of_mem_fimage : forall f : set -> set , forall I , forall y :e fimage f I , inv I f y :e I /\ f (inv I f y) = y.
Axiom IccI : forall a b x :e R , a <= x -> x <= b -> x :e Icc a b.
Definition is_partition_Icc : set -> set -> set -> prop := fun a b P => a :e R /\ b :e R /\ a <= b /\ finite P /\ P c= Icc a b /\ a :e P /\ b :e P.
Axiom partition_Icc_nonempty : forall a b P , is_partition_Icc a b P -> nonempty P.
Axiom partition_Icc_subq : forall a b P , is_partition_Icc a b P -> P c= Icc a b.
Axiom partition_Icc_elim_memR : forall a b P , is_partition_Icc a b P -> forall x :e P , x :e R.
Axiom partition_Icc_elim_finite : forall a b P , is_partition_Icc a b P -> finite P.
Axiom partition_Icc_adjoin : forall a b P , is_partition_Icc a b P -> forall x :e Icc a b , is_partition_Icc a b (P :\/: {x}).
Definition is_partition_seq_Icc : set -> set -> set -> (set -> set) -> prop := fun a b n p => nat_p n /\ a :e R /\ b :e R /\ a <= b /\ (forall i :e ordsucc n , p i :e R) /\ p 0 = a /\ p n = b /\ (forall i :e n , p i < p (ordsucc i)).
Axiom is_partition_seq_IccI_components : forall a b n , forall p : set -> set , nat_p n -> a :e R -> b :e R -> a <= b -> (forall i :e ordsucc n , p i :e R) -> p 0 = a -> p n = b -> (forall i :e n , p i < p (ordsucc i)) -> is_partition_seq_Icc a b n p.
Axiom partition_seq_endpoints : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> p 0 = a /\ p n = b.
Axiom is_partition_seq_Icc_elim_nat_p : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> nat_p n.
Axiom is_partition_seq_Icc_elim_valsR : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> forall i :e ordsucc n , p i :e R.
Axiom is_partition_seq_Icc_elim_strict : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> forall i :e n , p i < p (ordsucc i).
Definition nat_sub_witness : set -> set -> set := fun n m => Eps_i (fun k => nat_p k /\ m = add_nat k n).
Axiom nat_sub_witness_spec : forall n , nat_p n -> forall m , nat_p m -> n c= m -> nat_p (nat_sub_witness n m) /\ m = add_nat (nat_sub_witness n m) n.
Axiom nat_sub_witness_self_eq_0 : forall n , nat_p n -> nat_sub_witness n n = 0.
Axiom nat_sub_witness_eq_of_add : forall n k , nat_p n -> nat_p k -> nat_sub_witness n (add_nat k n) = k.
Axiom add_nat_succ_swap : forall n k , nat_p n -> nat_p k -> add_nat n (ordsucc k) = add_nat k (ordsucc n).
Axiom add_nat_succ_0R : forall n , nat_p n -> add_nat n (ordsucc 0) = ordsucc n.
Axiom nat_sub_witness_shift_succ : forall n k , nat_p n -> nat_p k -> nat_sub_witness (ordsucc n) (add_nat n (ordsucc k)) = k.
Axiom add_nat_succ_not_in_ordsucc : forall n k , nat_p n -> nat_p k -> ~ (add_nat n (ordsucc k) :e ordsucc n).
Axiom add_nat_succ_mem_ordsucc_imp_mem : forall n k m , nat_p n -> nat_p k -> nat_p m -> add_nat n (ordsucc k) :e ordsucc (add_nat n m) -> k :e m.
Axiom nat_sub_witness_in_omega : forall n m , nat_p n -> nat_p m -> n c= m -> nat_sub_witness n m :e omega.
Definition concat_partition_seq_fun : set -> (set -> set) -> set -> (set -> set) -> (set -> set) := fun n p m q => fun i => if i :e ordsucc n then p i else q (ordsucc (nat_sub_witness (ordsucc n) i)).
Axiom concat_partition_seq_fun_left : forall n m , nat_p n -> nat_p m -> forall p q : set -> set , forall i :e ordsucc n , concat_partition_seq_fun n p m q i = p i.
Axiom concat_partition_seq_fun_0 : forall n , nat_p n -> forall m , nat_p m -> forall p q : set -> set , concat_partition_seq_fun n p m q 0 = p 0.
Axiom concat_partition_seq_fun_n : forall n , nat_p n -> forall m , nat_p m -> forall p q : set -> set , concat_partition_seq_fun n p m q n = p n.
Axiom concat_partition_seq_fun_succ_n : forall n , nat_p n -> forall m , nat_p m -> forall p q : set -> set , concat_partition_seq_fun n p m q (ordsucc n) = q (ordsucc 0).
Axiom concat_partition_seq_fun_shift_succ : forall n k , nat_p n -> nat_p k -> forall m , nat_p m -> forall p q : set -> set , concat_partition_seq_fun n p m q (add_nat n (ordsucc k)) = q (ordsucc k).
Axiom mem_ordsucc_add_nat_decomp : forall n m , nat_p n -> nat_p m -> forall i :e ordsucc (add_nat n m) , i :e ordsucc n \/ exists k :e m , i = add_nat n (ordsucc k).
Axiom nat_sub_witness_mem_m_of_index : forall n m , nat_p n -> nat_p m -> forall i :e ordsucc (add_nat n m) , ~ (i :e ordsucc n) -> nat_sub_witness (ordsucc n) i :e m.
Axiom concat_partition_seq_fun_left_succ : forall n , nat_p n -> forall m , nat_p m -> forall p q : set -> set , forall i :e n , concat_partition_seq_fun n p m q (ordsucc i) = p (ordsucc i).
Axiom concat_partition_seq_fun_shift_succ_succ : forall n k , nat_p n -> nat_p k -> forall m , nat_p m -> forall p q : set -> set , concat_partition_seq_fun n p m q (ordsucc (add_nat n (ordsucc k))) = q (ordsucc (ordsucc k)).
Axiom concat_is_partition_seq_Icc : forall a b c :e R , a <= b -> b <= c -> forall n m , nat_p n -> nat_p m -> forall p q : set -> set , is_partition_seq_Icc a b n p -> is_partition_seq_Icc b c m q -> is_partition_seq_Icc a c (add_nat n m) (concat_partition_seq_fun n p m q).
Definition part_Icc : (set -> set) -> set -> set := fun p i => Icc (p i) (p (ordsucc i)).
Definition delta_part : (set -> set) -> set -> set := fun p i => (p (ordsucc i)) + (- (p i)).
Definition darboux_term_lower : (set -> set) -> (set -> set) -> set -> set := fun f p i => (inf_on f (part_Icc p i)) * (delta_part p i).
Definition darboux_term_upper : (set -> set) -> (set -> set) -> set -> set := fun f p i => (sup_on f (part_Icc p i)) * (delta_part p i).
Definition darboux_sum_lower_seq : (set -> set) -> set -> (set -> set) -> set := fun f n p => partial_sum_seq (fun i : set => darboux_term_lower f p i) n.
Definition darboux_sum_upper_seq : (set -> set) -> set -> (set -> set) -> set := fun f n p => partial_sum_seq (fun i : set => darboux_term_upper f p i) n.
Axiom darboux_term_lower_concat_left : forall n , nat_p n -> forall m , nat_p m -> forall f : set -> set , forall p q : set -> set , forall i :e n , darboux_term_lower f (concat_partition_seq_fun n p m q) i = darboux_term_lower f p i.
Axiom darboux_term_upper_concat_left : forall n , nat_p n -> forall m , nat_p m -> forall f : set -> set , forall p q : set -> set , forall i :e n , darboux_term_upper f (concat_partition_seq_fun n p m q) i = darboux_term_upper f p i.
Axiom darboux_term_lower_concat_shift_succ : forall n k , nat_p n -> nat_p k -> forall m , nat_p m -> forall f : set -> set , forall p q : set -> set , darboux_term_lower f (concat_partition_seq_fun n p m q) (add_nat n (ordsucc k)) = darboux_term_lower f q (ordsucc k).
Axiom darboux_term_upper_concat_shift_succ : forall n k , nat_p n -> nat_p k -> forall m , nat_p m -> forall f : set -> set , forall p q : set -> set , darboux_term_upper f (concat_partition_seq_fun n p m q) (add_nat n (ordsucc k)) = darboux_term_upper f q (ordsucc k).
Axiom darboux_term_lower_concat_n : forall n , nat_p n -> forall m , nat_p m -> forall f : set -> set , forall p q : set -> set , p n = q 0 -> darboux_term_lower f (concat_partition_seq_fun n p m q) n = darboux_term_lower f q 0.
Axiom darboux_term_upper_concat_n : forall n , nat_p n -> forall m , nat_p m -> forall f : set -> set , forall p q : set -> set , p n = q 0 -> darboux_term_upper f (concat_partition_seq_fun n p m q) n = darboux_term_upper f q 0.
Axiom darboux_term_lower_concat_add_nat : forall n m , nat_p n -> nat_p m -> forall f : set -> set , forall p q : set -> set , p n = q 0 -> forall j :e m , darboux_term_lower f (concat_partition_seq_fun n p m q) (add_nat n j) = darboux_term_lower f q j.
Axiom darboux_term_upper_concat_add_nat : forall n m , nat_p n -> nat_p m -> forall f : set -> set , forall p q : set -> set , p n = q 0 -> forall j :e m , darboux_term_upper f (concat_partition_seq_fun n p m q) (add_nat n j) = darboux_term_upper f q j.
Axiom darboux_term_lower_closed : forall a b n , forall f p : set -> set , is_partition_seq_Icc a b n p -> bounded_fun (Icc a b) f -> forall i :e n , darboux_term_lower f p i :e R.
Axiom darboux_term_upper_closed : forall a b n , forall f p : set -> set , is_partition_seq_Icc a b n p -> bounded_fun (Icc a b) f -> forall i :e n , darboux_term_upper f p i :e R.
Axiom darboux_sum_lower_seq_concat_split : forall a b c :e R , a <= b -> b <= c -> forall n m , nat_p n -> nat_p m -> forall f : set -> set , forall p q : set -> set , bounded_fun (Icc a c) f -> is_partition_seq_Icc a b n p -> is_partition_seq_Icc b c m q -> darboux_sum_lower_seq f (add_nat n m) (concat_partition_seq_fun n p m q) = darboux_sum_lower_seq f n p + darboux_sum_lower_seq f m q.
Axiom darboux_sum_upper_seq_concat_split : forall a b c :e R , a <= b -> b <= c -> forall n m , nat_p n -> nat_p m -> forall f : set -> set , forall p q : set -> set , bounded_fun (Icc a c) f -> is_partition_seq_Icc a b n p -> is_partition_seq_Icc b c m q -> darboux_sum_upper_seq f (add_nat n m) (concat_partition_seq_fun n p m q) = darboux_sum_upper_seq f n p + darboux_sum_upper_seq f m q.
Definition partition_refines_Icc : set -> set -> set -> set -> prop := fun a b P Q => is_partition_Icc a b P /\ is_partition_Icc a b Q /\ P c= Q.
Axiom partition_refines_Icc_refl : forall a b P , is_partition_Icc a b P -> partition_refines_Icc a b P P.
Axiom partition_refines_Icc_adjoin : forall a b P , is_partition_Icc a b P -> forall x :e Icc a b , partition_refines_Icc a b P (P :\/: {x}).
Axiom partition_refines_Icc_trans : forall a b P Q R , partition_refines_Icc a b P Q -> partition_refines_Icc a b Q R -> partition_refines_Icc a b P R.
Axiom bounded_fun_Subq : forall D E , forall f : set -> set , E c= D -> bounded_fun D f -> bounded_fun E f.
Axiom bounded_fun_Icc_subinterval : forall a b x y :e R , a <= x -> y <= b -> forall f : set -> set , bounded_fun (Icc a b) f -> bounded_fun (Icc x y) f.
Axiom R_Le_refl : forall x :e R , x <= x.
Axiom inf_on_le_value : forall D , forall f : set -> set , nonempty D -> bounded_fun D f -> forall x :e D , inf_on f D <= f x.
Axiom value_le_sup_on : forall D , forall f : set -> set , nonempty D -> bounded_fun D f -> forall x :e D , f x <= sup_on f D.
Axiom delta_part_pos : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> forall i :e n , 0 < delta_part p i.
Axiom partition_seq_elim_basic : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> nat_p n /\ (forall j :e ordsucc n , p j :e R) /\ (forall j :e n , p j < p (ordsucc j)).
Axiom partition_seq_points_in_R : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> forall i :e ordsucc n , p i :e R.
Axiom concat_partition_seq_fun_closed : forall a b c :e R , a <= b -> b <= c -> forall n m , nat_p n -> nat_p m -> forall p q : set -> set , is_partition_seq_Icc a b n p -> is_partition_seq_Icc b c m q -> forall i :e ordsucc (add_nat n m) , concat_partition_seq_fun n p m q i :e R.
Axiom delta_part_real : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> forall i :e n , delta_part p i :e R.
Axiom partial_sum_seq_delta_part_eq : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> forall k :e ordsucc n , partial_sum_seq (fun i => delta_part p i) k = p k + (- (p 0)).
Axiom partial_sum_seq_tail_delta_part_eq : forall a b m , forall q : set -> set , is_partition_seq_Icc a b m q -> forall j0 j1 :e ordsucc m , j0 :e j1 -> forall k :e omega , j1 = add_nat j0 k -> partial_sum_seq (tail_series (fun t => delta_part q t) j0) k = q j1 + (- (q j0)).
Axiom nat_add_decomp_of_mem : forall m , nat_p m -> forall j0 j1 :e ordsucc m , j0 :e j1 -> exists k :e omega , j1 = add_nat j0 k.
Axiom part_Icc_nonempty : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> forall i :e n , nonempty (part_Icc p i).
Axiom strict_finseq_mem_imp_lt : forall n , nat_p n -> forall p : set -> set , (forall j :e ordsucc n , p j :e R) -> (forall j :e n , p j < p (ordsucc j)) -> forall i j :e ordsucc n , i :e j -> p i < p j.
Axiom strict_finseq_0_Le : forall n , nat_p n -> forall p : set -> set , (forall j :e ordsucc n , p j :e R) -> (forall j :e n , p j < p (ordsucc j)) -> forall i :e ordsucc n , p 0 <= p i.
Axiom strict_finseq_Le_last : forall n , nat_p n -> forall p : set -> set , (forall j :e ordsucc n , p j :e R) -> (forall j :e n , p j < p (ordsucc j)) -> forall i :e ordsucc n , p i <= p n.
Axiom strict_finseq_inj : forall n , nat_p n -> forall p : set -> set , (forall j :e ordsucc n , p j :e R) -> (forall j :e n , p j < p (ordsucc j)) -> forall i j :e ordsucc n , p i = p j -> i = j.
Axiom strict_finseq_lt_imp_mem : forall n , nat_p n -> forall p : set -> set , (forall j :e ordsucc n , p j :e R) -> (forall j :e n , p j < p (ordsucc j)) -> forall i j :e ordsucc n , p i < p j -> i :e j.
Axiom part_Icc_subq_Icc : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> forall i :e n , part_Icc p i c= Icc a b.
Axiom inf_on_ge_of_pointwise_ge : forall D , forall f : set -> set , forall m :e R , nonempty D -> bounded_fun D f -> (forall x :e D , m <= f x) -> m <= inf_on f D.
Axiom sup_on_le_of_pointwise_le : forall D , forall f : set -> set , forall M :e R , nonempty D -> bounded_fun D f -> (forall x :e D , f x <= M) -> sup_on f D <= M.
Axiom inf_on_Le_sup_on : forall D , forall f : set -> set , nonempty D -> bounded_fun D f -> inf_on f D <= sup_on f D.
Axiom sup_on_le_of_pointwise_abs_le : forall D , forall f : set -> set , forall M :e R , nonempty D -> bounded_fun D f -> (forall x :e D , abs_SNo (f x) <= M) -> sup_on f D <= M.
Axiom neg_bound_le_inf_on_of_pointwise_abs_le : forall D , forall f : set -> set , forall M :e R , nonempty D -> bounded_fun D f -> (forall x :e D , abs_SNo (f x) <= M) -> (- M) <= inf_on f D.
Axiom osc_on_Le_of_pointwise_abs_le : forall D , forall f : set -> set , forall M :e R , nonempty D -> bounded_fun D f -> (forall x :e D , abs_SNo (f x) <= M) -> (sup_on f D) + (- (inf_on f D)) <= M + M.
Axiom inf_on_mono_Subq : forall D E , forall f : set -> set , nonempty D -> nonempty E -> D c= E -> bounded_fun E f -> inf_on f E <= inf_on f D.
Axiom sup_on_mono_Subq : forall D E , forall f : set -> set , nonempty D -> nonempty E -> D c= E -> bounded_fun E f -> sup_on f D <= sup_on f E.
Axiom fimage_eq_of_pointwise_eq : forall D , forall f g : set -> set , (forall x :e D , f x = g x) -> fimage f D = fimage g D.
Axiom sup_on_eq_of_pointwise_eq : forall D , forall f g : set -> set , (forall x :e D , f x = g x) -> sup_on f D = sup_on g D.
Axiom inf_on_eq_of_pointwise_eq : forall D , forall f g : set -> set , (forall x :e D , f x = g x) -> inf_on f D = inf_on g D.
Axiom darboux_term_lower_Le_upper : forall a b n , forall f p : set -> set , is_partition_seq_Icc a b n p -> bounded_fun (Icc a b) f -> forall i :e n , darboux_term_lower f p i <= darboux_term_upper f p i.
Axiom darboux_term_gap_nonneg : forall a b n , forall f p : set -> set , is_partition_seq_Icc a b n p -> bounded_fun (Icc a b) f -> forall i :e n , 0 <= (darboux_term_upper f p i) + (- (darboux_term_lower f p i)).
Axiom darboux_sum_lower_Le_upper_seq : forall a b n , forall f p : set -> set , is_partition_seq_Icc a b n p -> bounded_fun (Icc a b) f -> darboux_sum_lower_seq f n p <= darboux_sum_upper_seq f n p.
Definition partition_seq_refines_Icc : set -> set -> set -> (set -> set) -> set -> (set -> set) -> prop := fun a b n p m q => is_partition_seq_Icc a b n p /\ is_partition_seq_Icc a b m q /\ (forall i :e ordsucc n , exists j :e ordsucc m , p i = q j).
Axiom partition_seq_refines_endpoints_order : forall a b n m , forall p q : set -> set , partition_seq_refines_Icc a b n p m q -> forall i :e n , exists j0 :e ordsucc m , exists j1 :e ordsucc m , p i = q j0 /\ p (ordsucc i) = q j1 /\ j0 :e j1.
Axiom part_Icc_refine_block_subq : forall a b n m , forall p q : set -> set , is_partition_seq_Icc a b n p -> is_partition_seq_Icc a b m q -> forall i :e n , forall j0 :e ordsucc m , forall j1 :e ordsucc m , p i = q j0 -> p (ordsucc i) = q j1 -> j0 :e j1 -> forall j :e m , j0 :e ordsucc j -> ordsucc j :e ordsucc j1 -> part_Icc q j c= part_Icc p i.
Axiom inf_on_refine_block_Le : forall a b n m , forall f p q : set -> set , is_partition_seq_Icc a b n p -> is_partition_seq_Icc a b m q -> bounded_fun (Icc a b) f -> forall i :e n , forall j0 :e ordsucc m , forall j1 :e ordsucc m , p i = q j0 -> p (ordsucc i) = q j1 -> j0 :e j1 -> forall j :e m , j0 :e ordsucc j -> ordsucc j :e ordsucc j1 -> inf_on f (part_Icc p i) <= inf_on f (part_Icc q j).
Axiom sup_on_refine_block_Le : forall a b n m , forall f p q : set -> set , is_partition_seq_Icc a b n p -> is_partition_seq_Icc a b m q -> bounded_fun (Icc a b) f -> forall i :e n , forall j0 :e ordsucc m , forall j1 :e ordsucc m , p i = q j0 -> p (ordsucc i) = q j1 -> j0 :e j1 -> forall j :e m , j0 :e ordsucc j -> ordsucc j :e ordsucc j1 -> sup_on f (part_Icc q j) <= sup_on f (part_Icc p i).
Axiom partition_seq_refines_points_Subq : forall a b n m , forall p q : set -> set , partition_seq_refines_Icc a b n p m q -> {p i|i :e ordsucc n} c= {q j|j :e ordsucc m}.
Axiom partition_seq_refines_Icc_refl : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> partition_seq_refines_Icc a b n p n p.
Axiom partition_seq_refines_Icc_trans : forall a b n m k , forall p q r : set -> set , partition_seq_refines_Icc a b n p m q -> partition_seq_refines_Icc a b m q k r -> partition_seq_refines_Icc a b n p k r.
Axiom darboux_term_lower_refine_block_Le : forall a b n m , forall f p q : set -> set , partition_seq_refines_Icc a b n p m q -> bounded_fun (Icc a b) f -> forall i :e n , forall j0 :e ordsucc m , forall j1 :e ordsucc m , p i = q j0 -> p (ordsucc i) = q j1 -> j0 :e j1 -> forall k :e omega , j1 = add_nat j0 k -> darboux_term_lower f p i <= partial_sum_seq (tail_series (fun t => darboux_term_lower f q t) j0) k.
Axiom darboux_term_upper_refine_block_Le : forall a b n m , forall f p q : set -> set , partition_seq_refines_Icc a b n p m q -> bounded_fun (Icc a b) f -> forall i :e n , forall j0 :e ordsucc m , forall j1 :e ordsucc m , p i = q j0 -> p (ordsucc i) = q j1 -> j0 :e j1 -> forall k :e omega , j1 = add_nat j0 k -> partial_sum_seq (tail_series (fun t => darboux_term_upper f q t) j0) k <= darboux_term_upper f p i.
Axiom darboux_sum_refinement_monotone_seq : forall a b n m , forall f p q : set -> set , partition_seq_refines_Icc a b n p m q -> bounded_fun (Icc a b) f -> darboux_sum_lower_seq f n p <= darboux_sum_lower_seq f m q /\ darboux_sum_upper_seq f m q <= darboux_sum_upper_seq f n p.
Definition lower_darboux_sums_Icc : set -> set -> (set -> set) -> set := fun a b f => {s :e R|exists n :e omega , exists p : set -> set , is_partition_seq_Icc a b n p /\ s = darboux_sum_lower_seq f n p}.
Definition upper_darboux_sums_Icc : set -> set -> (set -> set) -> set := fun a b f => {s :e R|exists n :e omega , exists p : set -> set , is_partition_seq_Icc a b n p /\ s = darboux_sum_upper_seq f n p}.
Definition lower_darboux_integral_Icc : set -> set -> (set -> set) -> set := fun a b f => sup (lower_darboux_sums_Icc a b f).
Definition upper_darboux_integral_Icc : set -> set -> (set -> set) -> set := fun a b f => inf (upper_darboux_sums_Icc a b f).
Definition riemann_integrable_Icc : set -> set -> (set -> set) -> prop := fun a b f => bounded_fun (Icc a b) f /\ lower_darboux_integral_Icc a b f = upper_darboux_integral_Icc a b f.
Definition riemann_integral_Icc : set -> set -> (set -> set) -> set := fun a b f => lower_darboux_integral_Icc a b f.
Definition partition_seq_points : set -> (set -> set) -> set := fun n p => {p i|i :e ordsucc n}.
Axiom partition_seq_pointsI : forall n , forall p : set -> set , forall i :e ordsucc n , p i :e partition_seq_points n p.
Axiom partition_seq_pointsE : forall n , forall p : set -> set , forall y , y :e partition_seq_points n p -> exists i :e ordsucc n , y = p i.
Axiom nat_mem_ne0_imp_succ : forall n , nat_p n -> forall j :e n , j <> 0 -> exists j0 :e n , j = ordsucc j0.
Axiom part_Icc_mem_left_endpoint : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> forall i :e n , p i :e part_Icc p i.
Axiom part_Icc_mem_right_endpoint : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> forall i :e n , p (ordsucc i) :e part_Icc p i.
Axiom part_Icc_mem_of_left_endpoint_imp_eq0 : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> forall i :e n , p 0 :e part_Icc p i -> i = 0.
Axiom part_Icc_mem_of_right_endpoint_imp_eq_last : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> forall i :e n , p n :e part_Icc p i -> ordsucc i = n.
Axiom partition_seq_points_lt_imp_exists_indices_mem : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> forall u v , u :e partition_seq_points n p -> v :e partition_seq_points n p -> u < v -> exists i0 :e ordsucc n , exists i1 :e ordsucc n , p i0 = u /\ p i1 = v /\ i0 :e i1.
Axiom partition_seq_refines_of_points_Subq : forall a b n m , forall p q : set -> set , is_partition_seq_Icc a b n p -> is_partition_seq_Icc a b m q -> partition_seq_points n p c= partition_seq_points m q -> partition_seq_refines_Icc a b n p m q.
Axiom partition_seq_points_Subq_of_refines : forall a b n m , forall p q : set -> set , partition_seq_refines_Icc a b n p m q -> partition_seq_points n p c= partition_seq_points m q.
Axiom partition_seq_pointsE_in_n_of_neq_right_endpoint : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> forall x , x :e partition_seq_points n p -> x <> p n -> exists i :e n , x = p i.
Axiom partition_seq_pointsE_index_ne0_of_neq_left_endpoint : forall n , forall p : set -> set , forall x , x :e partition_seq_points n p -> x <> p 0 -> exists i :e ordsucc n , x = p i /\ i <> 0.
Axiom partition_seq_pointsE_in_n_ne0_of_neq_endpoints : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> forall x , x :e partition_seq_points n p -> x <> p 0 -> x <> p n -> exists i :e n , x = p i /\ i <> 0.
Axiom darboux_sum_lower_seq_closed : forall a b n , forall f p : set -> set , is_partition_seq_Icc a b n p -> bounded_fun (Icc a b) f -> darboux_sum_lower_seq f n p :e R.
Axiom darboux_sum_upper_seq_closed : forall a b n , forall f p : set -> set , is_partition_seq_Icc a b n p -> bounded_fun (Icc a b) f -> darboux_sum_upper_seq f n p :e R.
Axiom lower_darboux_sums_IccE : forall a b :e R , a <= b -> forall f : set -> set , forall s :e lower_darboux_sums_Icc a b f , exists n :e omega , exists p : set -> set , is_partition_seq_Icc a b n p /\ s = darboux_sum_lower_seq f n p.
Axiom lower_darboux_sums_IccI : forall a b :e R , a <= b -> forall f : set -> set , bounded_fun (Icc a b) f -> forall n :e omega , forall p : set -> set , is_partition_seq_Icc a b n p -> darboux_sum_lower_seq f n p :e lower_darboux_sums_Icc a b f.
Axiom upper_darboux_sums_IccE : forall a b :e R , a <= b -> forall f : set -> set , forall s :e upper_darboux_sums_Icc a b f , exists n :e omega , exists p : set -> set , is_partition_seq_Icc a b n p /\ s = darboux_sum_upper_seq f n p.
Axiom upper_darboux_sums_IccI : forall a b :e R , a <= b -> forall f : set -> set , bounded_fun (Icc a b) f -> forall n :e omega , forall p : set -> set , is_partition_seq_Icc a b n p -> darboux_sum_upper_seq f n p :e upper_darboux_sums_Icc a b f.
Axiom darboux_term_lower_eq_of_pointwise_eq_Icc : forall a b n , forall f g p : set -> set , is_partition_seq_Icc a b n p -> (forall x :e Icc a b , f x = g x) -> forall i :e n , darboux_term_lower f p i = darboux_term_lower g p i.
Axiom darboux_term_lower_eq_of_eq_off_singleton_Icc : forall a b n , forall f g p : set -> set , is_partition_seq_Icc a b n p -> forall c :e Icc a b , (forall x :e Icc a b , x <> c -> f x = g x) -> forall i :e n , c /:e part_Icc p i -> darboux_term_lower f p i = darboux_term_lower g p i.
Axiom darboux_term_upper_eq_of_pointwise_eq_Icc : forall a b n , forall f g p : set -> set , is_partition_seq_Icc a b n p -> (forall x :e Icc a b , f x = g x) -> forall i :e n , darboux_term_upper f p i = darboux_term_upper g p i.
Axiom darboux_term_upper_eq_of_eq_off_singleton_Icc : forall a b n , forall f g p : set -> set , is_partition_seq_Icc a b n p -> forall c :e Icc a b , (forall x :e Icc a b , x <> c -> f x = g x) -> forall i :e n , c /:e part_Icc p i -> darboux_term_upper f p i = darboux_term_upper g p i.
Axiom darboux_sum_lower_seq_eq_of_pointwise_eq_Icc : forall a b n , forall f g p : set -> set , is_partition_seq_Icc a b n p -> (forall x :e Icc a b , f x = g x) -> darboux_sum_lower_seq f n p = darboux_sum_lower_seq g n p.
Axiom darboux_sum_upper_seq_eq_of_pointwise_eq_Icc : forall a b n , forall f g p : set -> set , is_partition_seq_Icc a b n p -> (forall x :e Icc a b , f x = g x) -> darboux_sum_upper_seq f n p = darboux_sum_upper_seq g n p.
Axiom lower_darboux_sums_Icc_eq_of_pointwise_eq : forall a b :e R , a <= b -> forall f g : set -> set , bounded_fun (Icc a b) f -> (forall x :e Icc a b , f x = g x) -> lower_darboux_sums_Icc a b f = lower_darboux_sums_Icc a b g.
Axiom upper_darboux_sums_Icc_eq_of_pointwise_eq : forall a b :e R , a <= b -> forall f g : set -> set , bounded_fun (Icc a b) f -> (forall x :e Icc a b , f x = g x) -> upper_darboux_sums_Icc a b f = upper_darboux_sums_Icc a b g.
Axiom lower_darboux_integral_Icc_eq_of_pointwise_eq : forall a b :e R , a <= b -> forall f g : set -> set , bounded_fun (Icc a b) f -> (forall x :e Icc a b , f x = g x) -> lower_darboux_integral_Icc a b f = lower_darboux_integral_Icc a b g.
Axiom upper_darboux_integral_Icc_eq_of_pointwise_eq : forall a b :e R , a <= b -> forall f g : set -> set , bounded_fun (Icc a b) f -> (forall x :e Icc a b , f x = g x) -> upper_darboux_integral_Icc a b f = upper_darboux_integral_Icc a b g.
Axiom riemann_integrable_Icc_of_pointwise_eq : forall a b :e R , a <= b -> forall f g : set -> set , riemann_integrable_Icc a b f -> (forall x :e Icc a b , f x = g x) -> riemann_integrable_Icc a b g /\ riemann_integral_Icc a b g = riemann_integral_Icc a b f.
Axiom partition_seq_points_finite : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> finite (partition_seq_points n p).
Axiom partition_seq_points_mem_0 : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> p 0 :e partition_seq_points n p.
Axiom partition_seq_points_mem_n : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> p n :e partition_seq_points n p.
Axiom concat_partition_seq_fun_last : forall a b c :e R , forall n m , forall p q : set -> set , is_partition_seq_Icc a c n p -> is_partition_seq_Icc c b m q -> concat_partition_seq_fun n p m q (add_nat n m) = b.
Axiom partition_seq_points_subq_Icc : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> partition_seq_points n p c= Icc a b.
Axiom partition_seq_points_is_partition_Icc : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> is_partition_Icc a b (partition_seq_points n p).
Axiom partition_seq_points_adjoin_is_partition_Icc : forall a c n , forall p : set -> set , is_partition_seq_Icc a c n p -> forall b :e Icc a c , is_partition_Icc a c (partition_seq_points n p :\/: {b}).
Axiom partition_Icc_mem_bounds : forall a b P , is_partition_Icc a b P -> forall x :e P , a <= x /\ x <= b.
Axiom partition_Icc_all_SNo : forall a b P , is_partition_Icc a b P -> forall x :e P , SNo x.
Axiom partition_Icc_a_is_min_of : forall a b P , is_partition_Icc a b P -> SNo_min_of P a.
Axiom partition_Icc_b_is_max_of : forall a b P , is_partition_Icc a b P -> SNo_max_of P b.
Axiom partition_Icc_min_eq_a : forall a b P , is_partition_Icc a b P -> forall x , SNo_min_of P x -> x = a.
Axiom partition_Icc_max_eq_b : forall a b P , is_partition_Icc a b P -> forall x , SNo_max_of P x -> x = b.
Axiom partition_Icc_min_exists : forall a b P , is_partition_Icc a b P -> exists x , SNo_min_of P x.
Axiom partition_Icc_max_exists : forall a b P , is_partition_Icc a b P -> exists x , SNo_max_of P x.
Axiom equip_SNo_set_strict_enum : forall n , nat_p n -> forall X , (forall x :e X , SNo x) -> equip X (ordsucc n) -> X <> 0 -> exists p : set -> set , ((forall i :e ordsucc n , p i :e X) /\ (forall i :e n , p i < p (ordsucc i)) /\ (forall x :e X , exists i :e ordsucc n , p i = x)) /\ SNo_min_of X (p 0) /\ SNo_max_of X (p n).
Axiom exists_partition_seq_of_partition_Icc : forall a b P , is_partition_Icc a b P -> exists n :e omega , exists p : set -> set , is_partition_seq_Icc a b n p /\ partition_seq_points n p = P.
Axiom exists_partition_seq_Icc_refining_adjoin_point : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> forall c :e Icc a b , exists m :e omega , exists q : set -> set , partition_seq_refines_Icc a b n p m q /\ c :e partition_seq_points m q.
Axiom exists_partition_seq_Icc_refining_adjoin_two_points : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> forall c1 :e Icc a b , forall c2 :e Icc a b , exists m :e omega , exists q : set -> set , partition_seq_refines_Icc a b n p m q /\ c1 :e partition_seq_points m q /\ c2 :e partition_seq_points m q.
End form76.
Section form77.
Axiom R_fun_subq : forall D E , forall f : set -> set , R_fun D f -> E c= D -> R_fun E f.
Axiom bounded_fun_subq : forall D E , forall f : set -> set , bounded_fun D f -> E c= D -> bounded_fun E f.
Axiom bounded_fun_part_Icc : forall a b n , forall p : set -> set , forall f : set -> set , is_partition_seq_Icc a b n p -> bounded_fun (Icc a b) f -> forall i :e n , bounded_fun (part_Icc p i) f.
Axiom bounded_fun_add : forall D , forall f g : set -> set , bounded_fun D f -> bounded_fun D g -> bounded_fun D (fun x => (f x) + (g x)).
Axiom bounded_fun_scale : forall D , forall f : set -> set , bounded_fun D f -> forall alpha :e R , bounded_fun D (fun x => alpha * (f x)).
Axiom inf_on_add_Le : forall D , nonempty D -> forall f g : set -> set , bounded_fun D f -> bounded_fun D g -> (inf_on f D) + (inf_on g D) <= inf_on (fun x => (f x) + (g x)) D.
Axiom sup_on_add_Le : forall D , nonempty D -> forall f g : set -> set , bounded_fun D f -> bounded_fun D g -> sup_on (fun x => (f x) + (g x)) D <= (sup_on f D) + (sup_on g D).
Definition add_set : set -> set -> set := fun A B => (\/_ a :e A , add_const_set a B).
Axiom SNoLe_eq_substR : forall x y z , SNo x -> SNo y -> SNo z -> x = y -> z <= x -> z <= y.
Axiom sup_add_set : forall A B , A c= R -> B c= R -> has_lub A -> has_lub B -> sup (add_set A B) = (sup A) + (sup B).
Axiom inf_add_set : forall A B , A c= R -> B c= R -> nonempty A -> nonempty B -> has_glb A -> has_glb B -> inf (add_set A B) = (inf A) + (inf B).
Axiom sup_mono_Subq : forall S T , S c= T -> has_lub S -> has_lub T -> sup S <= sup T.
Axiom inf_mono_Subq : forall S T , S c= T -> has_glb S -> has_glb T -> inf T <= inf S.
Axiom sup_eq_of_dominating_subset : forall A B , A c= R -> B c= A -> has_lub A -> has_lub B -> (forall x :e A , exists y :e B , x <= y) -> sup B = sup A.
Axiom inf_eq_of_dominating_subset : forall A B , A c= R -> B c= A -> has_glb A -> has_glb B -> (forall x :e A , exists y :e B , y <= x) -> inf B = inf A.
Axiom darboux_sum_lower_seq_scale_neg : forall a b n , forall f p : set -> set , is_partition_seq_Icc a b n p -> bounded_fun (Icc a b) f -> forall alpha :e R , alpha < 0 -> darboux_sum_lower_seq (fun x => alpha * (f x)) n p = alpha * (darboux_sum_upper_seq f n p).
Axiom darboux_sum_upper_seq_scale_neg : forall a b n , forall f p : set -> set , is_partition_seq_Icc a b n p -> bounded_fun (Icc a b) f -> forall alpha :e R , alpha < 0 -> darboux_sum_upper_seq (fun x => alpha * (f x)) n p = alpha * (darboux_sum_lower_seq f n p).
Axiom lower_darboux_sums_Icc_add_set_Subq_concat : forall a b c :e R , a <= b -> b <= c -> forall f : set -> set , bounded_fun (Icc a c) f -> add_set (lower_darboux_sums_Icc a b f) (lower_darboux_sums_Icc b c f) c= lower_darboux_sums_Icc a c f.
Axiom lower_darboux_sum_lower_seq_mem_add_set_of_contains_b : forall a b c :e R , a <= b -> b <= c -> forall f : set -> set , bounded_fun (Icc a c) f -> forall m :e omega , forall q : set -> set , is_partition_seq_Icc a c m q -> b :e partition_seq_points m q -> darboux_sum_lower_seq f m q :e add_set (lower_darboux_sums_Icc a b f) (lower_darboux_sums_Icc b c f).
Axiom upper_darboux_sum_upper_seq_mem_add_set_of_contains_b : forall a b c :e R , a <= b -> b <= c -> forall f : set -> set , bounded_fun (Icc a c) f -> forall m :e omega , forall q : set -> set , is_partition_seq_Icc a c m q -> b :e partition_seq_points m q -> darboux_sum_upper_seq f m q :e add_set (upper_darboux_sums_Icc a b f) (upper_darboux_sums_Icc b c f).
Axiom lower_darboux_sums_Icc_dominated_by_add_set_adjoin : forall a b c :e R , a <= b -> b <= c -> forall f : set -> set , bounded_fun (Icc a c) f -> forall s :e lower_darboux_sums_Icc a c f , exists t :e add_set (lower_darboux_sums_Icc a b f) (lower_darboux_sums_Icc b c f) , s <= t.
Axiom upper_darboux_sums_Icc_add_set_Subq_concat : forall a b c :e R , a <= b -> b <= c -> forall f : set -> set , bounded_fun (Icc a c) f -> add_set (upper_darboux_sums_Icc a b f) (upper_darboux_sums_Icc b c f) c= upper_darboux_sums_Icc a c f.
Axiom upper_darboux_sums_Icc_dominated_by_add_set_adjoin : forall a b c :e R , a <= b -> b <= c -> forall f : set -> set , bounded_fun (Icc a c) f -> forall s :e upper_darboux_sums_Icc a c f , exists t :e add_set (upper_darboux_sums_Icc a b f) (upper_darboux_sums_Icc b c f) , t <= s.
Axiom add_set_subq_R : forall A B , A c= R -> B c= R -> add_set A B c= R.
Axiom add_set_nonempty : forall A B , nonempty A -> nonempty B -> nonempty (add_set A B).
Axiom add_set_bounded_above : forall A B , A c= R -> B c= R -> bounded_above A -> bounded_above B -> bounded_above (add_set A B).
Axiom add_set_bounded_below : forall A B , A c= R -> B c= R -> bounded_below A -> bounded_below B -> bounded_below (add_set A B).
Axiom has_lub_add_set : forall A B , A c= R -> B c= R -> nonempty A -> nonempty B -> bounded_above A -> bounded_above B -> has_lub (add_set A B).
Axiom has_glb_add_set : forall A B , A c= R -> B c= R -> nonempty A -> nonempty B -> bounded_below A -> bounded_below B -> has_glb (add_set A B).
Axiom fimage_scale : forall D , forall f : set -> set , forall alpha :e R , fimage (fun x => alpha * (f x)) D = mul_const_set alpha (fimage f D).
Axiom sup_on_scale_pos : forall D , nonempty D -> forall f : set -> set , bounded_fun D f -> forall alpha :e R , 0 < alpha -> sup_on (fun x => alpha * (f x)) D = alpha * (sup_on f D).
Axiom inf_on_scale_pos : forall D , nonempty D -> forall f : set -> set , bounded_fun D f -> forall alpha :e R , 0 < alpha -> inf_on (fun x => alpha * (f x)) D = alpha * (inf_on f D).
Axiom sup_on_scale_neg : forall D , nonempty D -> forall f : set -> set , bounded_fun D f -> forall alpha :e R , alpha < 0 -> sup_on (fun x => alpha * (f x)) D = alpha * (inf_on f D).
Axiom inf_on_scale_neg : forall D , nonempty D -> forall f : set -> set , bounded_fun D f -> forall alpha :e R , alpha < 0 -> inf_on (fun x => alpha * (f x)) D = alpha * (sup_on f D).
Axiom darboux_term_lower_scale_pos : forall a b n , forall f p : set -> set , is_partition_seq_Icc a b n p -> bounded_fun (Icc a b) f -> forall alpha :e R , 0 < alpha -> forall i :e n , darboux_term_lower (fun x => alpha * (f x)) p i = alpha * (darboux_term_lower f p i).
