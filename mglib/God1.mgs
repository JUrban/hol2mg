Definition Pi_SNo : (set -> set) -> set -> set := fun f n => nat_primrec 1 (fun i r => r * f i) n.
Axiom Pi_SNo_0 : forall f : set -> set , Pi_SNo f 0 = 1.
Axiom Pi_SNo_S : forall f : set -> set , forall n , nat_p n -> Pi_SNo f (ordsucc n) = Pi_SNo f n * f n.
Axiom Pi_SNo_In_omega : forall f : set -> set , forall n , nat_p n -> (forall i :e n , f i :e omega) -> Pi_SNo f n :e omega.
Axiom Pi_SNo_In_int : forall f : set -> set , forall n , nat_p n -> (forall i :e n , f i :e int) -> Pi_SNo f n :e int.
Axiom divides_int_prime_nat_eq : forall p q , prime_nat p -> prime_nat q -> divides_int p q -> p = q.
Axiom Euclid_lemma_Pi_SNo : forall f : set -> set , forall p , prime_nat p -> forall n , nat_p n -> (forall i :e n , f i :e int) -> divides_int p (Pi_SNo f n) -> exists i :e n , divides_int p (f i).
