Definition god1_dependent_sigma_append_map : set -> set -> (set -> set) -> set -> set := fun N m phi t => let z := if t :e N then (0,t) else (1,nat_sub_witness N t) in if z 0 = 0 then phi (z 1) else (m,z 1).
Axiom god1_natural_sum_tail_coordinate : forall p q :e omega , forall k :e p + q , k /:e p -> nat_sub_witness p k :e q /\ k = add_nat p (nat_sub_witness p k).
Axiom god1_bijection_finite_codomain : forall X Y , forall f : set -> set , finite X -> bij X Y f -> finite Y.
Axiom god1_dependent_sigma_append_bijection : forall m :e omega , forall ell : set -> set , forall N :e omega , forall phi : set -> set , ell m :e omega -> bij N (Sigma_ j :e m , ell j) phi -> bij (N + ell m) (Sigma_ j :e ordsucc m , ell j) (god1_dependent_sigma_append_map N m phi).
