Definition is_R_function_algebra : set -> set -> prop := fun X A => A c= setexp R X /\ (forall f :e A , forall g :e A , (fun x :e X => (f x) + (g x)) :e A) /\ (forall f :e A , forall g :e A , (fun x :e X => (f x) * (g x)) :e A) /\ (forall c :e R , forall f :e A , (fun x :e X => c * (f x)) :e A).
