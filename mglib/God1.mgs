Axiom god1_group_words_universal_property : forall G , forall mul : set -> set -> set , forall B z , z :e group_words G mul B -> forall H :e Power G , subgroup G mul H -> B c= H -> z :e H.
Axiom god1_group_words_subset_generated_subgroup : forall G , forall mul : set -> set -> set , forall B , group G mul -> B c= G -> group_words G mul B c= subgroup_generated_by G mul B.
Axiom god1_s7_theorem2_generated_subgroup_words : forall G , forall mul : set -> set -> set , forall B , group G mul -> B c= G -> forall x :e G , (x :e subgroup_generated_by G mul B <-> exists p :e omega , exists f : set -> set , (forall i :e p , f i :e G /\ (f i :e B \/ group_inverse G mul (f i) :e B)) /\ x = group_word_product G mul f p).
Definition generating_set : set -> (set -> set -> set) -> set -> prop := fun G mul B => B c= G /\ subgroup_generated_by G mul B = G.
Definition finitely_generated_group : set -> (set -> set -> set) -> prop := fun G mul => group G mul /\ exists B :e Power G , finite B /\ generating_set G mul B.
Definition permutation_group : set -> set := fun X => {s :e X :^: X|bij X X (fun x => s x)}.
Definition permutation_composition : set -> set -> set -> set := fun X s t => fun x :e X => s (t x).
Definition permutation_identity : set -> set := fun X => fun x :e X => x.
Definition permutation_inverse : set -> set -> set := fun X f => fun y :e X => inv X (fun x => f x) y.
Axiom god1_permutation_function_in : forall X , forall f :e permutation_group X , f :e X :^: X.
Axiom god1_permutation_bijective : forall X , forall f :e permutation_group X , bij X X (fun x => f x).
Axiom god1_bijection_maps_into : forall X Y , forall f : set -> set , bij X Y f -> forall x :e X , f x :e Y.
Axiom god1_bijection_injective : forall X Y , forall f : set -> set , bij X Y f -> forall x y :e X , f x = f y -> x = y.
Axiom god1_bijection_surjective : forall X Y , forall f : set -> set , bij X Y f -> forall y :e Y , exists x :e X , f x = y.
Axiom god1_permutation_group_intro : forall X s , s :e X :^: X -> bij X X (fun x => s x) -> s :e permutation_group X.
Axiom god1_bounded_bijection : forall X , forall f : set -> set , bij X X f -> bij X X (fun x => (fun y :e X => f y) x).
Axiom god1_permutation_identity_values_in : forall X , forall x :e X , x :e X.
Axiom god1_permutation_identity_in : forall X , permutation_identity X :e permutation_group X.
Axiom god1_permutation_composition_values_in : forall X , forall f g :e permutation_group X , forall x :e X , f (g x) :e X.
Axiom god1_permutation_composition_bijective : forall X , forall f g :e permutation_group X , bij X X (fun x => permutation_composition X f g x).
Axiom god1_permutation_composition_in : forall X , forall f g :e permutation_group X , permutation_composition X f g :e permutation_group X.
Axiom god1_permutation_composition_law : forall X , law_of_composition (permutation_group X) (permutation_composition X).
Axiom god1_permutation_right_identity : forall X , forall f :e permutation_group X , permutation_composition X f (permutation_identity X) = f.
Axiom god1_permutation_left_identity : forall X , forall f :e permutation_group X , permutation_composition X (permutation_identity X) f = f.
Axiom god1_permutation_identity_laws : forall X , forall f :e permutation_group X , permutation_composition X f (permutation_identity X) = f /\ permutation_composition X (permutation_identity X) f = f.
Axiom god1_permutation_identity_neutral : forall X , neutral_element (permutation_group X) (permutation_composition X) (permutation_identity X).
Axiom god1_permutation_inverse_raw_values_in : forall X , forall f :e permutation_group X , forall y :e X , inv X (fun x => f x) y :e X.
Axiom god1_permutation_inverse_values_in : forall X , forall f :e permutation_group X , forall y :e X , permutation_inverse X f y :e X.
Axiom god1_permutation_inverse_in : forall X , forall f :e permutation_group X , permutation_inverse X f :e permutation_group X.
Axiom god1_permutation_inverse_left : forall X , forall f :e permutation_group X , permutation_composition X (permutation_inverse X f) f = permutation_identity X.
Axiom god1_permutation_inverse_right : forall X , forall f :e permutation_group X , permutation_composition X f (permutation_inverse X f) = permutation_identity X.
Axiom god1_permutation_inverse_reflection : forall X , forall f :e permutation_group X , reflection (permutation_group X) (permutation_composition X) (permutation_identity X) f (permutation_inverse X f).
Axiom god1_permutation_inverse_witnesses : forall X , forall f :e permutation_group X , exists g :e permutation_group X , reflection (permutation_group X) (permutation_composition X) (permutation_identity X) f g.
Axiom god1_permutation_composition_associative_components : forall X , forall f g h :e permutation_group X , permutation_composition X f (permutation_composition X g h) = permutation_composition X (permutation_composition X f g) h.
Axiom god1_permutation_composition_associative : forall X , associative_on (permutation_group X) (permutation_composition X).
Axiom god1_permutation_identity_and_inverses : forall X , exists e :e permutation_group X , neutral_element (permutation_group X) (permutation_composition X) e /\ forall f :e permutation_group X , exists g :e permutation_group X , reflection (permutation_group X) (permutation_composition X) e f g.
Axiom god1_permutations_form_group : forall X , group (permutation_group X) (permutation_composition X).
Definition permutation_swap : set -> set -> set -> set := fun X a b => fun x :e X => if x = a then b else if x = b then a else x.
Axiom god1_permutation_swap_at_left : forall X a b , a :e X -> permutation_swap X a b a = b.
Axiom god1_permutation_swap_at_right : forall X a b , a :e X -> b :e X -> permutation_swap X a b b = a.
Axiom god1_permutation_swap_at_other : forall X a b x , x :e X -> x <> a -> x <> b -> permutation_swap X a b x = x.
Axiom god1_permutation_swap_values_in : forall X a b , a :e X -> b :e X -> forall x :e X , permutation_swap X a b x :e X.
Axiom god1_permutation_swap_involutive : forall X a b , a :e X -> b :e X -> forall x :e X , permutation_swap X a b (permutation_swap X a b x) = x.
Axiom god1_permutation_swap_injective : forall X a b , a :e X -> b :e X -> forall x y :e X , permutation_swap X a b x = permutation_swap X a b y -> x = y.
Axiom god1_permutation_swap_surjective : forall X a b , a :e X -> b :e X -> forall y :e X , exists x :e X , permutation_swap X a b x = y.
Axiom god1_permutation_swap_bijective : forall X a b , a :e X -> b :e X -> bij X X (fun x => permutation_swap X a b x).
Axiom god1_permutation_swap_raw_values_in : forall X a b , a :e X -> b :e X -> forall x :e X , (if x = a then b else if x = b then a else x) :e X.
Axiom god1_permutation_swap_function_in : forall X a b , a :e X -> b :e X -> permutation_swap X a b :e X :^: X.
Axiom god1_permutation_swap_in : forall X a b , a :e X -> b :e X -> permutation_swap X a b :e permutation_group X.
Definition adjacent_transposition : set -> set -> prop := fun n t => n :e omega /\ t :e permutation_group n /\ exists i :e n , ordsucc i :e n /\ t i = ordsucc i /\ t (ordsucc i) = i /\ (forall k :e n , k <> i -> k <> ordsucc i -> t k = k).
Definition adjacent_transpositions : set -> set := fun n => {t :e permutation_group n|adjacent_transposition n t}.
Axiom god1_adjacent_transpositions_intro : forall n t , t :e permutation_group n -> adjacent_transposition n t -> t :e adjacent_transpositions n.
Axiom god1_adjacent_transpositions_elim_member : forall n , forall t :e adjacent_transpositions n , t :e permutation_group n.
Axiom god1_adjacent_transpositions_elim_property : forall n , forall t :e adjacent_transpositions n , adjacent_transposition n t.
Axiom god1_permutation_swap_adjacent_property : forall n i , nat_p n -> i :e n -> ordsucc i :e n -> adjacent_transposition n (permutation_swap n i (ordsucc i)).
Axiom god1_permutation_swap_adjacent_in : forall n i , nat_p n -> i :e n -> ordsucc i :e n -> permutation_swap n i (ordsucc i) :e adjacent_transpositions n.
Axiom god1_adjacent_transposition_has_swap_index : forall n t , adjacent_transposition n t -> exists i :e n , ordsucc i :e n /\ t = permutation_swap n i (ordsucc i).
Axiom god1_permutation_swap_square_identity : forall X a b , a :e X -> b :e X -> permutation_composition X (permutation_swap X a b) (permutation_swap X a b) = permutation_identity X.
Axiom god1_permutation_group_identity_eq : forall X , group_identity (permutation_group X) (permutation_composition X) = permutation_identity X.
Axiom god1_adjacent_transposition_square_identity : forall n , forall t :e adjacent_transpositions n , permutation_composition n t t = group_identity (permutation_group n) (permutation_composition n).
Axiom god1_adjacent_transposition_inverse_eq : forall n , forall t :e adjacent_transpositions n , group_inverse (permutation_group n) (permutation_composition n) t = t.
Definition permutation_extend_last : set -> set -> set := fun n f => fun k :e ordsucc n => if k :e n then f k else n.
Definition permutation_restrict_last : set -> set -> set := fun n f => fun k :e n => f k.
Axiom god1_permutation_extend_last_prefix : forall n , forall f : set , forall k :e n , permutation_extend_last n f k = f k.
Axiom god1_permutation_extend_last_at_last : forall n , nat_p n -> forall f : set , permutation_extend_last n f n = n.
Axiom god1_permutation_extend_last_values_in : forall n , nat_p n -> forall f :e permutation_group n , forall k :e ordsucc n , permutation_extend_last n f k :e ordsucc n.
Axiom god1_permutation_extend_last_injective : forall n , nat_p n -> forall f :e permutation_group n , forall k l :e ordsucc n , permutation_extend_last n f k = permutation_extend_last n f l -> k = l.
Axiom god1_permutation_extend_last_surjective : forall n , nat_p n -> forall f :e permutation_group n , forall w :e ordsucc n , exists k :e ordsucc n , permutation_extend_last n f k = w.
Axiom god1_permutation_extend_last_raw_values_in : forall n , nat_p n -> forall f :e permutation_group n , forall k :e ordsucc n , (if k :e n then f k else n) :e ordsucc n.
Axiom god1_permutation_extend_last_function_in : forall n , nat_p n -> forall f :e permutation_group n , permutation_extend_last n f :e ordsucc n :^: ordsucc n.
Axiom god1_permutation_extend_last_bijective : forall n , nat_p n -> forall f :e permutation_group n , bij (ordsucc n) (ordsucc n) (fun k => permutation_extend_last n f k).
Axiom god1_permutation_extend_last_in : forall n , nat_p n -> forall f :e permutation_group n , permutation_extend_last n f :e permutation_group (ordsucc n).
Axiom god1_permutation_extend_last_identity : forall n , nat_p n -> permutation_extend_last n (permutation_identity n) = permutation_identity (ordsucc n).
Axiom god1_permutation_extend_last_composition : forall n , nat_p n -> forall f g :e permutation_group n , permutation_extend_last n (permutation_composition n f g) = permutation_composition (ordsucc n) (permutation_extend_last n f) (permutation_extend_last n g).
Axiom god1_nat_member_ne_self : forall n , nat_p n -> forall k :e n , n <> k.
Axiom god1_permutation_extend_last_swap : forall n , nat_p n -> forall a b :e n , permutation_extend_last n (permutation_swap n a b) = permutation_swap (ordsucc n) a b.
Axiom god1_adjacent_transposition_extend_last_in : forall n , nat_p n -> forall t :e adjacent_transpositions n , permutation_extend_last n t :e adjacent_transpositions (ordsucc n).
Axiom god1_permutation_restrict_last_prefix : forall n , forall f : set , forall k :e n , permutation_restrict_last n f k = f k.
Axiom god1_permutation_restrict_last_raw_values_in : forall n , nat_p n -> forall u :e permutation_group (ordsucc n) , u n = n -> forall k :e n , u k :e n.
Axiom god1_permutation_restrict_last_values_in : forall n , nat_p n -> forall u :e permutation_group (ordsucc n) , u n = n -> forall k :e n , permutation_restrict_last n u k :e n.
Axiom god1_permutation_restrict_last_injective : forall n , nat_p n -> forall u :e permutation_group (ordsucc n) , u n = n -> forall k l :e n , permutation_restrict_last n u k = permutation_restrict_last n u l -> k = l.
Axiom god1_permutation_restrict_last_surjective : forall n , nat_p n -> forall u :e permutation_group (ordsucc n) , u n = n -> forall w :e n , exists k :e n , permutation_restrict_last n u k = w.
Axiom god1_permutation_restrict_last_function_in : forall n , nat_p n -> forall u :e permutation_group (ordsucc n) , u n = n -> permutation_restrict_last n u :e n :^: n.
Axiom god1_permutation_restrict_last_bijective : forall n , nat_p n -> forall u :e permutation_group (ordsucc n) , u n = n -> bij n n (fun k => permutation_restrict_last n u k).
Axiom god1_permutation_restrict_last_in : forall n , nat_p n -> forall u :e permutation_group (ordsucc n) , u n = n -> permutation_restrict_last n u :e permutation_group n.
Axiom god1_permutation_extend_restrict_last : forall n , nat_p n -> forall u :e permutation_group (ordsucc n) , u n = n -> permutation_extend_last n (permutation_restrict_last n u) = u.
Axiom god1_group_word_letter_adjacent_is_adjacent : forall n f , group_word_letter (permutation_group n) (permutation_composition n) (adjacent_transpositions n) f -> f :e adjacent_transpositions n.
Axiom god1_permutation_extend_last_group_identity : forall n , nat_p n -> permutation_extend_last n (group_identity (permutation_group n) (permutation_composition n)) = group_identity (permutation_group (ordsucc n)) (permutation_composition (ordsucc n)).
Axiom god1_permutation_extend_word_zero : forall n , nat_p n -> forall f : set -> set , permutation_extend_last n (group_word_product (permutation_group n) (permutation_composition n) f 0) = group_word_product (permutation_group (ordsucc n)) (permutation_composition (ordsucc n)) (fun i => permutation_extend_last n (f i)) 0.
Axiom god1_permutation_extend_word_zero_imp : forall n , nat_p n -> forall f : set -> set , (forall i :e 0 , f i :e permutation_group n) -> permutation_extend_last n (group_word_product (permutation_group n) (permutation_composition n) f 0) = group_word_product (permutation_group (ordsucc n)) (permutation_composition (ordsucc n)) (fun i => permutation_extend_last n (f i)) 0.
Axiom god1_permutation_word_members_prefix : forall n , forall f : set -> set , forall p , (forall i :e ordsucc p , f i :e permutation_group n) -> forall i :e p , f i :e permutation_group n.
Axiom god1_permutation_extend_word_step : forall n , nat_p n -> forall f : set -> set , forall p , nat_p p -> ((forall i :e p , f i :e permutation_group n) -> permutation_extend_last n (group_word_product (permutation_group n) (permutation_composition n) f p) = group_word_product (permutation_group (ordsucc n)) (permutation_composition (ordsucc n)) (fun i => permutation_extend_last n (f i)) p) -> (forall i :e ordsucc p , f i :e permutation_group n) -> permutation_extend_last n (group_word_product (permutation_group n) (permutation_composition n) f (ordsucc p)) = group_word_product (permutation_group (ordsucc n)) (permutation_composition (ordsucc n)) (fun i => permutation_extend_last n (f i)) (ordsucc p).
Axiom god1_permutation_extend_word : forall n , nat_p n -> forall f : set -> set , forall p , nat_p p -> (forall i :e p , f i :e permutation_group n) -> permutation_extend_last n (group_word_product (permutation_group n) (permutation_composition n) f p) = group_word_product (permutation_group (ordsucc n)) (permutation_composition (ordsucc n)) (fun i => permutation_extend_last n (f i)) p.
