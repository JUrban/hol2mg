Axiom uniformly_bounded_fun_seq_eval_in_complex : forall X , forall fn : set -> set , uniformly_bounded_fun_seq X fn -> forall c :e X , forall n :e omega , (fn n) c :e complex.
Axiom pointwise_bounded_fun_seq_subseq : forall X , forall fn gn : set -> set , pointwise_bounded_fun_seq X fn -> subseq_of fn gn -> pointwise_bounded_fun_seq X gn.
Axiom uniformly_bounded_fun_seq_subseq : forall X , forall fn gn : set -> set , uniformly_bounded_fun_seq X fn -> subseq_of fn gn -> uniformly_bounded_fun_seq X gn.
Axiom subseq_of_maps_to_setexp : forall X , forall Y , forall fn gn : set -> set , (forall n :e omega , fn n :e setexp Y X) -> subseq_of fn gn -> forall n :e omega , gn n :e setexp Y X.
Definition pointwise_bounds_uniformizable : set -> (set -> set) -> set -> prop := fun X fn S => S c= X -> (forall c :e S , exists M :e R , forall n :e omega , modulus_CSNo ((fn n) c) <= M) -> exists B :e R , forall c :e S , forall n :e omega , modulus_CSNo ((fn n) c) <= B.
Axiom pointwise_bounds_uniformizable_Empty : forall X , forall fn : set -> set , pointwise_bounds_uniformizable X fn Empty.
Axiom pointwise_bounds_uniformizable_adjoin : forall X , forall fn : set -> set , (forall n :e omega , fn n :e setexp complex X) -> forall S y , finite S -> y /:e S -> pointwise_bounds_uniformizable X fn S -> pointwise_bounds_uniformizable X fn (S :\/: {y}).
Axiom finite_pointwise_bounds_imp_uniform_bound : forall X , forall fn : set -> set , forall F , (forall n :e omega , fn n :e setexp complex X) -> F c= X -> finite F -> (forall c :e F , exists M :e R , forall n :e omega , modulus_CSNo ((fn n) c) <= M) -> exists B :e R , forall c :e F , forall n :e omega , modulus_CSNo ((fn n) c) <= B.
Definition ms_equicontinuous_on : set -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> (set -> set) -> prop := fun X dX Y dY K fn => K c= X /\ (forall n :e omega , fn n :e setexp Y X) /\ forall eps :e R , 0 < eps -> exists delta :e R , 0 < delta /\ forall n :e omega , forall x :e K , forall y :e K , dX x y < delta -> dY ((fn n) x) ((fn n) y) < eps.
Axiom ms_equicontinuous_on_subq : forall X , forall dX : set -> set -> set , forall Y , forall dY : set -> set -> set , forall K , forall fn : set -> set , ms_equicontinuous_on X dX Y dY K fn -> K c= X.
