Axiom god1_finite_sum_of_alternating_trilinear_mappings : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall U , forall g : set -> set -> set , commutative_ring K addK mulK -> left_module K addK mulK X addX smulX -> left_module K addK mulK M addM smulM -> finite U -> (forall t :e U , alternating_trilinear_mapping K addK mulK X addX smulX M addM smulM (g t)) -> alternating_trilinear_mapping K addK mulK X addX smulX M addM smulM (fun z => ring_finite_sum M addM U (fun t => g t z)).
Axiom god1_determinant_basis_triple_coordinate_is_exterior_product : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall n :e omega , forall a : set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX n a -> forall i j k :e n , forall x y z :e X , determinant_3 K addK mulK (basis_triple_coordinate_matrix K addK mulK X addX smulX n a i j k x y z) = ap (exterior_product_three_linear_forms K addK mulK X (basis_coordinate_function K addK mulK X addX smulX n a i) (basis_coordinate_function K addK mulK X addX smulX n a j) (basis_coordinate_function K addK mulK X addX smulX n a k)) (trilinear_tuple x y z).
Axiom god1_basis_triple_coordinate_determinant_is_alternating : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall n :e omega , forall a : set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX n a -> forall i j k :e n , alternating_trilinear_mapping K addK mulK X addX smulX K addK mulK (fun q => determinant_3 K addK mulK (basis_triple_coordinate_matrix K addK mulK X addX smulX n a i j k (q 0) (q 1) (q 2))).
Axiom god1_basis_coordinate_triple_product_delta_raw : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall n , forall a : set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX n a -> forall i j k r s u :e n , mulK (basis_coordinates K addK mulK X addX smulX n a (a r) i) (mulK (basis_coordinates K addK mulK X addX smulX n a (a s) j) (basis_coordinates K addK mulK X addX smulX n a (a u) k)) = if i = r /\ j = s /\ k = u then ring_one K mulK else ring_zero K addK.
Axiom god1_s22_determinant_basis_coordinate_delta : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall n , forall a : set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX n a -> forall i j k r s u :e n , determinant_3 K addK mulK (basis_triple_coordinate_matrix K addK mulK X addX smulX n a i j k (a r) (a s) (a u)) = addK (addK (if i = r /\ j = s /\ k = u then ring_one K mulK else ring_zero K addK) (if j = r /\ k = s /\ i = u then ring_one K mulK else ring_zero K addK)) (addK (if k = r /\ i = s /\ j = u then ring_one K mulK else ring_zero K addK) (addK (ring_negation K addK (if i = r /\ k = s /\ j = u then ring_one K mulK else ring_zero K addK)) (addK (ring_negation K addK (if j = r /\ i = s /\ k = u then ring_one K mulK else ring_zero K addK)) (ring_negation K addK (if k = r /\ j = s /\ i = u then ring_one K mulK else ring_zero K addK))))).
Axiom god1_ring_six_term_first_only : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x :e K , add (add x (ring_zero K add)) (add (ring_zero K add) (add (ring_negation K add (ring_zero K add)) (add (ring_negation K add (ring_zero K add)) (ring_negation K add (ring_zero K add))))) = x.
Axiom god1_s22_determinant_delta_for_increasing_triples : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall n :e omega , forall a : set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX n a -> forall i j k r s u :e n , i :e j -> j :e k -> r :e s -> s :e u -> determinant_3 K addK mulK (basis_triple_coordinate_matrix K addK mulK X addX smulX n a i j k (a r) (a s) (a u)) = if i = r /\ j = s /\ k = u then ring_one K mulK else ring_zero K addK.
Axiom god1_s22_increasing_triple_determinant_sum_at_basis : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall n :e omega , forall a : set -> set , forall c : set -> set -> set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX n a -> left_module K addK mulK M addM smulM -> (forall i j k :e n , c i j k :e M) -> forall r s u :e n , r :e s -> s :e u -> module_finitely_supported_sum M addM {t :e n :*: (n :*: n)|t 0 :e t 1 0 /\ t 1 0 :e t 1 1} (fun t => smulM (determinant_3 K addK mulK (basis_triple_coordinate_matrix K addK mulK X addX smulX n a (t 0) (t 1 0) (t 1 1) (a r) (a s) (a u))) (c (t 0) (t 1 0) (t 1 1))) = c r s u.
Axiom god1_s22_increasing_triple_determinant_ring_sum_is_alternating : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall n :e omega , forall a : set -> set , forall c : set -> set -> set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX n a -> left_module K addK mulK M addM smulM -> (forall i j k :e n , c i j k :e M) -> alternating_trilinear_mapping K addK mulK X addX smulX M addM smulM (fun q => ring_finite_sum M addM {t :e n :*: (n :*: n)|t 0 :e t 1 0 /\ t 1 0 :e t 1 1} (fun t => smulM (determinant_3 K addK mulK (basis_triple_coordinate_matrix K addK mulK X addX smulX n a (t 0) (t 1 0) (t 1 1) (q 0) (q 1) (q 2))) (c (t 0) (t 1 0) (t 1 1)))).
Axiom god1_s22_increasing_triple_determinant_ring_sum_at_basis : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall n :e omega , forall a : set -> set , forall c : set -> set -> set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX n a -> left_module K addK mulK M addM smulM -> (forall i j k :e n , c i j k :e M) -> forall r s u :e n , r :e s -> s :e u -> ring_finite_sum M addM {t :e n :*: (n :*: n)|t 0 :e t 1 0 /\ t 1 0 :e t 1 1} (fun t => smulM (determinant_3 K addK mulK (basis_triple_coordinate_matrix K addK mulK X addX smulX n a (t 0) (t 1 0) (t 1 1) (a r) (a s) (a u))) (c (t 0) (t 1 0) (t 1 1))) = c r s u.
Axiom god1_alternating_trilinear_maps_equal_on_increasing_basis : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall n :e omega , forall a : set -> set , forall f g : set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX n a -> left_module K addK mulK M addM smulM -> alternating_trilinear_mapping K addK mulK X addX smulX M addM smulM f -> alternating_trilinear_mapping K addK mulK X addX smulX M addM smulM g -> (forall i j k :e n , i :e j -> j :e k -> f (trilinear_tuple (a i) (a j) (a k)) = g (trilinear_tuple (a i) (a j) (a k))) -> forall i j k :e n , f (trilinear_tuple (a i) (a j) (a k)) = g (trilinear_tuple (a i) (a j) (a k)).
Axiom god1_trilinear_maps_equal_on_basis_triples : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall n :e omega , forall a : set -> set , forall f g : set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX n a -> left_module K addK mulK M addM smulM -> trilinear_mapping K addK mulK X addX smulX X addX smulX X addX smulX M addM smulM f -> trilinear_mapping K addK mulK X addX smulX X addX smulX X addX smulX M addM smulM g -> (forall i j k :e n , f (trilinear_tuple (a i) (a j) (a k)) = g (trilinear_tuple (a i) (a j) (a k))) -> forall x y z :e X , f (trilinear_tuple x y z) = g (trilinear_tuple x y z).
Axiom god1_basis_triple_coordinate_determinant_trilinear_tuple_eval : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall n , forall a : set -> set , forall i j k x y z , (fun q : set => determinant_3 K addK mulK (basis_triple_coordinate_matrix K addK mulK X addX smulX n a i j k (q 0) (q 1) (q 2))) (trilinear_tuple x y z) = determinant_3 K addK mulK (basis_triple_coordinate_matrix K addK mulK X addX smulX n a i j k x y z).
Axiom god1_basis_triple_coordinate_determinant_maps_into : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall n :e omega , forall a : set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX n a -> forall i j k :e n , forall x y z :e X , determinant_3 K addK mulK (basis_triple_coordinate_matrix K addK mulK X addX smulX n a i j k x y z) :e K.
Axiom god1_s22_increasing_triple_determinant_module_sum_finite_conversion : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall n :e omega , forall a : set -> set , forall c : set -> set -> set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX n a -> left_module K addK mulK M addM smulM -> (forall i j k :e n , c i j k :e M) -> forall x y z :e X , module_finitely_supported_sum M addM {t :e n :*: (n :*: n)|t 0 :e t 1 0 /\ t 1 0 :e t 1 1} (fun t => smulM (determinant_3 K addK mulK (basis_triple_coordinate_matrix K addK mulK X addX smulX n a (t 0) (t 1 0) (t 1 1) x y z)) (c (t 0) (t 1 0) (t 1 1))) = ring_finite_sum M addM {t :e n :*: (n :*: n)|t 0 :e t 1 0 /\ t 1 0 :e t 1 1} (fun t => smulM (determinant_3 K addK mulK (basis_triple_coordinate_matrix K addK mulK X addX smulX n a (t 0) (t 1 0) (t 1 1) x y z)) (c (t 0) (t 1 0) (t 1 1))).
Axiom god1_s22_theorem2_alternating_trilinear_coefficients : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall n :e omega , forall a : set -> set , forall f : set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX n a -> left_module K addK mulK M addM smulM -> trilinear_mapping K addK mulK X addX smulX X addX smulX X addX smulX M addM smulM f -> (alternating_trilinear_mapping K addK mulK X addX smulX M addM smulM f <-> (forall i j :e n , f (trilinear_tuple (a i) (a j) (a j)) = module_zero M addM /\ f (trilinear_tuple (a i) (a j) (a i)) = module_zero M addM /\ f (trilinear_tuple (a i) (a i) (a j)) = module_zero M addM) /\ forall i j k :e n , f (trilinear_tuple (a i) (a j) (a k)) = f (trilinear_tuple (a j) (a k) (a i)) /\ f (trilinear_tuple (a i) (a j) (a k)) = f (trilinear_tuple (a k) (a i) (a j)) /\ f (trilinear_tuple (a i) (a j) (a k)) = module_negation M addM (f (trilinear_tuple (a i) (a k) (a j)))) /\ (alternating_trilinear_mapping K addK mulK X addX smulX M addM smulM f -> forall x y z :e X , f (trilinear_tuple x y z) = module_finitely_supported_sum M addM {t :e n :*: (n :*: n)|t 0 :e t 1 0 /\ t 1 0 :e t 1 1} (fun t => smulM (determinant_3 K addK mulK (basis_triple_coordinate_matrix K addK mulK X addX smulX n a (t 0) (t 1 0) (t 1 1) x y z)) (f (trilinear_tuple (a (t 0)) (a (t 1 0)) (a (t 1 1)))))).
Definition permutation_inversion_set : set -> set -> set := fun p sigma => {u :e p :*: p|u 0 :e u 1 /\ sigma (u 1) :e sigma (u 0)}.
Definition permutation_signature : set -> set -> set := fun p sigma => if exists k :e omega , finite_cardinality (permutation_inversion_set p sigma) = 2 * k then 1 else minus_SNo 1.
Definition permuted_tuple : set -> set -> set -> set := fun p sigma x => fun i :e p => x (sigma i).
Definition signed_group_element : set -> (set -> set -> set) -> set -> set -> set := fun M addM sign x => if sign = 1 then x else module_negation M addM x.
Definition antisymmetric_mapping : set -> set -> (set -> set -> set) -> set -> (set -> set) -> prop := fun X M addM p f => abelian_group M addM /\ (forall x :e X :^: p , f x :e M) /\ forall tau :e adjacent_transpositions p , forall x :e X :^: p , f (permuted_tuple p tau x) = module_negation M addM (f x).
Definition natural_even : set -> prop := fun n => exists k :e omega , n = 2 * k.
Definition natural_parity_sign : set -> set := fun n => if natural_even n then 1 else minus_SNo 1.
Axiom god1_natural_even_or_successor_even : forall n :e omega , natural_even n \/ natural_even (ordsucc n).
Axiom god1_natural_even_successor_exclusive : forall n :e omega , natural_even n -> ~ natural_even (ordsucc n).
Axiom god1_natural_even_successor_iff_not : forall n :e omega , (natural_even (ordsucc n) <-> ~ natural_even n).
Axiom god1_natural_parity_sign_successor : forall n :e omega , natural_parity_sign (ordsucc n) = mul_SNo (natural_parity_sign n) (minus_SNo 1).
Axiom god1_natural_parity_sign_successor_reverse : forall n :e omega , natural_parity_sign n = mul_SNo (natural_parity_sign (ordsucc n)) (minus_SNo 1).
Axiom god1_finite_cardinality_adjoin : forall X a , finite X -> a /:e X -> finite_cardinality (X :\/: {a}) = ordsucc (finite_cardinality X).
Axiom god1_setminus_singleton_eq_self_of_not_member : forall X a , a /:e X -> X :\: {a} = X.
Axiom god1_finite_complement_equip_single_toggle_parity : forall A B d , finite A -> finite B -> equip (A :\: {d}) (B :\: {d}) -> exactly1of2 (d :e A) (d :e B) -> natural_parity_sign (finite_cardinality B) = mul_SNo (natural_parity_sign (finite_cardinality A)) (minus_SNo 1).
Axiom god1_natural_parity_sign_adjoin : forall X a , finite X -> a /:e X -> natural_parity_sign (finite_cardinality (X :\/: {a})) = mul_SNo (natural_parity_sign (finite_cardinality X)) (minus_SNo 1).
Axiom god1_membership_implies_neq : forall a b , a :e b -> a <> b.
Axiom god1_membership_transport_two_equalities : forall a b c d , a = b -> c = d -> a :e c -> b :e d.
Axiom god1_tuple_two_congr : forall a b c d , a = c -> b = d -> (a,b) = (c,d).
Definition adjacent_pair_swap : set -> set -> set -> set := fun p i u => (permutation_swap p i (ordsucc i) (u 0),permutation_swap p i (ordsucc i) (u 1)).
Axiom god1_adjacent_swap_preserves_strict_order_off_swapped_pair : forall p i , nat_p p -> i :e p -> ordsucc i :e p -> forall a b :e p , a :e b -> (a,b) <> (i,ordsucc i) -> permutation_swap p i (ordsucc i) a :e permutation_swap p i (ordsucc i) b.
Axiom god1_adjacent_pair_swap_unfold : forall p i u , adjacent_pair_swap p i u = (permutation_swap p i (ordsucc i) (u 0),permutation_swap p i (ordsucc i) (u 1)).
Axiom god1_adjacent_pair_swap_zero : forall p i u , adjacent_pair_swap p i u 0 = permutation_swap p i (ordsucc i) (u 0).
Axiom god1_adjacent_pair_swap_one : forall p i u , adjacent_pair_swap p i u 1 = permutation_swap p i (ordsucc i) (u 1).
Axiom god1_adjacent_pair_swap_in_product : forall p i , i :e p -> ordsucc i :e p -> forall u :e p :*: p , adjacent_pair_swap p i u :e p :*: p.
Axiom god1_adjacent_pair_swap_involutive : forall p i , i :e p -> ordsucc i :e p -> forall u :e p :*: p , adjacent_pair_swap p i (adjacent_pair_swap p i u) = u.
Axiom god1_adjacent_pair_swap_preserves_strict_order : forall p i , nat_p p -> i :e p -> ordsucc i :e p -> forall u :e p :*: p , u 0 :e u 1 -> u <> (i,ordsucc i) -> adjacent_pair_swap p i u 0 :e adjacent_pair_swap p i u 1.
Axiom god1_adjacent_pair_swap_distinguished_pair : forall p i , i :e p -> ordsucc i :e p -> adjacent_pair_swap p i (i,ordsucc i) = (ordsucc i,i).
Axiom god1_ordered_adjacent_pair_swap_not_distinguished : forall p i , i :e p -> ordsucc i :e p -> forall u :e p :*: p , u 0 :e u 1 -> adjacent_pair_swap p i u <> (i,ordsucc i).
Axiom god1_permutation_composition_swap_eval : forall p i , i :e p -> ordsucc i :e p -> forall sigma :e permutation_group p , forall x :e p , permutation_composition p sigma (permutation_swap p i (ordsucc i)) x = sigma (permutation_swap p i (ordsucc i) x).
Axiom god1_permutation_composition_swap_cancel : forall p i , i :e p -> ordsucc i :e p -> forall sigma :e permutation_group p , forall x :e p , permutation_composition p sigma (permutation_swap p i (ordsucc i)) (permutation_swap p i (ordsucc i) x) = sigma x.
Axiom god1_permutation_inversion_intro : forall p sigma u , u :e p :*: p -> u 0 :e u 1 -> sigma (u 1) :e sigma (u 0) -> u :e permutation_inversion_set p sigma.
Axiom god1_permutation_inversion_product_member : forall p sigma u , u :e permutation_inversion_set p sigma -> u :e p :*: p.
Axiom god1_permutation_inversion_order : forall p sigma u , u :e permutation_inversion_set p sigma -> u 0 :e u 1.
Axiom god1_permutation_inversion_comparison : forall p sigma u , u :e permutation_inversion_set p sigma -> sigma (u 1) :e sigma (u 0).
Axiom god1_adjacent_pair_swap_inversion_forward : forall p i , nat_p p -> i :e p -> ordsucc i :e p -> forall sigma :e permutation_group p , forall u :e permutation_inversion_set p sigma :\: {(i,ordsucc i)} , adjacent_pair_swap p i u :e permutation_inversion_set p (permutation_composition p sigma (permutation_swap p i (ordsucc i))) :\: {(i,ordsucc i)}.
Axiom god1_adjacent_pair_swap_inversion_reverse : forall p i , nat_p p -> i :e p -> ordsucc i :e p -> forall sigma :e permutation_group p , forall v :e permutation_inversion_set p (permutation_composition p sigma (permutation_swap p i (ordsucc i))) :\: {(i,ordsucc i)} , adjacent_pair_swap p i v :e permutation_inversion_set p sigma :\: {(i,ordsucc i)}.
Axiom god1_adjacent_pair_swap_inversion_complements_bijective : forall p i , nat_p p -> i :e p -> ordsucc i :e p -> forall sigma :e permutation_group p , bij (permutation_inversion_set p sigma :\: {(i,ordsucc i)}) (permutation_inversion_set p (permutation_composition p sigma (permutation_swap p i (ordsucc i))) :\: {(i,ordsucc i)}) (adjacent_pair_swap p i).
Axiom god1_adjacent_distinguished_inversion_iff : forall p i , i :e p -> ordsucc i :e p -> forall sigma , ((i,ordsucc i) :e permutation_inversion_set p sigma <-> sigma (ordsucc i) :e sigma i).
Axiom god1_adjacent_distinguished_composed_inversion_iff : forall p i , i :e p -> ordsucc i :e p -> forall sigma :e permutation_group p , ((i,ordsucc i) :e permutation_inversion_set p (permutation_composition p sigma (permutation_swap p i (ordsucc i))) <-> sigma i :e sigma (ordsucc i)).
Axiom god1_adjacent_distinguished_inversion_toggles : forall p i , nat_p p -> i :e p -> ordsucc i :e p -> forall sigma :e permutation_group p , exactly1of2 ((i,ordsucc i) :e permutation_inversion_set p sigma) ((i,ordsucc i) :e permutation_inversion_set p (permutation_composition p sigma (permutation_swap p i (ordsucc i)))).
Axiom god1_permutation_inversion_set_finite : forall p , nat_p p -> forall sigma , finite (permutation_inversion_set p sigma).
Axiom god1_permutation_signature_is_parity_sign : forall p sigma , permutation_signature p sigma = natural_parity_sign (finite_cardinality (permutation_inversion_set p sigma)).
Axiom god1_permutation_signature_right_adjacent_swap : forall p , nat_p p -> forall i :e p , ordsucc i :e p -> forall sigma :e permutation_group p , permutation_signature p (permutation_composition p sigma (permutation_swap p i (ordsucc i))) = mul_SNo (permutation_signature p sigma) (minus_SNo 1).
Axiom god1_permutation_signature_right_adjacent_transposition : forall p , nat_p p -> forall sigma :e permutation_group p , forall tau :e adjacent_transpositions p , permutation_signature p (permutation_composition p sigma tau) = mul_SNo (permutation_signature p sigma) (minus_SNo 1).
Axiom god1_sign_pair_cases : forall x :e {1,minus_SNo 1} , x = 1 \/ x = minus_SNo 1.
Axiom god1_sign_pair_sno : forall x :e {1,minus_SNo 1} , SNo x.
Axiom god1_sign_pair_mul_in : forall x y :e {1,minus_SNo 1} , mul_SNo x y :e {1,minus_SNo 1}.
Axiom god1_sign_pair_neutral : neutral_element {1,minus_SNo 1} mul_SNo 1.
Axiom god1_sign_pair_self_inverse : forall x :e {1,minus_SNo 1} , reflection {1,minus_SNo 1} mul_SNo 1 x x.
Axiom god1_sign_pair_group : group {1,minus_SNo 1} mul_SNo.
Axiom god1_natural_parity_sign_in_sign_pair : forall n , natural_parity_sign n :e {1,minus_SNo 1}.
Axiom god1_natural_parity_sign_zero : natural_parity_sign 0 = 1.
Axiom god1_permutation_signature_in_sign_pair : forall p sigma , permutation_signature p sigma :e {1,minus_SNo 1}.
Axiom god1_permutation_signature_sno : forall p sigma , SNo (permutation_signature p sigma).
Axiom god1_permutation_identity_inversion_set_empty : forall p , permutation_inversion_set p (permutation_identity p) = 0.
Axiom god1_permutation_signature_identity : forall p , permutation_signature p (permutation_identity p) = 1.
Axiom god1_permutation_signature_word_right_parity : forall p , nat_p p -> forall sigma :e permutation_group p , forall f : set -> set , forall n , nat_p n -> (forall i :e n , group_word_letter (permutation_group p) (permutation_composition p) (adjacent_transpositions p) (f i)) -> permutation_signature p (permutation_composition p sigma (group_word_product (permutation_group p) (permutation_composition p) f n)) = mul_SNo (permutation_signature p sigma) (natural_parity_sign n).
Axiom god1_permutation_signature_word_product : forall p , nat_p p -> forall f : set -> set , forall n , nat_p n -> (forall i :e n , group_word_letter (permutation_group p) (permutation_composition p) (adjacent_transpositions p) (f i)) -> permutation_signature p (group_word_product (permutation_group p) (permutation_composition p) f n) = natural_parity_sign n.
Axiom god1_permutation_signature_multiplies_represented : forall p , nat_p p -> forall sigma tau :e permutation_group p , group_word_represented (permutation_group p) (permutation_composition p) (adjacent_transpositions p) tau -> permutation_signature p (permutation_composition p sigma tau) = mul_SNo (permutation_signature p sigma) (permutation_signature p tau).
Axiom god1_permutation_signature_multiplies : forall p , nat_p p -> forall sigma tau :e permutation_group p , permutation_signature p (permutation_composition p sigma tau) = mul_SNo (permutation_signature p sigma) (permutation_signature p tau).
Axiom god1_permutation_signature_group_homomorphism : forall p , nat_p p -> group_homomorphism (permutation_group p) (permutation_composition p) {1,minus_SNo 1} mul_SNo (permutation_signature p).
Axiom god1_sign_pair_group_identity_eq : group_identity {1,minus_SNo 1} mul_SNo = 1.
Axiom god1_permutation_signature_adjacent_transposition : forall p , nat_p p -> forall tau :e adjacent_transpositions p , permutation_signature p tau = minus_SNo 1.
Axiom god1_sign_homomorphism_word_zero : forall p , forall s : set -> set , group_homomorphism (permutation_group p) (permutation_composition p) {1,minus_SNo 1} mul_SNo s -> forall f : set -> set , (forall i :e 0 , group_word_letter (permutation_group p) (permutation_composition p) (adjacent_transpositions p) (f i)) -> s (group_word_product (permutation_group p) (permutation_composition p) f 0) = natural_parity_sign 0.
Axiom god1_sign_homomorphism_word_step : forall p , nat_p p -> forall s : set -> set , group_homomorphism (permutation_group p) (permutation_composition p) {1,minus_SNo 1} mul_SNo s -> (forall tau :e adjacent_transpositions p , s tau = minus_SNo 1) -> forall f : set -> set , forall n , nat_p n -> ((forall i :e n , group_word_letter (permutation_group p) (permutation_composition p) (adjacent_transpositions p) (f i)) -> s (group_word_product (permutation_group p) (permutation_composition p) f n) = natural_parity_sign n) -> (forall i :e ordsucc n , group_word_letter (permutation_group p) (permutation_composition p) (adjacent_transpositions p) (f i)) -> s (group_word_product (permutation_group p) (permutation_composition p) f (ordsucc n)) = natural_parity_sign (ordsucc n).
Axiom god1_sign_homomorphism_word_product : forall p , nat_p p -> forall s : set -> set , group_homomorphism (permutation_group p) (permutation_composition p) {1,minus_SNo 1} mul_SNo s -> (forall tau :e adjacent_transpositions p , s tau = minus_SNo 1) -> forall f : set -> set , forall n , nat_p n -> (forall i :e n , group_word_letter (permutation_group p) (permutation_composition p) (adjacent_transpositions p) (f i)) -> s (group_word_product (permutation_group p) (permutation_composition p) f n) = natural_parity_sign n.
Axiom god1_sign_homomorphism_unique : forall p , nat_p p -> forall s : set -> set , group_homomorphism (permutation_group p) (permutation_composition p) {1,minus_SNo 1} mul_SNo s -> (forall tau :e adjacent_transpositions p , s tau = minus_SNo 1) -> forall sigma :e permutation_group p , s sigma = permutation_signature p sigma.
Axiom god1_minus_one_neq_one : minus_SNo 1 <> 1.
Axiom god1_permuted_tuple_in : forall p X , forall sigma :e permutation_group p , forall x :e X :^: p , permuted_tuple p sigma x :e X :^: p.
Axiom god1_permuted_tuple_identity : forall p X , forall x :e X :^: p , permuted_tuple p (permutation_identity p) x = x.
Axiom god1_permuted_tuple_composition : forall p X , forall sigma tau :e permutation_group p , forall x :e X :^: p , permuted_tuple p tau (permuted_tuple p sigma x) = permuted_tuple p (permutation_composition p sigma tau) x.
Axiom god1_signed_group_element_one : forall M , forall addM : set -> set -> set , forall y , signed_group_element M addM 1 y = y.
Axiom god1_signed_group_element_minus_one : forall M , forall addM : set -> set -> set , forall y , signed_group_element M addM (minus_SNo 1) y = module_negation M addM y.
Axiom god1_signed_group_element_in : forall M , forall addM : set -> set -> set , group M addM -> forall sign :e {1,minus_SNo 1} , forall y :e M , signed_group_element M addM sign y :e M.
Axiom god1_signed_group_element_negation_flips_sign : forall M , forall addM : set -> set -> set , group M addM -> forall sign :e {1,minus_SNo 1} , forall y :e M , module_negation M addM (signed_group_element M addM sign y) = signed_group_element M addM (mul_SNo sign (minus_SNo 1)) y.
Axiom god1_antisymmetric_mapping_group : forall X M , forall addM : set -> set -> set , forall p , forall f : set -> set , antisymmetric_mapping X M addM p f -> group M addM.
Axiom god1_antisymmetric_mapping_abelian_group : forall X M , forall addM : set -> set -> set , forall p , forall f : set -> set , antisymmetric_mapping X M addM p f -> abelian_group M addM.
Axiom god1_antisymmetric_mapping_values_in : forall X M , forall addM : set -> set -> set , forall p , forall f : set -> set , antisymmetric_mapping X M addM p f -> forall x :e X :^: p , f x :e M.
Axiom god1_antisymmetric_mapping_adjacent_law : forall X M , forall addM : set -> set -> set , forall p , forall f : set -> set , antisymmetric_mapping X M addM p f -> forall tau :e adjacent_transpositions p , forall x :e X :^: p , f (permuted_tuple p tau x) = module_negation M addM (f x).
Axiom god1_antisymmetric_mapping_word_zero : forall p X M , forall addM : set -> set -> set , forall f : set -> set , antisymmetric_mapping X M addM p f -> forall word : set -> set , forall x :e X :^: p , f (permuted_tuple p (group_word_product (permutation_group p) (permutation_composition p) word 0) x) = signed_group_element M addM (natural_parity_sign 0) (f x).
Axiom god1_antisymmetric_mapping_word_step : forall p , nat_p p -> forall X M , forall addM : set -> set -> set , forall f : set -> set , antisymmetric_mapping X M addM p f -> forall word : set -> set , forall x :e X :^: p , forall n , nat_p n -> ((forall i :e n , group_word_letter (permutation_group p) (permutation_composition p) (adjacent_transpositions p) (word i)) -> f (permuted_tuple p (group_word_product (permutation_group p) (permutation_composition p) word n) x) = signed_group_element M addM (natural_parity_sign n) (f x)) -> (forall i :e ordsucc n , group_word_letter (permutation_group p) (permutation_composition p) (adjacent_transpositions p) (word i)) -> f (permuted_tuple p (group_word_product (permutation_group p) (permutation_composition p) word (ordsucc n)) x) = signed_group_element M addM (natural_parity_sign (ordsucc n)) (f x).
Axiom god1_antisymmetric_mapping_word_product : forall p , nat_p p -> forall X M , forall addM : set -> set -> set , forall f : set -> set , antisymmetric_mapping X M addM p f -> forall word : set -> set , forall n , nat_p n -> (forall i :e n , group_word_letter (permutation_group p) (permutation_composition p) (adjacent_transpositions p) (word i)) -> forall x :e X :^: p , f (permuted_tuple p (group_word_product (permutation_group p) (permutation_composition p) word n) x) = signed_group_element M addM (natural_parity_sign n) (f x).
Axiom god1_antisymmetric_mapping_permutation_formula : forall p , nat_p p -> forall X M , forall addM : set -> set -> set , forall f : set -> set , antisymmetric_mapping X M addM p f -> forall sigma :e permutation_group p , forall x :e X :^: p , f (permuted_tuple p sigma x) = signed_group_element M addM (permutation_signature p sigma) (f x).
Axiom god1_group_left_translation_bijective : forall G , forall mul : set -> set -> set , group G mul -> forall a :e G , bij G G (fun x => mul a x).
Axiom god1_permutation_group_finite : forall p :e omega , finite (permutation_group p).
Axiom god1_module_finitely_supported_sum_bijection_invariant : forall M , forall addM : set -> set -> set , abelian_group M addM -> forall I J , finite I -> finite J -> forall phi : set -> set , bij I J phi -> forall f : set -> set , (forall j :e J , f j :e M) -> module_finitely_supported_sum M addM J f = module_finitely_supported_sum M addM I (fun i => f (phi i)).
Axiom god1_abelian_group_negation_homomorphism : forall M , forall addM : set -> set -> set , abelian_group M addM -> group_homomorphism M addM M addM (module_negation M addM).
Axiom god1_signed_group_element_nested : forall M , forall addM : set -> set -> set , group M addM -> forall a b :e {1,minus_SNo 1} , forall y :e M , signed_group_element M addM a (signed_group_element M addM b y) = signed_group_element M addM (mul_SNo a b) y.
Axiom god1_signed_group_element_finite_sum : forall M , forall addM : set -> set -> set , abelian_group M addM -> forall I , finite I -> forall sign :e {1,minus_SNo 1} , forall f : set -> set , (forall i :e I , f i :e M) -> signed_group_element M addM sign (module_finitely_supported_sum M addM I f) = module_finitely_supported_sum M addM I (fun i => signed_group_element M addM sign (f i)).
Axiom god1_sign_pair_group_inverse_self : forall sign :e {1,minus_SNo 1} , group_inverse {1,minus_SNo 1} mul_SNo sign = sign.
Axiom god1_permutation_signature_inverse : forall p , nat_p p -> forall sigma :e permutation_group p , permutation_signature p (group_inverse (permutation_group p) (permutation_composition p) sigma) = permutation_signature p sigma.
Axiom god1_map_eq_permutation_swap : forall X a b , forall t : set -> set , a :e X -> b :e X -> t a = b -> t b = a -> (forall k :e X , k <> a -> k <> b -> t k = k) -> forall k :e X , t k = permutation_swap X a b k.
Axiom god1_permutation_swap_symmetric : forall X a b , a :e X -> b :e X -> permutation_swap X a b = permutation_swap X b a.
Axiom god1_permutation_swap_conjugate_adjacent : forall p m a b , m :e p -> a :e p -> b :e p -> m <> a -> m <> b -> a <> b -> permutation_composition p (permutation_swap p m a) (permutation_composition p (permutation_swap p m b) (permutation_swap p m a)) = permutation_swap p a b.
Axiom god1_sign_pair_sandwich_minus_one : forall sign :e {1,minus_SNo 1} , mul_SNo sign (mul_SNo (minus_SNo 1) sign) = minus_SNo 1.
Axiom god1_permutation_signature_swap_ordered : forall p , nat_p p -> forall a b :e p , a :e b -> permutation_signature p (permutation_swap p a b) = minus_SNo 1.
Axiom god1_permutation_signature_swap : forall p , nat_p p -> forall a b :e p , a <> b -> permutation_signature p (permutation_swap p a b) = minus_SNo 1.
Axiom god1_permuted_tuple_swap_fixed : forall p X , forall i j :e p , i <> j -> forall x :e X :^: p , x i = x j -> permuted_tuple p (permutation_swap p i j) x = x.
Definition permutation_preimage_order_class : set -> set -> set -> set := fun p i j => {sigma :e permutation_group p|exists u v :e p , (u :e v /\ sigma u = i) /\ sigma v = j}.
Axiom god1_permutation_preimage_order_class_subset : forall p i j , permutation_preimage_order_class p i j c= permutation_group p.
Axiom god1_permutation_preimage_order_class_intro : forall p i j , forall sigma :e permutation_group p , forall u v :e p , u :e v -> sigma u = i -> sigma v = j -> sigma :e permutation_preimage_order_class p i j.
Axiom god1_permutation_preimage_order_class_elim : forall p i j , forall sigma :e permutation_preimage_order_class p i j , exists u v :e p , (u :e v /\ sigma u = i) /\ sigma v = j.
Axiom god1_permutation_preimage_order_classes_disjoint : forall p :e omega , forall i j :e p , i <> j -> permutation_preimage_order_class p i j :/\: permutation_preimage_order_class p j i = Empty.
Axiom god1_permutation_preimage_order_classes_union : forall p :e omega , forall i j :e p , i <> j -> permutation_preimage_order_class p i j :\/: permutation_preimage_order_class p j i = permutation_group p.
Axiom god1_permutation_preimage_order_classes_partition : forall p :e omega , forall i j :e p , i <> j -> let S1 := permutation_preimage_order_class p i j in let S2 := permutation_preimage_order_class p j i in (S1 c= permutation_group p /\ finite S1) /\ (S2 c= permutation_group p /\ finite S2) /\ S1 :/\: S2 = Empty /\ S1 :\/: S2 = permutation_group p.
Axiom god1_swap_left_composition_maps_preimage_order_class : forall p , forall i j :e p , forall sigma :e permutation_preimage_order_class p i j , permutation_composition p (permutation_swap p i j) sigma :e permutation_preimage_order_class p j i.
Axiom god1_swap_left_composition_preimage_classes_bijective : forall p , forall i j :e p , bij (permutation_preimage_order_class p i j) (permutation_preimage_order_class p j i) (fun sigma => permutation_composition p (permutation_swap p i j) sigma).
Axiom god1_swap_left_composition_paired_terms_are_opposites : forall p , nat_p p -> forall X M , forall addM : set -> set -> set , group M addM -> forall f : set -> set , (forall z :e X :^: p , f z :e M) -> forall i j :e p , i <> j -> forall sigma :e permutation_group p , forall x :e X :^: p , permuted_tuple p (permutation_swap p i j) x = x -> signed_group_element M addM (permutation_signature p (permutation_composition p (permutation_swap p i j) sigma)) (f (permuted_tuple p (permutation_composition p (permutation_swap p i j) sigma) x)) = module_negation M addM (signed_group_element M addM (permutation_signature p sigma) (f (permuted_tuple p sigma x))).
Axiom god1_abelian_finite_sum_opposite_bijection_zero : forall M , forall addM : set -> set -> set , abelian_group M addM -> forall S1 S2 , finite S1 -> finite S2 -> (forall z :e S2 , z /:e S1) -> forall phi : set -> set , bij S1 S2 phi -> forall F : set -> set , (forall z :e S1 :\/: S2 , F z :e M) -> (forall z :e S1 , F (phi z) = module_negation M addM (F z)) -> ring_finite_sum M addM (S1 :\/: S2) F = module_zero M addM.
Axiom god1_antisymmetrization_repeated_arguments_vanish : forall X M , forall addM : set -> set -> set , forall p :e omega , forall f : set -> set , abelian_group M addM -> (forall z :e X :^: p , f z :e M) -> forall x :e X :^: p , (exists i j :e p , i <> j /\ x i = x j) -> module_finitely_supported_sum M addM (permutation_group p) (fun sigma => signed_group_element M addM (permutation_signature p sigma) (f (permuted_tuple p sigma x))) = module_zero M addM.
Axiom god1_s7_example21_permutation_action_interface : forall p :e omega , forall X , (forall sigma :e permutation_group p , forall x :e X :^: p , permuted_tuple p sigma x :e X :^: p) /\ forall omega sigma :e permutation_group p , forall x :e X :^: p , permuted_tuple p sigma (permuted_tuple p omega x) = permuted_tuple p (permutation_composition p omega sigma) x.
Axiom god1_s23_theorem1_signature_and_antisymmetric_permutation_law : forall p :e omega , 0 :e p -> group_homomorphism (permutation_group p) (permutation_composition p) {1,minus_SNo 1} mul_SNo (permutation_signature p) /\ (forall tau :e adjacent_transpositions p , permutation_signature p tau = minus_SNo 1) /\ (forall s : set -> set , group_homomorphism (permutation_group p) (permutation_composition p) {1,minus_SNo 1} mul_SNo s -> (forall tau :e adjacent_transpositions p , s tau = minus_SNo 1) -> forall sigma :e permutation_group p , s sigma = permutation_signature p sigma) /\ forall X M , forall addM : set -> set -> set , forall f : set -> set , antisymmetric_mapping X M addM p f -> forall sigma :e permutation_group p , forall x :e X :^: p , f (permuted_tuple p sigma x) = signed_group_element M addM (permutation_signature p sigma) (f x).
Axiom god1_s23_theorem1_transposition_signature_interface : forall p :e omega , 0 :e p -> forall tau :e adjacent_transpositions p , permutation_signature p tau = minus_SNo 1.
Axiom god1_s23_theorem1_antisymmetric_permutation_interface : forall p :e omega , 0 :e p -> forall X M , forall addM : set -> set -> set , forall f : set -> set , antisymmetric_mapping X M addM p f -> forall sigma :e permutation_group p , forall x :e X :^: p , f (permuted_tuple p sigma x) = signed_group_element M addM (permutation_signature p sigma) (f x).
Definition antisymmetrization : set -> (set -> set -> set) -> set -> set -> (set -> set) -> set := fun M addM X p f => fun x :e X :^: p => module_finitely_supported_sum M addM (permutation_group p) (fun sigma => signed_group_element M addM (permutation_signature p sigma) (f (permuted_tuple p sigma x))).
Axiom god1_antisymmetrization_inverse_translate_term : forall X M , forall addM : set -> set -> set , forall p :e omega , forall f : set -> set , abelian_group M addM -> (forall x :e X :^: p , f x :e M) -> forall omega sigma :e permutation_group p , forall x :e X :^: p , signed_group_element M addM (permutation_signature p (permutation_composition p (group_inverse (permutation_group p) (permutation_composition p) omega) sigma)) (f (permuted_tuple p (permutation_composition p (group_inverse (permutation_group p) (permutation_composition p) omega) sigma) (permuted_tuple p omega x))) = signed_group_element M addM (permutation_signature p omega) (signed_group_element M addM (permutation_signature p sigma) (f (permuted_tuple p sigma x))).
Axiom god1_antisymmetrization_transforms_by_signature : forall X M , forall addM : set -> set -> set , forall p :e omega , forall f : set -> set , abelian_group M addM -> (forall x :e X :^: p , f x :e M) -> forall omega :e permutation_group p , forall x :e X :^: p , antisymmetrization M addM X p f (permuted_tuple p omega x) = signed_group_element M addM (permutation_signature p omega) (antisymmetrization M addM X p f x).
Axiom god1_antisymmetrization_is_antisymmetric_and_vanishes_on_repetitions : forall X M , forall addM : set -> set -> set , forall p :e omega , forall f : set -> set , 0 :e p -> abelian_group M addM -> (forall x :e X :^: p , f x :e M) -> antisymmetric_mapping X M addM p (fun x => antisymmetrization M addM X p f x) /\ forall x :e X :^: p , (exists i j :e p , i <> j /\ x i = x j) -> antisymmetrization M addM X p f x = module_zero M addM.
Definition alternating_multilinear_mapping : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> prop := fun K addK mulK p X addX smulX M addM smulM f => multilinear_mapping K addK mulK p (fun i => X) (fun i => addX) (fun i => smulX) M addM smulM f /\ forall x :e X :^: p , (exists i j :e p , i <> j /\ x i = x j) -> f x = module_zero M addM.
Definition alternating_multilinear_mapping_space : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set := fun K addK mulK p X addX smulX M addM smulM => {f :e M :^: (X :^: p)|alternating_multilinear_mapping K addK mulK p X addX smulX M addM smulM (fun x => f x)}.
Axiom god1_indexed_function_update_at : forall I x i y , i :e I -> indexed_function_update I x i y i = y.
Axiom god1_indexed_function_update_other : forall I x i y , forall k :e I , k <> i -> indexed_function_update I x i y k = x k.
Axiom god1_indexed_function_update_current : forall I , forall X : set -> set , forall x :e indexed_module_product I X , forall i :e I , indexed_function_update I x i (x i) = x.
Axiom god1_indexed_function_update_commute : forall I , forall X : set -> set , forall x :e indexed_module_product I X , forall i j :e I , i <> j -> forall u :e X i , forall v :e X j , indexed_function_update I (indexed_function_update I x i u) j v = indexed_function_update I (indexed_function_update I x j v) i u.
Axiom god1_indexed_function_two_current_updates : forall I , forall X : set -> set , forall x :e indexed_module_product I X , forall i j :e I , indexed_function_update I (indexed_function_update I x i (x i)) j (x j) = x.
Axiom god1_indexed_function_swapped_updates_are_permuted_tuple : forall p X , forall x :e X :^: p , forall i j :e p , i <> j -> indexed_function_update p (indexed_function_update p x i (x j)) j (x i) = permuted_tuple p (permutation_swap p i j) x.
Axiom god1_permutation_inverse_right_eval : forall p , forall sigma :e permutation_group p , forall i :e p , sigma (permutation_inverse p sigma i) = i.
Axiom god1_permuted_tuple_update_inverse : forall p X , forall sigma :e permutation_group p , forall x :e X :^: p , forall i :e p , forall y :e X , permuted_tuple p sigma (indexed_function_update p x i y) = indexed_function_update p (permuted_tuple p sigma x) (permutation_inverse p sigma i) y.
Axiom god1_multilinear_mapping_permuted_arguments : forall K , forall addK mulK : set -> set -> set , forall p X , forall addX smulX : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , multilinear_mapping K addK mulK p (fun q => X) (fun q => addX) (fun q => smulX) M addM smulM f -> forall sigma :e permutation_group p , multilinear_mapping K addK mulK p (fun q => X) (fun q => addX) (fun q => smulX) M addM smulM (fun x => f (permuted_tuple p sigma x)).
Axiom god1_module_negation_of_multilinear_mapping : forall K , forall addK mulK : set -> set -> set , forall I , forall X : set -> set , forall addX smulX : set -> set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , commutative_ring K addK mulK -> (forall i :e I , left_module K addK mulK (X i) (addX i) (smulX i)) -> left_module K addK mulK M addM smulM -> multilinear_mapping K addK mulK I X addX smulX M addM smulM f -> multilinear_mapping K addK mulK I X addX smulX M addM smulM (fun z => module_negation M addM (f z)).
Axiom god1_signed_multilinear_permuted_term : forall K , forall addK mulK : set -> set -> set , forall p X , forall addX smulX : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , commutative_ring K addK mulK -> (forall i :e p , left_module K addK mulK X addX smulX) -> left_module K addK mulK M addM smulM -> multilinear_mapping K addK mulK p (fun i => X) (fun i => addX) (fun i => smulX) M addM smulM f -> forall sigma :e permutation_group p , multilinear_mapping K addK mulK p (fun i => X) (fun i => addX) (fun i => smulX) M addM smulM (fun x => signed_group_element M addM (permutation_signature p sigma) (f (permuted_tuple p sigma x))).
Axiom god1_s22_relation2_alternating_bilinear_is_skew_interface : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , alternating_bilinear_mapping K addK mulK X addX smulX M addM smulM f -> forall x y :e X , f (bilinear_tuple y x) = module_negation M addM (f (bilinear_tuple x y)).
Axiom god1_alternating_multilinear_swap_changes_sign : forall K , forall addK mulK : set -> set -> set , forall p , forall X , forall addX smulX : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , alternating_multilinear_mapping K addK mulK p X addX smulX M addM smulM f -> forall i j :e p , i <> j -> forall x :e X :^: p , f (permuted_tuple p (permutation_swap p i j) x) = module_negation M addM (f x).
Axiom god1_alternating_multilinear_is_antisymmetric_core : forall K , forall addK mulK : set -> set -> set , forall p , forall X , forall addX smulX : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , alternating_multilinear_mapping K addK mulK p X addX smulX M addM smulM f -> antisymmetric_mapping X M addM p f.
Axiom god1_s23_theorem2_alternating_multilinear_is_antisymmetric : forall K , forall addK mulK : set -> set -> set , forall p :e omega , forall X , forall addX smulX : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , 0 :e p -> alternating_multilinear_mapping K addK mulK p X addX smulX M addM smulM f -> antisymmetric_mapping X M addM p f /\ forall sigma :e permutation_group p , forall x :e X :^: p , f (permuted_tuple p sigma x) = signed_group_element M addM (permutation_signature p sigma) (f x).
Axiom god1_s23_theorem3_antisymmetrization_of_multilinear_map : forall K , forall addK mulK : set -> set -> set , forall p :e omega , forall X , forall addX smulX : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , 0 :e p -> multilinear_mapping K addK mulK p (fun i => X) (fun i => addX) (fun i => smulX) M addM smulM f -> alternating_multilinear_mapping K addK mulK p X addX smulX M addM smulM (fun x => antisymmetrization M addM X p f x).
Definition exterior_product_linear_forms : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> (set -> set) -> set := fun K add mul X p u => antisymmetrization K add X p (fun x => ring_finite_product K add mul p (fun i => ap (u i) (x i))).
Axiom god1_exterior_product_of_linear_forms_is_alternating : forall K , forall add mul : set -> set -> set , forall p :e omega , forall X , forall addX smulX : set -> set -> set , forall u : set -> set , 0 :e p -> commutative_ring K add mul -> (forall i :e p , module_homomorphism K add mul X addX smulX K add mul (fun x => u i x)) -> alternating_multilinear_mapping K add mul p X addX smulX K add mul (fun x => exterior_product_linear_forms K add mul X p u x).
Definition god1_extend_indexed_function_last : set -> set -> set -> set := fun k t r => fun h :e ordsucc k => if h = k then r else t h.
Axiom god1_extend_indexed_function_last_in : forall k :e omega , forall Q , forall t :e Q :^: k , forall r :e Q , god1_extend_indexed_function_last k t r :e Q :^: ordsucc k.
Axiom god1_extend_indexed_function_last_eval_earlier : forall k t r , forall h :e k , god1_extend_indexed_function_last k t r h = t h.
Axiom god1_extend_indexed_function_last_eval_last : forall k t r , god1_extend_indexed_function_last k t r k = r.
Axiom god1_extend_indexed_function_last_bijective : forall k :e omega , forall Q , bij ((Q :^: k) :*: Q) (Q :^: ordsucc k) (fun z => god1_extend_indexed_function_last k (z 0) (z 1)).
Definition god1_partial_multilinear_expansion_tuple : set -> set -> set -> (set -> set) -> set -> set := fun p k x b idx => fun h :e p => if h :e k then b (idx h) else x h.
Axiom god1_partial_multilinear_expansion_tuple_in : forall p k X Q , forall x :e X :^: p , forall b : set -> set , forall idx :e Q :^: k , (forall r :e Q , b r :e X) -> god1_partial_multilinear_expansion_tuple p k x b idx :e X :^: p.
Axiom god1_partial_multilinear_expansion_tuple_zero : forall p X Q , forall x :e X :^: p , forall b : set -> set , forall idx :e Q :^: 0 , god1_partial_multilinear_expansion_tuple p 0 x b idx = x.
Axiom god1_partial_multilinear_expansion_tuple_full : forall p X Q , forall x :e X :^: p , forall b : set -> set , forall idx :e Q :^: p , (forall r :e Q , b r :e X) -> god1_partial_multilinear_expansion_tuple p p x b idx = (fun h :e p => b (idx h)).
Axiom god1_partial_multilinear_expansion_tuple_step : forall p , forall k :e omega , forall X Q , forall x :e X :^: p , forall b : set -> set , forall idx :e Q :^: k , forall r :e Q , ordsucc k c= p -> (forall s :e Q , b s :e X) -> indexed_function_update p (god1_partial_multilinear_expansion_tuple p k x b idx) k (b r) = god1_partial_multilinear_expansion_tuple p (ordsucc k) x b (god1_extend_indexed_function_last k idx r).
Axiom god1_setexp_zero_is_singleton : forall Q , Q :^: 0 = {(fun h :e 0 => 0)}.
Axiom god1_multilinear_partial_tuple_expands_last_coordinate : forall K , forall addK mulK : set -> set -> set , forall p , forall k :e omega , forall Q :e omega , forall X , forall addX smulX : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , forall x :e X :^: p , forall b : set -> set , forall coeff : set -> set -> set , commutative_ring K addK mulK -> (forall i :e p , left_module K addK mulK X addX smulX) -> left_module K addK mulK M addM smulM -> multilinear_mapping K addK mulK p (fun i => X) (fun i => addX) (fun i => smulX) M addM smulM f -> ordsucc k c= p -> (forall r :e Q , b r :e X) -> (forall i :e p , forall r :e Q , coeff i r :e K) -> (forall i :e p , x i = module_finitely_supported_sum X addX Q (fun r => smulX (coeff i r) (b r))) -> forall idx :e Q :^: k , f (god1_partial_multilinear_expansion_tuple p k x b idx) = module_finitely_supported_sum M addM Q (fun r => smulM (coeff k r) (f (god1_partial_multilinear_expansion_tuple p (ordsucc k) x b (god1_extend_indexed_function_last k idx r)))).
Definition god1_multilinear_expansion_term : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set -> (set -> set) -> (set -> set -> set) -> (set -> set) -> (set -> set -> set) -> set -> set := fun K addK mulK p k x b coeff f smulM idx => smulM (ring_finite_product K addK mulK k (fun i => coeff i (idx i))) (f (god1_partial_multilinear_expansion_tuple p k x b idx)).
Axiom god1_multilinear_finite_family_expansion : forall K , forall addK mulK : set -> set -> set , forall p :e omega , forall Q :e omega , forall X , forall addX smulX : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , forall x :e X :^: p , forall b : set -> set , forall coeff : set -> set -> set , commutative_ring K addK mulK -> (forall i :e p , left_module K addK mulK X addX smulX) -> left_module K addK mulK M addM smulM -> multilinear_mapping K addK mulK p (fun i => X) (fun i => addX) (fun i => smulX) M addM smulM f -> (forall r :e Q , b r :e X) -> (forall i :e p , forall r :e Q , coeff i r :e K) -> (forall i :e p , x i = module_finitely_supported_sum X addX Q (fun r => smulX (coeff i r) (b r))) -> f x = module_finitely_supported_sum M addM (Q :^: p) (fun idx => smulM (ring_finite_product K addK mulK p (fun i => coeff i (idx i))) (f (fun i :e p => b (idx i)))).
Axiom god1_s23_theorem4_alternating_map_vanishes_on_short_span : forall K , forall addK mulK : set -> set -> set , forall p q :e omega , forall X , forall addX smulX : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , q :e p -> alternating_multilinear_mapping K addK mulK p X addX smulX M addM smulM f -> forall b : set -> set , forall coeff : set -> set -> set , forall x :e X :^: p , (forall j :e q , b j :e X) /\ (forall i :e p , forall j :e q , coeff i j :e K) /\ (forall i :e p , x i = module_finitely_supported_sum X addX q (fun j => smulX (coeff i j) (b j))) -> f x = module_zero M addM.
Axiom god1_s23_theorem4_corollary1_dependent_arguments_vanish : forall K , forall addK mulK : set -> set -> set , forall p :e omega , forall X , forall addX smulX : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , field K addK mulK -> left_module K addK mulK X addX smulX -> alternating_multilinear_mapping K addK mulK p X addX smulX M addM smulM f -> forall x :e X :^: p , not (linearly_independent_family K addK mulK X addX smulX p (fun i => x i)) -> f x = module_zero M addM.
Axiom god1_s23_theorem4_corollary2_degree_above_rank_is_zero : forall K , forall addK mulK : set -> set -> set , forall p r :e omega , forall X , forall addX smulX : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall a : set -> set , forall f : set -> set , r :e p -> module_basis K addK mulK X addX smulX r a -> left_module K addK mulK M addM smulM -> alternating_multilinear_mapping K addK mulK p X addX smulX M addM smulM f -> forall x :e X :^: p , f x = module_zero M addM.
Definition signature_scalar : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set := fun K add mul p sigma => if permutation_signature p sigma = 1 then ring_one K mul else ring_negation K add (ring_one K mul).
Definition matrix_determinant : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set := fun K add mul p A => module_finitely_supported_sum K add (permutation_group p) (fun sigma => mul (signature_scalar K add mul p sigma) (ring_finite_product K add mul p (fun j => matrix_entry A (sigma j) j))).
Definition basis_coordinate_matrix : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> (set -> set) -> set := fun K addK mulK X addX smulX p a x => fun u :e p :*: p => basis_coordinates K addK mulK X addX smulX p a (x (u 1)) (u 0).
Definition determinant_of_vectors_in_basis : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> (set -> set) -> set := fun K addK mulK X addX smulX p a x => matrix_determinant K addK mulK p (basis_coordinate_matrix K addK mulK X addX smulX p a x).
Definition god1_basis_coordinate_function_family : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> set -> set := fun K addK mulK X addX smulX p a i => (fun z :e X => basis_coordinates K addK mulK X addX smulX p a z i).
Axiom god1_signature_scalar_module_action : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulM : set -> set -> set , ring K addK mulK -> left_module K addK mulK M addM smulM -> forall p sigma , forall y :e M , smulM (signature_scalar K addK mulK p sigma) y = signed_group_element M addM (permutation_signature p sigma) y.
Axiom god1_permutation_group_inversion_bijective : forall p , bij (permutation_group p) (permutation_group p) (fun sigma => group_inverse (permutation_group p) (permutation_composition p) sigma).
Axiom god1_basis_coordinate_matrix_entry_eval : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall p , forall a x : set -> set , forall i j :e p , matrix_entry (basis_coordinate_matrix K addK mulK X addX smulX p a x) i j = basis_coordinates K addK mulK X addX smulX p a (x j) i.
Axiom god1_basis_coordinate_product_inverse_reindex : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall p :e omega , forall a : set -> set , forall x :e X :^: p , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX p a -> forall sigma :e permutation_group p , ring_finite_product K addK mulK p (fun j => basis_coordinates K addK mulK X addX smulX p a (x j) (group_inverse (permutation_group p) (permutation_composition p) sigma j)) = ring_finite_product K addK mulK p (fun i => basis_coordinates K addK mulK X addX smulX p a (permuted_tuple p sigma x i) i).
Axiom god1_determinant_of_vectors_is_coordinate_exterior_product : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall p :e omega , forall a : set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX p a -> forall x :e X :^: p , determinant_of_vectors_in_basis K addK mulK X addX smulX p a (fun i => x i) = ap (exterior_product_linear_forms K addK mulK X p (fun i => god1_basis_coordinate_function_family K addK mulK X addX smulX p a i)) x.
Axiom god1_alternating_multilinear_mapping_pointwise_transfer : forall K , forall addK mulK : set -> set -> set , forall p , forall X , forall addX smulX : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f g : set -> set , commutative_ring K addK mulK -> (forall i :e p , left_module K addK mulK X addX smulX) -> left_module K addK mulK M addM smulM -> alternating_multilinear_mapping K addK mulK p X addX smulX M addM smulM f -> (forall z :e X :^: p , g z :e M) -> (forall z :e X :^: p , g z = f z) -> alternating_multilinear_mapping K addK mulK p X addX smulX M addM smulM g.
Axiom god1_determinant_of_vectors_in_basis_is_alternating : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall p :e omega , forall a : set -> set , 0 :e p -> commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX p a -> alternating_multilinear_mapping K addK mulK p X addX smulX K addK mulK (fun x => determinant_of_vectors_in_basis K addK mulK X addX smulX p a (fun i => x i)).
Axiom god1_determinant_of_basis_is_one : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall p :e omega , forall a : set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX p a -> determinant_of_vectors_in_basis K addK mulK X addX smulX p a a = ring_one K mulK.
Axiom god1_basis_coordinate_matrix_congr : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall p , forall a x y : set -> set , module_basis K addK mulK X addX smulX p a -> (forall j :e p , x j :e X) -> (forall j :e p , y j :e X) -> (forall j :e p , x j = y j) -> basis_coordinate_matrix K addK mulK X addX smulX p a x = basis_coordinate_matrix K addK mulK X addX smulX p a y.
Axiom god1_determinant_of_vectors_in_basis_congr : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall p , forall a x y : set -> set , module_basis K addK mulK X addX smulX p a -> (forall j :e p , x j :e X) -> (forall j :e p , y j :e X) -> (forall j :e p , x j = y j) -> determinant_of_vectors_in_basis K addK mulK X addX smulX p a x = determinant_of_vectors_in_basis K addK mulK X addX smulX p a y.
Axiom god1_top_alternating_form_is_determinant_multiple : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall p :e omega , forall a : set -> set , 0 :e p -> commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX p a -> forall M , forall addM smulM : set -> set -> set , forall f : set -> set , left_module K addK mulK M addM smulM -> alternating_multilinear_mapping K addK mulK p X addX smulX M addM smulM f -> forall x :e X :^: p , f x = smulM (determinant_of_vectors_in_basis K addK mulK X addX smulX p a (fun i => x i)) (f (fun i :e p => a i)).
Axiom god1_s23_theorem5_unique_normalized_top_alternating_form : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall p :e omega , forall a : set -> set , 0 :e p -> commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX p a -> alternating_multilinear_mapping K addK mulK p X addX smulX K addK mulK (fun x => determinant_of_vectors_in_basis K addK mulK X addX smulX p a (fun i => x i)) /\ determinant_of_vectors_in_basis K addK mulK X addX smulX p a a = ring_one K mulK /\ (forall D : set -> set , alternating_multilinear_mapping K addK mulK p X addX smulX K addK mulK D -> D (fun i :e p => a i) = ring_one K mulK -> forall x :e X :^: p , D x = determinant_of_vectors_in_basis K addK mulK X addX smulX p a (fun i => x i)) /\ forall M , forall addM smulM : set -> set -> set , forall f : set -> set , left_module K addK mulK M addM smulM -> alternating_multilinear_mapping K addK mulK p X addX smulX M addM smulM f -> forall x :e X :^: p , f x = smulM (determinant_of_vectors_in_basis K addK mulK X addX smulX p a (fun i => x i)) (f (fun i :e p => a i)).
Axiom god1_s23_theorem5_normalized_determinant_interface : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall p :e omega , forall a : set -> set , 0 :e p -> commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX p a -> alternating_multilinear_mapping K addK mulK p X addX smulX K addK mulK (fun x => determinant_of_vectors_in_basis K addK mulK X addX smulX p a (fun i => x i)) /\ determinant_of_vectors_in_basis K addK mulK X addX smulX p a a = ring_one K mulK.
Axiom god1_s23_theorem5_proportionality_interface : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall p :e omega , forall a : set -> set , 0 :e p -> commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX p a -> forall M , forall addM smulM : set -> set -> set , forall f : set -> set , left_module K addK mulK M addM smulM -> alternating_multilinear_mapping K addK mulK p X addX smulX M addM smulM f -> forall x :e X :^: p , f x = smulM (determinant_of_vectors_in_basis K addK mulK X addX smulX p a (fun i => x i)) (f (fun i :e p => a i)).
Axiom god1_s23_theorem5_corollary_bases_of_commutative_free_module_same_size : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall p q :e omega , forall a b : set -> set , commutative_ring K addK mulK -> ring_zero K addK <> ring_one K mulK -> module_basis K addK mulK X addX smulX p a -> module_basis K addK mulK X addX smulX q b -> p = q.
Axiom god1_matrix_determinant_transpose_invariance_core : forall K , forall add mul : set -> set -> set , forall p :e omega , forall A :e square_matrix_ring K p , commutative_ring K add mul -> matrix_determinant K add mul p A = matrix_determinant K add mul p (matrix_transpose K p p A).
Axiom god1_s23_theorem6_determinant_of_transpose : forall K , forall add mul : set -> set -> set , forall p :e omega , forall A :e square_matrix_ring K p , commutative_ring K add mul -> matrix_determinant K add mul p A = matrix_determinant K add mul p (matrix_transpose K p p A).
Axiom god1_indexed_map_update : forall I X , forall z :e X :^: I , forall i :e I , forall y :e X , forall u : set -> set , (forall x :e X , u x :e X) -> (fun k :e I => u (indexed_function_update I z i y k)) = indexed_function_update I (fun k :e I => u (z k)) i (u y).
Axiom god1_alternating_multilinear_endomorphism_pullback : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall p , forall f u : set -> set , commutative_ring K addK mulK -> left_module K addK mulK X addX smulX -> left_module K addK mulK M addM smulM -> module_endomorphism K addK mulK X addX smulX u -> alternating_multilinear_mapping K addK mulK p X addX smulX M addM smulM f -> alternating_multilinear_mapping K addK mulK p X addX smulX M addM smulM (fun z => f (fun i :e p => u (z i))).
Definition god1_canonical_matrix_endomorphism : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set -> set := fun K add mul p A => god1_basis_induced_linear_map K add mul (K :^: p) (module_power_addition p add) (module_power_left_scalar p mul) p (canonical_module_basis_vector K add mul p) (K :^: p) (module_power_addition p add) (module_power_left_scalar p mul) (fun j => fun i :e p => matrix_entry A i j).
Axiom god1_canonical_matrix_endomorphism_is_linear : forall K , forall add mul : set -> set -> set , forall p :e omega , forall A :e square_matrix_ring K p , ring K add mul -> module_endomorphism K add mul (K :^: p) (module_power_addition p add) (module_power_left_scalar p mul) (god1_canonical_matrix_endomorphism K add mul p A).
Axiom god1_canonical_matrix_endomorphism_evaluates_as_matrix_product : forall K , forall add mul : set -> set -> set , forall p :e omega , forall A :e square_matrix_ring K p , commutative_ring K add mul -> forall x :e K :^: p , god1_canonical_matrix_endomorphism K add mul p A x = matrix_vector_product K add mul p p A x.
Axiom god1_canonical_matrix_endomorphism_coordinate_matrix : forall K , forall add mul : set -> set -> set , forall p :e omega , forall A :e square_matrix_ring K p , ring K add mul -> basis_coordinate_matrix K add mul (K :^: p) (module_power_addition p add) (module_power_left_scalar p mul) p (canonical_module_basis_vector K add mul p) (fun j => god1_canonical_matrix_endomorphism K add mul p A (canonical_module_basis_vector K add mul p j)) = A.
Axiom god1_canonical_matrix_endomorphism_composition_coordinate_matrix : forall K , forall add mul : set -> set -> set , forall p :e omega , forall A B :e square_matrix_ring K p , commutative_ring K add mul -> basis_coordinate_matrix K add mul (K :^: p) (module_power_addition p add) (module_power_left_scalar p mul) p (canonical_module_basis_vector K add mul p) (fun j => god1_canonical_matrix_endomorphism K add mul p A (god1_canonical_matrix_endomorphism K add mul p B (canonical_module_basis_vector K add mul p j))) = matrix_multiplication K add mul p p p A B.
Axiom god1_matrix_determinant_order_zero : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall A :e square_matrix_ring K 0 , matrix_determinant K add mul 0 A = ring_one K mul.
Axiom god1_s23_theorem7_determinant_multiplicative : forall K , forall add mul : set -> set -> set , forall p :e omega , forall A B :e square_matrix_ring K p , commutative_ring K add mul -> matrix_determinant K add mul p (matrix_multiplication K add mul p p p A B) = mul (matrix_determinant K add mul p A) (matrix_determinant K add mul p B).
Definition endomorphism_coordinate_matrix : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> (set -> set) -> set := fun K addK mulK X addX smulX p a u => fun z :e p :*: p => basis_coordinates K addK mulK X addX smulX p a (u (a (z 1))) (z 0).
Definition endomorphism_determinant : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> (set -> set) -> set := fun K addK mulK X addX smulX p a u => matrix_determinant K addK mulK p (endomorphism_coordinate_matrix K addK mulK X addX smulX p a u).
Axiom god1_commutative_matrix_multiplication_opposite_agrees : forall K , forall add mul : set -> set -> set , forall p q r :e omega , forall A :e matrix_space K p q , forall B :e matrix_space K q r , commutative_ring K add mul -> matrix_multiplication K add (opposite_ring_multiplication mul) p q r A B = matrix_multiplication K add mul p q r A B.
Axiom god1_endomorphism_coordinate_matrix_in : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall p , forall a : set -> set , forall u : set -> set , module_basis K addK mulK X addX smulX p a -> module_endomorphism K addK mulK X addX smulX u -> endomorphism_coordinate_matrix K addK mulK X addX smulX p a u :e square_matrix_ring K p.
Axiom god1_endomorphism_coordinate_matrix_composition : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall p :e omega , forall a : set -> set , forall u v : set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX p a -> module_endomorphism K addK mulK X addX smulX u -> module_endomorphism K addK mulK X addX smulX v -> endomorphism_coordinate_matrix K addK mulK X addX smulX p a (fun x => u (v x)) = matrix_multiplication K addK mulK p p p (endomorphism_coordinate_matrix K addK mulK X addX smulX p a u) (endomorphism_coordinate_matrix K addK mulK X addX smulX p a v).
Axiom god1_commutative_left_module_over_opposite_ring : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , commutative_ring K addK mulK -> left_module K addK mulK M addM smul -> left_module K addK (opposite_ring_multiplication mulK) M addM smul.
Axiom god1_commutative_module_basis_as_right_basis : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , commutative_ring K addK mulK -> module_basis K addK mulK M addM smul I a -> right_module_basis K addK mulK M addM (fun x scalar => smul scalar x) I a.
Axiom god1_commutative_module_homomorphism_as_right_homomorphism : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , commutative_ring K addK mulK -> module_homomorphism K addK mulK L addL smulL M addM smulM f -> right_module_homomorphism K addK mulK L addL (fun x scalar => smulL scalar x) M addM (fun x scalar => smulM scalar x) f.
Axiom god1_basis_coordinate_matrix_self_is_unit_matrix : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall p :e omega , forall a : set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX p a -> basis_coordinate_matrix K addK mulK X addX smulX p a a = unit_matrix K addK mulK p.
Axiom god1_matrix_determinant_in : forall K , forall add mul : set -> set -> set , forall p :e omega , forall A :e square_matrix_ring K p , commutative_ring K add mul -> matrix_determinant K add mul p A :e K.
Axiom god1_endomorphism_determinant_independent_of_basis_and_composes : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall p :e omega , forall a b : set -> set , forall u v : set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX p a -> module_basis K addK mulK X addX smulX p b -> module_endomorphism K addK mulK X addX smulX u -> module_endomorphism K addK mulK X addX smulX v -> endomorphism_determinant K addK mulK X addX smulX p a u = endomorphism_determinant K addK mulK X addX smulX p b u /\ endomorphism_determinant K addK mulK X addX smulX p a (fun x => u (v x)) = mulK (endomorphism_determinant K addK mulK X addX smulX p a u) (endomorphism_determinant K addK mulK X addX smulX p a v) /\ endomorphism_determinant K addK mulK X addX smulX p a (fun x => x) = ring_one K mulK.
Axiom god1_right_basis_as_module_basis_for_same_scalar : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , left_module K addK mulK M addM smul -> right_module_basis K addK mulK M addM (fun x scalar => smul scalar x) I a -> module_basis K addK mulK M addM smul I a.
Axiom god1_basis_coordinate_matrix_in : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall p , forall a x : set -> set , module_basis K addK mulK X addX smulX p a -> (forall i :e p , x i :e X) -> basis_coordinate_matrix K addK mulK X addX smulX p a x :e square_matrix_ring K p.
Axiom god1_matrix_determinant_unit_matrix : forall K , forall add mul : set -> set -> set , forall p :e omega , commutative_ring K add mul -> matrix_determinant K add mul p (unit_matrix K add mul p) = ring_one K mul.
Axiom god1_invertible_matrix_determinant_nonzero : forall K , forall add mul : set -> set -> set , forall p :e omega , forall A :e square_matrix_ring K p , commutative_ring K add mul -> ring_one K mul <> ring_zero K add -> invertible_matrix K add mul p A -> matrix_determinant K add mul p A <> ring_zero K add.
Axiom god1_s19_theorem10_basis_iff_independent_and_dimension : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , forall n :e omega , forall x : set -> set , right_vector_space K addK mulK M addM smulR -> (right_module_basis K addK mulK M addM smulR n x <-> linearly_independent_family K addK (opposite_ring_multiplication mulK) M addM (fun scalar y => smulR y scalar) n x /\ finite_dimensional_right_vector_space K addK mulK M addM smulR /\ right_vector_dimension K addK mulK M addM smulR = n).
Axiom god1_s23_theorem8_basis_determinant_criterion : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall p :e omega , forall a x : set -> set , field K addK mulK -> module_basis K addK mulK X addX smulX p a -> (forall i :e p , x i :e X) -> (linearly_independent_family K addK mulK X addX smulX p x <-> module_basis K addK mulK X addX smulX p x) /\ (module_basis K addK mulK X addX smulX p x <-> invertible_matrix K addK mulK p (basis_coordinate_matrix K addK mulK X addX smulX p a x)) /\ (invertible_matrix K addK mulK p (basis_coordinate_matrix K addK mulK X addX smulX p a x) <-> matrix_determinant K addK mulK p (basis_coordinate_matrix K addK mulK X addX smulX p a x) <> ring_zero K addK).
Axiom god1_s23_theorem8_corollary1_matrix_invertible_iff_determinant_nonzero : forall K , forall add mul : set -> set -> set , forall p :e omega , forall A :e square_matrix_ring K p , field K add mul -> (invertible_matrix K add mul p A <-> matrix_determinant K add mul p A <> ring_zero K add).
Axiom god1_s23_theorem8_corollary2_endomorphism_conditions : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall p :e omega , forall a : set -> set , forall u : set -> set , field K addK mulK -> module_basis K addK mulK X addX smulX p a -> module_endomorphism K addK mulK X addX smulX u -> (bij X X u <-> surj X X u) /\ (surj X X u <-> inj X X u) /\ (inj X X u <-> module_homomorphism_kernel K addK mulK X addX smulX X addX smulX u = {module_zero X addX}) /\ (bij X X u <-> endomorphism_determinant K addK mulK X addX smulX p a u <> ring_zero K addK).
Axiom god1_homogeneous_solution_iff_associated_space_member : forall K , forall add mul : set -> set -> set , forall n p :e omega , forall A :e matrix_space K n p , ring K add mul -> forall x :e K :^: p , (homogeneous_linear_system_solution K add mul n p A x <-> x :e associated_homogeneous_solution_space K add mul n p A).
Axiom god1_s20_theorem2_singularity_and_cramer_interfaces : forall K , forall add mul : set -> set -> set , forall n :e omega , forall A :e square_matrix_ring K n , division_ring K add mul -> (((exists x :e K :^: n , homogeneous_linear_system_solution K add mul n n A x /\ x <> (fun i :e n => ring_zero K add)) <-> not (invertible_matrix K add mul n A)) /\ (cramer_linear_system K add mul n n A <-> invertible_matrix K add mul n A)).
Axiom god1_s23_theorem8_corollary3_homogeneous_square_system : forall K , forall add mul : set -> set -> set , forall n :e omega , forall A :e square_matrix_ring K n , field K add mul -> ((exists x :e K :^: n , homogeneous_linear_system_solution K add mul n n A x /\ x <> (fun i :e n => ring_zero K add)) <-> matrix_determinant K add mul n A = ring_zero K add).
Axiom god1_s23_theorem8_corollary4_cramer_determinant_criterion : forall K , forall add mul : set -> set -> set , forall n :e omega , forall A :e square_matrix_ring K n , field K add mul -> (cramer_linear_system K add mul n n A <-> matrix_determinant K add mul n A <> ring_zero K add).
Definition strictly_increasing_index_tuple : set -> set -> set -> prop := fun n p idx => idx :e n :^: p /\ forall i j :e p , i :e j -> idx i :e idx j.
Definition selected_coordinate_matrix : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> (set -> set) -> (set -> set) -> (set -> set) -> set := fun K addK mulK X addX smulX n p a idx x => fun u :e p :*: p => basis_coordinates K addK mulK X addX smulX n a (x (u 1)) (idx (u 0)).
Axiom god1_selected_coordinate_determinant_as_exterior_product : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall n , forall p :e omega , forall a : set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX n a -> forall idx :e n :^: p , forall x :e X :^: p , matrix_determinant K addK mulK p (selected_coordinate_matrix K addK mulK X addX smulX n p a (fun h => idx h) (fun j => x j)) = exterior_product_linear_forms K addK mulK X p (fun h => god1_basis_coordinate_function_family K addK mulK X addX smulX n a (idx h)) x.
Definition alternating_basis_coefficient_conditions : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> (set -> set) -> (set -> set) -> prop := fun K addK mulK X addX smulX M addM smulM n p a f => (forall idx :e n :^: p , (exists i j :e p , i <> j /\ idx i = idx j) -> f (fun h :e p => a (idx h)) = module_zero M addM) /\ forall idx :e n :^: p , forall sigma :e permutation_group p , f (fun h :e p => a (idx (sigma h))) = smulM (signature_scalar K addK mulK p sigma) (f (fun h :e p => a (idx h))).
Axiom god1_s23_theorem9_alternating_coefficient_characterization_and_expansion : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall n p :e omega , forall a : set -> set , forall f : set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX n a -> left_module K addK mulK M addM smulM -> multilinear_mapping K addK mulK p (fun i => X) (fun i => addX) (fun i => smulX) M addM smulM f -> 0 :e p -> (alternating_multilinear_mapping K addK mulK p X addX smulX M addM smulM f <-> alternating_basis_coefficient_conditions K addK mulK X addX smulX M addM smulM n p a f) /\ (alternating_basis_coefficient_conditions K addK mulK X addX smulX M addM smulM n p a f -> forall x :e X :^: p , f x = module_finitely_supported_sum M addM {idx :e n :^: p|strictly_increasing_index_tuple n p idx} (fun idx => smulM (matrix_determinant K addK mulK p (selected_coordinate_matrix K addK mulK X addX smulX n p a (fun h => idx h) (fun j => x j))) (f (fun h :e p => a (idx h))))).
Definition family_coordinate_matrix : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> (set -> set) -> (set -> set) -> set := fun K addK mulK X addX smulX n p a x => fun u :e n :*: p => basis_coordinates K addK mulK X addX smulX n a (x (u 1)) (u 0).
Axiom god1_family_coordinate_submatrix_is_selected_coordinate_matrix : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall n p :e omega , forall a x : set -> set , forall rows :e n :^: p , module_basis K addK mulK X addX smulX n a -> (forall j :e p , x j :e X) -> matrix_submatrix p p (fun i => rows i) (fun j => j) (family_coordinate_matrix K addK mulK X addX smulX n p a x) = selected_coordinate_matrix K addK mulK X addX smulX n p a (fun i => rows i) (fun j => x j).
Axiom god1_s23_theorem10_linear_independence_by_alternating_form_and_minor : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall n p :e omega , forall a x : set -> set , field K addK mulK -> module_basis K addK mulK X addX smulX n a -> (forall j :e p , x j :e X) -> 0 :e p -> (linearly_independent_family K addK mulK X addX smulX p x <-> exists f :e alternating_multilinear_mapping_space K addK mulK p X addX smulX K addK mulK , f (fun j :e p => x j) <> ring_zero K addK) /\ ((exists f :e alternating_multilinear_mapping_space K addK mulK p X addX smulX K addK mulK , f (fun j :e p => x j) <> ring_zero K addK) <-> exists rows :e n :^: p , inj p n (fun i => rows i) /\ matrix_determinant K addK mulK p (matrix_submatrix p p (fun i => rows i) (fun j => j) (family_coordinate_matrix K addK mulK X addX smulX n p a x)) <> ring_zero K addK).
Definition augmented_consistency_matrix : set -> set -> set -> set -> set := fun r A b j => fun u :e ordsucc r :*: ordsucc r => if u 0 :e r then if u 1 :e r then matrix_entry A (u 0) (u 1) else b (u 0) else if u 1 :e r then matrix_entry A j (u 1) else b j.
Axiom god1_rank_sized_independent_prefix_spans_right_family : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , forall p r :e omega , forall x : set -> set , right_vector_space K addK mulK M addM smulR -> r c= p -> (forall j :e p , x j :e M) -> right_vector_family_rank K addK mulK M addM smulR p x = r -> linearly_independent_family K addK (opposite_ring_multiplication mulK) M addM (fun scalar z => smulR z scalar) r x -> forall j :e p , x j :e submodule_generated_by_family K addK (opposite_ring_multiplication mulK) M addM (fun scalar z => smulR z scalar) r x.
Axiom god1_generated_member_chosen_linear_representation : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , forall x , left_module K addK mulK M addM smul -> x :e submodule_generated_by_family K addK mulK M addM smul I a -> linear_representation K addK mulK M addM smul I a x (fun i => basis_coordinates K addK mulK M addM smul I a x i).
Axiom god1_s20_section5_zero_free_variables_interface : forall K , forall add mul : set -> set -> set , forall n p r :e omega , forall A :e matrix_space K n p , forall b :e K :^: n , field K add mul -> r c= n -> r c= p -> linear_system_rank K add mul n p A = r -> matrix_determinant K add mul r (matrix_submatrix r r (fun i => i) (fun j => j) A) <> ring_zero K add -> (exists y :e K :^: p , linear_system_solution K add mul n p A b y) -> exists x :e K :^: p , linear_system_solution K add mul n p A b x /\ forall k :e p , k /:e r -> x k = ring_zero K add.
Axiom god1_s23_theorem11_consistency_by_augmented_determinants : forall K , forall add mul : set -> set -> set , forall n p r :e omega , forall A :e matrix_space K n p , forall b :e K :^: n , field K add mul -> r c= n -> r c= p -> linear_system_rank K add mul n p A = r -> matrix_determinant K add mul r (matrix_submatrix r r (fun i => i) (fun j => j) A) <> ring_zero K add -> ((exists x :e K :^: p , linear_system_solution K add mul n p A b x) <-> forall j :e n , not (j :e r) -> matrix_determinant K add mul (ordsucc r) (augmented_consistency_matrix r A b j) = ring_zero K add).
Definition matrix_from_columns : set -> set -> (set -> set) -> set := fun K n x => fun u :e n :*: n => x (u 1) (u 0).
Definition matrix_from_rows : set -> set -> (set -> set) -> set := fun K n x => fun u :e n :*: n => x (u 0) (u 1).
Definition matrix_add_linear_combination_to_column : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set -> (set -> set) -> set := fun K add mul n A j coeff => fun u :e n :*: n => if u 1 = j then add (matrix_entry A (u 0) j) (ring_finite_sum K add n (fun k => mul (matrix_entry A (u 0) k) (coeff k))) else matrix_entry A (u 0) (u 1).
Axiom god1_s24_fundamental_determinant_properties : forall K , forall add mul : set -> set -> set , forall n :e omega , commutative_ring K add mul -> alternating_multilinear_mapping K add mul n (K :^: n) (module_power_addition n add) (module_power_left_scalar n mul) K add mul (fun x => matrix_determinant K add mul n (matrix_from_columns K n (fun j => x j))) /\ alternating_multilinear_mapping K add mul n (K :^: n) (module_power_addition n add) (module_power_left_scalar n mul) K add mul (fun x => matrix_determinant K add mul n (matrix_from_rows K n (fun i => x i))) /\ forall A :e square_matrix_ring K n , forall j :e n , forall coeff :e K :^: n , coeff j = ring_zero K add -> matrix_determinant K add mul n (matrix_add_linear_combination_to_column K add mul n A j (fun k => coeff k)) = matrix_determinant K add mul n A.
Definition skip_ordinal_index : set -> set -> set -> set := fun n i k => if k :e n then if k :e i then k else ordsucc k else 0.
Definition matrix_minor : set -> set -> set -> set -> set := fun n i j A => matrix_submatrix n n (skip_ordinal_index n i) (skip_ordinal_index n j) A.
Definition cofactor_sign_scalar : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set := fun K add mul k => if exists h :e omega , k = 2 * h then ring_one K mul else ring_negation K add (ring_one K mul).
Definition matrix_cofactor : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set -> set -> set := fun K add mul n i j A => mul (cofactor_sign_scalar K add mul (i + j)) (matrix_determinant K add mul n (matrix_minor n i j A)).
Definition god1_successor_family_insert : set -> set -> set -> set -> set := fun n j u x => fun q :e ordsucc n => if q = j then u else x (inv n (fun k => skip_ordinal_index n j k) q).
Axiom god1_s24_theorem1_laplace_expansion_along_row_or_column : forall K , forall add mul : set -> set -> set , forall n :e omega , forall A :e square_matrix_ring K (ordsucc n) , commutative_ring K add mul -> (forall j :e ordsucc n , matrix_determinant K add mul (ordsucc n) A = ring_finite_sum K add (ordsucc n) (fun i => mul (matrix_entry A i j) (matrix_cofactor K add mul n i j A))) /\ forall i :e ordsucc n , matrix_determinant K add mul (ordsucc n) A = ring_finite_sum K add (ordsucc n) (fun j => mul (matrix_entry A i j) (matrix_cofactor K add mul n i j A)).
Definition upper_triangular_matrix : set -> (set -> set -> set) -> set -> set -> prop := fun K add n A => A :e square_matrix_ring K n /\ forall i j :e n , j :e i -> matrix_entry A i j = ring_zero K add.
Definition matrix_adjugate : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set := fun K add mul n A => fun u :e ordsucc n :*: ordsucc n => matrix_cofactor K add mul n (u 1) (u 0) A.
Axiom god1_s24_theorem2_adjugate_identity : forall K , forall add mul : set -> set -> set , forall n :e omega , forall A :e square_matrix_ring K (ordsucc n) , commutative_ring K add mul -> matrix_multiplication K add mul (ordsucc n) (ordsucc n) (ordsucc n) A (matrix_adjugate K add mul n A) = matrix_left_scalar K mul (ordsucc n) (ordsucc n) (matrix_determinant K add mul (ordsucc n) A) (unit_matrix K add mul (ordsucc n)) /\ matrix_multiplication K add mul (ordsucc n) (ordsucc n) (ordsucc n) (matrix_adjugate K add mul n A) A = matrix_left_scalar K mul (ordsucc n) (ordsucc n) (matrix_determinant K add mul (ordsucc n) A) (unit_matrix K add mul (ordsucc n)).
Axiom god1_s24_theorem2_corollary1_invertible_iff_determinant_unit : forall K , forall add mul : set -> set -> set , forall n :e omega , forall A :e square_matrix_ring K (ordsucc n) , commutative_ring K add mul -> (invertible_matrix K add mul (ordsucc n) A <-> ring_unit K add mul (matrix_determinant K add mul (ordsucc n) A)) /\ (ring_unit K add mul (matrix_determinant K add mul (ordsucc n) A) -> matrix_inverse K add mul (ordsucc n) A = matrix_left_scalar K mul (ordsucc n) (ordsucc n) (ring_inverse K add mul (matrix_determinant K add mul (ordsucc n) A)) (matrix_adjugate K add mul n A)).
Axiom god1_invertible_matrix_iff_determinant_unit_all_orders : forall K , forall add mul : set -> set -> set , forall p :e omega , forall A :e square_matrix_ring K p , commutative_ring K add mul -> (invertible_matrix K add mul p A <-> ring_unit K add mul (matrix_determinant K add mul p A)).
Axiom god1_module_basis_iff_coordinate_matrix_invertible : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall p :e omega , forall a x : set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX p a -> (forall i :e p , x i :e X) -> (module_basis K addK mulK X addX smulX p x <-> invertible_matrix K addK mulK p (basis_coordinate_matrix K addK mulK X addX smulX p a x)).
Axiom god1_s24_theorem2_corollary2_basis_iff_determinant_unit : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall n :e omega , forall a x : set -> set , commutative_ring K addK mulK -> module_basis K addK mulK X addX smulX n a -> (forall i :e n , x i :e X) -> (module_basis K addK mulK X addX smulX n x <-> ring_unit K addK mulK (determinant_of_vectors_in_basis K addK mulK X addX smulX n a x)).
Definition matrix_replace_column : set -> set -> set -> set -> set := fun n A j b => fun u :e n :*: n => if u 1 = j then b (u 0) else matrix_entry A (u 0) (u 1).
Axiom god1_matrix_left_scalar_entry_eval : forall K , forall mul : set -> set -> set , forall p q scalar A , forall i :e p , forall j :e q , matrix_entry (matrix_left_scalar K mul p q scalar A) i j = mul scalar (matrix_entry A i j).
Axiom god1_matrix_adjugate_entry_eval : forall K , forall add mul : set -> set -> set , forall n A , forall i j :e ordsucc n , matrix_entry (matrix_adjugate K add mul n A) i j = matrix_cofactor K add mul n j i A.
Axiom god1_matrix_replace_column_entry_eval : forall n A i b , forall r c :e n , matrix_entry (matrix_replace_column n A i b) r c = if c = i then b r else matrix_entry A r c.
Axiom god1_skip_ordinal_index_in_successor : forall n :e omega , forall i :e ordsucc n , forall k :e n , skip_ordinal_index n i k :e ordsucc n.
Axiom god1_skip_ordinal_index_avoids_omitted : forall n :e omega , forall i :e ordsucc n , forall k :e n , skip_ordinal_index n i k <> i.
Axiom god1_matrix_minor_in : forall K , forall n :e omega , forall B :e square_matrix_ring K (ordsucc n) , forall r c :e ordsucc n , matrix_minor n r c B :e square_matrix_ring K n.
Axiom god1_cofactor_sign_scalar_in : forall K , forall add mul : set -> set -> set , ring K add mul -> forall k , cofactor_sign_scalar K add mul k :e K.
Axiom god1_matrix_cofactor_in : forall K , forall add mul : set -> set -> set , forall n :e omega , forall A :e square_matrix_ring K (ordsucc n) , forall i j :e ordsucc n , commutative_ring K add mul -> matrix_cofactor K add mul n i j A :e K.
Axiom god1_matrix_replace_column_in : forall K n , forall A :e square_matrix_ring K n , forall i :e n , forall b :e K :^: n , matrix_replace_column n A i b :e square_matrix_ring K n.
Axiom god1_matrix_minor_replace_deleted_column : forall K , forall n :e omega , forall A :e square_matrix_ring K (ordsucc n) , forall b :e K :^: ordsucc n , forall i r :e ordsucc n , matrix_minor n r i (matrix_replace_column (ordsucc n) A i b) = matrix_minor n r i A.
Axiom god1_matrix_cofactor_replace_deleted_column : forall K , forall add mul : set -> set -> set , forall n :e omega , forall A :e square_matrix_ring K (ordsucc n) , forall b :e K :^: ordsucc n , forall i r :e ordsucc n , matrix_cofactor K add mul n r i (matrix_replace_column (ordsucc n) A i b) = matrix_cofactor K add mul n r i A.
Axiom god1_matrix_replace_column_determinant_laplace : forall K , forall add mul : set -> set -> set , forall n :e omega , forall A :e square_matrix_ring K (ordsucc n) , forall b :e K :^: ordsucc n , forall i :e ordsucc n , commutative_ring K add mul -> matrix_determinant K add mul (ordsucc n) (matrix_replace_column (ordsucc n) A i b) = ring_finite_sum K add (ordsucc n) (fun r => mul (matrix_cofactor K add mul n r i A) (b r)).
Axiom god1_commutative_ring_finite_sum_left_mul : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall n :e omega , forall f : set -> set , (forall i :e n , f i :e K) -> forall z :e K , mul z (ring_finite_sum K add n f) = ring_finite_sum K add n (fun i => mul z (f i)).
Axiom god1_s24_cramer_formulae : forall K , forall add mul : set -> set -> set , forall n :e omega , forall A :e square_matrix_ring K n , forall b :e K :^: n , commutative_ring K add mul -> ring_unit K add mul (matrix_determinant K add mul n A) -> linear_system_unique_solution K add mul n n A b /\ forall x :e K :^: n , linear_system_solution K add mul n n A b x -> forall i :e n , mul (matrix_determinant K add mul n A) (x i) = matrix_determinant K add mul n (matrix_replace_column n A i b) /\ x i = mul (ring_inverse K add mul (matrix_determinant K add mul n A)) (matrix_determinant K add mul n (matrix_replace_column n A i b)).
Definition affine_space : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> prop := fun K addK mulK T addT smulT E action => left_vector_space K addK mulK T addT smulT /\ E <> 0 /\ (forall s :e T , forall P :e E , action s P :e E) /\ (forall s t :e T , forall P :e E , action s (action t P) = action (addT s t) P) /\ (forall P :e E , action (module_zero T addT) P = P) /\ forall P Q :e E , exists s :e T , action s P = Q /\ forall t :e T , action t P = Q -> t = s.
Definition affine_translation : set -> set -> (set -> set -> set) -> set -> set := fun E T action s => fun P :e E => action s P.
Definition affine_difference : set -> set -> (set -> set -> set) -> set -> set -> set := fun T E action P Q => Eps_i (fun s => s :e T /\ action s P = Q).
Definition affine_origin : set -> set := fun E => Eps_i (fun O => O :e E).
Definition affine_origin_addition : set -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> set -> set -> set := fun T addT E action O P Q => action (addT (affine_difference T E action O P) (affine_difference T E action O Q)) O.
Definition affine_origin_scalar : set -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> set -> set -> set := fun T smulT E action O scalar P => action (smulT scalar (affine_difference T E action O P)) O.
Axiom god1_abelian_group_transport_by_two_sided_inverse : forall M , forall addM : set -> set -> set , forall N , forall f g : set -> set , abelian_group M addM -> (forall x :e M , f x :e N) -> (forall y :e N , g y :e M) -> (forall x :e M , g (f x) = x) -> (forall y :e N , f (g y) = y) -> abelian_group N (fun x y => f (addM (g x) (g y))).
Axiom god1_left_module_transport_by_two_sided_inverse : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall N , forall f g : set -> set , left_module K addK mulK M addM smulM -> (forall x :e M , f x :e N) -> (forall y :e N , g y :e M) -> (forall x :e M , g (f x) = x) -> (forall y :e N , f (g y) = y) -> left_module K addK mulK N (fun x y => f (addM (g x) (g y))) (fun scalar x => f (smulM scalar (g x))) /\ module_isomorphism K addK mulK M addM smulM N (fun x y => f (addM (g x) (g y))) (fun scalar x => f (smulM scalar (g x))) f.
Axiom god1_affine_space_with_origin_is_vector_space : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall O :e E , affine_space K addK mulK T addT smulT E action -> left_vector_space K addK mulK E (affine_origin_addition T addT E action O) (affine_origin_scalar T smulT E action O) /\ module_isomorphism K addK mulK T addT smulT E (affine_origin_addition T addT E action O) (affine_origin_scalar T smulT E action O) (fun s => action s O).
Axiom god1_affine_space_axiom_bundle : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , affine_space K addK mulK T addT smulT E action -> left_vector_space K addK mulK T addT smulT /\ ((E <> 0) /\ ((forall s :e T , forall P :e E , action s P :e E) /\ ((forall s t :e T , forall P :e E , action s (action t P) = action (addT s t) P) /\ ((forall P :e E , action (module_zero T addT) P = P) /\ (forall P Q :e E , exists s :e T , action s P = Q /\ forall t :e T , action t P = Q -> t = s))))).
Axiom god1_affine_origin_in : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , affine_space K addK mulK T addT smulT E action -> affine_origin E :e E.
Axiom god1_affine_difference_specification : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , affine_space K addK mulK T addT smulT E action -> forall P Q :e E , affine_difference T E action P Q :e T /\ (action (affine_difference T E action P Q) P = Q /\ forall s :e T , action s P = Q -> s = affine_difference T E action P Q).
Axiom god1_affine_difference_cocycle : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , affine_space K addK mulK T addT smulT E action -> forall P Q R :e E , affine_difference T E action P R = addT (affine_difference T E action Q R) (affine_difference T E action P Q).
Axiom god1_affine_difference_self : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , affine_space K addK mulK T addT smulT E action -> forall P :e E , affine_difference T E action P P = module_zero T addT.
Axiom god1_module_fixed_vector_scalar_additive_group_homomorphism : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , left_module K addK mulK M addM smul -> forall x :e M , group_homomorphism K addK M addM (fun scalar => smul scalar x).
Definition affine_coefficients_sum_one : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> prop := fun K add mul I coeff => (fun i :e I => coeff i) :e K :^: I /\ ring_finite_sum K add I (fun i => coeff i) = ring_one K mul.
Definition affine_barycenter : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set) -> set := fun T addT smulT E action I P coeff => action (module_finitely_supported_sum T addT I (fun i => smulT (coeff i) (affine_difference T E action (affine_origin E) (P i)))) (affine_origin E).
Axiom god1_affine_weighted_difference_change_origin : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall I , forall P : set -> set , forall coeff : set -> set , affine_space K addK mulK T addT smulT E action -> finite I -> (forall i :e I , P i :e E) -> affine_coefficients_sum_one K addK mulK I coeff -> forall O Oprime :e E , module_finitely_supported_sum T addT I (fun i => smulT (coeff i) (affine_difference T E action Oprime (P i))) = addT (module_finitely_supported_sum T addT I (fun i => smulT (coeff i) (affine_difference T E action O (P i)))) (affine_difference T E action Oprime O).
Axiom god1_affine_barycenter_is_origin_independent : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall I , forall P : set -> set , forall coeff : set -> set , affine_space K addK mulK T addT smulT E action -> finite I -> (forall i :e I , P i :e E) -> affine_coefficients_sum_one K addK mulK I coeff -> forall O :e E , affine_difference T E action O (affine_barycenter T addT smulT E action I P coeff) = module_finitely_supported_sum T addT I (fun i => smulT (coeff i) (affine_difference T E action O (P i))).
Axiom god1_affine_barycenter_in : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall I , forall P : set -> set , forall coeff : set -> set , affine_space K addK mulK T addT smulT E action -> finite I -> (forall i :e I , P i :e E) -> affine_coefficients_sum_one K addK mulK I coeff -> affine_barycenter T addT smulT E action I P coeff :e E.
Axiom god1_affine_flattened_coefficients_sum_one : forall K , forall addK mulK : set -> set -> set , forall I J , forall mu : set -> set , forall lambda : set -> set -> set , ring K addK mulK -> finite I -> finite J -> affine_coefficients_sum_one K addK mulK I mu -> (forall i :e I , affine_coefficients_sum_one K addK mulK J (fun j => lambda i j)) -> affine_coefficients_sum_one K addK mulK (I :*: J) (fun u => mulK (mu (u 0)) (lambda (u 0) (u 1))).
Axiom god1_module_finite_double_sum_scalar_distributivity : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I J , forall mu : set -> set , forall lambda : set -> set -> set , forall x : set -> set -> set , left_module K addK mulK M addM smul -> finite I -> finite J -> (forall i :e I , mu i :e K) -> (forall i :e I , forall j :e J , lambda i j :e K) -> (forall i :e I , forall j :e J , x i j :e M) -> module_finitely_supported_sum M addM I (fun i => smul (mu i) (module_finitely_supported_sum M addM J (fun j => smul (lambda i j) (x i j)))) = module_finitely_supported_sum M addM (I :*: J) (fun u => smul (mulK (mu (u 0)) (lambda (u 0) (u 1))) (x (u 0) (u 1))).
Axiom god1_affine_difference_base_injective : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , affine_space K addK mulK T addT smulT E action -> forall O P Q :e E , affine_difference T E action O P = affine_difference T E action O Q -> P = Q.
Axiom god1_affine_barycenter_distributive_law : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall I J , forall P : set -> set -> set , forall mu : set -> set , forall lambda : set -> set -> set , affine_space K addK mulK T addT smulT E action -> finite I -> finite J -> (forall i :e I , forall j :e J , P i j :e E) -> affine_coefficients_sum_one K addK mulK I mu -> (forall i :e I , affine_coefficients_sum_one K addK mulK J (fun j => lambda i j)) -> affine_barycenter T addT smulT E action I (fun i => affine_barycenter T addT smulT E action J (fun j => P i j) (fun j => lambda i j)) mu = affine_barycenter T addT smulT E action (I :*: J) (fun u => P (u 0) (u 1)) (fun u => mulK (mu (u 0)) (lambda (u 0) (u 1))).
Definition affine_linear_variety : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> prop := fun K addK mulK T addT smulT E action V => affine_space K addK mulK T addT smulT E action /\ V c= E /\ forall n :e omega , forall P :e V :^: n , forall coeff : set -> set , affine_coefficients_sum_one K addK mulK n coeff -> affine_barycenter T addT smulT E action n (fun i => P i) coeff :e V.
Definition affine_span : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> (set -> set) -> set := fun K addK mulK T addT smulT E action I P => {Q :e E|forall V , affine_linear_variety K addK mulK T addT smulT E action V -> (forall i :e I , P i :e V) -> Q :e V}.
Definition affine_displacement_set : set -> set -> (set -> set -> set) -> set -> set -> set := fun T E action V O => {s :e T|exists P :e V , s = affine_difference T E action O P}.
Definition affine_director_subspace : set -> set -> (set -> set -> set) -> set -> set := fun T E action V => {s :e T|exists P Q :e V , s = affine_difference T E action P Q}.
Axiom god1_affine_difference_reverse : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , affine_space K addK mulK T addT smulT E action -> forall P Q :e E , affine_difference T E action P Q = module_negation T addT (affine_difference T E action Q P).
Axiom god1_affine_difference_change_origin_with_negation : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , affine_space K addK mulK T addT smulT E action -> forall P O Oprime :e E , affine_difference T E action O P = addT (affine_difference T E action Oprime P) (module_negation T addT (affine_difference T E action Oprime O)).
Axiom god1_affine_displacement_set_equal_from_subspace : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall V , affine_space K addK mulK T addT smulT E action -> V c= E -> forall O Oprime :e V , vector_subspace K addK mulK T addT smulT (affine_displacement_set T E action V O) -> affine_displacement_set T E action V O = affine_displacement_set T E action V Oprime.
Axiom god1_ring_finite_sum_three : forall K , forall add mul : set -> set -> set , ring K add mul -> forall f : set -> set , f 0 :e K -> f 1 :e K -> f 2 :e K -> ring_finite_sum K add 3 f = add (add (f 0) (f 1)) (f 2).
Axiom god1_abelian_finite_sum_three : forall G , forall add : set -> set -> set , abelian_group G add -> forall f : set -> set , f 0 :e G -> f 1 :e G -> f 2 :e G -> ring_finite_sum G add 3 f = add (add (f 0) (f 1)) (f 2).
Axiom god1_module_finitely_supported_sum_three : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , left_module K addK mulK M addM smul -> forall f : set -> set , f 0 :e M -> f 1 :e M -> f 2 :e M -> module_finitely_supported_sum M addM 3 f = addM (addM (f 0) (f 1)) (f 2).
Axiom god1_affine_three_coefficients_sum_one : forall K , forall add mul : set -> set -> set , ring K add mul -> forall lambda mu :e K , affine_coefficients_sum_one K add mul 3 (fun i => if i = 0 then lambda else if i = 1 then mu else add (ring_one K mul) (ring_negation K add (add lambda mu))).
Axiom god1_affine_barycenter_point_family_congr_finite_index : forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall I , finite I -> forall P Q : set -> set , forall coeff : set -> set , (forall i :e I , P i = Q i) -> affine_barycenter T addT smulT E action I P coeff = affine_barycenter T addT smulT E action I Q coeff.
Axiom god1_affine_three_point_barycenter_displacement : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , affine_space K addK mulK T addT smulT E action -> forall O Q R :e E , forall lambda mu :e K , affine_difference T E action O (affine_barycenter T addT smulT E action 3 (fun i => if i = 0 then Q else if i = 1 then R else O) (fun i => if i = 0 then lambda else if i = 1 then mu else addK (ring_one K mulK) (ring_negation K addK (addK lambda mu)))) = addT (smulT lambda (affine_difference T E action O Q)) (smulT mu (affine_difference T E action O R)).
Axiom god1_affine_linear_variety_displacement_subspace : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall V , affine_space K addK mulK T addT smulT E action -> V c= E -> affine_linear_variety K addK mulK T addT smulT E action V -> forall O :e V , vector_subspace K addK mulK T addT smulT (affine_displacement_set T E action V O).
Axiom god1_affine_displacement_subspace_implies_linear_variety : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall V , affine_space K addK mulK T addT smulT E action -> V c= E -> forall O :e V , vector_subspace K addK mulK T addT smulT (affine_displacement_set T E action V O) -> affine_linear_variety K addK mulK T addT smulT E action V.
Axiom god1_affine_displacement_subspace_equals_director : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall V , affine_space K addK mulK T addT smulT E action -> V c= E -> forall O :e V , vector_subspace K addK mulK T addT smulT (affine_displacement_set T E action V O) -> affine_displacement_set T E action V O = affine_director_subspace T E action V.
Axiom god1_affine_director_translation_invariance : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall V , affine_space K addK mulK T addT smulT E action -> V c= E -> V <> 0 -> affine_linear_variety K addK mulK T addT smulT E action V -> affine_director_subspace T E action V = {s :e T|forall P :e V , action s P :e V}.
Axiom god1_affine_linear_variety_displacement_combination : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall V , affine_space K addK mulK T addT smulT E action -> V c= E -> affine_linear_variety K addK mulK T addT smulT E action V -> forall O Q R :e V , forall lambda mu :e K , exists S :e V , affine_difference T E action O S = addT (smulT lambda (affine_difference T E action O Q)) (smulT mu (affine_difference T E action O R)).
Axiom god1_translation_invariance_implies_affine_director : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall V , affine_space K addK mulK T addT smulT E action -> V c= E -> V <> 0 -> forall s :e T , (forall P :e V , action s P :e V) -> s :e affine_director_subspace T E action V.
Axiom god1_s25_theorem1_characterization_of_nonempty_linear_varieties : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall V , affine_space K addK mulK T addT smulT E action -> V c= E -> V <> 0 -> (affine_linear_variety K addK mulK T addT smulT E action V <-> forall O :e V , vector_subspace K addK mulK T addT smulT (affine_displacement_set T E action V O)) /\ ((forall O :e V , vector_subspace K addK mulK T addT smulT (affine_displacement_set T E action V O)) <-> exists O :e V , vector_subspace K addK mulK T addT smulT (affine_displacement_set T E action V O)) /\ (affine_linear_variety K addK mulK T addT smulT E action V -> (forall O :e V , affine_displacement_set T E action V O = affine_director_subspace T E action V) /\ affine_director_subspace T E action V = {s :e T|forall P :e V , action s P :e V}).
Axiom god1_s25_theorem1_displacement_characterization_interface : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall V , affine_space K addK mulK T addT smulT E action -> V c= E -> V <> 0 -> (affine_linear_variety K addK mulK T addT smulT E action V <-> exists O :e V , vector_subspace K addK mulK T addT smulT (affine_displacement_set T E action V O)).
Axiom god1_affine_translation_preserves_difference : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , affine_space K addK mulK T addT smulT E action -> forall P0 P Q0 :e E , affine_difference T E action P0 P = affine_difference T E action Q0 (action (affine_difference T E action P0 Q0) P).
Axiom god1_linear_varieties_with_same_director_are_translates : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall V W , affine_space K addK mulK T addT smulT E action -> affine_linear_variety K addK mulK T addT smulT E action V -> affine_linear_variety K addK mulK T addT smulT E action W -> V <> 0 -> W <> 0 -> affine_director_subspace T E action V = affine_director_subspace T E action W -> exists s :e T , {action s P|P :e V} = W.
Definition affine_line : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> set -> set := fun K addK mulK T addT smulT E action P Q => affine_span K addK mulK T addT smulT E action 2 (fun i => if i = 0 then P else Q).
Axiom god1_s25_example10_line_minimality_interface : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall V , forall P Q :e V , affine_linear_variety K addK mulK T addT smulT E action V -> affine_line K addK mulK T addT smulT E action P Q c= V.
Axiom god1_module_finitely_supported_sum_two : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , left_module K addK mulK M addM smul -> forall f : set -> set , f 0 :e M -> f 1 :e M -> module_finitely_supported_sum M addM 2 f = addM (f 0) (f 1).
Axiom god1_affine_two_coefficients_sum_one : forall K , forall add mul : set -> set -> set , ring K add mul -> forall lambda :e K , affine_coefficients_sum_one K add mul 2 (fun i => if i = 0 then lambda else add (ring_one K mul) (ring_negation K add lambda)).
Axiom god1_affine_binary_barycenter_displacement : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , affine_space K addK mulK T addT smulT E action -> forall O P Q :e E , forall lambda :e K , affine_difference T E action O (affine_barycenter T addT smulT E action 2 (fun i => if i = 0 then P else Q) (fun i => if i = 0 then lambda else addK (ring_one K mulK) (ring_negation K addK lambda))) = addT (smulT lambda (affine_difference T E action O P)) (smulT (addK (ring_one K mulK) (ring_negation K addK lambda)) (affine_difference T E action O Q)).
Axiom god1_affine_binary_barycenter_in_line : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , affine_space K addK mulK T addT smulT E action -> forall P Q :e E , forall lambda :e K , affine_barycenter T addT smulT E action 2 (fun i => if i = 0 then P else Q) (fun i => if i = 0 then lambda else addK (ring_one K mulK) (ring_negation K addK lambda)) :e affine_line K addK mulK T addT smulT E action P Q.
Axiom god1_affine_binary_barycenter_equal_endpoints : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , affine_space K addK mulK T addT smulT E action -> forall P Q :e E , P = Q -> forall lambda :e K , affine_barycenter T addT smulT E action 2 (fun i => if i = 0 then P else Q) (fun i => if i = 0 then lambda else addK (ring_one K mulK) (ring_negation K addK lambda)) = P.
Axiom god1_line_closed_binary_barycenter_in : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall V , affine_space K addK mulK T addT smulT E action -> V c= E -> (forall P Q :e V , P <> Q -> affine_line K addK mulK T addT smulT E action P Q c= V) -> forall P Q :e V , forall lambda :e K , affine_barycenter T addT smulT E action 2 (fun i => if i = 0 then P else Q) (fun i => if i = 0 then lambda else addK (ring_one K mulK) (ring_negation K addK lambda)) :e V.
Axiom god1_affine_binary_barycenter_from_base_displacement : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , affine_space K addK mulK T addT smulT E action -> forall O Q :e E , forall lambda :e K , affine_difference T E action O (affine_barycenter T addT smulT E action 2 (fun i => if i = 0 then Q else O) (fun i => if i = 0 then lambda else addK (ring_one K mulK) (ring_negation K addK lambda))) = smulT lambda (affine_difference T E action O Q).
Axiom god1_ring_right_distributive_law : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x y z :e K , mul (add x y) z = add (mul x z) (mul y z).
Axiom god1_division_ring_half_data : forall K , forall add mul : set -> set -> set , division_ring K add mul -> add (ring_one K mul) (ring_one K mul) <> ring_zero K add -> let two := add (ring_one K mul) (ring_one K mul) in let half := ring_inverse K add mul two in (half :e K /\ add (ring_one K mul) (ring_negation K add half) = half) /\ mul two half = ring_one K mul.
Axiom god1_module_double_half_sum : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , division_ring K addK mulK -> addK (ring_one K mulK) (ring_one K mulK) <> ring_zero K addK -> left_module K addK mulK M addM smul -> forall x y :e M , smul (addK (ring_one K mulK) (ring_one K mulK)) (addM (smul (ring_inverse K addK mulK (addK (ring_one K mulK) (ring_one K mulK))) x) (smul (ring_inverse K addK mulK (addK (ring_one K mulK) (ring_one K mulK))) y)) = addM x y.
Definition god1_affine_binary_point : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> set -> set -> set := fun K addK mulK T addT smulT E action P Q lambda => affine_barycenter T addT smulT E action 2 (fun i => if i = 0 then P else Q) (fun i => if i = 0 then lambda else addK (ring_one K mulK) (ring_negation K addK lambda)).
Axiom god1_line_closed_displacement_combination : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall V , affine_space K addK mulK T addT smulT E action -> addK (ring_one K mulK) (ring_one K mulK) <> ring_zero K addK -> V c= E -> (forall P Q :e V , P <> Q -> affine_line K addK mulK T addT smulT E action P Q c= V) -> forall O Q R :e V , forall lambda mu :e K , exists S :e V , affine_difference T E action O S = addT (smulT lambda (affine_difference T E action O Q)) (smulT mu (affine_difference T E action O R)).
Axiom god1_empty_subset_is_affine_linear_variety : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall V , affine_space K addK mulK T addT smulT E action -> V c= E -> V = 0 -> affine_linear_variety K addK mulK T addT smulT E action V.
Axiom god1_line_closed_nonempty_displacement_subspace : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall V , affine_space K addK mulK T addT smulT E action -> addK (ring_one K mulK) (ring_one K mulK) <> ring_zero K addK -> V c= E -> (forall P Q :e V , P <> Q -> affine_line K addK mulK T addT smulT E action P Q c= V) -> V <> 0 -> exists O :e V , vector_subspace K addK mulK T addT smulT (affine_displacement_set T E action V O).
Axiom god1_line_closed_subset_is_affine_linear_variety : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall V , affine_space K addK mulK T addT smulT E action -> addK (ring_one K mulK) (ring_one K mulK) <> ring_zero K addK -> V c= E -> (forall P Q :e V , P <> Q -> affine_line K addK mulK T addT smulT E action P Q c= V) -> affine_linear_variety K addK mulK T addT smulT E action V.
Axiom god1_three_coefficients_sum_one_not_all_one : forall K , forall add mul : set -> set -> set , division_ring K add mul -> add (ring_one K mul) (ring_one K mul) <> ring_zero K add -> forall lambda mu nu :e K , add (add lambda mu) nu = ring_one K mul -> lambda <> ring_one K mul \/ (mu <> ring_one K mul \/ nu <> ring_one K mul).
Axiom god1_s25_theorem2_generation_of_linear_variety_by_lines : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall V , affine_space K addK mulK T addT smulT E action -> addK (ring_one K mulK) (ring_one K mulK) <> ring_zero K addK -> V c= E -> (affine_linear_variety K addK mulK T addT smulT E action V <-> forall P Q :e V , P <> Q -> affine_line K addK mulK T addT smulT E action P Q c= V).
Definition affine_space_dimension : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> set := fun K addK mulK T addT smulT E => module_dimension K addK mulK T addT smulT.
Definition affine_variety_dimension : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> set := fun K addK mulK T addT smulT E action V => module_dimension K addK mulK (affine_director_subspace T E action V) addT smulT.
Definition affine_basis : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> (set -> set) -> prop := fun K addK mulK T addT smulT E action n P => (forall i :e ordsucc n , P i :e E) /\ module_basis K addK mulK T addT smulT n (fun i => affine_difference T E action (P 0) (P (ordsucc i))).
Definition affine_coordinates : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> (set -> set) -> set -> set := fun K addK mulK T addT smulT E action n P Q => Eps_i (fun coeff => affine_coefficients_sum_one K addK mulK (ordsucc n) (fun i => coeff i) /\ affine_barycenter T addT smulT E action (ordsucc n) P (fun i => coeff i) = Q).
Definition affinely_independent_family : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> (set -> set) -> prop := fun K addK mulK T addT smulT E action m Q => (forall j :e ordsucc m , Q j :e E) /\ linearly_independent_family K addK mulK T addT smulT m (fun j => affine_difference T E action (Q 0) (Q (ordsucc j))).
Axiom god1_affine_span_whole_iff_no_proper_variety : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall I , forall P : set -> set , (affine_span K addK mulK T addT smulT E action I P = E <-> forall V , affine_linear_variety K addK mulK T addT smulT E action V -> (forall i :e I , P i :e V) -> V = E).
Definition god1_affine_coset_of_vector_subspace : set -> set -> (set -> set -> set) -> set -> set -> set := fun T E action H O => {Q :e E|affine_difference T E action O Q :e H}.
Axiom god1_affine_coset_displacement_set : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall H , affine_space K addK mulK T addT smulT E action -> H c= T -> forall O :e E , affine_displacement_set T E action (god1_affine_coset_of_vector_subspace T E action H O) O = H.
Axiom god1_affine_coset_of_vector_subspace_is_variety : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall H , affine_space K addK mulK T addT smulT E action -> vector_subspace K addK mulK T addT smulT H -> forall O :e E , affine_linear_variety K addK mulK T addT smulT E action (god1_affine_coset_of_vector_subspace T E action H O).
Axiom god1_affine_variety_with_full_displacement_is_whole : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall V , affine_space K addK mulK T addT smulT E action -> V c= E -> affine_linear_variety K addK mulK T addT smulT E action V -> forall O :e V , T c= affine_displacement_set T E action V O -> V = E.
Axiom god1_affine_coset_whole_implies_subspace_whole : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall H , affine_space K addK mulK T addT smulT E action -> H c= T -> forall O :e E , god1_affine_coset_of_vector_subspace T E action H O = E -> H = T.
Axiom god1_s25_theorem3_affine_basis_spanning_characterization : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall n :e omega , forall P : set -> set , affine_space K addK mulK T addT smulT E action -> finite_dimensional_vector_space K addK mulK T addT smulT -> affine_space_dimension K addK mulK T addT smulT E = n -> (forall i :e ordsucc n , P i :e E) -> (affine_basis K addK mulK T addT smulT E action n P <-> affine_span K addK mulK T addT smulT E action (ordsucc n) P = E) /\ (affine_basis K addK mulK T addT smulT E action n P <-> forall V , affine_linear_variety K addK mulK T addT smulT E action V -> (forall i :e ordsucc n , P i :e V) -> V = E).
Axiom god1_finite_nested_left_subspace_dimension_bound : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall L N , finite_dimensional_vector_space K addK mulK T addT smulT -> submodule K addK mulK T addT smulT L -> submodule K addK mulK T addT smulT N -> N c= L -> module_dimension K addK mulK N addT smulT c= module_dimension K addK mulK L addT smulT /\ (module_dimension K addK mulK N addT smulT = module_dimension K addK mulK L addT smulT <-> N = L).
Axiom god1_affine_variety_eq_director_coset : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall V O , affine_space K addK mulK T addT smulT E action -> affine_linear_variety K addK mulK T addT smulT E action V -> O :e V -> V = god1_affine_coset_of_vector_subspace T E action (affine_director_subspace T E action V) O.
Axiom god1_affine_variety_dimension_monotonicity : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall V W , affine_space K addK mulK T addT smulT E action -> finite_dimensional_vector_space K addK mulK T addT smulT -> affine_linear_variety K addK mulK T addT smulT E action V -> affine_linear_variety K addK mulK T addT smulT E action W -> V <> 0 -> V c= W -> affine_variety_dimension K addK mulK T addT smulT E action V c= affine_variety_dimension K addK mulK T addT smulT E action W /\ (affine_variety_dimension K addK mulK T addT smulT E action V = affine_variety_dimension K addK mulK T addT smulT E action W <-> V = W).
Definition affine_coordinate_matrix : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> set -> (set -> set) -> (set -> set) -> set := fun K addK mulK T addT smulT E action m n P Q => fun u :e ordsucc m :*: ordsucc n => affine_coordinates K addK mulK T addT smulT E action m P (Q (u 1)) (u 0).
Axiom god1_affine_coordinate_matrix_entry : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall m n , forall P Q : set -> set , forall i :e ordsucc m , forall j :e ordsucc n , matrix_entry (affine_coordinate_matrix K addK mulK T addT smulT E action m n P Q) i j = affine_coordinates K addK mulK T addT smulT E action m P (Q j) i.
Axiom god1_affine_coordinate_matrix_in : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall m n :e omega , forall P Q : set -> set , (forall j :e ordsucc n , affine_coefficients_sum_one K addK mulK (ordsucc m) (fun i => affine_coordinates K addK mulK T addT smulT E action m P (Q j) i)) -> affine_coordinate_matrix K addK mulK T addT smulT E action m n P Q :e matrix_space K (ordsucc m) (ordsucc n).
Definition affine_difference_matrix : set -> (set -> set -> set) -> set -> set -> set -> set := fun K addK m n A => fun u :e m :*: n => addK (matrix_entry A (ordsucc (u 0)) (ordsucc (u 1))) (ring_negation K addK (matrix_entry A (ordsucc (u 0)) 0)).
Axiom god1_affine_difference_matrix_in : forall K , forall addK mulK : set -> set -> set , forall m n :e omega , forall A :e matrix_space K (ordsucc m) (ordsucc n) , ring K addK mulK -> affine_difference_matrix K addK m n A :e matrix_space K m n.
Axiom god1_affine_difference_matrix_entry : forall K , forall addK : set -> set -> set , forall m n , forall A , forall i :e m , forall j :e n , matrix_entry (affine_difference_matrix K addK m n A) i j = addK (matrix_entry A (ordsucc i) (ordsucc j)) (ring_negation K addK (matrix_entry A (ordsucc i) 0)).
Axiom god1_abelian_natural_double_sum_swap : forall G , forall op : set -> set -> set , abelian_group G op -> forall m :e omega , forall n :e omega , forall F : set -> set -> set , (forall i :e m , forall j :e n , F i j :e G) -> ring_finite_sum G op m (fun i => ring_finite_sum G op n (fun j => F i j)) = ring_finite_sum G op n (fun j => ring_finite_sum G op m (fun i => F i j)).
Axiom god1_group_natural_finite_sum_head_tail : forall G , forall op : set -> set -> set , group G op -> forall f : set -> set , forall n :e omega , (forall i :e ordsucc n , f i :e G) -> ring_finite_sum G op (ordsucc n) f = op (f 0) (ring_finite_sum G op n (fun i => f (ordsucc i))).
Definition god1_affine_coordinate_candidate : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> (set -> set) -> set -> set -> set := fun K addK mulK T addT smulT E action n P Q => fun i => if i = 0 then addK (ring_one K mulK) (ring_negation K addK (ring_finite_sum K addK n (fun j => basis_coordinates K addK mulK T addT smulT n (fun k => affine_difference T E action (P 0) (P (ordsucc k))) (affine_difference T E action (P 0) Q) j))) else basis_coordinates K addK mulK T addT smulT n (fun k => affine_difference T E action (P 0) (P (ordsucc k))) (affine_difference T E action (P 0) Q) (Union i).
Axiom god1_affine_coordinate_candidate_zero : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall n , forall P : set -> set , forall Q , god1_affine_coordinate_candidate K addK mulK T addT smulT E action n P Q 0 = addK (ring_one K mulK) (ring_negation K addK (ring_finite_sum K addK n (fun j => basis_coordinates K addK mulK T addT smulT n (fun k => affine_difference T E action (P 0) (P (ordsucc k))) (affine_difference T E action (P 0) Q) j))).
Axiom god1_affine_coordinate_candidate_successor : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall n , forall P : set -> set , forall Q , forall i , nat_p i -> god1_affine_coordinate_candidate K addK mulK T addT smulT E action n P Q (ordsucc i) = basis_coordinates K addK mulK T addT smulT n (fun k => affine_difference T E action (P 0) (P (ordsucc k))) (affine_difference T E action (P 0) Q) i.
Axiom god1_affine_coordinate_candidate_sum_one : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall n :e omega , forall P : set -> set , forall Q :e E , affine_space K addK mulK T addT smulT E action -> affine_basis K addK mulK T addT smulT E action n P -> affine_coefficients_sum_one K addK mulK (ordsucc n) (god1_affine_coordinate_candidate K addK mulK T addT smulT E action n P Q).
Axiom god1_affine_coordinate_candidate_barycenter : forall K , forall addK mulK : set -> set -> set , forall T , forall addT smulT : set -> set -> set , forall E , forall action : set -> set -> set , forall n :e omega , forall P : set -> set , forall Q :e E , affine_space K addK mulK T addT smulT E action -> affine_basis K addK mulK T addT smulT E action n P -> affine_barycenter T addT smulT E action (ordsucc n) P (god1_affine_coordinate_candidate K addK mulK T addT smulT E action n P Q) = Q.
