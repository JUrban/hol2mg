Definition iterated_integral_yx_Icc : set -> set -> set -> set -> (set -> set) -> set := fun a1 b1 a2 b2 f => riemann_integral_Icc a2 b2 (fun y : set => riemann_integral_Icc a1 b1 (fun x : set => f (R2_pair x y))).
Axiom iterated_integral_yx_Icc_unfold : forall a1 b1 a2 b2 : set , forall f : set -> set , iterated_integral_yx_Icc a1 b1 a2 b2 f = riemann_integral_Icc a2 b2 (fun y : set => riemann_integral_Icc a1 b1 (fun x : set => f (R2_pair x y))).
