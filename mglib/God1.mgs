Let Re : set -> set := CSNo_Re.
Let Im : set -> set := CSNo_Im.
Definition complex_vec2 : set -> set := fun z => (fun i :e 2 => if i = 0 then Re z else Im z).
Definition dist_complex : set -> set -> set := fun z w => Rn_dist 2 (complex_vec2 z) (complex_vec2 w).
Axiom dist_complex_unfold : forall z w , dist_complex z w = Rn_dist 2 (complex_vec2 z) (complex_vec2 w).
Axiom abs_sqr_CSNo_unfold : forall z , abs_sqr_CSNo z = (Re z ^ 2) + (Im z ^ 2).
Axiom modulus_CSNo_unfold : forall z , modulus_CSNo z = sqrt_SNo_nonneg (abs_sqr_CSNo z).
Axiom complex_vec2_mem : forall z :e complex , complex_vec2 z :e Rn 2.
Axiom complex_vec2_ap0 : forall z :e complex , (complex_vec2 z) 0 = Re z.
Axiom complex_vec2_ap1 : forall z :e complex , (complex_vec2 z) 1 = Im z.
Axiom complex_vec2_eq_R2_pair : forall z :e complex , complex_vec2 z = R2_pair (Re z) (Im z).
Axiom complex_vec2_0_eq_Rn_zero2 : complex_vec2 0 = Rn_zero 2.
Axiom Rn_dot_R2_pair_self : forall a :e R , forall b :e R , Rn_dot 2 (R2_pair a b) (R2_pair a b) = (a ^ 2) + (b ^ 2).
Axiom dist_complex_zero_eq_modulus : forall z :e complex , dist_complex z 0 = modulus_CSNo z.
Axiom complex_vec2_add_minus : forall z :e complex , forall w :e complex , complex_vec2 (add_CSNo z (minus_CSNo w)) = Rn_add 2 (complex_vec2 z) (Rn_neg 2 (complex_vec2 w)).
Axiom complex_vec2_inj : forall z :e complex , forall w :e complex , complex_vec2 z = complex_vec2 w -> z = w.
Axiom complex_vec2_add_CSNo_right : forall w :e complex , forall z0 :e complex , complex_vec2 (add_CSNo w z0) = Rn_add 2 (complex_vec2 z0) (complex_vec2 w).
Axiom dist_complex_add_CSNo_right_eq_dist0 : forall w :e complex , forall z0 :e complex , dist_complex (add_CSNo w z0) z0 = dist_complex w 0.
Axiom dist_complex_add_CSNo_right_lt_eps : forall w :e complex , forall z0 :e complex , forall eps :e R , dist_complex w 0 < eps -> dist_complex (add_CSNo w z0) z0 < eps.
Axiom dist_complex_is_metric : is_metric complex dist_complex.
Axiom modulus_CSNo_mem_R : forall z :e complex , modulus_CSNo z :e R.
Axiom modulus_CSNo_Le_dist_complex_add : forall u :e complex , forall v :e complex , modulus_CSNo u <= dist_complex u v + modulus_CSNo v.
Section form82.
Axiom ms_seq_compact_subq : forall X , forall d : set -> set -> set , forall K , ms_seq_compact X d K -> K c= X.
Axiom ms_seq_compact_elim : forall X , forall d : set -> set -> set , forall K , ms_seq_compact X d K -> forall x : set -> set , (forall n :e omega , x n :e K) -> exists xs : set -> set , subseq_of x xs /\ exists l :e K , ms_seq_limit X d xs l.
Definition countable : set -> prop := fun A => atleastp A omega.
Axiom finite_imp_countable : forall A , finite A -> countable A.
Axiom countable_nonempty_imp_exists_omega_enum : forall D , countable D -> nonempty D -> exists e : set -> set , (forall n :e omega , e n :e D) /\ (forall x :e D , exists n :e omega , e n = x).
Definition ms_dense : set -> (set -> set -> set) -> set -> prop := fun X d D => D c= X /\ forall x :e X , forall eps :e R , 0 < eps -> exists y :e D , d x y < eps.
Axiom binfun_lt_eq_substR : forall f : set -> set -> set , forall x y z eps , y = z -> f x y < eps -> f x z < eps.
Axiom ms_dense_countable_nonempty_imp_exists_dense_seq : forall X , forall d : set -> set -> set , forall D , ms_dense X d D -> countable D -> nonempty D -> exists e : set -> set , (forall n :e omega , e n :e D) /\ (forall x :e X , forall eps :e R , 0 < eps -> exists n :e omega , d x (e n) < eps).
Definition ms_totally_bounded : set -> (set -> set -> set) -> prop := fun X d => forall eps :e R , 0 < eps -> exists F , F c= X /\ finite F /\ forall x :e X , x :e (\/_ c :e F , ms_ball X d c eps).
Axiom ms_totally_bounded_Empty : forall d : set -> set -> set , ms_totally_bounded Empty d.
Axiom not_nonempty_imp_eq_Empty : forall X , ~ nonempty X -> X = Empty.
Axiom ms_totally_bounded_of_not_nonempty : forall X , forall d : set -> set -> set , ~ nonempty X -> ms_totally_bounded X d.
Axiom famunion_not_mem_imp : forall A , forall F : set -> set , forall y , y /:e (\/_ x :e A , F x) -> forall x :e A , y /:e F x.
Axiom ms_no_finite_eps_net_imp_sep_seq : forall X , forall d : set -> set -> set , forall eps :e R , 0 < eps -> is_metric X d -> (forall F , F c= X -> finite F -> exists x :e X , x /:e (\/_ c :e F , ms_ball X d c eps)) -> exists x : set -> set , (forall n :e omega , x n :e X) /\ forall n :e omega , forall m :e n , ~ (d (x m) (x n) < eps).
Axiom ms_seq_compact_imp_totally_bounded : forall X , forall d : set -> set -> set , is_metric X d -> ms_seq_compact X d X -> ms_totally_bounded X d.
Axiom ms_totally_bounded_imp_exists_countable_dense : forall X , forall d : set -> set -> set , is_metric X d -> ms_totally_bounded X d -> exists D , countable D /\ ms_dense X d D.
Axiom ms_seq_compact_nonempty_imp_exists_dense_seq : forall X , forall d : set -> set -> set , is_metric X d -> ms_seq_compact X d X -> nonempty X -> exists e : set -> set , (forall n :e omega , e n :e X) /\ (forall x :e X , forall eps :e R , 0 < eps -> exists n :e omega , d x (e n) < eps).
Definition pointwise_bounded_fun_seq : set -> (set -> set) -> prop := fun X fn => (forall n :e omega , fn n :e setexp complex X) /\ forall x :e X , exists M :e R , forall n :e omega , modulus_CSNo ((fn n) x) <= M.
Axiom pointwise_bounded_fun_seq_maps_to : forall X , forall fn : set -> set , pointwise_bounded_fun_seq X fn -> forall n :e omega , fn n :e setexp complex X.
Axiom pointwise_bounded_fun_seq_bound : forall X , forall fn : set -> set , pointwise_bounded_fun_seq X fn -> forall x :e X , exists M :e R , forall n :e omega , modulus_CSNo ((fn n) x) <= M.
Definition uniformly_bounded_fun_seq : set -> (set -> set) -> prop := fun X fn => (forall n :e omega , fn n :e setexp complex X) /\ exists M :e R , forall n :e omega , forall x :e X , modulus_CSNo ((fn n) x) <= M.
Axiom uniformly_bounded_fun_seq_maps_to : forall X , forall fn : set -> set , uniformly_bounded_fun_seq X fn -> forall n :e omega , fn n :e setexp complex X.
Axiom uniformly_bounded_fun_seq_bound : forall X , forall fn : set -> set , uniformly_bounded_fun_seq X fn -> exists M :e R , forall n :e omega , forall x :e X , modulus_CSNo ((fn n) x) <= M.
Axiom uniformly_bounded_fun_seq_imp_pointwise_bounded_fun_seq : forall X , forall fn : set -> set , uniformly_bounded_fun_seq X fn -> pointwise_bounded_fun_seq X fn.
Axiom R_Le_add_of_nonneg_right : forall x :e R , forall y :e R , 0 <= y -> x <= x + y.
Axiom complex_Re_abs_le_modulus : forall z :e complex , abs_SNo (Re z) <= modulus_CSNo z.
Axiom complex_Im_abs_le_modulus : forall z :e complex , abs_SNo (Im z) <= modulus_CSNo z.
Axiom complex_modulus_bound_imp_vec_in_rect : forall z :e complex , forall M :e R , modulus_CSNo z <= M -> complex_vec2 z :e rect_Icc_R2 (- M) M (- M) M.
Axiom complex_seq_dist_lt_of_vec_dist_lt : forall x : set -> set , forall f : set -> set , forall vsub : set -> set , forall p , forall l , forall n :e omega , vsub n = complex_vec2 ((fun m : set => x (f m)) n) -> p = complex_vec2 l -> forall eps :e R , Rn_dist 2 (vsub n) p < eps -> dist_complex ((fun m : set => x (f m)) n) l < eps.
Axiom complex_vec2_of_SNo_pair : forall x :e R , forall y :e R , complex_vec2 (SNo_pair x y) = R2_pair x y.
Axiom complex_subseq_limit_from_vec_subseq_witness : forall x : set -> set , forall M :e R , (forall n :e omega , x n :e complex) -> forall vsub : set -> set , forall f : set -> set , subseq_fun f -> (forall n :e omega , vsub n = (fun n : set => complex_vec2 (x n)) (f n)) -> forall p :e rect_Icc_R2 (- M) M (- M) M , ms_seq_limit (Rn 2) (Rn_dist 2) vsub p -> exists y : set -> set , subseq_of x y /\ exists l :e complex , ms_seq_limit complex dist_complex y l.
Axiom complex_subseq_limit_from_vec_subseq_limit : forall x : set -> set , forall M :e R , (forall n :e omega , x n :e complex) -> forall vsub : set -> set , subseq_of (fun n : set => complex_vec2 (x n)) vsub -> (exists p :e rect_Icc_R2 (- M) M (- M) M , ms_seq_limit (Rn 2) (Rn_dist 2) vsub p) -> exists y : set -> set , subseq_of x y /\ exists l :e complex , ms_seq_limit complex dist_complex y l.
Axiom complex_seq_modulus_bounded_subseq_converges : forall x : set -> set , forall M :e R , (forall n :e omega , x n :e complex) -> (forall n :e omega , modulus_CSNo (x n) <= M) -> exists y : set -> set , subseq_of x y /\ exists l :e complex , ms_seq_limit complex dist_complex y l.
Axiom subseq_of_eval_at_point : forall x y : set -> set , subseq_of x y -> forall c , subseq_of (fun n : set => (x n) c) (fun n : set => (y n) c).
Axiom pointwise_bounded_fun_seq_at_point_subseq_converges : forall X , forall fn : set -> set , pointwise_bounded_fun_seq X fn -> forall c :e X , exists y : set -> set , subseq_of (fun n : set => (fn n) c) y /\ exists l :e complex , ms_seq_limit complex dist_complex y l.
Axiom pointwise_bounded_fun_seq_at_point_fun_subseq_converges : forall X , forall fn : set -> set , pointwise_bounded_fun_seq X fn -> forall c :e X , exists gn : set -> set , subseq_of fn gn /\ exists l :e complex , ms_seq_limit complex dist_complex (fun n : set => (gn n) c) l.
Axiom ms_seq_limit_eval_arg_eq_subst : forall e : set -> set , forall gn : set -> set , forall m , forall k , forall l , e m = e k -> ms_seq_limit complex dist_complex (fun n : set => (gn n) (e k)) l -> ms_seq_limit complex dist_complex (fun n : set => (gn n) (e m)) l.
Axiom pointwise_limits_on_initial_segment_subseq : forall e : set -> set , forall hn gn : set -> set , forall K :e omega , (forall m :e K , exists l :e complex , ms_seq_limit complex dist_complex (fun n : set => (hn n) (e m)) l) -> subseq_of hn gn -> forall m :e K , exists l :e complex , ms_seq_limit complex dist_complex (fun n : set => (gn n) (e m)) l.
Axiom pointwise_limits_initial_segment_ordsucc_merge : forall e : set -> set , forall gn : set -> set , forall K :e omega , (forall m :e K , exists l :e complex , ms_seq_limit complex dist_complex (fun n : set => (gn n) (e m)) l) -> (exists l :e complex , ms_seq_limit complex dist_complex (fun n : set => (gn n) (e K)) l) -> forall m :e ordsucc K , exists l :e complex , ms_seq_limit complex dist_complex (fun n : set => (gn n) (e m)) l.
Axiom pointwise_bounded_fun_seq_extend_subseq_converges : forall X , forall fn : set -> set , forall e : set -> set , pointwise_bounded_fun_seq X fn -> forall hn : set -> set , subseq_of fn hn -> forall K :e omega , e K :e X -> (forall m :e K , exists l :e complex , ms_seq_limit complex dist_complex (fun n : set => (hn n) (e m)) l) -> exists gn : set -> set , subseq_of hn gn /\ forall m :e ordsucc K , exists l :e complex , ms_seq_limit complex dist_complex (fun n : set => (gn n) (e m)) l.
