End RealAnalysis2.
Section God1.
Definition law_of_composition : set -> (set -> set -> set) -> prop := fun X op => forall x y :e X , op x y :e X.
Definition associative_on : set -> (set -> set -> set) -> prop := fun X op => forall x y z :e X , op x (op y z) = op (op x y) z.
Definition commutative_on : set -> (set -> set -> set) -> prop := fun X op => forall x y :e X , op x y = op y x.
Definition neutral_element : set -> (set -> set -> set) -> set -> prop := fun X op e => e :e X /\ forall x :e X , op x e = x /\ op e x = x.
Definition left_reflection : set -> (set -> set -> set) -> set -> set -> set -> prop := fun X op e x r => r :e X /\ op r x = e.
Definition right_reflection : set -> (set -> set -> set) -> set -> set -> set -> prop := fun X op e x r => r :e X /\ op x r = e.
Definition reflection : set -> (set -> set -> set) -> set -> set -> set -> prop := fun X op e x r => r :e X /\ op r x = e /\ op x r = e.
Definition reflexible : set -> (set -> set -> set) -> set -> set -> prop := fun X op e x => x :e X /\ exists r :e X , reflection X op e x r.
Axiom god1_s6_theorem1_neutral_element_unique : forall X , forall op : set -> set -> set , law_of_composition X op -> forall e1 e2 , neutral_element X op e1 -> neutral_element X op e2 -> e1 = e2.
Axiom god1_s6_left_and_right_reflections_equal : forall X , forall op : set -> set -> set , forall e x l r , associative_on X op -> neutral_element X op e -> x :e X -> left_reflection X op e x l -> right_reflection X op e x r -> l = r.
Axiom god1_s6_one_sided_reflections_are_unique : forall X , forall op : set -> set -> set , forall e x l r , associative_on X op -> neutral_element X op e -> x :e X -> left_reflection X op e x l -> right_reflection X op e x r -> (forall l' :e X , left_reflection X op e x l' -> l' = l) /\ (forall r' :e X , right_reflection X op e x r' -> r' = r) /\ l = r.
Axiom god1_s6_left_and_right_reflections_give_common_reflection : forall X , forall op : set -> set -> set , forall e x l r , associative_on X op -> neutral_element X op e -> x :e X -> left_reflection X op e x l -> right_reflection X op e x r -> reflection X op e x l.
Axiom god1_s6_reflexibility_gives_one_sided_reflections : forall X , forall op : set -> set -> set , forall e x , reflexible X op e x -> (exists l :e X , left_reflection X op e x l) /\ (exists r :e X , right_reflection X op e x r).
Axiom god1_s6_one_sided_reflections_give_reflexibility_and_uniqueness : forall X , forall op : set -> set -> set , forall e x , associative_on X op -> neutral_element X op e -> x :e X -> ((exists l :e X , left_reflection X op e x l) /\ (exists r :e X , right_reflection X op e x r)) -> reflexible X op e x /\ exists u :e X , reflection X op e x u /\ (forall v :e X , reflection X op e x v -> v = u) /\ (forall v :e X , left_reflection X op e x v -> v = u) /\ (forall v :e X , right_reflection X op e x v -> v = u).
Axiom god1_s6_theorem2_reflection_characterization : forall X , forall op : set -> set -> set , forall e x , law_of_composition X op -> associative_on X op -> neutral_element X op e -> x :e X -> (reflexible X op e x <-> ((exists l :e X , left_reflection X op e x l) /\ (exists r :e X , right_reflection X op e x r))) /\ (((exists l :e X , left_reflection X op e x l) /\ (exists r :e X , right_reflection X op e x r)) -> exists u :e X , reflection X op e x u /\ (forall v :e X , reflection X op e x v -> v = u) /\ (forall v :e X , left_reflection X op e x v -> v = u) /\ (forall v :e X , right_reflection X op e x v -> v = u)).
Axiom god1_s6_reflection_reverses : forall X , forall op : set -> set -> set , forall e x r , x :e X -> reflection X op e x r -> reflection X op e r x.
Axiom god1_s6_reflection_product_calculation : forall X , forall op : set -> set -> set , forall e x y rx ry , law_of_composition X op -> associative_on X op -> neutral_element X op e -> x :e X -> y :e X -> reflection X op e x rx -> reflection X op e y ry -> op (op ry rx) (op x y) = e /\ op (op x y) (op ry rx) = e.
Axiom god1_s6_product_has_reversed_product_reflection : forall X , forall op : set -> set -> set , forall e x y rx ry , law_of_composition X op -> associative_on X op -> neutral_element X op e -> x :e X -> y :e X -> reflection X op e x rx -> reflection X op e y ry -> reflexible X op e (op x y) /\ reflection X op e (op x y) (op ry rx).
Axiom god1_s6_theorem3_reflections_and_products : forall X , forall op : set -> set -> set , forall e , law_of_composition X op -> associative_on X op -> neutral_element X op e -> (forall x r :e X , reflection X op e x r -> reflection X op e r x) /\ (forall x y rx ry :e X , reflection X op e x rx -> reflection X op e y ry -> reflexible X op e (op x y) /\ reflection X op e (op x y) (op ry rx)).
Axiom god1_s6_reflexible_left_factor_forces_solution : forall X , forall op : set -> set -> set , forall e a ar b y , associative_on X op -> neutral_element X op e -> a :e X -> reflection X op e a ar -> b :e X -> y :e X -> op a y = b -> y = op ar b.
Axiom god1_s6_reflexible_left_factor_candidate_solves : forall X , forall op : set -> set -> set , forall e a ar b , associative_on X op -> neutral_element X op e -> a :e X -> reflection X op e a ar -> b :e X -> op a (op ar b) = b.
Axiom god1_s6_theorem4_equation_with_reflexible_left_factor : forall X , forall op : set -> set -> set , forall e , law_of_composition X op -> associative_on X op -> neutral_element X op e -> forall a ar :e X , reflection X op e a ar -> forall b :e X , exists x :e X , op a x = b /\ x = op ar b /\ (forall y :e X , op a y = b -> y = x).
Definition group : set -> (set -> set -> set) -> prop := fun G mul => law_of_composition G mul /\ associative_on G mul /\ exists e :e G , neutral_element G mul e /\ forall x :e G , exists y :e G , reflection G mul e x y.
Definition group_identity : set -> (set -> set -> set) -> set := fun G mul => Eps_i (fun e => neutral_element G mul e).
Definition group_inverse : set -> (set -> set -> set) -> set -> set := fun G mul x => Eps_i (fun y => reflection G mul (group_identity G mul) x y).
Definition abelian_group : set -> (set -> set -> set) -> prop := fun G mul => group G mul /\ commutative_on G mul.
Axiom god1_group_identity_specification : forall G , forall mul : set -> set -> set , group G mul -> neutral_element G mul (group_identity G mul).
Axiom god1_group_inverse_specification : forall G , forall mul : set -> set -> set , group G mul -> forall x :e G , reflection G mul (group_identity G mul) x (group_inverse G mul x).
Axiom god1_group_identity_and_inverse_specifications : forall G , forall mul : set -> set -> set , group G mul -> neutral_element G mul (group_identity G mul) /\ forall x :e G , reflection G mul (group_identity G mul) x (group_inverse G mul x).
Axiom god1_group_law_of_composition : forall G , forall mul : set -> set -> set , group G mul -> law_of_composition G mul.
Axiom god1_group_associative : forall G , forall mul : set -> set -> set , group G mul -> associative_on G mul.
Axiom god1_group_identity_in : forall G , forall mul : set -> set -> set , group G mul -> group_identity G mul :e G.
Axiom god1_group_inverse_in : forall G , forall mul : set -> set -> set , group G mul -> forall x :e G , group_inverse G mul x :e G.
Definition indexed_group_product_operation : set -> (set -> set -> set -> set) -> set -> set -> set := fun I mul x y => fun i :e I => mul i (x i) (y i).
Axiom god1_indexed_group_product_eval : forall I , forall mul : set -> set -> set -> set , forall x y i , i :e I -> indexed_group_product_operation I mul x y i = mul i (x i) (y i).
Axiom god1_indexed_group_product_components_in : forall I , forall G : set -> set , forall mul : set -> set -> set -> set , (forall i :e I , group (G i) (mul i)) -> forall x y :e (Pi_ i :e I , G i) , forall i :e I , mul i (x i) (y i) :e G i.
Axiom god1_indexed_group_product_law : forall I , forall G : set -> set , forall mul : set -> set -> set -> set , (forall i :e I , group (G i) (mul i)) -> law_of_composition (Pi_ i :e I , G i) (indexed_group_product_operation I mul).
Axiom god1_indexed_group_product_three_elements : forall I , forall G : set -> set , forall mul : set -> set -> set -> set , (forall i :e I , group (G i) (mul i)) -> forall x y z :e (Pi_ i :e I , G i) , indexed_group_product_operation I mul (indexed_group_product_operation I mul x y) z = indexed_group_product_operation I mul x (indexed_group_product_operation I mul y z).
Axiom god1_indexed_group_product_definition_call : forall I , forall G : set -> set , forall mul : set -> set -> set -> set , forall x y :e (Pi_ i :e I , G i) , indexed_group_product_operation I mul x y = (fun i :e I => mul i (x i) (y i)).
Axiom god1_indexed_group_product_associative : forall I , forall G : set -> set , forall mul : set -> set -> set -> set , (forall i :e I , group (G i) (mul i)) -> associative_on (Pi_ i :e I , G i) (indexed_group_product_operation I mul).
Axiom god1_indexed_group_product_identity_in : forall I , forall G : set -> set , forall mul : set -> set -> set -> set , (forall i :e I , group (G i) (mul i)) -> (fun i :e I => group_identity (G i) (mul i)) :e (Pi_ i :e I , G i).
Axiom god1_indexed_group_product_identity_is_neutral : forall I , forall G : set -> set , forall mul : set -> set -> set -> set , (forall i :e I , group (G i) (mul i)) -> neutral_element (Pi_ i :e I , G i) (indexed_group_product_operation I mul) (fun i :e I => group_identity (G i) (mul i)).
Axiom god1_indexed_group_product_inverse_in : forall I , forall G : set -> set , forall mul : set -> set -> set -> set , (forall i :e I , group (G i) (mul i)) -> forall x :e (Pi_ i :e I , G i) , (fun i :e I => group_inverse (G i) (mul i) (x i)) :e (Pi_ i :e I , G i).
Axiom god1_indexed_group_product_inverse_is_reflection : forall I , forall G : set -> set , forall mul : set -> set -> set -> set , (forall i :e I , group (G i) (mul i)) -> forall x :e (Pi_ i :e I , G i) , reflection (Pi_ i :e I , G i) (indexed_group_product_operation I mul) (fun i :e I => group_identity (G i) (mul i)) x (fun i :e I => group_inverse (G i) (mul i) (x i)).
Axiom god1_indexed_direct_product_is_group : forall I , forall G : set -> set , forall mul : set -> set -> set -> set , (forall i :e I , group (G i) (mul i)) -> group (Pi_ i :e I , G i) (indexed_group_product_operation I mul).
Definition group_direct_power : set -> set -> set := fun G I => G :^: I.
Axiom god1_nonempty_of_ne_empty : forall X , X <> 0 -> nonempty X.
Axiom god1_group_inverse_involutive : forall G , forall mul : set -> set -> set , group G mul -> forall x :e G , group_inverse G mul (group_inverse G mul x) = x.
Definition subgroup : set -> (set -> set -> set) -> set -> prop := fun G mul H => group G mul /\ H c= G /\ H <> 0 /\ forall x y :e H , mul x (group_inverse G mul y) :e H.
Axiom god1_subgroup_ambient_group : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> group G mul.
Axiom god1_subgroup_subset : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> H c= G.
Axiom god1_subgroup_ne_empty : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> H <> 0.
Axiom god1_subgroup_difference_closed : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> forall x y :e H , mul x (group_inverse G mul y) :e H.
Axiom god1_subgroup_chosen_member_in : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> Eps_i (fun a => a :e H) :e H.
Axiom god1_subgroup_contains_identity : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> group_identity G mul :e H.
Axiom god1_subgroup_inverse_closed : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> forall x :e H , group_inverse G mul x :e H.
Axiom god1_subgroup_product_closed : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> forall x y :e H , mul x y :e H.
Axiom god1_subgroup_of_identity_product_inverse : forall G , forall mul : set -> set -> set , forall H , group G mul -> H c= G -> group_identity G mul :e H -> (forall x y :e H , mul x y :e H) -> (forall x :e H , group_inverse G mul x :e H) -> subgroup G mul H.
Axiom god1_subgroup_characterization : forall G , forall mul : set -> set -> set , forall H , group G mul -> H c= G -> (subgroup G mul H <-> group_identity G mul :e H /\ (forall x y :e H , mul x y :e H) /\ (forall x :e H , group_inverse G mul x :e H)).
Axiom god1_subgroup_induced_group : forall G , forall mul : set -> set -> set , forall H , subgroup G mul H -> group H mul.
Definition group_nat_power : set -> (set -> set -> set) -> set -> set -> set := fun G mul x n => nat_primrec (group_identity G mul) (fun i r => mul r x) n.
Definition group_int_power : set -> (set -> set -> set) -> set -> set -> set := fun G mul x n => if SNoLe 0 n then group_nat_power G mul x n else group_nat_power G mul (group_inverse G mul x) (minus_SNo n).
Axiom god1_group_inverse_identity : forall G , forall mul : set -> set -> set , group G mul -> group_inverse G mul (group_identity G mul) = group_identity G mul.
Axiom god1_group_nat_power_zero : forall G , forall mul : set -> set -> set , forall x , group_nat_power G mul x 0 = group_identity G mul.
Axiom god1_group_nat_power_successor : forall G , forall mul : set -> set -> set , forall x n , nat_p n -> group_nat_power G mul x (ordsucc n) = mul (group_nat_power G mul x n) x.
Axiom god1_group_nat_power_zero_in : forall G , forall mul : set -> set -> set , forall x , group G mul -> group_nat_power G mul x 0 :e G.
