Axiom god1_trilinear_fixed_middle_bilinear : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall Y , forall addY smulY : set -> set -> set , forall Z , forall addZ smulZ : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , commutative_ring K addK mulK -> left_module K addK mulK X addX smulX -> left_module K addK mulK Y addY smulY -> left_module K addK mulK Z addZ smulZ -> left_module K addK mulK M addM smulM -> trilinear_mapping K addK mulK X addX smulX Y addY smulY Z addZ smulZ M addM smulM f -> forall y :e Y , bilinear_mapping K addK mulK X addX smulX Z addZ smulZ M addM smulM (fun q : set => f (trilinear_tuple (q 0) y (q 1))).
