Axiom upper_darboux_sums_Icc_self_eq_Sing0 : forall a :e R , forall f : set -> set , upper_darboux_sums_Icc a a f = {0}.
Axiom riemann_integral_Icc_self_eq_0 : forall a :e R , forall f : set -> set , riemann_integral_Icc a a f = 0.
Axiom upper_darboux_integral_Icc_self_eq_0 : forall a :e R , forall f : set -> set , upper_darboux_integral_Icc a a f = 0.
Axiom inf_on_eq_0_of_pointwise_eq_0 : forall D , nonempty D -> forall f : set -> set , bounded_fun D f -> (forall x :e D , f x = 0) -> inf_on f D = 0.
Axiom sup_on_eq_0_of_pointwise_eq_0 : forall D , nonempty D -> forall f : set -> set , bounded_fun D f -> (forall x :e D , f x = 0) -> sup_on f D = 0.
Axiom riemann_integrable_Icc_scale_ne0 : forall a b :e R , a <= b -> forall f : set -> set , forall alpha :e R , alpha <> 0 -> riemann_integrable_Icc a b f -> riemann_integrable_Icc a b (fun x => alpha * (f x)).
Axiom riemann_integral_Icc_scale_ne0 : forall a b :e R , a <= b -> forall f : set -> set , forall alpha :e R , alpha <> 0 -> riemann_integrable_Icc a b f -> riemann_integral_Icc a b (fun x => alpha * (f x)) = alpha * (riemann_integral_Icc a b f).
Axiom riemann_integrable_Icc_scale : forall a b :e R , a <= b -> forall f : set -> set , forall alpha :e R , riemann_integrable_Icc a b f -> riemann_integrable_Icc a b (fun x => alpha * (f x)).
Axiom riemann_integral_Icc_scale : forall a b :e R , a <= b -> forall f : set -> set , forall alpha :e R , riemann_integrable_Icc a b f -> riemann_integral_Icc a b (fun x => alpha * (f x)) = alpha * (riemann_integral_Icc a b f).
Axiom riemann_integral_Icc_linearity : forall a b :e R , a <= b -> forall f g : set -> set , forall alpha :e R , riemann_integrable_Icc a b f -> riemann_integrable_Icc a b g -> riemann_integrable_Icc a b (fun x => (f x) + (g x)) /\ riemann_integral_Icc a b (fun x => (f x) + (g x)) = riemann_integral_Icc a b f + riemann_integral_Icc a b g /\ riemann_integrable_Icc a b (fun x => alpha * (f x)) /\ riemann_integral_Icc a b (fun x => alpha * (f x)) = alpha * (riemann_integral_Icc a b f).
Axiom riemann_integral_Icc_monotone : forall a b :e R , a <= b -> forall f g : set -> set , (forall x :e Icc a b , f x <= g x) -> riemann_integrable_Icc a b f -> riemann_integrable_Icc a b g -> riemann_integral_Icc a b f <= riemann_integral_Icc a b g.
End form77.
Section form78.
Axiom lower_darboux_integral_Icc_additivity : forall a b c :e R , a <= b -> b <= c -> forall f : set -> set , bounded_fun (Icc a c) f -> lower_darboux_integral_Icc a c f = lower_darboux_integral_Icc a b f + lower_darboux_integral_Icc b c f.
Axiom riemann_integral_Icc_additivity : forall a b c , forall f : set -> set , a :e R -> b :e R -> c :e R -> a <= c -> c <= b -> riemann_integrable_Icc a b f -> riemann_integrable_Icc a c f -> riemann_integrable_Icc c b f -> riemann_integral_Icc a b f = riemann_integral_Icc a c f + riemann_integral_Icc c b f.
Axiom upper_darboux_integral_Icc_additivity : forall a b c :e R , a <= b -> b <= c -> forall f : set -> set , bounded_fun (Icc a c) f -> upper_darboux_integral_Icc a c f = upper_darboux_integral_Icc a b f + upper_darboux_integral_Icc b c f.
