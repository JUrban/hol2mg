Axiom god1_adapted_complements_give_dimension_indexed_chain_basis : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall n :e omega , forall u F : set -> set , forall q :e omega , finite_dimensional_vector_space K addK mulK E addE smul -> module_dimension K addK mulK E addE smul = n -> module_endomorphism K addK mulK E addE smul u -> (forall i :e ordsucc (ordsucc q) , 0 :e i -> vector_subspace K addK mulK E addE smul (F i) /\ direct_sum_decomposition K addK mulK (endomorphism_power_kernel K addK mulK E addE smul u i) addE smul 2 (fun k => if k = 0 then endomorphism_power_kernel K addK mulK E addE smul u (Union i) else F i) /\ (0 :e Union i -> (forall x :e F i , u x :e F (Union i)) /\ inj (F i) (F (Union i)) u)) -> endomorphism_natural_power K addK mulK E addE smul u (ordsucc q) = (fun x :e E => module_zero E addE) -> exists b : set -> set , exists coeff :e K :^: n , module_basis K addK mulK E addE smul n b /\ (forall t :e n , coeff t = ring_zero K addK \/ coeff t = ring_one K mulK) /\ forall t :e n , u (b t) = if 0 :e t then smul (coeff t) (b (Union t)) else module_zero E addE.
Axiom god1_s35_theorem3_nilpotent_basis_structure : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall n :e omega , forall u : set -> set , field K addK mulK -> 0 :e n -> finite_dimensional_vector_space K addK mulK E addE smul -> module_dimension K addK mulK E addE smul = n -> module_endomorphism K addK mulK E addE smul u -> nilpotent_endomorphism K addK mulK E addE smul u -> exists b : set -> set , exists v :e K :^: n , module_basis K addK mulK E addE smul n b /\ (forall i :e n , v i = ring_zero K addK \/ v i = ring_one K mulK) /\ forall i j :e n , matrix_entry (endomorphism_coordinate_matrix K addK mulK E addE smul n b u) i j = if j = ordsucc i then v j else ring_zero K addK.
Axiom god1_s35_lemma1_nilpotent_kernel_filtration : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall u : set -> set , forall q :e omega , field K addK mulK -> 0 :e q -> module_endomorphism K addK mulK E addE smul u -> endomorphism_natural_power K addK mulK E addE smul u q <> (fun x :e E => module_zero E addE) -> endomorphism_natural_power K addK mulK E addE smul u (ordsucc q) = (fun x :e E => module_zero E addE) -> (forall i :e ordsucc q , endomorphism_power_kernel K addK mulK E addE smul u i c= endomorphism_power_kernel K addK mulK E addE smul u (ordsucc i) /\ endomorphism_power_kernel K addK mulK E addE smul u i <> endomorphism_power_kernel K addK mulK E addE smul u (ordsucc i)) /\ forall i :e ordsucc q , forall x :e endomorphism_power_kernel K addK mulK E addE smul u (ordsucc i) , u x :e endomorphism_power_kernel K addK mulK E addE smul u i.
Axiom god1_s35_lemma2_nilpotent_image_avoids_previous_kernel : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall u : set -> set , forall i :e omega , forall F , field K addK mulK -> 0 :e i -> module_endomorphism K addK mulK E addE smul u -> vector_subspace K addK mulK E addE smul F -> F :/\: endomorphism_power_kernel K addK mulK E addE smul u i = {module_zero E addE} -> module_homomorphism_image F u :/\: endomorphism_power_kernel K addK mulK E addE smul u (Union i) = {module_zero E addE} /\ module_isomorphism K addK mulK F addE smul (module_homomorphism_image F u) addE smul u.
Axiom god1_s35_lemma3_complements_adapted_to_nilpotent_map : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall u : set -> set , forall q :e omega , field K addK mulK -> finite_dimensional_vector_space K addK mulK E addE smul -> module_endomorphism K addK mulK E addE smul u -> exists F : set -> set , forall i :e ordsucc (ordsucc q) , 0 :e i -> vector_subspace K addK mulK E addE smul (F i) /\ direct_sum_decomposition K addK mulK (endomorphism_power_kernel K addK mulK E addE smul u i) addE smul 2 (fun k => if k = 0 then endomorphism_power_kernel K addK mulK E addE smul u (Union i) else F i) /\ (0 :e Union i -> (forall x :e F i , u x :e F (Union i)) /\ inj (F i) (F (Union i)) u).
Definition reduced_jordan_matrix : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> prop := fun K add mul n A => 0 :e n /\ A :e square_matrix_ring K n /\ exists lambda :e K , forall i j :e n , matrix_entry A i j = if i = j then lambda else if j = ordsucc i then ring_one K mul else ring_zero K add.
Definition natural_prefix_sum : set -> (set -> set) -> set -> set := fun r sizes i => ring_finite_sum omega add_SNo i (fun j => sizes j).
Definition jordan_canonical_matrix : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> prop := fun K add mul n A => A :e square_matrix_ring K n /\ exists r :e omega , exists sizes :e omega :^: r , exists lambda :e K :^: r , (forall k :e r , 0 :e sizes k) /\ ring_finite_sum omega add_SNo r (fun k => sizes k) = n /\ forall k l :e r , forall i :e sizes k , forall j :e sizes l , matrix_entry A (natural_prefix_sum r (fun h => sizes h) k + i) (natural_prefix_sum r (fun h => sizes h) l + j) = if k = l then if i = j then lambda k else if j = ordsucc i then ring_one K mul else ring_zero K add else ring_zero K add.
Axiom god1_s34_section5_reduced_matrix_characteristic_splits_interface : forall K , forall add mul : set -> set -> set , forall n :e omega , forall A :e square_matrix_ring K n , field K add mul -> reduced_jordan_matrix K add mul n A -> polynomial_splits_over K add mul (matrix_characteristic_polynomial K add mul n A).
Axiom god1_indexed_choice_family : forall I , forall P : set -> set -> prop , (forall i :e I , exists x , P i x) -> exists f : set -> set , forall i :e I , P i (f i).
Axiom god1_indexed_triple_choice_families : forall I , forall P : set -> set -> set -> set -> prop , (forall i :e I , exists x y z , P i x y z) -> exists X Y Z : set -> set , forall i :e I , P i (X i) (Y i) (Z i).
Definition god1_function_family_update : (set -> set -> set) -> (set -> set) -> set -> set -> set -> set := fun F f m i x => if i = m then f x else F i x.
Axiom god1_function_family_update_at : forall F : set -> set -> set , forall f : set -> set , forall m , god1_function_family_update F f m m = f.
Axiom god1_function_family_update_before : forall F : set -> set -> set , forall f : set -> set , forall m i , i <> m -> god1_function_family_update F f m i = F i.
Axiom god1_dependent_function_predicate_eq_subst : forall P : set -> (set -> set) -> prop , forall G : set -> set -> set , forall i j , i = j -> P i (G i) -> P j (G j).
Axiom god1_function_predicate_eq_subst : forall P : (set -> set) -> prop , forall f g : set -> set , f = g -> P f -> P g.
Axiom god1_function_eq_sym : forall f g : set -> set , f = g -> g = f.
Axiom god1_function_family_update_at_equal_index : forall P : set -> (set -> set) -> prop , forall F : set -> set -> set , forall f : set -> set , forall m i , i = m -> P m f -> P i (god1_function_family_update F f m i).
Axiom god1_finite_indexed_function_choice_family : forall q :e omega , forall P : set -> (set -> set) -> prop , (forall i :e q , exists f : set -> set , P i f) -> exists F : set -> set -> set , forall i :e q , P i (F i).
Axiom god1_endomorphism_natural_power_restriction_eval : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall u : set -> set , forall F , module_endomorphism K addK mulK E addE smul u -> submodule K addK mulK E addE smul F -> (forall x :e F , u x :e F) -> forall r :e omega , forall x :e F , endomorphism_natural_power K addK mulK F addE smul u r x = endomorphism_natural_power K addK mulK E addE smul u r x.
Axiom god1_endomorphism_natural_power_commutes_with_base_eval : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall u : set -> set , module_endomorphism K addK mulK E addE smul u -> forall r :e omega , forall x :e E , endomorphism_natural_power K addK mulK E addE smul u r (u x) = u (endomorphism_natural_power K addK mulK E addE smul u r x).
Axiom god1_generalized_eigenspace_restricted_shift_is_nilpotent : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall u : set -> set , forall lambda :e K , forall r :e omega , field K addK mulK -> 0 :e r -> module_endomorphism K addK mulK E addE smul u -> let G := generalized_eigenspace K addK mulK E addE smul u lambda r in (submodule K addK mulK E addE smul G /\ module_endomorphism K addK mulK G addE smul (endomorphism_shift K addK mulK E addE smul u lambda)) /\ nilpotent_endomorphism K addK mulK G addE smul (endomorphism_shift K addK mulK E addE smul u lambda).
Axiom god1_adapted_complements_give_block_chain_basis : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall n :e omega , forall u F : set -> set , forall q :e omega , finite_dimensional_vector_space K addK mulK E addE smul -> module_dimension K addK mulK E addE smul = n -> module_endomorphism K addK mulK E addE smul u -> (forall i :e ordsucc (ordsucc q) , 0 :e i -> vector_subspace K addK mulK E addE smul (F i) /\ direct_sum_decomposition K addK mulK (endomorphism_power_kernel K addK mulK E addE smul u i) addE smul 2 (fun k => if k = 0 then endomorphism_power_kernel K addK mulK E addE smul u (Union i) else F i) /\ (0 :e Union i -> (forall x :e F i , u x :e F (Union i)) /\ inj (F i) (F (Union i)) u)) -> endomorphism_natural_power K addK mulK E addE smul u (ordsucc q) = (fun x :e E => module_zero E addE) -> exists r :e omega , exists sizes :e omega :^: r , exists b : set -> set , (forall k :e r , 0 :e sizes k) /\ ring_finite_sum omega add_SNo r (fun k => sizes k) = n /\ module_basis K addK mulK E addE smul n b /\ forall k :e r , forall j :e sizes k , add_nat (natural_indexed_sum k (fun h => sizes h)) j :e n /\ u (b (add_nat (natural_indexed_sum k (fun h => sizes h)) j)) = if 0 :e j then b (add_nat (natural_indexed_sum k (fun h => sizes h)) (Union j)) else module_zero E addE.
Axiom god1_nilpotent_endomorphism_has_block_chain_basis : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall n :e omega , forall u : set -> set , field K addK mulK -> 0 :e n -> finite_dimensional_vector_space K addK mulK E addE smul -> module_dimension K addK mulK E addE smul = n -> module_endomorphism K addK mulK E addE smul u -> nilpotent_endomorphism K addK mulK E addE smul u -> exists r :e omega , exists sizes :e omega :^: r , exists b : set -> set , (forall k :e r , 0 :e sizes k) /\ ring_finite_sum omega add_SNo r (fun k => sizes k) = n /\ module_basis K addK mulK E addE smul n b /\ forall k :e r , forall j :e sizes k , add_nat (natural_indexed_sum k (fun h => sizes h)) j :e n /\ u (b (add_nat (natural_indexed_sum k (fun h => sizes h)) j)) = if 0 :e j then b (add_nat (natural_indexed_sum k (fun h => sizes h)) (Union j)) else module_zero E addE.
Axiom god1_natural_block_positions_equal_iff : forall r :e omega , forall sizes : set -> set , (forall k :e r , sizes k :e omega) -> forall k l :e r , forall i :e sizes k , forall j :e sizes l , (add_nat (natural_indexed_sum k sizes) i = add_nat (natural_indexed_sum l sizes) j <-> k = l /\ i = j).
