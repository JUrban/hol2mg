Axiom god1_s34_theorem4_distinct_eigenvectors_are_independent : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall n :e omega , forall u : set -> set , forall x :e E :^: n , forall lambda :e K :^: n , field K addK mulK -> module_endomorphism K addK mulK E addE smul u -> (forall i :e n , x i <> module_zero E addE /\ u (x i) = smul (lambda i) (x i)) -> (forall i j :e n , i <> j -> lambda i <> lambda j) -> linearly_independent_family K addK mulK E addE smul n (fun i => x i).
Definition diagonal_matrix_from_family : set -> (set -> set -> set) -> set -> (set -> set) -> set := fun K add n lambda => fun z :e n :*: n => if z 0 = z 1 then lambda (z 0) else ring_zero K add.
Definition diagonal_matrix : set -> (set -> set -> set) -> set -> set -> prop := fun K add n A => A :e square_matrix_ring K n /\ forall i j :e n , i <> j -> matrix_entry A i j = ring_zero K add.
Axiom god1_field_independent_family_full_size_basis : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall n :e omega , forall a x : set -> set , field K addK mulK -> module_basis K addK mulK E addE smul n a -> linearly_independent_family K addK mulK E addE smul n x -> module_basis K addK mulK E addE smul n x.
Axiom god1_polynomial_multiplicity_one_implies_root : forall K , forall add mul : set -> set -> set , forall f :e multivariate_polynomial_ring K add 1 , forall a :e K , field K add mul -> f <> (fun exponent :e omega :^: 1 => ring_zero K add) -> polynomial_root_multiplicity K add mul f a = 1 -> polynomial_zero K add mul K add mul 1 f (fun i => a).
Axiom god1_endomorphism_characteristic_polynomial_nonzero : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall n :e omega , forall a : set -> set , forall u : set -> set , field K addK mulK -> 0 :e n -> module_basis K addK mulK E addE smul n a -> module_endomorphism K addK mulK E addE smul u -> endomorphism_characteristic_polynomial K addK mulK E addE smul n a u <> (fun exponent :e omega :^: 1 => ring_zero K addK).
Axiom god1_basis_coordinate_generator : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall I , forall b : set -> set , module_basis K addK mulK E addE smul I b -> forall j i :e I , basis_coordinates K addK mulK E addE smul I b (b j) i = module_kronecker_coefficient K addK mulK j i.
Axiom god1_eigenbasis_coordinate_matrix_diagonal : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall n :e omega , forall b lambda : set -> set , forall u : set -> set , field K addK mulK -> module_basis K addK mulK E addE smul n b -> module_endomorphism K addK mulK E addE smul u -> (forall j :e n , lambda j :e K) -> (forall j :e n , u (b j) = smul (lambda j) (b j)) -> endomorphism_coordinate_matrix K addK mulK E addE smul n b u = diagonal_matrix_from_family K addK n lambda.
Axiom god1_s34_theorem5_simple_characteristic_roots_diagonalize : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall n :e omega , forall a : set -> set , forall u : set -> set , forall lambda :e K :^: n , field K addK mulK -> 0 :e n -> module_basis K addK mulK E addE smul n a -> module_endomorphism K addK mulK E addE smul u -> (forall i :e n , polynomial_root_multiplicity K addK mulK (endomorphism_characteristic_polynomial K addK mulK E addE smul n a u) (lambda i) = 1) -> (forall i j :e n , i <> j -> lambda i <> lambda j) -> exists b : set -> set , module_basis K addK mulK E addE smul n b /\ endomorphism_coordinate_matrix K addK mulK E addE smul n b u = diagonal_matrix_from_family K addK n (fun i => lambda i).
Axiom god1_canonical_basis_coordinate_matrix_conjugation : forall K , forall add mul : set -> set -> set , forall n :e omega , forall U :e square_matrix_ring K n , forall b : set -> set , field K add mul -> module_basis K add mul (K :^: n) (module_power_addition n add) (module_power_left_scalar n mul) n b -> exists P :e square_matrix_ring K n , invertible_matrix K add mul n P /\ matrix_multiplication K add mul n n n (matrix_multiplication K add mul n n n P U) (matrix_inverse K add mul n P) = endomorphism_coordinate_matrix K add mul (K :^: n) (module_power_addition n add) (module_power_left_scalar n mul) n b (god1_canonical_matrix_endomorphism K add mul n U).
Axiom god1_s34_theorem5_corollary_simple_root_matrix_diagonalization : forall K , forall add mul : set -> set -> set , forall n :e omega , forall U :e square_matrix_ring K n , forall lambda :e K :^: n , field K add mul -> 0 :e n -> (forall i :e n , polynomial_root_multiplicity K add mul (matrix_characteristic_polynomial K add mul n U) (lambda i) = 1) -> (forall i j :e n , i <> j -> lambda i <> lambda j) -> exists P :e square_matrix_ring K n , invertible_matrix K add mul n P /\ matrix_multiplication K add mul n n n (matrix_multiplication K add mul n n n P U) (matrix_inverse K add mul n P) = diagonal_matrix_from_family K add n (fun i => lambda i).
Definition diagonalizable_endomorphism : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> prop := fun K addK mulK E addE smul u => exists n :e omega , exists a : set -> set , module_basis K addK mulK E addE smul n a /\ forall i :e n , endomorphism_eigenvector K addK mulK E addE smul u (a i).
Definition endomorphism_eigenspace : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> set -> set := fun K addK mulK E addE smul u lambda => {x :e E|u x = smul lambda x}.
Definition endomorphism_eigenvalue_multiplicity : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> (set -> set) -> set -> set := fun K addK mulK E addE smul n a u lambda => polynomial_root_multiplicity K addK mulK (endomorphism_characteristic_polynomial K addK mulK E addE smul n a u) lambda.
Axiom god1_endomorphism_eigenspace_submodule : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall u : set -> set , forall lambda :e K , field K addK mulK -> module_endomorphism K addK mulK E addE smul u -> submodule K addK mulK E addE smul (endomorphism_eigenspace K addK mulK E addE smul u lambda).
Axiom god1_nonzero_scalar_annihilator_vector_zero : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , field K addK mulK -> left_module K addK mulK M addM smul -> forall scalar :e K , scalar <> ring_zero K addK -> forall x :e M , smul scalar x = module_zero M addM -> x = module_zero M addM.
Axiom god1_distinct_eigencomponents_zero_sum : forall n :e omega , forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall u x lambda : set -> set , field K addK mulK -> module_endomorphism K addK mulK E addE smul u -> (forall i :e n , x i :e E) -> (forall i :e n , lambda i :e K) -> (forall i :e n , u (x i) = smul (lambda i) (x i)) -> (forall i j :e n , i <> j -> lambda i <> lambda j) -> module_finitely_supported_sum E addE n x = module_zero E addE -> forall i :e n , x i = module_zero E addE.
Axiom god1_distinct_eigenspaces_linearly_independent : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall q :e omega , forall u : set -> set , forall roots :e K :^: q , field K addK mulK -> module_endomorphism K addK mulK E addE smul u -> (forall i j :e q , i <> j -> roots i <> roots j) -> linearly_independent_submodules K addK mulK E addE smul q (fun i => endomorphism_eigenspace K addK mulK E addE smul u (roots i)).
Axiom god1_polynomial_finite_total_degree_nonzero : forall K , forall add mul : set -> set -> set , forall f :e multivariate_polynomial_ring K add 1 , forall n :e omega , polynomial_total_degree K add 1 f = n -> f <> (fun exponent :e omega :^: 1 => ring_zero K add).
Axiom god1_polynomial_distinct_root_enumeration : forall K , forall add mul : set -> set -> set , forall f :e multivariate_polynomial_ring K add 1 , forall n :e omega , field K add mul -> polynomial_total_degree K add 1 f = n -> exists q :e omega , exists roots r : set -> set , (forall i :e q , roots i :e K /\ r i :e omega) /\ (forall i j :e q , i <> j -> roots i <> roots j) /\ (forall z :e K , polynomial_zero K add mul K add mul 1 f (fun h => z) <-> exists i :e q , z = roots i) /\ forall i :e q , polynomial_root_multiplicity K add mul f (roots i) = r i.
Axiom god1_split_polynomial_distinct_root_multiplicity_sum : forall K , forall add mul : set -> set -> set , forall f :e multivariate_polynomial_ring K add 1 , forall n q :e omega , forall a :e K :^: q , forall r :e omega :^: q , field K add mul -> polynomial_total_degree K add 1 f = n -> polynomial_splits_over K add mul f -> (forall i j :e q , i <> j -> a i <> a j) -> (forall z :e K , polynomial_zero K add mul K add mul 1 f (fun h => z) <-> exists i :e q , z = a i) -> (forall i :e q , polynomial_root_multiplicity K add mul f (a i) = r i) -> ring_finite_sum omega add_SNo q (fun i => r i) = n.
Axiom god1_split_polynomial_raw_root_multiplicity_sum : forall K , forall add mul : set -> set -> set , forall f :e multivariate_polynomial_ring K add 1 , forall n q :e omega , forall roots r : set -> set , field K add mul -> polynomial_total_degree K add 1 f = n -> polynomial_splits_over K add mul f -> (forall i :e q , roots i :e K /\ r i :e omega) -> (forall i j :e q , i <> j -> roots i <> roots j) -> (forall z :e K , polynomial_zero K add mul K add mul 1 f (fun h => z) <-> exists i :e q , z = roots i) -> (forall i :e q , polynomial_root_multiplicity K add mul f (roots i) = r i) -> ring_finite_sum omega add_SNo q (fun i => r i) = n.
Axiom god1_nonzero_coefficient_total_degree_lower_bound : forall K , forall add mul : set -> set -> set , forall f :e multivariate_polynomial_ring K add 1 , forall exponent :e omega :^: 1 , ring K add mul -> f exponent <> ring_zero K add -> polynomial_total_degree K add 1 f :e omega /\ exponent_total_degree 1 (fun i => exponent i) c= polynomial_total_degree K add 1 f.
Axiom god1_positive_dimensional_characteristic_polynomial_degree_lower_bound : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall n :e omega , forall a u : set -> set , field K addK mulK -> 0 :e n -> module_basis K addK mulK E addE smul n a -> module_endomorphism K addK mulK E addE smul u -> polynomial_total_degree K addK 1 (endomorphism_characteristic_polynomial K addK mulK E addE smul n a u) :e omega /\ n c= polynomial_total_degree K addK 1 (endomorphism_characteristic_polynomial K addK mulK E addE smul n a u).
Axiom god1_ring_finite_sum_naturals_is_natural_indexed_sum : forall q :e omega , forall f : set -> set , ring_finite_sum omega add_SNo q f = natural_indexed_sum q f.
Axiom god1_positive_dimensional_eigenspace_direct_sum_from_multiplicities : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall n :e omega , forall a u : set -> set , field K addK mulK -> 0 :e n -> module_basis K addK mulK E addE smul n a -> module_endomorphism K addK mulK E addE smul u -> polynomial_splits_over K addK mulK (endomorphism_characteristic_polynomial K addK mulK E addE smul n a u) -> (forall z :e K , endomorphism_eigenvalue K addK mulK E addE smul u z -> module_dimension K addK mulK (endomorphism_eigenspace K addK mulK E addE smul u z) addE smul = endomorphism_eigenvalue_multiplicity K addK mulK E addE smul n a u z) -> exists q :e omega , exists roots :e K :^: q , direct_sum_decomposition K addK mulK E addE smul q (fun i => endomorphism_eigenspace K addK mulK E addE smul u (roots i)).
Axiom god1_linearly_independent_submodules_zero_components : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall I , forall M : set -> set , left_module K addK mulK L addL smul -> linearly_independent_submodules K addK mulK L addL smul I M -> forall x :e indexed_module_product I M , submodule_family_sum_map L addL I x = module_zero L addL -> forall i :e I , x i = module_zero L addL.
Axiom god1_module_finite_dependent_double_sum : forall G , forall op : set -> set -> set , abelian_group G op -> forall I , finite I -> forall J : set -> set , (forall i :e I , finite (J i)) -> forall F : set -> set , (forall z :e (Sigma_ i :e I , J i) , F z :e G) -> finite (Sigma_ i :e I , J i) /\ module_finitely_supported_sum G op I (fun i => module_finitely_supported_sum G op (J i) (fun j => F ((i,j)))) = module_finitely_supported_sum G op (Sigma_ i :e I , J i) F.
Axiom god1_module_finite_dependent_double_sum_binary : forall G , forall op : set -> set -> set , abelian_group G op -> forall I , finite I -> forall J : set -> set , (forall i :e I , finite (J i)) -> forall F : set -> set -> set , (forall i :e I , forall j :e J i , F i j :e G) -> finite (Sigma_ i :e I , J i) /\ module_finitely_supported_sum G op I (fun i => module_finitely_supported_sum G op (J i) (fun j => F i j)) = module_finitely_supported_sum G op (Sigma_ i :e I , J i) (fun z => F (z 0) (z 1)).
Axiom god1_direct_sum_component_bases_form_basis : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall I , forall M J : set -> set , forall b : set -> set -> set , left_module K addK mulK L addL smul -> finite I -> (forall i :e I , submodule K addK mulK L addL smul (M i)) -> direct_sum_decomposition K addK mulK L addL smul I M -> (forall i :e I , finite (J i)) -> (forall i :e I , module_basis K addK mulK (M i) addL smul (J i) (b i)) -> module_basis K addK mulK L addL smul (Sigma_ i :e I , J i) (fun z => b (z 0) (z 1)).
Axiom god1_left_finite_basis_gives_finite_opposite_right_space : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall n :e omega , forall a : set -> set , division_ring K addK mulK -> module_basis K addK mulK E addE smul n a -> finite_dimensional_right_vector_space K addK (opposite_ring_multiplication mulK) E addE (fun x scalar => smul scalar x).
Definition god1_module_basis_tuple_choice : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> set := fun K addK mulK M addM smul I => Eps_i (fun c => c :e M :^: I /\ module_basis K addK mulK M addM smul I (fun i => c i)).
Axiom god1_module_basis_tuple_choice_specification : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , (exists a : set -> set , module_basis K addK mulK M addM smul I a) -> god1_module_basis_tuple_choice K addK mulK M addM smul I :e M :^: I /\ module_basis K addK mulK M addM smul I (fun i => god1_module_basis_tuple_choice K addK mulK M addM smul I i).
Axiom god1_zero_dimensional_endomorphism_diagonalizable : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall a u : set -> set , module_basis K addK mulK E addE smul 0 a -> diagonalizable_endomorphism K addK mulK E addE smul u.
Axiom god1_eigenspace_direct_sum_implies_diagonalizable : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall n :e omega , forall a : set -> set , forall u : set -> set , forall q :e omega , forall roots , field K addK mulK -> module_basis K addK mulK E addE smul n a -> module_endomorphism K addK mulK E addE smul u -> roots :e K :^: q -> direct_sum_decomposition K addK mulK E addE smul q (fun i => endomorphism_eigenspace K addK mulK E addE smul u (roots i)) -> diagonalizable_endomorphism K addK mulK E addE smul u.
Axiom god1_polynomial_root_multiplicity_eq_extremal_valuation : forall K , forall add mul : set -> set -> set , forall f :e multivariate_polynomial_ring K add 1 , forall a :e K , field K add mul -> f <> (fun exponent :e omega :^: 1 => ring_zero K add) -> polynomial_root_multiplicity K add mul f a = extremal_valuation (multivariate_polynomial_ring K add 1) (polynomial_addition K add 1) (polynomial_multiplication K add mul 1) (linear_root_polynomial K add mul a) f.
Axiom god1_polynomial_root_multiplicity_product : forall K , forall add mul : set -> set -> set , forall f g :e multivariate_polynomial_ring K add 1 , forall a :e K , field K add mul -> f <> (fun exponent :e omega :^: 1 => ring_zero K add) -> g <> (fun exponent :e omega :^: 1 => ring_zero K add) -> polynomial_root_multiplicity K add mul (polynomial_multiplication K add mul 1 f g) a = add_nat (polynomial_root_multiplicity K add mul f a) (polynomial_root_multiplicity K add mul g a).
Axiom god1_polynomial_ring_one_root_multiplicity_zero : forall K , forall add mul : set -> set -> set , forall a :e K , field K add mul -> polynomial_root_multiplicity K add mul (ring_one (multivariate_polynomial_ring K add 1) (polynomial_multiplication K add mul 1)) a = 0.
Axiom god1_polynomial_root_multiplicity_finite_product : forall K , forall add mul : set -> set -> set , forall n :e omega , forall f : set -> set , forall a :e K , field K add mul -> (forall i :e n , f i :e multivariate_polynomial_ring K add 1) -> (forall i :e n , f i <> (fun exponent :e omega :^: 1 => ring_zero K add)) -> polynomial_root_multiplicity K add mul (ring_finite_product (multivariate_polynomial_ring K add 1) (polynomial_addition K add 1) (polynomial_multiplication K add mul 1) n f) a = natural_indexed_sum n (fun i => polynomial_root_multiplicity K add mul (f i) a).
Axiom god1_linear_root_polynomial_root_multiplicity : forall K , forall add mul : set -> set -> set , forall a b :e K , field K add mul -> polynomial_root_multiplicity K add mul (linear_root_polynomial K add mul b) a = if a = b then 1 else 0.
Axiom god1_zero_degree_polynomial_root_multiplicity_zero : forall K , forall add mul : set -> set -> set , forall f :e multivariate_polynomial_ring K add 1 , forall a :e K , field K add mul -> f <> (fun exponent :e omega :^: 1 => ring_zero K add) -> polynomial_total_degree K add 1 f = 0 -> polynomial_root_multiplicity K add mul f a = 0.
Axiom god1_nonzero_polynomial_constant_nonzero : forall K , forall add mul : set -> set -> set , forall c :e K , commutative_ring K add mul -> c <> ring_zero K add -> polynomial_constant K add mul 1 c <> (fun exponent :e omega :^: 1 => ring_zero K add).
Axiom god1_nonzero_polynomial_constant_root_multiplicity_zero : forall K , forall add mul : set -> set -> set , forall c a :e K , field K add mul -> c <> ring_zero K add -> polynomial_root_multiplicity K add mul (polynomial_constant K add mul 1 c) a = 0.
Axiom god1_natural_indexed_sum_congr : forall n :e omega , forall f g : set -> set , (forall i :e n , f i = g i) -> natural_indexed_sum n f = natural_indexed_sum n g.
Axiom god1_split_factorization_root_multiplicity_count : forall K , forall add mul : set -> set -> set , forall n :e omega , forall c :e K , forall roots :e K :^: n , forall f :e multivariate_polynomial_ring K add 1 , forall z :e K , field K add mul -> c <> ring_zero K add -> f = polynomial_multiplication K add mul 1 (polynomial_constant K add mul 1 c) (ring_finite_product (multivariate_polynomial_ring K add 1) (polynomial_addition K add 1) (polynomial_multiplication K add mul 1) n (fun i => linear_root_polynomial K add mul (roots i))) -> polynomial_root_multiplicity K add mul f z = natural_indexed_sum n (fun i => if z = roots i then 1 else 0).
Axiom god1_split_polynomial_root_multiplicity_count : forall K , forall add mul : set -> set -> set , forall f :e multivariate_polynomial_ring K add 1 , field K add mul -> polynomial_splits_over K add mul f -> exists n :e omega , exists roots :e K :^: n , forall z :e K , polynomial_root_multiplicity K add mul f z = natural_indexed_sum n (fun i => if z = roots i then 1 else 0).
Axiom god1_diagonal_matrix_from_family_upper_triangular : forall K , forall add mul : set -> set -> set , forall n :e omega , forall lambda : set -> set , ring K add mul -> (forall i :e n , lambda i :e K) -> upper_triangular_matrix K add n (diagonal_matrix_from_family K add n lambda).
Axiom god1_eigenbasis_characteristic_root_multiplicity_count : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall n :e omega , forall b lambda u : set -> set , field K addK mulK -> module_basis K addK mulK E addE smul n b -> module_endomorphism K addK mulK E addE smul u -> (forall i :e n , lambda i :e K) -> (forall i :e n , u (b i) = smul (lambda i) (b i)) -> forall z :e K , endomorphism_eigenvalue_multiplicity K addK mulK E addE smul n b u z = natural_indexed_sum n (fun i => if z = lambda i then 1 else 0).
Axiom god1_linear_representation_restrict_to_zero_support : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I J , forall a : set -> set , forall x , forall coeff : set -> set , left_module K addK mulK M addM smul -> finite I -> J c= I -> (forall i :e I , a i :e M) -> linear_representation K addK mulK M addM smul I a x coeff -> (forall i :e I , i /:e J -> coeff i = ring_zero K addK) -> linear_representation K addK mulK M addM smul J a x coeff.
Axiom god1_eigenbasis_eigenspace_fiber_basis : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall n :e omega , forall b lambda u : set -> set , field K addK mulK -> module_basis K addK mulK E addE smul n b -> module_endomorphism K addK mulK E addE smul u -> (forall i :e n , lambda i :e K) -> (forall i :e n , u (b i) = smul (lambda i) (b i)) -> forall z :e K , module_basis K addK mulK (endomorphism_eigenspace K addK mulK E addE smul u z) addE smul {i :e n|z = lambda i} b.
Axiom god1_eigenbasis_eigenspace_dimension_count : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall n :e omega , forall b lambda u : set -> set , field K addK mulK -> module_basis K addK mulK E addE smul n b -> module_endomorphism K addK mulK E addE smul u -> (forall i :e n , lambda i :e K) -> (forall i :e n , u (b i) = smul (lambda i) (b i)) -> forall z :e K , module_dimension K addK mulK (endomorphism_eigenspace K addK mulK E addE smul u z) addE smul = natural_indexed_sum n (fun i => if z = lambda i then 1 else 0).
