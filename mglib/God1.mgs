Axiom not_mem_singleton_imp_neq : forall x c , x /:e {c} -> x <> c.
Axiom neq_imp_not_mem_singleton : forall x c , x <> c -> x /:e {c}.
Axiom finite_Sing : forall x , finite {x}.
Axiom point_not_in_two_parts_of_succ_mem : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> forall c :e Icc a b , forall i j :e n , ordsucc i :e j -> ~ (c :e part_Icc p i /\ c :e part_Icc p j).
Axiom point_in_two_parts_imp_adjacent : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> forall c :e Icc a b , forall i j :e n , c :e part_Icc p i -> c :e part_Icc p j -> i <> j -> j = ordsucc i \/ i = ordsucc j.
Axiom part_Icc_mem_of_partition_point_imp_eq_or_pred : forall a b n , forall p : set -> set , is_partition_seq_Icc a b n p -> forall c :e Icc a b , forall j :e n , p j = c -> j <> 0 -> forall i :e n , c :e part_Icc p i -> i = j \/ j = ordsucc i.
Axiom darboux_term_gap_Le_abs_bound_part : forall a b n , forall f p : set -> set , is_partition_seq_Icc a b n p -> bounded_fun (Icc a b) f -> forall i :e n , forall M :e R , (forall x :e part_Icc p i , abs_SNo (f x) <= M) -> (darboux_term_upper f p i) + (- (darboux_term_lower f p i)) <= (delta_part p i) * (M + M).
Axiom bounded_fun_Icc_of_eq_off_singleton : forall a b :e R , a <= b -> forall f g : set -> set , bounded_fun (Icc a b) f -> R_fun (Icc a b) g -> forall c :e Icc a b , (forall x :e Icc a b , x <> c -> f x = g x) -> bounded_fun (Icc a b) g.
Axiom riemann_integrable_Icc_of_eq_off_singleton_self : forall a :e R , forall f g : set -> set , riemann_integrable_Icc a a f -> R_fun (Icc a a) g -> forall c :e Icc a a , (forall x :e Icc a a , x <> c -> f x = g x) -> riemann_integrable_Icc a a g /\ riemann_integral_Icc a a g = riemann_integral_Icc a a f.
Axiom riemann_integrable_Icc_exists_partition_gap_lt_with_point : forall a b :e R , a <= b -> forall f : set -> set , riemann_integrable_Icc a b f -> forall eps :e R , 0 < eps -> forall c :e Icc a b , exists n :e omega , exists p : set -> set , is_partition_seq_Icc a b n p /\ c :e partition_seq_points n p /\ (darboux_sum_upper_seq f n p + (- (darboux_sum_lower_seq f n p))) < eps.
Axiom partial_sum_seq_singleton_term : forall n , nat_p n -> forall i :e n , forall x :e R , partial_sum_seq (fun k : set => if k = i then x else 0) n = x.
Axiom partial_sum_seq_add_two_singletons : forall n , nat_p n -> forall i :e n , forall j :e n , forall x y :e R , partial_sum_seq (seq_add (fun k : set => if k = i then x else 0) (fun k : set => if k = j then y else 0)) n = x + y.
Axiom partial_sum_seq_Le_of_term_Le_add_two_singletons : forall z : set -> set , forall n , nat_p n -> (forall k :e n , z k :e R) -> forall i :e n , forall j :e n , forall x y :e R , (forall k :e n , z k <= (seq_add (fun t : set => if t = i then x else 0) (fun t : set => if t = j then y else 0)) k) -> partial_sum_seq z n <= x + y.
Axiom partial_sum_seq_sub_eq : forall x y : set -> set , forall n , nat_p n -> (forall k :e n , x k :e R) -> (forall k :e n , y k :e R) -> partial_sum_seq (seq_sub x y) n = partial_sum_seq x n + (- (partial_sum_seq y n)).
Axiom partial_sum_seq_add_eq_on : forall x y : set -> set , forall n , nat_p n -> (forall k :e n , x k :e R) -> (forall k :e n , y k :e R) -> partial_sum_seq (seq_add x y) n = partial_sum_seq x n + partial_sum_seq y n.
Axiom darboux_sum_gap_eq_partial_sum_seq_sub : forall a b n , forall f p : set -> set , is_partition_seq_Icc a b n p -> bounded_fun (Icc a b) f -> darboux_sum_upper_seq f n p + (- (darboux_sum_lower_seq f n p)) = partial_sum_seq (seq_sub (fun i => darboux_term_upper f p i) (fun i => darboux_term_lower f p i)) n.
Axiom exists_two_points_around_interior_Icc_small_width : forall a b :e R , a < b -> forall c :e Ioo a b , forall delta :e R , 0 < delta -> exists u :e Ioo a b , exists v :e Ioo a b , u < c /\ c < v /\ v + (- u) < delta.
Axiom exists_point_right_of_left_Icc_small_width : forall a b :e R , a < b -> forall delta :e R , 0 < delta -> exists v :e Ioo a b , v + (- a) < delta.
Axiom exists_point_left_of_right_Icc_small_width : forall a b :e R , a < b -> forall delta :e R , 0 < delta -> exists u :e Ioo a b , b + (- u) < delta.
Axiom riemann_integrable_Icc_const0_integral_eq_0 : forall a b :e R , a <= b -> riemann_integrable_Icc a b (fun _ : set => 0) /\ riemann_integral_Icc a b (fun _ : set => 0) = 0.
Axiom R_fun_Icc_spike : forall a b :e R , a <= b -> forall c :e Icc a b , forall d :e R , R_fun (Icc a b) (fun x => if x = c then d else 0).
Axiom abs_spike_le_abs : forall a b :e R , a <= b -> forall c :e Icc a b , forall d :e R , forall x :e Icc a b , abs_SNo ((fun t : set => if t = c then d else 0) x) <= abs_SNo d.
Axiom bounded_fun_Icc_spike : forall a b :e R , a <= b -> forall c :e Icc a b , forall d :e R , bounded_fun (Icc a b) (fun x => if x = c then d else 0).
Axiom riemann_integrable_Icc_spike_integral_eq_0 : forall a b :e R , a < b -> forall c :e Icc a b , forall d :e R , riemann_integrable_Icc a b (fun x => if x = c then d else 0) /\ riemann_integral_Icc a b (fun x => if x = c then d else 0) = 0.
Axiom riemann_integrable_Icc_of_eq_off_singleton_lt : forall a b :e R , a < b -> forall f g : set -> set , riemann_integrable_Icc a b f -> R_fun (Icc a b) g -> forall c :e Icc a b , (forall x :e Icc a b , x <> c -> f x = g x) -> riemann_integrable_Icc a b g /\ riemann_integral_Icc a b g = riemann_integral_Icc a b f.
Axiom riemann_integrable_Icc_of_eq_off_singleton_lt_integrable : forall a b :e R , a < b -> forall f g : set -> set , riemann_integrable_Icc a b f -> R_fun (Icc a b) g -> forall c :e Icc a b , (forall x :e Icc a b , x <> c -> f x = g x) -> riemann_integrable_Icc a b g.
Axiom riemann_integrable_Icc_of_eq_off_singleton : forall a b :e R , a <= b -> forall f g : set -> set , riemann_integrable_Icc a b f -> R_fun (Icc a b) g -> forall c :e Icc a b , (forall x :e Icc a b , x <> c -> f x = g x) -> riemann_integrable_Icc a b g /\ riemann_integral_Icc a b g = riemann_integral_Icc a b f.
Axiom riemann_integrable_Icc_of_eq_off_finite_set : forall a b :e R , a <= b -> forall f g : set -> set , riemann_integrable_Icc a b f -> R_fun (Icc a b) g -> forall S , finite S -> S c= Icc a b -> (forall x :e Icc a b , x /:e S -> f x = g x) -> riemann_integrable_Icc a b g /\ riemann_integral_Icc a b g = riemann_integral_Icc a b f.
End form81.
Section form82.
Definition monotone_inc_on : (set -> set) -> set -> prop := fun f S => R_fun S f /\ forall x :e S , forall y :e S , x <= y -> f x <= f y.
Definition monotone_dec_on : (set -> set) -> set -> prop := fun f S => R_fun S f /\ forall x :e S , forall y :e S , x <= y -> f y <= f x.
Definition monotone_on : (set -> set) -> set -> prop := fun f S => monotone_inc_on f S \/ monotone_dec_on f S.
Axiom monotone_on_Icc_imp_bounded_fun : forall a b :e R , a <= b -> forall f : set -> set , monotone_on f (Icc a b) -> bounded_fun (Icc a b) f.
Axiom omega_subq_R : omega c= R.
Definition uniform_partition_step : set -> set -> set -> set := fun a b n => (b + (- a)) * (recip_SNo n).
Axiom exists_uniform_partition_step_lt : forall a b :e R , a < b -> forall delta :e R , 0 < delta -> exists n :e omega , (nat_p n /\ n <> 0) /\ uniform_partition_step a b n < delta.
Definition uniform_partition_seq_fun : set -> set -> set -> (set -> set) := fun a b n => fun i => a + i * (uniform_partition_step a b n).
Axiom uniform_partition_seq_fun_succ : forall a b :e R , forall n :e omega , forall i :e omega , uniform_partition_seq_fun a b n (ordsucc i) = (uniform_partition_seq_fun a b n i) + (uniform_partition_step a b n).
Axiom uniform_partition_is_partition_seq_Icc : forall a b :e R , a < b -> forall n , nat_p n -> n <> 0 -> is_partition_seq_Icc a b n (uniform_partition_seq_fun a b n).
Axiom delta_part_uniform_partition : forall a b :e R , a < b -> forall n , nat_p n -> n <> 0 -> forall i :e n , delta_part (uniform_partition_seq_fun a b n) i = uniform_partition_step a b n.
Axiom dist_R_Icc_Le_len : forall a b :e R , a <= b -> forall x :e Icc a b , forall y :e Icc a b , dist_R x y <= b + (- a).
Axiom delta_part_refine_block_Le : forall a b n m , forall p q : set -> set , is_partition_seq_Icc a b n p -> is_partition_seq_Icc a b m q -> forall i :e n , forall j0 :e ordsucc m , forall j1 :e ordsucc m , p i = q j0 -> p (ordsucc i) = q j1 -> j0 :e j1 -> forall j :e m , j0 :e ordsucc j -> ordsucc j :e ordsucc j1 -> delta_part q j <= delta_part p i.
Axiom continuous_on_Icc_exists_partition_gap_lt : forall a b :e R , a < b -> forall f : set -> set , continuous_on f (Icc a b) -> forall eps :e R , 0 < eps -> exists n :e omega , exists p : set -> set , is_partition_seq_Icc a b n p /\ (darboux_sum_upper_seq f n p + (- (darboux_sum_lower_seq f n p))) < eps.
Axiom partial_sum_seq_succ_diff_eq : forall n , nat_p n -> forall g : set -> set , (forall i :e ordsucc n , g i :e R) -> partial_sum_seq (fun i => g (ordsucc i) + (- (g i))) n = g n + (- (g 0)).
Axiom partial_sum_seq_neg_eq : forall y : set -> set , forall n :e omega , (forall k :e n , y k :e R) -> partial_sum_seq (seq_neg y) n = - (partial_sum_seq y n).
Axiom monotone_inc_on_Icc_exists_partition_gap_lt : forall a b :e R , a < b -> forall f : set -> set , monotone_inc_on f (Icc a b) -> forall eps :e R , 0 < eps -> exists n :e omega , exists p : set -> set , is_partition_seq_Icc a b n p /\ (darboux_sum_upper_seq f n p + (- (darboux_sum_lower_seq f n p))) < eps.
Axiom monotone_dec_on_Icc_exists_partition_gap_lt : forall a b :e R , a < b -> forall f : set -> set , monotone_dec_on f (Icc a b) -> forall eps :e R , 0 < eps -> exists n :e omega , exists p : set -> set , is_partition_seq_Icc a b n p /\ (darboux_sum_upper_seq f n p + (- (darboux_sum_lower_seq f n p))) < eps.
Axiom monotone_on_Icc_imp_riemann_integrable_Icc : forall a b :e R , a <= b -> forall f : set -> set , monotone_on f (Icc a b) -> riemann_integrable_Icc a b f.
Axiom continuous_on_Icc_imp_riemann_integrable_Icc : forall a b :e R , a <= b -> forall f : set -> set , continuous_on f (Icc a b) -> riemann_integrable_Icc a b f.
End form82.
Section form83.
Axiom Fdiff_bound_by_inf_sup_Icc : forall a b :e R , a < b -> forall F f : set -> set , continuous_on F (Icc a b) -> (forall x :e Ioo a b , deriv_at F (Ioo a b) x (f x)) -> bounded_fun (Icc a b) f -> inf_on f (Icc a b) * (b + (- a)) <= F b + (- (F a)) /\ F b + (- (F a)) <= sup_on f (Icc a b) * (b + (- a)).
Axiom Fdiff_bound_by_inf_sup_subinterval : forall a b :e R , a < b -> forall F f : set -> set , continuous_on F (Icc a b) -> (forall x :e Ioo a b , deriv_at F (Ioo a b) x (f x)) -> bounded_fun (Icc a b) f -> forall u v :e Icc a b , u < v -> inf_on f (Icc u v) * (v + (- u)) <= F v + (- (F u)) /\ F v + (- (F u)) <= sup_on f (Icc u v) * (v + (- u)).
Axiom FTCv1_Icc : forall a b :e R , a <= b -> forall F f : set -> set , continuous_on F (Icc a b) -> (forall x :e Ioo a b , deriv_at F (Ioo a b) x (f x)) -> riemann_integrable_Icc a b f -> riemann_integral_Icc a b f = F b + (- (F a)).
Definition integral_primitive_Icc : set -> (set -> set) -> set -> set := fun a f x => riemann_integral_Icc a x f.
Axiom lower_darboux_integral_Icc_ge_inf_mul_len : forall a b :e R , a < b -> forall f : set -> set , bounded_fun (Icc a b) f -> inf_on f (Icc a b) * (b + (- a)) <= lower_darboux_integral_Icc a b f.
Axiom upper_darboux_integral_Icc_le_sup_mul_len : forall a b :e R , a < b -> forall f : set -> set , bounded_fun (Icc a b) f -> upper_darboux_integral_Icc a b f <= sup_on f (Icc a b) * (b + (- a)).
Axiom integral_primitive_Icc_lipschitz_continuous_on : forall a b :e R , a < b -> forall f : set -> set , riemann_integrable_Icc a b f -> let F := integral_primitive_Icc a f in lipschitz_continuous_on F (Icc a b).
Axiom integral_primitive_Icc_continuous_on : forall a b :e R , a < b -> forall f : set -> set , riemann_integrable_Icc a b f -> let F := integral_primitive_Icc a f in continuous_on F (Icc a b).
Axiom diffquot_integral_primitive_Icc_eq_integral_gt : forall a b :e R , a < b -> forall f : set -> set , riemann_integrable_Icc a b f -> forall c x :e Icc a b , c < x -> let F := integral_primitive_Icc a f in diffquot F c x = (riemann_integral_Icc c x f) :/: (x + (- c)).
Axiom diffquot_integral_primitive_Icc_eq_integral_lt : forall a b :e R , a < b -> forall f : set -> set , riemann_integrable_Icc a b f -> forall c x :e Icc a b , x < c -> let F := integral_primitive_Icc a f in diffquot F c x = (riemann_integral_Icc x c f) :/: (c + (- x)).
Axiom dist_R_Icc_left_le : forall c t x :e R , c <= t -> t <= x -> dist_R t c <= dist_R x c.
Axiom dist_R_Icc_right_le : forall x t c :e R , x <= t -> t <= c -> dist_R t c <= dist_R x c.
Axiom riemann_integral_Icc_between_inf_sup_mul_len : forall a b :e R , a < b -> forall f : set -> set , riemann_integrable_Icc a b f -> inf_on f (Icc a b) * (b + (- a)) <= riemann_integral_Icc a b f /\ riemann_integral_Icc a b f <= sup_on f (Icc a b) * (b + (- a)).
Axiom riemann_integral_Icc_between_inf_sup_div_len : forall a b :e R , a < b -> forall f : set -> set , riemann_integrable_Icc a b f -> inf_on f (Icc a b) <= (riemann_integral_Icc a b f) :/: (b + (- a)) /\ (riemann_integral_Icc a b f) :/: (b + (- a)) <= sup_on f (Icc a b).
Axiom integral_primitive_Icc_deriv_at : forall a b :e R , a < b -> forall f : set -> set , riemann_integrable_Icc a b f -> forall c :e Icc a b , continuous_at f (Icc a b) c -> let F := integral_primitive_Icc a f in deriv_at F (Icc a b) c (f c).
Axiom FTCv2_Icc : forall a b :e R , a < b -> forall f : set -> set , riemann_integrable_Icc a b f -> let F := integral_primitive_Icc a f in continuous_on F (Icc a b) /\ forall c :e Icc a b , continuous_at f (Icc a b) c -> differentiable_at F (Icc a b) c /\ deriv_at F (Icc a b) c (f c).
Definition has_derivative_on : (set -> set) -> set -> (set -> set) -> prop := fun g I g' => forall x :e I , deriv_at g I x (g' x).
Axiom has_derivative_on_elim_f'R : forall f f' : set -> set , forall I , has_derivative_on f I f' -> forall x :e I , f' x :e R.
Axiom has_derivative_on_imp_continuous_on : forall f f' : set -> set , forall I , has_derivative_on f I f' -> continuous_on f I.
Axiom has_derivative_on_imp_differentiable_on : forall f f' : set -> set , forall I , has_derivative_on f I f' -> differentiable_on f I.
Axiom has_derivative_on_subinterval_Ioo : forall f f' : set -> set , forall a b x y :e R , a <= x -> y <= b -> has_derivative_on f (Ioo a b) f' -> has_derivative_on f (Ioo x y) f'.
Axiom continuous_at_comp : forall f : set -> set , forall T d , continuous_at f T d -> forall g : set -> set , forall S c , continuous_at g S c -> (forall x :e S , g x :e T) -> g c = d -> continuous_at (fun x => f (g x)) S c.
Axiom continuous_at_mul : forall f g : set -> set , forall S c , continuous_at f S c -> continuous_at g S c -> continuous_at (fun x => (f x) * (g x)) S c.
Axiom change_of_variables_Icc_degenerate : forall a b c d :e R , a <= b -> c <= d -> forall g g' f : set -> set , continuous_on g (Icc a b) -> has_derivative_on g (Icc a b) g' -> continuous_on g' (Icc a b) -> (forall x :e Icc a b , g x :e Icc c d) -> continuous_on f (Icc c d) -> g a <= g b -> c = d -> riemann_integral_Icc a b (fun x => f (g x) * (g' x)) = riemann_integral_Icc (g a) (g b) f.
Axiom change_of_variables_Icc : forall a b c d :e R , a <= b -> c <= d -> forall g g' f : set -> set , continuous_on g (Icc a b) -> has_derivative_on g (Icc a b) g' -> continuous_on g' (Icc a b) -> (forall x :e Icc a b , g x :e Icc c d) -> continuous_on f (Icc c d) -> g a <= g b -> riemann_integral_Icc a b (fun x => f (g x) * (g' x)) = riemann_integral_Icc (g a) (g b) f.
Axiom Icc_subq_Ioi0_of_left_pos : forall a b :e R , 0 < a -> Icc a b c= Ioi 0.
Axiom Ioo_subq_Ioi0_of_left_pos : forall a b :e R , 0 < a -> Ioo a b c= Ioi 0.
Definition recip_fun : set -> set := fun x => recip_SNo x.
Axiom recip_fun_continuous_at_Ioi0 : forall c :e Ioi 0 , continuous_at recip_fun (Ioi 0) c.
Axiom recip_fun_continuous_at_Icc_of_left_pos : forall a b :e R , 0 < a -> forall c :e Icc a b , continuous_at recip_fun (Icc a b) c.
Definition ln : set -> set := fun x => if x :e Ioi 0 then if 1 <= x then riemann_integral_Icc 1 x recip_fun else - (riemann_integral_Icc x 1 recip_fun) else 0.
Axiom ln_not_in_Ioi0_eq_0 : forall x , ~ (x :e Ioi 0) -> ln x = 0.
Axiom ln_in_Ioi0_of_1_le : forall x :e Ioi 0 , 1 <= x -> ln x = riemann_integral_Icc 1 x recip_fun.
Axiom ln_in_Ioi0_of_not_1_le : forall x :e Ioi 0 , ~ (1 <= x) -> ln x = - (riemann_integral_Icc x 1 recip_fun).
Axiom ln_1_eq_0 : ln 1 = 0.
Axiom recip_fun_continuous_on_Icc_of_left_pos : forall a b :e R , 0 < a -> continuous_on recip_fun (Icc a b).
Axiom riemann_integrable_Icc_recip_fun_of_left_pos : forall a b :e R , 0 < a -> a <= b -> riemann_integrable_Icc a b recip_fun.
Axiom ln_in_Ioi0_in_R : forall x :e Ioi 0 , ln x :e R.
Axiom ln_diff_eq_integral_Icc : forall y x :e Ioi 0 , y < x -> ln x + (- (ln y)) = riemann_integral_Icc y x recip_fun.
Axiom ln_deriv : forall x :e Ioi 0 , deriv_at ln (Ioi 0) x (recip_fun x).
Axiom ln_differentiable_on_Ioi0 : differentiable_on ln (Ioi 0).
Axiom ln_continuous_on_Ioi0 : continuous_on ln (Ioi 0).
Axiom ln_deriv_Ioo_of_left_pos : forall a b :e R , 0 < a -> forall c :e Ioo a b , deriv_at ln (Ioo a b) c (recip_fun c).
Axiom ln_deriv_Icc_of_left_pos : forall a b :e R , 0 < a -> a < b -> forall c :e Ioo a b , deriv_at ln (Icc a b) c (recip_fun c).
Axiom ln_strict_mono : forall x y :e Ioi 0 , x < y -> ln x < ln y.
Axiom ln_mul : forall x y :e Ioi 0 , ln (x * y) = ln x + ln y.
Axiom exists_unique_log_function : exists L : set -> set , (L 1 = 0) /\ (forall x :e Ioi 0 , deriv_at L (Ioi 0) x (recip_fun x)) /\ (forall x y :e Ioi 0 , x < y -> L x < L y) /\ (forall x y :e Ioi 0 , L (x * y) = L x + L y).
Definition exp : set -> set := inv (Ioi 0) ln.
Axiom exp_pos_and_ln_exp_on_fimage_ln : forall y :e fimage ln (Ioi 0) , exp y :e Ioi 0 /\ ln (exp y) = y.
Axiom ln_2_pos : 0 < ln 2.
Axiom ln_pow_2 : forall n :e omega , ln (2 ^ n) = n * (ln 2).
Axiom ln_pow_pos_nat : forall x :e Ioi 0 , forall n :e omega , ln (x ^ n) = n * (ln x).
Axiom ln_recip_SNo_of_pos : forall x :e Ioi 0 , ln (recip_SNo x) = - (ln x).
Axiom ln_surj_R_pos : forall y :e R , 0 < y -> exists u :e Ioi 0 , ln u = y.
Axiom ln_surj_R : forall y :e R , exists u :e Ioi 0 , ln u = y.
Axiom exp_pos_of_ln_surj : (forall y :e R , exists u :e Ioi 0 , ln u = y) -> forall x :e R , exp x :e Ioi 0.
Axiom exp_pos : forall x :e R , exp x :e Ioi 0.
Axiom exp_ln_of_ln_inj : (forall u v :e Ioi 0 , ln u = ln v -> u = v) -> forall x :e Ioi 0 , exp (ln x) = x.
Axiom exp_ln : forall x :e Ioi 0 , exp (ln x) = x.
Axiom exp_neg_ln_of_pos : forall x :e Ioi 0 , exp (- (ln x)) = recip_SNo x.
Axiom ln_exp : forall x :e R , ln (exp x) = x.
Axiom exp_neg_eq_recip_exp : forall z :e R , exp (- z) = recip_SNo (exp z).
Axiom exp_0_eq_1 : exp 0 = 1.
Axiom exp_ge_1_of_nonneg : forall x :e R , 0 <= x -> 1 <= exp x.
Axiom exp_strict_mono : forall x y :e R , x < y -> exp x < exp y.
Axiom exp_mono : forall x y :e R , x <= y -> exp x <= exp y.
Axiom riemann_integral_Icc_1_exp_recip_fun_eq : forall x :e R , 0 <= x -> riemann_integral_Icc 1 (exp x) recip_fun = x.
Axiom exp_add : forall x y :e R , exp (x + y) = (exp x) * (exp y).
Definition pow_R : set -> set -> set := fun x y => exp (y * (ln x)).
Axiom exp_mul_pow : forall x y :e R , exp (x * y) = pow_R (exp x) y.
Axiom ln_pow : forall x :e Ioi 0 , forall y :e R , ln (pow_R x y) = y * (ln x).
Axiom pow_R_pos : forall x :e Ioi 0 , forall y :e R , pow_R x y :e Ioi 0.
Axiom pow_R_in_R : forall x :e Ioi 0 , forall y :e R , pow_R x y :e R.
Axiom pow_R_neg : forall x :e Ioi 0 , forall y :e R , pow_R x (- y) = recip_SNo (pow_R x y).
Definition e : set := exp 1.
Axiom e_pos : e :e Ioi 0.
Axiom ln_e_eq_1 : ln e = 1.
Axiom e_gt_1 : 1 < e.
Axiom exp_eq_pow_e : forall x :e R , exp x = pow_R e x.
End form83.
Section form85.
Definition injective_on : (set -> set) -> set -> prop := fun f I => forall x :e I , forall y :e I , f x = f y -> x = y.
Definition surjective_on : (set -> set) -> set -> set -> prop := fun f I J => forall y :e J , exists x :e I , f x = y.
Definition bijective_on : (set -> set) -> set -> set -> prop := fun f I J => injective_on f I /\ surjective_on f I J.
Axiom strictly_increasing_on_imp_injective_on : forall f : set -> set , forall I , I c= R -> R_fun I f -> strictly_increasing_on f I -> injective_on f I.
Axiom strictly_decreasing_on_imp_injective_on : forall f : set -> set , forall I , I c= R -> R_fun I f -> strictly_decreasing_on f I -> injective_on f I.
Axiom Ioo_inner_Icc_symmetric : forall a b :e R , forall x0 :e Ioo a b , exists m :e R , 0 < m /\ Icc (x0 + (- m)) (x0 + m) c= Ioo a b.
Axiom inv_cancel_on_injective : forall f : set -> set , forall I , injective_on f I -> forall x :e I , inv I f (f x) = x.
Axiom diffquot_inv_on_f : forall f : set -> set , forall I , injective_on f I -> forall x0 :e I , forall x :e I , diffquot (inv I f) (f x0) (f x) = (x + (- x0)) :/: (f x + (- (f x0))).
Axiom recip_SNo_div_swap : forall a b , SNo a -> SNo b -> a <> 0 -> b <> 0 -> recip_SNo (a :/: b) = b :/: a.
Axiom diffquot_inv_on_f_eq_recip : forall f : set -> set , forall I , I c= R -> (forall x :e I , f x :e R) -> injective_on f I -> forall x0 :e I , forall x :e I , x <> x0 -> diffquot (inv I f) (f x0) (f x) = recip_SNo (diffquot f x0 x).
Axiom cluster_point_fimage_of_injective_continuous_at : forall f : set -> set , forall I c , continuous_at f I c -> cluster_point I c -> injective_on f I -> cluster_point (fimage f I) (f c).
Axiom ln_lt_imp_lt : forall u v :e Ioi 0 , ln u < ln v -> u < v.
Axiom deriv_at_inverse_of_continuous_at : forall f : set -> set , forall I , I c= R -> forall x0 :e I , forall L :e R , deriv_at f I x0 L -> L <> 0 -> injective_on f I -> let g := inv I f in continuous_at g (fimage f I) (f x0) -> deriv_at g (fimage f I) (f x0) (recip_SNo L).
Axiom deriv_at_inverse : forall f : set -> set , forall I , I c= R -> forall x0 :e I , forall L :e R , deriv_at f I x0 L -> L <> 0 -> injective_on f I -> let g := inv I f in continuous_at g (fimage f I) (f x0) -> deriv_at g (fimage f I) (f x0) (recip_SNo L).
Axiom R_subq_fimage_ln_Ioi0 : R c= fimage ln (Ioi 0).
Axiom recip_SNo_invol_of_pos : forall x :e R , 0 < x -> recip_SNo (recip_SNo x) = x.
Axiom exp_continuous_at : forall x :e R , continuous_at exp R x.
Axiom exp_deriv : forall x :e R , deriv_at exp R x (exp x).
Axiom deriv_pos_imp_strictly_increasing_Ioo : forall f f' : set -> set , forall a b :e R , a < b -> has_derivative_on f (Ioo a b) f' -> (forall x :e Ioo a b , 0 < f' x) -> strictly_increasing_on f (Ioo a b).
Axiom deriv_neg_imp_strictly_decreasing_Ioo : forall f f' : set -> set , forall a b :e R , a < b -> has_derivative_on f (Ioo a b) f' -> (forall x :e Ioo a b , f' x < 0) -> strictly_decreasing_on f (Ioo a b).
Axiom local_Ioo_with_deriv_sign : forall f' : set -> set , forall a b :e R , a < b -> forall x0 :e Ioo a b , continuous_on f' (Ioo a b) -> f' x0 <> 0 -> exists u v :e R , u < v /\ Ioo u v c= Ioo a b /\ x0 :e Ioo u v /\ ((forall x :e Ioo u v , 0 < f' x) \/ (forall x :e Ioo u v , f' x < 0)).
Axiom inv_strictly_increasing_on_fimage : forall f : set -> set , forall I , I c= R -> R_fun I f -> strictly_increasing_on f I -> strictly_increasing_on (inv I f) (fimage f I).
Axiom inv_strictly_decreasing_on_fimage : forall f : set -> set , forall I , I c= R -> R_fun I f -> strictly_decreasing_on f I -> strictly_decreasing_on (inv I f) (fimage f I).
Axiom R_gapL_cancel : forall y0 yL :e R , let gapL : set := y0 + (- yL) in y0 + (- gapL) = yL.
Axiom R_gapR_cancel : forall y0 yR :e R , let gapR : set := yR + (- y0) in y0 + gapR = yR.
Axiom exists_pos_lt_of_two_pos : forall eps m :e R , 0 < eps -> 0 < m -> exists e :e R , 0 < e /\ e < eps /\ e < m.
Axiom inv_continuous_on_of_strict_mono_Ioo : forall f : set -> set , forall u v :e R , u < v -> continuous_on f (Ioo u v) -> (strictly_increasing_on f (Ioo u v) \/ strictly_decreasing_on f (Ioo u v)) -> continuous_on (inv (Ioo u v) f) (fimage f (Ioo u v)).
Axiom inverse_function_theorem_Ioo : forall f f' : set -> set , forall a b :e R , a < b -> forall x0 :e Ioo a b , has_derivative_on f (Ioo a b) f' -> continuous_on f' (Ioo a b) -> f' x0 <> 0 -> exists I J , I c= Ioo a b /\ x0 :e I /\ J = fimage f I /\ injective_on f I /\ (forall y :e J , inv I f y :e I) /\ has_derivative_on (inv I f) J (fun y => recip_SNo (f' (inv I f y))).
End form85.
Section form86.
Definition nth_root : set -> set -> set := fun n x => pow_R x (recip_SNo n).
Axiom nth_root_spec_pos : forall n :e omega :\: {0} , forall x :e Ioi 0 , nth_root n x :e Ioi 0 /\ (nth_root n x) ^ n = x.
Axiom nth_root_unique_pos : forall n :e omega :\: {0} , forall x :e Ioi 0 , forall y :e Ioi 0 , y ^ n = x -> y = nth_root n x.
Axiom nth_root_deriv : forall n :e omega :\: {0} , forall x :e Ioi 0 , deriv_at (nth_root n) (Ioi 0) x ((recip_SNo n) * (pow_R x (recip_SNo n + (- 1)))).
End form86.
Section form87.
Axiom R_seq_of_pointwise_eq : forall x y : set -> set , (forall n :e omega , x n = y n) -> R_seq x -> R_seq y.
Axiom R_seq_of_eq_on_tail : forall x y : set -> set , R_seq x -> forall N0 :e omega , (forall n :e omega , N0 <= n -> y n = x n) -> (forall n :e omega , ~ (N0 <= n) -> y n :e R) -> R_seq y.
Definition tends_to_infty : (set -> set) -> prop := fun x => R_seq x /\ forall M :e R , exists N :e omega , forall n :e omega , N <= n -> M <= x n.
Axiom tends_to_infty_elim_R_seq : forall x : set -> set , tends_to_infty x -> R_seq x.
Axiom tends_to_infty_elim_eventually_ge : forall x : set -> set , tends_to_infty x -> forall M :e R , exists N :e omega , forall n :e omega , N <= n -> M <= x n.
Axiom tends_to_infty_id : tends_to_infty (fun n : set => n).
Definition clamp_from : set -> (set -> set) -> (set -> set) := fun a x => fun n => if a <= x n then x n else a.
Axiom clamp_from_ge : forall a :e R , forall x : set -> set , forall n :e omega , a <= clamp_from a x n.
Axiom clamp_from_eq_of_ge : forall a :e R , forall x : set -> set , forall n :e omega , a <= x n -> clamp_from a x n = x n.
Axiom tends_to_infty_clamp_from : forall a :e R , forall x : set -> set , tends_to_infty x -> tends_to_infty (clamp_from a x).
Axiom clamp_from_eq_on_tail_of_tends_to_infty : forall a :e R , forall x : set -> set , tends_to_infty x -> exists N :e omega , forall n :e omega , N <= n -> clamp_from a x n = x n.
Definition improper_integrable_from : set -> (set -> set) -> prop := fun a f => a :e R /\ (forall b :e R , a <= b -> riemann_integrable_Icc a b f) /\ exists L :e R , forall x : set -> set , tends_to_infty x -> seq_limit (fun n : set => riemann_integral_Icc a (clamp_from a x n) f) L.
Axiom improper_integrable_from_elim_a_in_R : forall a , forall f : set -> set , improper_integrable_from a f -> a :e R.
Axiom improper_integrable_from_elim_integrable : forall a , forall f : set -> set , improper_integrable_from a f -> forall b :e R , a <= b -> riemann_integrable_Icc a b f.
Axiom improper_integrable_from_elim_a_in_RT : forall a , forall f : set -> set , improper_integrable_from a f -> a :e R.
Axiom improper_integrable_from_elim_integrableT : forall a , forall f : set -> set , improper_integrable_from a f -> forall b :e R , a <= b -> riemann_integrable_Icc a b f.
Definition improper_integral_from : set -> (set -> set) -> set := fun a f => Eps_i (fun L => L :e R /\ forall x : set -> set , tends_to_infty x -> seq_limit (fun n : set => riemann_integral_Icc a (clamp_from a x n) f) L).
Axiom improper_integral_from_spec : forall a , forall f : set -> set , improper_integrable_from a f -> improper_integral_from a f :e R.
Axiom improper_integral_from_limit : forall a , forall f : set -> set , improper_integrable_from a f -> forall x : set -> set , tends_to_infty x -> seq_limit (fun n : set => riemann_integral_Icc a (clamp_from a x n) f) (improper_integral_from a f).
Axiom R_seq_riemann_integral_Icc_of_all_ge : forall b :e R , forall f : set -> set , (forall c :e R , b <= c -> riemann_integrable_Icc b c f) -> forall x : set -> set , R_seq x -> (forall n :e omega , b <= x n) -> R_seq (fun n : set => riemann_integral_Icc b (x n) f).
Axiom R_seq_riemann_integral_Icc_of_tends_to_infty_clamp_from : forall b :e R , forall f : set -> set , (forall c :e R , b <= c -> riemann_integrable_Icc b c f) -> forall x : set -> set , tends_to_infty x -> R_seq (fun n : set => riemann_integral_Icc b (clamp_from b x n) f).
Axiom R_seq_riemann_integral_Icc_of_tends_to_infty_and_all_ge : forall b :e R , forall f : set -> set , (forall c :e R , b <= c -> riemann_integrable_Icc b c f) -> forall x : set -> set , tends_to_infty x -> (forall n :e omega , b <= x n) -> R_seq (fun n : set => riemann_integral_Icc b (x n) f).
Axiom R_seq_riemann_integral_Icc_of_tends_to_infty : forall b :e R , forall f : set -> set , (forall c :e R , b <= c -> riemann_integrable_Icc b c f) -> forall x : set -> set , tends_to_infty x -> R_seq (fun n : set => riemann_integral_Icc b (clamp_from b x n) f).
End form87.
Section form88.
Definition tends_to_minus_infty : (set -> set) -> prop := fun x => R_seq x /\ forall M :e R , exists N :e omega , forall n :e omega , N <= n -> x n <= M.
Axiom tends_to_minus_infty_elim_R_seq : forall x : set -> set , tends_to_minus_infty x -> R_seq x.
Axiom tends_to_minus_infty_elim_eventually_le : forall x : set -> set , tends_to_minus_infty x -> forall M :e R , exists N :e omega , forall n :e omega , N <= n -> x n <= M.
Definition clamp_to : set -> (set -> set) -> (set -> set) := fun b x => fun n => if x n <= b then x n else b.
Axiom clamp_to_le : forall b :e R , forall x : set -> set , forall n :e omega , clamp_to b x n <= b.
Axiom tends_to_minus_infty_clamp_to : forall b :e R , forall x : set -> set , tends_to_minus_infty x -> tends_to_minus_infty (clamp_to b x).
Axiom clamp_to_eq_on_tail_of_tends_to_minus_infty : forall b :e R , forall x : set -> set , tends_to_minus_infty x -> exists N :e omega , forall n :e omega , N <= n -> clamp_to b x n = x n.
Axiom tends_to_infty_imp_tends_to_minus_infty_neg : forall x : set -> set , tends_to_infty x -> tends_to_minus_infty (seq_neg x).
Axiom tends_to_minus_infty_imp_tends_to_infty_neg : forall x : set -> set , tends_to_minus_infty x -> tends_to_infty (seq_neg x).
Definition tends_to_from_right : (set -> set) -> set -> prop := fun x a => R_seq x /\ seq_limit x a /\ (forall n :e omega , a < x n).
Definition tends_to_from_left : (set -> set) -> set -> prop := fun x b => R_seq x /\ seq_limit x b /\ (forall n :e omega , x n < b).
Definition improper_integrable_Ioo : set -> set -> (set -> set) -> prop := fun a b f => a :e R /\ b :e R /\ a < b /\ (forall c d :e R , a < c -> c < d -> d < b -> riemann_integrable_Icc c d f) /\ exists L :e R , forall x y : set -> set , tends_to_from_right x a -> tends_to_from_left y b -> seq_limit (fun n : set => riemann_integral_Icc (x n) (y n) f) L.
Axiom improper_integrable_Ioo_elim_inner_integrable : forall a b , forall f : set -> set , improper_integrable_Ioo a b f -> forall c d :e R , a < c -> c < d -> d < b -> riemann_integrable_Icc c d f.
Definition improper_integral_Ioo : set -> set -> (set -> set) -> set := fun a b f => Eps_i (fun L => L :e R /\ forall x y : set -> set , tends_to_from_right x a -> tends_to_from_left y b -> seq_limit (fun n : set => riemann_integral_Icc (x n) (y n) f) L).
Axiom tends_to_from_right_elim_R_seq : forall x : set -> set , forall a , tends_to_from_right x a -> R_seq x.
Axiom tends_to_from_right_elim_limit : forall x : set -> set , forall a , tends_to_from_right x a -> seq_limit x a.
Axiom tends_to_from_right_elim_eventually_gt : forall x : set -> set , forall a , tends_to_from_right x a -> forall n :e omega , a < x n.
Axiom tends_to_from_left_elim_R_seq : forall x : set -> set , forall b , tends_to_from_left x b -> R_seq x.
Axiom tends_to_from_left_elim_limit : forall x : set -> set , forall b , tends_to_from_left x b -> seq_limit x b.
Axiom tends_to_from_left_elim_eventually_lt : forall x : set -> set , forall b , tends_to_from_left x b -> forall n :e omega , x n < b.
Axiom improper_integrable_Ioo_elim_a_in_R : forall a b , forall f : set -> set , improper_integrable_Ioo a b f -> a :e R.
Axiom improper_integrable_Ioo_elim_b_in_R : forall a b , forall f : set -> set , improper_integrable_Ioo a b f -> b :e R.
Axiom improper_integrable_Ioo_elim_a_lt_b : forall a b , forall f : set -> set , improper_integrable_Ioo a b f -> a < b.
Axiom improper_integral_Ioo_spec : forall a b :e R , forall f : set -> set , improper_integrable_Ioo a b f -> improper_integral_Ioo a b f :e R.
Axiom improper_integral_Ioo_limit : forall a b :e R , forall f : set -> set , improper_integrable_Ioo a b f -> forall x y : set -> set , tends_to_from_right x a -> tends_to_from_left y b -> seq_limit (fun n : set => riemann_integral_Icc (x n) (y n) f) (improper_integral_Ioo a b f).
Definition improper_integrable_R : (set -> set) -> prop := fun f => improper_integrable_from 0 (fun x => f x) /\ improper_integrable_from 0 (fun x => f (- x)).
Axiom improper_integrable_R_elim_pos : forall f : set -> set , improper_integrable_R f -> improper_integrable_from 0 (fun x => f x).
Axiom improper_integrable_R_elim_neg : forall f : set -> set , improper_integrable_R f -> improper_integrable_from 0 (fun x => f (- x)).
End form88.
Section form89.
Definition nonneg_on : (set -> set) -> set -> prop := fun f S => forall x :e S , 0 <= f x.
Axiom riemann_integral_Icc_nonneg_of_pointwise_nonneg : forall a b :e R , a <= b -> forall f : set -> set , riemann_integrable_Icc a b f -> (forall x :e Icc a b , 0 <= f x) -> 0 <= riemann_integral_Icc a b f.
Axiom riemann_integral_Icc_mono_upper_of_nonneg_on_Ioi : forall a b c :e R , a < b -> b <= c -> forall f : set -> set , riemann_integrable_Icc a c f -> riemann_integrable_Icc a b f -> nonneg_on f (Ioi a) -> riemann_integral_Icc a b f <= riemann_integral_Icc a c f.
Axiom improper_integral_tail_from : forall a b :e R , a <= b -> forall f : set -> set , (forall c :e R , a <= c -> riemann_integrable_Icc a c f) -> improper_integrable_from a f -> improper_integrable_from b f /\ improper_integral_from a f = riemann_integral_Icc a b f + improper_integral_from b f.
Axiom improper_integral_from_eq_sup_of_nonneg : forall a :e R , forall f : set -> set , (forall b :e R , a <= b -> riemann_integrable_Icc a b f) -> nonneg_on f (Ioi a) -> improper_integrable_from a f -> improper_integral_from a f = sup {t :e R|exists x :e Ioi a , t = riemann_integral_Icc a x f}.
Axiom not_upper_bound_imp_exists_gt_R : forall S , (forall s :e S , s :e R) -> forall z :e R , ~ (upper_bound S z) -> exists s :e S , z < s.
Axiom not_lower_bound_imp_exists_lt_R : forall S , (forall s :e S , s :e R) -> forall z :e R , ~ (lower_bound S z) -> exists s :e S , s < z.
Axiom is_lub_imp_exists_gt_of_lt_R : forall S , (forall s :e S , s :e R) -> forall L :e R , is_lub S L -> forall z :e R , z < L -> exists s :e S , z < s.
Axiom is_glb_imp_exists_lt_of_gt_R : forall S , (forall s :e S , s :e R) -> forall L :e R , is_glb S L -> forall z :e R , L < z -> exists s :e S , s < z.
Axiom riemann_integral_Icc_mem_partial_integrals : forall a :e R , forall f : set -> set , forall b :e Ioi a , riemann_integrable_Icc a b f -> riemann_integral_Icc a b f :e {t :e R|exists u :e Ioi a , t = riemann_integral_Icc a u f}.
Axiom partial_integrals_is_lub_of_seq_limit_of_nonneg : forall a :e R , forall f : set -> set , (forall b :e R , a <= b -> riemann_integrable_Icc a b f) -> nonneg_on f (Ioi a) -> forall x : set -> set , tends_to_infty x -> forall L :e R , seq_limit (fun n : set => riemann_integral_Icc a (clamp_from a x n) f) L -> is_lub {t :e R|exists b :e Ioi a , t = riemann_integral_Icc a b f} L.
Axiom partial_integrals_seq_limit_of_lub_of_nonneg : forall a :e R , forall f : set -> set , (forall b :e R , a <= b -> riemann_integrable_Icc a b f) -> nonneg_on f (Ioi a) -> forall L :e R , is_lub {t :e R|exists b :e Ioi a , t = riemann_integral_Icc a b f} L -> forall x : set -> set , tends_to_infty x -> seq_limit (fun n : set => riemann_integral_Icc a (clamp_from a x n) f) L.
Axiom improper_integral_from_seq_iff_of_nonneg : forall a :e R , forall f : set -> set , (forall b :e R , a <= b -> riemann_integrable_Icc a b f) -> nonneg_on f (Ioi a) -> forall x : set -> set , tends_to_infty x -> (improper_integrable_from a f <-> exists L :e R , seq_limit (fun n : set => riemann_integral_Icc a (clamp_from a x n) f) L).
Axiom riemann_integral_Icc_abs_le_of_pointwise_abs_le : forall a b :e R , a <= b -> forall f g : set -> set , riemann_integrable_Icc a b f -> riemann_integrable_Icc a b g -> (forall x :e Icc a b , abs_SNo (f x) <= g x) -> abs_SNo (riemann_integral_Icc a b f) <= riemann_integral_Icc a b g.
Axiom dist_partial_integrals_le_of_pointwise_abs_le : forall a b c :e R , a <= b -> b <= c -> forall f g : set -> set , riemann_integrable_Icc a c f -> riemann_integrable_Icc a b f -> riemann_integrable_Icc a c g -> riemann_integrable_Icc a b g -> (forall x :e Icc b c , abs_SNo (f x) <= g x) -> dist_R (riemann_integral_Icc a c f) (riemann_integral_Icc a b f) <= dist_R (riemann_integral_Icc a c g) (riemann_integral_Icc a b g).
Axiom dist_R_in_R : forall x y :e R , dist_R x y :e R.
Axiom dist_R_nonneg : forall x y :e R , 0 <= dist_R x y.
Axiom seq_limit_of_dist_seq_limit_0 : forall x : set -> set , forall l , R_seq x -> l :e R -> seq_limit (fun n : set => dist_R (x n) l) 0 -> seq_limit x l.
Axiom improper_integral_comparison_test_aux : forall a :e R , forall f g : set -> set , improper_integrable_from a g -> (forall b :e R , a <= b -> riemann_integrable_Icc a b f) -> (forall x :e Ioi a , abs_SNo (f x) <= g x) -> improper_integrable_from a f.
Axiom improper_integral_comparison_test : forall a :e R , forall f g : set -> set , improper_integrable_from a g -> (forall b :e R , a <= b -> riemann_integrable_Icc a b f) -> (forall x :e Ioi a , abs_SNo (f x) <= g x) -> improper_integrable_from a f.
End form89.
Section form90.
Definition inv_pow : set -> set -> set := fun x p => recip_SNo (pow_R x p).
Axiom inv_pow_eq_pow_R_neg : forall x :e Ioi 0 , forall p :e R , inv_pow x p = pow_R x (- p).
Axiom inv_pow_strict_antimono_base : forall p :e R , 0 < p -> forall x y :e Ioi 0 , x < y -> inv_pow y p < inv_pow x p.
Axiom inv_pow_pos : forall x :e Ioi 0 , forall p :e R , inv_pow x p :e Ioi 0.
Axiom inv_pow_nonneg_on_Ioi0 : forall p :e R , nonneg_on (fun x => inv_pow x p) (Ioi 0).
Axiom not_bounded_seq_id : ~ bounded_seq (fun n : set => n).
Axiom not_seq_limit_id : forall l , ~ seq_limit (fun n : set => n) l.
Axiom tends_to_infty_exp_id : tends_to_infty (fun n : set => exp n).
Axiom not_improper_integrable_from_1_recip_fun : ~ improper_integrable_from 1 recip_fun.
Axiom recip_SNo_strict_antimono_Ioi0 : forall x y :e Ioi 0 , x < y -> recip_SNo y < recip_SNo x.
Axiom inv_pow_not_improper_integrable_from_1_of_le_1 : forall p :e R , 0 < p -> p <= 1 -> ~ improper_integrable_from 1 (fun x => inv_pow x p).
Axiom pow_R_one : forall y :e R , pow_R 1 y = 1.
Axiom pow_R_add_neg1 : forall x :e Ioi 0 , forall alpha :e R , pow_R x (alpha + (- 1)) = (pow_R x alpha) * recip_fun x.
Axiom deriv_at_pow_R_base : forall y :e R , forall x :e Ioi 0 , deriv_at (fun t => pow_R t y) (Ioi 0) x ((pow_R x y) * (y * (recip_fun x))).
Axiom exp_mul_omega_eq_pow_seq : forall a :e R , forall n :e omega , exp (a * n) = (exp a) ^ n.
Axiom seq_limit_exp_neg_mul_omega : forall r :e R , 0 < r -> seq_limit (fun n : set => exp ((- r) * n)) 0.
Axiom improper_integral_p_test_right_conv : forall p :e R , 0 < p -> 1 < p -> improper_integrable_from 1 (fun x => inv_pow x p) /\ improper_integral_from 1 (fun x => inv_pow x p) = recip_SNo (p + (- 1)).
Axiom improper_integral_p_test_right : forall p :e R , 0 < p -> (1 < p -> improper_integrable_from 1 (fun x => inv_pow x p) /\ improper_integral_from 1 (fun x => inv_pow x p) = recip_SNo (p + (- 1))) /\ (p <= 1 -> ~ improper_integrable_from 1 (fun x => inv_pow x p)).
End form90.
Section form91.
Definition R_fun_seq : set -> (set -> set -> set) -> prop := fun S fseq => forall n :e omega , R_fun S (fun x => fseq n x).
Definition pointwise_converges_to : set -> (set -> set -> set) -> (set -> set) -> prop := fun S fseq f => R_fun_seq S fseq /\ R_fun S f /\ forall x :e S , seq_limit (fun n => fseq n x) (f x).
Definition uniformly_converges_to : set -> (set -> set -> set) -> (set -> set) -> prop := fun S fseq f => R_fun_seq S fseq /\ R_fun S f /\ forall eps :e R , 0 < eps -> exists N :e omega , forall n :e omega , N <= n -> forall x :e S , dist_R (fseq n x) (f x) < eps.
Axiom uniformly_converges_to_imp_pointwise_converges_to : forall S , forall fseq : set -> set -> set , forall f : set -> set , uniformly_converges_to S fseq f -> pointwise_converges_to S fseq f.
Definition uniform_norm : set -> (set -> set) -> set := fun S f => sup_on (fun x => abs_SNo (f x)) S.
Axiom uniformly_converges_to_iff_seq_limit_sup_dist_0 : forall S , nonempty S -> forall fseq : set -> set -> set , forall f : set -> set , R_fun_seq S fseq -> R_fun S f -> (forall n :e omega , bounded_fun S (fun x => dist_R (fseq n x) (f x))) -> (uniformly_converges_to S fseq f <-> seq_limit (fun n => sup_on (fun x => dist_R (fseq n x) (f x)) S) 0).
Axiom mul_two_R_eq_add : forall x :e R , 2 * x = x + x.
Axiom add_half_R_eq : forall x :e R , (x :/: 2) + (x :/: 2) = x.
Definition continuous_on_seq : set -> (set -> set -> set) -> prop := fun S fseq => forall n :e omega , continuous_on (fun x => fseq n x) S.
Axiom uniform_limit_continuous_on : forall S , forall fseq : set -> set -> set , forall f : set -> set , continuous_on_seq S fseq -> uniformly_converges_to S fseq f -> forall c :e S , continuous_at f S c.
End form91.
Section form92.
Definition C_Icc : set -> set -> set -> set := fun a b J => {f :e (J :^: (Icc a b))|continuous_on (fun x => f x) (Icc a b)}.
Definition sup_dist_on : set -> set -> set -> set := fun D f g => sup_on (fun x => dist_R (f x) (g x)) D.
Definition d_C_Icc : set -> set -> set -> set -> set -> set := fun a b J f g => sup_dist_on (Icc a b) f g.
Axiom sup_dist_on_sym : forall D , forall f g , (forall x :e D , f x :e R) -> (forall x :e D , g x :e R) -> sup_dist_on D f g = sup_dist_on D g f.
Axiom bounded_fun_dist_R : forall D , forall f g : set -> set , bounded_fun D f -> bounded_fun D g -> bounded_fun D (fun x => dist_R (f x) (g x)).
Axiom sup_dist_on_in_R : forall D , nonempty D -> forall f g , bounded_fun D (fun x => dist_R (f x) (g x)) -> sup_dist_on D f g :e R.
Axiom dist_R_eq_0_imp_eq : forall x y :e R , dist_R x y = 0 -> x = y.
Axiom C_Icc_elim : forall a b J , forall f , f :e C_Icc a b J -> f :e (J :^: (Icc a b)) /\ continuous_on (fun x : set => f x) (Icc a b).
Axiom C_Icc_bounded_fun : forall a b :e R , a <= b -> forall J , J c= R -> forall f :e C_Icc a b J , bounded_fun (Icc a b) (fun x : set => f x).
Axiom d_C_Icc_in_R : forall a b :e R , a <= b -> forall J , J c= R -> forall f g :e C_Icc a b J , d_C_Icc a b J f g :e R.
Axiom sup_dist_on_nonneg : forall D , nonempty D -> forall f g , (forall x :e D , f x :e R) -> (forall x :e D , g x :e R) -> bounded_fun D (fun x : set => dist_R (f x) (g x)) -> 0 <= sup_dist_on D f g.
Axiom sup_dist_on_triangle : forall D , nonempty D -> forall f g h , (forall x :e D , f x :e R) -> (forall x :e D , g x :e R) -> (forall x :e D , h x :e R) -> bounded_fun D (fun x : set => dist_R (f x) (g x)) -> bounded_fun D (fun x : set => dist_R (g x) (h x)) -> bounded_fun D (fun x : set => dist_R (f x) (h x)) -> sup_dist_on D f h <= sup_dist_on D f g + sup_dist_on D g h.
Axiom sup_dist_on_refl : forall D , nonempty D -> forall f , (forall x :e D , f x :e R) -> bounded_fun D (fun x : set => dist_R (f x) (f x)) -> sup_dist_on D f f = 0.
Axiom sup_dist_on_eq_0_imp_pointwise_eq : forall D , nonempty D -> forall f g , (forall x :e D , f x :e R) -> (forall x :e D , g x :e R) -> bounded_fun D (fun x : set => dist_R (f x) (g x)) -> sup_dist_on D f g = 0 -> forall x :e D , f x = g x.
Axiom is_metric_C_Icc_d_C_Icc : forall a b :e R , a <= b -> forall J , J c= R -> is_metric (C_Icc a b J) (d_C_Icc a b J).
Axiom ms_cauchy_seq_C_Icc_pointwise_cauchy : forall a b :e R , a <= b -> forall x : set -> set , ms_cauchy_seq (C_Icc a b R) (d_C_Icc a b R) x -> forall t :e Icc a b , cauchy_seq (fun n : set => (x n) t).
Axiom ms_complete_C_Icc_d_C_Icc : forall a b :e R , a <= b -> ms_complete (C_Icc a b R) (d_C_Icc a b R).
Axiom continuous_on_lam_const : forall S , S c= R -> forall y0 :e R , continuous_on (fun x : set => (fun t :e S => y0) x) S.
Axiom C_Icc_nonempty : forall a b J , J c= R -> forall y0 :e J , nonempty (C_Icc a b J).
Axiom continuous_on_const : forall S , S c= R -> forall y0 :e R , continuous_on (fun _ : set => y0) S.
Definition picard_phi_Icc : set -> set -> (set -> set -> set) -> set -> set -> set := fun a b F y0 f => (fun x :e Icc a b => y0 + riemann_integral_Icc a x (fun t : set => F t (f t))).
Axiom picard_phi_Icc_in_C_Icc_R : forall a b :e R , a < b -> forall F : set -> set -> set , (forall t :e Icc a b , forall y :e R , F t y :e R) -> forall y0 :e R , forall f :e C_Icc a b R , riemann_integrable_Icc a b (fun t : set => F t (f t)) -> (picard_phi_Icc a b F y0 f) :e C_Icc a b R.
Axiom neg_one_mul_eq_neg : forall x :e R , (- 1) * x = - x.
Axiom R_add_eq_compat_right : forall x y z :e R , y = z -> x + y = x + z.
Axiom abs_SNo_eq_compat_R : forall x y :e R , x = y -> abs_SNo x = abs_SNo y.
Axiom d_C_Icc_nonneg : forall a b :e R , a <= b -> forall f :e C_Icc a b R , forall g :e C_Icc a b R , 0 <= d_C_Icc a b R f g.
Axiom ms_contraction_picard_phi_Icc : forall a b :e R , a < b -> forall F : set -> set -> set , (forall t :e Icc a b , forall y :e R , F t y :e R) -> forall L :e R , 0 <= L -> L * (b + (- a)) < 1 -> (forall t :e Icc a b , forall y z :e R , dist_R (F t y) (F t z) <= L * dist_R y z) -> forall y0 :e R , (forall f :e C_Icc a b R , riemann_integrable_Icc a b (fun t : set => F t (f t))) -> ms_contraction (fun f : set => picard_phi_Icc a b F y0 f) (C_Icc a b R) (d_C_Icc a b R).
Axiom ms_contraction_picard_phi_Icc_proof : True -> forall a b :e R , a < b -> forall F : set -> set -> set , (forall t :e Icc a b , forall y :e R , F t y :e R) -> forall L :e R , 0 <= L -> L * (b + (- a)) < 1 -> (forall t :e Icc a b , forall y z :e R , dist_R (F t y) (F t z) <= L * dist_R y z) -> forall y0 :e R , (forall f :e C_Icc a b R , riemann_integrable_Icc a b (fun t : set => F t (f t))) -> ms_contraction (fun f : set => picard_phi_Icc a b F y0 f) (C_Icc a b R) (d_C_Icc a b R).
Axiom picard_fixed_point_Icc : forall a b :e R , a < b -> forall F : set -> set -> set , (forall t :e Icc a b , forall y :e R , F t y :e R) -> forall L :e R , 0 <= L -> L * (b + (- a)) < 1 -> (forall t :e Icc a b , forall y z :e R , dist_R (F t y) (F t z) <= L * dist_R y z) -> forall y0 :e R , (forall f :e C_Icc a b R , riemann_integrable_Icc a b (fun t : set => F t (f t))) -> exists f :e C_Icc a b R , (fun g : set => picard_phi_Icc a b F y0 g) f = f /\ forall g :e C_Icc a b R , (fun x : set => picard_phi_Icc a b F y0 x) g = g -> g = f.
Axiom picard_integral_equation_Icc : forall a b :e R , a < b -> forall F : set -> set -> set , (forall t :e Icc a b , forall y :e R , F t y :e R) -> forall L :e R , 0 <= L -> L * (b + (- a)) < 1 -> (forall t :e Icc a b , forall y z :e R , dist_R (F t y) (F t z) <= L * dist_R y z) -> forall y0 :e R , (forall f :e C_Icc a b R , riemann_integrable_Icc a b (fun t : set => F t (f t))) -> exists f :e C_Icc a b R , (forall x :e Icc a b , f x = y0 + riemann_integral_Icc a x (fun t : set => F t (f t))) /\ forall g :e C_Icc a b R , (fun x : set => picard_phi_Icc a b F y0 x) g = g -> g = f.
Axiom picard_ode_solution_Icc : forall a b :e R , a < b -> forall F : set -> set -> set , (forall t :e Icc a b , forall y :e R , F t y :e R) -> forall L :e R , 0 <= L -> L * (b + (- a)) < 1 -> (forall t :e Icc a b , forall y z :e R , dist_R (F t y) (F t z) <= L * dist_R y z) -> forall y0 :e R , (forall f :e C_Icc a b R , riemann_integrable_Icc a b (fun t : set => F t (f t))) -> (forall f :e C_Icc a b R , continuous_on (fun t : set => F t (f t)) (Icc a b)) -> exists f :e C_Icc a b R , f a = y0 /\ (forall x :e Icc a b , deriv_at (fun u : set => f u) (Icc a b) x (F x (f x))) /\ forall g :e C_Icc a b R , g a = y0 -> (forall x :e Icc a b , deriv_at (fun u : set => g u) (Icc a b) x (F x (g x))) -> g = f.
End form92.
End RealAnalysis1.
Section RealAnalysis2.
Section form68.
Definition is_real_vector_space : set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> prop := fun X add zero neg smul => (forall u :e X , forall v :e X , add u v :e X) /\ (forall u :e X , forall v :e X , forall w :e X , add u (add v w) = add (add u v) w) /\ (forall u :e X , forall v :e X , add u v = add v u) /\ (zero :e X) /\ (forall v :e X , add v zero = v) /\ (forall v :e X , (neg v) :e X /\ add v (neg v) = zero) /\ (forall a :e R , forall v :e X , smul a v :e X) /\ (forall a :e R , forall u :e X , forall v :e X , smul a (add u v) = add (smul a u) (smul a v)) /\ (forall a :e R , forall b :e R , forall v :e X , smul (a + b) v = add (smul a v) (smul b v)) /\ (forall a :e R , forall b :e R , forall v :e X , smul (a * b) v = smul a (smul b v)) /\ (forall v :e X , smul 1 v = v).
Axiom rvs_zero_mem : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> zero :e X.
Axiom rvs_add_zero_R : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall v :e X , add v zero = v.
Axiom rvs_smul_closed : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall a :e R , forall v :e X , smul a v :e X.
Axiom rvs_add_closed : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall u :e X , forall v :e X , add u v :e X.
Axiom rvs_add_assoc : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall u :e X , forall v :e X , forall w :e X , add u (add v w) = add (add u v) w.
Axiom rvs_add_com : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall u :e X , forall v :e X , add u v = add v u.
Axiom rvs_add_zero_L : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall v :e X , add zero v = v.
Axiom rvs_smul_add_distr : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall a :e R , forall u :e X , forall v :e X , smul a (add u v) = add (smul a u) (smul a v).
Axiom rvs_smul_add_scalar_distr : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall a :e R , forall b :e R , forall v :e X , smul (a + b) v = add (smul a v) (smul b v).
Axiom rvs_smul_one : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall v :e X , smul 1 v = v.
Axiom rvs_neg_prop : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall v :e X , (neg v) :e X /\ add v (neg v) = zero.
Axiom rvs_smul_mul_assoc : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall a :e R , forall b :e R , forall v :e X , smul (a * b) v = smul a (smul b v).
Definition is_vector_subspace : set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> set -> prop := fun X add zero neg smul S => S c= X /\ zero :e S /\ (forall u :e S , forall v :e S , add u v :e S) /\ (forall a :e R , forall v :e S , smul a v :e S).
Axiom mem_singleton_of_eq : forall x y , y = x -> y :e {x}.
Axiom vector_subspace_test : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall S , S c= X -> (zero :e S) -> (forall u :e S , forall v :e S , add u v :e S) -> (forall a :e R , forall v :e S , smul a v :e S) -> is_vector_subspace X add zero neg smul S.
Axiom mem_eq_substL : forall X x y , y = x -> x :e X -> y :e X.
Axiom mem_eq_substR : forall X x y , x = y -> x :e X -> y :e X.
Axiom mem_eq_set_subst : forall A B x , A = B -> x :e A -> x :e B.
Axiom seq_func_limit_eq_subst : forall f : set -> set , forall S c L1 L2 , seq_func_limit f S c L1 -> L1 = L2 -> seq_func_limit f S c L2.
Axiom deriv_at_eq_subst : forall f : set -> set , forall I c L1 L2 , deriv_at f I c L1 -> L1 = L2 -> deriv_at f I c L2.
Axiom rvs_smul_neg1_eq_neg : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall v :e X , smul (- 1) v = neg v.
Axiom rvs_of_vector_subspace : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall S , is_vector_subspace X add zero neg smul S -> is_real_vector_space S add zero neg smul.
Axiom f_eq_i : forall f : set -> set , forall x y , x = y -> f x = f y.
Axiom eq_ref : forall x , x = x.
Axiom eq_trans : forall x y z , x = y -> y = z -> x = z.
Axiom rvs_add_add_swap : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall u :e X , forall v :e X , forall w :e X , add u (add v w) = add v (add u w).
Axiom rvs_add_add_add_add_swap : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall a :e X , forall b :e X , forall c :e X , forall d :e X , add (add a b) (add c d) = add (add a c) (add b d).
Axiom sing_subq_of_mem : forall X y , y :e X -> {y} c= X.
Axiom omega_Subq_SNoLe : forall m n :e omega , m c= n -> m <= n.
Axiom omega_mem_imp_SNoLe : forall m n :e omega , m :e n -> m <= n.
Axiom R_Le_trans : forall x y z :e R , x <= y -> y <= z -> x <= z.
Axiom R_nonneg_mul_Le_compat_R : forall x y z :e R , 0 <= z -> x <= y -> x * z <= y * z.
Axiom rvs_smul_zero : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall a :e R , smul a zero = zero.
Axiom rvs_add_cancel_L : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall u :e X , forall v :e X , forall w :e X , add u v = add u w -> v = w.
Axiom rvs_add_eq_zero_solve_R : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall u :e X , forall v :e X , add u v = zero -> v = neg u.
Axiom rvs_add_solve_R : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall u :e X , forall v :e X , forall w :e X , add u v = w -> v = add (neg u) w.
Axiom rvs_neg_neg : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall v :e X , neg (neg v) = v.
Axiom rvs_smul_0 : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall v :e X , smul 0 v = zero.
Axiom rvs_neg_add : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall u :e X , forall v :e X , neg (add u v) = add (neg u) (neg v).
Axiom rvs_neg_smul : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall a :e R , forall v :e X , neg (smul a v) = smul a (neg v).
Definition Rn : set -> set := fun n => setexp R n.
Definition Rn_zero : set -> set := fun n => (fun i :e n => 0).
Definition Rn_add : set -> set -> set -> set := fun n x y => (fun i :e n => (x i) + (y i)).
Definition Rn_neg : set -> set -> set := fun n x => (fun i :e n => - (x i)).
Definition Rn_smul : set -> set -> set -> set := fun n a x => (fun i :e n => a * (x i)).
Axiom Rn_zero_ap : forall n , forall i :e n , (Rn_zero n) i = 0.
Axiom Rn_add_ap : forall n , forall x y , forall i :e n , (Rn_add n x y) i = (x i) + (y i).
Axiom Rn_neg_ap : forall n , forall x , forall i :e n , (Rn_neg n x) i = - (x i).
Axiom Rn_smul_ap : forall n , forall a , forall x , forall i :e n , (Rn_smul n a x) i = a * (x i).
Axiom Rn_zero_mem : forall n :e omega , Rn_zero n :e Rn n.
Axiom Rn_add_closed : forall n :e omega , forall x :e Rn n , forall y :e Rn n , Rn_add n x y :e Rn n.
Axiom Rn_neg_closed : forall n :e omega , forall x :e Rn n , Rn_neg n x :e Rn n.
Axiom Rn_smul_closed : forall n :e omega , forall a :e R , forall x :e Rn n , Rn_smul n a x :e Rn n.
Axiom Rn_is_real_vector_space : forall n :e omega , is_real_vector_space (Rn n) (Rn_add n) (Rn_zero n) (Rn_neg n) (Rn_smul n).
Definition vs_finsum : (set -> set -> set) -> set -> (set -> set) -> set -> set := fun add zero term m => nat_primrec zero (fun i r => add r (term i)) m.
Axiom vs_finsum_0 : forall add : set -> set -> set , forall zero : set , forall t : set -> set , vs_finsum add zero t 0 = zero.
Axiom vs_finsum_S : forall add : set -> set -> set , forall zero : set , forall t : set -> set , forall m :e omega , vs_finsum add zero t (ordsucc m) = add (vs_finsum add zero t m) (t m).
Axiom vs_finsum_const_zero : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall m :e omega , vs_finsum add zero (fun i : set => zero) m = zero.
Axiom vs_finsum_ext : forall add : set -> set -> set , forall zero : set , forall t1 t2 : set -> set , forall m :e omega , (forall i :e m , t1 i = t2 i) -> vs_finsum add zero t1 m = vs_finsum add zero t2 m.
Axiom vs_finsum_closed : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall m :e omega , forall t : set -> set , (forall i :e m , t i :e X) -> vs_finsum add zero t m :e X.
Axiom vs_finsum_R_closed : forall t : set -> set , forall m :e omega , (forall i :e m , t i :e R) -> vs_finsum (fun r s => r + s) 0 t m :e R.
Axiom vs_finsum_R_nonneg : forall t : set -> set , forall m :e omega , (forall i :e m , t i :e R) -> (forall i :e m , 0 <= t i) -> 0 <= vs_finsum (fun r s => r + s) 0 t m.
Axiom vs_finsum_R_nonneg_eq0 : forall m :e omega , forall t : set -> set , (forall i :e m , t i :e R) -> (forall i :e m , 0 <= t i) -> vs_finsum (fun r s => r + s) 0 t m = 0 -> forall i :e m , t i = 0.
Axiom vs_finsum_R_add_split : forall t1 t2 : set -> set , forall m :e omega , (forall i :e m , t1 i :e R) -> (forall i :e m , t2 i :e R) -> vs_finsum (fun r s => r + s) 0 (fun i => (t1 i) + (t2 i)) m = (vs_finsum (fun r s => r + s) 0 t1 m) + (vs_finsum (fun r s => r + s) 0 t2 m).
Axiom vs_finsum_R_mul_const_left : forall a :e R , forall t : set -> set , forall m :e omega , (forall i :e m , t i :e R) -> vs_finsum (fun r s => r + s) 0 (fun i => a * (t i)) m = a * (vs_finsum (fun r s => r + s) 0 t m).
Axiom vs_finsum_R_eq_partial_sum_seq : forall t : set -> set , forall m , vs_finsum (fun r s => r + s) 0 t m = partial_sum_seq t m.
Axiom vs_finsum_add_split : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall t1 t2 : set -> set , forall m :e omega , (forall i :e m , t1 i :e X) -> (forall i :e m , t2 i :e X) -> vs_finsum add zero (fun i : set => add (t1 i) (t2 i)) m = add (vs_finsum add zero t1 m) (vs_finsum add zero t2 m).
Axiom vs_finsum_smul_const_left : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall a :e R , forall t : set -> set , forall m :e omega , (forall i :e m , t i :e X) -> vs_finsum add zero (fun i : set => smul a (t i)) m = smul a (vs_finsum add zero t m).
Axiom vs_finsum_smul_same_vector : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall w :e X , forall b : set -> set , forall m :e omega , (forall i :e m , b i :e R) -> vs_finsum add zero (fun i : set => smul (b i) w) m = smul (vs_finsum (fun r s => r + s) 0 b m) w.
Definition vs_lincomb : (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set) -> (set -> set) -> set -> set := fun add zero smul a x m => vs_finsum add zero (fun i => smul (a i) (x i)) m.
Axiom vs_lincomb_unfold : forall add : set -> set -> set , forall zero : set , forall smul : set -> set -> set , forall a x : set -> set , forall m , vs_lincomb add zero smul a x m = vs_finsum add zero (fun i : set => smul (a i) (x i)) m.
Axiom vs_lincomb_coeff_add_split : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall m :e omega , forall a b x : set -> set , (forall i :e m , a i :e R) -> (forall i :e m , b i :e R) -> (forall i :e m , x i :e X) -> vs_lincomb add zero smul (fun i : set => (a i) + (b i)) x m = add (vs_lincomb add zero smul a x m) (vs_lincomb add zero smul b x m).
Axiom vs_lincomb_eq_zero_of_coeff_zero : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall m :e omega , forall a x : set -> set , (forall i :e m , a i :e R) -> (forall i :e m , x i :e X) -> (forall i :e m , a i = 0) -> vs_lincomb add zero smul a x m = zero.
Axiom vs_lincomb_ne_zero_imp_exists_coeff_ne_zero : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall m :e omega , forall a x : set -> set , (forall i :e m , a i :e R) -> (forall i :e m , x i :e X) -> vs_lincomb add zero smul a x m <> zero -> exists i :e m , a i <> 0.
Axiom vs_lincomb_S : forall add : set -> set -> set , forall zero : set , forall smul : set -> set -> set , forall a x : set -> set , forall m :e omega , vs_lincomb add zero smul a x (ordsucc m) = add (vs_lincomb add zero smul a x m) (smul (a m) (x m)).
Axiom vs_lincomb_ext : forall add : set -> set -> set , forall zero : set , forall smul : set -> set -> set , forall a x1 x2 : set -> set , forall m :e omega , (forall i :e m , x1 i = x2 i) -> vs_lincomb add zero smul a x1 m = vs_lincomb add zero smul a x2 m.
Definition vs_span : set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> set -> set := fun X add zero neg smul Y => {v :e X|exists m :e omega , exists a :e setexp R m , exists x :e setexp Y m , v = vs_lincomb add zero smul (fun i : set => a i) (fun i : set => x i) m}.
Axiom vs_spanE : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , forall Y , forall v , v :e vs_span X add zero neg smul Y -> exists m :e omega , exists a :e setexp R m , exists x :e setexp Y m , v = vs_lincomb add zero smul (fun i : set => a i) (fun i : set => x i) m.
Axiom vs_span_singleton_eq_smul : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall w :e X , forall v , v :e vs_span X add zero neg smul {w} -> exists c :e R , v = smul c w.
Axiom vs_span_in_own_carrier_eq : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall Y , Y c= X -> vs_span (vs_span X add zero neg smul Y) add zero neg smul Y = vs_span X add zero neg smul Y.
Axiom vs_span_contains : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall Y , Y c= X -> forall y :e Y , y :e vs_span X add zero neg smul Y.
Axiom vs_lincomb_in_subspace : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall S , is_vector_subspace X add zero neg smul S -> forall m :e omega , forall a x : set -> set , (forall i :e m , a i :e R) -> (forall i :e m , x i :e S) -> vs_lincomb add zero smul a x m :e S.
Axiom vs_span_subq_of_subspace : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall S , is_vector_subspace X add zero neg smul S -> forall Y , Y c= S -> vs_span X add zero neg smul Y c= S.
Axiom vs_span_eq_of_subspace : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall S , is_vector_subspace X add zero neg smul S -> vs_span X add zero neg smul S = S.
Axiom nat_not_in_self : forall n , nat_p n -> n /:e n.
Axiom add_nat_not_in_left : forall m , nat_p m -> forall i , nat_p i -> (add_nat m i) /:e m.
Axiom mem_add_nat_decomp : forall m n , nat_p m -> nat_p n -> forall i :e add_nat m n , i :e m \/ exists k :e n , i = add_nat m k.
Axiom vs_span_zero_mem : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall Y , Y c= X -> zero :e vs_span X add zero neg smul Y.
Axiom vs_span_add_closed : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall Y , Y c= X -> forall u :e vs_span X add zero neg smul Y , forall v :e vs_span X add zero neg smul Y , add u v :e vs_span X add zero neg smul Y.
Axiom vs_span_smul_closed : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall Y , Y c= X -> forall a :e R , forall v :e vs_span X add zero neg smul Y , smul a v :e vs_span X add zero neg smul Y.
Axiom vs_span_neg_closed : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall Y , Y c= X -> forall u :e vs_span X add zero neg smul Y , neg u :e vs_span X add zero neg smul Y.
Axiom vs_span_mem_of_smul_eq : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall Y , Y c= X -> forall c :e R , c <> 0 -> forall v :e X , forall u :e vs_span X add zero neg smul Y , smul c v = u -> v :e vs_span X add zero neg smul Y.
Axiom vs_span_is_subspace : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall Y , Y c= X -> is_vector_subspace X add zero neg smul (vs_span X add zero neg smul Y).
Axiom vs_span_adjoin_decomp_aux : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall Y , Y c= X -> forall w :e X , forall m :e omega , forall a :e setexp R m , forall x :e setexp (Y :\/: {w}) m , forall v , v = vs_lincomb add zero smul (fun i : set => a i) (fun i : set => x i) m -> exists u :e vs_span X add zero neg smul Y , exists c :e R , v = add u (smul c w).
Axiom vs_span_adjoin_decomp : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall Y , Y c= X -> forall w :e X , forall v , v :e vs_span X add zero neg smul (Y :\/: {w}) -> exists u :e vs_span X add zero neg smul Y , exists c :e R , v = add u (smul c w).
Axiom vs_span_mono : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall Y Z , Y c= Z -> Z c= X -> vs_span X add zero neg smul Y c= vs_span X add zero neg smul Z.
Axiom vs_span_adjoin_eq_of_mem : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall Y , Y c= X -> forall v :e X , v :e vs_span X add zero neg smul Y -> vs_span X add zero neg smul (Y :\/: {v}) = vs_span X add zero neg smul Y.
Axiom vs_span_exchange_add_smul : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall Y , Y c= X -> forall u :e vs_span X add zero neg smul Y , forall c :e R , c <> 0 -> forall w :e X , w :e vs_span X add zero neg smul (Y :\/: {add u (smul c w)}).
Axiom vs_span_exchange_add_smul_eq : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall Y , Y c= X -> forall u :e vs_span X add zero neg smul Y , forall c :e R , c <> 0 -> forall w :e X , vs_span X add zero neg smul (Y :\/: {w}) = vs_span X add zero neg smul (Y :\/: {add u (smul c w)}).
Axiom vs_span_empty : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> vs_span X add zero neg smul Empty = {zero}.
Definition is_linear_map : set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> (set -> set) -> prop := fun X addX zeroX negX smulX Y addY zeroY negY smulY A => (forall x :e X , A x :e Y) /\ (forall a :e R , forall x :e X , A (smulX a x) = smulY a (A x)) /\ (forall x :e X , forall y :e X , A (addX x y) = addY (A x) (A y)).
Definition LXY : set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> set := fun X addX zeroX negX smulX Y addY zeroY negY smulY => {A :e setexp Y X|is_linear_map X addX zeroX negX smulX Y addY zeroY negY smulY (fun x => A x)}.
Axiom LXY_maps_to : forall X , forall addX : set -> set -> set , forall zeroX : set , forall negX : set -> set , forall smulX : set -> set -> set , forall Y , forall addY : set -> set -> set , forall zeroY : set , forall negY : set -> set , forall smulY : set -> set -> set , forall A :e LXY X addX zeroX negX smulX Y addY zeroY negY smulY , forall x :e X , A x :e Y.
Definition LX : set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> set := fun X addX zeroX negX smulX => LXY X addX zeroX negX smulX X addX zeroX negX smulX.
Definition map_add : set -> (set -> set -> set) -> set -> set -> set := fun X addY A B => (fun x :e X => addY (A x) (B x)).
Definition map_smul : set -> (set -> set -> set) -> set -> set -> set := fun X smulY a A => (fun x :e X => smulY a (A x)).
Definition map_comp : set -> set -> set -> set := fun X B A => (fun x :e X => A (B x)).
Definition map_id : set -> set := fun X => (fun x :e X => x).
Definition map_zero : set -> set -> set := fun X zeroY => (fun x :e X => zeroY).
Definition map_neg : set -> (set -> set) -> set -> set := fun X negY A => (fun x :e X => negY (A x)).
Definition LXY_add : set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> set -> set -> set := fun X addX zeroX negX smulX Y addY zeroY negY smulY A B => map_add X addY A B.
Definition LXY_smul : set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> set -> set -> set := fun X addX zeroX negX smulX Y addY zeroY negY smulY a A => map_smul X smulY a A.
Definition LXY_zero : set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> set := fun X addX zeroX negX smulX Y addY zeroY negY smulY => map_zero X zeroY.
Definition LXY_neg : set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> set -> set := fun X addX zeroX negX smulX Y addY zeroY negY smulY A => map_neg X negY A.
Axiom LXY_add_closed : forall X , forall addX : set -> set -> set , forall zeroX : set , forall negX : set -> set , forall smulX : set -> set -> set , forall Y , forall addY : set -> set -> set , forall zeroY : set , forall negY : set -> set , forall smulY : set -> set -> set , is_real_vector_space X addX zeroX negX smulX -> is_real_vector_space Y addY zeroY negY smulY -> forall A :e LXY X addX zeroX negX smulX Y addY zeroY negY smulY , forall B :e LXY X addX zeroX negX smulX Y addY zeroY negY smulY , (LXY_add X addX zeroX negX smulX Y addY zeroY negY smulY A B) :e LXY X addX zeroX negX smulX Y addY zeroY negY smulY.
Axiom LXY_zero_mem : forall X , forall addX : set -> set -> set , forall zeroX : set , forall negX : set -> set , forall smulX : set -> set -> set , forall Y , forall addY : set -> set -> set , forall zeroY : set , forall negY : set -> set , forall smulY : set -> set -> set , is_real_vector_space X addX zeroX negX smulX -> is_real_vector_space Y addY zeroY negY smulY -> (LXY_zero X addX zeroX negX smulX Y addY zeroY negY smulY) :e LXY X addX zeroX negX smulX Y addY zeroY negY smulY.
Axiom LXY_ap_zero : forall X , forall addX : set -> set -> set , forall zeroX : set , forall negX : set -> set , forall smulX : set -> set -> set , forall Y , forall addY : set -> set -> set , forall zeroY : set , forall negY : set -> set , forall smulY : set -> set -> set , is_real_vector_space X addX zeroX negX smulX -> is_real_vector_space Y addY zeroY negY smulY -> forall A :e LXY X addX zeroX negX smulX Y addY zeroY negY smulY , A zeroX = zeroY.
Axiom LXY_ap_vs_finsum : forall X , forall addX : set -> set -> set , forall zeroX : set , forall negX : set -> set , forall smulX : set -> set -> set , forall Y , forall addY : set -> set -> set , forall zeroY : set , forall negY : set -> set , forall smulY : set -> set -> set , is_real_vector_space X addX zeroX negX smulX -> is_real_vector_space Y addY zeroY negY smulY -> forall A :e LXY X addX zeroX negX smulX Y addY zeroY negY smulY , forall m :e omega , forall t : set -> set , (forall i :e m , t i :e X) -> A (vs_finsum addX zeroX t m) = vs_finsum addY zeroY (fun i : set => A (t i)) m.
Axiom LXY_ap_vs_lincomb : forall X , forall addX : set -> set -> set , forall zeroX : set , forall negX : set -> set , forall smulX : set -> set -> set , forall Y , forall addY : set -> set -> set , forall zeroY : set , forall negY : set -> set , forall smulY : set -> set -> set , is_real_vector_space X addX zeroX negX smulX -> is_real_vector_space Y addY zeroY negY smulY -> forall A :e LXY X addX zeroX negX smulX Y addY zeroY negY smulY , forall m :e omega , forall a x : set -> set , (forall i :e m , a i :e R) -> (forall i :e m , x i :e X) -> A (vs_lincomb addX zeroX smulX a x m) = vs_lincomb addY zeroY smulY a (fun i : set => A (x i)) m.
Axiom LXY_smul_closed : forall X , forall addX : set -> set -> set , forall zeroX : set , forall negX : set -> set , forall smulX : set -> set -> set , forall Y , forall addY : set -> set -> set , forall zeroY : set , forall negY : set -> set , forall smulY : set -> set -> set , is_real_vector_space X addX zeroX negX smulX -> is_real_vector_space Y addY zeroY negY smulY -> forall a :e R , forall A :e LXY X addX zeroX negX smulX Y addY zeroY negY smulY , (LXY_smul X addX zeroX negX smulX Y addY zeroY negY smulY a A) :e LXY X addX zeroX negX smulX Y addY zeroY negY smulY.
Axiom LXY_comp_closed : forall X , forall addX : set -> set -> set , forall zeroX : set , forall negX : set -> set , forall smulX : set -> set -> set , forall Y , forall addY : set -> set -> set , forall zeroY : set , forall negY : set -> set , forall smulY : set -> set -> set , forall Z , forall addZ : set -> set -> set , forall zeroZ : set , forall negZ : set -> set , forall smulZ : set -> set -> set , is_real_vector_space X addX zeroX negX smulX -> is_real_vector_space Y addY zeroY negY smulY -> is_real_vector_space Z addZ zeroZ negZ smulZ -> forall A :e LXY Y addY zeroY negY smulY Z addZ zeroZ negZ smulZ , forall B :e LXY X addX zeroX negX smulX Y addY zeroY negY smulY , (map_comp X B A) :e LXY X addX zeroX negX smulX Z addZ zeroZ negZ smulZ.
Axiom LXY_neg_closed : forall X , forall addX : set -> set -> set , forall zeroX : set , forall negX : set -> set , forall smulX : set -> set -> set , forall Y , forall addY : set -> set -> set , forall zeroY : set , forall negY : set -> set , forall smulY : set -> set -> set , is_real_vector_space X addX zeroX negX smulX -> is_real_vector_space Y addY zeroY negY smulY -> forall A :e LXY X addX zeroX negX smulX Y addY zeroY negY smulY , (LXY_neg X addX zeroX negX smulX Y addY zeroY negY smulY A) :e LXY X addX zeroX negX smulX Y addY zeroY negY smulY.
Axiom LXY_is_real_vector_space : forall X , forall addX : set -> set -> set , forall zeroX : set , forall negX : set -> set , forall smulX : set -> set -> set , forall Y , forall addY : set -> set -> set , forall zeroY : set , forall negY : set -> set , forall smulY : set -> set -> set , is_real_vector_space X addX zeroX negX smulX -> is_real_vector_space Y addY zeroY negY smulY -> is_real_vector_space (LXY X addX zeroX negX smulX Y addY zeroY negY smulY) (LXY_add X addX zeroX negX smulX Y addY zeroY negY smulY) (LXY_zero X addX zeroX negX smulX Y addY zeroY negY smulY) (LXY_neg X addX zeroX negX smulX Y addY zeroY negY smulY) (LXY_smul X addX zeroX negX smulX Y addY zeroY negY smulY).
Axiom LX_id_mem : forall X , forall addX : set -> set -> set , forall zeroX : set , forall negX : set -> set , forall smulX : set -> set -> set , is_real_vector_space X addX zeroX negX smulX -> (map_id X) :e LX X addX zeroX negX smulX.
Definition is_linear_inverse : set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> set -> set -> prop := fun X addX zeroX negX smulX Y addY zeroY negY smulY A B => A :e LXY X addX zeroX negX smulX Y addY zeroY negY smulY /\ B :e LXY Y addY zeroY negY smulY X addX zeroX negX smulX /\ (forall x :e X , B (A x) = x) /\ (forall y :e Y , A (B y) = y).
Definition is_linear_invertible : set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> set -> prop := fun X addX zeroX negX smulX Y addY zeroY negY smulY A => exists B , is_linear_inverse X addX zeroX negX smulX Y addY zeroY negY smulY A B.
Axiom is_linear_inverse_bij : forall X , forall addX : set -> set -> set , forall zeroX : set , forall negX : set -> set , forall smulX : set -> set -> set , forall Y , forall addY : set -> set -> set , forall zeroY : set , forall negY : set -> set , forall smulY : set -> set -> set , forall A B , is_linear_inverse X addX zeroX negX smulX Y addY zeroY negY smulY A B -> bij X Y (fun x : set => A x).
Axiom is_linear_inverse_bij_inv : forall X , forall addX : set -> set -> set , forall zeroX : set , forall negX : set -> set , forall smulX : set -> set -> set , forall Y , forall addY : set -> set -> set , forall zeroY : set , forall negY : set -> set , forall smulY : set -> set -> set , forall A B , is_linear_inverse X addX zeroX negX smulX Y addY zeroY negY smulY A B -> bij Y X (fun y : set => B y).
Axiom is_linear_invertible_bij : forall X , forall addX : set -> set -> set , forall zeroX : set , forall negX : set -> set , forall smulX : set -> set -> set , forall Y , forall addY : set -> set -> set , forall zeroY : set , forall negY : set -> set , forall smulY : set -> set -> set , forall A , is_linear_invertible X addX zeroX negX smulX Y addY zeroY negY smulY A -> bij X Y (fun x : set => A x).
Axiom is_linear_invertible_inj : forall X , forall addX : set -> set -> set , forall zeroX : set , forall negX : set -> set , forall smulX : set -> set -> set , forall Y , forall addY : set -> set -> set , forall zeroY : set , forall negY : set -> set , forall smulY : set -> set -> set , forall A , is_linear_invertible X addX zeroX negX smulX Y addY zeroY negY smulY A -> inj X Y (fun x : set => A x).
Axiom is_linear_invertible_surj : forall X , forall addX : set -> set -> set , forall zeroX : set , forall negX : set -> set , forall smulX : set -> set -> set , forall Y , forall addY : set -> set -> set , forall zeroY : set , forall negY : set -> set , forall smulY : set -> set -> set , forall A , is_linear_invertible X addX zeroX negX smulX Y addY zeroY negY smulY A -> surj X Y (fun x : set => A x).
Axiom LXY_inv_closed : forall X , forall addX : set -> set -> set , forall zeroX : set , forall negX : set -> set , forall smulX : set -> set -> set , forall Y , forall addY : set -> set -> set , forall zeroY : set , forall negY : set -> set , forall smulY : set -> set -> set , is_real_vector_space X addX zeroX negX smulX -> is_real_vector_space Y addY zeroY negY smulY -> forall A , is_linear_invertible X addX zeroX negX smulX Y addY zeroY negY smulY A -> exists B , is_linear_inverse X addX zeroX negX smulX Y addY zeroY negY smulY A B /\ B :e LXY Y addY zeroY negY smulY X addX zeroX negX smulX.
Definition is_convex : set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> set -> prop := fun X add zero neg smul U => U c= X /\ forall x :e U , forall y :e U , forall t :e Icc 0 1 , add (smul (1 + - t) x) (smul t y) :e U.
Axiom is_convex_subq : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , forall U , is_convex X add zero neg smul U -> U c= X.
Axiom is_convex_comb_mem : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , forall U , is_convex X add zero neg smul U -> forall x :e U , forall y :e U , forall t :e Icc 0 1 , add (smul (1 + - t) x) (smul t y) :e U.
Axiom convex_binintersect : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , forall U V , is_convex X add zero neg smul U -> is_convex X add zero neg smul V -> is_convex X add zero neg smul (U :/\: V).
Axiom vector_subspace_is_convex : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall S , is_vector_subspace X add zero neg smul S -> is_convex X add zero neg smul S.
Axiom linear_map_image_convex : forall X , forall addX : set -> set -> set , forall zeroX : set , forall negX : set -> set , forall smulX : set -> set -> set , forall Y , forall addY : set -> set -> set , forall zeroY : set , forall negY : set -> set , forall smulY : set -> set -> set , is_real_vector_space X addX zeroX negX smulX -> is_real_vector_space Y addY zeroY negY smulY -> forall A :e LXY X addX zeroX negX smulX Y addY zeroY negY smulY , forall C , is_convex X addX zeroX negX smulX C -> is_convex Y addY zeroY negY smulY {A x|x :e C}.
Definition vs_family_set : (set -> set) -> set -> set := fun x m => {x i|i :e m}.
Axiom omega_ordsucc_inv : forall m , ordsucc m :e omega -> m :e omega.
Axiom vs_family_set_ordsucc : forall x : set -> set , forall m :e omega , vs_family_set x (ordsucc m) = (vs_family_set x m) :\/: {x m}.
Axiom vs_family_set_0 : forall x : set -> set , vs_family_set x 0 = Empty.
Axiom vs_family_set_subq : forall X , forall x : set -> set , forall m :e omega , (forall i :e m , x i :e X) -> (vs_family_set x m) c= X.
Definition vs_linindep_family : set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> (set -> set) -> set -> prop := fun X add zero neg smul x m => (m :e omega) /\ (forall i :e m , x i :e X) /\ forall a : set -> set , (forall i :e m , a i :e R) -> vs_lincomb add zero smul a x m = zero -> forall i :e m , a i = 0.
Axiom vs_linindep_family_restrict_carrier : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , forall S , forall x : set -> set , forall m , vs_linindep_family X add zero neg smul x m -> (forall i :e m , x i :e S) -> vs_linindep_family S add zero neg smul x m.
Axiom vs_linindep_family_len_eq : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , forall x : set -> set , forall m n , m = n -> vs_linindep_family X add zero neg smul x m -> vs_linindep_family X add zero neg smul x n.
Axiom vs_linindep_family_prefix : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall m , forall x : set -> set , vs_linindep_family X add zero neg smul x (ordsucc m) -> vs_linindep_family X add zero neg smul x m.
Axiom vs_linindep_family_prefix_add_nat : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall d :e omega , forall k :e omega , forall x : set -> set , vs_linindep_family X add zero neg smul x (add_nat d k) -> vs_linindep_family X add zero neg smul x d.
Axiom vs_linindep_family_nonzero : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , forall x : set -> set , forall m :e omega , is_real_vector_space X add zero neg smul -> vs_linindep_family X add zero neg smul x m -> forall i :e m , x i <> zero.
Definition vs_spans_family : set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> (set -> set) -> set -> prop := fun X add zero neg smul x m => vs_span X add zero neg smul (vs_family_set x m) = X.
Definition vs_basis_family : set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> (set -> set) -> set -> prop := fun X add zero neg smul x m => vs_linindep_family X add zero neg smul x m /\ vs_spans_family X add zero neg smul x m.
Definition vs_finite_dim : set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> prop := fun X add zero neg smul => exists m :e omega , exists x : set -> set , vs_basis_family X add zero neg smul x m.
Definition vs_dim_eq : set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> set -> prop := fun X add zero neg smul d => d :e omega /\ exists x : set -> set , vs_basis_family X add zero neg smul x d.
Definition vs_dim_le : set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> set -> prop := fun X add zero neg smul d => d :e omega /\ forall m :e omega , forall x : set -> set , vs_linindep_family X add zero neg smul x m -> m <= d.
Axiom vs_spans_family_mem : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , forall x : set -> set , forall m , vs_spans_family X add zero neg smul x m -> forall v :e X , v :e vs_span X add zero neg smul (vs_family_set x m).
Axiom vs_dim_le_of_no_ordsucc_linindep : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall d :e omega , (forall x : set -> set , vs_linindep_family X add zero neg smul x (ordsucc d) -> False) -> vs_dim_le X add zero neg smul d.
Axiom ordinal_ne0_imp_0_In : forall alpha , ordinal alpha -> alpha <> 0 -> 0 :e alpha.
Axiom vs_family_set_nonempty_of_ne0 : forall x : set -> set , forall n , nat_p n -> n <> 0 -> exists z , z :e vs_family_set x n.
Axiom vs_no_linindep_ordsucc_of_spans_family_0 : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall x : set -> set , (forall i :e 0 , x i :e X) -> vs_spans_family X add zero neg smul x 0 -> forall y : set -> set , vs_linindep_family X add zero neg smul y (ordsucc 0) -> False.
Axiom vs_no_linindep_ordsucc_of_spans_family : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall d :e omega , forall x : set -> set , (forall i :e d , x i :e X) -> vs_spans_family X add zero neg smul x d -> forall y : set -> set , vs_linindep_family X add zero neg smul y (ordsucc d) -> False.
Axiom vs_dim_le_of_spans_family : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall d :e omega , forall x : set -> set , (forall i :e d , x i :e X) -> vs_spans_family X add zero neg smul x d -> vs_dim_le X add zero neg smul d.
Axiom vs_dim_le_of_spans_family_0 : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall x : set -> set , (forall i :e 0 , x i :e X) -> vs_spans_family X add zero neg smul x 0 -> vs_dim_le X add zero neg smul 0.
Axiom vs_linindep_family_extend_not_in_span : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall m :e omega , forall x : set -> set , vs_linindep_family X add zero neg smul x m -> forall v :e X , v /:e vs_span X add zero neg smul (vs_family_set x m) -> vs_linindep_family X add zero neg smul (fun i : set => if i = m then v else x i) (ordsucc m).
Axiom vs_dim_le_subspace : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , is_real_vector_space X add zero neg smul -> forall d :e omega , vs_dim_le X add zero neg smul d -> forall S , is_vector_subspace X add zero neg smul S -> vs_dim_le S add zero neg smul d.
Definition linear_nullspace : set -> set -> (set -> set) -> set := fun X zeroY A => {x :e X|A x = zeroY}.
Axiom LXY_eq_on_span_of_eq_on_set : forall X , forall addX : set -> set -> set , forall zeroX : set , forall negX : set -> set , forall smulX : set -> set -> set , forall Y , forall addY : set -> set -> set , forall zeroY : set , forall negY : set -> set , forall smulY : set -> set -> set , is_real_vector_space X addX zeroX negX smulX -> is_real_vector_space Y addY zeroY negY smulY -> forall S , S c= X -> forall A :e LXY X addX zeroX negX smulX Y addY zeroY negY smulY , forall B :e LXY X addX zeroX negX smulX Y addY zeroY negY smulY , (forall s :e S , A s = B s) -> forall v :e (vs_span X addX zeroX negX smulX S) , A v = B v.
Axiom LXY_eq_of_eq_on_basis_family : forall X , forall addX : set -> set -> set , forall zeroX : set , forall negX : set -> set , forall smulX : set -> set -> set , forall Y , forall addY : set -> set -> set , forall zeroY : set , forall negY : set -> set , forall smulY : set -> set -> set , is_real_vector_space X addX zeroX negX smulX -> is_real_vector_space Y addY zeroY negY smulY -> forall m :e omega , forall x : set -> set , vs_basis_family X addX zeroX negX smulX x m -> forall A :e LXY X addX zeroX negX smulX Y addY zeroY negY smulY , forall B :e LXY X addX zeroX negX smulX Y addY zeroY negY smulY , (forall i :e m , A (x i) = B (x i)) -> A = B.
Definition vs_segment : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set := fun X add smul x y => {z :e X|exists t :e (Icc 0 1) , z = add (smul (1 + - t) x) (smul t y)}.
End form68.
Section form69.
Definition is_norm : set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> (set -> set) -> prop := fun X add zero neg smul norm => is_real_vector_space X add zero neg smul /\ (forall x :e X , norm x :e R) /\ (forall x :e X , 0 <= norm x) /\ (forall x :e X , (norm x = 0 <-> x = zero)) /\ (forall c :e R , forall x :e X , norm (smul c x) = (abs_SNo c) * (norm x)) /\ (forall x :e X , forall y :e X , norm (add x y) <= (norm x) + (norm y)).
Axiom is_norm_norm_R_closed : forall X , forall add : set -> set -> set , forall zero : set , forall neg : set -> set , forall smul : set -> set -> set , forall norm : set -> set , is_norm X add zero neg smul norm -> forall x :e X , norm x :e R.
Definition is_normed_vector_space : set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> (set -> set) -> prop := fun X add zero neg smul norm => is_norm X add zero neg smul norm.
Definition norm_dist : set -> (set -> set -> set) -> (set -> set) -> (set -> set) -> set -> set -> set := fun X add neg norm x y => norm (add x (neg y)).
Definition Rn_dot : set -> set -> set -> set := fun n x y => vs_finsum (fun r s => r + s) 0 (fun i => (x i) * (y i)) n.
Axiom Rn_ap_R_closed : forall n :e omega , forall x :e Rn n , forall i :e n , x i :e R.
Axiom Rn_dot_add_left : forall n :e omega , forall x :e Rn n , forall y :e Rn n , forall z :e Rn n , Rn_dot n (Rn_add n x y) z = (Rn_dot n x z) + (Rn_dot n y z).
Axiom Rn_dot_add_right : forall n :e omega , forall x :e Rn n , forall y :e Rn n , forall z :e Rn n , Rn_dot n x (Rn_add n y z) = (Rn_dot n x y) + (Rn_dot n x z).
Axiom Rn_dot_smul_left : forall n :e omega , forall a :e R , forall x :e Rn n , forall y :e Rn n , Rn_dot n (Rn_smul n a x) y = a * (Rn_dot n x y).
Axiom Rn_dot_smul_right : forall n :e omega , forall a :e R , forall x :e Rn n , forall y :e Rn n , Rn_dot n x (Rn_smul n a y) = a * (Rn_dot n x y).
Axiom Rn_dot_sym : forall n :e omega , forall x :e Rn n , forall y :e Rn n , Rn_dot n x y = Rn_dot n y x.
Axiom Rn_dot_R_closed : forall n :e omega , forall x :e Rn n , forall y :e Rn n , Rn_dot n x y :e R.
Axiom Rn_dot_neg_right : forall n :e omega , forall x :e Rn n , forall y :e Rn n , Rn_dot n x (Rn_neg n y) = - (Rn_dot n x y).
Axiom Rn_dot_self_nonneg : forall n :e omega , forall x :e Rn n , 0 <= Rn_dot n x x.
Axiom vs_finsum_R_const_zero : forall m :e omega , vs_finsum (fun r s => r + s) 0 (fun i : set => 0) m = 0.
Axiom Rn_dot_zero_self : forall n :e omega , Rn_dot n (Rn_zero n) (Rn_zero n) = 0.
Axiom Rn_dot_zero_right : forall n :e omega , forall x :e Rn n , Rn_dot n x (Rn_zero n) = 0.
Axiom Rn_dot_self_eq0 : forall n :e omega , forall x :e Rn n , Rn_dot n x x = 0 -> x = Rn_zero n.
Definition Rn_norm : set -> set -> set := fun n x => sqrt_SNo_nonneg (Rn_dot n x x).
Axiom Rn_norm_zero : forall n :e omega , Rn_norm n (Rn_zero n) = 0.
Axiom Rn_norm_R_closed : forall n :e omega , forall x :e Rn n , Rn_norm n x :e R.
Axiom Rn_norm_nonneg : forall n :e omega , forall x :e Rn n , 0 <= Rn_norm n x.
Axiom Rn_norm_sqr : forall n :e omega , forall x :e Rn n , (Rn_norm n x) * (Rn_norm n x) = Rn_dot n x x.
Axiom Rn_dot_add_self : forall n :e omega , forall x :e Rn n , forall y :e Rn n , Rn_dot n (Rn_add n x y) (Rn_add n x y) = ((Rn_dot n x x) + (Rn_dot n x y)) + ((Rn_dot n y x) + (Rn_dot n y y)).
Axiom abs_R_sqr : forall r :e R , (abs_SNo r) * (abs_SNo r) = r * r.
Axiom sqrt_R_sqr_eq_abs : forall r :e R , sqrt_SNo_nonneg (r * r) = abs_SNo r.
Axiom Rn_dot_Cauchy_Schwarz : forall n :e omega , forall x :e Rn n , forall y :e Rn n , abs_SNo (Rn_dot n x y) <= (Rn_norm n x) * (Rn_norm n y).
Axiom Rn_dot_unit_abs_le_norm : forall n :e omega , forall x :e Rn n , forall y :e Rn n , Rn_norm n y = 1 -> abs_SNo (Rn_dot n x y) <= Rn_norm n x.
Axiom Rn_norm_triangle : forall n :e omega , forall x :e Rn n , forall y :e Rn n , Rn_norm n (Rn_add n x y) <= (Rn_norm n x) + (Rn_norm n y).
Axiom Rn_norm_is_norm : forall n :e omega , is_norm (Rn n) (Rn_add n) (Rn_zero n) (Rn_neg n) (Rn_smul n) (Rn_norm n).
Axiom Rn_norm_eq0_imp_zero : forall n :e omega , forall x :e Rn n , Rn_norm n x = 0 -> x = Rn_zero n.
Axiom Rn_norm_nonzero_of_nonzero : forall n :e omega , forall x :e Rn n , x <> Rn_zero n -> Rn_norm n x <> 0.
Axiom proof_id_test : forall P : prop , P -> P.
Axiom orE_id_test : forall A : prop , A \/ A -> A.
Axiom proof_id_test_nontrivial : (0 < 1) -> (0 < 1).
Axiom lambda_prop_annot_test : forall x :e R , (0 < x) -> (0 < x).
Axiom orE_prop_annot_test : forall x :e R , (0 < x \/ 0 < x) -> (0 < x).
Axiom R_nonneg_neq0_imp_pos : forall x :e R , 0 <= x -> x <> 0 -> 0 < x.
Axiom Rn_norm_pos_of_nonzero : forall n :e omega , forall x :e Rn n , x <> Rn_zero n -> 0 < Rn_norm n x.
Definition sup_ext_on : (set -> set) -> set -> set := fun f D => sup_ext (fimage f D).
Definition operator_norm : set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> (set -> set) -> set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> (set -> set) -> set -> set := fun X addX zeroX negX smulX normX Y addY zeroY negY smulY normY A => sup_ext_on (fun x => normY (A x)) {x :e X|normX x = 1}.
Definition operator_norm_LXY : set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> (set -> set) -> set -> (set -> set -> set) -> set -> (set -> set) -> (set -> set -> set) -> (set -> set) -> set -> set := fun X addX zeroX negX smulX normX Y addY zeroY negY smulY normY A => operator_norm X addX zeroX negX smulX normX Y addY zeroY negY smulY normY A.
Axiom operator_norm_LXY_mem_ext_real : forall X , forall addX : set -> set -> set , forall zeroX : set , forall negX : set -> set , forall smulX : set -> set -> set , forall normX : set -> set , forall Y , forall addY : set -> set -> set , forall zeroY : set , forall negY : set -> set , forall smulY : set -> set -> set , forall normY : set -> set , is_norm X addX zeroX negX smulX normX -> is_norm Y addY zeroY negY smulY normY -> forall A :e LXY X addX zeroX negX smulX Y addY zeroY negY smulY , (operator_norm_LXY X addX zeroX negX smulX normX Y addY zeroY negY smulY normY A) :e ext_real.
Axiom operator_norm_LXY_SNo : forall X , forall addX : set -> set -> set , forall zeroX : set , forall negX : set -> set , forall smulX : set -> set -> set , forall normX : set -> set , forall Y , forall addY : set -> set -> set , forall zeroY : set , forall negY : set -> set , forall smulY : set -> set -> set , forall normY : set -> set , is_norm X addX zeroX negX smulX normX -> is_norm Y addY zeroY negY smulY normY -> forall A :e LXY X addX zeroX negX smulX Y addY zeroY negY smulY , SNo (operator_norm_LXY X addX zeroX negX smulX normX Y addY zeroY negY smulY normY A).
Axiom operator_norm_LXY_bound : forall X , forall addX : set -> set -> set , forall zeroX : set , forall negX : set -> set , forall smulX : set -> set -> set , forall normX : set -> set , forall Y , forall addY : set -> set -> set , forall zeroY : set , forall negY : set -> set , forall smulY : set -> set -> set , forall normY : set -> set , is_norm X addX zeroX negX smulX normX -> is_norm Y addY zeroY negY smulY normY -> forall A :e LXY X addX zeroX negX smulX Y addY zeroY negY smulY , forall x :e X , normY (A x) <= (operator_norm_LXY X addX zeroX negX smulX normX Y addY zeroY negY smulY normY A) * (normX x).
Axiom operator_norm_LXY_Lipschitz_Rn : forall n :e omega , forall m :e omega , forall A :e LXY (Rn n) (Rn_add n) (Rn_zero n) (Rn_neg n) (Rn_smul n) (Rn m) (Rn_add m) (Rn_zero m) (Rn_neg m) (Rn_smul m) , forall x :e (Rn n) , forall y :e (Rn n) , norm_dist (Rn m) (Rn_add m) (Rn_neg m) (Rn_norm m) (A x) (A y) <= (operator_norm_LXY (Rn n) (Rn_add n) (Rn_zero n) (Rn_neg n) (Rn_smul n) (Rn_norm n) (Rn m) (Rn_add m) (Rn_zero m) (Rn_neg m) (Rn_smul m) (Rn_norm m) A) * (norm_dist (Rn n) (Rn_add n) (Rn_neg n) (Rn_norm n) x y).
Definition Rn_std_basis : set -> set -> set := fun n j => (fun i :e n => if i = j then 1 else 0).
Axiom Rn_std_basis_mem : forall n :e omega , forall j :e n , Rn_std_basis n j :e Rn n.
Axiom Rn_std_basis_ap : forall n :e omega , forall j :e n , forall i :e n , (Rn_std_basis n j) i = if i = j then 1 else 0.
Axiom Rn_vs_finsum_mem : forall n :e omega , forall m :e omega , forall t : set -> set , (forall k :e m , t k :e Rn n) -> vs_finsum (Rn_add n) (Rn_zero n) t m :e Rn n.
Axiom Rn_vs_finsum_ap : forall n :e omega , forall m :e omega , forall t : set -> set , forall i :e n , (vs_finsum (Rn_add n) (Rn_zero n) t m) i = vs_finsum (fun r s => r + s) 0 (fun k => (t k) i) m.
Axiom Rn_dot_std_basis_right : forall n :e omega , forall x :e Rn n , forall j :e n , Rn_dot n x (Rn_std_basis n j) = x j.
Axiom Rn_dot_std_basis_left : forall n :e omega , forall x :e Rn n , forall j :e n , Rn_dot n (Rn_std_basis n j) x = x j.
Axiom Rn_dot_std_basis_self : forall n :e omega , forall j :e n , Rn_dot n (Rn_std_basis n j) (Rn_std_basis n j) = 1.
Axiom Rn_norm_std_basis : forall n :e omega , forall j :e n , Rn_norm n (Rn_std_basis n j) = 1.
