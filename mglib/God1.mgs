Section form74.
Definition sv_C1_on : set -> set -> (set -> set) -> set -> prop := fun n m f U => sv_differentiable_on n m f U.
Definition sv_jacobian_entry : set -> set -> (set -> set) -> set -> set -> set -> set -> set := fun n m f U x i j => Rn_matrix_entry n m (sv_derivative_at n m f U x) i j.
Definition sv_C1_on_strict : set -> set -> (set -> set) -> set -> prop := fun n m f U => sv_differentiable_on n m f U /\ (forall i :e m , forall j :e n , ms_continuous_on (fun x : set => sv_jacobian_entry n m f U x i j) (Rn n) (Rn_dist n) R dist_R U).
Axiom sv_C1_on_strict_imp_sv_C1_on : forall n :e omega , forall m :e omega , forall f : set -> set , forall U , sv_C1_on_strict n m f U -> sv_C1_on n m f U.
Axiom sv_C1_on_strict_open : forall n :e omega , forall m :e omega , forall f : set -> set , forall U , sv_C1_on_strict n m f U -> ms_open (Rn n) (Rn_dist n) U.
Axiom sv_C1_on_strict_differentiable_at : forall n :e omega , forall m :e omega , forall f : set -> set , forall U , sv_C1_on_strict n m f U -> forall x :e U , sv_differentiable_at n m f U x.
Axiom inverse_function_theorem_Rn : forall n :e omega , forall f : set -> set , forall U , forall p :e U , sv_C1_on n n f U -> is_linear_invertible (Rn n) (Rn_add n) (Rn_zero n) (Rn_neg n) (Rn_smul n) (Rn n) (Rn_add n) (Rn_zero n) (Rn_neg n) (Rn_smul n) (sv_derivative_at n n f U p) -> exists V , exists W , ms_open (Rn n) (Rn_dist n) V /\ p :e V /\ V c= U /\ {f x|x :e V} = W.
Axiom inverse_function_theorem_Rn_scaffold_of_C1_strict : forall n :e omega , forall f : set -> set , forall U , forall p :e U , sv_C1_on_strict n n f U -> is_linear_invertible (Rn n) (Rn_add n) (Rn_zero n) (Rn_neg n) (Rn_smul n) (Rn n) (Rn_add n) (Rn_zero n) (Rn_neg n) (Rn_smul n) (sv_derivative_at n n f U p) -> exists V , exists W , ms_open (Rn n) (Rn_dist n) V /\ p :e V /\ V c= U /\ {f x|x :e V} = W.
End form74.
Section form75.
Definition sv_Ck_on : set -> set -> set -> (set -> set) -> set -> prop := fun k n m f U => sv_C1_on n m f U.
End form75.
Section form76.
Definition rect_Icc_R2 : set -> set -> set -> set -> set := fun a b c d => {p :e (Rn 2)|(p 0) :e (Icc a b) /\ (p 1) :e (Icc c d)}.
Definition R2_pair : set -> set -> set := fun x y => (fun i :e 2 => if i = 0 then x else y).
Axiom R2_pair_mem_Rn2 : forall x :e R , forall y :e R , R2_pair x y :e (Rn 2).
Axiom R2_pair_ap0 : forall x :e R , forall y :e R , (R2_pair x y) 0 = x.
Axiom R2_pair_ap1 : forall x :e R , forall y :e R , (R2_pair x y) 1 = y.
Axiom R2_pair_mem_rect_Icc_R2 : forall a b c d :e R , forall x :e (Icc a b) , forall y :e (Icc c d) , R2_pair x y :e (rect_Icc_R2 a b c d).
Axiom rect_Icc_R2_nonempty : forall a b c d :e R , a <= b -> c <= d -> nonempty (rect_Icc_R2 a b c d).
Axiom rect_Icc_R2_subq_Rn2 : forall a b c d :e R , rect_Icc_R2 a b c d c= (Rn 2).
Axiom Rn2_eta_R2_pair : forall p :e (Rn 2) , p = R2_pair (p 0) (p 1).
Axiom Rn_dist_R2_pair_fixed_second : forall x :e R , forall x' :e R , forall y :e R , Rn_dist 2 (R2_pair x y) (R2_pair x' y) = dist_R x x'.
Axiom Rn_dist_R2_pair_fixed_first : forall x :e R , forall y :e R , forall y' :e R , Rn_dist 2 (R2_pair x y) (R2_pair x y') = dist_R y y'.
Axiom partial_sum_seq_2_R : forall t : set -> set , t 0 :e R -> t 1 :e R -> partial_sum_seq t 2 = (t 0) + (t 1).
Axiom Rn_dist_R2_pair_le_dist_sum : forall x :e R , forall x' :e R , forall y :e R , forall y' :e R , Rn_dist 2 (R2_pair x y) (R2_pair x' y') <= dist_R x x' + dist_R y y'.
Axiom ms_seq_limit_R_iff_seq_limit : forall x : set -> set , forall l , ms_seq_limit R dist_R x l <-> seq_limit x l.
Axiom subseq_fun_lt_of_mem : forall f : set -> set , subseq_fun f -> forall n :e omega , forall m :e n , f m < f n.
Axiom subseq_fun_comp : forall f g : set -> set , subseq_fun f -> subseq_fun g -> subseq_fun (fun n : set => f (g n)).
Axiom subseq_of_trans : forall x y z : set -> set , subseq_of x y -> subseq_of y z -> subseq_of x z.
Axiom ms_seq_limit_R2_pair_of_seq_limit : forall y :e R , forall a : set -> set , forall c :e R , seq_limit a c -> ms_seq_limit (Rn 2) (Rn_dist 2) (fun n : set => R2_pair (a n) y) (R2_pair c y).
Axiom ms_seq_limit_R2_pair_fixed_first_of_seq_limit : forall x :e R , forall a : set -> set , forall c :e R , seq_limit a c -> ms_seq_limit (Rn 2) (Rn_dist 2) (fun n : set => R2_pair x (a n)) (R2_pair x c).
Axiom subseq_fun_ge_of_ge : forall f : set -> set , subseq_fun f -> forall N :e omega , forall n :e omega , N <= n -> N <= f n.
Axiom ms_seq_limit_subseq : forall X , forall d : set -> set -> set , forall x : set -> set , forall l , forall y : set -> set , ms_seq_limit X d x l -> subseq_of x y -> ms_seq_limit X d y l.
Axiom subseq_fun_maps_to_omega : forall f : set -> set , subseq_fun f -> forall n :e omega , f n :e omega.
Axiom subseq_fun_ge_self : forall f : set -> set , subseq_fun f -> forall n :e omega , n <= f n.
Axiom subseq_fun_step_lt : forall f : set -> set , subseq_fun f -> forall n :e omega , f n < f (ordsucc n).
Axiom ms_seq_limit_all : forall X , forall d : set -> set -> set , forall x : set -> set , forall l , ms_seq_limit X d x l -> forall n :e omega , x n :e X.
Axiom ms_seq_limit_lim_mem : forall X , forall d : set -> set -> set , forall x : set -> set , forall l , ms_seq_limit X d x l -> l :e X.
Axiom ms_seq_limit_eps : forall X , forall d : set -> set -> set , forall x : set -> set , forall l , ms_seq_limit X d x l -> forall eps :e R , 0 < eps -> exists N :e omega , forall n :e omega , N <= n -> d (x n) l < eps.
Axiom ms_seq_limit_of_pointwise_eq : forall X , forall d : set -> set -> set , forall x y : set -> set , forall l , ms_seq_limit X d x l -> (forall n :e omega , y n = x n) -> ms_seq_limit X d y l.
