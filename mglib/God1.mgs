End form70.
Section form71.
Definition sv_derivative_at : set -> set -> (set -> set) -> set -> set -> set := fun n m f U x => Eps_i (fun A : set => sv_deriv_at n m f U x A).
Axiom sv_derivative_at_spec : forall n :e omega , forall m :e omega , forall f : set -> set , forall U , forall x :e U , sv_differentiable_at n m f U x -> sv_deriv_at n m f U x (sv_derivative_at n m f U x).
End form71.
Section form72.
Definition sv_derivative : set -> set -> (set -> set) -> set -> set := fun n m f U => (fun x :e U => sv_derivative_at n m f U x).
Axiom sv_derivative_ap : forall n :e omega , forall m :e omega , forall f : set -> set , forall U , forall x :e U , (sv_derivative n m f U) x = sv_derivative_at n m f U x.
Definition sv_differentiable_on : set -> set -> (set -> set) -> set -> prop := fun n m f U => ms_open (Rn n) (Rn_dist n) U /\ (forall x :e U , sv_differentiable_at n m f U x).
End form72.
Section form73.
Axiom continuous_at_add : forall f g : set -> set , forall S c , continuous_at f S c -> continuous_at g S c -> continuous_at (fun x => (f x) + (g x)) S c.
Axiom continuous_on_add : forall f g : set -> set , forall S , continuous_on f S -> continuous_on g S -> continuous_on (fun x => (f x) + (g x)) S.
Axiom continuous_on_mul : forall f g : set -> set , forall S , continuous_on f S -> continuous_on g S -> continuous_on (fun x => (f x) * (g x)) S.
Axiom continuous_on_minus : forall f : set -> set , forall S , continuous_on f S -> continuous_on (fun x => - (f x)) S.
Axiom continuous_on_sub : forall f g : set -> set , forall S , continuous_on f S -> continuous_on g S -> continuous_on (fun x => (f x) + (- (g x))) S.
Axiom continuous_at_sub : forall f g : set -> set , forall S c , continuous_at f S c -> continuous_at g S c -> continuous_at (fun x => (f x) + (- (g x))) S c.
Axiom continuous_on_vs_finsum_R : forall m :e omega , forall term : set -> set -> set , forall S , S c= R -> (forall i :e m , continuous_on (fun x : set => term i x) S) -> continuous_on (fun x : set => vs_finsum (fun r s => r + s) 0 (fun i : set => term i x) m) S.
Axiom deriv_at_of_pointwise_eq : forall f g : set -> set , forall I c L , (forall x :e I , g x = f x) -> deriv_at f I c L -> deriv_at g I c L.
Axiom deriv_at_vs_finsum_R : forall m :e omega , forall term : set -> set -> set , forall dterm : set -> set , forall I c , I c= R -> c :e I -> cluster_point I c -> (forall i :e m , dterm i :e R /\ deriv_at (fun x : set => term i x) I c (dterm i)) -> deriv_at (fun x : set => vs_finsum (fun r s => r + s) 0 (fun i : set => term i x) m) I c (vs_finsum (fun r s => r + s) 0 dterm m).
Definition Rn_lipschitz_on : set -> set -> (set -> set) -> set -> set -> prop := fun n m f U K => n :e omega /\ m :e omega /\ ms_open (Rn n) (Rn_dist n) U /\ (forall x :e U , f x :e (Rn m)) /\ K :e R /\ 0 <= K /\ forall x :e U , forall y :e U , Rn_dist m (f x) (f y) <= K * (Rn_dist n x y).
Axiom sv_differentiable_on_imp_maps_to_Rn : forall n :e omega , forall m :e omega , forall f : set -> set , forall U , sv_differentiable_on n m f U -> forall z :e U , f z :e (Rn m).
Axiom deriv_at_Icc_imp_Ioo : forall f : set -> set , forall a b :e R , a < b -> forall c :e (Ioo a b) , forall L :e R , deriv_at f (Icc a b) c L -> deriv_at f (Ioo a b) c L.
Axiom Rn_affine_comb_eq_add_smul_sub : forall n :e omega , forall x :e (Rn n) , forall y :e (Rn n) , forall t :e R , Rn_add n (Rn_smul n (1 + (- t)) x) (Rn_smul n t y) = Rn_add n x (Rn_smul n t (Rn_add n y (Rn_neg n x))).
Axiom Rn_affine_comb_0 : forall n :e omega , forall x :e (Rn n) , forall y :e (Rn n) , Rn_add n (Rn_smul n (1 + (- 0)) x) (Rn_smul n 0 y) = x.
Axiom Rn_affine_comb_1 : forall n :e omega , forall x :e (Rn n) , forall y :e (Rn n) , Rn_add n (Rn_smul n (1 + (- 1)) x) (Rn_smul n 1 y) = y.
Axiom Rn_smul_neg_scalar : forall n :e omega , forall t :e R , forall v :e (Rn n) , Rn_smul n (- t) v = Rn_neg n (Rn_smul n t v).
Axiom Rn_affine_comb_diff_eq_smul_sub : forall n :e omega , forall x :e (Rn n) , forall y :e (Rn n) , forall s :e R , forall t :e R , Rn_add n (Rn_add n (Rn_smul n (1 + (- s)) x) (Rn_smul n s y)) (Rn_neg n (Rn_add n (Rn_smul n (1 + (- t)) x) (Rn_smul n t y))) = Rn_smul n (s + (- t)) (Rn_add n y (Rn_neg n x)).
Axiom Rn_affine_comb_add_smul_sub : forall n :e omega , forall x :e (Rn n) , forall y :e (Rn n) , forall s :e R , forall t :e R , Rn_add n (Rn_add n (Rn_smul n (1 + (- s)) x) (Rn_smul n s y)) (Rn_zero n) = Rn_add n (Rn_add n (Rn_smul n (1 + (- t)) x) (Rn_smul n t y)) (Rn_smul n (s + (- t)) (Rn_add n y (Rn_neg n x))).
Axiom Rn_dist_affine_comb : forall n :e omega , forall x :e (Rn n) , forall y :e (Rn n) , forall s :e R , forall t :e R , Rn_dist n (Rn_add n (Rn_smul n (1 + (- s)) x) (Rn_smul n s y)) (Rn_add n (Rn_smul n (1 + (- t)) x) (Rn_smul n t y)) = (abs_SNo (s + (- t))) * (Rn_norm n (Rn_add n y (Rn_neg n x))).
