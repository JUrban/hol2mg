Axiom god1_adjacent_map_values_in : forall n i , forall t : set -> set , i :e n -> ordsucc i :e n -> t i = ordsucc i -> t (ordsucc i) = i -> (forall k :e n , k <> i -> k <> ordsucc i -> t k = k) -> forall k :e n , t k :e n.
Axiom god1_adjacent_predecessor_in_prefix : forall n i , i :e ordsucc n -> ordsucc i :e n -> i :e n.
