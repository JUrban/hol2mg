Axiom fubini_Icc_R2_self_y : forall a1 b1 a2 :e R , a1 <= b1 -> forall f : set -> set , iterated_integral_xy_Icc a1 b1 a2 a2 f = iterated_integral_yx_Icc a1 b1 a2 a2 f.
Axiom rect_darboux_sum_uniform_bounds_iterated_integrals_Icc_R2 : forall a1 b1 a2 b2 :e R , a1 < b1 -> a2 < b2 -> forall f : set -> set , ms_continuous_on f (Rn 2) (Rn_dist 2) R dist_R (rect_Icc_R2 a1 b1 a2 b2) -> forall nx ny :e omega , (nat_p nx /\ nx <> 0) -> (nat_p ny /\ ny <> 0) -> rect_darboux_sum_lower_seq_R2 f nx (uniform_partition_seq_fun a1 b1 nx) ny (uniform_partition_seq_fun a2 b2 ny) <= iterated_integral_xy_Icc a1 b1 a2 b2 f /\ iterated_integral_xy_Icc a1 b1 a2 b2 f <= rect_darboux_sum_upper_seq_R2 f nx (uniform_partition_seq_fun a1 b1 nx) ny (uniform_partition_seq_fun a2 b2 ny) /\ (rect_darboux_sum_lower_seq_R2 f nx (uniform_partition_seq_fun a1 b1 nx) ny (uniform_partition_seq_fun a2 b2 ny) <= iterated_integral_yx_Icc a1 b1 a2 b2 f /\ iterated_integral_yx_Icc a1 b1 a2 b2 f <= rect_darboux_sum_upper_seq_R2 f nx (uniform_partition_seq_fun a1 b1 nx) ny (uniform_partition_seq_fun a2 b2 ny)).
