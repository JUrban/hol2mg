Axiom complex_imag_combo_pair_product_eq_pair_of_scalar_pair : forall b :e real , mul_CSNo (SNo_pair 0 (- (1 :/: 2))) (SNo_pair 0 (b + b)) = SNo_pair b 0.
Axiom contains_complex_constants_imp_vanishes_at_no_point : forall X , forall A , contains_complex_constants X A -> vanishes_at_no_point X A.
End form83.
Section form84.
Axiom Ioi0_nonempty : nonempty (Ioi 0).
Axiom setprod_elim_0_1 : forall X , forall Y , forall p :e setprod X Y , p 0 :e X /\ p 1 :e Y.
Definition Rn_ball_subspace : set -> set -> set -> set -> set := fun n D x delta => (ms_ball (Rn n) (Rn_dist n) x delta) :/\: D.
Axiom Rn_ball_subspace_nonempty : forall n :e omega , forall D , forall x :e D , D c= (Rn n) -> forall delta :e R , 0 < delta -> nonempty (Rn_ball_subspace n D x delta).
Axiom Rn_osc_integrand_bounded : forall n :e omega , forall D , forall f : set -> set , forall x :e D , bounded_fun D f -> forall delta :e R , 0 < delta -> bounded_fun (setprod (Rn_ball_subspace n D x delta) (Rn_ball_subspace n D x delta)) (fun p => (f (p 0)) + (- (f (p 1)))).
Axiom R_add_minus_closed_sanity : forall x :e R , forall y :e R , x + (- y) :e R.
Axiom Rn_ball_subspace_center_mem : forall n :e omega , forall D , forall x :e D , D c= (Rn n) -> forall delta :e R , 0 < delta -> x :e Rn_ball_subspace n D x delta.
Axiom Rn_ball_subspace_mem_of_dist : forall n :e omega , forall D , forall x :e D , D c= (Rn n) -> forall delta :e R , 0 < delta -> forall y :e D , Rn_dist n y x < delta -> y :e Rn_ball_subspace n D x delta.
Definition Rn_oscillation_delta : set -> set -> (set -> set) -> set -> set -> set := fun n D f x delta => sup_on (fun p => (f (p 0)) + (- (f (p 1)))) (setprod (Rn_ball_subspace n D x delta) (Rn_ball_subspace n D x delta)).
Axiom Rn_oscillation_delta_R_closed : forall n :e omega , forall D , forall f : set -> set , forall x :e D , D c= (Rn n) -> bounded_fun D f -> forall delta :e R , 0 < delta -> Rn_oscillation_delta n D f x delta :e R.
Axiom Rn_oscillation_delta_nonneg : forall n :e omega , forall D , forall f : set -> set , forall x :e D , D c= (Rn n) -> bounded_fun D f -> forall delta :e R , 0 < delta -> 0 <= Rn_oscillation_delta n D f x delta.
Axiom bounded_fun_Rn_oscillation_delta_Ioi0 : forall n :e omega , forall D , forall f : set -> set , forall x :e D , D c= (Rn n) -> bounded_fun D f -> bounded_fun (Ioi 0) (fun delta => Rn_oscillation_delta n D f x delta).
Definition Rn_oscillation : set -> set -> (set -> set) -> set -> set := fun n D f x => inf_on (fun delta => Rn_oscillation_delta n D f x delta) (Ioi 0).
Definition Rn_discontinuities : set -> set -> (set -> set) -> set := fun n D f => {x :e D|0 < Rn_oscillation n D f x}.
Definition Rn_discontinuities_eps : set -> set -> (set -> set) -> set -> set := fun n D f eps => {x :e D|eps <= Rn_oscillation n D f x}.
Axiom Rn_continuous_at_imp_oscillation_zero : forall n :e omega , forall D , forall f : set -> set , forall x :e D , D c= (Rn n) -> bounded_fun D f -> ms_continuous_at f D (Rn_dist n) R dist_R x -> Rn_oscillation n D f x = 0.
Axiom Rn_oscillation_zero_imp_continuous_at : forall n :e omega , forall D , forall f : set -> set , forall x :e D , D c= (Rn n) -> bounded_fun D f -> Rn_oscillation n D f x = 0 -> ms_continuous_at f D (Rn_dist n) R dist_R x.
Axiom Rn_continuous_at_iff_oscillation_zero : forall n :e omega , forall D , forall f : set -> set , forall x :e D , D c= (Rn n) -> bounded_fun D f -> (ms_continuous_at f D (Rn_dist n) R dist_R x <-> Rn_oscillation n D f x = 0).
Axiom sup_on_Le_of_domain_subq : forall D , forall E , forall f : set -> set , D c= E -> nonempty D -> bounded_fun E f -> sup_on f D <= sup_on f E.
Axiom Rn_ball_subspace_subq_of_dist : forall n :e omega , forall D , forall x :e D , forall y :e D , D c= (Rn n) -> forall delta :e R , 0 < delta -> Rn_dist n x y < delta -> (Rn_ball_subspace n D y delta) c= (Rn_ball_subspace n D x (delta + delta)).
Axiom Rn_oscillation_ge_set_open_compl_notinD : forall n :e omega , forall D , forall f : set -> set , forall eps :e R , D c= (Rn n) -> ms_closed (Rn n) (Rn_dist n) D -> bounded_fun D f -> forall x :e (Rn n) , x /:e D -> exists delta :e R , 0 < delta /\ forall y :e (Rn n) , Rn_dist n x y < delta -> y :e ((Rn n) :\: (Rn_discontinuities_eps n D f eps)).
Axiom Rn_oscillation_ge_set_open_compl_inD_contra : forall n :e omega , forall D , forall f : set -> set , forall eps :e R , D c= (Rn n) -> bounded_fun D f -> forall x :e D , forall t0 :e R , 0 < t0 -> Rn_oscillation_delta n D f x t0 < eps -> forall y :e (Rn n) , Rn_dist n x y < (t0 :/: 2) -> y :e (Rn_discontinuities_eps n D f eps) -> False.
Axiom Rn_oscillation_ge_set_open_compl_inD : forall n :e omega , forall D , forall f : set -> set , forall eps :e R , D c= (Rn n) -> bounded_fun D f -> forall x :e D , x /:e (Rn_discontinuities_eps n D f eps) -> exists delta :e R , 0 < delta /\ forall y :e (Rn n) , Rn_dist n x y < delta -> y :e ((Rn n) :\: (Rn_discontinuities_eps n D f eps)).
Axiom Rn_oscillation_ge_set_closed : forall n :e omega , forall D , forall f : set -> set , forall eps :e R , D c= (Rn n) -> ms_closed (Rn n) (Rn_dist n) D -> bounded_fun D f -> ms_closed (Rn n) (Rn_dist n) (Rn_discontinuities_eps n D f eps).
End form84.
Section form85.
Definition ms_bounded : set -> (set -> set -> set) -> set -> prop := fun X d S => S c= X /\ exists x :e X , exists R :e R , forall y :e S , d x y <= R.
Definition ms_interior : set -> (set -> set -> set) -> set -> set := fun X d S => {x :e X|exists delta :e R , 0 < delta /\ forall y :e X , d x y < delta -> y :e S}.
Definition ms_closure : set -> (set -> set -> set) -> set -> set := fun X d S => {x :e X|forall delta :e R , 0 < delta -> exists y :e S , d x y < delta}.
Definition ms_boundary : set -> (set -> set -> set) -> set -> set := fun X d S => (ms_closure X d S) :\: (ms_interior X d S).
Definition indicator_fun : set -> set -> set -> set := fun X S x => if x :e S then 1 else 0.
Definition indicator_set : set -> set -> set := fun X S => (fun x :e X => if x :e S then 1 else 0).
Definition jordan_measurable_Rn : set -> set -> prop := fun n S => ms_bounded (Rn n) (Rn_dist n) S /\ is_null_set_Rn n (ms_boundary (Rn n) (Rn_dist n) S).
Axiom ms_bounded_subq : forall X , forall d : set -> set -> set , forall S , ms_bounded X d S -> S c= X.
Axiom ms_interior_subq : forall X , forall d : set -> set -> set , forall S , ms_interior X d S c= X.
Axiom ms_closure_subq : forall X , forall d : set -> set -> set , forall S , ms_closure X d S c= X.
Axiom ms_boundary_subq : forall X , forall d : set -> set -> set , forall S , ms_boundary X d S c= X.
Axiom indicator_set_in_setexp : forall X , forall S , indicator_set X S :e setexp R X.
Axiom jordan_measurable_Rn_subq_Rn : forall n , forall S , jordan_measurable_Rn n S -> S c= (Rn n).
Axiom jordan_measurable_Rn_bounded : forall n , forall S , jordan_measurable_Rn n S -> ms_bounded (Rn n) (Rn_dist n) S.
Axiom jordan_measurable_Rn_boundary_null : forall n , forall S , jordan_measurable_Rn n S -> is_null_set_Rn n (ms_boundary (Rn n) (Rn_dist n) S).
Axiom ms_interior_subq_set : forall X , forall d : set -> set -> set , forall S , is_metric X d -> S c= X -> ms_interior X d S c= S.
Axiom Subq_ms_closure : forall X , forall d : set -> set -> set , forall S , is_metric X d -> S c= X -> S c= ms_closure X d S.
Axiom indicator_set_eval_in : forall X , forall S , forall x :e X , x :e S -> indicator_set X S x = 1.
Axiom indicator_set_eval_out : forall X , forall S , forall x :e X , x /:e S -> indicator_set X S x = 0.
Axiom ms_boundary_subq_closure : forall X , forall d : set -> set -> set , forall S , ms_boundary X d S c= ms_closure X d S.
Axiom indicator_set_eval_outside : forall X , forall S , forall x , x /:e X -> indicator_set X S x = 0.
Axiom jordan_measurable_Rn_boundary_subq_Rn : forall n , forall S , jordan_measurable_Rn n S -> ms_boundary (Rn n) (Rn_dist n) S c= (Rn n).
Axiom ms_interior_monotone : forall X , forall d : set -> set -> set , forall S , forall T , S c= T -> ms_interior X d S c= ms_interior X d T.
Axiom ms_closure_monotone : forall X , forall d : set -> set -> set , forall S , forall T , S c= T -> ms_closure X d S c= ms_closure X d T.
Axiom ms_open_subq_ms_interior : forall X , forall d : set -> set -> set , forall V , ms_open X d V -> V c= ms_interior X d V.
Axiom ms_open_ms_interior : forall X , forall d : set -> set -> set , forall S , is_metric X d -> ms_open X d (ms_interior X d S).
Axiom ms_interior_idem : forall X , forall d : set -> set -> set , forall S , is_metric X d -> ms_interior X d (ms_interior X d S) = ms_interior X d S.
Axiom ms_interior_subq_closure : forall X , forall d : set -> set -> set , forall S , is_metric X d -> S c= X -> ms_interior X d S c= ms_closure X d S.
Axiom ms_closure_idem : forall X , forall d : set -> set -> set , forall S , is_metric X d -> S c= X -> ms_closure X d (ms_closure X d S) = ms_closure X d S.
Axiom ms_boundary_closure_subq_boundary : forall X , forall d : set -> set -> set , forall S , is_metric X d -> S c= X -> ms_boundary X d (ms_closure X d S) c= ms_boundary X d S.
Axiom ms_boundary_interior_subq_boundary : forall X , forall d : set -> set -> set , forall S , is_metric X d -> S c= X -> ms_boundary X d (ms_interior X d S) c= ms_boundary X d S.
Axiom ms_bounded_subq_set : forall X , forall d : set -> set -> set , forall S , forall T , T c= S -> ms_bounded X d S -> ms_bounded X d T.
Axiom ms_closure_bounded : forall X , forall d : set -> set -> set , forall S , is_metric X d -> ms_bounded X d S -> ms_bounded X d (ms_closure X d S).
Axiom jordan_measurable_Rn_interior : forall n , forall S , jordan_measurable_Rn n S -> jordan_measurable_Rn n (ms_interior (Rn n) (Rn_dist n) S).
Axiom jordan_measurable_Rn_closure : forall n , forall S , jordan_measurable_Rn n S -> jordan_measurable_Rn n (ms_closure (Rn n) (Rn_dist n) S).
Axiom ms_closure_subq_of_closed : forall X , forall d : set -> set -> set , forall S , forall E , is_metric X d -> S c= E -> ms_closed X d E -> ms_closure X d S c= E.
Definition ms_closure_gap_witness : set -> (set -> set -> set) -> set -> set -> set := fun X d S x => Eps_i (fun delta => ~ (delta :e R -> 0 < delta -> exists y :e S , d x y < delta)).
Axiom ms_closure_gap_witness_spec : forall X , forall d : set -> set -> set , forall S , forall x , ~ (forall delta :e R , 0 < delta -> exists y :e S , d x y < delta) -> (ms_closure_gap_witness X d S x) :e R /\ (0 < (ms_closure_gap_witness X d S x) /\ ~ (exists y :e S , d x y < (ms_closure_gap_witness X d S x))).
Axiom ms_closure_gap_halfball_subq_complement : forall X , forall d : set -> set -> set , forall S , forall x , is_metric X d -> S c= X -> x :e X -> ~ (forall delta :e R , 0 < delta -> exists y :e S , d x y < delta) -> forall z :e X , d x z < ((ms_closure_gap_witness X d S x) :/: 2) -> z :e X :\: ms_closure X d S.
Axiom ms_closed_ms_closure : forall X , forall d : set -> set -> set , forall S , is_metric X d -> S c= X -> ms_closed X d (ms_closure X d S).
Axiom ms_open_subq_ms_interior_of_subq : forall X , forall d : set -> set -> set , forall V , forall A , ms_open X d V -> V c= A -> V c= ms_interior X d A.
Axiom ms_closure_binintersect_subq : forall X , forall d : set -> set -> set , forall S , forall T , ms_closure X d (S :/\: T) c= (ms_closure X d S) :/\: (ms_closure X d T).
Axiom ms_interior_binintersect_eq : forall X , forall d : set -> set -> set , forall S , forall T , is_metric X d -> S c= X -> T c= X -> ms_interior X d (S :/\: T) = (ms_interior X d S) :/\: (ms_interior X d T).
Axiom ms_boundary_binintersect_subq_binunion : forall X , forall d : set -> set -> set , forall S , forall T , is_metric X d -> S c= X -> T c= X -> ms_boundary X d (S :/\: T) c= (ms_boundary X d S) :\/: (ms_boundary X d T).
End form85.
