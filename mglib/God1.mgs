Definition god1_induced_enumeration_permutation : set -> set -> (set -> set) -> set := fun X Y phi => fun i :e finite_cardinality X => inv (finite_cardinality X) (fun j => finite_enumeration Y j) (phi (finite_enumeration X i)).
Axiom god1_induced_enumeration_permutation_specification : forall X Y , finite X -> finite Y -> forall phi : set -> set , bij X Y phi -> god1_induced_enumeration_permutation X Y phi :e permutation_group (finite_cardinality X) /\ forall i :e finite_cardinality X , finite_enumeration Y (god1_induced_enumeration_permutation X Y phi i) = phi (finite_enumeration X i).
Axiom god1_ring_finite_product_bijection_invariant : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall X Y , finite X -> finite Y -> forall phi : set -> set , bij X Y phi -> forall f : set -> set , (forall y :e Y , f y :e K) -> ring_finite_product K add mul Y f = ring_finite_product K add mul X (fun x => f (phi x)).
Axiom god1_group_word_append_bijection : forall n , nat_p n -> forall X , forall f : set -> set , bij n X f -> forall a , a /:e X -> bij (ordsucc n) (X :\/: {a}) (group_word_append n f a).
Axiom god1_ring_finite_product_natural : forall K , forall add mul : set -> set -> set , forall n :e omega , forall f : set -> set , ring_finite_product K add mul n f = god1_ring_word_product K add mul f n.
Axiom god1_ring_finite_product_natural_successor : forall K , forall add mul : set -> set -> set , forall n :e omega , forall f : set -> set , ring_finite_product K add mul (ordsucc n) f = mul (ring_finite_product K add mul n f) (f n).
Axiom god1_ring_finite_sum_enumerated : forall K , forall add : set -> set -> set , forall X , finite X -> forall f : set -> set , ring_finite_sum K add X f = ring_finite_sum K add (finite_cardinality X) (fun i => f (finite_enumeration X i)).
Axiom god1_ring_finite_product_enumerated : forall K , forall add mul : set -> set -> set , forall X , finite X -> forall f : set -> set , ring_finite_product K add mul X f = ring_finite_product K add mul (finite_cardinality X) (fun i => f (finite_enumeration X i)).
Axiom god1_ring_finite_product_congr_natural : forall K , forall add mul : set -> set -> set , forall n :e omega , forall f g : set -> set , (forall i :e n , f i = g i) -> ring_finite_product K add mul n f = ring_finite_product K add mul n g.
Axiom god1_ring_finite_product_empty : forall K , forall add mul : set -> set -> set , forall f : set -> set , ring_finite_product K add mul 0 f = ring_one K mul.
Axiom god1_ring_finite_sum_adjoin : forall K , forall add mul : set -> set -> set , ring K add mul -> forall X , finite X -> forall a , a /:e X -> forall f : set -> set , (forall z :e X :\/: {a} , f z :e K) -> ring_finite_sum K add (X :\/: {a}) f = add (ring_finite_sum K add X f) (f a).
Axiom god1_ring_finite_product_adjoin : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall X , finite X -> forall a , a /:e X -> forall f : set -> set , (forall z :e X :\/: {a} , f z :e K) -> ring_finite_product K add mul (X :\/: {a}) f = mul (ring_finite_product K add mul X f) (f a).
Axiom god1_power_finite : forall X , finite X -> finite (Power X).
Axiom god1_ring_finite_sum_in : forall K , forall add mul : set -> set -> set , ring K add mul -> forall X , finite X -> forall f : set -> set , (forall x :e X , f x :e K) -> ring_finite_sum K add X f :e K.
Axiom god1_ring_finite_sum_right_mul_finite : forall K , forall add mul : set -> set -> set , ring K add mul -> forall X , finite X -> forall f : set -> set , (forall x :e X , f x :e K) -> forall z :e K , mul (ring_finite_sum K add X f) z = ring_finite_sum K add X (fun x => mul (f x) z).
Axiom god1_binunion_associative : forall A B C , (A :\/: B) :\/: C = A :\/: (B :\/: C).
Definition god1_power_adjoin_avoiding : set -> set -> set := fun X a => {F :e Power (X :\/: {a})|a /:e F}.
Definition god1_power_adjoin_containing : set -> set -> set := fun X a => {F :e Power (X :\/: {a})|a :e F}.
Axiom god1_power_adjoin_avoiding_eq : forall X a , a /:e X -> god1_power_adjoin_avoiding X a = Power X.
Axiom god1_adjoin_injective_outside : forall X a , a /:e X -> forall A B , A c= X -> B c= X -> A :\/: {a} = B :\/: {a} -> A = B.
Axiom god1_subset_adjoin_remove_new : forall X a A , A c= X :\/: {a} -> A :\: {a} c= X.
Axiom god1_power_adjoin_containing_bijection : forall X a , a /:e X -> bij (Power X) (god1_power_adjoin_containing X a) (fun F => F :\/: {a}).
Axiom god1_power_adjoin_containing_finite : forall X a , finite X -> a /:e X -> finite (god1_power_adjoin_containing X a).
Axiom god1_power_adjoin_avoiding_finite : forall X a , finite X -> a /:e X -> finite (god1_power_adjoin_avoiding X a).
Axiom god1_power_adjoin_partition : forall X a , god1_power_adjoin_avoiding X a :\/: god1_power_adjoin_containing X a = Power (X :\/: {a}).
Axiom god1_power_adjoin_partition_disjoint : forall X a , forall F :e god1_power_adjoin_containing X a , F /:e god1_power_adjoin_avoiding X a.
Axiom god1_ring_finite_sum_disjoint_union_zero : forall K , forall add mul : set -> set -> set , ring K add mul -> forall C , finite C -> (forall z :e 0 , z /:e C) -> forall g : set -> set , (forall z :e C :\/: 0 , g z :e K) -> ring_finite_sum K add (C :\/: 0) g = add (ring_finite_sum K add C g) (ring_finite_sum K add 0 g).
Axiom god1_ring_finite_sum_disjoint_union_step : forall K , forall add mul : set -> set -> set , ring K add mul -> forall Y y , finite Y -> y /:e Y -> (forall C , finite C -> (forall z :e Y , z /:e C) -> forall g : set -> set , (forall z :e C :\/: Y , g z :e K) -> ring_finite_sum K add (C :\/: Y) g = add (ring_finite_sum K add C g) (ring_finite_sum K add Y g)) -> forall C , finite C -> (forall z :e Y :\/: {y} , z /:e C) -> forall g : set -> set , (forall z :e C :\/: (Y :\/: {y}) , g z :e K) -> ring_finite_sum K add (C :\/: (Y :\/: {y})) g = add (ring_finite_sum K add C g) (ring_finite_sum K add (Y :\/: {y}) g).
Axiom god1_ring_finite_sum_disjoint_union : forall K , forall add mul : set -> set -> set , ring K add mul -> forall A , finite A -> forall B , finite B -> (forall b :e B , b /:e A) -> forall f : set -> set , (forall z :e A :\/: B , f z :e K) -> ring_finite_sum K add (A :\/: B) f = add (ring_finite_sum K add A f) (ring_finite_sum K add B f).
Axiom god1_ring_finite_sum_congr_finite : forall K , forall add : set -> set -> set , forall X , finite X -> forall f g : set -> set , (forall x :e X , f x = g x) -> ring_finite_sum K add X f = ring_finite_sum K add X g.
Axiom god1_ring_finite_product_in : forall K , forall add mul : set -> set -> set , ring K add mul -> forall X , finite X -> forall f : set -> set , (forall x :e X , f x :e K) -> ring_finite_product K add mul X f :e K.
Axiom god1_adjoin_setminus_avoiding : forall X a F , a /:e X -> F c= X -> (X :\/: {a}) :\: F = (X :\: F) :\/: {a}.
Axiom god1_adjoin_setminus_containing : forall X a F , a /:e X -> F c= X -> (X :\/: {a}) :\: (F :\/: {a}) = X :\: F.
Definition god1_product_choice_term : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> (set -> set) -> set -> set := fun K add mul I x y F => mul (ring_finite_product K add mul F x) (ring_finite_product K add mul (I :\: F) y).
Axiom god1_product_choice_term_avoiding_adjoin : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall X , finite X -> forall a , a /:e X -> forall x y : set -> set , (forall z :e X :\/: {a} , x z :e K /\ y z :e K) -> forall F :e Power X , god1_product_choice_term K add mul (X :\/: {a}) x y F = mul (god1_product_choice_term K add mul X x y F) (y a).
Axiom god1_product_choice_term_containing_adjoin : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall X , finite X -> forall a , a /:e X -> forall x y : set -> set , (forall z :e X :\/: {a} , x z :e K /\ y z :e K) -> forall F :e Power X , god1_product_choice_term K add mul (X :\/: {a}) x y (F :\/: {a}) = mul (god1_product_choice_term K add mul X x y F) (x a).
Axiom god1_product_choice_term_in : forall K , forall add mul : set -> set -> set , ring K add mul -> forall I , finite I -> forall x y : set -> set , (forall i :e I , x i :e K /\ y i :e K) -> forall F :e Power I , god1_product_choice_term K add mul I x y F :e K.
Axiom god1_product_choice_sum_adjoin : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall X , finite X -> forall a , a /:e X -> forall x y : set -> set , (forall z :e X :\/: {a} , x z :e K /\ y z :e K) -> ring_finite_sum K add (Power (X :\/: {a})) (god1_product_choice_term K add mul (X :\/: {a}) x y) = add (mul (ring_finite_sum K add (Power X) (god1_product_choice_term K add mul X x y)) (y a)) (mul (ring_finite_sum K add (Power X) (god1_product_choice_term K add mul X x y)) (x a)).
Axiom god1_product_of_sums_expansion_empty : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall x y : set -> set , (forall i :e 0 , x i :e K /\ y i :e K) -> ring_finite_product K add mul 0 (fun i => add (x i) (y i)) = ring_finite_sum K add (Power 0) (god1_product_choice_term K add mul 0 x y).
Axiom god1_product_of_sums_expansion_step : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall X a , finite X -> a /:e X -> (forall x y : set -> set , (forall i :e X , x i :e K /\ y i :e K) -> ring_finite_product K add mul X (fun i => add (x i) (y i)) = ring_finite_sum K add (Power X) (god1_product_choice_term K add mul X x y)) -> forall x y : set -> set , (forall i :e X :\/: {a} , x i :e K /\ y i :e K) -> ring_finite_product K add mul (X :\/: {a}) (fun i => add (x i) (y i)) = ring_finite_sum K add (Power (X :\/: {a})) (god1_product_choice_term K add mul (X :\/: {a}) x y).
Axiom god1_product_of_sums_expansion_core : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall I , finite I -> forall x y : set -> set , (forall i :e I , x i :e K /\ y i :e K) -> ring_finite_product K add mul I (fun i => add (x i) (y i)) = ring_finite_sum K add (Power I) (god1_product_choice_term K add mul I x y).
Axiom god1_product_of_sums_expansion : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall I , finite I -> forall x y : set -> set , (forall i :e I , x i :e K /\ y i :e K) -> ring_finite_product K add mul I (fun i => add (x i) (y i)) = ring_finite_sum K add (Power I) (fun F => mul (ring_finite_product K add mul F x) (ring_finite_product K add mul (I :\: F) y)).
Definition ring_homomorphism : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> prop := fun K addK mulK L addL mulL f => ring K addK mulK /\ ring L addL mulL /\ (forall x :e K , f x :e L) /\ (forall x y :e K , f (addK x y) = addL (f x) (f y) /\ f (mulK x y) = mulL (f x) (f y)) /\ f (ring_one K mulK) = ring_one L mulL.
Definition ring_isomorphism : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> prop := fun K addK mulK L addL mulL f => ring_homomorphism K addK mulK L addL mulL f /\ bij K L f.
Definition isomorphic_rings : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K addK mulK L addL mulL => exists f : set -> set , ring_isomorphism K addK mulK L addL mulL f.
Axiom god1_ring_homomorphism_rings : forall K , forall addK mulK : set -> set -> set , forall L , forall addL mulL : set -> set -> set , forall f : set -> set , ring_homomorphism K addK mulK L addL mulL f -> ring K addK mulK /\ ring L addL mulL.
Axiom god1_ring_homomorphism_maps_into : forall K , forall addK mulK : set -> set -> set , forall L , forall addL mulL : set -> set -> set , forall f : set -> set , ring_homomorphism K addK mulK L addL mulL f -> forall x :e K , f x :e L.
Axiom god1_ring_homomorphism_operations : forall K , forall addK mulK : set -> set -> set , forall L , forall addL mulL : set -> set -> set , forall f : set -> set , ring_homomorphism K addK mulK L addL mulL f -> forall x y :e K , f (addK x y) = addL (f x) (f y) /\ f (mulK x y) = mulL (f x) (f y).
Axiom god1_ring_homomorphism_preserves_one : forall K , forall addK mulK : set -> set -> set , forall L , forall addL mulL : set -> set -> set , forall f : set -> set , ring_homomorphism K addK mulK L addL mulL f -> f (ring_one K mulK) = ring_one L mulL.
Axiom god1_ring_homomorphism_additive_group_homomorphism : forall K , forall addK mulK : set -> set -> set , forall L , forall addL mulL : set -> set -> set , forall f : set -> set , ring_homomorphism K addK mulK L addL mulL f -> group_homomorphism K addK L addL f.
Axiom god1_ring_homomorphism_composite : forall K , forall addK mulK : set -> set -> set , forall L , forall addL mulL : set -> set -> set , forall M , forall addM mulM : set -> set -> set , forall f g : set -> set , ring_homomorphism K addK mulK L addL mulL f -> ring_homomorphism L addL mulL M addM mulM g -> ring_homomorphism K addK mulK M addM mulM (fun x => g (f x)).
Axiom god1_bijective_ring_homomorphism_inverse : forall K , forall addK mulK : set -> set -> set , forall L , forall addL mulL : set -> set -> set , forall f : set -> set , ring_homomorphism K addK mulK L addL mulL f -> bij K L f -> ring_homomorphism L addL mulL K addK mulK (inv K f).
Axiom god1_ring_homomorphism_composition_and_inverse : forall K , forall addK mulK : set -> set -> set , forall L , forall addL mulL : set -> set -> set , forall M , forall addM mulM : set -> set -> set , forall f g : set -> set , ring_homomorphism K addK mulK L addL mulL f -> ring_homomorphism L addL mulL M addM mulM g -> ring_homomorphism K addK mulK M addM mulM (fun x => g (f x)) /\ (bij K L f -> ring_homomorphism L addL mulL K addK mulK (inv K f)).
Definition ring_homomorphism_kernel : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> set := fun K addK mulK L addL mulL f => {x :e K|f x = ring_zero L addL}.
Axiom god1_ring_homomorphism_injective_iff_trivial_kernel : forall K , forall addK mulK : set -> set -> set , forall L , forall addL mulL : set -> set -> set , forall f : set -> set , ring_homomorphism K addK mulK L addL mulL f -> (inj K L f <-> ring_homomorphism_kernel K addK mulK L addL mulL f = {ring_zero K addK}).
Axiom god1_ring_zero_multiplication_right : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x :e K , mul x (ring_zero K add) = ring_zero K add.
Axiom god1_ring_homomorphism_kernel_elim : forall K , forall addK mulK : set -> set -> set , forall L , forall addL mulL : set -> set -> set , forall f : set -> set , forall x , x :e ring_homomorphism_kernel K addK mulK L addL mulL f -> x :e K /\ f x = ring_zero L addL.
Axiom god1_ring_homomorphism_kernel_intro : forall K , forall addK mulK : set -> set -> set , forall L , forall addL mulL : set -> set -> set , forall f : set -> set , forall x , x :e K -> f x = ring_zero L addL -> x :e ring_homomorphism_kernel K addK mulK L addL mulL f.
Axiom god1_ring_homomorphism_kernel_additive_subgroup : forall K , forall addK mulK : set -> set -> set , forall L , forall addL mulL : set -> set -> set , forall f : set -> set , ring_homomorphism K addK mulK L addL mulL f -> subgroup K addK (ring_homomorphism_kernel K addK mulK L addL mulL f).
Axiom god1_ring_homomorphism_kernel_absorbs : forall K , forall addK mulK : set -> set -> set , forall L , forall addL mulL : set -> set -> set , forall f : set -> set , ring_homomorphism K addK mulK L addL mulL f -> forall a :e K , forall x :e ring_homomorphism_kernel K addK mulK L addL mulL f , mulK a x :e ring_homomorphism_kernel K addK mulK L addL mulL f /\ mulK x a :e ring_homomorphism_kernel K addK mulK L addL mulL f.
Definition left_ideal : set -> (set -> set -> set) -> (set -> set -> set) -> set -> prop := fun K add mul I => ring K add mul /\ I c= K /\ subgroup K add I /\ forall a :e K , forall x :e I , mul a x :e I.
Definition right_ideal : set -> (set -> set -> set) -> (set -> set -> set) -> set -> prop := fun K add mul I => ring K add mul /\ I c= K /\ subgroup K add I /\ forall a :e K , forall x :e I , mul x a :e I.
Definition two_sided_ideal : set -> (set -> set -> set) -> (set -> set -> set) -> set -> prop := fun K add mul I => left_ideal K add mul I /\ right_ideal K add mul I.
Axiom god1_ring_homomorphism_kernel_is_two_sided_ideal : forall K , forall addK mulK : set -> set -> set , forall L , forall addL mulL : set -> set -> set , forall f : set -> set , ring_homomorphism K addK mulK L addL mulL f -> two_sided_ideal K addK mulK (ring_homomorphism_kernel K addK mulK L addL mulL f).
Axiom god1_two_sided_ideal_iff_left_and_right : forall K , forall add mul : set -> set -> set , forall I , ring K add mul -> I c= K -> (two_sided_ideal K add mul I <-> left_ideal K add mul I /\ right_ideal K add mul I).
Definition principal_ideal : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set := fun K add mul x => {mul u x|u :e K}.
Axiom god1_group_is_subgroup_of_itself : forall G , forall op : set -> set -> set , group G op -> subgroup G op G.
Axiom god1_ring_right_multiplication_additive_homomorphism : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x :e K , group_homomorphism K add K add (fun u : set => mul u x).
Axiom god1_principal_ideal_additive_subgroup : forall K , forall add mul : set -> set -> set , forall x :e K , ring K add mul -> subgroup K add (principal_ideal K add mul x).
Axiom god1_principal_ideal_absorbs : forall K , forall add mul : set -> set -> set , forall x :e K , commutative_ring K add mul -> forall a :e K , forall z :e principal_ideal K add mul x , mul a z :e principal_ideal K add mul x /\ mul z a :e principal_ideal K add mul x.
Axiom god1_principal_ideal_is_ideal : forall K , forall add mul : set -> set -> set , forall x :e K , commutative_ring K add mul -> two_sided_ideal K add mul (principal_ideal K add mul x).
Definition principal_ideal_domain : set -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K add mul => integral_domain K add mul /\ forall I , two_sided_ideal K add mul I -> exists x :e K , I = principal_ideal K add mul x.
Definition square_in_ring : set -> (set -> set -> set) -> (set -> set -> set) -> set -> prop := fun K add mul d => d :e K /\ exists x :e K , mul x x = d.
Definition square_root_in_ring : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> prop := fun K add mul d x => x :e K /\ d :e K /\ mul x x = d.
Axiom god1_commutative_ring_difference_of_squares : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall x y :e K , mul (add x (ring_negation K add y)) (add x y) = add (mul x x) (ring_negation K add (mul y y)).
Axiom god1_integral_domain_sum_difference_zero_cases : forall K , forall add mul : set -> set -> set , integral_domain K add mul -> forall x y :e K , mul (add x (ring_negation K add y)) (add x y) = ring_zero K add -> y = x \/ y = ring_negation K add x.
Axiom god1_integral_domain_square_roots_unique_up_to_sign : forall K , forall add mul : set -> set -> set , integral_domain K add mul -> forall d x y :e K , square_root_in_ring K add mul d x -> square_root_in_ring K add mul d y -> y = x \/ y = ring_negation K add x.
Definition quadratic_linear_span : set -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> set -> set := fun K L addL mulL j omega => {z :e L|exists x y :e K , z = addL (j x) (mulL omega (j y))}.
Axiom god1_commutative_ring_three_factor_interchange : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall a b c :e K , mul a (mul b c) = mul b (mul a c).
Axiom god1_commutative_ring_four_factor_interchange : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall a b c d :e K , mul (mul a b) (mul c d) = mul (mul a c) (mul b d).
Axiom god1_commutative_ring_product_of_sums_grouped : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall a b c d :e K , mul (add a b) (add c d) = add (add (mul a c) (mul b d)) (add (mul a d) (mul b c)).
Axiom god1_quadratic_linear_span_intro : forall K , forall addK mulK : set -> set -> set , forall L , forall addL mulL : set -> set -> set , forall j : set -> set , forall omega , ring_homomorphism K addK mulK L addL mulL j -> omega :e L -> forall x y :e K , addL (j x) (mulL omega (j y)) :e quadratic_linear_span K L addL mulL j omega.
Axiom god1_quadratic_linear_span_subset : forall K L , forall addL mulL : set -> set -> set , forall j : set -> set , forall omega , quadratic_linear_span K L addL mulL j omega c= L.
Axiom god1_quadratic_linear_span_contains_base : forall K , forall addK mulK : set -> set -> set , forall L , forall addL mulL : set -> set -> set , forall j : set -> set , forall omega , ring_homomorphism K addK mulK L addL mulL j -> omega :e L -> group_image_of_subset K j c= quadratic_linear_span K L addL mulL j omega.
Axiom god1_quadratic_linear_span_contains_root : forall K , forall addK mulK : set -> set -> set , forall L , forall addL mulL : set -> set -> set , forall j : set -> set , forall omega , ring_homomorphism K addK mulK L addL mulL j -> omega :e L -> omega :e quadratic_linear_span K L addL mulL j omega.
Axiom god1_quadratic_linear_span_sum_formula : forall K , forall addK mulK : set -> set -> set , forall L , forall addL mulL : set -> set -> set , forall j : set -> set , forall omega , commutative_ring K addK mulK -> commutative_ring L addL mulL -> ring_homomorphism K addK mulK L addL mulL j -> omega :e L -> forall x y x' y' :e K , addL (addL (j x) (mulL omega (j y))) (addL (j x') (mulL omega (j y'))) = addL (j (addK x x')) (mulL omega (j (addK y y'))).
Axiom god1_quadratic_linear_span_product_formula : forall K , forall addK mulK : set -> set -> set , forall L , forall addL mulL : set -> set -> set , forall j : set -> set , forall d omega , commutative_ring K addK mulK -> commutative_ring L addL mulL -> ring_homomorphism K addK mulK L addL mulL j -> d :e K -> omega :e L -> mulL omega omega = j d -> forall x y x' y' :e K , mulL (addL (j x) (mulL omega (j y))) (addL (j x') (mulL omega (j y'))) = addL (j (addK (mulK x x') (mulK d (mulK y y')))) (mulL omega (j (addK (mulK x y') (mulK x' y)))).
Axiom god1_quadratic_linear_span_contains_minus_one : forall K , forall addK mulK : set -> set -> set , forall L , forall addL mulL : set -> set -> set , forall j : set -> set , forall omega , ring_homomorphism K addK mulK L addL mulL j -> omega :e L -> ring_negation L addL (ring_one L mulL) :e quadratic_linear_span K L addL mulL j omega.
Axiom god1_quadratic_linear_span_closed : forall K , forall addK mulK : set -> set -> set , forall L , forall addL mulL : set -> set -> set , forall j : set -> set , forall d omega , commutative_ring K addK mulK -> commutative_ring L addL mulL -> ring_homomorphism K addK mulK L addL mulL j -> d :e K -> omega :e L -> mulL omega omega = j d -> forall z w :e quadratic_linear_span K L addL mulL j omega , addL z w :e quadratic_linear_span K L addL mulL j omega /\ mulL z w :e quadratic_linear_span K L addL mulL j omega.
Axiom god1_quadratic_linear_span_subring_core : forall K , forall addK mulK : set -> set -> set , forall L , forall addL mulL : set -> set -> set , forall j : set -> set , forall d omega , commutative_ring K addK mulK -> commutative_ring L addL mulL -> ring_homomorphism K addK mulK L addL mulL j -> d :e K -> omega :e L -> mulL omega omega = j d -> subring L addL mulL (quadratic_linear_span K L addL mulL j omega).
Axiom god1_quadratic_linear_span_is_subring : forall K , forall addK mulK : set -> set -> set , forall L , forall addL mulL : set -> set -> set , forall j : set -> set , forall d omega , commutative_ring K addK mulK -> commutative_ring L addL mulL -> ring_homomorphism K addK mulK L addL mulL j -> inj K L j -> d :e K -> omega :e L -> mulL omega omega = j d -> subring L addL mulL (quadratic_linear_span K L addL mulL j omega) /\ group_image_of_subset K j c= quadratic_linear_span K L addL mulL j omega /\ omega :e quadratic_linear_span K L addL mulL j omega.
Definition quadratic_extension : set -> set := fun K => K :*: K.
Definition quadratic_extension_addition : set -> (set -> set -> set) -> set -> set -> set := fun K add z w => (add (z 0) (w 0),add (z 1) (w 1)).
Definition quadratic_extension_multiplication : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set -> set := fun K add mul d z w => (add (mul (z 0) (w 0)) (mul d (mul (z 1) (w 1))),add (mul (z 0) (w 1)) (mul (w 0) (z 1))).
Definition quadratic_extension_embedding : set -> (set -> set -> set) -> set -> set := fun K add x => (x,ring_zero K add).
Definition quadratic_extension_root : set -> (set -> set -> set) -> (set -> set -> set) -> set := fun K add mul => (ring_zero K add,ring_one K mul).
Axiom god1_quadratic_extension_coordinates : forall K , forall z :e quadratic_extension K , z 0 :e K /\ z 1 :e K.
Axiom god1_quadratic_extension_eta : forall K , forall z :e quadratic_extension K , (z 0,z 1) = z.
Axiom god1_quadratic_extension_addition_component_zero : forall K , forall add : set -> set -> set , forall z w , quadratic_extension_addition K add z w 0 = add (z 0) (w 0).
Axiom god1_quadratic_extension_addition_component_one : forall K , forall add : set -> set -> set , forall z w , quadratic_extension_addition K add z w 1 = add (z 1) (w 1).
Axiom god1_quadratic_extension_addition_law : forall K , forall add mul : set -> set -> set , ring K add mul -> law_of_composition (quadratic_extension K) (quadratic_extension_addition K add).
Axiom god1_quadratic_extension_addition_associative : forall K , forall add mul : set -> set -> set , ring K add mul -> associative_on (quadratic_extension K) (quadratic_extension_addition K add).
Axiom god1_quadratic_extension_addition_commutative : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> commutative_on (quadratic_extension K) (quadratic_extension_addition K add).
Axiom god1_quadratic_extension_additive_zero_neutral : forall K , forall add mul : set -> set -> set , ring K add mul -> neutral_element (quadratic_extension K) (quadratic_extension_addition K add) (ring_zero K add,ring_zero K add).
Axiom god1_quadratic_extension_additive_inverses : forall K , forall add mul : set -> set -> set , ring K add mul -> forall z :e quadratic_extension K , exists v :e quadratic_extension K , reflection (quadratic_extension K) (quadratic_extension_addition K add) (ring_zero K add,ring_zero K add) z v.
Axiom god1_quadratic_extension_additive_group : forall K , forall add mul : set -> set -> set , ring K add mul -> group (quadratic_extension K) (quadratic_extension_addition K add).
Axiom god1_quadratic_extension_additive_abelian_group : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> abelian_group (quadratic_extension K) (quadratic_extension_addition K add).
Axiom god1_quadratic_extension_multiplication_component_zero : forall K , forall add mul : set -> set -> set , forall d z w , quadratic_extension_multiplication K add mul d z w 0 = add (mul (z 0) (w 0)) (mul d (mul (z 1) (w 1))).
Axiom god1_quadratic_extension_multiplication_component_one : forall K , forall add mul : set -> set -> set , forall d z w , quadratic_extension_multiplication K add mul d z w 1 = add (mul (z 0) (w 1)) (mul (w 0) (z 1)).
Axiom god1_quadratic_extension_multiplication_law : forall K , forall add mul : set -> set -> set , forall d :e K , ring K add mul -> law_of_composition (quadratic_extension K) (quadratic_extension_multiplication K add mul d).
Axiom god1_quadratic_extension_multiplication_commutative : forall K , forall add mul : set -> set -> set , forall d :e K , commutative_ring K add mul -> commutative_on (quadratic_extension K) (quadratic_extension_multiplication K add mul d).
Axiom god1_quadratic_extension_multiplication_one_neutral : forall K , forall add mul : set -> set -> set , forall d :e K , commutative_ring K add mul -> neutral_element (quadratic_extension K) (quadratic_extension_multiplication K add mul d) (ring_one K mul,ring_zero K add).
Axiom god1_quadratic_extension_multiplicative_identity_exists : forall K , forall add mul : set -> set -> set , forall d :e K , commutative_ring K add mul -> exists one :e quadratic_extension K , neutral_element (quadratic_extension K) (quadratic_extension_multiplication K add mul d) one.
Axiom god1_abelian_four_term_rotate : forall K , forall add : set -> set -> set , abelian_group K add -> forall a b c d :e K , add (add a b) (add c d) = add (add a d) (add b c).
Axiom god1_quadratic_associativity_first_coordinate : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall d a b c e f g :e K , add (mul a (add (mul c f) (mul d (mul e g)))) (mul d (mul b (add (mul c g) (mul f e)))) = add (mul (add (mul a c) (mul d (mul b e))) f) (mul d (mul (add (mul a e) (mul c b)) g)).
Axiom god1_quadratic_associativity_second_coordinate : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall d a b c e f g :e K , add (mul a (add (mul c g) (mul f e))) (mul (add (mul c f) (mul d (mul e g))) b) = add (mul (add (mul a c) (mul d (mul b e))) g) (mul f (add (mul a e) (mul c b))).
Axiom god1_quadratic_extension_multiplication_associative : forall K , forall add mul : set -> set -> set , forall d :e K , commutative_ring K add mul -> associative_on (quadratic_extension K) (quadratic_extension_multiplication K add mul d).
Axiom god1_quadratic_distributivity_first_coordinate : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall d a b c e f g :e K , add (mul a (add c f)) (mul d (mul b (add e g))) = add (add (mul a c) (mul d (mul b e))) (add (mul a f) (mul d (mul b g))).
Axiom god1_quadratic_distributivity_second_coordinate : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall a b c e f g :e K , add (mul a (add e g)) (mul (add c f) b) = add (add (mul a e) (mul c b)) (add (mul a g) (mul f b)).
Axiom god1_quadratic_extension_left_distributive : forall K , forall add mul : set -> set -> set , forall d :e K , commutative_ring K add mul -> forall x y z :e quadratic_extension K , quadratic_extension_multiplication K add mul d x (quadratic_extension_addition K add y z) = quadratic_extension_addition K add (quadratic_extension_multiplication K add mul d x y) (quadratic_extension_multiplication K add mul d x z).
Axiom god1_quadratic_extension_distributive_laws : forall K , forall add mul : set -> set -> set , forall d :e K , commutative_ring K add mul -> forall x y z :e quadratic_extension K , quadratic_extension_multiplication K add mul d x (quadratic_extension_addition K add y z) = quadratic_extension_addition K add (quadratic_extension_multiplication K add mul d x y) (quadratic_extension_multiplication K add mul d x z) /\ quadratic_extension_multiplication K add mul d (quadratic_extension_addition K add x y) z = quadratic_extension_addition K add (quadratic_extension_multiplication K add mul d x z) (quadratic_extension_multiplication K add mul d y z).
Axiom god1_quadratic_extension_is_commutative_ring : forall K , forall add mul : set -> set -> set , forall d :e K , commutative_ring K add mul -> commutative_ring (quadratic_extension K) (quadratic_extension_addition K add) (quadratic_extension_multiplication K add mul d).
Axiom god1_quadratic_extension_embedding_member : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x :e K , quadratic_extension_embedding K add x :e quadratic_extension K.
Axiom god1_quadratic_extension_embedding_injective : forall K , forall add mul : set -> set -> set , ring K add mul -> inj K (quadratic_extension K) (quadratic_extension_embedding K add).
Axiom god1_quadratic_extension_embedding_preserves_addition : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x y :e K , quadratic_extension_embedding K add (add x y) = quadratic_extension_addition K add (quadratic_extension_embedding K add x) (quadratic_extension_embedding K add y).
Axiom god1_quadratic_extension_embedding_preserves_multiplication : forall K , forall add mul : set -> set -> set , forall d :e K , ring K add mul -> forall x y :e K , quadratic_extension_embedding K add (mul x y) = quadratic_extension_multiplication K add mul d (quadratic_extension_embedding K add x) (quadratic_extension_embedding K add y).
Axiom god1_quadratic_extension_ring_one : forall K , forall add mul : set -> set -> set , forall d :e K , commutative_ring K add mul -> (ring_one K mul,ring_zero K add) = ring_one (quadratic_extension K) (quadratic_extension_multiplication K add mul d).
Axiom god1_quadratic_extension_embedding_is_ring_homomorphism : forall K , forall add mul : set -> set -> set , forall d :e K , commutative_ring K add mul -> ring_homomorphism K add mul (quadratic_extension K) (quadratic_extension_addition K add) (quadratic_extension_multiplication K add mul d) (quadratic_extension_embedding K add).
Axiom god1_quadratic_extension_root_member : forall K , forall add mul : set -> set -> set , ring K add mul -> quadratic_extension_root K add mul :e quadratic_extension K.
Axiom god1_quadratic_extension_root_square : forall K , forall add mul : set -> set -> set , forall d :e K , commutative_ring K add mul -> quadratic_extension_multiplication K add mul d (quadratic_extension_root K add mul) (quadratic_extension_root K add mul) = quadratic_extension_embedding K add d.
Axiom god1_quadratic_extension_root_is_square_root : forall K , forall add mul : set -> set -> set , forall d :e K , commutative_ring K add mul -> square_root_in_ring (quadratic_extension K) (quadratic_extension_addition K add) (quadratic_extension_multiplication K add mul d) (quadratic_extension_embedding K add d) (quadratic_extension_root K add mul).
Axiom god1_quadratic_extension_canonical_embedding : forall K , forall add mul : set -> set -> set , forall d :e K , commutative_ring K add mul -> ring_homomorphism K add mul (quadratic_extension K) (quadratic_extension_addition K add) (quadratic_extension_multiplication K add mul d) (quadratic_extension_embedding K add) /\ inj K (quadratic_extension K) (quadratic_extension_embedding K add) /\ square_root_in_ring (quadratic_extension K) (quadratic_extension_addition K add) (quadratic_extension_multiplication K add mul d) (quadratic_extension_embedding K add d) (quadratic_extension_root K add mul).
Definition quadratic_conjugate : set -> (set -> set -> set) -> set -> set := fun K add z => (z 0,ring_negation K add (z 1)).
Definition quadratic_norm : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set := fun K add mul d z => add (mul (z 0) (z 0)) (ring_negation K add (mul d (mul (z 1) (z 1)))).
Axiom god1_ring_negation_addition : forall K , forall add mul : set -> set -> set , ring K add mul -> forall a b :e K , ring_negation K add (add a b) = add (ring_negation K add a) (ring_negation K add b).
Axiom god1_commutative_ring_product_of_negations : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall a b :e K , mul (ring_negation K add a) (ring_negation K add b) = mul a b.
Axiom god1_quadratic_conjugate_member : forall K , forall add mul : set -> set -> set , ring K add mul -> forall z :e quadratic_extension K , quadratic_conjugate K add z :e quadratic_extension K.
Axiom god1_quadratic_norm_member : forall K , forall add mul : set -> set -> set , forall d :e K , ring K add mul -> forall z :e quadratic_extension K , quadratic_norm K add mul d z :e K.
Axiom god1_quadratic_conjugate_preserves_addition : forall K , forall add mul : set -> set -> set , ring K add mul -> forall z w :e quadratic_extension K , quadratic_conjugate K add (quadratic_extension_addition K add z w) = quadratic_extension_addition K add (quadratic_conjugate K add z) (quadratic_conjugate K add w).
Axiom god1_quadratic_conjugate_preserves_multiplication : forall K , forall add mul : set -> set -> set , forall d :e K , commutative_ring K add mul -> forall z w :e quadratic_extension K , quadratic_conjugate K add (quadratic_extension_multiplication K add mul d z w) = quadratic_extension_multiplication K add mul d (quadratic_conjugate K add z) (quadratic_conjugate K add w).
Axiom god1_quadratic_norm_as_product_with_conjugate : forall K , forall add mul : set -> set -> set , forall d :e K , commutative_ring K add mul -> forall u :e quadratic_extension K , quadratic_extension_multiplication K add mul d u (quadratic_conjugate K add u) = quadratic_extension_embedding K add (quadratic_norm K add mul d u).
Axiom god1_quadratic_norm_multiplicative : forall K , forall add mul : set -> set -> set , forall d :e K , commutative_ring K add mul -> forall z w :e quadratic_extension K , quadratic_norm K add mul d (quadratic_extension_multiplication K add mul d z w) = mul (quadratic_norm K add mul d z) (quadratic_norm K add mul d w).
Axiom god1_quadratic_conjugate_and_norm_laws : forall K , forall add mul : set -> set -> set , forall d :e K , commutative_ring K add mul -> forall z w :e quadratic_extension K , quadratic_conjugate K add (quadratic_extension_addition K add z w) = quadratic_extension_addition K add (quadratic_conjugate K add z) (quadratic_conjugate K add w) /\ quadratic_conjugate K add (quadratic_extension_multiplication K add mul d z w) = quadratic_extension_multiplication K add mul d (quadratic_conjugate K add z) (quadratic_conjugate K add w) /\ quadratic_norm K add mul d (quadratic_extension_multiplication K add mul d z w) = mul (quadratic_norm K add mul d z) (quadratic_norm K add mul d w).
Axiom god1_quadratic_norm_of_embedding : forall K , forall add mul : set -> set -> set , forall d :e K , ring K add mul -> forall x :e K , quadratic_norm K add mul d (quadratic_extension_embedding K add x) = mul x x.
Axiom god1_quadratic_norm_one : forall K , forall add mul : set -> set -> set , forall d :e K , commutative_ring K add mul -> quadratic_norm K add mul d (ring_one (quadratic_extension K) (quadratic_extension_multiplication K add mul d)) = ring_one K mul.
Axiom god1_quadratic_norm_unit_candidate_reflection : forall K , forall add mul : set -> set -> set , forall d :e K , commutative_ring K add mul -> forall z :e quadratic_extension K , ring_unit K add mul (quadratic_norm K add mul d z) -> reflection (quadratic_extension K) (quadratic_extension_multiplication K add mul d) (ring_one (quadratic_extension K) (quadratic_extension_multiplication K add mul d)) z (quadratic_extension_multiplication K add mul d (quadratic_extension_embedding K add (ring_inverse K add mul (quadratic_norm K add mul d z))) (quadratic_conjugate K add z)).
Axiom god1_s9_theorem1_units_in_quadratic_extension : forall K , forall add mul : set -> set -> set , forall d :e K , commutative_ring K add mul -> forall z :e quadratic_extension K , (ring_unit (quadratic_extension K) (quadratic_extension_addition K add) (quadratic_extension_multiplication K add mul d) z <-> ring_unit K add mul (quadratic_norm K add mul d z)) /\ (ring_unit K add mul (quadratic_norm K add mul d z) -> ring_inverse (quadratic_extension K) (quadratic_extension_addition K add) (quadratic_extension_multiplication K add mul d) z = quadratic_extension_multiplication K add mul d (quadratic_extension_embedding K add (ring_inverse K add mul (quadratic_norm K add mul d z))) (quadratic_conjugate K add z)).
Axiom god1_quadratic_extension_ring_zero : forall K , forall add mul : set -> set -> set , ring K add mul -> (ring_zero K add,ring_zero K add) = ring_zero (quadratic_extension K) (quadratic_extension_addition K add).
Axiom god1_quadratic_square_zero_factorization : forall K , forall add mul : set -> set -> set , forall d :e K , commutative_ring K add mul -> square_in_ring K add mul d -> exists x :e K , quadratic_extension_multiplication K add mul d (quadratic_extension_addition K add (quadratic_extension_embedding K add x) (ring_negation (quadratic_extension K) (quadratic_extension_addition K add) (quadratic_extension_root K add mul))) (quadratic_extension_addition K add (quadratic_extension_embedding K add x) (quadratic_extension_root K add mul)) = ring_zero (quadratic_extension K) (quadratic_extension_addition K add).
Axiom god1_quadratic_root_not_embedding : forall K , forall add mul : set -> set -> set , ring K add mul -> ring_one K mul <> ring_zero K add -> forall x :e K , quadratic_extension_root K add mul <> quadratic_extension_embedding K add x.
Axiom god1_quadratic_extension_field_implies_nonsquare : forall K , forall add mul : set -> set -> set , field K add mul -> forall d :e K , field (quadratic_extension K) (quadratic_extension_addition K add) (quadratic_extension_multiplication K add mul d) -> ~ square_in_ring K add mul d.
Axiom god1_field_norm_equation_nonzero_second_forces_square : forall K , forall add mul : set -> set -> set , field K add mul -> forall d x y :e K , y <> ring_zero K add -> add (mul x x) (ring_negation K add (mul d (mul y y))) = ring_zero K add -> square_in_ring K add mul d.
Axiom god1_quadratic_norm_zero_under_nonsquare : forall K , forall add mul : set -> set -> set , field K add mul -> forall d :e K , ~ square_in_ring K add mul d -> forall z :e quadratic_extension K , quadratic_norm K add mul d z = ring_zero K add -> z = ring_zero (quadratic_extension K) (quadratic_extension_addition K add).
Axiom god1_quadratic_extension_one_ne_zero : forall K , forall add mul : set -> set -> set , forall d :e K , commutative_ring K add mul -> ring_one K mul <> ring_zero K add -> ring_one (quadratic_extension K) (quadratic_extension_multiplication K add mul d) <> ring_zero (quadratic_extension K) (quadratic_extension_addition K add).
Axiom god1_quadratic_nonsquare_implies_extension_field : forall K , forall add mul : set -> set -> set , field K add mul -> forall d :e K , ~ square_in_ring K add mul d -> field (quadratic_extension K) (quadratic_extension_addition K add) (quadratic_extension_multiplication K add mul d).
Axiom god1_quadratic_root_times_embedding : forall K , forall add mul : set -> set -> set , forall d :e K , commutative_ring K add mul -> forall y :e K , quadratic_extension_multiplication K add mul d (quadratic_extension_root K add mul) (quadratic_extension_embedding K add y) = (ring_zero K add,y).
Axiom god1_quadratic_extension_coordinate_representation : forall K , forall add mul : set -> set -> set , forall d :e K , commutative_ring K add mul -> forall z :e quadratic_extension K , exists x y :e K , z = quadratic_extension_addition K add (quadratic_extension_embedding K add x) (quadratic_extension_multiplication K add mul d (quadratic_extension_root K add mul) (quadratic_extension_embedding K add y)).
Axiom god1_s9_theorem2_quadratic_extension_field_iff_nonsquare : forall K , forall add mul : set -> set -> set , field K add mul -> forall d :e K , (field (quadratic_extension K) (quadratic_extension_addition K add) (quadratic_extension_multiplication K add mul d) <-> ~ square_in_ring K add mul d).
Axiom god1_field_from_explicit_arithmetic : forall K , forall add mul : set -> set -> set , forall zero one , forall neg inv : set -> set , law_of_composition K add -> associative_on K add -> commutative_on K add -> neutral_element K add zero -> (forall x :e K , neg x :e K /\ add (neg x) x = zero /\ add x (neg x) = zero) -> law_of_composition K mul -> associative_on K mul -> commutative_on K mul -> neutral_element K mul one -> (forall x y z :e K , mul x (add y z) = add (mul x y) (mul x z) /\ mul (add x y) z = add (mul x z) (mul y z)) -> one <> zero -> (forall x :e K , x <> zero -> inv x :e K /\ mul (inv x) x = one /\ mul x (inv x) = one) -> field K add mul.
Axiom god1_real_numbers_are_field : field real add_SNo mul_SNo.
Axiom god1_real_minus_one_is_nonsquare : ~ square_in_ring real add_SNo mul_SNo (minus_SNo 1).
Axiom god1_complex_numbers_are_field_direct : field complex add_CSNo mul_CSNo.
Axiom god1_complex_numbers_form_field : field complex add_CSNo mul_CSNo.
Axiom god1_real_is_subfield_of_complex : subfield complex add_CSNo mul_CSNo real.
Axiom god1_reals_form_subfield_of_complex_numbers : subfield complex add_CSNo mul_CSNo real.
Axiom god1_complex_i_and_cartesian_representation : Complex_i :e complex /\ mul_CSNo Complex_i Complex_i = minus_CSNo 1 /\ (forall z :e complex , z = add_CSNo (CSNo_Re z) (mul_CSNo Complex_i (CSNo_Im z))) /\ (forall z :e complex , forall x y :e real , z = add_CSNo x (mul_CSNo Complex_i y) -> x = CSNo_Re z /\ y = CSNo_Im z).
Definition pure_imaginary : set -> prop := fun z => z :e complex /\ CSNo_Re z = 0.
Axiom god1_complex_real_iff_imaginary_part_zero : forall z :e complex , z :e real <-> CSNo_Im z = 0.
Axiom god1_complex_norm_as_conjugate_product : forall z :e complex , abs_sqr_CSNo z = mul_CSNo (conj_CSNo z) z.
Axiom god1_complex_abs_sqr_is_real : forall z :e complex , abs_sqr_CSNo z :e real.
Axiom god1_complex_inverse_via_norm_conjugate : forall z :e complex , z <> 0 -> recip_CSNo z = mul_CSNo (recip_SNo (abs_sqr_CSNo z)) (conj_CSNo z).
Axiom god1_complex_conjugate_norm_and_inverse : (forall z :e complex , abs_sqr_CSNo z = mul_CSNo (conj_CSNo z) z) /\ (forall z w :e complex , conj_CSNo (add_CSNo z w) = add_CSNo (conj_CSNo z) (conj_CSNo w) /\ conj_CSNo (mul_CSNo z w) = mul_CSNo (conj_CSNo z) (conj_CSNo w) /\ abs_sqr_CSNo (mul_CSNo z w) = mul_SNo (abs_sqr_CSNo z) (abs_sqr_CSNo w)) /\ (forall z :e complex , z <> 0 -> recip_CSNo z = mul_CSNo (recip_SNo (abs_sqr_CSNo z)) (conj_CSNo z)).
Definition complex_argument : set -> set -> prop := fun z theta => z :e complex /\ z <> 0 /\ theta :e real /\ z = mul_CSNo (modulus_CSNo z) (add_CSNo (complex_cos theta) (mul_CSNo Complex_i (complex_sin theta))).
Axiom god1_complex_modulus_basic_properties : (forall z :e complex , modulus_CSNo z :e real /\ SNoLe 0 (modulus_CSNo z) /\ (modulus_CSNo z = 0 <-> z = 0)) /\ (forall z w :e complex , SNoLe (modulus_CSNo (add_CSNo z w)) (add_SNo (modulus_CSNo z) (modulus_CSNo w))) /\ (forall z w :e complex , modulus_CSNo (mul_CSNo z w) = mul_SNo (modulus_CSNo z) (modulus_CSNo w)).
Axiom god1_nonzero_complex_has_nonzero_cartesian_coordinate : forall z :e complex , z <> 0 -> CSNo_Re z <> 0 \/ CSNo_Im z <> 0.
Axiom god1_nonzero_complex_polar_coordinate_angle : (forall x y :e real , x <> 0 \/ y <> 0 -> exists theta :e real , complex_cos theta :e real /\ complex_sin theta :e real /\ x = mul_SNo (modulus_CSNo (add_CSNo x (mul_CSNo Complex_i y))) (complex_cos theta) /\ y = mul_SNo (modulus_CSNo (add_CSNo x (mul_CSNo Complex_i y))) (complex_sin theta)) -> forall z :e complex , z <> 0 -> exists theta :e real , complex_cos theta :e real /\ complex_sin theta :e real /\ CSNo_Re z = mul_SNo (modulus_CSNo z) (complex_cos theta) /\ CSNo_Im z = mul_SNo (modulus_CSNo z) (complex_sin theta).
Axiom god1_polar_coordinate_data_gives_argument : forall z :e complex , z <> 0 -> forall theta :e real , complex_cos theta :e real -> complex_sin theta :e real -> CSNo_Re z = mul_SNo (modulus_CSNo z) (complex_cos theta) -> CSNo_Im z = mul_SNo (modulus_CSNo z) (complex_sin theta) -> complex_argument z theta.
Axiom god1_complex_polar_representation : (forall x y :e real , x <> 0 \/ y <> 0 -> exists theta :e real , complex_cos theta :e real /\ complex_sin theta :e real /\ x = mul_SNo (modulus_CSNo (add_CSNo x (mul_CSNo Complex_i y))) (complex_cos theta) /\ y = mul_SNo (modulus_CSNo (add_CSNo x (mul_CSNo Complex_i y))) (complex_sin theta)) -> forall z :e complex , z <> 0 -> exists theta :e real , complex_argument z theta.
Axiom god1_complex_cartesian_pair_coordinates : forall x y :e real , (add_CSNo x (mul_CSNo Complex_i y) :e complex /\ CSNo_Re (add_CSNo x (mul_CSNo Complex_i y)) = x) /\ CSNo_Im (add_CSNo x (mul_CSNo Complex_i y)) = y.
Axiom god1_real_angle_euler_laws : (forall theta :e real , complex_cos theta :e real /\ complex_sin theta :e real) -> (forall theta phi :e real , complex_cos (add_SNo theta phi) = add_SNo (mul_SNo (complex_cos theta) (complex_cos phi)) (minus_SNo (mul_SNo (complex_sin phi) (complex_sin theta))) /\ complex_sin (add_SNo theta phi) = add_SNo (mul_SNo (complex_sin phi) (complex_cos theta)) (mul_SNo (complex_sin theta) (complex_cos phi))) -> (forall theta :e real , complex_cos theta :e real /\ complex_sin theta :e real) /\ forall theta phi :e real , mul_CSNo (add_CSNo (complex_cos theta) (mul_CSNo Complex_i (complex_sin theta))) (add_CSNo (complex_cos phi) (mul_CSNo Complex_i (complex_sin phi))) = add_CSNo (complex_cos (add_SNo theta phi)) (mul_CSNo Complex_i (complex_sin (add_SNo theta phi))).
Axiom god1_complex_argument_gives_coordinates : forall z :e complex , forall theta :e real , complex_argument z theta -> complex_cos theta :e real -> complex_sin theta :e real -> CSNo_Re z = mul_SNo (modulus_CSNo z) (complex_cos theta) /\ CSNo_Im z = mul_SNo (modulus_CSNo z) (complex_sin theta).
Axiom god1_complex_argument_of_product : (forall alpha :e real , complex_cos alpha :e real /\ complex_sin alpha :e real) -> (forall alpha beta :e real , complex_cos (add_SNo alpha beta) = add_SNo (mul_SNo (complex_cos alpha) (complex_cos beta)) (minus_SNo (mul_SNo (complex_sin beta) (complex_sin alpha))) /\ complex_sin (add_SNo alpha beta) = add_SNo (mul_SNo (complex_sin beta) (complex_cos alpha)) (mul_SNo (complex_sin alpha) (complex_cos beta))) -> forall z w :e complex , forall theta phi :e real , complex_argument z theta -> complex_argument w phi -> complex_argument (mul_CSNo z w) (add_SNo theta phi).
Axiom god1_natural_number_is_real : forall n :e omega , n :e real.
Axiom god1_de_moivre_zero : forall theta :e real , exp_CSNo_nat (add_CSNo (complex_cos theta) (mul_CSNo Complex_i (complex_sin theta))) 0 = add_CSNo (complex_cos (mul_SNo 0 theta)) (mul_CSNo Complex_i (complex_sin (mul_SNo 0 theta))).
Axiom god1_de_moivre_induction_step : (forall alpha :e real , complex_cos alpha :e real /\ complex_sin alpha :e real) -> (forall alpha beta :e real , complex_cos (add_SNo alpha beta) = add_SNo (mul_SNo (complex_cos alpha) (complex_cos beta)) (minus_SNo (mul_SNo (complex_sin beta) (complex_sin alpha))) /\ complex_sin (add_SNo alpha beta) = add_SNo (mul_SNo (complex_sin beta) (complex_cos alpha)) (mul_SNo (complex_sin alpha) (complex_cos beta))) -> forall theta :e real , forall n :e omega , exp_CSNo_nat (add_CSNo (complex_cos theta) (mul_CSNo Complex_i (complex_sin theta))) n = add_CSNo (complex_cos (mul_SNo n theta)) (mul_CSNo Complex_i (complex_sin (mul_SNo n theta))) -> exp_CSNo_nat (add_CSNo (complex_cos theta) (mul_CSNo Complex_i (complex_sin theta))) (ordsucc n) = add_CSNo (complex_cos (mul_SNo (ordsucc n) theta)) (mul_CSNo Complex_i (complex_sin (mul_SNo (ordsucc n) theta))).
Axiom god1_de_moivre : (forall alpha :e real , complex_cos alpha :e real /\ complex_sin alpha :e real) -> (forall alpha beta :e real , complex_cos (add_SNo alpha beta) = add_SNo (mul_SNo (complex_cos alpha) (complex_cos beta)) (minus_SNo (mul_SNo (complex_sin beta) (complex_sin alpha))) /\ complex_sin (add_SNo alpha beta) = add_SNo (mul_SNo (complex_sin beta) (complex_cos alpha)) (mul_SNo (complex_sin alpha) (complex_cos beta))) -> forall theta :e real , forall n :e omega , exp_CSNo_nat (add_CSNo (complex_cos theta) (mul_CSNo Complex_i (complex_sin theta))) n = add_CSNo (complex_cos (mul_SNo n theta)) (mul_CSNo Complex_i (complex_sin (mul_SNo n theta))).
Definition left_module : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K addK mulK M addM smul => ring K addK mulK /\ abelian_group M addM /\ (forall scalar :e K , forall x :e M , smul scalar x :e M) /\ (forall scalar mu :e K , forall x :e M , smul scalar (smul mu x) = smul (mulK scalar mu) x) /\ (forall x :e M , smul (ring_one K mulK) x = x) /\ (forall scalar mu :e K , forall x :e M , smul (addK scalar mu) x = addM (smul scalar x) (smul mu x)) /\ (forall scalar :e K , forall x y :e M , smul scalar (addM x y) = addM (smul scalar x) (smul scalar y)).
Definition left_vector_space : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K addK mulK M addM smul => division_ring K addK mulK /\ left_module K addK mulK M addM smul.
Definition right_module : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K addK mulK M addM smul => ring K addK mulK /\ abelian_group M addM /\ (forall x :e M , forall scalar :e K , smul x scalar :e M) /\ (forall x :e M , forall scalar mu :e K , smul (smul x scalar) mu = smul x (mulK scalar mu)) /\ (forall x :e M , smul x (ring_one K mulK) = x) /\ (forall x :e M , forall scalar mu :e K , smul x (addK scalar mu) = addM (smul x scalar) (smul x mu)) /\ (forall x y :e M , forall scalar :e K , smul (addM x y) scalar = addM (smul x scalar) (smul y scalar)).
Definition module_zero : set -> (set -> set -> set) -> set := fun M addM => group_identity M addM.
Definition module_negation : set -> (set -> set -> set) -> set -> set := fun M addM x => group_inverse M addM x.
Axiom god1_left_module_axiom_components : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , left_module K addK mulK M addM smul -> (((ring K addK mulK /\ abelian_group M addM) /\ ((forall scalar :e K , forall x :e M , smul scalar x :e M) /\ (forall scalar mu :e K , forall x :e M , smul scalar (smul mu x) = smul (mulK scalar mu) x))) /\ ((forall x :e M , smul (ring_one K mulK) x = x) /\ (forall scalar mu :e K , forall x :e M , smul (addK scalar mu) x = addM (smul scalar x) (smul mu x)))) /\ (forall scalar :e K , forall x y :e M , smul scalar (addM x y) = addM (smul scalar x) (smul scalar y)).
Axiom god1_left_module_ring_and_additive_component : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , left_module K addK mulK M addM smul -> ring K addK mulK /\ abelian_group M addM.
Axiom god1_left_module_scalar_core_component : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , left_module K addK mulK M addM smul -> (forall scalar :e K , forall x :e M , smul scalar x :e M) /\ (forall scalar mu :e K , forall x :e M , smul scalar (smul mu x) = smul (mulK scalar mu) x).
Axiom god1_left_module_scalar_add_component : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , left_module K addK mulK M addM smul -> (forall x :e M , smul (ring_one K mulK) x = x) /\ (forall scalar mu :e K , forall x :e M , smul (addK scalar mu) x = addM (smul scalar x) (smul mu x)).
Axiom god1_left_module_vector_add_component : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , left_module K addK mulK M addM smul -> forall scalar :e K , forall x y :e M , smul scalar (addM x y) = addM (smul scalar x) (smul scalar y).
Axiom god1_module_zero_and_negation_scalar_laws : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , left_module K addK mulK M addM smul -> (forall scalar :e K , smul scalar (module_zero M addM) = module_zero M addM) /\ (forall x :e M , smul (ring_zero K addK) x = module_zero M addM) /\ (forall x :e M , module_negation M addM x = smul (ring_negation K addK (ring_one K mulK)) x).
Definition module_power_addition : set -> (set -> set -> set) -> set -> set -> set := fun I addM x y => fun i :e I => addM (x i) (y i).
Definition module_power_left_scalar : set -> (set -> set -> set) -> set -> set -> set := fun I smul scalar x => fun i :e I => smul scalar (x i).
Axiom god1_module_power_addition_eval : forall I , forall addM : set -> set -> set , forall x y i , i :e I -> module_power_addition I addM x y i = addM (x i) (y i).
Axiom god1_module_power_left_scalar_eval : forall I , forall smul : set -> set -> set , forall scalar x i , i :e I -> module_power_left_scalar I smul scalar x i = smul scalar (x i).
Axiom god1_module_direct_power_is_module : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , left_module K addK mulK M addM smul -> left_module K addK mulK (M :^: I) (module_power_addition I addM) (module_power_left_scalar I smul).
Axiom god1_mapping_module_is_module : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall X , left_module K addK mulK M addM smul -> left_module K addK mulK (M :^: X) (module_power_addition X addM) (module_power_left_scalar X smul).
Definition submodule : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> prop := fun K addK mulK M addM smul N => left_module K addK mulK M addM smul /\ N c= M /\ subgroup M addM N /\ forall scalar :e K , forall x :e N , smul scalar x :e N.
Definition vector_subspace : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> prop := fun K addK mulK M addM smul N => left_vector_space K addK mulK M addM smul /\ submodule K addK mulK M addM smul N.
Axiom god1_submodule_test : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall N , left_module K addK mulK M addM smul -> N c= M -> (submodule K addK mulK M addM smul N <-> N <> 0 /\ forall scalar mu :e K , forall x y :e N , addM (smul scalar x) (smul mu y) :e N).
Axiom god1_submodule_induced_module : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall N , submodule K addK mulK M addM smul N -> left_module K addK mulK N addM smul.
Axiom god1_submodule_ambient_module : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall N , submodule K addK mulK M addM smul N -> left_module K addK mulK M addM smul.
Axiom god1_submodule_subset : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall N , submodule K addK mulK M addM smul N -> N c= M.
Axiom god1_submodule_additive_subgroup : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall N , submodule K addK mulK M addM smul N -> subgroup M addM N.
Axiom god1_submodule_scalar_closed : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall N , submodule K addK mulK M addM smul N -> forall scalar :e K , forall x :e N , smul scalar x :e N.
Definition module_family_intersection : set -> (set -> set) -> set -> set := fun I N M => {x :e M|forall i :e I , x :e N i}.
Definition module_family_union : set -> (set -> set) -> set := fun I N => \/_ i :e I , N i.
Axiom god1_s10_theorem1_intersection_and_directed_union_submodules : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall N : set -> set , left_module K addK mulK M addM smul -> (forall i :e I , submodule K addK mulK M addM smul (N i)) -> submodule K addK mulK M addM smul (module_family_intersection I N M) /\ (((exists i , i :e I) /\ (forall i j :e I , exists k :e I , N i c= N k /\ N j c= N k)) -> submodule K addK mulK M addM smul (module_family_union I N)).
Definition opposite_ring_multiplication : (set -> set -> set) -> set -> set -> set := fun mul x y => mul y x.
Axiom god1_opposite_ring_is_ring : forall K , forall add mul : set -> set -> set , ring K add mul -> ring K add (opposite_ring_multiplication mul).
Axiom god1_opposite_ring_one : forall K , forall add mul : set -> set -> set , ring K add mul -> ring_one K (opposite_ring_multiplication mul) = ring_one K mul.
Axiom god1_right_modules_are_left_modules_over_opposite_ring_core : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , right_module K addK mulK M addM smulR -> ((((ring K addK (opposite_ring_multiplication mulK) /\ abelian_group M addM) /\ (forall scalar :e K , forall x :e M , smulR x scalar :e M)) /\ (forall scalar mu :e K , forall x :e M , smulR (smulR x mu) scalar = smulR x (mulK mu scalar))) /\ (forall x :e M , smulR x (ring_one K (opposite_ring_multiplication mulK)) = x)) /\ (forall scalar mu :e K , forall x :e M , smulR x (addK scalar mu) = addM (smulR x scalar) (smulR x mu)) /\ (forall scalar :e K , forall x y :e M , smulR (addM x y) scalar = addM (smulR x scalar) (smulR y scalar)).
Axiom god1_right_modules_are_left_modules_over_opposite_ring : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , right_module K addK mulK M addM smulR -> left_module K addK (opposite_ring_multiplication mulK) M addM (fun scalar x => smulR x scalar).
Definition nonzero_support : set -> set -> (set -> set) -> set := fun I zero f => {i :e I|f i <> zero}.
Definition almost_all_zero : set -> set -> (set -> set) -> prop := fun I zero f => finite (nonzero_support I zero f).
Definition module_finitely_supported_sum : set -> (set -> set -> set) -> set -> (set -> set) -> set := fun M addM I f => ring_finite_sum M addM (nonzero_support I (module_zero M addM) f) f.
Axiom god1_abelian_finite_sum_in_natural : forall G , forall op : set -> set -> set , abelian_group G op -> forall n :e omega , forall f : set -> set , (forall i :e n , f i :e G) -> ring_finite_sum G op n f :e G.
Axiom god1_abelian_finite_sum_in : forall G , forall op : set -> set -> set , abelian_group G op -> forall X , finite X -> forall f : set -> set , (forall x :e X , f x :e G) -> ring_finite_sum G op X f :e G.
Axiom god1_abelian_finite_sum_adjoin : forall G , forall op : set -> set -> set , abelian_group G op -> forall X , finite X -> forall a , a /:e X -> forall f : set -> set , (forall z :e X :\/: {a} , f z :e G) -> ring_finite_sum G op (X :\/: {a}) f = op (ring_finite_sum G op X f) (f a).
Axiom god1_abelian_finite_sum_disjoint_union_zero : forall G , forall op : set -> set -> set , abelian_group G op -> forall C , finite C -> (forall z :e 0 , z /:e C) -> forall g : set -> set , (forall z :e C :\/: 0 , g z :e G) -> ring_finite_sum G op (C :\/: 0) g = op (ring_finite_sum G op C g) (ring_finite_sum G op 0 g).
Axiom god1_abelian_finite_sum_disjoint_union_step : forall G , forall op : set -> set -> set , abelian_group G op -> forall Y y , finite Y -> y /:e Y -> (forall C , finite C -> (forall z :e Y , z /:e C) -> forall g : set -> set , (forall z :e C :\/: Y , g z :e G) -> ring_finite_sum G op (C :\/: Y) g = op (ring_finite_sum G op C g) (ring_finite_sum G op Y g)) -> forall C , finite C -> (forall z :e Y :\/: {y} , z /:e C) -> forall g : set -> set , (forall z :e C :\/: (Y :\/: {y}) , g z :e G) -> ring_finite_sum G op (C :\/: (Y :\/: {y})) g = op (ring_finite_sum G op C g) (ring_finite_sum G op (Y :\/: {y}) g).
Axiom god1_abelian_finite_sum_disjoint_union : forall G , forall op : set -> set -> set , abelian_group G op -> forall A , finite A -> forall B , finite B -> (forall b :e B , b /:e A) -> forall f : set -> set , (forall z :e A :\/: B , f z :e G) -> ring_finite_sum G op (A :\/: B) f = op (ring_finite_sum G op A f) (ring_finite_sum G op B f).
Axiom god1_abelian_finite_sum_pointwise_add_zero : forall G , forall op : set -> set -> set , abelian_group G op -> forall f g : set -> set , (forall i :e 0 , f i :e G) -> (forall i :e 0 , g i :e G) -> ring_finite_sum G op 0 (fun i => op (f i) (g i)) = op (ring_finite_sum G op 0 f) (ring_finite_sum G op 0 g).
Axiom god1_abelian_finite_sum_pointwise_add_step : forall G , forall op : set -> set -> set , abelian_group G op -> forall f g : set -> set , forall n , nat_p n -> ((forall i :e n , f i :e G) -> (forall i :e n , g i :e G) -> ring_finite_sum G op n (fun i => op (f i) (g i)) = op (ring_finite_sum G op n f) (ring_finite_sum G op n g)) -> (forall i :e ordsucc n , f i :e G) -> (forall i :e ordsucc n , g i :e G) -> ring_finite_sum G op (ordsucc n) (fun i => op (f i) (g i)) = op (ring_finite_sum G op (ordsucc n) f) (ring_finite_sum G op (ordsucc n) g).
Axiom god1_abelian_finite_sum_pointwise_add : forall G , forall op : set -> set -> set , abelian_group G op -> forall n :e omega , forall f g : set -> set , (forall i :e n , f i :e G) -> (forall i :e n , g i :e G) -> ring_finite_sum G op n (fun i => op (f i) (g i)) = op (ring_finite_sum G op n f) (ring_finite_sum G op n g).
Axiom god1_abelian_finite_sum_pointwise_add_finite : forall G , forall op : set -> set -> set , abelian_group G op -> forall X , finite X -> forall f g : set -> set , (forall x :e X , f x :e G) -> (forall x :e X , g x :e G) -> ring_finite_sum G op X (fun x => op (f x) (g x)) = op (ring_finite_sum G op X f) (ring_finite_sum G op X g).
Axiom god1_abelian_finite_sum_zero_step : forall G , forall op : set -> set -> set , abelian_group G op -> forall X y , finite X -> y /:e X -> ring_finite_sum G op X (fun z => group_identity G op) = group_identity G op -> ring_finite_sum G op (X :\/: {y}) (fun z => group_identity G op) = group_identity G op.
Axiom god1_abelian_finite_sum_zero : forall G , forall op : set -> set -> set , abelian_group G op -> forall X , finite X -> ring_finite_sum G op X (fun z => group_identity G op) = group_identity G op.
Axiom god1_abelian_finite_sum_zero_extension : forall G , forall op : set -> set -> set , abelian_group G op -> forall X , finite X -> forall F , F c= X -> forall f : set -> set , (forall x :e X , f x :e G) -> (forall x :e X , x /:e F -> f x = group_identity G op) -> ring_finite_sum G op X f = ring_finite_sum G op F f.
Axiom god1_nonzero_support_subset : forall I zero , forall f : set -> set , nonzero_support I zero f c= I.
Axiom god1_not_in_nonzero_support : forall I zero , forall f : set -> set , forall i :e I , i /:e nonzero_support I zero f -> f i = zero.
Axiom god1_nonzero_support_pointwise_add_subset_union : forall G , forall op : set -> set -> set , abelian_group G op -> forall I , forall f g : set -> set , nonzero_support I (group_identity G op) (fun i => op (f i) (g i)) c= nonzero_support I (group_identity G op) f :\/: nonzero_support I (group_identity G op) g.
Axiom god1_module_finitely_supported_sum_add : forall M , forall addM : set -> set -> set , abelian_group M addM -> forall I , forall f g : set -> set , almost_all_zero I (module_zero M addM) f -> almost_all_zero I (module_zero M addM) g -> (forall i :e I , f i :e M) -> (forall i :e I , g i :e M) -> almost_all_zero I (module_zero M addM) (fun i => addM (f i) (g i)) /\ module_finitely_supported_sum M addM I (fun i => addM (f i) (g i)) = addM (module_finitely_supported_sum M addM I f) (module_finitely_supported_sum M addM I g).
Axiom god1_group_word_product_homomorphism_zero : forall G , forall opG : set -> set -> set , forall H , forall opH : set -> set -> set , forall phi : set -> set , group_homomorphism G opG H opH phi -> forall f : set -> set , phi (group_word_product G opG f 0) = group_word_product H opH (fun i => phi (f i)) 0.
Axiom god1_group_word_product_homomorphism_step : forall G , forall opG : set -> set -> set , forall H , forall opH : set -> set -> set , forall phi : set -> set , group_homomorphism G opG H opH phi -> forall f : set -> set , forall n , nat_p n -> ((forall i :e n , f i :e G) -> phi (group_word_product G opG f n) = group_word_product H opH (fun i => phi (f i)) n) -> (forall i :e ordsucc n , f i :e G) -> phi (group_word_product G opG f (ordsucc n)) = group_word_product H opH (fun i => phi (f i)) (ordsucc n).
Axiom god1_group_word_product_homomorphism : forall G , forall opG : set -> set -> set , forall H , forall opH : set -> set -> set , forall phi : set -> set , group_homomorphism G opG H opH phi -> forall f : set -> set , forall n :e omega , (forall i :e n , f i :e G) -> phi (group_word_product G opG f n) = group_word_product H opH (fun i => phi (f i)) n.
Axiom god1_group_homomorphism_finite_sum : forall G , forall opG : set -> set -> set , forall H , forall opH : set -> set -> set , forall phi : set -> set , group_homomorphism G opG H opH phi -> forall X , finite X -> forall f : set -> set , (forall x :e X , f x :e G) -> phi (ring_finite_sum G opG X f) = ring_finite_sum H opH X (fun x => phi (f x)).
Axiom god1_module_scalar_additive_group_homomorphism : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , left_module K addK mulK M addM smul -> forall scalar :e K , group_homomorphism M addM M addM (fun x => smul scalar x).
Axiom god1_nonzero_support_scalar_subset : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , left_module K addK mulK M addM smul -> forall scalar :e K , forall I , forall f : set -> set , nonzero_support I (module_zero M addM) (fun i => smul scalar (f i)) c= nonzero_support I (module_zero M addM) f.
Axiom god1_module_finitely_supported_sum_scalar : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , left_module K addK mulK M addM smul -> forall scalar :e K , forall I , forall f : set -> set , almost_all_zero I (module_zero M addM) f -> (forall i :e I , f i :e M) -> almost_all_zero I (module_zero M addM) (fun i => smul scalar (f i)) /\ module_finitely_supported_sum M addM I (fun i => smul scalar (f i)) = smul scalar (module_finitely_supported_sum M addM I f).
Axiom god1_abelian_finite_sum_singleton : forall G , forall op : set -> set -> set , abelian_group G op -> forall i , forall f : set -> set , f i :e G -> ring_finite_sum G op {i} f = f i.
Axiom god1_module_finitely_supported_sum_single : forall M , forall addM : set -> set -> set , abelian_group M addM -> forall I i , i :e I -> forall f : set -> set , (forall j :e I , f j :e M) -> (forall j :e I , j <> i -> f j = module_zero M addM) -> almost_all_zero I (module_zero M addM) f /\ module_finitely_supported_sum M addM I f = f i.
Definition module_kronecker_coefficient : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set := fun K addK mulK i j => if j = i then ring_one K mulK else ring_zero K addK.
Axiom god1_module_finitely_supported_sum_congr : forall M , forall addM : set -> set -> set , forall I , forall f g : set -> set , almost_all_zero I (module_zero M addM) f -> (forall i :e I , f i = g i) -> almost_all_zero I (module_zero M addM) g /\ module_finitely_supported_sum M addM I f = module_finitely_supported_sum M addM I g.
Axiom god1_abelian_finite_sum_in_subgroup : forall G , forall op : set -> set -> set , forall H , abelian_group G op -> subgroup G op H -> forall X , finite X -> forall f : set -> set , (forall x :e X , f x :e H) -> ring_finite_sum G op X f :e H.
Definition linear_representation : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> set -> (set -> set) -> prop := fun K addK mulK M addM smul I a x coeff => (forall i :e I , coeff i :e K) /\ almost_all_zero I (ring_zero K addK) coeff /\ x = module_finitely_supported_sum M addM I (fun i => smul (coeff i) (a i)).
Axiom god1_generator_linear_representation : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , left_module K addK mulK M addM smul -> (forall j :e I , a j :e M) -> forall i :e I , linear_representation K addK mulK M addM smul I a (a i) (module_kronecker_coefficient K addK mulK i).
Axiom god1_linear_representation_term_family_data : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , forall x , forall coeff : set -> set , left_module K addK mulK M addM smul -> (forall i :e I , a i :e M) -> linear_representation K addK mulK M addM smul I a x coeff -> (forall i :e I , smul (coeff i) (a i) :e M) /\ almost_all_zero I (module_zero M addM) (fun i => smul (coeff i) (a i)).
Axiom god1_linear_representation_add : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , forall x y , forall coeff eta : set -> set , left_module K addK mulK M addM smul -> (forall i :e I , a i :e M) -> linear_representation K addK mulK M addM smul I a x coeff -> linear_representation K addK mulK M addM smul I a y eta -> linear_representation K addK mulK M addM smul I a (addM x y) (fun i => addK (coeff i) (eta i)).
Axiom god1_linear_representation_scalar : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , forall x , forall coeff : set -> set , left_module K addK mulK M addM smul -> (forall i :e I , a i :e M) -> forall scalar :e K , linear_representation K addK mulK M addM smul I a x coeff -> linear_representation K addK mulK M addM smul I a (smul scalar x) (fun i => mulK scalar (coeff i)).
Definition linear_combination : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> set -> prop := fun K addK mulK M addM smul I a x => x :e M /\ (forall i :e I , a i :e M) /\ exists coeff : set -> set , linear_representation K addK mulK M addM smul I a x coeff.
Axiom god1_zero_linear_representation_finite : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , left_module K addK mulK M addM smul -> finite I -> (forall i :e I , a i :e M) -> linear_representation K addK mulK M addM smul I a (module_zero M addM) (fun i => ring_zero K addK).
Axiom god1_zero_linear_combination_finite : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , left_module K addK mulK M addM smul -> finite I -> (forall i :e I , a i :e M) -> linear_combination K addK mulK M addM smul I a (module_zero M addM).
Axiom god1_generator_linear_combination : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , left_module K addK mulK M addM smul -> (forall j :e I , a j :e M) -> forall i :e I , linear_combination K addK mulK M addM smul I a (a i).
Axiom god1_linear_combination_add : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , forall x y , left_module K addK mulK M addM smul -> (forall i :e I , a i :e M) -> linear_combination K addK mulK M addM smul I a x -> linear_combination K addK mulK M addM smul I a y -> linear_combination K addK mulK M addM smul I a (addM x y).
Axiom god1_linear_combination_scalar : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , forall x , left_module K addK mulK M addM smul -> (forall i :e I , a i :e M) -> forall scalar :e K , linear_combination K addK mulK M addM smul I a x -> linear_combination K addK mulK M addM smul I a (smul scalar x).
Axiom god1_linear_combination_two_scalar : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , forall x y , left_module K addK mulK M addM smul -> (forall i :e I , a i :e M) -> forall scalar mu :e K , linear_combination K addK mulK M addM smul I a x -> linear_combination K addK mulK M addM smul I a y -> linear_combination K addK mulK M addM smul I a (addM (smul scalar x) (smul mu y)).
Axiom god1_linear_combination_in_submodule : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , forall x , forall N , left_module K addK mulK M addM smul -> submodule K addK mulK M addM smul N -> (forall i :e I , a i :e N) -> linear_combination K addK mulK M addM smul I a x -> x :e N.
Definition submodule_generated_by_family : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> set := fun K addK mulK M addM smul I a => {x :e M|linear_combination K addK mulK M addM smul I a x}.
Axiom god1_s11_theorem1_linear_combinations_form_generated_submodule : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall n :e omega , forall a : set -> set , left_module K addK mulK M addM smul -> (forall i :e n , a i :e M) -> submodule K addK mulK M addM smul (submodule_generated_by_family K addK mulK M addM smul n a) /\ (forall i :e n , a i :e submodule_generated_by_family K addK mulK M addM smul n a) /\ (forall N , submodule K addK mulK M addM smul N -> (forall i :e n , a i :e N) -> submodule_generated_by_family K addK mulK M addM smul n a c= N).
Definition generating_family : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> prop := fun K addK mulK M addM smul I a => (forall i :e I , a i :e M) /\ submodule_generated_by_family K addK mulK M addM smul I a = M.
Definition finitely_generated_module : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K addK mulK M addM smul => left_module K addK mulK M addM smul /\ exists I , finite I /\ exists a : set -> set , generating_family K addK mulK M addM smul I a.
Definition finite_dimensional_vector_space : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K addK mulK M addM smul => left_vector_space K addK mulK M addM smul /\ finitely_generated_module K addK mulK M addM smul.
Definition linear_relation : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> (set -> set) -> prop := fun K addK mulK M addM smul I a coeff => linear_representation K addK mulK M addM smul I a (module_zero M addM) coeff.
Definition linearly_independent_family : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> prop := fun K addK mulK M addM smul I a => left_module K addK mulK M addM smul /\ (forall i :e I , a i :e M) /\ forall coeff : set -> set , linear_relation K addK mulK M addM smul I a coeff -> forall i :e I , coeff i = ring_zero K addK.
Axiom god1_linear_representation_value_congr : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a coeff : set -> set , forall x y , x = y -> linear_representation K addK mulK M addM smul I a x coeff -> linear_representation K addK mulK M addM smul I a y coeff.
Axiom god1_linearly_independent_representation_unique : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , forall x , forall coeff eta : set -> set , linearly_independent_family K addK mulK M addM smul I a -> x :e M -> linear_representation K addK mulK M addM smul I a x coeff -> linear_representation K addK mulK M addM smul I a x eta -> forall i :e I , coeff i = eta i.
Axiom god1_unique_representation_at_vector_implies_independent : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , forall x , left_module K addK mulK M addM smul -> (forall i :e I , a i :e M) -> x :e M -> (exists theta : set -> set , linear_representation K addK mulK M addM smul I a x theta /\ forall eta : set -> set , linear_representation K addK mulK M addM smul I a x eta -> forall i :e I , eta i = theta i) -> linearly_independent_family K addK mulK M addM smul I a.
Axiom god1_s11_theorem2_unique_coordinates_iff_independent : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall n :e omega , forall a : set -> set , forall x , left_module K addK mulK M addM smul -> linear_combination K addK mulK M addM smul n a x -> ((exists coeff : set -> set , linear_representation K addK mulK M addM smul n a x coeff /\ forall eta : set -> set , linear_representation K addK mulK M addM smul n a x eta -> forall i :e n , eta i = coeff i) <-> linearly_independent_family K addK mulK M addM smul n a).
Axiom god1_linear_representation_coefficient_congr : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , forall x , forall coeff eta : set -> set , left_module K addK mulK M addM smul -> (forall i :e I , a i :e M) -> linear_representation K addK mulK M addM smul I a x coeff -> (forall i :e I , coeff i = eta i) -> linear_representation K addK mulK M addM smul I a x eta.
Definition module_basis : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> prop := fun K addK mulK M addM smul I a => linearly_independent_family K addK mulK M addM smul I a /\ generating_family K addK mulK M addM smul I a.
Definition finitely_generated_free_module : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K addK mulK M addM smul => left_module K addK mulK M addM smul /\ exists I , finite I /\ exists a : set -> set , module_basis K addK mulK M addM smul I a.
Definition free_module : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K addK mulK M addM smul => left_module K addK mulK M addM smul /\ exists I , exists a : set -> set , module_basis K addK mulK M addM smul I a.
Definition basis_coordinates : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> set -> set := fun K addK mulK M addM smul I a x => Eps_i (fun coeff => coeff :e K :^: I /\ linear_representation K addK mulK M addM smul I a x (fun i => coeff i)).
Definition basis_coordinate_function : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> set -> set -> set := fun K addK mulK M addM smul I a i x => basis_coordinates K addK mulK M addM smul I a x i.
Axiom god1_basis_coordinate_representation_and_uniqueness : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , module_basis K addK mulK M addM smul I a -> forall x :e M , linear_representation K addK mulK M addM smul I a x (fun i => basis_coordinates K addK mulK M addM smul I a x i) /\ forall coeff : set -> set , linear_representation K addK mulK M addM smul I a x coeff -> forall i :e I , coeff i = basis_coordinates K addK mulK M addM smul I a x i.
Axiom god1_basis_coordinate_add : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , module_basis K addK mulK M addM smul I a -> forall i :e I , forall x y :e M , basis_coordinate_function K addK mulK M addM smul I a i (addM x y) = addK (basis_coordinate_function K addK mulK M addM smul I a i x) (basis_coordinate_function K addK mulK M addM smul I a i y).
Axiom god1_basis_coordinate_scalar : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , module_basis K addK mulK M addM smul I a -> forall i :e I , forall scalar :e K , forall x :e M , basis_coordinate_function K addK mulK M addM smul I a i (smul scalar x) = mulK scalar (basis_coordinate_function K addK mulK M addM smul I a i x).
Axiom god1_basis_unique_coordinates_and_coordinate_linearity : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , module_basis K addK mulK M addM smul I a -> (forall x :e M , linear_representation K addK mulK M addM smul I a x (fun i => basis_coordinates K addK mulK M addM smul I a x i) /\ (forall coeff : set -> set , linear_representation K addK mulK M addM smul I a x coeff -> forall i :e I , coeff i = basis_coordinates K addK mulK M addM smul I a x i)) /\ (forall i :e I , forall x y :e M , basis_coordinate_function K addK mulK M addM smul I a i (addM x y) = addK (basis_coordinate_function K addK mulK M addM smul I a i x) (basis_coordinate_function K addK mulK M addM smul I a i y)) /\ (forall i :e I , forall scalar :e K , forall x :e M , basis_coordinate_function K addK mulK M addM smul I a i (smul scalar x) = mulK scalar (basis_coordinate_function K addK mulK M addM smul I a i x)).
Definition canonical_module_basis_vector : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set := fun K addK mulK I i => fun j :e I => if j = i then ring_one K mulK else ring_zero K addK.
Axiom god1_ring_left_regular_module : forall K , forall add mul : set -> set -> set , ring K add mul -> left_module K add mul K add mul.
Axiom god1_module_power_evaluation_additive_homomorphism : forall K , forall addK mulK : set -> set -> set , forall I , ring K addK mulK -> forall j :e I , group_homomorphism (K :^: I) (module_power_addition I addK) K addK (fun x => x j).
Axiom god1_canonical_module_basis_vector_in : forall K , forall addK mulK : set -> set -> set , forall I , ring K addK mulK -> forall i , canonical_module_basis_vector K addK mulK I i :e K :^: I.
Axiom god1_canonical_module_basis_vector_eval : forall K , forall addK mulK : set -> set -> set , forall I i , forall j :e I , canonical_module_basis_vector K addK mulK I i j = if j = i then ring_one K mulK else ring_zero K addK.
Axiom god1_canonical_module_sum_evaluation : forall K , forall addK mulK : set -> set -> set , forall I , ring K addK mulK -> finite I -> forall coeff : set -> set , (forall i :e I , coeff i :e K) -> forall j :e I , module_finitely_supported_sum (K :^: I) (module_power_addition I addK) I (fun i => module_power_left_scalar I mulK (coeff i) (canonical_module_basis_vector K addK mulK I i)) j = coeff j.
Axiom god1_canonical_linear_representation : forall K , forall addK mulK : set -> set -> set , forall I , ring K addK mulK -> finite I -> forall x :e K :^: I , linear_representation K addK mulK (K :^: I) (module_power_addition I addK) (module_power_left_scalar I mulK) I (canonical_module_basis_vector K addK mulK I) x (fun i => x i).
Axiom god1_canonical_basis_of_finite_module_power : forall K , forall addK mulK : set -> set -> set , forall n :e omega , ring K addK mulK -> module_basis K addK mulK (K :^: n) (module_power_addition n addK) (module_power_left_scalar n mulK) n (canonical_module_basis_vector K addK mulK n).
Axiom god1_s11_theorem3_finite_dimensional_vector_space_has_basis : (forall K0 , forall add0 mul0 : set -> set -> set , forall M0 , forall addM0 smul0 : set -> set -> set , finite_dimensional_vector_space K0 add0 mul0 M0 addM0 smul0 -> exists I , finite I /\ exists a : set -> set , module_basis K0 add0 mul0 M0 addM0 smul0 I a) -> forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , finite_dimensional_vector_space K addK mulK M addM smul -> exists I , finite I /\ exists a : set -> set , module_basis K addK mulK M addM smul I a.
Definition module_homomorphism : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> prop := fun K addK mulK L addL smulL M addM smulM f => left_module K addK mulK L addL smulL /\ left_module K addK mulK M addM smulM /\ (forall x :e L , f x :e M) /\ forall x y :e L , forall scalar mu :e K , f (addL (smulL scalar x) (smulL mu y)) = addM (smulM scalar (f x)) (smulM mu (f y)).
Definition module_isomorphism : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> prop := fun K addK mulK L addL smulL M addM smulM f => module_homomorphism K addK mulK L addL smulL M addM smulM f /\ bij L M f.
Definition isomorphic_modules : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K addK mulK L addL smulL M addM smulM => exists f : set -> set , module_isomorphism K addK mulK L addL smulL M addM smulM f.
Definition module_endomorphism : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> prop := fun K addK mulK M addM smul f => module_homomorphism K addK mulK M addM smul M addM smul f.
Definition module_automorphism : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> prop := fun K addK mulK M addM smul f => module_isomorphism K addK mulK M addM smul M addM smul f.
Axiom god1_module_homomorphism_additive_and_homogeneous_iff_linear : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , left_module K addK mulK L addL smulL -> left_module K addK mulK M addM smulM -> (forall x :e L , f x :e M) -> (module_homomorphism K addK mulK L addL smulL M addM smulM f <-> (forall x y :e L , f (addL x y) = addM (f x) (f y)) /\ (forall scalar :e K , forall x :e L , f (smulL scalar x) = smulM scalar (f x))).
Axiom god1_module_homomorphism_additive_group_homomorphism : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , module_homomorphism K addK mulK L addL smulL M addM smulM f -> group_homomorphism L addL M addM f.
Axiom god1_group_homomorphism_module_finitely_supported_sum : forall G , forall opG : set -> set -> set , forall H , forall opH : set -> set -> set , forall phi : set -> set , group_homomorphism G opG H opH phi -> abelian_group H opH -> forall I , forall f : set -> set , almost_all_zero I (group_identity G opG) f -> (forall i :e I , f i :e G) -> phi (module_finitely_supported_sum G opG I f) = module_finitely_supported_sum H opH I (fun i => phi (f i)).
Axiom god1_module_homomorphism_preserves_zero_and_linear_combinations : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , module_homomorphism K addK mulK L addL smulL M addM smulM f -> f (module_zero L addL) = module_zero M addM /\ forall I , forall a : set -> set , forall coeff : set -> set , (forall i :e I , a i :e L /\ coeff i :e K) -> almost_all_zero I (ring_zero K addK) coeff -> f (module_finitely_supported_sum L addL I (fun i => smulL (coeff i) (a i))) = module_finitely_supported_sum M addM I (fun i => smulM (coeff i) (f (a i))).
Axiom god1_module_homomorphism_composite : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall N , forall addN smulN : set -> set -> set , forall f g : set -> set , module_homomorphism K addK mulK L addL smulL M addM smulM f -> module_homomorphism K addK mulK M addM smulM N addN smulN g -> module_homomorphism K addK mulK L addL smulL N addN smulN (fun x => g (f x)).
Axiom god1_module_isomorphism_inverse : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , module_isomorphism K addK mulK L addL smulL M addM smulM f -> module_isomorphism K addK mulK M addM smulM L addL smulL (inv L f).
Axiom god1_module_isomorphism_composite : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall N , forall addN smulN : set -> set -> set , forall f g : set -> set , module_isomorphism K addK mulK L addL smulL M addM smulM f -> module_isomorphism K addK mulK M addM smulM N addN smulN g -> module_isomorphism K addK mulK L addL smulL N addN smulN (fun x => g (f x)).
Axiom god1_s12_theorem1_composition_and_inverse_linear : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall N , forall addN smulN : set -> set -> set , forall f g : set -> set , module_homomorphism K addK mulK L addL smulL M addM smulM f -> module_homomorphism K addK mulK M addM smulM N addN smulN g -> module_homomorphism K addK mulK L addL smulL N addN smulN (fun x => g (f x)) /\ (module_isomorphism K addK mulK L addL smulL M addM smulM f -> module_isomorphism K addK mulK M addM smulM L addL smulL (inv L f)) /\ (module_isomorphism K addK mulK L addL smulL M addM smulM f -> module_isomorphism K addK mulK M addM smulM N addN smulN g -> module_isomorphism K addK mulK L addL smulL N addN smulN (fun x => g (f x))).
Definition module_homomorphism_kernel : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> set := fun K addK mulK L addL smulL M addM smulM f => {x :e L|f x = module_zero M addM}.
Definition module_homomorphism_image : set -> (set -> set) -> set := fun L f => {f x|x :e L}.
Axiom god1_module_homomorphism_domain_module : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , module_homomorphism K addK mulK L addL smulL M addM smulM f -> left_module K addK mulK L addL smulL.
Axiom god1_module_homomorphism_codomain_module : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , module_homomorphism K addK mulK L addL smulL M addM smulM f -> left_module K addK mulK M addM smulM.
Axiom god1_module_homomorphism_maps_into : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , module_homomorphism K addK mulK L addL smulL M addM smulM f -> forall x :e L , f x :e M.
Axiom god1_module_homomorphism_homogeneous : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , module_homomorphism K addK mulK L addL smulL M addM smulM f -> forall scalar :e K , forall x :e L , f (smulL scalar x) = smulM scalar (f x).
Axiom god1_group_image_two_representatives : forall A , forall f : set -> set , forall u v :e group_image_of_subset A f , exists x y :e A , u = f x /\ v = f y.
Axiom god1_module_homomorphism_image_scalar_closed : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , module_homomorphism K addK mulK L addL smulL M addM smulM f -> forall A , submodule K addK mulK L addL smulL A -> forall scalar :e K , forall u :e group_image_of_subset A f , smulM scalar u :e group_image_of_subset A f.
Axiom god1_module_homomorphism_image_submodule : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , module_homomorphism K addK mulK L addL smulL M addM smulM f -> forall A , submodule K addK mulK L addL smulL A -> submodule K addK mulK M addM smulM (group_image_of_subset A f).
Axiom god1_module_homomorphism_preimage_scalar_closed : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , module_homomorphism K addK mulK L addL smulL M addM smulM f -> forall B , submodule K addK mulK M addM smulM B -> forall scalar :e K , forall x :e group_preimage_of_subset L B f , smulL scalar x :e group_preimage_of_subset L B f.
Axiom god1_module_homomorphism_preimage_submodule : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , module_homomorphism K addK mulK L addL smulL M addM smulM f -> forall B , submodule K addK mulK M addM smulM B -> submodule K addK mulK L addL smulL (group_preimage_of_subset L B f).
Axiom god1_s12_theorem2_images_and_preimages_of_submodules : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , module_homomorphism K addK mulK L addL smulL M addM smulM f -> (forall A , submodule K addK mulK L addL smulL A -> submodule K addK mulK M addM smulM (group_image_of_subset A f)) /\ (forall B , submodule K addK mulK M addM smulM B -> submodule K addK mulK L addL smulL (group_preimage_of_subset L B f)).
Axiom god1_module_is_submodule_of_itself : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , left_module K addK mulK M addM smul -> submodule K addK mulK M addM smul M.
Axiom god1_module_homomorphism_kernel_submodule : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , module_homomorphism K addK mulK L addL smulL M addM smulM f -> submodule K addK mulK L addL smulL (module_homomorphism_kernel K addK mulK L addL smulL M addM smulM f).
Axiom god1_module_homomorphism_kernel_image_and_injectivity : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , module_homomorphism K addK mulK L addL smulL M addM smulM f -> submodule K addK mulK L addL smulL (module_homomorphism_kernel K addK mulK L addL smulL M addM smulM f) /\ submodule K addK mulK M addM smulM (module_homomorphism_image L f) /\ (inj L M f <-> module_homomorphism_kernel K addK mulK L addL smulL M addM smulM f = {module_zero L addL}).
Axiom god1_module_basis_domain_module : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall I , forall a : set -> set , module_basis K addK mulK L addL smulL I a -> left_module K addK mulK L addL smulL.
Axiom god1_module_basis_vectors_map_into : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall I , forall a : set -> set , module_basis K addK mulK L addL smulL I a -> forall i :e I , a i :e L.
Axiom god1_linear_representation_canonical_sum : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a coeff : set -> set , left_module K addK mulK M addM smul -> (forall i :e I , a i :e M) -> (forall i :e I , coeff i :e K) -> almost_all_zero I (ring_zero K addK) coeff -> module_finitely_supported_sum M addM I (fun i => smul (coeff i) (a i)) :e M /\ linear_representation K addK mulK M addM smul I a (module_finitely_supported_sum M addM I (fun i => smul (coeff i) (a i))) coeff.
Axiom god1_linear_representation_family_congr : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a b : set -> set , forall x , forall coeff : set -> set , left_module K addK mulK M addM smul -> (forall i :e I , a i :e M) -> linear_representation K addK mulK M addM smul I a x coeff -> (forall i :e I , a i = b i) -> linear_representation K addK mulK M addM smul I b x coeff.
Axiom god1_module_homomorphism_maps_linear_representation : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , forall I , forall a : set -> set , forall x , forall coeff : set -> set , module_homomorphism K addK mulK L addL smulL M addM smulM f -> (forall i :e I , a i :e L) -> linear_representation K addK mulK L addL smulL I a x coeff -> linear_representation K addK mulK M addM smulM I (fun i => f (a i)) (f x) coeff.
Axiom god1_generating_family_of_all_linear_combinations : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall c : set -> set , (forall i :e I , c i :e M) -> (forall y :e M , linear_combination K addK mulK M addM smul I c y) -> generating_family K addK mulK M addM smul I c.
Definition god1_basis_induced_linear_map : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> set -> set := fun K addK mulK L addL smulL I a M addM smulM c x => module_finitely_supported_sum M addM I (fun i => smulM (basis_coordinates K addK mulK L addL smulL I a x i) (c i)).
Axiom god1_basis_induced_linear_map_representation : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall I , forall a : set -> set , forall M , forall addM smulM : set -> set -> set , forall c : set -> set , module_basis K addK mulK L addL smulL I a -> left_module K addK mulK M addM smulM -> (forall i :e I , c i :e M) -> forall x :e L , god1_basis_induced_linear_map K addK mulK L addL smulL I a M addM smulM c x :e M /\ linear_representation K addK mulK M addM smulM I c (god1_basis_induced_linear_map K addK mulK L addL smulL I a M addM smulM c x) (fun i => basis_coordinates K addK mulK L addL smulL I a x i).
Axiom god1_basis_induced_linear_map_homomorphism : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall I , forall a : set -> set , forall M , forall addM smulM : set -> set -> set , forall c : set -> set , module_basis K addK mulK L addL smulL I a -> left_module K addK mulK M addM smulM -> (forall i :e I , c i :e M) -> module_homomorphism K addK mulK L addL smulL M addM smulM (god1_basis_induced_linear_map K addK mulK L addL smulL I a M addM smulM c).
Axiom god1_basis_induced_linear_map_on_basis : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall I , forall a : set -> set , forall M , forall addM smulM : set -> set -> set , forall c : set -> set , module_basis K addK mulK L addL smulL I a -> left_module K addK mulK M addM smulM -> (forall i :e I , c i :e M) -> forall i :e I , god1_basis_induced_linear_map K addK mulK L addL smulL I a M addM smulM c (a i) = c i.
Axiom god1_basis_induced_linear_map_injective_iff_independent : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall I , forall a : set -> set , forall M , forall addM smulM : set -> set -> set , forall c : set -> set , module_basis K addK mulK L addL smulL I a -> left_module K addK mulK M addM smulM -> (forall i :e I , c i :e M) -> (inj L M (god1_basis_induced_linear_map K addK mulK L addL smulL I a M addM smulM c) <-> linearly_independent_family K addK mulK M addM smulM I c).
Axiom god1_basis_induced_linear_map_surjective_iff_generating : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall I , forall a : set -> set , forall M , forall addM smulM : set -> set -> set , forall c : set -> set , module_basis K addK mulK L addL smulL I a -> left_module K addK mulK M addM smulM -> (forall i :e I , c i :e M) -> (surj L M (god1_basis_induced_linear_map K addK mulK L addL smulL I a M addM smulM c) <-> generating_family K addK mulK M addM smulM I c).
Axiom god1_basis_induced_linear_map_unique : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall I , forall a : set -> set , forall M , forall addM smulM : set -> set -> set , forall c : set -> set , forall g : set -> set , module_basis K addK mulK L addL smulL I a -> left_module K addK mulK M addM smulM -> (forall i :e I , c i :e M) -> module_homomorphism K addK mulK L addL smulL M addM smulM g -> (forall i :e I , g (a i) = c i) -> forall x :e L , g x = god1_basis_induced_linear_map K addK mulK L addL smulL I a M addM smulM c x.
Axiom god1_s12_theorem3_linear_map_from_basis : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall I , forall a c : set -> set , module_basis K addK mulK L addL smulL I a -> left_module K addK mulK M addM smulM -> (forall i :e I , c i :e M) -> exists f : set -> set , module_homomorphism K addK mulK L addL smulL M addM smulM f /\ (forall i :e I , f (a i) = c i) /\ (forall g : set -> set , module_homomorphism K addK mulK L addL smulL M addM smulM g -> (forall i :e I , g (a i) = c i) -> forall x :e L , g x = f x) /\ (inj L M f <-> linearly_independent_family K addK mulK M addM smulM I c) /\ (surj L M f <-> generating_family K addK mulK M addM smulM I c).
Axiom god1_module_finitely_supported_sum_finite_index : forall M , forall addM : set -> set -> set , abelian_group M addM -> forall I , finite I -> forall f : set -> set , (forall i :e I , f i :e M) -> module_finitely_supported_sum M addM I f = ring_finite_sum M addM I f.
Axiom god1_linear_representation_reindex_bijection : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I J , forall phi : set -> set , forall a : set -> set , forall x , forall coeff : set -> set , left_module K addK mulK M addM smul -> finite I -> finite J -> bij J I phi -> (forall i :e I , a i :e M) -> linear_representation K addK mulK M addM smul I a x coeff -> linear_representation K addK mulK M addM smul J (fun j => a (phi j)) x (fun j => coeff (phi j)).
Axiom god1_generating_family_reindex_bijection : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I J , forall phi : set -> set , forall a : set -> set , left_module K addK mulK M addM smul -> finite I -> finite J -> bij J I phi -> generating_family K addK mulK M addM smul I a -> generating_family K addK mulK M addM smul J (fun j => a (phi j)).
Axiom god1_linearly_independent_family_reindex_bijection : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I J , forall phi : set -> set , forall a : set -> set , finite I -> finite J -> bij J I phi -> linearly_independent_family K addK mulK M addM smul I a -> linearly_independent_family K addK mulK M addM smul J (fun j => a (phi j)).
Axiom god1_module_basis_reindex_bijection : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I J , forall phi : set -> set , forall a : set -> set , finite I -> finite J -> bij J I phi -> module_basis K addK mulK M addM smul I a -> module_basis K addK mulK M addM smul J (fun j => a (phi j)).
Axiom god1_injection_pointwise_transfer : forall X Y , forall f g : set -> set , (forall x :e X , f x = g x) -> (forall x :e X , g x = f x) -> inj X Y f -> inj X Y g.
Axiom god1_surjection_pointwise_transfer : forall X Y , forall f g : set -> set , (forall x :e X , f x = g x) -> (forall x :e X , g x = f x) -> surj X Y f -> surj X Y g.
Axiom god1_s12_corollary1_free_module_iff_isomorphic_to_power : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulM : set -> set -> set , left_module K addK mulK M addM smulM -> (finitely_generated_free_module K addK mulK M addM smulM <-> exists n :e omega , isomorphic_modules K addK mulK (K :^: n) (module_power_addition n addK) (module_power_left_scalar n mulK) M addM smulM).
Axiom god1_surjective_module_homomorphism_image_generating : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , forall I , forall a : set -> set , module_homomorphism K addK mulK L addL smulL M addM smulM f -> surj L M f -> generating_family K addK mulK L addL smulL I a -> generating_family K addK mulK M addM smulM I (fun i => f (a i)).
Axiom god1_surjective_image_finitely_generated_module : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , finitely_generated_module K addK mulK L addL smulL -> module_homomorphism K addK mulK L addL smulL M addM smulM f -> surj L M f -> finitely_generated_module K addK mulK M addM smulM.
Axiom god1_finitely_generated_module_quotient_of_finite_power : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulM : set -> set -> set , finitely_generated_module K addK mulK M addM smulM -> exists n :e omega , exists f : set -> set , module_homomorphism K addK mulK (K :^: n) (module_power_addition n addK) (module_power_left_scalar n mulK) M addM smulM f /\ surj (K :^: n) M f.
Axiom god1_finite_module_power_finitely_generated : forall K , forall addK mulK : set -> set -> set , forall n :e omega , ring K addK mulK -> finitely_generated_module K addK mulK (K :^: n) (module_power_addition n addK) (module_power_left_scalar n mulK).
Axiom god1_s12_corollary2_finitely_generated_iff_quotient_of_power : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulM : set -> set -> set , left_module K addK mulK M addM smulM -> (finitely_generated_module K addK mulK M addM smulM <-> exists n :e omega , exists f : set -> set , module_homomorphism K addK mulK (K :^: n) (module_power_addition n addK) (module_power_left_scalar n mulK) M addM smulM f /\ surj (K :^: n) M f).
Definition module_homomorphism_space : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set := fun K addK mulK L addL smulL M addM smulM => {f :e M :^: L|module_homomorphism K addK mulK L addL smulL M addM smulM (fun x => f x)}.
Definition module_homomorphism_addition : set -> (set -> set -> set) -> set -> set -> set := fun L addM f g => fun x :e L => addM (f x) (g x).
Definition module_homomorphism_scalar : set -> (set -> set -> set) -> set -> set -> set := fun L smul scalar f => fun x :e L => smul scalar (f x).
Definition module_homomorphism_zero : set -> set -> (set -> set -> set) -> set := fun L M addM => fun x :e L => module_zero M addM.
Definition module_homomorphism_negation : set -> set -> (set -> set -> set) -> set -> set := fun L M addM f => fun x :e L => module_negation M addM (f x).
Axiom god1_module_homomorphism_addition_eval : forall L , forall addM : set -> set -> set , forall f g x , x :e L -> module_homomorphism_addition L addM f g x = addM (f x) (g x).
Axiom god1_module_homomorphism_scalar_eval : forall L , forall smul : set -> set -> set , forall scalar f x , x :e L -> module_homomorphism_scalar L smul scalar f x = smul scalar (f x).
Axiom god1_module_homomorphism_zero_eval : forall L M , forall addM : set -> set -> set , forall x , x :e L -> module_homomorphism_zero L M addM x = module_zero M addM.
Axiom god1_module_homomorphism_negation_eval : forall L M , forall addM : set -> set -> set , forall f x , x :e L -> module_homomorphism_negation L M addM f x = module_negation M addM (f x).
Axiom god1_zero_module_homomorphism : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , left_module K addK mulK L addL smulL -> left_module K addK mulK M addM smulM -> module_homomorphism K addK mulK L addL smulL M addM smulM (fun x => module_homomorphism_zero L M addM x).
Axiom god1_negated_module_homomorphism : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f , left_module K addK mulK L addL smulL -> left_module K addK mulK M addM smulM -> module_homomorphism K addK mulK L addL smulL M addM smulM (fun x => f x) -> module_homomorphism K addK mulK L addL smulL M addM smulM (fun x => module_homomorphism_negation L M addM f x).
Axiom god1_module_homomorphism_pointwise_sum_linear : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f g , left_module K addK mulK L addL smulL -> left_module K addK mulK M addM smulM -> module_homomorphism K addK mulK L addL smulL M addM smulM (fun x => f x) -> module_homomorphism K addK mulK L addL smulL M addM smulM (fun x => g x) -> module_homomorphism K addK mulK L addL smulL M addM smulM (fun x => module_homomorphism_addition L addM f g x).
Axiom god1_module_homomorphism_pointwise_scalar_linear : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall scalar f , left_module K addK mulK L addL smulL -> left_module K addK mulK M addM smulM -> commutative_ring K addK mulK -> scalar :e K -> module_homomorphism K addK mulK L addL smulL M addM smulM (fun x => f x) -> module_homomorphism K addK mulK L addL smulL M addM smulM (fun x => module_homomorphism_scalar L smulM scalar f x).
Axiom god1_s13_theorem1_homomorphisms_form_additive_group : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , left_module K addK mulK L addL smulL -> left_module K addK mulK M addM smulM -> abelian_group (module_homomorphism_space K addK mulK L addL smulL M addM smulM) (module_homomorphism_addition L addM) /\ (commutative_ring K addK mulK -> left_module K addK mulK (module_homomorphism_space K addK mulK L addL smulL M addM smulM) (module_homomorphism_addition L addM) (module_homomorphism_scalar L smulM)).
Definition matrix_space : set -> set -> set -> set := fun K p q => K :^: (p :*: q).
Definition matrix_entry : set -> set -> set -> set := fun A i j => A (i,j).
Definition matrix_addition : set -> (set -> set -> set) -> set -> set -> set -> set -> set := fun K add p q A B => fun u :e p :*: q => add (A u) (B u).
Definition matrix_left_scalar : set -> (set -> set -> set) -> set -> set -> set -> set -> set := fun K mul p q scalar A => fun u :e p :*: q => mul scalar (A u).
Definition matrix_right_scalar : set -> (set -> set -> set) -> set -> set -> set -> set -> set := fun K mul p q A scalar => fun u :e p :*: q => mul (A u) scalar.
Definition matrix_multiplication : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set -> set -> set -> set := fun K add mul p q r A B => fun u :e p :*: r => ring_finite_sum K add q (fun j => mul (matrix_entry A (u 0) j) (matrix_entry B j (u 1))).
Definition unit_matrix : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set := fun K add mul n => fun u :e n :*: n => if u 0 = u 1 then ring_one K mul else ring_zero K add.
Definition right_module_basis : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> prop := fun K addK mulK M addM smulR I a => module_basis K addK (opposite_ring_multiplication mulK) M addM (fun scalar x => smulR x scalar) I a.
Definition right_module_homomorphism : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> prop := fun K addK mulK L addL smulL M addM smulM f => module_homomorphism K addK (opposite_ring_multiplication mulK) L addL (fun scalar x => smulL x scalar) M addM (fun scalar x => smulM x scalar) f.
Definition matrix_of_right_linear_map : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> (set -> set) -> (set -> set) -> (set -> set) -> set := fun K addK mulK L addL smulL M addM smulM q p a b f => fun u :e p :*: q => basis_coordinates K addK (opposite_ring_multiplication mulK) M addM (fun scalar x => smulM x scalar) p b (f (a (u 1))) (u 0).
Axiom god1_s12_section3_formula6_matrix_coordinates : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall q p :e omega , forall a b : set -> set , forall f : set -> set , right_module_basis K addK mulK L addL smulL q a -> right_module_basis K addK mulK M addM smulM p b -> right_module_homomorphism K addK mulK L addL smulL M addM smulM f -> forall i :e p , forall j :e q , basis_coordinates K addK (opposite_ring_multiplication mulK) M addM (fun scalar x => smulM x scalar) p b (f (a j)) i = matrix_entry (matrix_of_right_linear_map K addK mulK L addL smulL M addM smulM q p a b f) i j.
Axiom god1_finite_basis_vector_with_coordinates : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a coeff : set -> set , module_basis K addK mulK M addM smul I a -> finite I -> (forall i :e I , coeff i :e K) -> module_finitely_supported_sum M addM I (fun i => smul (coeff i) (a i)) :e M /\ forall i :e I , basis_coordinates K addK mulK M addM smul I a (module_finitely_supported_sum M addM I (fun j => smul (coeff j) (a j))) i = coeff i.
Axiom god1_basis_coordinate_in : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , module_basis K addK mulK M addM smul I a -> forall x :e M , forall i :e I , basis_coordinates K addK mulK M addM smul I a x i :e K.
Axiom god1_basis_coordinates_determine_vector : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , module_basis K addK mulK M addM smul I a -> forall x y :e M , (forall i :e I , basis_coordinates K addK mulK M addM smul I a x i = basis_coordinates K addK mulK M addM smul I a y i) -> x = y.
Axiom god1_module_homomorphism_pointwise_transfer : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f g : set -> set , left_module K addK mulK L addL smulL -> left_module K addK mulK M addM smulM -> module_homomorphism K addK mulK L addL smulL M addM smulM f -> (forall x :e L , g x :e M) -> (forall x :e L , g x = f x) -> module_homomorphism K addK mulK L addL smulL M addM smulM g.
Axiom god1_matrices_classify_maps_between_finite_free_right_modules : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall q p :e omega , forall a b : set -> set , right_module_basis K addK mulK L addL smulL q a -> right_module_basis K addK mulK M addM smulM p b -> bij (module_homomorphism_space K addK (opposite_ring_multiplication mulK) L addL (fun scalar x => smulL x scalar) M addM (fun scalar x => smulM x scalar)) (matrix_space K p q) (fun F => matrix_of_right_linear_map K addK mulK L addL smulL M addM smulM q p a b (fun x => F x)).
Axiom god1_matrix_of_right_linear_map_in : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall q p , forall a b : set -> set , forall f : set -> set , right_module_basis K addK mulK L addL smulL q a -> right_module_basis K addK mulK M addM smulM p b -> right_module_homomorphism K addK mulK L addL smulL M addM smulM f -> matrix_of_right_linear_map K addK mulK L addL smulL M addM smulM q p a b f :e matrix_space K p q.
Definition god1_right_basis_transport_map : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> set -> set := fun K addK mulK M addM smulR n a => god1_basis_induced_linear_map K addK (opposite_ring_multiplication mulK) (K :^: n) (module_power_addition n addK) (module_power_left_scalar n (opposite_ring_multiplication mulK)) n (canonical_module_basis_vector K addK (opposite_ring_multiplication mulK) n) M addM (fun scalar x => smulR x scalar) a.
Definition god1_right_basis_transport_of_map : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> (set -> set) -> (set -> set) -> (set -> set) -> set -> set := fun K addK mulK L addL smulL M addM smulM q p a b f => fun x => inv (K :^: p) (god1_right_basis_transport_map K addK mulK M addM smulM p b) (f (god1_right_basis_transport_map K addK mulK L addL smulL q a x)).
Axiom god1_basis_coordinates_preserved_by_basis_map : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall I , forall a b : set -> set , forall u : set -> set , module_basis K addK mulK L addL smulL I a -> module_basis K addK mulK M addM smulM I b -> module_homomorphism K addK mulK L addL smulL M addM smulM u -> (forall i :e I , u (a i) = b i) -> forall x :e L , forall i :e I , basis_coordinates K addK mulK L addL smulL I a x i = basis_coordinates K addK mulK M addM smulM I b (u x) i.
Axiom god1_s12_remark2_matrix_transport_to_canonical_bases : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall q p :e omega , forall a b : set -> set , forall f : set -> set , right_module_basis K addK mulK L addL smulL q a -> right_module_basis K addK mulK M addM smulM p b -> right_module_homomorphism K addK mulK L addL smulL M addM smulM f -> exists u v fbar : set -> set , module_isomorphism K addK (opposite_ring_multiplication mulK) (K :^: q) (module_power_addition q addK) (fun scalar x => module_power_left_scalar q (opposite_ring_multiplication mulK) scalar x) L addL (fun scalar x => smulL x scalar) u /\ module_isomorphism K addK (opposite_ring_multiplication mulK) (K :^: p) (module_power_addition p addK) (fun scalar x => module_power_left_scalar p (opposite_ring_multiplication mulK) scalar x) M addM (fun scalar x => smulM x scalar) v /\ (forall i :e q , u (canonical_module_basis_vector K addK (opposite_ring_multiplication mulK) q i) = a i) /\ (forall i :e p , v (canonical_module_basis_vector K addK (opposite_ring_multiplication mulK) p i) = b i) /\ (forall x :e K :^: q , fbar x = inv (K :^: p) v (f (u x))) /\ matrix_of_right_linear_map K addK mulK L addL smulL M addM smulM q p a b f = matrix_of_right_linear_map K addK mulK (K :^: q) (module_power_addition q addK) (fun x scalar => module_power_left_scalar q (opposite_ring_multiplication mulK) scalar x) (K :^: p) (module_power_addition p addK) (fun x scalar => module_power_left_scalar p (opposite_ring_multiplication mulK) scalar x) q p (canonical_module_basis_vector K addK (opposite_ring_multiplication mulK) q) (canonical_module_basis_vector K addK (opposite_ring_multiplication mulK) p) fbar.
Axiom god1_s13_theorem2_matrix_of_sum : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall q p :e omega , forall a b : set -> set , forall f g : set -> set , right_module_basis K addK mulK L addL smulL q a -> right_module_basis K addK mulK M addM smulM p b -> right_module_homomorphism K addK mulK L addL smulL M addM smulM f -> right_module_homomorphism K addK mulK L addL smulL M addM smulM g -> matrix_of_right_linear_map K addK mulK L addL smulL M addM smulM q p a b (fun x => addM (f x) (g x)) = matrix_addition K addK p q (matrix_of_right_linear_map K addK mulK L addL smulL M addM smulM q p a b f) (matrix_of_right_linear_map K addK mulK L addL smulL M addM smulM q p a b g).
Definition module_endomorphism_ring : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set := fun K addK mulK M addM smul => module_homomorphism_space K addK mulK M addM smul M addM smul.
Definition module_endomorphism_composition : set -> set -> set -> set := fun M f g => fun x :e M => f (g x).
Axiom god1_module_endomorphism_composition_eval : forall X f g : set , forall x :e X , module_endomorphism_composition X f g x = ap f (ap g x).
Axiom god1_module_endomorphism_composition_in : forall X , forall f g :e X :^: X , module_endomorphism_composition X f g :e X :^: X.
Axiom god1_s2_theorem2_function_composition_associative : forall X , associative_on (X :^: X) (module_endomorphism_composition X).
Axiom god1_s14_theorem1_composition_distributes_over_map_addition : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall N , forall addN smulN : set -> set -> set , forall f g h : set -> set , module_homomorphism K addK mulK L addL smulL M addM smulM f -> module_homomorphism K addK mulK L addL smulL M addM smulM g -> module_homomorphism K addK mulK M addM smulM N addN smulN h -> (forall x :e L , h ((module_homomorphism_addition L addM (fun y :e L => f y) (fun y :e L => g y)) x) = (module_homomorphism_addition L addN (fun y :e L => h (f y)) (fun y :e L => h (g y))) x) /\ (forall u v : set -> set , module_homomorphism K addK mulK M addM smulM N addN smulN u -> module_homomorphism K addK mulK M addM smulM N addN smulN v -> forall x :e L , (module_homomorphism_addition M addN (fun y :e M => u y) (fun y :e M => v y)) (f x) = (module_homomorphism_addition L addN (fun y :e L => u (f y)) (fun y :e L => v (f y))) x).
Axiom god1_module_homomorphism_space_member_function : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f :e module_homomorphism_space K addK mulK L addL smulL M addM smulM , f :e M :^: L.
Axiom god1_module_homomorphism_space_member_linear : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f :e module_homomorphism_space K addK mulK L addL smulL M addM smulM , module_homomorphism K addK mulK L addL smulL M addM smulM (fun x => f x).
Axiom god1_module_endomorphism_identity_in : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , left_module K addK mulK M addM smul -> (fun x :e M => x) :e module_endomorphism_ring K addK mulK M addM smul.
Axiom god1_module_endomorphism_composition_closed : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , left_module K addK mulK M addM smul -> forall f g :e module_endomorphism_ring K addK mulK M addM smul , module_endomorphism_composition M f g :e module_endomorphism_ring K addK mulK M addM smul.
Axiom god1_module_homomorphism_addition_set_eval : forall L , forall addM : set -> set -> set , forall f g : set , forall x :e L , module_homomorphism_addition L addM f g x = addM (ap f x) (ap g x).
Axiom god1_endomorphism_composition_distributes : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , left_module K addK mulK M addM smul -> forall f g h :e module_endomorphism_ring K addK mulK M addM smul , module_endomorphism_composition M f (module_homomorphism_addition M addM g h) = module_homomorphism_addition M addM (module_endomorphism_composition M f g) (module_endomorphism_composition M f h) /\ module_endomorphism_composition M (module_homomorphism_addition M addM f g) h = module_homomorphism_addition M addM (module_endomorphism_composition M f h) (module_endomorphism_composition M g h).
Axiom god1_s14_corollary_endomorphisms_form_ring : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , left_module K addK mulK M addM smul -> ring (module_endomorphism_ring K addK mulK M addM smul) (module_homomorphism_addition M addM) (module_endomorphism_composition M).
Axiom god1_basis_coordinate_additive_group_homomorphism : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , module_basis K addK mulK M addM smul I a -> forall i :e I , group_homomorphism M addM K addK (basis_coordinate_function K addK mulK M addM smul I a i).
Axiom god1_right_linear_map_coordinate_matrix_formula : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall N , forall addN smulN : set -> set -> set , forall q p :e omega , forall b c : set -> set , forall f : set -> set , right_module_basis K addK mulK M addM smulM q b -> right_module_basis K addK mulK N addN smulN p c -> right_module_homomorphism K addK mulK M addM smulM N addN smulN f -> forall x :e M , forall i :e p , basis_coordinates K addK (opposite_ring_multiplication mulK) N addN (fun scalar y => smulN y scalar) p c (f x) i = ring_finite_sum K addK q (fun j => mulK (matrix_entry (matrix_of_right_linear_map K addK mulK M addM smulM N addN smulN q p b c f) i j) (basis_coordinates K addK (opposite_ring_multiplication mulK) M addM (fun scalar y => smulM y scalar) q b x j)).
Axiom god1_s14_theorem2_matrix_of_composition_is_product : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall N , forall addN smulN : set -> set -> set , forall r q p :e omega , forall a b c : set -> set , forall f g : set -> set , right_module_basis K addK mulK L addL smulL r a -> right_module_basis K addK mulK M addM smulM q b -> right_module_basis K addK mulK N addN smulN p c -> right_module_homomorphism K addK mulK M addM smulM N addN smulN f -> right_module_homomorphism K addK mulK L addL smulL M addM smulM g -> matrix_of_right_linear_map K addK mulK L addL smulL N addN smulN r p a c (fun x => f (g x)) = matrix_multiplication K addK mulK p q r (matrix_of_right_linear_map K addK mulK M addM smulM N addN smulN q p b c f) (matrix_of_right_linear_map K addK mulK L addL smulL M addM smulM r q a b g).
Axiom god1_basis_coordinate_of_basis_vector : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , module_basis K addK mulK M addM smul I a -> forall i j :e I , basis_coordinates K addK mulK M addM smul I a (a i) j = if j = i then ring_one K mulK else ring_zero K addK.
Axiom god1_module_identity_homomorphism : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , left_module K addK mulK M addM smul -> module_homomorphism K addK mulK M addM smul M addM smul (fun x : set => x).
Axiom god1_matrix_of_right_identity_is_unit : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall n :e omega , forall a : set -> set , right_module_basis K addK mulK M addM smul n a -> matrix_of_right_linear_map K addK mulK M addM smul M addM smul n n a a (fun x => x) = unit_matrix K addK mulK n.
Axiom god1_matrix_of_right_linear_map_pointwise_congr : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall q p , forall a b : set -> set , forall f g : set -> set , right_module_basis K addK mulK L addL smulL q a -> right_module_basis K addK mulK M addM smulM p b -> right_module_homomorphism K addK mulK L addL smulL M addM smulM f -> right_module_homomorphism K addK mulK L addL smulL M addM smulM g -> (forall x :e L , f x = g x) -> matrix_of_right_linear_map K addK mulK L addL smulL M addM smulM q p a b f = matrix_of_right_linear_map K addK mulK L addL smulL M addM smulM q p a b g.
Axiom god1_matrix_realized_by_canonical_right_linear_map : forall K , forall addK mulK : set -> set -> set , ring K addK mulK -> forall q p :e omega , forall A :e matrix_space K p q , exists F :e module_homomorphism_space K addK (opposite_ring_multiplication mulK) (K :^: q) (module_power_addition q addK) (module_power_left_scalar q (opposite_ring_multiplication mulK)) (K :^: p) (module_power_addition p addK) (module_power_left_scalar p (opposite_ring_multiplication mulK)) , matrix_of_right_linear_map K addK mulK (K :^: q) (module_power_addition q addK) (fun x scalar => module_power_left_scalar q (opposite_ring_multiplication mulK) scalar x) (K :^: p) (module_power_addition p addK) (fun x scalar => module_power_left_scalar p (opposite_ring_multiplication mulK) scalar x) q p (canonical_module_basis_vector K addK (opposite_ring_multiplication mulK) q) (canonical_module_basis_vector K addK (opposite_ring_multiplication mulK) p) (fun x => F x) = A.
Axiom god1_matrix_of_composition_with_identified_factors : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall N , forall addN smulN : set -> set -> set , forall r q p :e omega , forall a b c : set -> set , forall f g : set -> set , forall A B , right_module_basis K addK mulK L addL smulL r a -> right_module_basis K addK mulK M addM smulM q b -> right_module_basis K addK mulK N addN smulN p c -> right_module_homomorphism K addK mulK M addM smulM N addN smulN f -> right_module_homomorphism K addK mulK L addL smulL M addM smulM g -> matrix_of_right_linear_map K addK mulK M addM smulM N addN smulN q p b c f = A -> matrix_of_right_linear_map K addK mulK L addL smulL M addM smulM r q a b g = B -> matrix_of_right_linear_map K addK mulK L addL smulL N addN smulN r p a c (fun x => f (g x)) = matrix_multiplication K addK mulK p q r A B.
Axiom god1_module_homomorphism_raw_pointwise_sum : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f g : set -> set , left_module K addK mulK L addL smulL -> left_module K addK mulK M addM smulM -> module_homomorphism K addK mulK L addL smulL M addM smulM f -> module_homomorphism K addK mulK L addL smulL M addM smulM g -> module_homomorphism K addK mulK L addL smulL M addM smulM (fun x => addM (f x) (g x)).
Axiom god1_matrix_of_sum_with_identified_summands : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall q p :e omega , forall a b : set -> set , forall f g : set -> set , forall A B , right_module_basis K addK mulK L addL smulL q a -> right_module_basis K addK mulK M addM smulM p b -> right_module_homomorphism K addK mulK L addL smulL M addM smulM f -> right_module_homomorphism K addK mulK L addL smulL M addM smulM g -> matrix_of_right_linear_map K addK mulK L addL smulL M addM smulM q p a b f = A -> matrix_of_right_linear_map K addK mulK L addL smulL M addM smulM q p a b g = B -> matrix_of_right_linear_map K addK mulK L addL smulL M addM smulM q p a b (fun x => addM (f x) (g x)) = matrix_addition K addK p q A B.
Axiom god1_matrix_addition_in : forall K , forall add mul : set -> set -> set , forall p q , ring K add mul -> forall A B :e matrix_space K p q , matrix_addition K add p q A B :e matrix_space K p q.
Axiom god1_matrix_multiplication_in : forall K , forall add mul : set -> set -> set , forall p q r :e omega , ring K add mul -> forall A :e matrix_space K p q , forall B :e matrix_space K q r , matrix_multiplication K add mul p q r A B :e matrix_space K p r.
Axiom god1_matrix_associative_distributive_and_units : forall K , forall add mul : set -> set -> set , forall p q r s :e omega , ring K add mul -> (forall A :e matrix_space K p q , forall B :e matrix_space K q r , forall C :e matrix_space K r s , matrix_multiplication K add mul p q s A (matrix_multiplication K add mul q r s B C) = matrix_multiplication K add mul p r s (matrix_multiplication K add mul p q r A B) C) /\ (forall A B :e matrix_space K p q , forall C :e matrix_space K q r , matrix_multiplication K add mul p q r (matrix_addition K add p q A B) C = matrix_addition K add p r (matrix_multiplication K add mul p q r A C) (matrix_multiplication K add mul p q r B C)) /\ (forall A :e matrix_space K p q , forall B C :e matrix_space K q r , matrix_multiplication K add mul p q r A (matrix_addition K add q r B C) = matrix_addition K add p r (matrix_multiplication K add mul p q r A B) (matrix_multiplication K add mul p q r A C)) /\ (forall A :e matrix_space K p q , matrix_multiplication K add mul p p q (unit_matrix K add mul p) A = A /\ matrix_multiplication K add mul p q q A (unit_matrix K add mul q) = A).
Definition square_matrix_ring : set -> set -> set := fun K n => matrix_space K n n.
Axiom god1_square_matrices_form_ring : forall K , forall add mul : set -> set -> set , forall n :e omega , ring K add mul -> ring (square_matrix_ring K n) (matrix_addition K add n n) (matrix_multiplication K add mul n n n).
Axiom god1_endomorphism_ring_one_is_identity : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , left_module K addK mulK M addM smul -> ring_one (module_endomorphism_ring K addK mulK M addM smul) (module_endomorphism_composition M) = (fun x :e M => x).
Axiom god1_group_equal_carrier_transport : forall A B , forall op : set -> set -> set , A = B -> group B op -> group A op.
Axiom god1_bounded_map_two_sided_inverse_bijective : forall X , forall u v :e X :^: X , module_endomorphism_composition X v u = (fun x :e X => x) -> module_endomorphism_composition X u v = (fun x :e X => x) -> bij X X (fun x => u x).
Axiom god1_predicate_eq_subst : forall P : set -> prop , forall x y , x = y -> P x -> P y.
Axiom god1_ring_homomorphism_maps_units : forall K , forall addK mulK : set -> set -> set , forall L , forall addL mulL : set -> set -> set , forall phi : set -> set , ring_homomorphism K addK mulK L addL mulL phi -> forall x , ring_unit K addK mulK x -> ring_unit L addL mulL (phi x).
Axiom god1_ring_isomorphism_preserves_and_reflects_units : forall K , forall addK mulK : set -> set -> set , forall L , forall addL mulL : set -> set -> set , forall phi : set -> set , ring_isomorphism K addK mulK L addL mulL phi -> forall x :e K , (ring_unit K addK mulK x <-> ring_unit L addL mulL (phi x)).
Definition module_general_linear_group : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set := fun K addK mulK M addM smul => {f :e M :^: M|module_automorphism K addK mulK M addM smul (fun x => f x)}.
Axiom god1_module_automorphisms_form_general_linear_group : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , left_module K addK mulK M addM smul -> group (module_general_linear_group K addK mulK M addM smul) (module_endomorphism_composition M) /\ module_general_linear_group K addK mulK M addM smul = ring_units (module_endomorphism_ring K addK mulK M addM smul) (module_homomorphism_addition M addM) (module_endomorphism_composition M).
Definition invertible_matrix : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> prop := fun K add mul n A => ring_unit (square_matrix_ring K n) (matrix_addition K add n n) (matrix_multiplication K add mul n n n) A.
Definition general_linear_group : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set := fun K add mul n => {A :e square_matrix_ring K n|invertible_matrix K add mul n A}.
Definition matrix_inverse : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set := fun K add mul n A => ring_inverse (square_matrix_ring K n) (matrix_addition K add n n) (matrix_multiplication K add mul n n n) A.
Axiom god1_square_matrix_ring_one_is_unit_matrix : forall K , forall add mul : set -> set -> set , forall n :e omega , ring K add mul -> ring_one (square_matrix_ring K n) (matrix_multiplication K add mul n n n) = unit_matrix K add mul n.
Axiom god1_general_linear_group_is_group : forall K , forall add mul : set -> set -> set , forall n :e omega , ring K add mul -> group (general_linear_group K add mul n) (matrix_multiplication K add mul n n n) /\ forall A :e general_linear_group K add mul n , matrix_multiplication K add mul n n n (matrix_inverse K add mul n A) A = unit_matrix K add mul n /\ matrix_multiplication K add mul n n n A (matrix_inverse K add mul n A) = unit_matrix K add mul n.
Axiom god1_ring_homomorphism_intro : forall K , forall addK mulK : set -> set -> set , forall L , forall addL mulL : set -> set -> set , forall phi : set -> set , ring K addK mulK -> ring L addL mulL -> (forall x :e K , phi x :e L) -> (forall x y :e K , phi (addK x y) = addL (phi x) (phi y) /\ phi (mulK x y) = mulL (phi x) (phi y)) -> phi (ring_one K mulK) = ring_one L mulL -> ring_homomorphism K addK mulK L addL mulL phi.
Axiom god1_finite_free_endomorphism_matrix_ring_isomorphism : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , forall n :e omega , forall a : set -> set , right_module_basis K addK mulK M addM smulR n a -> ring_isomorphism (module_endomorphism_ring K addK (opposite_ring_multiplication mulK) M addM (fun scalar x => smulR x scalar)) (module_homomorphism_addition M addM) (module_endomorphism_composition M) (square_matrix_ring K n) (matrix_addition K addK n n) (matrix_multiplication K addK mulK n n n) (fun F => matrix_of_right_linear_map K addK mulK M addM smulR M addM smulR n n a a (fun x => F x)).
Axiom god1_automorphism_iff_matrix_invertible : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , forall n :e omega , forall a : set -> set , forall f : set -> set , right_module_basis K addK mulK M addM smulR n a -> right_module_homomorphism K addK mulK M addM smulR M addM smulR f -> (module_automorphism K addK (opposite_ring_multiplication mulK) M addM (fun scalar x => smulR x scalar) f <-> invertible_matrix K addK mulK n (matrix_of_right_linear_map K addK mulK M addM smulR M addM smulR n n a a f)).
Definition determinant_2 : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set := fun K add mul A => add (mul (matrix_entry A 0 0) (matrix_entry A 1 1)) (ring_negation K add (mul (matrix_entry A 0 1) (matrix_entry A 1 0))).
Axiom god1_ring_finite_sum_two : forall K , forall add mul : set -> set -> set , ring K add mul -> forall f : set -> set , f 0 :e K -> f 1 :e K -> ring_finite_sum K add 2 f = add (f 0) (f 1).
Axiom god1_matrix_product_entry_two : forall K , forall add mul : set -> set -> set , ring K add mul -> forall A B :e square_matrix_ring K 2 , forall i k :e 2 , matrix_entry (matrix_multiplication K add mul 2 2 2 A B) i k = add (mul (matrix_entry A i 0) (matrix_entry B 0 k)) (mul (matrix_entry A i 1) (matrix_entry B 1 k)).
Axiom god1_ring_common_addend_difference_cancel : forall K , forall add mul : set -> set -> set , ring K add mul -> forall x p q :e K , add (add x p) (ring_negation K add (add x q)) = add p (ring_negation K add q).
Axiom god1_commutative_ring_determinant_two_identity : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall a b c d e f g h :e K , add (mul (add (mul a e) (mul b g)) (add (mul c f) (mul d h))) (ring_negation K add (mul (add (mul a f) (mul b h)) (add (mul c e) (mul d g)))) = mul (add (mul a d) (ring_negation K add (mul b c))) (add (mul e h) (ring_negation K add (mul f g))).
Definition determinant_2_inverse_candidate : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set := fun K add mul A => fun u :e 2 :*: 2 => if u 0 = 0 then if u 1 = 0 then mul (ring_inverse K add mul (determinant_2 K add mul A)) (matrix_entry A 1 1) else mul (ring_inverse K add mul (determinant_2 K add mul A)) (ring_negation K add (matrix_entry A 0 1)) else if u 1 = 0 then mul (ring_inverse K add mul (determinant_2 K add mul A)) (ring_negation K add (matrix_entry A 1 0)) else mul (ring_inverse K add mul (determinant_2 K add mul A)) (matrix_entry A 0 0).
Axiom god1_matrix_two_extensionality : forall K , forall A B :e square_matrix_ring K 2 , matrix_entry A 0 0 = matrix_entry B 0 0 -> matrix_entry A 0 1 = matrix_entry B 0 1 -> matrix_entry A 1 0 = matrix_entry B 1 0 -> matrix_entry A 1 1 = matrix_entry B 1 1 -> A = B.
Axiom god1_commutative_ring_scaled_two_term : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall r x y z w :e K , add (mul x (mul r y)) (mul z (mul r w)) = mul r (add (mul x y) (mul z w)).
Axiom god1_commutative_ring_product_negated_swap_zero : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall x y :e K , add (mul x (ring_negation K add y)) (mul y x) = ring_zero K add.
Axiom god1_nested_if_member : forall K , forall a b c d :e K , forall p q : prop , (if p then (if q then a else b) else (if q then c else d)) :e K.
Axiom god1_determinant_2_inverse_candidate_member : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall A :e square_matrix_ring K 2 , ring_unit K add mul (determinant_2 K add mul A) -> determinant_2_inverse_candidate K add mul A :e square_matrix_ring K 2.
Axiom god1_unit_matrix_entry_two : forall K , forall add mul : set -> set -> set , forall i j :e 2 , matrix_entry (unit_matrix K add mul 2) i j = if i = j then ring_one K mul else ring_zero K add.
Axiom god1_determinant_2_inverse_candidate_entries : forall K , forall add mul : set -> set -> set , forall A , (matrix_entry (determinant_2_inverse_candidate K add mul A) 0 0 = mul (ring_inverse K add mul (determinant_2 K add mul A)) (matrix_entry A 1 1) /\ matrix_entry (determinant_2_inverse_candidate K add mul A) 0 1 = mul (ring_inverse K add mul (determinant_2 K add mul A)) (ring_negation K add (matrix_entry A 0 1))) /\ (matrix_entry (determinant_2_inverse_candidate K add mul A) 1 0 = mul (ring_inverse K add mul (determinant_2 K add mul A)) (ring_negation K add (matrix_entry A 1 0)) /\ matrix_entry (determinant_2_inverse_candidate K add mul A) 1 1 = mul (ring_inverse K add mul (determinant_2 K add mul A)) (matrix_entry A 0 0)).
Axiom god1_commutative_ring_inverse_scaled_determinant_two : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall a b c d :e K , ring_unit K add mul (add (mul a d) (ring_negation K add (mul b c))) -> add (mul a (mul (ring_inverse K add mul (add (mul a d) (ring_negation K add (mul b c)))) d)) (mul b (mul (ring_inverse K add mul (add (mul a d) (ring_negation K add (mul b c)))) (ring_negation K add c))) = ring_one K mul.
Axiom god1_commutative_ring_inverse_scaled_cross_zero : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall r x y :e K , add (mul x (mul r (ring_negation K add y))) (mul y (mul r x)) = ring_zero K add.
Axiom god1_commutative_ring_scaled_factor_interchange : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall r x y :e K , mul x (mul r y) = mul y (mul r x).
Axiom god1_commutative_ring_scaled_cross_negation_interchange : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall r b c :e K , mul c (mul r (ring_negation K add b)) = mul b (mul r (ring_negation K add c)).
Axiom god1_determinant_2_inverse_candidate_two_sided : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> forall A :e square_matrix_ring K 2 , ring_unit K add mul (determinant_2 K add mul A) -> matrix_multiplication K add mul 2 2 2 A (determinant_2_inverse_candidate K add mul A) = unit_matrix K add mul 2 /\ matrix_multiplication K add mul 2 2 2 (determinant_2_inverse_candidate K add mul A) A = unit_matrix K add mul 2.
Axiom god1_determinant_2_multiplicative_and_detects_units : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> (forall A B :e square_matrix_ring K 2 , determinant_2 K add mul (matrix_multiplication K add mul 2 2 2 A B) = mul (determinant_2 K add mul A) (determinant_2 K add mul B)) /\ (forall A :e square_matrix_ring K 2 , invertible_matrix K add mul 2 A <-> ring_unit K add mul (determinant_2 K add mul A)).
Definition transition_matrix : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> (set -> set) -> set := fun K addK mulK M addM smulR n a b => fun u :e n :*: n => basis_coordinates K addK (opposite_ring_multiplication mulK) M addM (fun scalar x => smulR x scalar) n b (a (u 1)) (u 0).
Axiom god1_transition_matrix_is_invertible_and_changes_coordinates : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , forall n :e omega , forall a b : set -> set , right_module_basis K addK mulK M addM smulR n a -> right_module_basis K addK mulK M addM smulR n b -> invertible_matrix K addK mulK n (transition_matrix K addK mulK M addM smulR n a b) /\ forall x :e M , forall i :e n , basis_coordinates K addK (opposite_ring_multiplication mulK) M addM (fun scalar y => smulR y scalar) n b x i = ring_finite_sum K addK n (fun j => mulK (matrix_entry (transition_matrix K addK mulK M addM smulR n a b) i j) (basis_coordinates K addK (opposite_ring_multiplication mulK) M addM (fun scalar y => smulR y scalar) n a x j)).
Definition right_basis_transform : set -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> set -> set -> set := fun K addK M addM smulR n a B j => module_finitely_supported_sum M addM n (fun i => smulR (a i) (matrix_entry B i j)).
Axiom god1_right_basis_transform_coordinates : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , forall n :e omega , forall a : set -> set , forall B :e square_matrix_ring K n , right_module_basis K addK mulK M addM smulR n a -> forall j :e n , right_basis_transform K addK M addM smulR n a B j :e M /\ forall i :e n , basis_coordinates K addK (opposite_ring_multiplication mulK) M addM (fun scalar x => smulR x scalar) n a (right_basis_transform K addK M addM smulR n a B j) i = matrix_entry B i j.
Axiom god1_right_basis_transform_induced_matrix : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , forall n :e omega , forall a : set -> set , forall B :e square_matrix_ring K n , right_module_basis K addK mulK M addM smulR n a -> matrix_of_right_linear_map K addK mulK M addM smulR M addM smulR n n a a (god1_basis_induced_linear_map K addK (opposite_ring_multiplication mulK) M addM (fun scalar x => smulR x scalar) n a M addM (fun scalar x => smulR x scalar) (fun j => right_basis_transform K addK M addM smulR n a B j)) = B.
Axiom god1_family_is_basis_iff_induced_map_automorphism : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a c : set -> set , module_basis K addK mulK M addM smul I a -> (forall i :e I , c i :e M) -> (module_basis K addK mulK M addM smul I c <-> module_automorphism K addK mulK M addM smul (god1_basis_induced_linear_map K addK mulK M addM smul I a M addM smul c)).
Axiom god1_s15_theorem1_basis_transform_iff_matrix_invertible : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , forall n :e omega , forall a : set -> set , forall B :e square_matrix_ring K n , right_module_basis K addK mulK M addM smulR n a -> (right_module_basis K addK mulK M addM smulR n (fun j => right_basis_transform K addK M addM smulR n a B j) <-> invertible_matrix K addK mulK n B).
Axiom god1_matrix_multiplication_associative_natural : forall K , forall add mul : set -> set -> set , forall p q r s :e omega , ring K add mul -> forall A :e matrix_space K p q , forall B :e matrix_space K q r , forall C :e matrix_space K r s , matrix_multiplication K add mul p q s A (matrix_multiplication K add mul q r s B C) = matrix_multiplication K add mul p r s (matrix_multiplication K add mul p q r A B) C.
Axiom god1_matrix_left_unit_rectangular : forall K , forall add mul : set -> set -> set , forall p q :e omega , ring K add mul -> forall A :e matrix_space K p q , matrix_multiplication K add mul p p q (unit_matrix K add mul p) A = A.
Axiom god1_s15_theorem2_matrix_under_change_of_bases : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall q p :e omega , forall a1 a2 b1 b2 : set -> set , forall f : set -> set , right_module_basis K addK mulK L addL smulL q a1 -> right_module_basis K addK mulK L addL smulL q a2 -> right_module_basis K addK mulK M addM smulM p b1 -> right_module_basis K addK mulK M addM smulM p b2 -> right_module_homomorphism K addK mulK L addL smulL M addM smulM f -> matrix_of_right_linear_map K addK mulK L addL smulL M addM smulM q p a1 b1 f = matrix_multiplication K addK mulK p p q (matrix_inverse K addK mulK p (transition_matrix K addK mulK M addM smulM p b1 b2)) (matrix_multiplication K addK mulK p q q (matrix_of_right_linear_map K addK mulK L addL smulL M addM smulM q p a2 b2 f) (transition_matrix K addK mulK L addL smulL q a1 a2)).
Axiom god1_s15_corollary_similar_matrices_of_endomorphism : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , forall n :e omega , forall a1 a2 : set -> set , forall f : set -> set , right_module_basis K addK mulK M addM smulR n a1 -> right_module_basis K addK mulK M addM smulR n a2 -> right_module_homomorphism K addK mulK M addM smulR M addM smulR f -> matrix_of_right_linear_map K addK mulK M addM smulR M addM smulR n n a2 a2 f = matrix_multiplication K addK mulK n n n (transition_matrix K addK mulK M addM smulR n a1 a2) (matrix_multiplication K addK mulK n n n (matrix_of_right_linear_map K addK mulK M addM smulR M addM smulR n n a1 a1 f) (matrix_inverse K addK mulK n (transition_matrix K addK mulK M addM smulR n a1 a2))).
Definition similar_matrices : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set -> prop := fun K add mul n A B => A :e square_matrix_ring K n /\ B :e square_matrix_ring K n /\ exists U :e general_linear_group K add mul n , B = matrix_multiplication K add mul n n n U (matrix_multiplication K add mul n n n A (matrix_inverse K add mul n U)).
Definition right_module_dual : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set := fun K addK mulK L addL smulR => module_homomorphism_space K addK (opposite_ring_multiplication mulK) L addL (fun scalar x => smulR x scalar) K addK (fun scalar x => mulK x scalar).
Definition right_module_dual_addition : set -> (set -> set -> set) -> set -> set -> set := fun L addK => module_homomorphism_addition L addK.
Definition right_module_dual_left_scalar : set -> (set -> set -> set) -> set -> set -> set := fun L mulK => module_homomorphism_scalar L mulK.
Axiom god1_right_module_basis_domain_right_module : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , forall I , forall a : set -> set , right_module_basis K addK mulK M addM smulR I a -> right_module K addK mulK M addM smulR.
Axiom god1_right_module_dual_is_left_module : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulR : set -> set -> set , right_module K addK mulK L addL smulR -> left_module K addK mulK (right_module_dual K addK mulK L addL smulR) (right_module_dual_addition L addK) (right_module_dual_left_scalar L mulK).
Axiom god1_induced_isomorphism_gives_basis : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall I , forall a c : set -> set , module_basis K addK mulK L addL smulL I a -> left_module K addK mulK M addM smulM -> (forall i :e I , c i :e M) -> module_isomorphism K addK mulK L addL smulL M addM smulM (god1_basis_induced_linear_map K addK mulK L addL smulL I a M addM smulM c) -> module_basis K addK mulK M addM smulM I c.
Definition right_module_dual_evaluation : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> set -> set := fun K addK mulK L addL smulR n a f => fun i :e n => f (a i).
Definition right_module_dual_basis_vector : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> set -> set -> set := fun K addK mulK L addL smulR n a i x => basis_coordinate_function K addK (opposite_ring_multiplication mulK) L addL (fun scalar y => smulR y scalar) n a i x.
Axiom god1_right_module_dual_evaluation_has_preimage : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulR : set -> set -> set , forall n , forall a : set -> set , right_module_basis K addK mulK L addL smulR n a -> forall y :e K :^: n , exists f :e right_module_dual K addK mulK L addL smulR , right_module_dual_evaluation K addK mulK L addL smulR n a f = y.
Axiom god1_s16_theorem1_dual_of_finite_free_module : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulR : set -> set -> set , forall n :e omega , forall a : set -> set , right_module_basis K addK mulK L addL smulR n a -> module_isomorphism K addK mulK (right_module_dual K addK mulK L addL smulR) (right_module_dual_addition L addK) (right_module_dual_left_scalar L mulK) (K :^: n) (module_power_addition n addK) (module_power_left_scalar n mulK) (fun f => right_module_dual_evaluation K addK mulK L addL smulR n a f) /\ module_basis K addK mulK (right_module_dual K addK mulK L addL smulR) (right_module_dual_addition L addK) (right_module_dual_left_scalar L mulK) n (fun i => fun x :e L => right_module_dual_basis_vector K addK mulK L addL smulR n a i x) /\ forall i j :e n , right_module_dual_basis_vector K addK mulK L addL smulR n a i (a j) = if i = j then ring_one K mulK else ring_zero K addK.
Definition right_module_bidual : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set := fun K addK mulK L addL smulR => module_homomorphism_space K addK mulK (right_module_dual K addK mulK L addL smulR) (right_module_dual_addition L addK) (right_module_dual_left_scalar L mulK) K addK mulK.
Definition right_module_bidual_addition : set -> (set -> set -> set) -> set -> set -> set := fun dualL addK => module_homomorphism_addition dualL addK.
Definition right_module_bidual_right_scalar : set -> (set -> set -> set) -> set -> set -> set := fun dualL mulK u scalar => fun f :e dualL => mulK (u f) scalar.
Definition canonical_bidual_mapping : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> set := fun K addK mulK L addL smulR x => fun f :e right_module_dual K addK mulK L addL smulR => f x.
Axiom god1_left_modules_over_opposite_ring_are_right_modules : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , left_module K addK (opposite_ring_multiplication mulK) M addM (fun scalar x => smulR x scalar) -> right_module K addK mulK M addM smulR.
Axiom god1_module_homomorphism_two_vector_formula : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , module_homomorphism K addK mulK L addL smulL M addM smulM f -> forall x y :e L , forall scalar mu :e K , f (addL (smulL scalar x) (smulL mu y)) = addM (smulM scalar (f x)) (smulM mu (f y)).
Axiom god1_bidual_is_right_module_and_evaluation_is_linear : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulR : set -> set -> set , right_module K addK mulK L addL smulR -> right_module K addK mulK (right_module_bidual K addK mulK L addL smulR) (right_module_bidual_addition (right_module_dual K addK mulK L addL smulR) addK) (right_module_bidual_right_scalar (right_module_dual K addK mulK L addL smulR) mulK) /\ right_module_homomorphism K addK mulK L addL smulR (right_module_bidual K addK mulK L addL smulR) (right_module_bidual_addition (right_module_dual K addK mulK L addL smulR) addK) (right_module_bidual_right_scalar (right_module_dual K addK mulK L addL smulR) mulK) (canonical_bidual_mapping K addK mulK L addL smulR).
Axiom god1_basis_to_basis_homomorphism_is_isomorphism : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall I , forall a c : set -> set , forall f : set -> set , module_basis K addK mulK L addL smulL I a -> module_basis K addK mulK M addM smulM I c -> module_homomorphism K addK mulK L addL smulL M addM smulM f -> (forall i :e I , f (a i) = c i) -> module_isomorphism K addK mulK L addL smulL M addM smulM f.
Axiom god1_s16_theorem2_finite_free_module_isomorphic_to_bidual : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulR : set -> set -> set , forall n :e omega , forall a : set -> set , right_module_basis K addK mulK L addL smulR n a -> module_isomorphism K addK (opposite_ring_multiplication mulK) L addL (fun scalar x => smulR x scalar) (right_module_bidual K addK mulK L addL smulR) (right_module_bidual_addition (right_module_dual K addK mulK L addL smulR) addK) (fun scalar u => right_module_bidual_right_scalar (right_module_dual K addK mulK L addL smulR) mulK u scalar) (canonical_bidual_mapping K addK mulK L addL smulR).
Axiom god1_s16_corollary1_every_bidual_form_is_evaluation : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulR : set -> set -> set , forall n :e omega , forall a : set -> set , right_module_basis K addK mulK L addL smulR n a -> forall u :e right_module_bidual K addK mulK L addL smulR , exists x :e L , (forall f :e right_module_dual K addK mulK L addL smulR , u f = f x) /\ forall y :e L , (forall f :e right_module_dual K addK mulK L addL smulR , u f = f y) -> y = x.
Axiom god1_finitely_generated_free_right_module_has_finite_ordinal_basis : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulR : set -> set -> set , finitely_generated_free_module K addK (opposite_ring_multiplication mulK) L addL (fun scalar x => smulR x scalar) -> exists m :e omega , exists a : set -> set , right_module_basis K addK mulK L addL smulR m a.
Axiom god1_s16_corollary2_prescribed_values_on_dual_basis : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulR : set -> set -> set , forall n :e omega , forall f : set -> set , forall beta :e K :^: n , finitely_generated_free_module K addK (opposite_ring_multiplication mulK) L addL (fun scalar x => smulR x scalar) -> module_basis K addK mulK (right_module_dual K addK mulK L addL smulR) (right_module_dual_addition L addK) (right_module_dual_left_scalar L mulK) n f -> exists x :e L , (forall i :e n , f i x = beta i) /\ forall y :e L , (forall i :e n , f i y = beta i) -> y = x.
Definition module_transpose : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> set := fun K addK mulK L addL smulL M addM smulM f => fun u :e right_module_dual K addK mulK M addM smulM => fun x :e L => u (f x).
Axiom god1_module_transpose_evaluation : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , forall u :e right_module_dual K addK mulK M addM smulM , forall x :e L , module_transpose K addK mulK L addL smulL M addM smulM f u x = u (f x).
Axiom god1_module_transpose_is_left_linear : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , right_module_homomorphism K addK mulK L addL smulL M addM smulM f -> module_homomorphism K addK mulK (right_module_dual K addK mulK M addM smulM) (right_module_dual_addition M addK) (right_module_dual_left_scalar M mulK) (right_module_dual K addK mulK L addL smulL) (right_module_dual_addition L addK) (right_module_dual_left_scalar L mulK) (fun u => module_transpose K addK mulK L addL smulL M addM smulM f u).
Axiom god1_right_module_homomorphism_pointwise_sum : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f g : set -> set , right_module_homomorphism K addK mulK L addL smulL M addM smulM f -> right_module_homomorphism K addK mulK L addL smulL M addM smulM g -> right_module_homomorphism K addK mulK L addL smulL M addM smulM (fun x => addM (f x) (g x)).
Axiom god1_s16_theorem3_transpose_addition_and_composition : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall N , forall addN smulN : set -> set -> set , forall f g h : set -> set , right_module_homomorphism K addK mulK L addL smulL M addM smulM f -> right_module_homomorphism K addK mulK L addL smulL M addM smulM g -> right_module_homomorphism K addK mulK M addM smulM N addN smulN h -> module_transpose K addK mulK L addL smulL M addM smulM (fun x => addM (f x) (g x)) = module_homomorphism_addition (right_module_dual K addK mulK M addM smulM) (right_module_dual_addition L addK) (module_transpose K addK mulK L addL smulL M addM smulM f) (module_transpose K addK mulK L addL smulL M addM smulM g) /\ module_transpose K addK mulK L addL smulL N addN smulN (fun x => h (f x)) = fun u :e right_module_dual K addK mulK N addN smulN => module_transpose K addK mulK L addL smulL M addM smulM f (module_transpose K addK mulK M addM smulM N addN smulN h u).
Axiom god1_transpose_of_identity_and_automorphism : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulR : set -> set -> set , forall f : set -> set , right_module K addK mulK L addL smulR -> module_transpose K addK mulK L addL smulR L addL smulR (fun x => x) = (fun u :e right_module_dual K addK mulK L addL smulR => u) /\ (module_automorphism K addK (opposite_ring_multiplication mulK) L addL (fun scalar x => smulR x scalar) f -> module_automorphism K addK mulK (right_module_dual K addK mulK L addL smulR) (right_module_dual_addition L addK) (right_module_dual_left_scalar L mulK) (fun u => module_transpose K addK mulK L addL smulR L addL smulR f u)).
Definition matrix_transpose : set -> set -> set -> set -> set := fun K p q A => fun u :e q :*: p => A (u 1,u 0).
Axiom god1_matrix_transpose_in : forall K p q , forall A :e matrix_space K p q , matrix_transpose K p q A :e matrix_space K q p.
Axiom god1_matrix_transpose_entry : forall K p q , forall A :e matrix_space K p q , forall i :e p , forall j :e q , matrix_entry (matrix_transpose K p q A) j i = matrix_entry A i j.
Axiom god1_right_module_dual_basis_coordinates_are_evaluations : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulR : set -> set -> set , forall n :e omega , forall a : set -> set , right_module_basis K addK mulK L addL smulR n a -> forall u :e right_module_dual K addK mulK L addL smulR , forall i :e n , basis_coordinates K addK mulK (right_module_dual K addK mulK L addL smulR) (right_module_dual_addition L addK) (right_module_dual_left_scalar L mulK) n (fun j => fun x :e L => right_module_dual_basis_vector K addK mulK L addL smulR n a j x) u i = u (a i).
Axiom god1_right_module_dual_basis_as_right_basis_over_opposite : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulR : set -> set -> set , forall n :e omega , forall a : set -> set , right_module_basis K addK mulK L addL smulR n a -> right_module_basis K addK (opposite_ring_multiplication mulK) (right_module_dual K addK mulK L addL smulR) (right_module_dual_addition L addK) (fun u scalar => right_module_dual_left_scalar L mulK scalar u) n (fun i => fun x :e L => right_module_dual_basis_vector K addK mulK L addL smulR n a i x).
Axiom god1_module_transpose_is_right_linear_over_opposite : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , right_module_homomorphism K addK mulK L addL smulL M addM smulM f -> right_module_homomorphism K addK (opposite_ring_multiplication mulK) (right_module_dual K addK mulK M addM smulM) (right_module_dual_addition M addK) (fun u scalar => right_module_dual_left_scalar M mulK scalar u) (right_module_dual K addK mulK L addL smulL) (right_module_dual_addition L addK) (fun u scalar => right_module_dual_left_scalar L mulK scalar u) (fun u => module_transpose K addK mulK L addL smulL M addM smulM f u).
Axiom god1_matrix_of_transposed_map_is_transpose_matrix : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall q p :e omega , forall a b : set -> set , forall f : set -> set , right_module_basis K addK mulK L addL smulL q a -> right_module_basis K addK mulK M addM smulM p b -> right_module_homomorphism K addK mulK L addL smulL M addM smulM f -> matrix_of_right_linear_map K addK (opposite_ring_multiplication mulK) (right_module_dual K addK mulK M addM smulM) (right_module_dual_addition M addK) (fun u scalar => right_module_dual_left_scalar M mulK scalar u) (right_module_dual K addK mulK L addL smulL) (right_module_dual_addition L addK) (fun u scalar => right_module_dual_left_scalar L mulK scalar u) p q (fun i => fun x :e M => right_module_dual_basis_vector K addK mulK M addM smulM p b i x) (fun j => fun x :e L => right_module_dual_basis_vector K addK mulK L addL smulL q a j x) (fun u => module_transpose K addK mulK L addL smulL M addM smulM f u) = matrix_transpose K p q (matrix_of_right_linear_map K addK mulK L addL smulL M addM smulM q p a b f).
Axiom god1_matrix_transpose_product : forall K , forall add mul : set -> set -> set , forall p q r :e omega , ring K add mul -> forall A :e matrix_space K p q , forall B :e matrix_space K q r , matrix_transpose K p r (matrix_multiplication K add mul p q r A B) = matrix_multiplication K add (opposite_ring_multiplication mul) r q p (matrix_transpose K q r B) (matrix_transpose K p q A).
Axiom god1_s16_theorem4_matrix_transpose_laws : forall K , forall add mul : set -> set -> set , forall p q r :e omega , ring K add mul -> (forall A B :e matrix_space K p q , matrix_transpose K p q (matrix_addition K add p q A B) = matrix_addition K add q p (matrix_transpose K p q A) (matrix_transpose K p q B)) /\ (forall A :e matrix_space K p q , forall B :e matrix_space K q r , matrix_transpose K p r (matrix_multiplication K add mul p q r A B) = matrix_multiplication K add (opposite_ring_multiplication mul) r q p (matrix_transpose K q r B) (matrix_transpose K p q A)) /\ (forall A :e square_matrix_ring K p , (invertible_matrix K add mul p A <-> invertible_matrix K add (opposite_ring_multiplication mul) p (matrix_transpose K p p A))) /\ forall A :e matrix_space K p q , matrix_transpose K q p (matrix_transpose K p q A) = A.
Definition submodule_sum : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set := fun K addK mulK L addL smul M N => {z :e L|exists x :e M , exists y :e N , z = addL x y}.
Axiom god1_submodule_sum_intro : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall M N , submodule K addK mulK L addL smul M -> submodule K addK mulK L addL smul N -> forall x :e M , forall y :e N , addL x y :e submodule_sum K addK mulK L addL smul M N.
Axiom god1_submodule_sum_elim : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall M N , forall z :e submodule_sum K addK mulK L addL smul M N , exists x :e M , exists y :e N , z = addL x y.
Axiom god1_sum_of_two_submodules_is_least_containing_submodule : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall M N , submodule K addK mulK L addL smul M -> submodule K addK mulK L addL smul N -> submodule K addK mulK L addL smul (submodule_sum K addK mulK L addL smul M N) /\ M c= submodule_sum K addK mulK L addL smul M N /\ N c= submodule_sum K addK mulK L addL smul M N /\ forall P , submodule K addK mulK L addL smul P -> M c= P -> N c= P -> submodule_sum K addK mulK L addL smul M N c= P.
Definition submodule_family_sum : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> set := fun K addK mulK L addL smul I M => {z :e L|exists x :e (Pi_ i :e I , M i) , z = module_finitely_supported_sum L addL I (fun i => x i)}.
Axiom god1_submodule_family_sum_intro : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall I , forall M : set -> set , left_module K addK mulK L addL smul -> finite I -> (forall i :e I , submodule K addK mulK L addL smul (M i)) -> forall x :e (Pi_ i :e I , M i) , module_finitely_supported_sum L addL I (fun i => x i) :e submodule_family_sum K addK mulK L addL smul I M.
Axiom god1_submodule_family_sum_elim : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall I , forall M : set -> set , forall z :e submodule_family_sum K addK mulK L addL smul I M , exists x :e (Pi_ i :e I , M i) , z = module_finitely_supported_sum L addL I (fun i => x i).
Axiom god1_submodule_family_sum_combined_coefficients : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall I , forall M : set -> set , left_module K addK mulK L addL smul -> finite I -> (forall i :e I , submodule K addK mulK L addL smul (M i)) -> forall x x' :e (Pi_ i :e I , M i) , forall lambda mu :e K , exists y :e (Pi_ i :e I , M i) , addL (smul lambda (module_finitely_supported_sum L addL I (fun i => x i))) (smul mu (module_finitely_supported_sum L addL I (fun i => x' i))) = module_finitely_supported_sum L addL I (fun i => y i).
Axiom god1_finite_sum_of_submodules_is_least_containing_submodule : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall I , forall M : set -> set , left_module K addK mulK L addL smul -> finite I -> (forall i :e I , submodule K addK mulK L addL smul (M i)) -> submodule K addK mulK L addL smul (submodule_family_sum K addK mulK L addL smul I M) /\ (forall i :e I , M i c= submodule_family_sum K addK mulK L addL smul I M) /\ forall P , submodule K addK mulK L addL smul P -> (forall i :e I , M i c= P) -> submodule_family_sum K addK mulK L addL smul I M c= P.
Definition indexed_module_product : set -> (set -> set) -> set := fun I M => Pi_ i :e I , M i.
Definition indexed_module_product_addition : set -> (set -> set -> set -> set) -> set -> set -> set := fun I addM x y => fun i :e I => addM i (x i) (y i).
Definition indexed_module_product_left_scalar : set -> (set -> set -> set -> set) -> set -> set -> set := fun I smul scalar x => fun i :e I => smul i scalar (x i).
Axiom god1_indexed_module_product_addition_eval : forall I , forall addM : set -> set -> set -> set , forall x y i , i :e I -> indexed_module_product_addition I addM x y i = addM i (x i) (y i).
Axiom god1_indexed_module_product_left_scalar_eval : forall I , forall smul : set -> set -> set -> set , forall scalar x i , i :e I -> indexed_module_product_left_scalar I smul scalar x i = smul i scalar (x i).
Axiom god1_indexed_direct_product_is_module : forall K , forall addK mulK : set -> set -> set , forall I , forall M : set -> set , forall addM smul : set -> set -> set -> set , ring K addK mulK -> (forall i :e I , left_module K addK mulK (M i) (addM i) (smul i)) -> left_module K addK mulK (indexed_module_product I M) (indexed_module_product_addition I addM) (indexed_module_product_left_scalar I smul).
Definition module_product_projection : set -> set -> set := fun i x => x i.
Definition module_product_injection : set -> (set -> set) -> (set -> set -> set -> set) -> set -> set -> set := fun I M addM i x => fun j :e I => if j = i then x else module_zero (M j) (addM j).
Axiom god1_module_product_injection_eval : forall I , forall M : set -> set , forall addM : set -> set -> set -> set , forall i x j , j :e I -> module_product_injection I M addM i x j = if j = i then x else module_zero (M j) (addM j).
Axiom god1_product_projections_and_injections_are_linear : forall K , forall addK mulK : set -> set -> set , forall I , forall M : set -> set , forall addM smul : set -> set -> set -> set , (forall i :e I , left_module K addK mulK (M i) (addM i) (smul i)) -> (forall i :e I , module_homomorphism K addK mulK (indexed_module_product I M) (indexed_module_product_addition I addM) (indexed_module_product_left_scalar I smul) (M i) (addM i) (smul i) (module_product_projection i)) /\ (forall i :e I , module_homomorphism K addK mulK (M i) (addM i) (smul i) (indexed_module_product I M) (indexed_module_product_addition I addM) (indexed_module_product_left_scalar I smul) (module_product_injection I M addM i) /\ inj (M i) (indexed_module_product I M) (module_product_injection I M addM i)).
Definition submodule_family_sum_map : set -> (set -> set -> set) -> set -> set -> set := fun L addL I x => module_finitely_supported_sum L addL I (fun i => x i).
Definition linearly_independent_submodules : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> prop := fun K addK mulK L addL smul I M => finite I /\ (forall i :e I , submodule K addK mulK L addL smul (M i)) /\ inj (indexed_module_product I M) L (submodule_family_sum_map L addL I).
Definition direct_sum_decomposition : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> prop := fun K addK mulK L addL smul I M => linearly_independent_submodules K addK mulK L addL smul I M /\ submodule_family_sum K addK mulK L addL smul I M = L.
Axiom god1_abelian_finite_sum_two : forall G , forall add : set -> set -> set , abelian_group G add -> forall f : set -> set , f 0 :e G -> f 1 :e G -> ring_finite_sum G add 2 f = add (f 0) (f 1).
Axiom god1_two_submodule_product_coordinates : forall M N , forall x :e (Pi_ i :e 2 , if i = 0 then M else N) , x 0 :e M /\ x 1 :e N.
Axiom god1_two_component_submodule_family_sum_eval : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall M N , submodule K addK mulK L addL smul M -> submodule K addK mulK L addL smul N -> forall x :e (Pi_ i :e 2 , if i = 0 then M else N) , submodule_family_sum_map L addL 2 x = addL (x 0) (x 1).
Axiom god1_two_submodule_product_pair : forall M N , forall x :e M , forall y :e N , exists u :e (Pi_ i :e 2 , if i = 0 then M else N) , u 0 = x /\ u 1 = y.
Axiom god1_s17_theorem1_two_submodules_independent_iff_trivial_intersection : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall M N , submodule K addK mulK L addL smul M -> submodule K addK mulK L addL smul N -> (linearly_independent_submodules K addK mulK L addL smul 2 (fun i => if i = 0 then M else N) <-> {x :e M|x :e N} = {module_zero L addL}).
Axiom god1_submodule_zero_equals_ambient_zero : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall N , submodule K addK mulK L addL smul N -> module_zero N addL = module_zero L addL.
Axiom god1_submodule_inclusion_is_linear : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall N , submodule K addK mulK L addL smul N -> module_homomorphism K addK mulK N addL smul L addL smul (fun x => x).
Axiom god1_submodule_family_sum_map_is_linear : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall I , forall M : set -> set , left_module K addK mulK L addL smul -> finite I -> (forall i :e I , submodule K addK mulK L addL smul (M i)) -> module_homomorphism K addK mulK (indexed_module_product I M) (indexed_module_product_addition I (fun i => addL)) (indexed_module_product_left_scalar I (fun i => smul)) L addL smul (submodule_family_sum_map L addL I).
Definition complementary_submodule : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> prop := fun K addK mulK L addL smul M N => submodule K addK mulK L addL smul M /\ submodule K addK mulK L addL smul N /\ direct_sum_decomposition K addK mulK L addL smul 2 (fun i => if i = 0 then M else N).
Definition direct_summand : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> prop := fun K addK mulK L addL smul M => exists N , complementary_submodule K addK mulK L addL smul M N.
Axiom god1_direct_sum_unique_expansion : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall I , forall M : set -> set , direct_sum_decomposition K addK mulK L addL smul I M -> forall x :e L , exists coeff :e indexed_module_product I M , x = submodule_family_sum_map L addL I coeff /\ forall coeff' :e indexed_module_product I M , x = submodule_family_sum_map L addL I coeff' -> coeff' = coeff.
Axiom god1_submodule_family_sum_map_injection_eval : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall I , forall M : set -> set , left_module K addK mulK L addL smul -> (forall i :e I , submodule K addK mulK L addL smul (M i)) -> forall i :e I , forall z :e M i , submodule_family_sum_map L addL I (module_product_injection I M (fun j => addL) i z) = z.
Definition direct_sum_projection : set -> (set -> set -> set) -> set -> (set -> set) -> set -> set -> set := fun L addL I M i x => Eps_i (fun y => y :e M i /\ exists coeff :e indexed_module_product I M , x = submodule_family_sum_map L addL I coeff /\ y = coeff i).
Axiom god1_direct_sum_projection_specification : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall I , forall M : set -> set , direct_sum_decomposition K addK mulK L addL smul I M -> forall x :e L , forall i :e I , direct_sum_projection L addL I M i x :e M i /\ exists coeff :e indexed_module_product I M , x = submodule_family_sum_map L addL I coeff /\ direct_sum_projection L addL I M i x = coeff i.
Axiom god1_direct_sum_projection_of_coefficients : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall I , forall M : set -> set , direct_sum_decomposition K addK mulK L addL smul I M -> forall coeff :e indexed_module_product I M , forall i :e I , direct_sum_projection L addL I M i (submodule_family_sum_map L addL I coeff) = coeff i.
Axiom god1_direct_sum_projection_on_summand : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall I , forall M : set -> set , left_module K addK mulK L addL smul -> direct_sum_decomposition K addK mulK L addL smul I M -> forall i :e I , forall z :e M i , direct_sum_projection L addL I M i z = z.
Axiom god1_direct_sum_projection_on_other_summand : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall I , forall M : set -> set , left_module K addK mulK L addL smul -> direct_sum_decomposition K addK mulK L addL smul I M -> forall i j :e I , i <> j -> forall z :e M i , direct_sum_projection L addL I M j z = module_zero L addL.
Definition module_projection : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> prop := fun K addK mulK L addL smul v => module_endomorphism K addK mulK L addL smul v /\ forall x :e L , v (v x) = v x.
Axiom god1_direct_sum_projections_are_orthogonal_and_sum_to_identity : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall I , forall M : set -> set , left_module K addK mulK L addL smul -> direct_sum_decomposition K addK mulK L addL smul I M -> (forall i :e I , module_projection K addK mulK L addL smul (direct_sum_projection L addL I M i) /\ module_homomorphism_image L (direct_sum_projection L addL I M i) = M i) /\ (forall i j :e I , forall x :e L , direct_sum_projection L addL I M j (direct_sum_projection L addL I M i x) = if i = j then direct_sum_projection L addL I M i x else module_zero L addL) /\ forall x :e L , module_finitely_supported_sum L addL I (fun i => direct_sum_projection L addL I M i x) = x.
Axiom god1_s17_theorem2_orthogonal_projections_give_direct_sum : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall I , forall v : set -> set -> set , left_module K addK mulK L addL smul -> finite I -> (forall i :e I , module_endomorphism K addK mulK L addL smul (v i)) -> (forall i j :e I , forall x :e L , v j (v i x) = if i = j then v i x else module_zero L addL) -> (forall x :e L , module_finitely_supported_sum L addL I (fun i => v i x) = x) -> direct_sum_decomposition K addK mulK L addL smul I (fun i => module_homomorphism_image L (v i)).
Axiom god1_two_submodule_family_sum_equals_sum : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall M N , submodule K addK mulK L addL smul M -> submodule K addK mulK L addL smul N -> submodule_family_sum K addK mulK L addL smul 2 (fun i => if i = 0 then M else N) = submodule_sum K addK mulK L addL smul M N.
Axiom god1_s17_corollary_direct_summand_characterizations : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall M , submodule K addK mulK L addL smul M -> (direct_summand K addK mulK L addL smul M <-> exists v : set -> set , module_projection K addK mulK L addL smul v /\ module_homomorphism_image L v = M) /\ (direct_summand K addK mulK L addL smul M <-> exists q : set -> set , module_homomorphism K addK mulK L addL smul M addL smul q /\ forall x :e M , q x = x).
Definition god1_s18_chosen_lift : set -> (set -> set) -> (set -> set) -> set -> set := fun L f b j => Eps_i (fun x => x :e L /\ f x = b j).
Definition god1_s18_joined_generators : set -> (set -> set) -> set -> (set -> set) -> set := fun I a J c => {a i|i :e I} :\/: {c j|j :e J}.
Definition god1_s18_finite_span : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> set := fun K addK mulK L addL smulL G => submodule_generated_by_family K addK mulK L addL smulL (finite_cardinality G) (fun i => finite_enumeration G i).
Definition god1_s18_tagged_family : set -> (set -> set) -> set -> (set -> set) -> set -> set := fun I a J c t => if t :e {Inj0 i|i :e I} then a (Unj t) else c (Unj t).
Definition god1_s18_pulled_canonical_basis : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> set -> set -> set := fun K addK mulK X u n i => inv X u (canonical_module_basis_vector K addK mulK n i).
Axiom god1_s18_theorem1_finite_kernel_and_image : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , module_homomorphism K addK mulK L addL smulL M addM smulM f -> (finitely_generated_module K addK mulK (module_homomorphism_kernel K addK mulK L addL smulL M addM smulM f) addL smulL -> finitely_generated_module K addK mulK (module_homomorphism_image L f) addM smulM -> finitely_generated_module K addK mulK L addL smulL) /\ (forall p q :e omega , isomorphic_modules K addK mulK (module_homomorphism_kernel K addK mulK L addL smulL M addM smulM f) addL smulL (K :^: p) (module_power_addition p addK) (module_power_left_scalar p mulK) -> isomorphic_modules K addK mulK (module_homomorphism_image L f) addM smulM (K :^: q) (module_power_addition q addK) (module_power_left_scalar q mulK) -> isomorphic_modules K addK mulK L addL smulL (K :^: (p + q)) (module_power_addition (p + q) addK) (module_power_left_scalar (p + q) mulK)).
Definition left_noetherian_ring : set -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K add mul => ring K add mul /\ forall I , left_ideal K add mul I -> finitely_generated_module K add mul I add mul.
Definition right_noetherian_ring : set -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K add mul => ring K add mul /\ forall I , right_ideal K add mul I -> finitely_generated_module K add (opposite_ring_multiplication mul) I add (fun scalar x => mul x scalar).
Definition noetherian_ring : set -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K add mul => commutative_ring K add mul /\ left_noetherian_ring K add mul.
Definition god1_module_power_last_coordinate : set -> set -> set := fun n x => x n.
Definition god1_module_power_prefix : set -> set -> set := fun n x => fun i :e n => x i.
Axiom god1_coded_function_argument_congr : forall f x y , x = y -> f x = f y.
Axiom god1_module_homomorphism_restrict_to_submodules : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , module_homomorphism K addK mulK L addL smulL M addM smulM f -> forall A , submodule K addK mulK L addL smulL A -> forall B , submodule K addK mulK M addM smulM B -> (forall x :e A , f x :e B) -> module_homomorphism K addK mulK A addL smulL B addM smulM f.
Axiom god1_finitely_generated_module_carrier_eq_subst : forall K , forall addK mulK : set -> set -> set , forall A B , forall addM smul : set -> set -> set , A = B -> finitely_generated_module K addK mulK B addM smul -> finitely_generated_module K addK mulK A addM smul.
Axiom god1_isomorphic_module_finitely_generated_reverse : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulX : set -> set -> set , forall Y , forall addY smulY : set -> set -> set , isomorphic_modules K addK mulK X addX smulX Y addY smulY -> finitely_generated_module K addK mulK Y addY smulY -> finitely_generated_module K addK mulK X addX smulX.
Axiom god1_left_ideal_is_regular_submodule : forall K , forall addK mulK : set -> set -> set , forall I , left_ideal K addK mulK I -> submodule K addK mulK K addK mulK I.
Axiom god1_regular_submodule_is_left_ideal : forall K , forall addK mulK : set -> set -> set , forall I , submodule K addK mulK K addK mulK I -> left_ideal K addK mulK I.
Axiom god1_module_power_last_coordinate_homomorphism : forall K , forall addK mulK : set -> set -> set , forall n :e omega , ring K addK mulK -> module_homomorphism K addK mulK (K :^: ordsucc n) (module_power_addition (ordsucc n) addK) (module_power_left_scalar (ordsucc n) mulK) K addK mulK (god1_module_power_last_coordinate n).
Axiom god1_module_power_last_coordinate_surjective : forall K , forall n , surj (K :^: ordsucc n) K (god1_module_power_last_coordinate n).
Axiom god1_module_power_prefix_homomorphism : forall K , forall addK mulK : set -> set -> set , forall n :e omega , ring K addK mulK -> module_homomorphism K addK mulK (K :^: ordsucc n) (module_power_addition (ordsucc n) addK) (module_power_left_scalar (ordsucc n) mulK) (K :^: n) (module_power_addition n addK) (module_power_left_scalar n mulK) (god1_module_power_prefix n).
Axiom god1_module_power_submodule_kernel_prefix_isomorphism : forall K , forall addK mulK : set -> set -> set , forall n :e omega , ring K addK mulK -> forall N , submodule K addK mulK (K :^: ordsucc n) (module_power_addition (ordsucc n) addK) (module_power_left_scalar (ordsucc n) mulK) N -> submodule K addK mulK (K :^: n) (module_power_addition n addK) (module_power_left_scalar n mulK) (module_homomorphism_image (module_homomorphism_kernel K addK mulK N (module_power_addition (ordsucc n) addK) (module_power_left_scalar (ordsucc n) mulK) K addK mulK (god1_module_power_last_coordinate n)) (god1_module_power_prefix n)) /\ isomorphic_modules K addK mulK (module_homomorphism_kernel K addK mulK N (module_power_addition (ordsucc n) addK) (module_power_left_scalar (ordsucc n) mulK) K addK mulK (god1_module_power_last_coordinate n)) (module_power_addition (ordsucc n) addK) (module_power_left_scalar (ordsucc n) mulK) (module_homomorphism_image (module_homomorphism_kernel K addK mulK N (module_power_addition (ordsucc n) addK) (module_power_left_scalar (ordsucc n) mulK) K addK mulK (god1_module_power_last_coordinate n)) (god1_module_power_prefix n)) (module_power_addition n addK) (module_power_left_scalar n mulK).
Axiom god1_module_power_zero_submodule_eq : forall K , forall addK mulK : set -> set -> set , ring K addK mulK -> forall N , submodule K addK mulK (K :^: 0) (module_power_addition 0 addK) (module_power_left_scalar 0 mulK) N -> N = K :^: 0.
Axiom god1_s18_theorem2_noetherian_submodule_characterization : forall K , forall addK mulK : set -> set -> set , ring K addK mulK -> (left_noetherian_ring K addK mulK <-> forall M , forall addM smul : set -> set -> set , finitely_generated_module K addK mulK M addM smul -> forall N , submodule K addK mulK M addM smul N -> finitely_generated_module K addK mulK N addM smul).
Axiom god1_isomorphic_modules_reflexive : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , left_module K addK mulK M addM smul -> isomorphic_modules K addK mulK M addM smul M addM smul.
Axiom god1_isomorphic_modules_symmetric : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , isomorphic_modules K addK mulK L addL smulL M addM smulM -> isomorphic_modules K addK mulK M addM smulM L addL smulL.
Axiom god1_isomorphic_modules_transitive : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall N , forall addN smulN : set -> set -> set , isomorphic_modules K addK mulK L addL smulL M addM smulM -> isomorphic_modules K addK mulK M addM smulM N addN smulN -> isomorphic_modules K addK mulK L addL smulL N addN smulN.
Axiom god1_module_isomorphism_maps_basis : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall I , forall a : set -> set , forall f : set -> set , module_basis K addK mulK L addL smulL I a -> module_isomorphism K addK mulK L addL smulL M addM smulM f -> module_basis K addK mulK M addM smulM I (fun i => f (a i)).
Axiom god1_module_basis_gives_power_isomorphism : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall n :e omega , forall a : set -> set , module_basis K addK mulK M addM smul n a -> isomorphic_modules K addK mulK M addM smul (K :^: n) (module_power_addition n addK) (module_power_left_scalar n mulK).
Axiom god1_isomorphic_to_power_has_basis : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall n :e omega , ring K addK mulK -> isomorphic_modules K addK mulK M addM smul (K :^: n) (module_power_addition n addK) (module_power_left_scalar n mulK) -> exists b : set -> set , module_basis K addK mulK M addM smul n b.
Axiom god1_module_isomorphism_submodule_image : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , forall f : set -> set , module_isomorphism K addK mulK L addL smulL M addM smulM f -> forall A , submodule K addK mulK L addL smulL A -> isomorphic_modules K addK mulK A addL smulL (module_homomorphism_image A f) addM smulM.
Axiom god1_module_power_one_last_coordinate_isomorphism : forall K , forall addK mulK : set -> set -> set , ring K addK mulK -> module_isomorphism K addK mulK (K :^: 1) (module_power_addition 1 addK) (module_power_left_scalar 1 mulK) K addK mulK (god1_module_power_last_coordinate 0).
Axiom god1_regular_module_right_multiplication_homomorphism : forall K , forall addK mulK : set -> set -> set , ring K addK mulK -> forall a :e K , module_homomorphism K addK mulK K addK mulK K addK mulK (fun x => mulK x a).
Axiom god1_module_power_zero_is_singleton : forall K , forall addK mulK : set -> set -> set , ring K addK mulK -> K :^: 0 = {module_zero (K :^: 0) (module_power_addition 0 addK)}.
Axiom god1_singleton_modules_isomorphic : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , left_module K addK mulK L addL smulL -> left_module K addK mulK M addM smulM -> L = {module_zero L addL} -> M = {module_zero M addM} -> isomorphic_modules K addK mulK L addL smulL M addM smulM.
Axiom god1_isomorphic_to_singleton_is_singleton : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , isomorphic_modules K addK mulK L addL smulL M addM smulM -> M = {module_zero M addM} -> L = {module_zero L addL}.
Axiom god1_natural_subsingleton_zero_or_one : forall p :e omega , p c= 1 -> p = 0 \/ p = 1.
Definition left_ideal_free_generator_property : set -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K add mul => ring K add mul /\ forall I , left_ideal K add mul I -> I <> {ring_zero K add} -> isomorphic_modules K add mul I add mul K add mul.
Axiom god1_s18_theorem3_submodules_of_finite_free_modules : forall K , forall addK mulK : set -> set -> set , ring K addK mulK -> (left_ideal_free_generator_property K addK mulK <-> forall n :e omega , forall M , forall addM smul : set -> set -> set , forall a : set -> set , module_basis K addK mulK M addM smul n a -> forall N , submodule K addK mulK M addM smul N -> exists p :e omega , p c= n /\ exists b : set -> set , module_basis K addK mulK N addM smul p b).
Axiom god1_subring_of_integral_domain_is_integral_domain : forall K , forall add mul : set -> set -> set , forall A , integral_domain K add mul -> subring K add mul A -> integral_domain A add mul.
Axiom god1_integers_subring_of_reals : subring real add_SNo mul_SNo int.
Axiom god1_integers_integral_domain : integral_domain int add_SNo mul_SNo.
Axiom god1_integer_multiple_set_is_principal_ideal : forall p :e omega , {mul_SNo p k|k :e int} = principal_ideal int add_SNo mul_SNo p.
Axiom god1_integers_are_principal_ideal_domain : principal_ideal_domain int add_SNo mul_SNo.
Axiom god1_principal_ideal_zero_is_singleton : forall K , forall add mul : set -> set -> set , ring K add mul -> principal_ideal K add mul (ring_zero K add) = {ring_zero K add}.
Axiom god1_principal_ideal_domain_has_free_nonzero_left_ideals : forall K , forall add mul : set -> set -> set , principal_ideal_domain K add mul -> left_ideal_free_generator_property K add mul.
Axiom god1_integer_ring_zero_eq_zero : ring_zero int add_SNo = 0.
Axiom god1_integer_ring_one_eq_one : ring_one int mul_SNo = 1.
Axiom god1_integer_module_subgroup_is_submodule : forall M , forall addM smul : set -> set -> set , left_module int add_SNo mul_SNo M addM smul -> forall H , subgroup M addM H -> submodule int add_SNo mul_SNo M addM smul H.
Axiom god1_isomorphic_modules_are_isomorphic_additive_groups : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , isomorphic_modules K addK mulK L addL smulL M addM smulM -> isomorphic_groups L addL M addM.
Axiom god1_s18_corollary_subgroups_of_integer_powers_are_free : forall n :e omega , forall H , subgroup (int :^: n) (module_power_addition n add_SNo) H -> exists p :e omega , p c= n /\ isomorphic_groups H (module_power_addition n add_SNo) (int :^: p) (module_power_addition p add_SNo).
Axiom god1_canonical_module_basis_coordinates_eval : forall K , forall add mul : set -> set -> set , ring K add mul -> forall n :e omega , forall x :e K :^: n , forall i :e n , basis_coordinates K add mul (K :^: n) (module_power_addition n add) (module_power_left_scalar n mul) n (canonical_module_basis_vector K add mul n) x i = x i.
Axiom god1_module_power_zero_evaluation : forall K , forall add mul : set -> set -> set , ring K add mul -> forall I , forall i :e I , module_zero (K :^: I) (module_power_addition I add) i = ring_zero K add.
Definition homogeneous_linear_system_solution : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set -> set -> prop := fun K add mul p n A x => A :e matrix_space K p n /\ x :e K :^: n /\ forall i :e p , ring_finite_sum K add n (fun j => mul (matrix_entry A i j) (x j)) = ring_zero K add.
Definition homogeneous_linear_solution_space : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set -> set := fun K add mul p n A => {x :e K :^: n|homogeneous_linear_system_solution K add mul p n A x}.
Axiom god1_homogeneous_solution_space_kernel_representation : forall K , forall add mul : set -> set -> set , ring K add mul -> forall p n :e omega , forall A :e matrix_space K p n , exists F : set , module_homomorphism K add (opposite_ring_multiplication mul) (K :^: n) (module_power_addition n add) (module_power_left_scalar n (opposite_ring_multiplication mul)) (K :^: p) (module_power_addition p add) (module_power_left_scalar p (opposite_ring_multiplication mul)) (fun x => F x) /\ homogeneous_linear_solution_space K add mul p n A = module_homomorphism_kernel K add (opposite_ring_multiplication mul) (K :^: n) (module_power_addition n add) (module_power_left_scalar n (opposite_ring_multiplication mul)) (K :^: p) (module_power_addition p add) (module_power_left_scalar p (opposite_ring_multiplication mul)) (fun x => F x).
Axiom god1_right_noetherian_is_left_noetherian_opposite : forall K , forall add mul : set -> set -> set , right_noetherian_ring K add mul -> left_noetherian_ring K add (opposite_ring_multiplication mul).
Axiom god1_opposite_division_ring : forall K , forall add mul : set -> set -> set , division_ring K add mul -> division_ring K add (opposite_ring_multiplication mul).
Axiom god1_division_ring_has_free_nonzero_left_ideals : forall K , forall add mul : set -> set -> set , division_ring K add mul -> left_ideal_free_generator_property K add mul.
Axiom god1_commutative_left_free_property_opposite : forall K , forall add mul : set -> set -> set , commutative_ring K add mul -> left_ideal_free_generator_property K add mul -> left_ideal_free_generator_property K add (opposite_ring_multiplication mul).
Axiom god1_homogeneous_solution_modules_are_finite_over_finite_rings : forall K , forall add mul : set -> set -> set , forall p n :e omega , forall A :e matrix_space K p n , (right_noetherian_ring K add mul -> finitely_generated_module K add (opposite_ring_multiplication mul) (homogeneous_linear_solution_space K add mul p n A) (module_power_addition n add) (fun scalar x => module_power_left_scalar n (opposite_ring_multiplication mul) scalar x)) /\ ((division_ring K add mul \/ principal_ideal_domain K add mul) -> exists r :e omega , r c= n /\ isomorphic_modules K add (opposite_ring_multiplication mul) (homogeneous_linear_solution_space K add mul p n A) (module_power_addition n add) (fun scalar x => module_power_left_scalar n (opposite_ring_multiplication mul) scalar x) (K :^: r) (module_power_addition r add) (module_power_left_scalar r (opposite_ring_multiplication mul))).
Definition increasing_sequence_of_sets : set -> (set -> set) -> prop := fun X A => (forall n :e omega , A n c= X) /\ forall n :e omega , A n c= A (ordsucc n).
Definition stationary_sequence_of_sets : set -> (set -> set) -> prop := fun X A => (forall n :e omega , A n c= X) /\ exists p :e omega , forall n :e omega , p c= n -> A n = A p.
Definition maximal_element_by_inclusion : set -> set -> set -> prop := fun X F A => F c= Power X /\ A :e F /\ forall B :e F , A c= B -> B = A.
Axiom god1_increasing_sequence_is_cumulative : forall X , forall A : set -> set , increasing_sequence_of_sets X A -> forall m n :e omega , m c= n -> A m c= A n.
Definition god1_s18_union_member_index : (set -> set) -> set -> set := fun A x => Eps_i (fun n => n :e omega /\ x :e A n).
Axiom god1_nested_submodule_restriction : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall L N , submodule K addK mulK M addM smul L -> submodule K addK mulK M addM smul N -> N c= L -> submodule K addK mulK L addM smul N.
Axiom god1_nested_submodule_lift_to_ambient : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall L N , submodule K addK mulK M addM smul L -> submodule K addK mulK L addM smul N -> submodule K addK mulK M addM smul N.
Axiom god1_left_noetherian_increasing_ideal_chain_stationary : forall K , forall add mul : set -> set -> set , left_noetherian_ring K add mul -> forall A : set -> set , increasing_sequence_of_sets K A -> (forall n :e omega , left_ideal K add mul (A n)) -> stationary_sequence_of_sets K A.
Definition god1_s18_strict_extension : set -> set -> set := fun F I => Eps_i (fun J => J :e F /\ (I c= J /\ J <> I)).
Definition god1_s18_strict_extension_chain : set -> set -> set -> set := fun F I0 n => nat_primrec I0 (fun _ I => god1_s18_strict_extension F I) n.
Definition god1_s18_stationary_index : (set -> set) -> set := fun A => Eps_i (fun p => p :e omega /\ forall n :e omega , p c= n -> A n = A p).
Definition god1_s18_finitely_spanned_subideals : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set := fun K add mul I => {J :e Power I|exists n :e omega , exists a : set -> set , (forall k :e n , a k :e I) /\ J = submodule_generated_by_family K add mul I add mul n a}.
Definition god1_s18_append_generator : set -> (set -> set) -> set -> set -> set := fun n a x k => if k :e n then a k else x.
Definition god1_s18_finitely_spanned_extension_choice : set -> set -> set -> set := fun F J x => Eps_i (fun H => H :e F /\ (J c= H /\ x :e H)).
Definition god1_s18_maximal_member_choice : set -> set -> set := fun X F => Eps_i (fun J => maximal_element_by_inclusion X F J).
Axiom god1_s18_strict_extension_chain_specification : forall F I0 , I0 :e F -> (forall I :e F , exists J :e F , I c= J /\ J <> I) -> (forall n :e omega , god1_s18_strict_extension_chain F I0 n :e F) /\ (forall n :e omega , god1_s18_strict_extension_chain F I0 n c= god1_s18_strict_extension_chain F I0 (ordsucc n)) /\ (forall n :e omega , god1_s18_strict_extension_chain F I0 (ordsucc n) <> god1_s18_strict_extension_chain F I0 n).
Axiom god1_no_strict_extension_is_maximal_by_inclusion : forall X F I , F c= Power X -> I :e F -> (~ exists J :e F , I c= J /\ J <> I) -> maximal_element_by_inclusion X F I.
Axiom god1_s18_finitely_spanned_subideal_is_left_ideal : forall K , forall add mul : set -> set -> set , forall I J , left_ideal K add mul I -> J :e god1_s18_finitely_spanned_subideals K add mul I -> left_ideal K add mul J.
Axiom god1_s18_finitely_spanned_subideal_adjoin : forall K , forall add mul : set -> set -> set , forall I J x , left_ideal K add mul I -> J :e god1_s18_finitely_spanned_subideals K add mul I -> x :e I -> exists H :e god1_s18_finitely_spanned_subideals K add mul I , J c= H /\ x :e H.
Axiom god1_s18_finitely_spanned_subideals_nonempty : forall K , forall add mul : set -> set -> set , forall I , left_ideal K add mul I -> god1_s18_finitely_spanned_subideals K add mul I <> 0.
Axiom god1_s18_finitely_spanned_subideal_equal_carrier_is_finite : forall K , forall add mul : set -> set -> set , forall I J , left_ideal K add mul I -> J :e god1_s18_finitely_spanned_subideals K add mul I -> J = I -> finitely_generated_module K add mul I add mul.
Axiom god1_maximal_finitely_spanned_subideals_imply_left_noetherian : forall K , forall add mul : set -> set -> set , ring K add mul -> (forall F , F <> 0 -> (forall I :e F , left_ideal K add mul I) -> exists I , maximal_element_by_inclusion K F I) -> left_noetherian_ring K add mul.
Axiom god1_stationary_ideal_chains_have_maximal_family_member : forall K , forall add mul : set -> set -> set , ring K add mul -> (forall A : set -> set , increasing_sequence_of_sets K A -> (forall n :e omega , left_ideal K add mul (A n)) -> stationary_sequence_of_sets K A) -> forall F , F <> 0 -> (forall I :e F , left_ideal K add mul I) -> exists I , maximal_element_by_inclusion K F I.
Axiom god1_s18_theorem4_noetherian_chain_conditions : forall K , forall add mul : set -> set -> set , ring K add mul -> (left_noetherian_ring K add mul <-> (forall A : set -> set , increasing_sequence_of_sets K A -> (forall n :e omega , left_ideal K add mul (A n)) -> stationary_sequence_of_sets K A) /\ (forall F , F <> 0 -> (forall I :e F , left_ideal K add mul I) -> exists I , maximal_element_by_inclusion K F I)).
Definition maximal_left_ideal : set -> (set -> set -> set) -> (set -> set -> set) -> set -> prop := fun K add mul I => left_ideal K add mul I /\ I <> K /\ forall J , left_ideal K add mul J -> I c= J -> J = I \/ J = K.
Axiom god1_empty_family_adjoin_has_maximal_element : forall X G z , G = 0 -> (G :\/: {z}) c= Power X -> exists A , maximal_element_by_inclusion X (G :\/: {z}) A.
Axiom god1_adjoin_preserves_existence_of_maximal_element : forall X G z A , maximal_element_by_inclusion X G A -> z /:e G -> (G :\/: {z}) c= Power X -> exists C , maximal_element_by_inclusion X (G :\/: {z}) C.
Axiom god1_finite_family_maximal_induction_step : forall G z , finite G -> z /:e G -> (forall X , G <> 0 -> G c= Power X -> exists A , maximal_element_by_inclusion X G A) -> forall X , G :\/: {z} <> 0 -> (G :\/: {z}) c= Power X -> exists A , maximal_element_by_inclusion X (G :\/: {z}) A.
Axiom god1_finite_family_has_maximal_element_by_inclusion : forall X F , finite F -> F <> 0 -> F c= Power X -> exists A , maximal_element_by_inclusion X F A.
Definition right_vector_space : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K addK mulK M addM smulR => division_ring K addK mulK /\ right_module K addK mulK M addM smulR.
Definition finite_dimensional_right_vector_space : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K addK mulK M addM smulR => right_vector_space K addK mulK M addM smulR /\ exists I , finite I /\ exists a : set -> set , generating_family K addK (opposite_ring_multiplication mulK) M addM (fun scalar x => smulR x scalar) I a.
Definition god1_independent_superset_family : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set := fun K addK mulK M addM smul X A => {B :e Power X|A c= B /\ linearly_independent_family K addK mulK M addM smul B (fun x => x)}.
Axiom god1_finite_maximal_independent_superset : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall X A , finite X -> A c= X -> linearly_independent_family K addK mulK M addM smul A (fun x => x) -> exists B , A c= B /\ B c= X /\ linearly_independent_family K addK mulK M addM smul B (fun x => x) /\ forall C , B c= C -> C c= X -> linearly_independent_family K addK mulK M addM smul C (fun x => x) -> C = B.
Axiom god1_linear_relation_remove_zero_adjoined_coefficient : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall B x , forall a coeff : set -> set , left_module K addK mulK M addM smul -> finite B -> x /:e B -> (forall i :e SetAdjoin B x , a i :e M) -> linear_relation K addK mulK M addM smul (SetAdjoin B x) a coeff -> coeff x = ring_zero K addK -> linear_relation K addK mulK M addM smul B a coeff.
Axiom god1_linear_combination_value_congr : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , forall x y , x = y -> linear_combination K addK mulK M addM smul I a x -> linear_combination K addK mulK M addM smul I a y.
Axiom god1_linear_representation_adjoin_decomposition : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall B x , forall a : set -> set , forall v , forall coeff : set -> set , left_module K addK mulK M addM smul -> finite B -> x /:e B -> (forall i :e SetAdjoin B x , a i :e M) -> linear_representation K addK mulK M addM smul (SetAdjoin B x) a v coeff -> v = addM (module_finitely_supported_sum M addM B (fun i => smul (coeff i) (a i))) (smul (coeff x) (a x)).
Axiom god1_dependent_adjoin_has_relation_nonzero_new_coefficient : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall B x , finite B -> linearly_independent_family K addK mulK M addM smul B (fun y => y) -> x :e M -> x /:e B -> ~ linearly_independent_family K addK mulK M addM smul (SetAdjoin B x) (fun y => y) -> exists coeff : set -> set , linear_relation K addK mulK M addM smul (SetAdjoin B x) (fun y => y) coeff /\ coeff x <> ring_zero K addK.
Axiom god1_group_inverse_right_product : forall G , forall op : set -> set -> set , group G op -> forall x :e G , op x (group_inverse G op x) = group_identity G op.
Axiom god1_division_ring_relation_solves_adjoined_vector : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall B x , forall coeff : set -> set , division_ring K addK mulK -> left_module K addK (opposite_ring_multiplication mulK) M addM smul -> finite B -> x /:e B -> (forall y :e SetAdjoin B x , y :e M) -> linear_relation K addK (opposite_ring_multiplication mulK) M addM smul (SetAdjoin B x) (fun y => y) coeff -> coeff x <> ring_zero K addK -> linear_combination K addK (opposite_ring_multiplication mulK) M addM smul B (fun y => y) x.
Axiom god1_finite_family_span_is_submodule : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , left_module K addK mulK M addM smul -> finite I -> (forall i :e I , a i :e M) -> submodule K addK mulK M addM smul (submodule_generated_by_family K addK mulK M addM smul I a).
Axiom god1_finite_generation_reduction_through_span : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall X B , left_module K addK mulK M addM smul -> finite B -> generating_family K addK mulK M addM smul X (fun x => x) -> B c= X -> (forall x :e X , linear_combination K addK mulK M addM smul B (fun y => y) x) -> generating_family K addK mulK M addM smul B (fun y => y).
Axiom god1_maximal_independent_outside_vector_in_span : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall X B x , division_ring K addK mulK -> left_module K addK (opposite_ring_multiplication mulK) M addM smul -> finite B -> B c= X -> (forall y :e X , y :e M) -> linearly_independent_family K addK (opposite_ring_multiplication mulK) M addM smul B (fun y => y) -> (forall C , B c= C -> C c= X -> linearly_independent_family K addK (opposite_ring_multiplication mulK) M addM smul C (fun y => y) -> C = B) -> x :e X -> x /:e B -> linear_combination K addK (opposite_ring_multiplication mulK) M addM smul B (fun y => y) x.
Axiom god1_finite_spanning_independent_subset_extends_to_basis : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , forall X A , right_vector_space K addK mulK M addM smulR -> finite X -> generating_family K addK (opposite_ring_multiplication mulK) M addM (fun scalar y => smulR y scalar) X (fun y => y) -> A c= X -> linearly_independent_family K addK (opposite_ring_multiplication mulK) M addM (fun scalar y => smulR y scalar) A (fun y => y) -> exists B , A c= B /\ B c= X /\ right_module_basis K addK mulK M addM smulR B (fun y => y).
Axiom god1_finite_generating_family_image_generates : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , left_module K addK mulK M addM smul -> finite I -> generating_family K addK mulK M addM smul I a -> generating_family K addK mulK M addM smul {a i|i :e I} (fun y => y).
Axiom god1_finite_dimensional_right_space_has_ordinal_basis : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , finite_dimensional_right_vector_space K addK mulK M addM smulR -> exists n :e omega , exists a : set -> set , right_module_basis K addK mulK M addM smulR n a.
Axiom god1_linear_representation_extend_index_by_zero : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I J , forall a : set -> set , forall x , forall coeff : set -> set , left_module K addK mulK M addM smul -> finite J -> J c= I -> (forall i :e I , a i :e M) -> linear_representation K addK mulK M addM smul J a x coeff -> linear_representation K addK mulK M addM smul I a x (fun i => if i :e J then coeff i else ring_zero K addK).
Axiom god1_linearly_independent_finite_subfamily : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I J , forall a : set -> set , finite J -> J c= I -> linearly_independent_family K addK mulK M addM smul I a -> linearly_independent_family K addK mulK M addM smul J a.
Axiom god1_linearly_independent_index_map_injective : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , ring K addK mulK -> ring_one K mulK <> ring_zero K addK -> linearly_independent_family K addK mulK M addM smul I a -> inj I M a.
Axiom god1_linearly_independent_family_pointwise_congr : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a b : set -> set , linearly_independent_family K addK mulK M addM smul I a -> (forall i :e I , a i = b i) -> linearly_independent_family K addK mulK M addM smul I b.
Axiom god1_finite_generating_family_superset_generates : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall G X , left_module K addK mulK M addM smul -> finite X -> G c= X -> (forall x :e X , x :e M) -> generating_family K addK mulK M addM smul G (fun y => y) -> generating_family K addK mulK M addM smul X (fun y => y).
Definition god1_s19_fresh_basis_tag : set -> set := fun y => Inj0 (Inj1 y).
Definition god1_s19_extended_basis_map : set -> (set -> set) -> set -> set := fun p x t => if t :e p then x t else Unj (Unj t).
Axiom god1_s19_fresh_basis_tag_not_ordinal : forall y , ~ ordinal (god1_s19_fresh_basis_tag y).
Axiom god1_s19_fresh_basis_tag_notin_natural : forall p :e omega , forall y , god1_s19_fresh_basis_tag y /:e p.
Axiom god1_s19_fresh_basis_tag_injective : forall y z , god1_s19_fresh_basis_tag y = god1_s19_fresh_basis_tag z -> y = z.
Axiom god1_s19_fresh_basis_tag_untag : forall y , Unj (Unj (god1_s19_fresh_basis_tag y)) = y.
Axiom god1_s19_fresh_tag_image_bijection : forall C , bij {god1_s19_fresh_basis_tag y|y :e C} C (fun t => Unj (Unj t)).
Axiom god1_bijection_disjoint_union_piecewise : forall P D A C , forall f g : set -> set , (forall d :e D , d /:e P) -> (forall c :e C , c /:e A) -> bij P A f -> bij D C g -> bij (P :\/: D) (A :\/: C) (fun t => if t :e P then f t else g t).
Axiom god1_s19_extended_basis_map_original : forall p , forall x : set -> set , forall i :e p , god1_s19_extended_basis_map p x i = x i.
Axiom god1_s19_extended_basis_map_fresh : forall p :e omega , forall x : set -> set , forall y , god1_s19_extended_basis_map p x (god1_s19_fresh_basis_tag y) = y.
Axiom god1_s19_basis_extension_implies_independent : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , forall p B , forall x b : set -> set , finite p -> p c= B -> right_module_basis K addK mulK M addM smulR B b -> (forall i :e p , b i = x i) -> linearly_independent_family K addK (opposite_ring_multiplication mulK) M addM (fun scalar y => smulR y scalar) p x.
Axiom god1_s19_finite_independent_family_extends_to_finite_basis : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , forall p :e omega , forall x : set -> set , finite_dimensional_right_vector_space K addK mulK M addM smulR -> linearly_independent_family K addK (opposite_ring_multiplication mulK) M addM (fun scalar y => smulR y scalar) p x -> exists B , finite B /\ p c= B /\ exists b : set -> set , right_module_basis K addK mulK M addM smulR B b /\ forall i :e p , b i = x i.
Axiom god1_s19_finite_independent_family_extends_to_basis : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , forall p :e omega , forall x : set -> set , finite_dimensional_right_vector_space K addK mulK M addM smulR -> linearly_independent_family K addK (opposite_ring_multiplication mulK) M addM (fun scalar y => smulR y scalar) p x -> exists B , p c= B /\ exists b : set -> set , right_module_basis K addK mulK M addM smulR B b /\ forall i :e p , b i = x i.
Axiom god1_s19_theorem2_extension_interface : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , forall X A , right_vector_space K addK mulK M addM smulR -> finite X -> generating_family K addK (opposite_ring_multiplication mulK) M addM (fun scalar x => smulR x scalar) X (fun x => x) -> A c= X -> linearly_independent_family K addK (opposite_ring_multiplication mulK) M addM (fun scalar x => smulR x scalar) A (fun x => x) -> exists B , A c= B /\ B c= X /\ right_module_basis K addK mulK M addM smulR B (fun x => x).
Axiom god1_s19_theorem1_finite_dimensional_space_has_basis : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , finite_dimensional_right_vector_space K addK mulK M addM smulR -> exists n :e omega , exists a : set -> set , right_module_basis K addK mulK M addM smulR n a.
Axiom god1_s19_theorem2_extend_independent_subset_to_basis : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , forall X A , right_vector_space K addK mulK M addM smulR -> finite X -> generating_family K addK (opposite_ring_multiplication mulK) M addM (fun scalar x => smulR x scalar) X (fun x => x) -> A c= X -> linearly_independent_family K addK (opposite_ring_multiplication mulK) M addM (fun scalar x => smulR x scalar) A (fun x => x) -> exists B , A c= B /\ B c= X /\ right_module_basis K addK mulK M addM smulR B (fun x => x).
Axiom god1_s19_corollary1_independent_family_extends_to_basis : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , forall p :e omega , forall x : set -> set , finite_dimensional_right_vector_space K addK mulK M addM smulR -> ((exists B , p c= B /\ exists b : set -> set , right_module_basis K addK mulK M addM smulR B b /\ forall i :e p , b i = x i) <-> linearly_independent_family K addK (opposite_ring_multiplication mulK) M addM (fun scalar y => smulR y scalar) p x).
Axiom god1_group_word_product_carrier_congr : forall G H , forall op : set -> set -> set , forall f : set -> set , forall n , group_identity G op = group_identity H op -> nat_p n -> group_word_product G op f n = group_word_product H op f n.
Axiom god1_ring_finite_sum_carrier_congr : forall G H , forall op : set -> set -> set , forall X , finite X -> forall f : set -> set , group_identity G op = group_identity H op -> ring_finite_sum G op X f = ring_finite_sum H op X f.
Axiom god1_submodule_finitely_supported_sum_agrees_with_ambient : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall N , submodule K addK mulK L addL smul N -> forall I , forall f : set -> set , almost_all_zero I (module_zero N addL) f -> module_finitely_supported_sum N addL I f = module_finitely_supported_sum L addL I f.
Axiom god1_submodule_independent_family_is_ambient_independent : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall N , forall I , forall a : set -> set , submodule K addK mulK L addL smul N -> linearly_independent_family K addK mulK N addL smul I a -> linearly_independent_family K addK mulK L addL smul I a.
Axiom god1_s19_corollary2_every_subspace_has_complement : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , forall N , finite_dimensional_right_vector_space K addK mulK M addM smulR -> submodule K addK (opposite_ring_multiplication mulK) M addM (fun scalar x => smulR x scalar) N -> direct_summand K addK (opposite_ring_multiplication mulK) M addM (fun scalar x => smulR x scalar) N.
Definition right_subspace_annihilator : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> set := fun K addK mulK L addL smulR M => {f :e right_module_dual K addK mulK L addL smulR|forall x :e M , f x = ring_zero K addK}.
Axiom god1_annihilator_is_vector_subspace : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulR : set -> set -> set , forall M , right_vector_space K addK mulK L addL smulR -> submodule K addK (opposite_ring_multiplication mulK) L addL (fun scalar x => smulR x scalar) M -> vector_subspace K addK mulK (right_module_dual K addK mulK L addL smulR) (right_module_dual_addition L addK) (right_module_dual_left_scalar L mulK) (right_subspace_annihilator K addK mulK L addL smulR M).
Axiom god1_s19_finite_dimensional_subspace_has_basis : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulR : set -> set -> set , forall M , finite_dimensional_right_vector_space K addK mulK L addL smulR -> submodule K addK (opposite_ring_multiplication mulK) L addL (fun scalar x => smulR x scalar) M -> exists p :e omega , exists b : set -> set , module_basis K addK (opposite_ring_multiplication mulK) M addL (fun scalar x => smulR x scalar) p b.
Axiom god1_submodule_linear_representation_is_ambient : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall N , forall I , forall a : set -> set , forall x , forall coeff : set -> set , submodule K addK mulK L addL smul N -> (forall i :e I , a i :e N) -> linear_representation K addK mulK N addL smul I a x coeff -> linear_representation K addK mulK L addL smul I a x coeff.
Axiom god1_finite_independent_family_image : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall I , forall a : set -> set , ring K addK mulK -> ring_one K mulK <> ring_zero K addK -> finite I -> linearly_independent_family K addK mulK L addL smul I a -> bij I {a i|i :e I} a /\ linearly_independent_family K addK mulK L addL smul {a i|i :e I} (fun y => y).
Axiom god1_s19_outside_subspace_has_separating_coordinate : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulR : set -> set -> set , forall M , forall x :e L , finite_dimensional_right_vector_space K addK mulK L addL smulR -> submodule K addK (opposite_ring_multiplication mulK) L addL (fun scalar y => smulR y scalar) M -> x /:e M -> exists f :e right_subspace_annihilator K addK mulK L addL smulR M , f x <> ring_zero K addK.
Axiom god1_s19_theorem3_double_annihilator_membership : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulR : set -> set -> set , forall M , finite_dimensional_right_vector_space K addK mulK L addL smulR -> submodule K addK (opposite_ring_multiplication mulK) L addL (fun scalar x => smulR x scalar) M -> forall x :e L , (x :e M <-> forall f :e right_subspace_annihilator K addK mulK L addL smulR M , f x = ring_zero K addK).
Axiom god1_module_finitely_supported_sum_constant_zero : forall M , forall addM : set -> set -> set , forall I , module_finitely_supported_sum M addM I (fun _ : set => module_zero M addM) = module_zero M addM.
Axiom god1_s19_theorem3_corollary1_subspace_defined_by_annihilator_generators : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulR : set -> set -> set , forall M I , forall f : set -> set , finite_dimensional_right_vector_space K addK mulK L addL smulR -> submodule K addK (opposite_ring_multiplication mulK) L addL (fun scalar x => smulR x scalar) M -> generating_family K addK mulK (right_subspace_annihilator K addK mulK L addL smulR M) (right_module_dual_addition L addK) (right_module_dual_left_scalar L mulK) I f -> forall x :e L , (x :e M <-> forall i :e I , f i x = ring_zero K addK).
Axiom god1_s19_theorem3_corollary2_proper_subspace_has_nonzero_form : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulR : set -> set -> set , forall M , finite_dimensional_right_vector_space K addK mulK L addL smulR -> submodule K addK (opposite_ring_multiplication mulK) L addL (fun scalar x => smulR x scalar) M -> (M <> L <-> exists f :e right_module_dual K addK mulK L addL smulR , f <> (fun x :e L => ring_zero K addK) /\ forall x :e M , f x = ring_zero K addK).
Axiom god1_right_module_dual_finite_sum_evaluation : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , forall I , forall g : set -> set , right_module K addK mulK M addM smulR -> finite I -> (forall i :e I , g i :e right_module_dual K addK mulK M addM smulR) -> forall x :e M , (module_finitely_supported_sum (right_module_dual K addK mulK M addM smulR) (right_module_dual_addition M addK) I g) x = ring_finite_sum K addK I (fun i => g i x).
Axiom god1_s19_theorem4_independent_forms_iff_all_values_attained : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , forall r :e omega , forall f : set -> set , right_vector_space K addK mulK M addM smulR -> (forall i :e r , f i :e right_module_dual K addK mulK M addM smulR) -> (linearly_independent_family K addK mulK (right_module_dual K addK mulK M addM smulR) (right_module_dual_addition M addK) (right_module_dual_left_scalar M mulK) r f <-> forall beta :e K :^: r , exists x :e M , forall i :e r , f i x = beta i).
Definition linear_system_consistency_conditions : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> (set -> set -> set) -> set -> prop := fun K addK mulK n r rho beta => forall j :e n , j /:e r -> beta j = ring_finite_sum K addK r (fun k => mulK (rho j k) (beta k)).
Axiom god1_s19_theorem5_consistency_of_dependent_linear_equations : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , forall n r :e omega , forall f : set -> set , forall rho : set -> set -> set , forall beta :e K :^: n , right_vector_space K addK mulK M addM smulR -> r c= n -> linearly_independent_family K addK mulK (right_module_dual K addK mulK M addM smulR) (right_module_dual_addition M addK) (right_module_dual_left_scalar M mulK) r f -> (forall j :e n , j /:e r -> forall k :e r , rho j k :e K) -> (forall j :e n , j /:e r -> f j = module_finitely_supported_sum (right_module_dual K addK mulK M addM smulR) (right_module_dual_addition M addK) r (fun k => right_module_dual_left_scalar M mulK (rho j k) (f k))) -> ((exists x :e M , forall i :e n , f i x = beta i) <-> forall j :e n , j /:e r -> beta j = ring_finite_sum K addK r (fun k => mulK (rho j k) (beta k))) /\ ((forall j :e n , j /:e r -> beta j = ring_finite_sum K addK r (fun k => mulK (rho j k) (beta k))) -> {x :e M|forall i :e n , f i x = beta i} = {x :e M|forall i :e r , f i x = beta i}).
Axiom god1_independent_family_shear_prefix : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I s , forall b nu : set -> set , left_module K addK mulK M addM smul -> finite I -> s /:e I -> linearly_independent_family K addK mulK M addM smul (SetAdjoin I s) b -> (forall i :e I , nu i :e K) -> linearly_independent_family K addK mulK M addM smul I (fun i => addM (b i) (smul (nu i) (b s))).
Axiom god1_linear_combination_chosen_coordinate_representation : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , forall x , left_module K addK mulK M addM smul -> linear_combination K addK mulK M addM smul I a x -> linear_representation K addK mulK M addM smul I a x (fun i => basis_coordinates K addK mulK M addM smul I a x i).
Axiom god1_linearly_independent_family_member_nonzero : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , division_ring K addK mulK -> linearly_independent_family K addK mulK M addM smul I a -> forall i :e I , a i <> module_zero M addM.
Axiom god1_division_ring_elimination_coefficient : forall K , forall addK mulK : set -> set -> set , division_ring K addK mulK -> forall alpha beta :e K , beta <> ring_zero K addK -> addK alpha (mulK (mulK (ring_negation K addK alpha) (ring_inverse K addK mulK beta)) beta) = ring_zero K addK.
Axiom god1_linear_combination_eliminate_last_generator : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I s , forall a : set -> set , forall x y , forall coeff eta : set -> set , division_ring K addK mulK -> left_module K addK mulK M addM smul -> finite I -> s /:e I -> (forall i :e SetAdjoin I s , a i :e M) -> x :e M -> y :e M -> linear_representation K addK mulK M addM smul (SetAdjoin I s) a x coeff -> linear_representation K addK mulK M addM smul (SetAdjoin I s) a y eta -> eta s <> ring_zero K addK -> linear_combination K addK mulK M addM smul I a (addM x (smul (mulK (ring_negation K addK (coeff s)) (ring_inverse K addK mulK (eta s))) y)).
Axiom god1_linear_representation_zero_last_is_prefix_combination : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I s , forall a : set -> set , forall x , forall coeff : set -> set , left_module K addK mulK M addM smul -> finite I -> s /:e I -> (forall i :e SetAdjoin I s , a i :e M) -> x :e M -> linear_representation K addK mulK M addM smul (SetAdjoin I s) a x coeff -> coeff s = ring_zero K addK -> linear_combination K addK mulK M addM smul I a x.
Axiom god1_independent_family_pivot_elimination : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I s , forall a : set -> set , forall J t , forall b : set -> set , division_ring K addK mulK -> left_module K addK mulK M addM smul -> finite I -> s /:e I -> (forall i :e SetAdjoin I s , a i :e M) -> finite J -> t /:e J -> linearly_independent_family K addK mulK M addM smul (SetAdjoin J t) b -> (forall j :e SetAdjoin J t , linear_combination K addK mulK M addM smul (SetAdjoin I s) a (b j)) -> basis_coordinates K addK mulK M addM smul (SetAdjoin I s) a (b t) s <> ring_zero K addK -> linearly_independent_family K addK mulK M addM smul J (fun j => addM (b j) (smul (mulK (ring_negation K addK (basis_coordinates K addK mulK M addM smul (SetAdjoin I s) a (b j) s)) (ring_inverse K addK mulK (basis_coordinates K addK mulK M addM smul (SetAdjoin I s) a (b t) s))) (b t))) /\ forall j :e J , linear_combination K addK mulK M addM smul I a (addM (b j) (smul (mulK (ring_negation K addK (basis_coordinates K addK mulK M addM smul (SetAdjoin I s) a (b j) s)) (ring_inverse K addK mulK (basis_coordinates K addK mulK M addM smul (SetAdjoin I s) a (b t) s))) (b t))).
Axiom god1_pivot_elimination_induction_step : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I s , forall a : set -> set , forall J t , forall b : set -> set , division_ring K addK mulK -> left_module K addK mulK M addM smul -> finite I -> s /:e I -> (forall i :e SetAdjoin I s , a i :e M) -> finite J -> t /:e J -> linearly_independent_family K addK mulK M addM smul (SetAdjoin J t) b -> (forall j :e SetAdjoin J t , linear_combination K addK mulK M addM smul (SetAdjoin I s) a (b j)) -> basis_coordinates K addK mulK M addM smul (SetAdjoin I s) a (b t) s <> ring_zero K addK -> (forall y : set -> set , linearly_independent_family K addK mulK M addM smul J y -> (forall j :e J , linear_combination K addK mulK M addM smul I a (y j)) -> False) -> False.
Axiom god1_independent_successor_family_not_spanned_by_prefix : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , division_ring K addK mulK -> left_module K addK mulK M addM smul -> forall p :e omega , forall a x : set -> set , (forall i :e p , a i :e M) -> linearly_independent_family K addK mulK M addM smul (ordsucc p) x -> (forall j :e ordsucc p , linear_combination K addK mulK M addM smul p a (x j)) -> False.
Axiom god1_finite_spanning_family_bounds_independent_family : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , division_ring K addK mulK -> left_module K addK mulK M addM smul -> forall p q :e omega , forall a x : set -> set , generating_family K addK mulK M addM smul p a -> linearly_independent_family K addK mulK M addM smul q x -> q c= p.
Axiom god1_dependent_family_has_nontrivial_relation : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall I , forall a : set -> set , left_module K addK mulK M addM smul -> (forall i :e I , a i :e M) -> ~ linearly_independent_family K addK mulK M addM smul I a -> exists coeff : set -> set , linear_relation K addK mulK M addM smul I a coeff /\ exists i :e I , coeff i <> ring_zero K addK.
Axiom god1_s19_theorem7_size_bound_interface : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , forall p q :e omega , forall a x : set -> set , right_vector_space K addK mulK M addM smulR -> right_module_basis K addK mulK M addM smulR p a -> linearly_independent_family K addK (opposite_ring_multiplication mulK) M addM (fun scalar y => smulR y scalar) q x -> q c= p.
Axiom god1_s19_theorem6_all_bases_have_same_size : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , forall p q :e omega , forall a b : set -> set , right_vector_space K addK mulK M addM smulR -> right_module_basis K addK mulK M addM smulR p a -> right_module_basis K addK mulK M addM smulR q b -> p = q.
Axiom god1_s19_theorem7_independent_family_no_larger_than_basis : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , forall p q :e omega , forall a x : set -> set , right_vector_space K addK mulK M addM smulR -> right_module_basis K addK mulK M addM smulR p a -> linearly_independent_family K addK (opposite_ring_multiplication mulK) M addM (fun scalar y => smulR y scalar) q x -> q c= p.
Axiom god1_s19_theorem7_corollary_underdetermined_homogeneous_system : forall K , forall add mul : set -> set -> set , forall n p :e omega , forall A :e matrix_space K n p , division_ring K add mul -> n :e p -> exists x :e K :^: p , homogeneous_linear_system_solution K add mul n p A x /\ x <> (fun j :e p => ring_zero K add).
Definition module_dimension : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set := fun K addK mulK M addM smul => Eps_i (fun n => n :e omega /\ exists a : set -> set , module_basis K addK mulK M addM smul n a).
Definition right_vector_dimension : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set := fun K addK mulK M addM smulR => module_dimension K addK (opposite_ring_multiplication mulK) M addM (fun scalar x => smulR x scalar).
Axiom god1_dimension_is_size_of_every_basis : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smulR : set -> set -> set , forall n :e omega , forall a : set -> set , right_vector_space K addK mulK M addM smulR -> right_module_basis K addK mulK M addM smulR n a -> right_vector_dimension K addK mulK M addM smulR = n.
Axiom god1_module_dimension_is_size_of_every_basis : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall n :e omega , forall a : set -> set , division_ring K addK mulK -> left_module K addK mulK M addM smul -> module_basis K addK mulK M addM smul n a -> module_dimension K addK mulK M addM smul = n.
Axiom god1_s19_theorem8_isomorphic_iff_same_dimension : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulL : set -> set -> set , forall M , forall addM smulM : set -> set -> set , finite_dimensional_right_vector_space K addK mulK L addL smulL -> finite_dimensional_right_vector_space K addK mulK M addM smulM -> (isomorphic_modules K addK (opposite_ring_multiplication mulK) L addL (fun scalar x => smulL x scalar) M addM (fun scalar x => smulM x scalar) <-> right_vector_dimension K addK mulK L addL smulL = right_vector_dimension K addK mulK M addM smulM).
Axiom god1_dual_basis_of_finite_right_module_basis : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smulR : set -> set -> set , forall n :e omega , forall a : set -> set , right_module_basis K addK mulK X addX smulR n a -> module_basis K addK mulK (right_module_dual K addK mulK X addX smulR) (right_module_dual_addition X addK) (right_module_dual_left_scalar X mulK) n (fun i => fun x :e X => right_module_dual_basis_vector K addK mulK X addX smulR n a i x).
Axiom god1_dimension_of_power_product_and_dual : forall K , forall addK mulK : set -> set -> set , forall n :e omega , division_ring K addK mulK -> right_vector_dimension K addK mulK (K :^: n) (module_power_addition n addK) (fun x scalar => module_power_left_scalar n (opposite_ring_multiplication mulK) scalar x) = n /\ module_dimension K addK mulK (right_module_dual K addK mulK (K :^: n) (module_power_addition n addK) (fun x scalar => module_power_left_scalar n (opposite_ring_multiplication mulK) scalar x)) (right_module_dual_addition (K :^: n) addK) (right_module_dual_left_scalar (K :^: n) mulK) = n.
Axiom god1_module_basis_pointwise_congr : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smul : set -> set -> set , forall I , forall a b : set -> set , module_basis K addK mulK X addX smul I a -> (forall i :e I , a i = b i) -> module_basis K addK mulK X addX smul I b.
Axiom god1_ambient_independent_family_is_submodule_independent : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smul : set -> set -> set , forall Y , forall I , forall a : set -> set , submodule K addK mulK X addX smul Y -> (forall i :e I , a i :e Y) -> linearly_independent_family K addK mulK X addX smul I a -> linearly_independent_family K addK mulK Y addX smul I a.
Axiom god1_finite_subspace_has_adapted_natural_ambient_basis : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulR : set -> set -> set , forall M , finite_dimensional_right_vector_space K addK mulK L addL smulR -> submodule K addK (opposite_ring_multiplication mulK) L addL (fun scalar x => smulR x scalar) M -> exists p :e omega , exists n :e omega , exists P , P c= n /\ equip P p /\ exists a : set -> set , module_basis K addK (opposite_ring_multiplication mulK) M addL (fun scalar x => smulR x scalar) P a /\ right_module_basis K addK mulK L addL smulR n a.
Axiom god1_adapted_basis_gives_annihilator_tail_basis : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulR : set -> set -> set , forall M , forall p n :e omega , forall P , forall a : set -> set , right_vector_space K addK mulK L addL smulR -> submodule K addK (opposite_ring_multiplication mulK) L addL (fun scalar x => smulR x scalar) M -> P c= n -> equip P p -> module_basis K addK (opposite_ring_multiplication mulK) M addL (fun scalar x => smulR x scalar) P a -> right_module_basis K addK mulK L addL smulR n a -> exists q :e omega , p + q = n /\ exists d : set -> set , module_basis K addK mulK (right_subspace_annihilator K addK mulK L addL smulR M) (right_module_dual_addition L addK) (right_module_dual_left_scalar L mulK) q d.
Axiom god1_s19_section2_remark2_annihilator_dimension_interface : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulR : set -> set -> set , forall M , finite_dimensional_right_vector_space K addK mulK L addL smulR -> submodule K addK (opposite_ring_multiplication mulK) L addL (fun scalar x => smulR x scalar) M -> right_vector_dimension K addK mulK M addL smulR + module_dimension K addK mulK (right_subspace_annihilator K addK mulK L addL smulR M) (right_module_dual_addition L addK) (right_module_dual_left_scalar L mulK) = right_vector_dimension K addK mulK L addL smulR.
Axiom god1_natural_surreal_sum_bounds_left : forall m q n :e omega , m + q = n -> m c= n.
Axiom god1_zero_index_basis_every_vector_zero : forall K , forall addK mulK : set -> set -> set , forall X , forall addX smul : set -> set -> set , forall a : set -> set , module_basis K addK mulK X addX smul 0 a -> forall x :e X , x = module_zero X addX.
Axiom god1_right_module_dual_zero_evaluation : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulR : set -> set -> set , right_module K addK mulK L addL smulR -> forall x :e L , (module_zero (right_module_dual K addK mulK L addL smulR) (right_module_dual_addition L addK)) x = ring_zero K addK.
Axiom god1_finite_subspace_annihilator_has_finite_basis : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulR : set -> set -> set , forall M , finite_dimensional_right_vector_space K addK mulK L addL smulR -> submodule K addK (opposite_ring_multiplication mulK) L addL (fun scalar x => smulR x scalar) M -> exists q :e omega , exists d : set -> set , module_basis K addK mulK (right_subspace_annihilator K addK mulK L addL smulR M) (right_module_dual_addition L addK) (right_module_dual_left_scalar L mulK) q d.
Axiom god1_finite_subspace_dimensions_are_natural : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulR : set -> set -> set , forall M , finite_dimensional_right_vector_space K addK mulK L addL smulR -> submodule K addK (opposite_ring_multiplication mulK) L addL (fun scalar x => smulR x scalar) M -> (right_vector_dimension K addK mulK M addL smulR :e omega /\ module_dimension K addK mulK (right_subspace_annihilator K addK mulK L addL smulR M) (right_module_dual_addition L addK) (right_module_dual_left_scalar L mulK) :e omega) /\ right_vector_dimension K addK mulK L addL smulR :e omega.
Axiom god1_s19_theorem9_dimension_of_annihilator : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulR : set -> set -> set , forall M , finite_dimensional_right_vector_space K addK mulK L addL smulR -> submodule K addK (opposite_ring_multiplication mulK) L addL (fun scalar x => smulR x scalar) M -> right_vector_dimension K addK mulK M addL smulR + module_dimension K addK mulK (right_subspace_annihilator K addK mulK L addL smulR M) (right_module_dual_addition L addK) (right_module_dual_left_scalar L mulK) = right_vector_dimension K addK mulK L addL smulR.
Axiom god1_s19_theorem9_corollary_subspace_dimension_bound : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smulR : set -> set -> set , forall M , finite_dimensional_right_vector_space K addK mulK L addL smulR -> submodule K addK (opposite_ring_multiplication mulK) L addL (fun scalar x => smulR x scalar) M -> right_vector_dimension K addK mulK M addL smulR c= right_vector_dimension K addK mulK L addL smulR /\ (right_vector_dimension K addK mulK M addL smulR = right_vector_dimension K addK mulK L addL smulR <-> M = L).
Axiom god1_natural_atleastp_implies_subset : forall p :e omega , forall q :e omega , atleastp p q -> p c= q.
Definition independent_family_size_bound : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> prop := fun K addK mulK M addM smul n => forall I , finite I -> forall x : set -> set , linearly_independent_family K addK mulK M addM smul I x -> finite_cardinality I c= n.
