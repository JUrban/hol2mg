Section form81.
Definition is_null_set_Rn : set -> set -> prop := fun n S => n :e omega /\ S c= (Rn n) /\ forall eps :e R , 0 < eps -> exists cseq :e setexp (Rn n) omega , exists rseq :e setexp R omega , (forall k :e omega , 0 < rseq k) /\ S c= (\/_ k :e omega , ms_ball (Rn n) (Rn_dist n) (cseq k) (rseq k)) /\ sum_series (fun k => pow_R (rseq k) n) < eps.
Axiom is_null_set_Rn_nat : forall n , forall S , is_null_set_Rn n S -> n :e omega.
Axiom is_null_set_Rn_subq_Rn : forall n , forall S , is_null_set_Rn n S -> S c= (Rn n).
Axiom null_set_subq : forall n :e omega , forall S T , T c= S -> is_null_set_Rn n S -> is_null_set_Rn n T.
Definition null_set_binunion_cseq : set -> set -> set -> set -> set := fun n cseq1 cseq2 k => if exists m :e omega , k = nat_pair 0 m then cseq1 (Eps_i (fun m : set => m :e omega /\ k = nat_pair 0 m)) else if exists m :e omega , k = nat_pair 1 m then cseq2 (Eps_i (fun m : set => m :e omega /\ k = nat_pair 1 m)) else cseq1 0.
Definition null_set_binunion_rseq : set -> set -> set -> set := fun rseq1 rseq2 k => if exists m :e omega , k = nat_pair 0 m then rseq1 (Eps_i (fun m : set => m :e omega /\ k = nat_pair 0 m)) else if exists m :e omega , k = nat_pair 1 m then rseq2 (Eps_i (fun m : set => m :e omega /\ k = nat_pair 1 m)) else 1.
Axiom null_set_binunion_cseq_tag0 : forall n , forall cseq1 , forall cseq2 , forall k :e omega , null_set_binunion_cseq n cseq1 cseq2 (nat_pair 0 k) = cseq1 k.
Axiom null_set_binunion_rseq_tag0 : forall rseq1 , forall rseq2 , forall k :e omega , null_set_binunion_rseq rseq1 rseq2 (nat_pair 0 k) = rseq1 k.
Axiom null_set_binunion_cseq_tag1 : forall n , forall cseq1 , forall cseq2 , forall k :e omega , null_set_binunion_cseq n cseq1 cseq2 (nat_pair 1 k) = cseq2 k.
Axiom null_set_binunion_rseq_tag1 : forall rseq1 , forall rseq2 , forall k :e omega , null_set_binunion_rseq rseq1 rseq2 (nat_pair 1 k) = rseq2 k.
Axiom null_set_binunion_rseq_eq_tag0_witness : forall rseq1 , forall rseq2 , forall k , forall m :e omega , k = nat_pair 0 m -> null_set_binunion_rseq rseq1 rseq2 k = rseq1 m.
Axiom null_set_binunion_rseq_eq_tag1_witness : forall rseq1 , forall rseq2 , forall k , forall m :e omega , k = nat_pair 1 m -> null_set_binunion_rseq rseq1 rseq2 k = rseq2 m.
Axiom null_set_binunion_rseq_eq_else : forall rseq1 , forall rseq2 , forall k , ~ (exists m :e omega , k = nat_pair 0 m) -> ~ (exists m :e omega , k = nat_pair 1 m) -> null_set_binunion_rseq rseq1 rseq2 k = 1.
Axiom SNoLt_eq_substL : forall x y z , x = y -> x < z -> y < z.
Axiom SNoLt_eq_substR : forall x y z , y = z -> x < y -> x < z.
Axiom null_set_binunion_cseq_eq_tag0_witness : forall n , forall cseq1 , forall cseq2 , forall k , forall m :e omega , k = nat_pair 0 m -> null_set_binunion_cseq n cseq1 cseq2 k = cseq1 m.
