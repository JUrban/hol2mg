Axiom god1_real_sign_classes_block_formula : forall n p q , forall phi c : set -> set , (forall k :e n , c k :e real) -> (forall i :e n , phi i :e n) -> (forall i :e n , (i :e p -> phi i :e {k :e n|SNoLt 0 (c k)}) /\ (i :e add_SNo p q /\ i /:e p -> phi i :e {k :e n|SNoLt (c k) 0}) /\ (i /:e add_SNo p q -> phi i /:e {k :e n|SNoLt 0 (c k)} /\ phi i /:e {k :e n|SNoLt (c k) 0})) -> forall i :e n , (if SNoLt 0 (c (phi i)) then 1 else if SNoLt (c (phi i)) 0 then minus_SNo 1 else 0) = if i :e p then 1 else if i :e add_SNo p q then minus_SNo 1 else 0.
Axiom god1_real_scaled_orthogonal_reindexed_inertia_entries : forall L , forall addL smul : set -> set -> set , forall n p q , forall b scalar phi : set -> set , forall f : set -> set -> set , symmetric_bilinear_form real add_SNo mul_SNo L addL smul f -> (forall i :e n , b i :e L) -> (forall i :e n , f (b i) (b i) :e real) -> (forall i :e n , scalar i :e real) -> (forall i :e n , mul_SNo (scalar i) (mul_SNo (scalar i) (f (b i) (b i))) = if SNoLt 0 (f (b i) (b i)) then 1 else if SNoLt (f (b i) (b i)) 0 then minus_SNo 1 else 0) -> (forall i j :e n , i <> j -> f (b i) (b j) = ring_zero real add_SNo) -> inj n n phi -> (forall i :e n , (i :e p -> phi i :e {k :e n|SNoLt 0 (f (b k) (b k))}) /\ (i :e add_SNo p q /\ i /:e p -> phi i :e {k :e n|SNoLt (f (b k) (b k)) 0}) /\ (i /:e add_SNo p q -> phi i /:e {k :e n|SNoLt 0 (f (b k) (b k))} /\ phi i /:e {k :e n|SNoLt (f (b k) (b k)) 0})) -> forall i j :e n , f (smul (scalar (phi i)) (b (phi i))) (smul (scalar (phi j)) (b (phi j))) = if i <> j then 0 else if i :e p then 1 else if i :e add_SNo p q then minus_SNo 1 else 0.
Axiom god1_complex_hermitian_scaled_orthogonal_reindexed_inertia_entries : forall L , forall addL smul : set -> set -> set , forall n p q , forall b scalar phi : set -> set , forall f : set -> set -> set , hermitian_form complex add_CSNo mul_CSNo conj_CSNo L addL smul f -> (forall i :e n , b i :e L) -> (forall i :e n , f (b i) (b i) :e real) -> (forall i :e n , scalar i :e real) -> (forall i :e n , mul_SNo (scalar i) (mul_SNo (scalar i) (f (b i) (b i))) = if SNoLt 0 (f (b i) (b i)) then 1 else if SNoLt (f (b i) (b i)) 0 then minus_SNo 1 else 0) -> (forall i j :e n , i <> j -> f (b i) (b j) = ring_zero complex add_CSNo) -> inj n n phi -> (forall i :e n , (i :e p -> phi i :e {k :e n|SNoLt 0 (f (b k) (b k))}) /\ (i :e add_SNo p q /\ i /:e p -> phi i :e {k :e n|SNoLt (f (b k) (b k)) 0}) /\ (i /:e add_SNo p q -> phi i /:e {k :e n|SNoLt 0 (f (b k) (b k))} /\ phi i /:e {k :e n|SNoLt (f (b k) (b k)) 0})) -> forall i j :e n , f (smul (scalar (phi i)) (b (phi i))) (smul (scalar (phi j)) (b (phi j))) = if i <> j then 0 else if i :e p then 1 else if i :e add_SNo p q then minus_SNo 1 else 0.
Axiom god1_real_symmetric_bilinear_form_has_inertia_basis : forall L , forall addL smul : set -> set -> set , forall n :e omega , forall f : set -> set -> set , finite_dimensional_vector_space real add_SNo mul_SNo L addL smul -> module_dimension real add_SNo mul_SNo L addL smul = n -> symmetric_bilinear_form real add_SNo mul_SNo L addL smul f -> exists p q :e ordsucc n , exists a : set -> set , add_SNo p q c= n /\ module_basis real add_SNo mul_SNo L addL smul n a /\ forall i j :e n , f (a i) (a j) = if i <> j then 0 else if i :e p then 1 else if i :e add_SNo p q then minus_SNo 1 else 0.
Axiom god1_real_inertia_diagonal_basis_nondegenerate_iff_full : forall L , forall addL smul : set -> set -> set , forall n p q :e omega , forall a : set -> set , forall f : set -> set -> set , field_involution real add_SNo mul_SNo (fun x => x) -> module_basis real add_SNo mul_SNo L addL smul n a -> sesquilinear_form real add_SNo mul_SNo (fun x => x) L addL smul f -> add_SNo p q c= n -> (forall i j :e n , f (a i) (a j) = if i <> j then 0 else if i :e p then 1 else if i :e add_SNo p q then minus_SNo 1 else 0) -> (nondegenerate_sesquilinear_form real add_SNo mul_SNo (fun x => x) L addL smul f <-> add_SNo p q = n).
Axiom god1_s36_theorem6_corollary2_real_symmetric_inertia_form : forall L , forall addL smul : set -> set -> set , forall n :e omega , forall f : set -> set -> set , finite_dimensional_vector_space real add_SNo mul_SNo L addL smul -> module_dimension real add_SNo mul_SNo L addL smul = n -> symmetric_bilinear_form real add_SNo mul_SNo L addL smul f -> exists p q :e ordsucc n , exists a : set -> set , add_SNo p q c= n /\ module_basis real add_SNo mul_SNo L addL smul n a /\ (forall i j :e n , f (a i) (a j) = if i <> j then 0 else if i :e p then 1 else if i :e add_SNo p q then minus_SNo 1 else 0) /\ (nondegenerate_sesquilinear_form real add_SNo mul_SNo (fun x => x) L addL smul f <-> add_SNo p q = n).
Axiom god1_sno_equal_negation_implies_zero : forall y , SNo y -> y = minus_SNo y -> y = 0.
Axiom god1_s36_section1_hermitian_diagonal_values_are_real_interface : forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , hermitian_form complex add_CSNo mul_CSNo conj_CSNo L addL smul f -> forall x :e L , exists r :e real , f x x = r.
Axiom god1_complex_hermitian_diagonal_value_in_real : forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , hermitian_form complex add_CSNo mul_CSNo conj_CSNo L addL smul f -> forall x :e L , f x x :e real.
Axiom god1_complex_hermitian_form_has_inertia_basis : forall L , forall addL smul : set -> set -> set , forall n :e omega , forall f : set -> set -> set , finite_dimensional_vector_space complex add_CSNo mul_CSNo L addL smul -> module_dimension complex add_CSNo mul_CSNo L addL smul = n -> hermitian_form complex add_CSNo mul_CSNo conj_CSNo L addL smul f -> exists p q :e ordsucc n , exists a : set -> set , add_SNo p q c= n /\ module_basis complex add_CSNo mul_CSNo L addL smul n a /\ forall i j :e n , f (a i) (a j) = if i <> j then 0 else if i :e p then 1 else if i :e add_SNo p q then minus_SNo 1 else 0.
Axiom god1_complex_diagonal_inertia_matrix_invertible_iff_full : forall n p q :e omega , forall A :e square_matrix_ring complex n , add_SNo p q c= n -> (forall i j :e n , matrix_entry A i j = if i <> j then 0 else if i :e p then 1 else if i :e add_SNo p q then minus_SNo 1 else 0) -> (invertible_matrix complex add_CSNo mul_CSNo n A <-> add_SNo p q = n).
Axiom god1_complex_inertia_diagonal_basis_nondegenerate_iff_full : forall L , forall addL smul : set -> set -> set , forall n p q :e omega , forall a : set -> set , forall f : set -> set -> set , field_involution complex add_CSNo mul_CSNo conj_CSNo -> module_basis complex add_CSNo mul_CSNo L addL smul n a -> sesquilinear_form complex add_CSNo mul_CSNo conj_CSNo L addL smul f -> add_SNo p q c= n -> (forall i j :e n , f (a i) (a j) = if i <> j then 0 else if i :e p then 1 else if i :e add_SNo p q then minus_SNo 1 else 0) -> (nondegenerate_sesquilinear_form complex add_CSNo mul_CSNo conj_CSNo L addL smul f <-> add_SNo p q = n).
Axiom god1_s36_theorem6_corollary3_complex_hermitian_inertia_form : forall L , forall addL smul : set -> set -> set , forall n :e omega , forall f : set -> set -> set , finite_dimensional_vector_space complex add_CSNo mul_CSNo L addL smul -> module_dimension complex add_CSNo mul_CSNo L addL smul = n -> hermitian_form complex add_CSNo mul_CSNo conj_CSNo L addL smul f -> exists p q :e ordsucc n , exists a : set -> set , add_SNo p q c= n /\ module_basis complex add_CSNo mul_CSNo L addL smul n a /\ (forall i j :e n , f (a i) (a j) = if i <> j then 0 else if i :e p then 1 else if i :e add_SNo p q then minus_SNo 1 else 0) /\ (nondegenerate_sesquilinear_form complex add_CSNo mul_CSNo conj_CSNo L addL smul f <-> add_SNo p q = n).
Definition orthonormal_basis_for_form : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> prop := fun K addK mulK L addL smul f n a => module_basis K addK mulK L addL smul n a /\ forall i j :e n , f (a i) (a j) = if i = j then ring_one K mulK else ring_zero K addK.
Definition positive_definite_hermitian_form : set -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K addK L addL f => forall x :e L , x <> module_zero L addL -> exists r :e real , SNoLt 0 r /\ f x x = r.
Definition positive_semidefinite_hermitian_form : set -> set -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K L addL f => forall x :e L , exists r :e real , SNoLe 0 r /\ f x x = r.
Definition negative_semidefinite_hermitian_form : set -> set -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K L addL f => forall x :e L , exists r :e real , SNoLe r 0 /\ f x x = r.
Definition indefinite_hermitian_form : set -> set -> (set -> set -> set) -> (set -> set -> set) -> prop := fun K L addL f => not (positive_semidefinite_hermitian_form K L addL f) /\ not (negative_semidefinite_hermitian_form K L addL f).
Axiom god1_nonzero_vector_has_nonzero_finite_basis_coordinate : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall n :e omega , forall a : set -> set , module_basis K addK mulK L addL smul n a -> forall x :e L , x <> module_zero L addL -> exists i :e n , basis_coordinates K addK mulK L addL smul n a x i <> ring_zero K addK.
Axiom god1_real_finite_sum_nonnegative_zero_terms : forall n :e omega , forall f : set -> set , (forall i :e n , f i :e real) -> (forall i :e n , SNoLe 0 (f i)) -> ring_finite_sum real add_SNo n f = 0 -> forall i :e n , f i = 0.
Axiom god1_real_finite_sum_positive_from_positive_term : forall n :e omega , forall f : set -> set , (forall i :e n , f i :e real) -> (forall i :e n , SNoLe 0 (f i)) -> (exists i :e n , SNoLt 0 (f i)) -> SNoLt 0 (ring_finite_sum real add_SNo n f).
Axiom god1_orthonormal_basis_sesquilinear_self_value : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall n :e omega , forall a : set -> set , forall f : set -> set -> set , field_involution K addK mulK star -> orthonormal_basis_for_form K addK mulK L addL smul f n a -> sesquilinear_form K addK mulK star L addL smul f -> forall x :e L , f x x = ring_finite_sum K addK n (fun i => mulK (basis_coordinates K addK mulK L addL smul n a x i) (star (basis_coordinates K addK mulK L addL smul n a x i))).
Axiom god1_real_square_sign : forall c :e real , SNoLe 0 (mul_SNo c c) /\ (c <> 0 -> SNoLt 0 (mul_SNo c c)).
Axiom god1_complex_abs_sqr_sign : forall z :e complex , SNoLe 0 (abs_sqr_CSNo z) /\ (z <> 0 -> SNoLt 0 (abs_sqr_CSNo z)).
Axiom god1_real_orthonormal_basis_implies_positive_definite : forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , forall n :e omega , forall a : set -> set , symmetric_bilinear_form real add_SNo mul_SNo L addL smul f -> orthonormal_basis_for_form real add_SNo mul_SNo L addL smul f n a -> positive_definite_hermitian_form real add_SNo L addL f.
Axiom god1_complex_orthonormal_basis_implies_positive_definite : forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , forall n :e omega , forall a : set -> set , hermitian_form complex add_CSNo mul_CSNo conj_CSNo L addL smul f -> orthonormal_basis_for_form complex add_CSNo mul_CSNo L addL smul f n a -> positive_definite_hermitian_form complex add_CSNo L addL f.
Axiom god1_positive_definite_inertia_basis_has_full_positive_block : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall n :e omega , forall p q :e ordsucc n , forall a : set -> set , forall f : set -> set -> set , division_ring K addK mulK -> module_basis K addK mulK L addL smul n a -> (forall i j :e n , f (a i) (a j) = if i <> j then 0 else if i :e p then 1 else if i :e add_SNo p q then minus_SNo 1 else 0) -> positive_definite_hermitian_form K addK L addL f -> p = n.
Axiom god1_full_positive_inertia_basis_is_orthonormal : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall n p q , forall a : set -> set , forall f : set -> set -> set , ring_zero K addK = 0 -> ring_one K mulK = 1 -> p = n -> module_basis K addK mulK L addL smul n a -> (forall i j :e n , f (a i) (a j) = if i <> j then 0 else if i :e p then 1 else if i :e add_SNo p q then minus_SNo 1 else 0) -> orthonormal_basis_for_form K addK mulK L addL smul f n a.
Axiom god1_positive_definite_inertia_decomposition_has_orthonormal_basis : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall n :e omega , forall f : set -> set -> set , division_ring K addK mulK -> ring_zero K addK = 0 -> ring_one K mulK = 1 -> (exists p q :e ordsucc n , exists a : set -> set , add_SNo p q c= n /\ module_basis K addK mulK L addL smul n a /\ forall i j :e n , f (a i) (a j) = if i <> j then 0 else if i :e p then 1 else if i :e add_SNo p q then minus_SNo 1 else 0) -> positive_definite_hermitian_form K addK L addL f -> exists a : set -> set , orthonormal_basis_for_form K addK mulK L addL smul f n a.
Axiom god1_s36_theorem7_real_and_complex_orthonormal_basis_criterion : (forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , finite_dimensional_vector_space real add_SNo mul_SNo L addL smul -> symmetric_bilinear_form real add_SNo mul_SNo L addL smul f -> ((exists n :e omega , exists a : set -> set , orthonormal_basis_for_form real add_SNo mul_SNo L addL smul f n a) <-> positive_definite_hermitian_form real add_SNo L addL f)) /\ (forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , finite_dimensional_vector_space complex add_CSNo mul_CSNo L addL smul -> hermitian_form complex add_CSNo mul_CSNo conj_CSNo L addL smul f -> ((exists n :e omega , exists a : set -> set , orthonormal_basis_for_form complex add_CSNo mul_CSNo L addL smul f n a) <-> positive_definite_hermitian_form complex add_CSNo L addL f)).
Definition hermitian_form_automorphism : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> prop := fun K addK mulK L addL smul f u => module_automorphism K addK mulK L addL smul u /\ forall x y :e L , f (u x) (u y) = f x y.
Definition hermitian_form_automorphism_group : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set -> set) -> set := fun K addK mulK L addL smul f => {u :e module_general_linear_group K addK mulK L addL smul|hermitian_form_automorphism K addK mulK L addL smul f (fun x => u x)}.
Definition orthogonal_matrix : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> prop := fun K add mul n A => A :e square_matrix_ring K n /\ matrix_multiplication K add mul n n n (matrix_transpose K n n A) A = unit_matrix K add mul n.
Definition orthogonal_group : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set := fun K add mul n => {A :e square_matrix_ring K n|orthogonal_matrix K add mul n A}.
Definition special_orthogonal_group : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set := fun K add mul n => {A :e orthogonal_group K add mul n|matrix_determinant K add mul n A = ring_one K mul}.
Definition unitary_matrix : set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> set -> set -> prop := fun K add mul star n A => A :e square_matrix_ring K n /\ matrix_multiplication K add mul n n n (matrix_adjoint K star n n A) A = unit_matrix K add mul n.
Definition unitary_group : set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> set -> set := fun K add mul star n => {A :e square_matrix_ring K n|unitary_matrix K add mul star n A}.
Axiom god1_orthogonal_matrix_determinant_square_one_core : forall K , forall add mul : set -> set -> set , forall n :e omega , forall A :e square_matrix_ring K n , field K add mul -> orthogonal_matrix K add mul n A -> matrix_determinant K add mul n A = ring_one K mul \/ matrix_determinant K add mul n A = ring_negation K add (ring_one K mul).
Axiom god1_orthogonal_matrix_determinant_is_plus_or_minus_one : forall K , forall add mul : set -> set -> set , forall n :e omega , forall A :e square_matrix_ring K n , field K add mul -> orthogonal_matrix K add mul n A -> matrix_determinant K add mul n A = ring_one K mul \/ matrix_determinant K add mul n A = ring_negation K add (ring_one K mul).
Axiom god1_general_linear_group_identity_evaluates : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , group (module_general_linear_group K addK mulK L addL smul) (module_endomorphism_composition L) -> forall x :e L , group_identity (module_general_linear_group K addK mulK L addL smul) (module_endomorphism_composition L) x = x.
Axiom god1_automorphisms_of_hermitian_form_form_group : forall K , forall addK mulK : set -> set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , group (module_general_linear_group K addK mulK L addL smul) (module_endomorphism_composition L) -> group (hermitian_form_automorphism_group K addK mulK L addL smul f) (module_endomorphism_composition L).
Definition normal_endomorphism : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> (set -> set -> set) -> (set -> set) -> prop := fun K addK mulK L addL smul f u => module_endomorphism K addK mulK L addL smul u /\ module_endomorphism_composition L (fun x :e L => adjoint_homomorphism K addK mulK L L f f u x) (fun x :e L => u x) = module_endomorphism_composition L (fun x :e L => u x) (fun x :e L => adjoint_homomorphism K addK mulK L L f f u x).
Axiom god1_complex_positive_definite_hermitian_is_nondegenerate : forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , hermitian_form complex add_CSNo mul_CSNo conj_CSNo L addL smul f -> positive_definite_hermitian_form complex add_CSNo L addL f -> nondegenerate_sesquilinear_form complex add_CSNo mul_CSNo conj_CSNo L addL smul f.
Axiom god1_hermitian_form_automorphism_is_normal : forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , forall u : set -> set , finite_dimensional_vector_space complex add_CSNo mul_CSNo L addL smul -> hermitian_form complex add_CSNo mul_CSNo conj_CSNo L addL smul f -> nondegenerate_sesquilinear_form complex add_CSNo mul_CSNo conj_CSNo L addL smul f -> hermitian_form_automorphism complex add_CSNo mul_CSNo L addL smul f u -> normal_endomorphism complex add_CSNo mul_CSNo L addL smul f u.
Axiom god1_bounded_module_endomorphism_composition_eval : forall X , forall f g : set -> set , (forall x :e X , f x :e X) -> (forall x :e X , g x :e X) -> forall x :e X , module_endomorphism_composition X (fun z :e X => f z) (fun z :e X => g z) x = f (g x).
Axiom god1_sesquilinear_form_zero_first_argument : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , field_involution K addK mulK star -> sesquilinear_form K addK mulK star L addL smul f -> forall y :e L , f (module_zero L addL) y = ring_zero K addK.
Axiom god1_complex_positive_definite_zero_diagonal : forall L , forall addL : set -> set -> set , forall f : set -> set -> set , positive_definite_hermitian_form complex add_CSNo L addL f -> forall x :e L , f x x = ring_zero complex add_CSNo -> x = module_zero L addL.
Axiom god1_normal_endomorphism_kernel_equals_adjoint_kernel_core : forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , forall u : set -> set , finite_dimensional_vector_space complex add_CSNo mul_CSNo L addL smul -> hermitian_form complex add_CSNo mul_CSNo conj_CSNo L addL smul f -> positive_definite_hermitian_form complex add_CSNo L addL f -> normal_endomorphism complex add_CSNo mul_CSNo L addL smul f u -> {x :e L|u x = module_zero L addL} = {x :e L|adjoint_homomorphism complex add_CSNo mul_CSNo L L f f u x = module_zero L addL}.
Axiom god1_sesquilinear_form_first_scalar_eval : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , sesquilinear_form K addK mulK star L addL smul f -> forall scalar :e K , forall x y :e L , f (smul scalar x) y = mulK scalar (f x y).
Axiom god1_sesquilinear_form_second_scalar_eval : forall K , forall addK mulK : set -> set -> set , forall star : set -> set , forall L , forall addL smul : set -> set -> set , forall f : set -> set -> set , sesquilinear_form K addK mulK star L addL smul f -> forall scalar :e K , forall x y :e L , f x (smul scalar y) = mulK (star scalar) (f x y).
