Axiom pointwise_bounded_fun_seq_extend_subseq_converges_coded : forall X , forall fn : set -> set , forall e : set -> set , pointwise_bounded_fun_seq X fn -> forall hn : set -> set , subseq_of fn hn -> forall K :e omega , e K :e X -> (forall m :e K , exists l :e complex , ms_seq_limit complex dist_complex (fun n : set => (hn n) (e m)) l) -> exists g , subseq_of fn (fun n : set => g n) /\ forall m :e ordsucc K , exists l :e complex , ms_seq_limit complex dist_complex (fun n : set => (g n) (e m)) l.
Axiom pointwise_bounded_fun_seq_finite_subseq_converges_coded : forall X , forall fn : set -> set , forall e : set -> set , pointwise_bounded_fun_seq X fn -> (forall n :e omega , e n :e X) -> forall N :e omega , exists g , subseq_of fn (fun n : set => g n) /\ forall m :e N , exists l :e complex , ms_seq_limit complex dist_complex (fun n : set => (g n) (e m)) l.
Axiom pointwise_bounded_fun_seq_extend_subseq_converges_coded_rel : forall X , forall fn : set -> set , forall e : set -> set , pointwise_bounded_fun_seq X fn -> forall hn : set -> set , subseq_of fn hn -> forall K :e omega , e K :e X -> (forall m :e K , exists l :e complex , ms_seq_limit complex dist_complex (fun n : set => (hn n) (e m)) l) -> exists g , subseq_of hn (fun n : set => g n) /\ forall m :e ordsucc K , exists l :e complex , ms_seq_limit complex dist_complex (fun n : set => (g n) (e m)) l.
Definition arzela_diag_step_pred : (set -> set) -> (set -> set) -> set -> set -> prop := fun fn e N r => subseq_of fn (fun n : set => r n) /\ forall m :e N , exists l :e complex , ms_seq_limit complex dist_complex (fun n : set => (r n) (e m)) l.
Definition arzela_diag_step_choice : (set -> set) -> set -> set -> set := fun e N r => Eps_i (fun g : set => subseq_of (fun n : set => r n) (fun n : set => g n) /\ forall m :e ordsucc N , exists l :e complex , ms_seq_limit complex dist_complex (fun n : set => (g n) (e m)) l).
Definition arzela_diag_step : (set -> set) -> (set -> set) -> set -> set -> set := fun fn e N r => if arzela_diag_step_pred fn e N r then arzela_diag_step_choice e N r else r.
Definition arzela_diag_family : (set -> set) -> (set -> set) -> set -> set := fun fn e => nat_primrec (fun n :e omega => fn n) (arzela_diag_step fn e).
Definition arzela_diag_family_prop : (set -> set) -> (set -> set) -> set -> prop := fun fn e K => subseq_of fn (fun n : set => (arzela_diag_family fn e K) n) /\ (forall m :e K , exists l :e complex , ms_seq_limit complex dist_complex (fun n : set => ((arzela_diag_family fn e K) n) (e m)) l) /\ subseq_of (fun n : set => (arzela_diag_family fn e K) n) (fun n : set => (arzela_diag_family fn e (ordsucc K)) n) /\ forall m :e ordsucc K , exists l :e complex , ms_seq_limit complex dist_complex (fun n : set => ((arzela_diag_family fn e (ordsucc K)) n) (e m)) l.
Axiom subseq_of_eq_on_omega_substR : forall x y z : set -> set , subseq_of x y -> (forall n :e omega , z n = y n) -> subseq_of x z.
Axiom arzela_diag_step_choice_spec : forall X , forall fn : set -> set , forall e : set -> set , forall N , forall r , pointwise_bounded_fun_seq X fn -> N :e omega -> e N :e X -> arzela_diag_step_pred fn e N r -> subseq_of (fun n : set => r n) (fun n : set => (arzela_diag_step_choice e N r) n) /\ forall m :e ordsucc N , exists l :e complex , ms_seq_limit complex dist_complex (fun n : set => ((arzela_diag_step_choice e N r) n) (e m)) l.
Axiom complex_seq_limit_exists_of_pointwise_eq : forall x y : set -> set , (forall n :e omega , y n = x n) -> (exists l :e complex , ms_seq_limit complex dist_complex x l) -> exists l :e complex , ms_seq_limit complex dist_complex y l.
Axiom arzela_diag_family_base : forall X , forall fn : set -> set , forall e : set -> set , pointwise_bounded_fun_seq X fn -> (forall n :e omega , e n :e X) -> arzela_diag_family_prop fn e 0.
Axiom arzela_diag_family_step : forall X , forall fn : set -> set , forall e : set -> set , pointwise_bounded_fun_seq X fn -> (forall n :e omega , e n :e X) -> forall K , nat_p K -> arzela_diag_family_prop fn e K -> arzela_diag_family_prop fn e (ordsucc K).
Axiom arzela_diag_family_spec : forall X , forall fn : set -> set , forall e : set -> set , pointwise_bounded_fun_seq X fn -> (forall n :e omega , e n :e X) -> forall N :e omega , arzela_diag_family_prop fn e N.
Axiom ms_seq_compact_nonempty_imp_arzela_diag_family_data : forall X , forall dX : set -> set -> set , forall fn : set -> set , is_metric X dX -> ms_seq_compact X dX X -> pointwise_bounded_fun_seq X fn -> nonempty X -> exists e : set -> set , (forall n :e omega , e n :e X) /\ (forall x :e X , forall eps :e R , 0 < eps -> exists n :e omega , dX x (e n) < eps) /\ forall N :e omega , arzela_diag_family_prop fn e N.
Axiom omega_Le_refl : forall n :e omega , n <= n.
Axiom subseq_fun_omega_coding : forall f : set -> set , subseq_fun f -> subseq_fun (fun n : set => ((fun k :e omega => f k) n)).
Axiom subseq_fun_eq_on_omega_substR : forall f g : set -> set , subseq_fun f -> (forall n :e omega , g n = f n) -> subseq_fun g.
Definition subseq_index_choice : (set -> set) -> (set -> set) -> (set -> set) := fun x y => fun n : set => (Eps_i (fun f : set => subseq_fun (fun k : set => f k) /\ forall k :e omega , y k = x (f k))) n.
Axiom subseq_index_choice_spec : forall x y : set -> set , subseq_of x y -> subseq_fun (subseq_index_choice x y) /\ forall n :e omega , y n = x ((subseq_index_choice x y) n).
Definition arzela_diag_link : (set -> set) -> (set -> set) -> set -> (set -> set) := fun fn e N => subseq_index_choice (fun n : set => (arzela_diag_family fn e N) n) (fun n : set => (arzela_diag_family fn e (ordsucc N)) n).
Axiom arzela_diag_link_spec : forall X , forall fn : set -> set , forall e : set -> set , pointwise_bounded_fun_seq X fn -> (forall n :e omega , e n :e X) -> forall N :e omega , subseq_fun (arzela_diag_link fn e N) /\ forall k :e omega , (arzela_diag_family fn e (ordsucc N)) k = (arzela_diag_family fn e N) ((arzela_diag_link fn e N) k).
Definition arzela_diag_index_family : (set -> set) -> (set -> set) -> set -> set := fun fn e => nat_primrec (fun n :e omega => n) (fun N a => fun k :e omega => a ((arzela_diag_link fn e N) k)).
Definition arzela_diag_subseq : (set -> set) -> (set -> set) -> (set -> set) := fun fn e => fun n : set => (fn (((arzela_diag_index_family fn e n)) n)).
Axiom arzela_diag_index_family_step_eq : forall fn : set -> set , forall e : set -> set , forall N :e omega , forall k :e omega , ((arzela_diag_index_family fn e (ordsucc N)) k) = ((arzela_diag_index_family fn e N) ((arzela_diag_link fn e N) k)).
Axiom arzela_diag_index_family_base : forall fn : set -> set , forall e : set -> set , subseq_fun (fun k : set => ((arzela_diag_index_family fn e 0) k)) /\ forall k :e omega , (arzela_diag_family fn e 0) k = fn (((arzela_diag_index_family fn e 0) k)).
Axiom arzela_diag_index_family_step : forall X , forall fn : set -> set , forall e : set -> set , pointwise_bounded_fun_seq X fn -> (forall n :e omega , e n :e X) -> forall M , nat_p M -> (subseq_fun (fun k : set => ((arzela_diag_index_family fn e M) k)) /\ forall k :e omega , (arzela_diag_family fn e M) k = fn (((arzela_diag_index_family fn e M) k))) -> (subseq_fun (fun k : set => ((arzela_diag_index_family fn e (ordsucc M)) k)) /\ forall k :e omega , (arzela_diag_family fn e (ordsucc M)) k = fn (((arzela_diag_index_family fn e (ordsucc M)) k))).
Axiom arzela_diag_index_family_spec : forall X , forall fn : set -> set , forall e : set -> set , pointwise_bounded_fun_seq X fn -> (forall n :e omega , e n :e X) -> forall N :e omega , subseq_fun (fun k : set => ((arzela_diag_index_family fn e N) k)) /\ forall k :e omega , (arzela_diag_family fn e N) k = fn (((arzela_diag_index_family fn e N) k)).
Axiom arzela_diag_subseq_index_subseq_fun : forall X , forall fn : set -> set , forall e : set -> set , pointwise_bounded_fun_seq X fn -> (forall n :e omega , e n :e X) -> subseq_fun (fun n : set => ((arzela_diag_index_family fn e n) n)).
Axiom arzela_diag_subseq_subseq_of : forall X , forall fn : set -> set , forall e : set -> set , pointwise_bounded_fun_seq X fn -> (forall n :e omega , e n :e X) -> subseq_of fn (arzela_diag_subseq fn e).
Axiom arzela_diag_subseq_eq_family_diag : forall X , forall fn : set -> set , forall e : set -> set , pointwise_bounded_fun_seq X fn -> (forall n :e omega , e n :e X) -> forall n :e omega , (arzela_diag_subseq fn e) n = ((arzela_diag_family fn e n) n).
Axiom arzela_diag_family_subseq_shift : forall X , forall fn : set -> set , forall e : set -> set , pointwise_bounded_fun_seq X fn -> (forall n :e omega , e n :e X) -> forall N :e omega , forall k :e omega , subseq_of (fun n : set => (arzela_diag_family fn e N) n) (fun n : set => (arzela_diag_family fn e (add_nat k N)) n).
Axiom arzela_diag_family_subseq_levels : forall X , forall fn : set -> set , forall e : set -> set , pointwise_bounded_fun_seq X fn -> (forall n :e omega , e n :e X) -> forall N :e omega , forall M :e omega , N <= M -> subseq_of (fun n : set => (arzela_diag_family fn e N) n) (fun n : set => (arzela_diag_family fn e M) n).
Axiom arzela_diag_subseq_term_from_level : forall X , forall fn : set -> set , forall e : set -> set , pointwise_bounded_fun_seq X fn -> (forall n :e omega , e n :e X) -> forall N :e omega , forall n :e omega , N <= n -> exists j :e omega , n <= j /\ (arzela_diag_subseq fn e) n = (arzela_diag_family fn e N) j.
Axiom eval_fun_eq_subst : forall a , forall f g , f = g -> f a = g a.
Axiom arzela_diag_subseq_eval_from_level : forall X , forall fn : set -> set , forall e : set -> set , pointwise_bounded_fun_seq X fn -> (forall n :e omega , e n :e X) -> forall N :e omega , forall n :e omega , forall m :e omega , N <= n -> exists j :e omega , n <= j /\ ((arzela_diag_subseq fn e) n) (e m) = ((arzela_diag_family fn e N) j) (e m).
Axiom arzela_diag_family_sample_limit : forall X , forall fn : set -> set , forall e : set -> set , pointwise_bounded_fun_seq X fn -> (forall n :e omega , e n :e X) -> forall m :e omega , exists l :e complex , ms_seq_limit complex dist_complex (fun n : set => ((arzela_diag_family fn e (ordsucc m)) n) (e m)) l.
Axiom arzela_diag_subseq_eval_in_complex : forall X , forall fn : set -> set , forall e : set -> set , pointwise_bounded_fun_seq X fn -> (forall n :e omega , e n :e X) -> forall n :e omega , forall m :e omega , ((arzela_diag_subseq fn e) n) (e m) :e complex.
Axiom arzela_diag_subseq_eval_tail_from_family_tail : forall X , forall fn : set -> set , forall e : set -> set , pointwise_bounded_fun_seq X fn -> (forall n :e omega , e n :e X) -> forall m :e omega , forall l :e complex , forall eps :e R , forall N1 :e omega , (forall j :e omega , N1 <= j -> dist_complex (((arzela_diag_family fn e (ordsucc m)) j) (e m)) l < eps) -> forall n :e omega , add_nat (ordsucc m) N1 <= n -> dist_complex (((arzela_diag_subseq fn e) n) (e m)) l < eps.
Axiom arzela_diag_subseq_dense_point_converges : forall X , forall fn : set -> set , forall e : set -> set , pointwise_bounded_fun_seq X fn -> (forall n :e omega , e n :e X) -> forall m :e omega , exists l :e complex , ms_seq_limit complex dist_complex (fun n : set => ((arzela_diag_subseq fn e) n) (e m)) l.
Axiom ms_seq_compact_nonempty_imp_arzela_diag_subseq_data : forall X , forall dX : set -> set -> set , forall fn : set -> set , is_metric X dX -> ms_seq_compact X dX X -> pointwise_bounded_fun_seq X fn -> nonempty X -> exists e : set -> set , (((forall n :e omega , e n :e X) /\ (forall x :e X , forall eps :e R , 0 < eps -> exists n :e omega , dX x (e n) < eps)) /\ subseq_of fn (arzela_diag_subseq fn e)) /\ forall m :e omega , exists l :e complex , ms_seq_limit complex dist_complex (fun n : set => ((arzela_diag_subseq fn e) n) (e m)) l.
Axiom ms_uniformly_converges_to_of_not_nonempty : forall X , forall dX : set -> set -> set , forall Y , forall dY : set -> set -> set , forall fn : set -> set , forall f , ~ nonempty X -> (forall n :e omega , fn n :e setexp Y X) -> f :e setexp Y X -> ms_uniformly_converges_to X dX Y dY X fn f.
Axiom arzela_ascoli_empty_branch : forall X , forall dX : set -> set -> set , forall fn : set -> set , ~ nonempty X -> pointwise_bounded_fun_seq X fn -> exists gn : set -> set , subseq_of fn gn /\ exists f , ms_uniformly_converges_to X dX complex dist_complex X gn f.
Axiom ms_uniformly_converges_to_imp_pointwise_seq_limit : forall X , forall dX : set -> set -> set , forall Y , forall dY : set -> set -> set , forall K , forall fn : set -> set , forall f , ms_uniformly_converges_to X dX Y dY K fn f -> forall x :e K , ms_seq_limit Y dY (fun n : set => (fn n) x) (f x).
Axiom ms_uniformly_converges_to_restrict : forall X , forall dX : set -> set -> set , forall Y , forall dY : set -> set -> set , forall K , forall K' , forall fn : set -> set , forall f , K' c= K -> ms_uniformly_converges_to X dX Y dY K fn f -> ms_uniformly_converges_to X dX Y dY K' fn f.
Axiom ms_uniformly_converges_to_subseq : forall X , forall dX : set -> set -> set , forall Y , forall dY : set -> set -> set , forall K , forall fn : set -> set , forall f , ms_uniformly_converges_to X dX Y dY K fn f -> forall g : set -> set , subseq_fun g -> ms_uniformly_converges_to X dX Y dY K (fun n : set => fn (g n)) f.
Axiom ms_seq_limit_pairwise_tail : forall X , forall d : set -> set -> set , forall x : set -> set , forall l , is_metric X d -> ms_seq_limit X d x l -> forall eps :e R , 0 < eps -> exists N :e omega , forall m :e omega , forall n :e omega , N <= m -> N <= n -> d (x m) (x n) < eps.
Axiom ms_seq_limit_eq_subst : forall X , forall d : set -> set -> set , forall x : set -> set , forall l1 , forall l2 , ms_seq_limit X d x l1 -> l1 = l2 -> ms_seq_limit X d x l2.
Axiom ms_pointwise_limit_choice_mem : forall X , forall Y , forall dY : set -> set -> set , forall fn : set -> set , (forall x :e X , exists l :e Y , ms_seq_limit Y dY (fun n : set => (fn n) x) l) -> forall x :e X , (Eps_i (fun l : set => l :e Y /\ ms_seq_limit Y dY (fun n : set => (fn n) x) l)) :e Y.
Axiom ms_pointwise_limit_choice_seq_limit : forall X , forall Y , forall dY : set -> set -> set , forall fn : set -> set , (forall x :e X , exists l :e Y , ms_seq_limit Y dY (fun n : set => (fn n) x) l) -> forall x :e X , ms_seq_limit Y dY (fun n : set => (fn n) x) ((fun x :e X => Eps_i (fun l : set => l :e Y /\ ms_seq_limit Y dY (fun n : set => (fn n) x) l)) x).
Axiom ms_pointwise_limit_choice_in_setexp : forall X , forall Y , forall dY : set -> set -> set , forall fn : set -> set , (forall x :e X , exists l :e Y , ms_seq_limit Y dY (fun n : set => (fn n) x) l) -> (fun x :e X => Eps_i (fun l : set => l :e Y /\ ms_seq_limit Y dY (fun n : set => (fn n) x) l)) :e setexp Y X.
Axiom ms_metric_two_step_half_lt : forall Y , forall dY : set -> set -> set , forall a , forall b , forall c , forall eps :e R , is_metric Y dY -> a :e Y -> b :e Y -> c :e Y -> dY a b < eps :/: 2 -> dY b c < eps :/: 2 -> dY a c < eps.
Axiom ms_metric_three_step_quarter_lt : forall Y , forall dY : set -> set -> set , forall a , forall b , forall c , forall z , forall eps :e R , is_metric Y dY -> a :e Y -> b :e Y -> c :e Y -> z :e Y -> dY a b < (eps :/: 2) :/: 2 -> dY b c < (eps :/: 2) :/: 2 -> dY c z < (eps :/: 2) :/: 2 -> 0 < eps -> dY a z < eps.
Axiom ms_cauchy_subseq_limit_imp_limit : forall X , forall d : set -> set -> set , forall x : set -> set , forall y : set -> set , forall l , is_metric X d -> ms_cauchy_seq X d x -> subseq_of x y -> ms_seq_limit X d y l -> ms_seq_limit X d x l.
Axiom pointwise_bounded_fun_seq_point_limit_exists_of_uniform_cauchy : forall X , forall gn : set -> set , pointwise_bounded_fun_seq X gn -> (forall eps :e R , 0 < eps -> exists N :e omega , forall m :e omega , forall n :e omega , N <= m -> N <= n -> forall x :e X , dist_complex ((gn m) x) ((gn n) x) < eps) -> forall x :e X , exists l :e complex , ms_seq_limit complex dist_complex (fun n : set => (gn n) x) l.
Axiom ms_uniformly_cauchy_pointwise_limit_tail_at_point : forall X , forall Y , forall dY : set -> set -> set , forall fn : set -> set , forall f , forall x , is_metric Y dY -> (forall n :e omega , fn n :e setexp Y X) -> f :e setexp Y X -> x :e X -> (forall eps :e R , 0 < eps -> exists N :e omega , forall m :e omega , forall n :e omega , N <= m -> N <= n -> forall y :e X , dY ((fn m) y) ((fn n) y) < eps) -> ms_seq_limit Y dY (fun n : set => (fn n) x) (f x) -> forall eps :e R , 0 < eps -> exists N :e omega , forall n :e omega , N <= n -> dY ((fn n) x) (f x) < eps.
Axiom ms_uniformly_cauchy_pointwise_limit_tail : forall X , forall Y , forall dY : set -> set -> set , forall fn : set -> set , forall f , is_metric Y dY -> (forall n :e omega , fn n :e setexp Y X) -> f :e setexp Y X -> (forall eps :e R , 0 < eps -> exists N :e omega , forall m :e omega , forall n :e omega , N <= m -> N <= n -> forall x :e X , dY ((fn m) x) ((fn n) x) < eps) -> (forall x :e X , ms_seq_limit Y dY (fun n : set => (fn n) x) (f x)) -> forall eps :e R , 0 < eps -> exists N :e omega , forall n :e omega , N <= n -> forall x :e X , dY ((fn n) x) (f x) < eps.
Axiom ms_uniformly_cauchy_full_pointwise_limit_imp_uniform_limit : forall X , forall dX : set -> set -> set , forall Y , forall dY : set -> set -> set , forall fn : set -> set , is_metric Y dY -> (forall n :e omega , fn n :e setexp Y X) -> (forall eps :e R , 0 < eps -> exists N :e omega , forall m :e omega , forall n :e omega , N <= m -> N <= n -> forall x :e X , dY ((fn m) x) ((fn n) x) < eps) -> (forall x :e X , exists l :e Y , ms_seq_limit Y dY (fun n : set => (fn n) x) l) -> exists f , ms_uniformly_converges_to X dX Y dY X fn f.
Axiom finite_UPair : forall x y , finite {x,y}.
Axiom ms_uniformly_continuous_on_finite_initial_segment : forall X , forall dX : set -> set -> set , forall Y , forall dY : set -> set -> set , forall K , forall fn : set -> set , is_metric X dX -> K c= X -> forall N , nat_p N -> (forall n :e ordsucc N , ms_uniformly_continuous_on (fun x : set => (fn n) x) X dX Y dY K) -> forall eps :e R , 0 < eps -> exists delta :e R , 0 < delta /\ forall n :e ordsucc N , forall x :e K , forall y :e K , dX x y < delta -> dY ((fn n) x) ((fn n) y) < eps.
Axiom ms_equicontinuity_tail_case_bound : forall X , forall dX : set -> set -> set , forall Y , forall dY : set -> set -> set , forall K , forall fn : set -> set , forall f , forall N :e omega , forall delta :e R , forall eps :e R , forall eps2 :e R , forall eps4 :e R , forall eps8 :e R , eps8 + eps8 = eps4 -> eps4 + eps4 = eps2 -> eps2 + eps2 = eps -> is_metric Y dY -> (forall x :e K , (f x) :e Y) -> (forall n :e omega , forall x :e K , (fn n) x :e Y) -> (forall n :e omega , N <= n -> forall x :e K , dY ((fn n) x) (f x) < eps8) -> (forall x :e K , forall y :e K , dX x y < delta -> dY ((fn N) x) ((fn N) y) < eps2) -> forall n :e omega , N <= n -> forall x :e K , forall y :e K , dX x y < delta -> dY ((fn n) x) ((fn n) y) < eps.
Axiom ms_uniformly_converges_to_continuous_imp_equicontinuous_on : forall X , forall dX : set -> set -> set , forall Y , forall dY : set -> set -> set , forall K , forall fn : set -> set , forall f , is_metric X dX -> is_metric Y dY -> ms_seq_compact X dX K -> (forall n :e omega , ms_continuous_on (fun x : set => (fn n) x) X dX Y dY K) -> ms_uniformly_converges_to X dX Y dY K fn f -> ms_equicontinuous_on X dX Y dY K fn.
Definition ms_pointwise_bounded_fun_seq : set -> (set -> set -> set) -> set -> set -> (set -> set) -> prop := fun Y dY X y0 fn => y0 :e Y /\ (forall n :e omega , fn n :e setexp Y X) /\ forall x :e X , exists M :e R , forall n :e omega , dY ((fn n) x) y0 <= M.
Definition ms_uniformly_bounded_fun_seq : set -> (set -> set -> set) -> set -> set -> (set -> set) -> prop := fun Y dY X y0 fn => y0 :e Y /\ (forall n :e omega , fn n :e setexp Y X) /\ exists M :e R , forall n :e omega , forall x :e X , dY ((fn n) x) y0 <= M.
Axiom ms_uniformly_bounded_fun_seq_imp_pointwise_bounded_fun_seq : forall Y , forall dY : set -> set -> set , forall X , forall y0 , forall fn : set -> set , ms_uniformly_bounded_fun_seq Y dY X y0 fn -> ms_pointwise_bounded_fun_seq Y dY X y0 fn.
Axiom arzela_ascoli_uniform_boundedness : forall X , forall dX : set -> set -> set , forall fn : set -> set , is_metric X dX -> ms_seq_compact X dX X -> pointwise_bounded_fun_seq X fn -> ms_equicontinuous_on X dX complex dist_complex X fn -> uniformly_bounded_fun_seq X fn.
Axiom finite_sample_pairwise_tail_step : forall e : set -> set , forall gn : set -> set , forall K , forall M0 :e omega , forall M1 :e omega , forall eps , (forall m :e K , forall i :e omega , forall j :e omega , M0 <= i -> M0 <= j -> dist_complex ((gn i) (e m)) ((gn j) (e m)) < eps) -> (forall i :e omega , forall j :e omega , M1 <= i -> M1 <= j -> dist_complex ((gn i) (e K)) ((gn j) (e K)) < eps) -> exists M :e omega , forall m :e ordsucc K , forall i :e omega , forall j :e omega , M <= i -> M <= j -> dist_complex ((gn i) (e m)) ((gn j) (e m)) < eps.
Axiom finite_omega_bounded_above : forall F , F c= omega -> finite F -> exists N :e omega , forall n :e F , n <= N.
