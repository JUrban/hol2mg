Axiom god1_group_word_inverse_represented_step : forall G , forall mul : set -> set -> set , forall B , forall f : set -> set , forall n , group G mul -> nat_p n -> ((forall i :e n , group_word_letter G mul B (f i)) -> group_word_represented G mul B (group_inverse G mul (group_word_product G mul f n))) -> (forall i :e ordsucc n , group_word_letter G mul B (f i)) -> group_word_represented G mul B (group_inverse G mul (group_word_product G mul f (ordsucc n))).
