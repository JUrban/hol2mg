Axiom divides_int_1 : forall n :e int , divides_int 1 n.
Axiom divides_int_pos_Le : forall m n , divides_int m n -> 0 < n -> m <= n.
Definition gcd_reln : set -> set -> set -> prop := fun m n d => divides_int d m /\ divides_int d n /\ forall d' , divides_int d' m -> divides_int d' n -> d' <= d.
Axiom gcd_reln_uniq : forall a b c d , gcd_reln a b c -> gcd_reln a b d -> c = d.
Definition int_lin_comb : set -> set -> set -> prop := fun a b c => a :e int /\ b :e int /\ c :e int /\ exists m n :e int , m * a + n * b = c.
Axiom int_lin_comb_I : forall a b c :e int , (exists m n :e int , m * a + n * b = c) -> int_lin_comb a b c.
Axiom int_lin_comb_E : forall a b c , int_lin_comb a b c -> forall p : prop , (a :e int -> b :e int -> c :e int -> forall m n :e int , m * a + n * b = c -> p) -> p.
Axiom int_lin_comb_E1 : forall a b c , int_lin_comb a b c -> a :e int.
Axiom int_lin_comb_E2 : forall a b c , int_lin_comb a b c -> b :e int.
Axiom int_lin_comb_E3 : forall a b c , int_lin_comb a b c -> c :e int.
Axiom int_lin_comb_E4 : forall a b c , int_lin_comb a b c -> forall p : prop , (forall m n :e int , m * a + n * b = c -> p) -> p.
Axiom least_pos_int_lin_comb_ex : forall a b :e int , ~ (a = 0 /\ b = 0) -> exists c , int_lin_comb a b c /\ 0 < c /\ forall c' , int_lin_comb a b c' -> 0 < c' -> c <= c'.
Axiom int_lin_comb_sym : forall a b d , int_lin_comb a b d -> int_lin_comb b a d.
Axiom least_pos_int_lin_comb_divides_int : forall a b d , int_lin_comb a b d -> 0 < d -> (forall c , int_lin_comb a b c -> 0 < c -> d <= c) -> divides_int d a.
Axiom least_pos_int_lin_comb_gcd : forall a b d , int_lin_comb a b d -> 0 < d -> (forall c , int_lin_comb a b c -> 0 < c -> d <= c) -> gcd_reln a b d.
Axiom BezoutThm : forall a b :e int , ~ (a = 0 /\ b = 0) -> forall d , gcd_reln a b d <-> int_lin_comb a b d /\ 0 < d /\ forall d' , int_lin_comb a b d' -> 0 < d' -> d <= d'.
Axiom gcd_id : forall m :e omega :\: {0} , gcd_reln m m m.
Axiom gcd_0 : forall m :e omega :\: {0} , gcd_reln 0 m m.
Axiom gcd_sym : forall m n d , gcd_reln m n d -> gcd_reln n m d.
Axiom gcd_minus : forall m n d , gcd_reln m n d -> gcd_reln m (- n) d.
Axiom euclidean_algorithm_prop_1 : forall m n d , n :e int -> gcd_reln m (n + - m) d -> gcd_reln m n d.
Axiom euclidean_algorithm : (forall m :e omega :\: {0} , gcd_reln m m m) /\ (forall m :e omega :\: {0} , gcd_reln 0 m m) /\ (forall m :e omega :\: {0} , gcd_reln m 0 m) /\ (forall m n :e omega , m < n -> forall d , gcd_reln m (n + - m) d -> gcd_reln m n d) /\ (forall m n :e omega , n < m -> forall d , gcd_reln n m d -> gcd_reln m n d) /\ (forall m :e omega , forall n :e int , n < 0 -> forall d , gcd_reln m (- n) d -> gcd_reln m n d) /\ (forall m n :e int , m < 0 -> forall d , gcd_reln (- m) n d -> gcd_reln m n d).
Axiom Euclid_lemma : forall p , prime_nat p -> forall a b :e int , divides_int p (a * b) -> divides_int p a \/ divides_int p b.
