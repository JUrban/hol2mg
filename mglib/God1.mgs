Axiom recip_SNo_2_lt_1 : recip_SNo 2 < 1.
Axiom half_lt_self_pos : forall x :e R , 0 < x -> x :/: 2 < x.
Axiom half_gt_self_neg : forall x :e R , x < 0 -> x < x :/: 2.
Axiom continuous_at_nbhd_pos : forall f : set -> set , forall S c , continuous_at f S c -> 0 < f c -> exists delta :e R , 0 < delta /\ forall x :e S , dist_R x c < delta -> 0 < f x.
Axiom continuous_at_nbhd_neg : forall f : set -> set , forall S c , continuous_at f S c -> f c < 0 -> exists delta :e R , 0 < delta /\ forall x :e S , dist_R x c < delta -> f x < 0.
Axiom seq_limit_eventually_nonzero_of_limit_ne0 : forall x : set -> set , forall l , seq_limit x l -> l <> 0 -> exists N :e omega , forall n :e omega , N <= n -> x n <> 0.
Axiom finite_R_fun_abs_bounded : forall S , finite S -> forall g : set -> set , R_fun S g -> exists M :e R , 0 <= M /\ forall x :e S , abs_SNo (g x) <= M.
Axiom cluster_point_R : forall c :e R , cluster_point R c.
Axiom cluster_point_Ioi0 : forall c :e Ioi 0 , cluster_point (Ioi 0) c.
Axiom deriv_at_id_Ioi0 : forall c :e Ioi 0 , deriv_at (fun x : set => x) (Ioi 0) c 1.
Axiom deriv_at_recip_SNo_Ioi0 : forall c :e Ioi 0 , deriv_at (fun x => recip_SNo x) (Ioi 0) c ((- 1) :/: (c * c)).
Axiom recip_SNo_continuous_at_Ioi0 : forall c :e Ioi 0 , continuous_at (fun x => recip_SNo x) (Ioi 0) c.
Axiom sup_Sing_eq : forall x :e R , sup {x} = x.
Axiom inf_Sing_eq : forall x :e R , inf {x} = x.
