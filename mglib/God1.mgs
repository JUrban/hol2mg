Axiom ms_continuous_on_rect_imp_slice_integral_x_between_darboux_sums : forall a1 b1 a2 b2 :e R , a1 <= b1 -> forall f : set -> set , ms_continuous_on f (Rn 2) (Rn_dist 2) R dist_R (rect_Icc_R2 a1 b1 a2 b2) -> forall y :e (Icc a2 b2) , forall n :e omega , forall p : set -> set , is_partition_seq_Icc a1 b1 n p -> darboux_sum_lower_seq (fun x : set => f (R2_pair x y)) n p <= riemann_integral_Icc a1 b1 (fun x : set => f (R2_pair x y)) /\ riemann_integral_Icc a1 b1 (fun x : set => f (R2_pair x y)) <= darboux_sum_upper_seq (fun x : set => f (R2_pair x y)) n p.
Definition iterated_integral_xy_Icc : set -> set -> set -> set -> (set -> set) -> set := fun a1 b1 a2 b2 f => riemann_integral_Icc a1 b1 (fun x : set => riemann_integral_Icc a2 b2 (fun y : set => f (R2_pair x y))).
