Axiom god1_nonidentity_permutation_has_two_moved_points : forall n :e omega , forall sigma :e permutation_group n , sigma <> permutation_identity n -> exists i :e n , exists j :e n , i <> j /\ sigma i <> i /\ sigma j <> j.
