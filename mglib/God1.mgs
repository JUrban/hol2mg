Section form79.
Axiom upper_minus_lower_darboux_integral_Icc_Le_abs_bound : forall a b :e R , a < b -> forall f : set -> set , bounded_fun (Icc a b) f -> forall M :e R , (forall x :e Icc a b , abs_SNo (f x) <= M) -> upper_darboux_integral_Icc a b f + (- (lower_darboux_integral_Icc a b f)) <= (M * (b + (- a))) + (M * (b + (- a))).
Axiom abs_lower_darboux_integral_Icc_Le_abs_bound : forall a b :e R , a < b -> forall f : set -> set , bounded_fun (Icc a b) f -> forall M :e R , (forall x :e Icc a b , abs_SNo (f x) <= M) -> abs_SNo (lower_darboux_integral_Icc a b f) <= M * (b + (- a)).
Axiom abs_riemann_integral_Icc_Le_abs_bound : forall a b :e R , a < b -> forall f : set -> set , bounded_fun (Icc a b) f -> forall M :e R , (forall x :e Icc a b , abs_SNo (f x) <= M) -> abs_SNo (riemann_integral_Icc a b f) <= M * (b + (- a)).
End form79.
Section form80.
Axiom riemann_integrable_Icc_of_integrable_on_inner_intervals : forall a b :e R , a < b -> forall f : set -> set , bounded_fun (Icc a b) f -> forall an bn : set -> set , R_seq an -> R_seq bn -> (forall n :e omega , a < an n /\ an n < bn n /\ bn n < b) -> seq_limit an a -> seq_limit bn b -> (forall n :e omega , riemann_integrable_Icc (an n) (bn n) f) -> riemann_integrable_Icc a b f /\ seq_limit (fun n : set => riemann_integral_Icc (an n) (bn n) f) (riemann_integral_Icc a b f).
End form80.
Section form81.
Definition finitely_many_discontinuities_Icc : set -> set -> (set -> set) -> prop := fun a b f => exists S , finite S /\ S c= Icc a b /\ forall x :e Icc a b , x /:e S -> continuous_at f (Icc a b) x.
Axiom finitely_many_discontinuities_Icc_of_continuous_on : forall a b :e R , forall f : set -> set , continuous_on f (Icc a b) -> finitely_many_discontinuities_Icc a b f.
