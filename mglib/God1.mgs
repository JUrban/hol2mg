Axiom god1_ring_word_product_of_ones : forall L , forall add mul : set -> set -> set , ring L add mul -> forall n :e omega , god1_ring_word_product L add mul (fun i => ring_one L mul) n = ring_one L mul.
Axiom god1_ring_monomial_zero_exponent : forall L , forall add mul : set -> set -> set , ring L add mul -> forall n :e omega , forall x : set -> set , ring_monomial_value L add mul n x (fun i => 0) = ring_one L mul.
Axiom god1_single_monomial_is_polynomial_in_ring_elements : forall L , forall add mul : set -> set -> set , forall K , forall n :e omega , forall x : set -> set , commutative_ring L add mul -> subring L add mul K -> (forall i :e n , x i :e L) -> forall exponent :e omega :^: n , forall a :e K , polynomial_in_ring_elements L add mul K n x (mul a (ring_monomial_value L add mul n x (fun i => exponent i))).
Axiom god1_single_monomial_function_is_polynomial_in_ring_elements : forall L , forall add mul : set -> set -> set , forall K , forall n :e omega , forall x : set -> set , commutative_ring L add mul -> subring L add mul K -> (forall i :e n , x i :e L) -> forall exponent : set -> set , (fun i :e n => exponent i) :e omega :^: n -> forall a :e K , polynomial_in_ring_elements L add mul K n x (mul a (ring_monomial_value L add mul n x exponent)).
Axiom god1_almost_all_zero_pointwise_right_multiplication : forall L , forall add mul : set -> set -> set , ring L add mul -> forall I , forall f g : set -> set , almost_all_zero I (ring_zero L add) f -> (forall i :e I , g i :e L) -> almost_all_zero I (ring_zero L add) (fun i => mul (f i) (g i)).
Axiom god1_polynomial_values_closed_under_addition : forall L , forall add mul : set -> set -> set , forall K , forall n :e omega , forall x : set -> set , commutative_ring L add mul -> subring L add mul K -> (forall i :e n , x i :e L) -> forall y z :e L , polynomial_in_ring_elements L add mul K n x y -> polynomial_in_ring_elements L add mul K n x z -> polynomial_in_ring_elements L add mul K n x (add y z).
Axiom god1_commutative_ring_finite_sum_left_mul_finite : forall L , forall add mul : set -> set -> set , commutative_ring L add mul -> forall X , finite X -> forall f : set -> set , (forall i :e X , f i :e L) -> forall z :e L , mul z (ring_finite_sum L add X f) = ring_finite_sum L add X (fun i => mul z (f i)).
Axiom god1_polynomial_values_closed_under_multiplication : forall L , forall add mul : set -> set -> set , forall K , forall n :e omega , forall x : set -> set , commutative_ring L add mul -> subring L add mul K -> (forall i :e n , x i :e L) -> forall y z :e L , polynomial_in_ring_elements L add mul K n x y -> polynomial_in_ring_elements L add mul K n x z -> polynomial_in_ring_elements L add mul K n x (mul y z).
Axiom god1_constant_is_polynomial_in_ring_elements : forall L , forall add mul : set -> set -> set , forall K , forall n :e omega , forall x : set -> set , commutative_ring L add mul -> subring L add mul K -> (forall i :e n , x i :e L) -> forall a :e K , polynomial_in_ring_elements L add mul K n x a.
Axiom god1_polynomial_values_form_subring : forall L , forall add mul : set -> set -> set , forall K , forall n :e omega , forall x : set -> set , commutative_ring L add mul -> subring L add mul K -> (forall i :e n , x i :e L) -> subring L add mul {w :e L|polynomial_in_ring_elements L add mul K n x w}.
Axiom god1_commutative_ring_word_product_single_factor : forall L , forall add mul : set -> set -> set , commutative_ring L add mul -> forall n :e omega , forall i :e n , forall z :e L , god1_ring_word_product L add mul (fun j => if j = i then z else ring_one L mul) n = z.
Axiom god1_ring_monomial_standard_exponent : forall L , forall add mul : set -> set -> set , forall n :e omega , forall x : set -> set , commutative_ring L add mul -> (forall j :e n , x j :e L) -> forall i :e n , ring_monomial_value L add mul n x (fun j => if j = i then 1 else 0) = x i.
Axiom god1_generator_is_polynomial_in_ring_elements : forall L , forall add mul : set -> set -> set , forall K , forall n :e omega , forall x : set -> set , commutative_ring L add mul -> subring L add mul K -> (forall j :e n , x j :e L) -> forall i :e n , polynomial_in_ring_elements L add mul K n x (x i).
Axiom god1_subring_generated_by_finite_family_is_polynomial_values : forall L , forall add mul : set -> set -> set , forall K , forall n :e omega , forall x : set -> set , commutative_ring L add mul -> subring L add mul K -> (forall i :e n , x i :e L) -> subring_generated_by L add mul K {x i|i :e n} = {y :e L|polynomial_in_ring_elements L add mul K n x y}.
Definition algebraic_relation : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> (set -> set) -> (set -> set) -> prop := fun L add mul K n x coeff => (forall exponent :e omega :^: n , coeff exponent :e K) /\ almost_all_zero (omega :^: n) (ring_zero L add) coeff /\ polynomial_value_in_ring_elements L add mul K n x coeff = ring_zero L add.
Definition algebraically_independent : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> (set -> set) -> prop := fun L add mul K n x => forall coeff : set -> set , algebraic_relation L add mul K n x coeff -> forall exponent :e omega :^: n , coeff exponent = ring_zero L add.
Definition algebraically_dependent : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> (set -> set) -> prop := fun L add mul K n x => exists coeff : set -> set , algebraic_relation L add mul K n x coeff /\ exists exponent :e omega :^: n , coeff exponent <> ring_zero L add.
Definition algebraic_over : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> prop := fun L add mul K x => x :e L /\ algebraically_dependent L add mul K 1 (fun i => x).
Definition transcendental_over : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> prop := fun L add mul K x => x :e L /\ not (algebraic_over L add mul K x).
Axiom god1_subring_between_subfield_is_vector_space : forall L , forall add mul : set -> set -> set , forall K F , field L add mul -> subfield L add mul K -> subring L add mul F -> K c= F -> left_vector_space K add mul F add mul.
Axiom god1_finite_dimensional_left_endomorphism_injective_is_surjective : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall f : set -> set , finite_dimensional_vector_space K addK mulK M addM smul -> module_endomorphism K addK mulK M addM smul f -> inj M M f -> surj M M f.
Axiom god1_module_finitely_supported_sum_bijection_invariant_general : forall M , forall addM : set -> set -> set , abelian_group M addM -> forall I J , forall phi : set -> set , bij I J phi -> forall f : set -> set , (forall j :e J , f j :e M) -> almost_all_zero J (module_zero M addM) f -> almost_all_zero I (module_zero M addM) (fun i => f (phi i)) /\ module_finitely_supported_sum M addM J f = module_finitely_supported_sum M addM I (fun i => f (phi i)).
Axiom god1_natural_numbers_biject_one_variable_exponents : bij omega (omega :^: 1) (fun n => fun i :e 1 => n).
Axiom god1_one_variable_exponents_biject_natural_numbers : bij (omega :^: 1) omega (fun exponent => exponent 0).
Axiom god1_one_variable_ring_monomial_value : forall L , forall add mul : set -> set -> set , forall x :e L , ring L add mul -> forall exponent :e omega :^: 1 , ring_monomial_value L add mul 1 (fun i => x) (fun i => exponent i) = ring_natural_power L add mul x (exponent 0).
Axiom god1_one_variable_polynomial_value_as_natural_sum : forall L , forall add mul : set -> set -> set , forall K , forall x :e L , forall coeff : set -> set , commutative_ring L add mul -> (forall exponent :e omega :^: 1 , coeff exponent :e L) -> almost_all_zero (omega :^: 1) (ring_zero L add) coeff -> polynomial_value_in_ring_elements L add mul K 1 (fun i => x) coeff = module_finitely_supported_sum L add omega (fun r => mul (coeff (fun i :e 1 => r)) (ring_natural_power L add mul x r)).
Axiom god1_algebraic_element_has_natural_coefficient_relation : forall L , forall add mul : set -> set -> set , forall K , forall x :e L , field L add mul -> subfield L add mul K -> algebraic_over L add mul K x -> exists c : set -> set , (forall r :e omega , c r :e K) /\ almost_all_zero omega (ring_zero L add) c /\ module_finitely_supported_sum L add omega (fun r => mul (c r) (ring_natural_power L add mul x r)) = ring_zero L add /\ exists r :e omega , c r <> ring_zero L add.
Axiom god1_finitely_supported_nonzero_sequence_has_leading_index : forall zero , forall c : set -> set , almost_all_zero omega zero c -> (exists r :e omega , c r <> zero) -> exists d :e omega , c d <> zero /\ forall n :e omega , d :e n -> c n = zero.
Axiom god1_one_index_constant_image_is_singleton : forall x , {x|i :e 1} = {x}.
Axiom god1_successor_bijection_omega_nonzero : bij omega (omega :\: {0}) ordsucc.
Definition god1_prepend_shift_sequence : set -> set -> (set -> set) -> set -> set := fun zero a c n => if n = 0 then a else c (Union n).
Definition god1_head_sequence : set -> set -> set -> set := fun zero a n => if n = 0 then a else zero.
Definition god1_tail_sequence : set -> (set -> set) -> set -> set := fun zero c n => if n = 0 then zero else c (Union n).
Definition god1_weighted_power_sequence : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set) -> set -> set := fun L add mul x c n => mul (c n) (ring_natural_power L add mul x n).
Axiom god1_head_sequence_almost_all_zero : forall zero a , almost_all_zero omega zero (god1_head_sequence zero a).
Axiom god1_prepend_shift_sequence_almost_all_zero : forall zero a , forall c : set -> set , almost_all_zero omega zero c -> almost_all_zero omega zero (god1_prepend_shift_sequence zero a c).
Axiom god1_nonzero_natural_union_in_omega : forall n :e omega , n <> 0 -> Union n :e omega.
Axiom god1_prepend_shift_sequence_maps : forall M zero a , forall c : set -> set , a :e M -> (forall r :e omega , c r :e M) -> forall n :e omega , god1_prepend_shift_sequence zero a c n :e M.
Axiom god1_prepend_shift_weighted_power_sum : forall L , forall add mul : set -> set -> set , forall x a :e L , forall c : set -> set , commutative_ring L add mul -> (forall r :e omega , c r :e L) -> almost_all_zero omega (ring_zero L add) c -> module_finitely_supported_sum L add omega (fun n => mul (god1_prepend_shift_sequence (ring_zero L add) a c n) (ring_natural_power L add mul x n)) = add a (mul x (module_finitely_supported_sum L add omega (fun r => mul (c r) (ring_natural_power L add mul x r)))).
Axiom god1_head_weighted_power_sum : forall L , forall add mul : set -> set -> set , forall x a :e L , ring L add mul -> module_finitely_supported_sum L add omega (god1_weighted_power_sequence L add mul x (god1_head_sequence (ring_zero L add) a)) = a.
Axiom god1_natural_coefficient_relation_gives_algebraic_relation : forall L , forall add mul : set -> set -> set , forall K , forall x :e L , forall c : set -> set , commutative_ring L add mul -> subring L add mul K -> (forall r :e omega , c r :e K) -> almost_all_zero omega (ring_zero L add) c -> module_finitely_supported_sum L add omega (fun r => mul (c r) (ring_natural_power L add mul x r)) = ring_zero L add -> (exists r :e omega , c r <> ring_zero L add) -> exists coeff : set -> set , algebraic_relation L add mul K 1 (fun i => x) coeff /\ exists exponent :e omega :^: 1 , coeff exponent <> ring_zero L add.
Axiom god1_subfield_element_is_algebraic : forall L , forall add mul : set -> set -> set , forall K , field L add mul -> subfield L add mul K -> forall x :e K , algebraic_over L add mul K x.
Axiom god1_division_ring_relation_solves_last_family_member : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall B j , forall a coeff : set -> set , division_ring K addK mulK -> left_module K addK mulK M addM smul -> finite B -> j /:e B -> (forall i :e SetAdjoin B j , a i :e M) -> linear_relation K addK mulK M addM smul (SetAdjoin B j) a coeff -> coeff j <> ring_zero K addK -> linear_combination K addK mulK M addM smul B a (a j).
Axiom god1_subring_left_multiplication_endomorphism : forall L , forall add mul : set -> set -> set , forall K F , field L add mul -> subfield L add mul K -> subring L add mul F -> K c= F -> forall a :e F , module_endomorphism K add mul F add mul (fun u => mul a u).
Axiom god1_ring_is_subring_of_itself : forall R , forall add mul : set -> set -> set , ring R add mul -> subring R add mul R.
Axiom god1_s26_theorem1_algebraic_element_characterizations : forall L , forall add mul : set -> set -> set , forall K , forall x :e L , field L add mul -> subfield L add mul K -> let Kx := subring_generated_by L add mul K {x} in (algebraic_over L add mul K x <-> finite_dimensional_vector_space K add mul Kx add mul) /\ (finite_dimensional_vector_space K add mul Kx add mul <-> subfield L add mul Kx).
Definition relative_algebraic_closure : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set := fun L add mul K => {x :e L|algebraic_over L add mul K x}.
Axiom god1_finite_dimensional_left_space_has_ordinal_basis : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , finite_dimensional_vector_space K addK mulK M addM smul -> exists n :e omega , exists a : set -> set , module_basis K addK mulK M addM smul n a.
Axiom god1_finite_dimensional_left_submodule_is_finite_dimensional : forall K , forall addK mulK : set -> set -> set , forall M , forall addM smul : set -> set -> set , forall N , finite_dimensional_vector_space K addK mulK M addM smul -> submodule K addK mulK M addM smul N -> finite_dimensional_vector_space K addK mulK N addM smul.
Axiom god1_finite_intermediate_subring_element_is_algebraic : forall L , forall add mul : set -> set -> set , forall K F , field L add mul -> subfield L add mul K -> subring L add mul F -> K c= F -> finite_dimensional_vector_space K add mul F add mul -> forall z :e F , algebraic_over L add mul K z.
Axiom god1_subring_left_multiplication_into_ambient_homomorphism : forall L , forall add mul : set -> set -> set , forall K F , field L add mul -> subfield L add mul K -> subring L add mul F -> K c= F -> forall a :e L , module_homomorphism K add mul F add mul L add mul (fun u => mul a u).
Axiom god1_intermediate_subring_multiplication_is_bilinear : forall L , forall add mul : set -> set -> set , forall K A B , field L add mul -> subfield L add mul K -> subring L add mul A -> K c= A -> subring L add mul B -> K c= B -> bilinear_mapping K add mul A add mul B add mul L add mul (fun z : set => mul (z 0) (z 1)).
Axiom god1_intermediate_subring_is_vector_submodule : forall L , forall add mul : set -> set -> set , forall K F , field L add mul -> subfield L add mul K -> subring L add mul F -> K c= F -> submodule K add mul L add mul F.
Axiom god1_product_of_basis_spans_is_linear_combination : forall L , forall add mul : set -> set -> set , forall K A B F , forall p q :e omega , forall a b : set -> set , field L add mul -> subfield L add mul K -> subring L add mul A -> K c= A -> subring L add mul B -> K c= B -> subring L add mul F -> K c= F -> A c= F -> B c= F -> module_basis K add mul A add mul p a -> module_basis K add mul B add mul q b -> forall u :e A , forall v :e B , linear_combination K add mul F add mul (p :*: q) (fun w => mul (a (w 0)) (b (w 1))) (mul u v).
Axiom god1_two_index_conditional_image_is_pair : forall x y , {(if i = 0 then x else y)|i :e 2} = {x,y}.
Axiom god1_two_variable_ring_monomial_value : forall L , forall add mul : set -> set -> set , forall x y , ring L add mul -> x :e L -> y :e L -> forall exponent :e omega :^: 2 , ring_monomial_value L add mul 2 (fun i => if i = 0 then x else y) (fun i => exponent i) = mul (ring_natural_power L add mul x (exponent 0)) (ring_natural_power L add mul y (exponent 1)).
Axiom god1_product_bases_generate_two_element_subring : forall L , forall add mul : set -> set -> set , forall K x y , forall p q :e omega , forall a b : set -> set , field L add mul -> subfield L add mul K -> x :e L -> y :e L -> module_basis K add mul (subring_generated_by L add mul K {x}) add mul p a -> module_basis K add mul (subring_generated_by L add mul K {y}) add mul q b -> generating_family K add mul (subring_generated_by L add mul K {x,y}) add mul (p :*: q) (fun w => mul (a (w 0)) (b (w 1))).
Axiom god1_s26_theorem2_algebraic_elements_form_subfield : forall L , forall add mul : set -> set -> set , forall K , field L add mul -> subfield L add mul K -> subfield L add mul (relative_algebraic_closure L add mul K).
Definition multivariate_polynomial_ring : set -> (set -> set -> set) -> set -> set := fun K add n => {f :e K :^: (omega :^: n)|almost_all_zero (omega :^: n) (ring_zero K add) (fun exponent => f exponent)}.
Definition polynomial_addition : set -> (set -> set -> set) -> set -> set -> set -> set := fun K add n f g => fun exponent :e omega :^: n => add (f exponent) (g exponent).
Definition polynomial_multiplication : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set -> set := fun K add mul n f g => fun exponent :e omega :^: n => module_finitely_supported_sum K add {u :e (omega :^: n) :*: (omega :^: n)|forall i :e n , add_SNo (u 0 i) (u 1 i) = exponent i} (fun u => mul (f (u 0)) (g (u 1))).
Definition polynomial_constant : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set := fun K add mul n a => fun exponent :e omega :^: n => if exponent = (fun i :e n => 0) then a else ring_zero K add.
Definition polynomial_constant_subring : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set := fun K add mul n => {polynomial_constant K add mul n a|a :e K}.
Definition polynomial_standard_exponent : set -> set -> set := fun n i => fun j :e n => if j = i then 1 else 0.
Definition polynomial_indeterminate : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set := fun K add mul n i => fun exponent :e omega :^: n => if exponent = polynomial_standard_exponent n i then ring_one K mul else ring_zero K add.
Axiom god1_almost_all_zero_pointwise_congr : forall I zero , forall f g : set -> set , almost_all_zero I zero f -> (forall i :e I , f i = g i) -> almost_all_zero I zero g.
Axiom god1_polynomial_convolution_terms_almost_all_zero : forall K , forall add mul : set -> set -> set , forall I D , forall f g : set -> set , ring K add mul -> D c= I :*: I -> almost_all_zero I (ring_zero K add) f -> almost_all_zero I (ring_zero K add) g -> (forall i :e I , f i :e K) -> (forall i :e I , g i :e K) -> almost_all_zero D (ring_zero K add) (fun u => mul (f (u 0)) (g (u 1))) /\ nonzero_support D (ring_zero K add) (fun u => mul (f (u 0)) (g (u 1))) c= nonzero_support I (ring_zero K add) f :*: nonzero_support I (ring_zero K add) g.
Axiom god1_polynomial_convolution_almost_all_zero : forall K , forall add mul : set -> set -> set , forall n , forall f g : set -> set , ring K add mul -> (forall exponent :e omega :^: n , f exponent :e K) -> (forall exponent :e omega :^: n , g exponent :e K) -> almost_all_zero (omega :^: n) (ring_zero K add) f -> almost_all_zero (omega :^: n) (ring_zero K add) g -> almost_all_zero (omega :^: n) (ring_zero K add) (fun exponent => module_finitely_supported_sum K add {u :e (omega :^: n) :*: (omega :^: n)|forall i :e n , add_SNo (u 0 i) (u 1 i) = exponent i} (fun u => mul (f (u 0)) (g (u 1)))).
Axiom god1_polynomial_constant_member_and_zero_evaluation : forall K , forall add mul : set -> set -> set , forall n , ring K add mul -> forall a :e K , polynomial_constant K add mul n a :e multivariate_polynomial_ring K add n /\ polynomial_constant K add mul n a (fun i :e n => 0) = a.
Axiom god1_polynomial_constant_support_subset : forall K , forall add mul : set -> set -> set , forall n a , nonzero_support (omega :^: n) (ring_zero K add) (fun exponent => polynomial_constant K add mul n a exponent) c= {(fun i :e n => 0)}.
Axiom god1_polynomial_decomposition_swap_bijection : forall n exponent , bij {u :e (omega :^: n) :*: (omega :^: n)|forall i :e n , add_SNo (u 0 i) (u 1 i) = exponent i} {u :e (omega :^: n) :*: (omega :^: n)|forall i :e n , add_SNo (u 0 i) (u 1 i) = exponent i} (fun u => (u 1,u 0)).
Axiom god1_polynomial_multiplication_closed : forall K , forall add mul : set -> set -> set , forall n , ring K add mul -> forall f g :e multivariate_polynomial_ring K add n , polynomial_multiplication K add mul n f g :e multivariate_polynomial_ring K add n.
Axiom god1_polynomial_addition_closed : forall K , forall add mul : set -> set -> set , forall n , ring K add mul -> forall f g :e multivariate_polynomial_ring K add n , polynomial_addition K add n f g :e multivariate_polynomial_ring K add n.
Axiom god1_almost_all_zero_pointwise_group_inverse : forall G , forall op : set -> set -> set , forall I , group G op -> forall f : set -> set , (forall i :e I , f i :e G) -> almost_all_zero I (group_identity G op) f -> almost_all_zero I (group_identity G op) (fun i => group_inverse G op (f i)).
Axiom god1_polynomial_additive_abelian_group : forall K , forall add mul : set -> set -> set , forall n , ring K add mul -> abelian_group (multivariate_polynomial_ring K add n) (polynomial_addition K add n).
Axiom god1_polynomial_multiplication_commutative : forall K , forall add mul : set -> set -> set , forall n , commutative_ring K add mul -> forall f g :e multivariate_polynomial_ring K add n , polynomial_multiplication K add mul n f g = polynomial_multiplication K add mul n g f.
Axiom god1_polynomial_left_distributive : forall K , forall add mul : set -> set -> set , forall n , ring K add mul -> forall f g h :e multivariate_polynomial_ring K add n , polynomial_multiplication K add mul n f (polynomial_addition K add n g h) = polynomial_addition K add n (polynomial_multiplication K add mul n f g) (polynomial_multiplication K add mul n f h).
Axiom god1_polynomial_distributive_laws : forall K , forall add mul : set -> set -> set , forall n , commutative_ring K add mul -> forall f g h :e multivariate_polynomial_ring K add n , polynomial_multiplication K add mul n f (polynomial_addition K add n g h) = polynomial_addition K add n (polynomial_multiplication K add mul n f g) (polynomial_multiplication K add mul n f h) /\ polynomial_multiplication K add mul n (polynomial_addition K add n f g) h = polynomial_addition K add n (polynomial_multiplication K add mul n f h) (polynomial_multiplication K add mul n g h).
Axiom god1_polynomial_constant_one_left_identity : forall K , forall add mul : set -> set -> set , forall n , ring K add mul -> forall f :e multivariate_polynomial_ring K add n , polynomial_multiplication K add mul n (polynomial_constant K add mul n (ring_one K mul)) f = f.
Axiom god1_polynomial_constant_one_neutral : forall K , forall add mul : set -> set -> set , forall n , commutative_ring K add mul -> neutral_element (multivariate_polynomial_ring K add n) (polynomial_multiplication K add mul n) (polynomial_constant K add mul n (ring_one K mul)).
Axiom god1_polynomial_convolution_coefficient_finite_restriction : forall K , forall add mul : set -> set -> set , forall n , ring K add mul -> forall f g : set -> set , (forall exponent :e omega :^: n , f exponent :e K) -> (forall exponent :e omega :^: n , g exponent :e K) -> forall A B , finite A -> finite B -> A c= omega :^: n -> B c= omega :^: n -> nonzero_support (omega :^: n) (ring_zero K add) f c= A -> nonzero_support (omega :^: n) (ring_zero K add) g c= B -> forall exponent :e omega :^: n , module_finitely_supported_sum K add {u :e (omega :^: n) :*: (omega :^: n)|forall i :e n , add_SNo (u 0 i) (u 1 i) = exponent i} (fun u => mul (f (u 0)) (g (u 1))) = ring_finite_sum K add {u :e A :*: B|forall i :e n , add_SNo (u 0 i) (u 1 i) = exponent i} (fun u => mul (f (u 0)) (g (u 1))).
Axiom god1_tuple_sigma : forall X , forall Y : set -> set , forall x :e X , forall y :e Y x , (x,y) :e (Sigma_ i :e X , Y i).
Axiom god1_abelian_finite_dependent_double_sum : forall G , forall op : set -> set -> set , abelian_group G op -> forall I , finite I -> forall J : set -> set , (forall i :e I , finite (J i)) -> forall F : set -> set , (forall z :e (Sigma_ i :e I , J i) , F z :e G) -> finite (Sigma_ i :e I , J i) /\ ring_finite_sum G op I (fun i => ring_finite_sum G op (J i) (fun j => F ((i,j)))) = ring_finite_sum G op (Sigma_ i :e I , J i) F.
Definition god1_polynomial_exponent_addition : set -> set -> set -> set := fun n x y => fun i :e n => add_SNo (x i) (y i).
Axiom god1_polynomial_exponent_addition_maps : forall n , forall x y :e omega :^: n , god1_polynomial_exponent_addition n x y :e omega :^: n.
