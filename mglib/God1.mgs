Definition god1_dependent_sigma_reassociation_map : set -> set := fun z => (z 0 0,(z 0 1,z 1)).
Definition god1_dependent_sigma_unreassociation_map : set -> set := fun y => ((y 0,y 1 0),y 1 1).
Axiom god1_dependent_sigma_reassociation_raw_left_inverse : forall z , god1_dependent_sigma_unreassociation_map (god1_dependent_sigma_reassociation_map z) = ((z 0 0,z 0 1),z 1).
Axiom god1_dependent_sigma_reassociation_raw_right_inverse : forall y , god1_dependent_sigma_reassociation_map (god1_dependent_sigma_unreassociation_map y) = (y 0,(y 1 0,y 1 1)).
Axiom god1_dependent_sigma_reassociation_map_on_literal : forall i k j , god1_dependent_sigma_reassociation_map ((i,k),j) = (i,(k,j)).
