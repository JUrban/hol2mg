Definition god1_characteristic_permutation_product : set -> (set -> set -> set) -> (set -> set -> set) -> set -> set -> set -> set := fun K add mul n A sigma => ring_finite_product (multivariate_polynomial_ring K add 1) (polynomial_addition K add 1) (polynomial_multiplication K add mul 1) n (fun j => god1_characteristic_permutation_factor K add mul n A sigma j).
