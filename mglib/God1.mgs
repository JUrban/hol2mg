Axiom contains_complex_constants_nonempty : forall X , forall A , contains_complex_constants X A -> nonempty A.
Definition real_members_of_complex_algebra : set -> set -> set := fun X A => {f :e A|forall x :e X , f x :e R}.
Axiom real_members_of_complex_algebra_subq : forall X , forall A , real_members_of_complex_algebra X A c= A.
