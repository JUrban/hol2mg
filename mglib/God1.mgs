Axiom god1_endomorphism_polynomial_evaluation_linear_root_power : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall n :e omega , forall a : set -> set , forall u : set -> set , forall lambda :e K , forall r :e omega , field K addK mulK -> module_basis K addK mulK E addE smul n a -> module_endomorphism K addK mulK E addE smul u -> forall x :e E , endomorphism_polynomial_evaluation K addK mulK E addE smul (ring_nat_power (multivariate_polynomial_ring K addK 1) (polynomial_addition K addK 1) (polynomial_multiplication K addK mulK 1) (linear_root_polynomial K addK mulK lambda) r) u x = endomorphism_natural_power K addK mulK E addE smul (endomorphism_shift K addK mulK E addE smul u lambda) r x.
Axiom god1_divisible_polynomial_evaluation_annihilates : forall K , forall addK mulK : set -> set -> set , forall E , forall addE smul : set -> set -> set , forall n :e omega , forall a : set -> set , forall u : set -> set , forall f g :e multivariate_polynomial_ring K addK 1 , commutative_ring K addK mulK -> module_basis K addK mulK E addE smul n a -> module_endomorphism K addK mulK E addE smul u -> ring_divides (multivariate_polynomial_ring K addK 1) (polynomial_multiplication K addK mulK 1) f g -> forall x :e E , endomorphism_polynomial_evaluation K addK mulK E addE smul f u x = module_zero E addE -> endomorphism_polynomial_evaluation K addK mulK E addE smul g u x = module_zero E addE.
Axiom god1_complementary_finite_product_divisible_by_other_factor : forall K , forall add mul : set -> set -> set , forall n :e omega , forall b : set -> set , commutative_ring K add mul -> (forall k :e n , b k :e K) -> forall i j :e n , i <> j -> ring_divides K mul (b i) (ring_finite_product K add mul n (fun k => if k = j then ring_one K mul else b k)).
