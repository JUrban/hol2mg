Definition affine_membership_coordinate_matrix : set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> (set -> set -> set) -> set -> (set -> set -> set) -> set -> set -> (set -> set) -> (set -> set) -> set -> set := fun K addK mulK T addT smulT E action n q P Q R => fun u :e ordsucc n :*: ordsucc q => if u 1 = 0 then affine_coordinates K addK mulK T addT smulT E action n P R (u 0) else affine_coordinates K addK mulK T addT smulT E action n P (Q (Union (u 1))) (u 0).
