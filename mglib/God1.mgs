Axiom riemann_integral_Icc_tail_eq : forall a b c :e R , a <= b -> b <= c -> forall f : set -> set , riemann_integrable_Icc a c f -> riemann_integrable_Icc a b f -> riemann_integrable_Icc b c f -> riemann_integral_Icc b c f = (- (riemann_integral_Icc a b f)) + riemann_integral_Icc a c f.
Axiom riemann_integrable_Icc_tail : forall a b c :e R , a <= b -> b <= c -> forall f : set -> set , riemann_integrable_Icc a c f -> riemann_integrable_Icc a b f -> riemann_integrable_Icc b c f.
Axiom riemann_integrable_Icc_head : forall a b c :e R , a <= b -> b <= c -> forall f : set -> set , riemann_integrable_Icc a c f -> riemann_integrable_Icc b c f -> riemann_integrable_Icc a b f.
Axiom riemann_integrable_Icc_split : forall a c b :e R , a <= c -> c <= b -> forall f : set -> set , riemann_integrable_Icc a b f -> riemann_integrable_Icc a c f /\ riemann_integrable_Icc c b f.
