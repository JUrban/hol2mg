Axiom god1_subring_ring_word_product_in : forall L , forall add mul : set -> set -> set , forall A , subring L add mul A -> forall n :e omega , forall f : set -> set , (forall i :e n , f i :e A) -> god1_ring_word_product L add mul f n :e A.
Axiom god1_finitely_supported_sum_in_subgroup : forall G , forall op : set -> set -> set , forall H I , abelian_group G op -> subgroup G op H -> forall f : set -> set , almost_all_zero I (module_zero G op) f -> (forall i :e I , f i :e H) -> module_finitely_supported_sum G op I f :e H.
Axiom god1_ring_monomial_value_in_subring : forall L , forall add mul : set -> set -> set , forall A , forall n :e omega , forall x : set -> set , subring L add mul A -> (forall i :e n , x i :e A) -> forall exponent :e omega :^: n , ring_monomial_value L add mul n x (fun i => exponent i) :e A.
Axiom god1_finite_sum_in_additively_closed_subset : forall G , forall op : set -> set -> set , forall H , abelian_group G op -> H c= G -> group_identity G op :e H -> (forall u v :e H , op u v :e H) -> forall X , finite X -> forall f : set -> set , (forall i :e X , f i :e H) -> ring_finite_sum G op X f :e H.
Axiom god1_ring_natural_power_add : forall L , forall add mul : set -> set -> set , ring L add mul -> forall z :e L , forall a b :e omega , mul (ring_natural_power L add mul z a) (ring_natural_power L add mul z b) = ring_natural_power L add mul z (add_nat a b).
Axiom god1_commutative_ring_word_product_pointwise_product : forall L , forall add mul : set -> set -> set , commutative_ring L add mul -> forall n :e omega , forall f g : set -> set , (forall i :e n , f i :e L) -> (forall i :e n , g i :e L) -> mul (god1_ring_word_product L add mul f n) (god1_ring_word_product L add mul g n) = god1_ring_word_product L add mul (fun i => mul (f i) (g i)) n.
Axiom god1_ring_monomial_value_product : forall L , forall add mul : set -> set -> set , forall n :e omega , forall x : set -> set , commutative_ring L add mul -> (forall i :e n , x i :e L) -> forall a b :e omega :^: n , mul (ring_monomial_value L add mul n x (fun i => a i)) (ring_monomial_value L add mul n x (fun i => b i)) = ring_monomial_value L add mul n x (fun i => add_nat (a i) (b i)).
