Definition is_C_function_algebra : set -> set -> prop := fun X A => A c= setexp complex X /\ (forall f :e A , forall g :e A , (fun x :e X => (f x) + (g x)) :e A) /\ (forall f :e A , forall g :e A , (fun x :e X => (f x) * (g x)) :e A) /\ (forall c :e complex , forall f :e A , (fun x :e X => c * (f x)) :e A).
Axiom is_C_function_algebra_subq_setexp : forall X , forall A , is_C_function_algebra X A -> A c= setexp complex X.
