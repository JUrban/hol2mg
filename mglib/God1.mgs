Axiom mvtmv_Rn_nonzero : forall n :e omega , forall a b :e R , a < b -> forall phi phi' : set -> set , (forall t :e Icc a b , phi t :e (Rn n)) -> (forall t :e Ioo a b , phi' t :e (Rn n)) -> (forall t :e Ioo a b , forall j :e n , deriv_at (fun s : set => (phi s) j) (Icc a b) t ((phi' t) j)) -> (forall j :e n , continuous_on (fun t : set => (phi t) j) (Icc a b)) -> Rn_add n (phi b) (Rn_neg n (phi a)) <> Rn_zero n -> exists t0 :e Ioo a b , Rn_norm n (Rn_add n (phi b) (Rn_neg n (phi a))) <= (b + (- a)) * (Rn_norm n (phi' t0)).
Axiom mvtmv_Rn : forall n :e omega , forall a b :e R , a < b -> forall phi phi' : set -> set , (forall t :e Icc a b , phi t :e (Rn n)) -> (forall t :e Ioo a b , phi' t :e (Rn n)) -> (forall t :e Ioo a b , forall j :e n , deriv_at (fun s : set => (phi s) j) (Icc a b) t ((phi' t) j)) -> (forall j :e n , continuous_on (fun t : set => (phi t) j) (Icc a b)) -> exists t0 :e Ioo a b , Rn_norm n (Rn_add n (phi b) (Rn_neg n (phi a))) <= (b + (- a)) * (Rn_norm n (phi' t0)).
