{
 "version": 1,
 "description": "Hand overrides for Multivariate concepts where the automatic definition is exact but unidiomatic.",
 "types": [],
 "constants": [
  {
   "hol": "vector_norm",
   "scheme": "real^N->real",
   "args": [
    "set"
   ],
   "result": "set",
   "template": "vector_norm ?N ?1",
   "class": "definitionally_exact",
   "status": "reviewed",
   "override": {
    "params": [
     "N"
    ],
    "args": [
     "x"
    ],
    "body": "sqrt_SNo_nonneg (dot N x x)"
   },
   "notes": "HOL Light: norm x = sqrt (x dot x); dot x x >= 0, so the odd extension of sqrt is not needed"
  },
  {
   "hol": "distance",
   "scheme": "real^N#real^N->real",
   "args": [
    "set"
   ],
   "result": "set",
   "template": "distance ?N ?1",
   "class": "definitionally_exact",
   "status": "reviewed",
   "override": {
    "params": [
     "N"
    ],
    "args": [
     "p"
    ],
    "body": "vector_norm N (vector_sub N (p 0) (p 1))"
   },
   "notes": "HOL Light constant distance (printed dist); uncurried, stays a pair argument"
  }
 ]
}