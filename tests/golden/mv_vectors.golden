### NORM_TRIANGLE   [Multivariate/vectors.ml statements requiring transport and generalization]
hash: ef6fc4fbee0886f6797c0875c1aca463
status: transport_required
statement: forall A:set, A <> Empty -> forall x y :e R :^: idx A, vector_norm A (vector_add A x y) <= vector_norm A x + vector_norm A y

### LINEAR_ADD   [Multivariate/vectors.ml statements requiring transport and generalization]
hash: 80767b008813f5a667ce3d3fa0d64983
status: transport_required
statement: forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e R :^: idx A, f x :e R :^: idx B) -> forall x y :e R :^: idx A, linear A B f -> f (vector_add A x y) = vector_add B (f x) (f y)

