let P.
let f.
assume H1.
apply iffI.
- assume H4.
  let x1. assume Hx1.
  let y1. assume Hy1.
  assume H5.
  apply iffI.
  + assume H7.
    exact (H4 (x1) Hx1 (y1) Hy1 (andI (P x1) (P y1 /\ f x1 = f y1) (andEL (P x1) (P y1) H5) (andI (P y1) (f x1 = f y1) (andER (P x1) (P y1) H5) H7))).
  + assume H6.
    exact (H6 (fun hl__u hl__v => (f x1) = (f hl__u)) (fun q H => H)).
- assume H2.
  let x. assume Hx.
  let y. assume Hy.
  assume H3.
