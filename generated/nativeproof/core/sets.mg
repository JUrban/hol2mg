Theorem INJECTIVE_ON_ALT : forall A B:set, B <> Empty -> forall P:set -> prop, forall f:set -> set, (forall x :e A, f x :e B) -> ((forall x y :e A, P x /\ (P y /\ f x = f y) -> x = y) <-> forall x y :e A, P x /\ P y -> (f x = f y <-> x = y)).
