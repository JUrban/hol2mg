let A.
let C.
let D.
assume H.
assume H1.
assume H2.
exact ((andER (B -> A) (C -> D) H) (H1 ((andEL (B -> A) (C -> D) H) H2))).
Qed.

// HOL Light: theorems.ml / MONO_FORALL
Theorem MONO_FORALL : forall A:set, forall P Q:set -> prop, (forall x :e A, P x -> Q x) -> (forall x :e A, P x) -> forall x :e A, Q x.
