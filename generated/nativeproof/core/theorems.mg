Theorem MONO_EXISTS : forall A:set, forall P Q:set -> prop, (forall x :e A, P x -> Q x) -> (exists x :e A, P x) -> exists x :e A, Q x.
let A.
let P.
let Q.
assume H.
assume H1.
apply H1. let x. assume H2. apply H2. assume Hx H3.
witness x.
