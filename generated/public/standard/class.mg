Theorem bool_INDUCT : forall P:set -> prop, P (if False then 1 else 0) /\ P (if True then 1 else 0) -> forall x:prop, P (if x then 1 else 0).
Admitted.

// HOL Light: class.ml:484 / bool_RECURSION
