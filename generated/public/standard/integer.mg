// HOL Light: Library/integer.ml:743 / INT_CONG_GCD_RIGHT
// Source hash: md5:94288c344c7a0c0c1bcfce9399799a79
// Status: transport_required (bridges: hol_int_int, hol_prod_setprod)
Theorem INT_CONG_GCD_RIGHT : forall x y n :e int, divides_int n (x + - y) -> gcd_int n x = gcd_int n y.
Admitted.

