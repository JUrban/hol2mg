// HOL Light: Library/integer.ml:349 / INT_LCM_UNIQUE_ABS
// Source hash: md5:eacdf83913c2479d6fc7d7b15ea1c2ca
// Status: transport_required (bridges: hol_int_int, hol_prod_setprod)
Theorem INT_LCM_UNIQUE_ABS : forall a b m :e int, lcm_int a b = abs_SNo m <-> divides_int a m /\ (divides_int b m /\ forall n :e int, divides_int a n /\ divides_int b n -> divides_int m n).
Admitted.

// HOL Light: Library/integer.ml:360 / INT_LCM_UNIQUE
// Source hash: md5:70055e9fc350abf76cd74fe334d5c40f
// Status: transport_required (bridges: hol_int_int, hol_num_omega, hol_prod_setprod, omega_Subq_int)
Theorem INT_LCM_UNIQUE : forall a b m :e int, lcm_int a b = m <-> 0 <= m /\ (divides_int a m /\ (divides_int b m /\ forall n :e int, divides_int a n /\ divides_int b n -> divides_int m n)).
Admitted.

