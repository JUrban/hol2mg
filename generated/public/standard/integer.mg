// Status: transport_required (bridges: hol_int_int)
Theorem INT_CONG_ADD : forall n x x' y y' :e int, divides_int n (x + - x') /\ divides_int n (y + - y') -> divides_int n ((x + y) + - (x' + y')).
Admitted.

