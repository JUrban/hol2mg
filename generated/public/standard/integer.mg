// Source hash: md5:d4909a3cb8f589c27732d55ef02a55d8
// Status: transport_required (bridges: hol_int_int, hol_prod_setprod)
Theorem INT_CONG_GCD_LEFT : forall x y n :e int, divides_int n (x + - y) -> gcd_int x n = gcd_int y n.
Admitted.

// HOL Light: Library/integer.ml:751 / INT_CONG_TO_1
// Source hash: md5:01a5499820571efa3fdf804faa91d0b7
// Status: transport_required (bridges: hol_int_int, hol_num_omega, omega_Subq_int)
Theorem INT_CONG_TO_1 : forall a n :e int, divides_int n (a + - 1) <-> exists m :e int, a = 1 + m * n.
Admitted.

// HOL Light: Library/integer.ml:755 / INT_CONG_SOLVE
// Source hash: md5:890ac1c314850531845bf18d173dcb38
// Status: transport_required (bridges: hol_int_int, hol_prod_setprod)
Theorem INT_CONG_SOLVE : forall a b n :e int, gcd_int a n = 1 -> exists x :e int, divides_int n (a * x + - b).
Admitted.

// HOL Light: Library/integer.ml:759 / INT_CONG_SOLVE_EQ
// Source hash: md5:533450fbd9686cabe10dac2632b6b355
// Status: transport_required (bridges: hol_int_int, hol_prod_setprod)
Theorem INT_CONG_SOLVE_EQ : forall n a b :e int, (exists x :e int, divides_int n (a * x + - b)) <-> divides_int (gcd_int a n) b.
Admitted.

// HOL Light: Library/integer.ml:763 / INT_CONG_SOLVE_UNIQUE
// Source hash: md5:64645164ac2da06b4de79e6704ba30a3
// Status: transport_required (bridges: hol_int_int, hol_prod_setprod)
Theorem INT_CONG_SOLVE_UNIQUE : forall a b n :e int, gcd_int a n = 1 -> forall x y :e int, divides_int n (a * x + - b) /\ divides_int n (a * y + - b) -> divides_int n (x + - y).
Admitted.

// HOL Light: Library/integer.ml:769 / INT_CONG_CHINESE
// Source hash: md5:1340a10e3ac5139ccec028e02f47e04c
// Status: transport_required (bridges: hol_int_int, hol_prod_setprod)
Theorem INT_CONG_CHINESE : forall a b x y :e int, gcd_int a b = 1 /\ (divides_int a (x + - y) /\ divides_int b (x + - y)) -> divides_int (a * b) (x + - y).
Admitted.

// HOL Light: Library/integer.ml:774 / INT_CHINESE_REMAINDER_COPRIME
// Source hash: md5:352be3399abccab628974064a89a2799
// Status: transport_required (bridges: hol_int_int, hol_num_omega, hol_prod_setprod, omega_Subq_int)
Theorem INT_CHINESE_REMAINDER_COPRIME : forall a b m n :e int, gcd_int a b = 1 /\ (~ a = 0 /\ (~ b = 0 /\ (gcd_int m a = 1 /\ gcd_int n b = 1))) -> exists x :e int, gcd_int x (a * b) = 1 /\ (divides_int a (x + - m) /\ divides_int b (x + - n)).
Admitted.

// HOL Light: Library/integer.ml:781 / INT_CHINESE_REMAINDER_COPRIME_UNIQUE
// Source hash: md5:b8ded85b630e926430c5074530626c36
// Status: transport_required (bridges: hol_int_int, hol_prod_setprod)
Theorem INT_CHINESE_REMAINDER_COPRIME_UNIQUE : forall a b m n x y :e int, gcd_int a b = 1 /\ (divides_int a (x + - m) /\ (divides_int b (x + - n) /\ (divides_int a (y + - m) /\ divides_int b (y + - n)))) -> divides_int (a * b) (x + - y).
Admitted.

// HOL Light: Library/integer.ml:789 / SOLVABLE_GCD
// Source hash: md5:8929ee982a2a66eec83bf779d6dc44d3
// Status: transport_required (bridges: hol_int_int, hol_prod_setprod)
Theorem SOLVABLE_GCD : forall a b n :e int, divides_int (gcd_int a n) b -> exists x :e int, divides_int n (a * x + - b).
Admitted.

// HOL Light: Library/integer.ml:793 / INT_LINEAR_CONG_POS
// Source hash: md5:adcf6363d6cf6e27cc5d50926cdc8862
// Status: transport_required (bridges: hol_int_int, hol_num_omega, omega_Subq_int)
Theorem INT_LINEAR_CONG_POS : forall n a x :e int, ~ n = 0 -> exists y :e int, 0 <= y /\ divides_int n (a * x + - a * y).
Admitted.

// HOL Light: Library/integer.ml:803 / INT_CONG_SOLVE_POS
// Source hash: md5:3a2433ba1ae4515a1795297e8563d812
// Status: transport_required (bridges: hol_int_int, hol_num_omega, hol_prod_setprod, omega_Subq_int)
Theorem INT_CONG_SOLVE_POS : forall a b n :e int, gcd_int a n = 1 /\ ~ (n = 0 /\ abs_SNo a = 1) -> exists x :e int, 0 <= x /\ divides_int n (a * x + - b).
Admitted.

// HOL Light: Library/integer.ml:813 / INT_CONG_IMP_EQ
// Source hash: md5:64ca351c1c549d45b6d4c9d074b3bde6
// Status: transport_required (bridges: hol_int_int)
Theorem INT_CONG_IMP_EQ : forall x y n :e int, abs_SNo (x + - y) < n /\ divides_int n (x + - y) -> x = y.
Admitted.

// HOL Light: Library/integer.ml:827 / INT_CONG_DIV
// Source hash: md5:677f3c7c2513e2eb0914fd72e749ebf1
// Status: transport_required (bridges: hol_int_int, hol_num_omega, omega_Subq_int)
Theorem INT_CONG_DIV : forall m n a b :e int, ~ m = 0 /\ divides_int (m * n) (a + - m * b) -> divides_int n (div_int a m + - b).
Admitted.

// HOL Light: Library/integer.ml:832 / INT_CONG_DIV_COPRIME
// Source hash: md5:6c5f6ee31a1b3a7ec917432a096b4184
// Status: transport_required (bridges: hol_int_int, hol_prod_setprod)
Theorem INT_CONG_DIV_COPRIME : forall m n a b :e int, gcd_int m n = 1 /\ (divides_int m a /\ divides_int n (a + - m * b)) -> divides_int n (div_int a m + - b).
Admitted.

// HOL Light: Library/integer.ml:846 / INT_CRT_STRONG
// Source hash: md5:11dcb4b2ebe2c61fb6ae3e8913eee872
// Status: transport_required (bridges: hol_int_int, hol_prod_setprod)
Theorem INT_CRT_STRONG : forall a1 a2 n1 n2 :e int, divides_int (gcd_int n1 n2) (a1 + - a2) -> exists x :e int, divides_int n1 (x + - a1) /\ divides_int n2 (x + - a2).
Admitted.

// HOL Light: Library/integer.ml:852 / INT_CRT_STRONG_IFF
// Source hash: md5:0c972f6999b597f504f3f26663b7fea7
// Status: transport_required (bridges: hol_int_int, hol_prod_setprod)
Theorem INT_CRT_STRONG_IFF : forall a1 a2 n1 n2 :e int, (exists x :e int, divides_int n1 (x + - a1) /\ divides_int n2 (x + - a2)) <-> divides_int (gcd_int n1 n2) (a1 + - a2).
Admitted.

// HOL Light: Library/integer.ml:862 / EVEN_SQUARE_MOD4
// Source hash: md5:2d8355a193bbef27949981de012d3766
// Status: transport_required (bridges: hol_int_int, hol_num_omega, omega_Subq_int)
Theorem EVEN_SQUARE_MOD4 : forall n :e int, divides_int 4 ((2 * n) ^ 2 + - 0).
Admitted.

// HOL Light: Library/integer.ml:866 / ODD_SQUARE_MOD4
// Source hash: md5:f3513cc18716952917d2602012a8aa3e
// Status: transport_required (bridges: hol_int_int, hol_num_omega, omega_Subq_int)
Theorem ODD_SQUARE_MOD4 : forall n :e int, divides_int 4 ((2 * n + 1) ^ 2 + - 1).
Admitted.

// HOL Light: Library/integer.ml:870 / INT_DIVIDES_LE
// Source hash: md5:de0fd0f15bc993b761f13a9e7d21fa95
// Status: transport_required (bridges: hol_int_int, hol_num_omega, omega_Subq_int)
Theorem INT_DIVIDES_LE : forall x y :e int, divides_int x y -> abs_SNo x <= abs_SNo y \/ y = 0.
Admitted.

// HOL Light: Library/integer.ml:880 / INT_DIVIDES_POW_LE
// Source hash: md5:3082061750aea7f8566c1fd7f0fe4962
// Status: transport_required (bridges: hol_int_int, hol_num_omega, nat_le_SNoLe, omega_Subq_int)
Theorem INT_DIVIDES_POW_LE : forall p :e int, forall m n :e omega, 2 <= abs_SNo p -> (divides_int (p ^ m) (p ^ n) <-> m <= n).
Admitted.

// HOL Light: Library/integer.ml:983 / INT_DIVIDES_FACT
// Source hash: md5:4fa7543f10494239f1062fe5cd409e5c
// Status: transport_required (bridges: hol_fact_factorial, hol_int_int, hol_num_omega, omega_Subq_int)
Theorem INT_DIVIDES_FACT : forall n :e omega, forall x :e int, 1 <= abs_SNo x /\ abs_SNo x <= n -> divides_int x (factorial n).
Admitted.

// HOL Light: Library/integer.ml:1074 / INT_COPRIME_BEZOUT
// Aliases: INT_COPRIME_BEZOUT int_coprime
// Source hash: md5:5d645fcc824ab4748c8fe7b17cd497df
// Status: transport_required (bridges: hol_int_int, hol_num_omega, hol_prod_setprod, omega_Subq_int)
Theorem INT_COPRIME_BEZOUT : forall a b :e int, gcd_int a b = 1 <-> exists x y :e int, a * x + b * y = 1.
Admitted.

// HOL Light: Library/integer.ml:1078 / INT_COPRIME_BEZOUT_ALT
// Source hash: md5:bfbf1d190942bd386703994359eb020d
// Status: transport_required (bridges: hol_int_int, hol_num_omega, hol_prod_setprod, omega_Subq_int)
Theorem INT_COPRIME_BEZOUT_ALT : forall a b :e int, gcd_int a b = 1 -> exists x y :e int, a * x = b * y + 1.
Admitted.

// HOL Light: Library/integer.ml:1106 / INT_COPRIME_SOS
// Source hash: md5:884d43e0ae1fabe66a12eb024ad53a28
// Status: transport_required (bridges: hol_int_int, hol_num_omega, hol_prod_setprod)
Theorem INT_COPRIME_SOS : forall x y :e int, gcd_int x y = 1 -> gcd_int (x * y) (x ^ 2 + y ^ 2) = 1.
Admitted.

// HOL Light: Library/integer.ml:1133 / INT_COPRIME_POW_DIVPROD
// Source hash: md5:54c8ad6d154db9fe1cef907fe7b516fd
// Status: transport_required (bridges: hol_int_int, hol_num_omega, hol_prod_setprod)
Theorem INT_COPRIME_POW_DIVPROD : forall n :e omega, forall d a b :e int, divides_int (d ^ n) (a * b) /\ gcd_int d a = 1 -> divides_int (d ^ n) b.
Admitted.

// HOL Light: Library/integer.ml:1146 / INT_DIVIDES_POW2_REV
// Source hash: md5:fb741b36d9c2508bfa74fbf59ef23eb8
// Status: transport_required (bridges: hol_int_int, hol_num_omega)
Theorem INT_DIVIDES_POW2_REV : forall n :e omega, forall a b :e int, divides_int (a ^ n) (b ^ n) /\ ~ n = 0 -> divides_int a b.
Admitted.

// HOL Light: Library/integer.ml:1159 / INT_DIVIDES_POW2_EQ
// Source hash: md5:0ced9ad1e78a5665f0d9f4c26d795e15
// Status: transport_required (bridges: hol_int_int, hol_num_omega)
Theorem INT_DIVIDES_POW2_EQ : forall n :e omega, forall a b :e int, ~ n = 0 -> (divides_int (a ^ n) (b ^ n) <-> divides_int a b).
Admitted.

// HOL Light: Library/integer.ml:1163 / INT_POW_MUL_EXISTS
// Source hash: md5:82aba582893ebfdc4bc5283b7e8af82d
// Status: transport_required (bridges: hol_int_int, hol_num_omega, omega_Subq_int)
Theorem INT_POW_MUL_EXISTS : forall m n p :e int, forall k :e omega, ~ m = 0 /\ m ^ k * n = p ^ k -> exists q :e int, n = q ^ k.
Admitted.

// HOL Light: Library/integer.ml:1175 / INT_COPRIME_POW_ABS
// Source hash: md5:4d52b4b5b7bb601b33c5452a66321986
// Status: transport_required (bridges: hol_int_int, hol_num_omega, hol_prod_setprod)
Theorem INT_COPRIME_POW_ABS : forall n :e omega, forall a b c :e int, gcd_int a b = 1 /\ a * b = c ^ n -> exists r s :e int, abs_SNo a = r ^ n /\ abs_SNo b = s ^ n.
Admitted.

// HOL Light: Library/integer.ml:1214 / INT_COPRIME_POW_ODD
// Source hash: md5:6b7d1e0f50a18941cf50058c9ece1a8a
// Status: transport_required (bridges: hol_int_int, hol_num_omega, hol_prod_setprod)
Theorem INT_COPRIME_POW_ODD : forall n :e omega, forall a b c :e int, odd_nat n /\ (gcd_int a b = 1 /\ a * b = c ^ n) -> exists r s :e int, a = r ^ n /\ b = s ^ n.
Admitted.

