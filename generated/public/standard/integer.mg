// Status: transport_required (bridges: hol_int_int, hol_prod_setprod)
Theorem INT_LCM_EQ : forall x y u v :e int, (forall m :e int, divides_int x m /\ divides_int y m <-> divides_int u m /\ divides_int v m) -> lcm_int x y = lcm_int u v.
Admitted.

