Theorem FINITE_CART : forall A N:set, A <> Empty -> N <> Empty -> forall P:set -> set -> prop, (forall i :e omega, 1 <= i /\ i <= dimindex N -> finite {x :e A | P i x}) -> finite {v :e A :^: idx N | forall i :e omega, 1 <= i /\ i <= dimindex N -> P i (v i)}.
Admitted.

