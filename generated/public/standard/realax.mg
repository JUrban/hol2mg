Theorem real_pow : forall x :e R, x ^ 0 = 1 /\ forall n :e omega, x ^ ordsucc n = x * x ^ n.
let x. assume Hx.
apply andI.
- exact (exp_SNo_nat_0 (x) (real_SNo (x) Hx)).
- let n. assume Hn.
  exact (exp_SNo_nat_S (x) (real_SNo (x) Hx) (n) (omega_nat_p (n) Hn)).
Qed.

