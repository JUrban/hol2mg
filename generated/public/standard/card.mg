// HOL Light: Library/card.ml:1450 / EQ_C_BIJECTIONS_DISJOINT
// Source hash: md5:22bad5daa028a9e99562d6541a84b0f7
// Status: transport_required (bridges: hol_eq_c_equip)
Theorem EQ_C_BIJECTIONS_DISJOINT : forall A B:set, A <> Empty -> B <> Empty -> forall s s' c= A, forall t t' c= B, s :/\: s' = Empty /\ t :/\: t' = Empty -> (equip s t /\ equip s' t' <-> exists f:set -> set, (forall x :e A, f x :e B) /\ exists g:set -> set, (forall x :e B, g x :e A) /\ ((forall x :e A, x :e s -> f x :e t /\ g (f x) = x) /\ ((forall y :e B, y :e t -> g y :e s /\ f (g y) = y) /\ ((forall x :e A, x :e s' -> f x :e t' /\ g (f x) = x) /\ forall y :e B, y :e t' -> g y :e s' /\ f (g y) = y)))).
Admitted.

// HOL Light: Library/card.ml:1469 / EQ_C_BIJECTIONS_SUBSETS
