Theorem EQ_C_BIJECTIONS_SUBSETS : forall A B:set, A <> Empty -> B <> Empty -> forall s s' c= A, forall t t' c= B, s' c= s /\ t' c= t -> (equip s' t' /\ equip (s :\: s') (t :\: t') <-> exists f:set -> set, (forall x :e A, f x :e B) /\ exists g:set -> set, (forall x :e B, g x :e A) /\ ((forall x :e A, x :e s -> f x :e t /\ g (f x) = x) /\ ((forall y :e B, y :e t -> g y :e s /\ f (g y) = y) /\ ({f x | x :e s'} = t' /\ {g x | x :e t'} = s')))).
Admitted.

