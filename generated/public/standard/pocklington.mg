Theorem POCKLINGTON_PRIMEFACT : forall n q r a b :e omega, forall ps :e finseq omega, 2 <= n /\ (q * r = minus_nat n 1 /\ n <= q * q) -> mod_nat (a ^ r) n = b -> seq_foldr (fun x:set => fun x0:set => x * x0) ps 1 = q -> mod_nat (b ^ q) n = 1 -> seq_all (fun p:set => prime_nat p /\ gcd_int (minus_nat (mod_nat (b ^ div_nat q p) n) 1) n = 1) ps -> prime_nat n.
