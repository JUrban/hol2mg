// HOL Light: Library/pocklington.ml:361 / CONG_LT
// Source hash: md5:70ac40442af5de4e3cabd2908a989991
// Status: transport_required (bridges: add_nat_add_SNo, hol_num_omega, mul_nat_mul_SNo, nat_lt_SNoLt)
Theorem CONG_LT : forall x y n :e omega, y < n -> ((exists q1 q2 :e omega, x + n * q1 = y + n * q2) <-> exists d :e omega, x = d * n + y).
Admitted.

// HOL Light: Library/pocklington.ml:381 / CONG_LE
// Source hash: md5:a2259a3481231ebcb73d394274c552a8
// Status: transport_required (bridges: add_nat_add_SNo, hol_num_omega, mul_nat_mul_SNo, nat_le_SNoLe)
Theorem CONG_LE : forall x y n :e omega, y <= x -> ((exists q1 q2 :e omega, x + n * q1 = y + n * q2) <-> exists q :e omega, x = q * n + y).
Admitted.

// HOL Light: Library/pocklington.ml:387 / CONG_TO_1
// Source hash: md5:814a44ab1702a9d302e4af9e93418443
// Status: transport_required (bridges: add_nat_add_SNo, hol_num_omega, mul_nat_mul_SNo)
Theorem CONG_TO_1 : forall a n :e omega, (exists q1 q2 :e omega, a + n * q1 = 1 + n * q2) <-> a = 0 /\ n = 1 \/ exists m :e omega, a = 1 + m * n.
Admitted.

// HOL Light: Library/pocklington.ml:400 / EVEN_MOD_2
// Source hash: md5:340a9cac4fe69bc839f3661b2ad8b08d
// Status: transport_required (bridges: hol_num_omega)
Theorem EVEN_MOD_2 : forall n :e omega, even_nat n <-> exists q1 q2 :e omega, n + 2 * q1 = 0 + 2 * q2.
Admitted.

// HOL Light: Library/pocklington.ml:404 / ODD_MOD_2
// Source hash: md5:6a7ad2d9147390593bdbbdbca7727f19
// Status: transport_required (bridges: hol_num_omega)
Theorem ODD_MOD_2 : forall n :e omega, odd_nat n <-> exists q1 q2 :e omega, n + 2 * q1 = 1 + 2 * q2.
Admitted.

// HOL Light: Library/pocklington.ml:427 / CONG_SOLVE_EQ
// Source hash: md5:64eac60a38ae5a5469af73a227dacc8b
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem CONG_SOLVE_EQ : forall n a b :e omega, (exists x q1 q2 :e omega, a * x + n * q1 = b + n * q2) <-> divides_nat (gcd_int a n) b.
Admitted.

// HOL Light: Library/pocklington.ml:438 / CONG_SOLVE_LT_EQ
// Source hash: md5:cca5927181b354b1ce8f19ddcac0ef10
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo, nat_lt_SNoLt)
Theorem CONG_SOLVE_LT_EQ : forall n a b :e omega, (exists x :e omega, x < n /\ exists q1 q2 :e omega, a * x + n * q1 = b + n * q2) <-> ~ n = 0 /\ divides_nat (gcd_int a n) b.
Admitted.

// HOL Light: Library/pocklington.ml:450 / CONG_SOLVE
// Source hash: md5:af844c90402d8ca99dda4ac7bd72f878
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem CONG_SOLVE : forall a b n :e omega, gcd_int a n = 1 -> exists x q1 q2 :e omega, a * x + n * q1 = b + n * q2.
Admitted.

// HOL Light: Library/pocklington.ml:454 / CONG_SOLVE_UNIQUE
// Source hash: md5:2922c6ed6668e2341ee1ee75ca82bd7d
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo, nat_lt_SNoLt)
Theorem CONG_SOLVE_UNIQUE : forall a b n :e omega, gcd_int a n = 1 /\ ~ n = 0 -> exists x :e omega, x < n /\ (exists q1 q2 :e omega, a * x + n * q1 = b + n * q2) /\ forall y :e omega, y < n /\ (exists q1 q2 :e omega, a * y + n * q1 = b + n * q2) -> y = x.
Admitted.

// HOL Light: Library/pocklington.ml:472 / CONG_SOLVE_UNIQUE_NONTRIVIAL
// Source hash: md5:26c776dadfd544827cfcb1ffd630700a
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo, nat_lt_SNoLt)
Theorem CONG_SOLVE_UNIQUE_NONTRIVIAL : forall a p x :e omega, prime_nat p /\ (gcd_int p a = 1 /\ (0 < x /\ x < p)) -> exists y :e omega, 0 < y /\ (y < p /\ (exists q1 q2 :e omega, x * y + p * q1 = a + p * q2)) /\ forall y0 :e omega, 0 < y0 /\ (y0 < p /\ (exists q1 q2 :e omega, x * y0 + p * q1 = a + p * q2)) -> y0 = y.
Admitted.

// HOL Light: Library/pocklington.ml:497 / CONG_UNIQUE_INVERSE_PRIME
// Source hash: md5:208d6027904a87eaf03e40492c2b68ca
// Status: transport_required (bridges: hol_num_omega, mul_nat_mul_SNo, nat_lt_SNoLt)
Theorem CONG_UNIQUE_INVERSE_PRIME : forall p x :e omega, prime_nat p /\ (0 < x /\ x < p) -> exists y :e omega, 0 < y /\ (y < p /\ (exists q1 q2 :e omega, x * y + p * q1 = 1 + p * q2)) /\ forall y0 :e omega, 0 < y0 /\ (y0 < p /\ (exists q1 q2 :e omega, x * y0 + p * q1 = 1 + p * q2)) -> y0 = y.
Admitted.

// HOL Light: Library/pocklington.ml:503 / COUNT_CONG_SOLVE_SIMPLE
// Source hash: md5:5c6019822b74248f11629e80d04fab10
// Status: transport_required (bridges: hol_has_size_equip, hol_num_omega, mul_nat_mul_SNo, nat_lt_SNoLt)
Theorem COUNT_CONG_SOLVE_SIMPLE : forall m n b :e omega, equip {x :e omega | x < m * n /\ exists q1 q2 :e omega, x + n * q1 = b + n * q2} (if n = 0 then 0 else m).
Admitted.

// HOL Light: Library/pocklington.ml:527 / COUNT_CONG_SOLVE_GEN
// Source hash: md5:15c38c082b3e0e4264ad3b1a92425dbd
// Status: transport_required (bridges: hol_has_size_equip, hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo, nat_lt_SNoLt)
Theorem COUNT_CONG_SOLVE_GEN : forall m n a b :e omega, equip {x :e omega | x < m * n /\ exists q1 q2 :e omega, a * x + n * q1 = b + n * q2} (if ~ n = 0 /\ divides_nat (gcd_int n a) b then m * gcd_int n a else 0).
Admitted.

// HOL Light: Library/pocklington.ml:553 / COUNT_CONG_SOLVE
// Source hash: md5:bb35628505915160d06ce9ba77ad5b1a
// Status: transport_required (bridges: hol_has_size_equip, hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo, nat_lt_SNoLt)
Theorem COUNT_CONG_SOLVE : forall n a b :e omega, equip {x :e omega | x < n /\ exists q1 q2 :e omega, a * x + n * q1 = b + n * q2} (if ~ n = 0 /\ divides_nat (gcd_int n a) b then gcd_int n a else 0).
Admitted.

// HOL Light: Library/pocklington.ml:563 / CONG_CHINESE
// Source hash: md5:499626f1935e2b1f0d66879e98d50f85
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem CONG_CHINESE : forall a b x y :e omega, gcd_int a b = 1 /\ ((exists q1 q2 :e omega, x + a * q1 = y + a * q2) /\ (exists q1 q2 :e omega, x + b * q1 = y + b * q2)) -> exists q1 q2 :e omega, x + (a * b) * q1 = y + (a * b) * q2.
Admitted.

// HOL Light: Library/pocklington.ml:568 / CHINESE_REMAINDER_UNIQUE
// Source hash: md5:d5530470c7ea0920762d6d81811eee81
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo, nat_lt_SNoLt)
Theorem CHINESE_REMAINDER_UNIQUE : forall a b m n :e omega, gcd_int a b = 1 /\ (~ a = 0 /\ ~ b = 0) -> exists x :e omega, x < a * b /\ ((exists q1 q2 :e omega, x + a * q1 = m + a * q2) /\ (exists q1 q2 :e omega, x + b * q1 = n + b * q2)) /\ forall y :e omega, y < a * b /\ ((exists q1 q2 :e omega, y + a * q1 = m + a * q2) /\ (exists q1 q2 :e omega, y + b * q1 = n + b * q2)) -> y = x.
Admitted.

// HOL Light: Library/pocklington.ml:589 / CHINESE_REMAINDER_COPRIME_UNIQUE
// Source hash: md5:19c3e108e1f2663432a8c0875774a5e1
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo, nat_lt_SNoLt)
Theorem CHINESE_REMAINDER_COPRIME_UNIQUE : forall a b m n :e omega, gcd_int a b = 1 /\ (~ a = 0 /\ (~ b = 0 /\ (gcd_int m a = 1 /\ gcd_int n b = 1))) -> exists x :e omega, gcd_int x (a * b) = 1 /\ (x < a * b /\ ((exists q1 q2 :e omega, x + a * q1 = m + a * q2) /\ (exists q1 q2 :e omega, x + b * q1 = n + b * q2))) /\ forall y :e omega, gcd_int y (a * b) = 1 /\ (y < a * b /\ ((exists q1 q2 :e omega, y + a * q1 = m + a * q2) /\ (exists q1 q2 :e omega, y + b * q1 = n + b * q2))) -> y = x.
Admitted.

// HOL Light: Library/pocklington.ml:601 / CHINESE_REMAINDER_USUAL
// Source hash: md5:59e019bd3588e3742ee86274ec5f6a99
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem CHINESE_REMAINDER_USUAL : forall a b u v :e omega, gcd_int a b = 1 -> exists x :e omega, (exists q1 q2 :e omega, x + a * q1 = u + a * q2) /\ exists q1 q2 :e omega, x + b * q1 = v + b * q2.
Admitted.

// HOL Light: Library/pocklington.ml:613 / CONG_CHINESE_EQ
// Source hash: md5:1c416ef4341539f266c11d15cbb341cf
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem CONG_CHINESE_EQ : forall a b x y :e omega, gcd_int a b = 1 -> ((exists q1 q2 :e omega, x + (a * b) * q1 = y + (a * b) * q2) <-> (exists q1 q2 :e omega, x + a * q1 = y + a * q2) /\ exists q1 q2 :e omega, x + b * q1 = y + b * q2).
Admitted.

// HOL Light: Library/pocklington.ml:619 / CHINESE_REMAINDER_COUNT
// Source hash: md5:fdf67b8d39568bb091528287d3ae54fb
// Status: transport_required (bridges: hol_has_size_equip, hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo, nat_lt_SNoLt)
Theorem CHINESE_REMAINDER_COUNT : forall P Q R0:set -> prop, forall a b m n :e omega, gcd_int a b = 1 /\ ((forall x :e omega, x < a * b -> (R0 x <-> P (mod_nat x a) /\ Q (mod_nat x b))) /\ (equip {x :e omega | x < a /\ P x} m /\ equip {x :e omega | x < b /\ Q x} n)) -> equip {x :e omega | x < a * b /\ R0 x} (m * n).
Admitted.

// HOL Light: Library/pocklington.ml:661 / CHINESE_REMAINDER_COPRIME_COUNT
// Source hash: md5:f8a62dd3b973113260c24dc268817f13
// Status: transport_required (bridges: hol_has_size_equip, hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo, nat_lt_SNoLt)
Theorem CHINESE_REMAINDER_COPRIME_COUNT : forall P Q R0:set -> prop, forall a b m n :e omega, gcd_int a b = 1 /\ ((forall x :e omega, x < a * b -> (R0 x <-> P (mod_nat x a) /\ Q (mod_nat x b))) /\ (equip {x :e omega | x < a /\ (gcd_int a x = 1 /\ P x)} m /\ equip {x :e omega | x < b /\ (gcd_int b x = 1 /\ Q x)} n)) -> equip {x :e omega | x < a * b /\ (gcd_int (a * b) x = 1 /\ R0 x)} (m * n).
Admitted.

// HOL Light: Library/pocklington.ml:676 / COUNT_ROOTS_MODULO_COPRIME
// Source hash: md5:05567242f1543f3b56a0a9467a29e9c2
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_has_size_equip, hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo, nat_lt_SNoLt)
Theorem COUNT_ROOTS_MODULO_COPRIME : forall a b k m n :e omega, gcd_int a b = 1 /\ (equip {x :e omega | x < a /\ exists q1 q2 :e omega, x ^ k + a * q1 = 1 + a * q2} m /\ equip {x :e omega | x < b /\ exists q1 q2 :e omega, x ^ k + b * q1 = 1 + b * q2} n) -> equip {x :e omega | x < a * b /\ exists q1 q2 :e omega, x ^ k + (a * b) * q1 = 1 + (a * b) * q2} (m * n).
Admitted.

// HOL Light: Library/pocklington.ml:1139 / PHI_FINITE_LEMMA
// Source hash: md5:e0960fbdf7937ca7e1592339369f9c23
// Status: transport_required (bridges: hol_finite_finite, hol_num_omega, hol_prod_setprod, nat_lt_SNoLt)
Theorem PHI_FINITE_LEMMA : forall n :e omega, finite {m :e omega | gcd_int m n = 1 /\ m < n}.
Admitted.

// HOL Light: Library/pocklington.ml:1370 / NPRODUCT_MOD
// Source hash: md5:2d2a03df84f7019ce17f3bfc180be789
// Status: transport_required (bridges: hol_finite_finite, hol_nproduct_finprod, hol_num_omega)
Theorem NPRODUCT_MOD : forall A:set, A <> Empty -> forall s c= A, forall a:set -> set, (forall x :e A, a x :e omega) -> forall n :e omega, finite s /\ ~ n = 0 -> exists q1 q2 :e omega, finprod s (fun m:set => mod_nat (a m) n) + n * q1 = finprod s a + n * q2.
Admitted.

// HOL Light: Library/pocklington.ml:1380 / NPRODUCT_CMUL
// Source hash: md5:139602d85c857f231232a97623571375
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_card_finite_cardinality, hol_finite_finite, hol_nproduct_finprod, hol_num_omega, mul_nat_mul_SNo)
Theorem NPRODUCT_CMUL : forall T219550:set, T219550 <> Empty -> forall s c= T219550, forall a:set -> set, (forall x :e T219550, a x :e omega) -> forall c :e omega, finite s -> finprod s (fun m:set => c * a m) = c ^ finite_cardinality s * finprod s a.
Admitted.

// HOL Light: Library/pocklington.ml:1390 / ITERATE_OVER_COPRIME
// Source hash: md5:10432f4c2447e010ce253b6b8805286b
// Status: transport_required (bridges: hol_iterate, hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo, nat_lt_SNoLt)
Theorem ITERATE_OVER_COPRIME : forall T219734:set, T219734 <> Empty -> forall op:set -> set -> set, (forall x y :e T219734, op x y :e T219734) -> forall f:set -> set, (forall x :e omega, f x :e T219734) -> forall n k :e omega, (forall x y :e T219734, op x y = op y x) /\ (forall x y z :e T219734, op x (op y z) = op (op x y) z) /\ (forall x :e T219734, op (neutral_of T219734 op) x = x) /\ (gcd_int k n = 1 /\ (forall x y :e omega, (exists q1 q2 :e omega, x + n * q1 = y + n * q2) -> f x = f y)) -> iterate_op T219734 op {d :e omega | gcd_int d n = 1 /\ d < n} (fun m:set => f (k * m)) = iterate_op T219734 op {d :e omega | gcd_int d n = 1 /\ d < n} f.
Admitted.

// HOL Light: Library/pocklington.ml:1412 / ITERATE_ITERATE_DIVISORS
// Source hash: md5:70a0e233291846b812a4f96b8e7ef1fa
// Status: transport_required (bridges: hol_iterate, hol_num_omega, mul_nat_mul_SNo)
Theorem ITERATE_ITERATE_DIVISORS : forall A:set, A <> Empty -> forall op:set -> set -> set, (forall x y :e A, op x y :e A) -> forall f:set -> set -> set, (forall x y :e omega, f x y :e A) -> forall x :e omega, (forall x y :e A, op x y = op y x) /\ (forall x y z :e A, op x (op y z) = op (op x y) z) /\ (forall x :e A, op (neutral_of A op) x = x) -> iterate_op A op (idx_n x) (fun n:set => iterate_op A op {d :e omega | divides_nat d n} (f n)) = iterate_op A op (idx_n x) (fun n:set => iterate_op A op (idx_n (div_nat x n)) (fun k:set => f (k * n) n)).
Admitted.

// HOL Light: Library/pocklington.ml:1459 / FERMAT_LITTLE_PRIME
// Source hash: md5:767066f98b7d4614b85b3177856bae8c
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, hol_prod_setprod)
Theorem FERMAT_LITTLE_PRIME : forall a p :e omega, prime_nat p /\ gcd_int a p = 1 -> exists q1 q2 :e omega, a ^ minus_nat p 1 + p * q1 = 1 + p * q2.
Admitted.

// HOL Light: Library/pocklington.ml:1467 / LUCAS_COPRIME_LEMMA
// Source hash: md5:d117a25578b92fede8eba5366c42c06e
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, hol_prod_setprod)
Theorem LUCAS_COPRIME_LEMMA : forall m n a :e omega, ~ m = 0 /\ (exists q1 q2 :e omega, a ^ m + n * q1 = 1 + n * q2) -> gcd_int a n = 1.
Admitted.

// HOL Light: Library/pocklington.ml:1494 / LUCAS_WEAK
// Source hash: md5:88149126fc49e598b7cadb3607cd6258
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, nat_le_SNoLe, nat_lt_SNoLt)
Theorem LUCAS_WEAK : forall a n :e omega, 2 <= n /\ ((exists q1 q2 :e omega, a ^ minus_nat n 1 + n * q1 = 1 + n * q2) /\ (forall m :e omega, 0 < m /\ m < minus_nat n 1 -> ~ exists q1 q2 :e omega, a ^ m + n * q1 = 1 + n * q2)) -> prime_nat n.
Admitted.

// HOL Light: Library/pocklington.ml:1510 / LUCAS
// Source hash: md5:f33036093df0a740928478a1376048b3
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, nat_le_SNoLe)
Theorem LUCAS : forall a n :e omega, 2 <= n /\ ((exists q1 q2 :e omega, a ^ minus_nat n 1 + n * q1 = 1 + n * q2) /\ (forall p :e omega, prime_nat p /\ divides_nat p (minus_nat n 1) -> ~ exists q1 q2 :e omega, a ^ div_nat (minus_nat n 1) p + n * q1 = 1 + n * q2)) -> prime_nat n.
Admitted.

// HOL Light: Library/pocklington.ml:1843 / POWER_RESIDUE_MODULO_PRIME
// Source hash: md5:f6a1e2b2735e56055e3a21203eefee5d
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, hol_prod_setprod)
Theorem POWER_RESIDUE_MODULO_PRIME : forall p a k :e omega, prime_nat p /\ (~ divides_nat p a /\ gcd_int k (minus_nat p 1) = 1) -> exists x q1 q2 :e omega, x ^ k + p * q1 = a + p * q2.
Admitted.

// HOL Light: Library/pocklington.ml:1974 / PRIME_DIVISOR_SQRT
// Source hash: md5:15c6b7ab0ad7c1a9f6b5d1e35fe1db67
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, nat_le_SNoLe)
Theorem PRIME_DIVISOR_SQRT : forall n :e omega, prime_nat n <-> ~ n = 1 /\ forall d :e omega, divides_nat d n /\ d ^ 2 <= n -> d = 1.
Admitted.

// HOL Light: Library/pocklington.ml:2002 / PRIME_PRIME_FACTOR_SQRT
// Source hash: md5:3bd21b3c379da85440182f5b02af9447
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, nat_le_SNoLe)
Theorem PRIME_PRIME_FACTOR_SQRT : forall n :e omega, prime_nat n <-> ~ n = 0 /\ (~ n = 1 /\ ~ exists p :e omega, prime_nat p /\ (divides_nat p n /\ p ^ 2 <= n)).
Admitted.

// HOL Light: Library/pocklington.ml:2024 / POCKLINGTON_LEMMA
// Source hash: md5:099bf8b88f5f5db977c975a8574b5653
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo, nat_le_SNoLe)
Theorem POCKLINGTON_LEMMA : forall a n q r :e omega, 2 <= n /\ (minus_nat n 1 = q * r /\ ((exists q1 q2 :e omega, a ^ minus_nat n 1 + n * q1 = 1 + n * q2) /\ (forall p :e omega, prime_nat p /\ divides_nat p q -> gcd_int (minus_nat (a ^ div_nat (minus_nat n 1) p) 1) n = 1))) -> forall p :e omega, prime_nat p /\ divides_nat p n -> exists q1 q2 :e omega, p + q * q1 = 1 + q * q2.
Admitted.

// HOL Light: Library/pocklington.ml:2099 / POCKLINGTON
// Source hash: md5:477d916375234bea5be670e6b021065b
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo, nat_le_SNoLe)
Theorem POCKLINGTON : forall a n q r :e omega, 2 <= n /\ (minus_nat n 1 = q * r /\ (n <= q ^ 2 /\ ((exists q1 q2 :e omega, a ^ minus_nat n 1 + n * q1 = 1 + n * q2) /\ (forall p :e omega, prime_nat p /\ divides_nat p q -> gcd_int (minus_nat (a ^ div_nat (minus_nat n 1) p) 1) n = 1)))) -> prime_nat n.
Admitted.

// HOL Light: Library/pocklington.ml:2124 / POCKLINGTON_ALT
// Source hash: md5:16ec081923d3154b28bdeacde5d7b0ce
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo, nat_le_SNoLe)
Theorem POCKLINGTON_ALT : forall a n q r :e omega, 2 <= n /\ (minus_nat n 1 = q * r /\ (n <= q ^ 2 /\ ((exists q1 q2 :e omega, a ^ minus_nat n 1 + n * q1 = 1 + n * q2) /\ (forall p :e omega, prime_nat p /\ divides_nat p q -> exists b :e omega, (exists q1 q2 :e omega, a ^ div_nat (minus_nat n 1) p + n * q1 = b + n * q2) /\ gcd_int (minus_nat b 1) n = 1)))) -> prime_nat n.
Admitted.

// HOL Light: Library/pocklington.ml:2226 / LUCAS_PRIMEFACT
// Source hash: md5:b15e9efc9c3584bbf871caddcee2750e
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_list_finseq, hol_num_omega, mul_nat_mul_SNo, nat_le_SNoLe)
Theorem LUCAS_PRIMEFACT : forall n a :e omega, forall ps :e finseq omega, 2 <= n /\ ((exists q1 q2 :e omega, a ^ minus_nat n 1 + n * q1 = 1 + n * q2) /\ (seq_foldr (fun x:set => fun x0:set => x * x0) ps 1 = minus_nat n 1 /\ seq_all (fun p:set => prime_nat p /\ ~ exists q1 q2 :e omega, a ^ div_nat (minus_nat n 1) p + n * q1 = 1 + n * q2) ps)) -> prime_nat n.
Admitted.

