Theorem INTER_UNIONS_PAIRWISE_DISJOINT : forall A:set, A <> Empty -> forall s t c= Power A, (forall x y :e s :\/: t, x <> y -> x :/\: y = Empty) -> Union s :/\: Union t = Union (s :/\: t).
Admitted.

// HOL Light: sets.ml:3983 / PSUBSET_UNIONS_PAIRWISE_DISJOINT
// Source hash: md5:243ac025bf71c94649029f0e4b06c9a1
