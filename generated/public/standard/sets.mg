Theorem FINITE_IMAGE_EQ : forall A B:set, B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall s c= A, finite {f x | x :e s} <-> exists t c= A, finite t /\ (t c= s /\ {f x | x :e s} = {f x | x :e t}).
Admitted.

