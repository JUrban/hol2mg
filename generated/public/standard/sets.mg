// Status: exact_native
Theorem UNION_OF : forall A:set, A <> Empty -> forall P Q:set -> prop, forall s c= A, (exists u c= Power A, P u /\ (forall c :e u, Q c) /\ Union u = s) <-> exists u c= Power A, P u /\ ((forall c c= A, c :e u -> Q c) /\ Union u = s).
Admitted.

