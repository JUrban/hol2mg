// Source hash: md5:41710ae7a2b99eaec1cb84878dab932e
// Status: transport_required (bridges: hol_finite_finite)
Theorem FINITE_POWERSET_EQ : forall A:set, A <> Empty -> forall s c= A, finite {t :e Power A | t c= s} <-> finite s.
Admitted.

// HOL Light: sets.ml:3452 / FINITE_RESTRICTED_SUBSETS
// Source hash: md5:bb629d5a3ea74b0adefb825509e11bb6
// Status: transport_required (bridges: hol_finite_finite)
Theorem FINITE_RESTRICTED_SUBSETS : forall A:set, A <> Empty -> forall P:set -> prop, forall s c= A, finite s -> finite {t :e Power A | t c= s /\ P t}.
Admitted.

// HOL Light: sets.ml:3458 / FINITE_UNIONS
// Source hash: md5:fc936e290505bf16faa4466670c43444
// Status: transport_required (bridges: hol_finite_finite)
Theorem FINITE_UNIONS : forall A:set, A <> Empty -> forall s c= Power A, finite (Union s) <-> finite s /\ forall t c= A, t :e s -> finite t.
Admitted.

// HOL Light: sets.ml:3467 / FINITE_CARD_LE_UNIONS
// Source hash: md5:93e50fa259c57e838e21294f821448c0
// Status: transport_required (bridges: hol_card_finite_cardinality, hol_finite_finite, hol_num_omega, mul_nat_mul_SNo, nat_le_SNoLe)
Theorem FINITE_CARD_LE_UNIONS : forall A B:set, A <> Empty -> B <> Empty -> forall s c= A, forall t :e Power B :^: A, forall m n :e omega, (forall x :e A, x :e s -> finite (t x) /\ finite_cardinality (t x) <= n) /\ (finite s /\ finite_cardinality s <= m) -> finite (Union {t x | x :e A, x :e s}) /\ finite_cardinality (Union {t x | x :e A, x :e s}) <= m * n.
Admitted.

// HOL Light: sets.ml:3479 / POWERSET_CLAUSES
// Source hash: md5:70a8a2d45d230cb1a42aaf9faab99fd3
// Status: exact_native
Theorem POWERSET_CLAUSES : forall A:set, A <> Empty -> {s :e Power A | s c= Empty} = {Empty} /\ forall a :e A, forall t c= A, {s :e Power A | s c= SetAdjoin t a} = {s :e Power A | s c= t} :\/: {{x0 :e A | x0 :e SetAdjoin x a} | x :e {s :e Power A | s c= t}}.
Admitted.

// HOL Light: sets.ml:3495 / FINITE_IMAGE_INFINITE
// Source hash: md5:31d295c1043c3a66b02308e635b29881
// Status: transport_required (bridges: hol_finite_finite)
Theorem FINITE_IMAGE_INFINITE : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall s c= A, infinite s /\ finite {f x | x :e s} -> exists a :e A, a :e s /\ infinite {x :e A | x :e s /\ f x = f a}.
Admitted.

// HOL Light: sets.ml:3507 / FINITE_RESTRICTED_POWERSET
