// Source hash: md5:bc2f3d7fe3f392adb52e953e810405f7
// Status: transport_required (bridges: hol_real_R)
Theorem has_sup : forall s c= R, forall b :e R, is_lub s b <-> forall c :e R, (forall x :e R, x :e s -> x <= c) <-> b <= c.
Admitted.

