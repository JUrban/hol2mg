Theorem PSUBSET_UNIONS_PAIRWISE_DISJOINT : forall A:set, A <> Empty -> forall u v c= Power A, (forall x y :e v, x <> y -> x :/\: y = Empty) /\ (u c= v :\: {Empty} /\ u <> v :\: {Empty}) -> Union u c= Union v /\ Union u <> Union v.
Admitted.

// HOL Light: sets.ml:4004 / UNION_OF
