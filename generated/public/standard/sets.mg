// Status: transport_required (bridges: hol_card_finite_cardinality, hol_itset, hol_num_omega)
Theorem CARD : forall A:set, A <> Empty -> forall s c= A, finite_cardinality s = set_foldr (fun x:set => fun n:set => ordsucc n) s 0.
