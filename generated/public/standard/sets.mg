// Status: transport_required (bridges: hol_finite_finite, hol_real_R)
Theorem INF_UNIQUE_FINITE : forall a :e R, forall s c= R, finite s /\ ~ s = Empty -> (inf s = a <-> a :e s /\ forall y :e R, y :e s -> a <= y).
Admitted.

// HOL Light: sets.ml:4951 / INF_INSERT_FINITE
// Source hash: md5:1d83d97f30fad042ee0f27901f564520
// Status: transport_required (bridges: hol_finite_finite, hol_real_R)
Theorem INF_INSERT_FINITE : forall x :e R, forall s c= R, finite s -> inf (SetAdjoin s x) = if s = Empty then x else if x <= inf s then x else inf s.
Admitted.

// HOL Light: sets.ml:4961 / INF_SING
