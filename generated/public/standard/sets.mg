// HOL Light: sets.ml:3947 / PAIRWISE_CHAIN_UNIONS
// Source hash: md5:710832e2e77206e27269a5d0a08e06d7
// Status: exact_native
Theorem PAIRWISE_CHAIN_UNIONS : forall A:set, A <> Empty -> forall R0:set -> set -> prop, forall c c= Power A, (forall s c= A, s :e c -> forall x y :e s, x <> y -> R0 x y) /\ (forall s t c= A, s :e c /\ t :e c -> s c= t \/ t c= s) -> forall x y :e Union c, x <> y -> R0 x y.
Admitted.

// HOL Light: sets.ml:3954 / DIFF_UNIONS_PAIRWISE_DISJOINT
// Source hash: md5:f9b768e4b5391065f8445242b04da4af
// Status: exact_native
Theorem DIFF_UNIONS_PAIRWISE_DISJOINT : forall A:set, A <> Empty -> forall s t c= Power A, (forall x y :e s, x <> y -> x :/\: y = Empty) /\ t c= s -> Union s :\: Union t = Union (s :\: t).
Admitted.

