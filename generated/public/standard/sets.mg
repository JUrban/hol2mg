- let x. assume Hx.
  apply (binunionE (s) (t :\/: u) (x) Hx).
  + assume H.
    exact (binunionI1 (s :\/: t) (u) (x) (binunionI1 (s) (t) (x) H)).
  + assume H1.
    apply (binunionE (t) (u) (x) H1).
    * assume H2.
      exact (binunionI1 (s :\/: t) (u) (x) (binunionI2 (s) (t) (x) H2)).
    * assume H3.
