// HOL Light: sets.ml:4965 / INF_INSERT_INSERT
// Source hash: md5:f84b8571e923ec6087760074af6ffac8
// Status: transport_required (bridges: hol_real_R)
Theorem INF_INSERT_INSERT : forall a b :e R, forall s c= R, inf (SetAdjoin (SetAdjoin s a) b) = inf (SetAdjoin s (if a <= b then a else b)).
Admitted.

// HOL Light: sets.ml:4972 / REAL_SUP_EQ_INF
// Source hash: md5:91182f57329d4d9ca5a8f471e418e09b
// Status: transport_required (bridges: hol_real_R)
Theorem REAL_SUP_EQ_INF : forall s c= R, ~ s = Empty /\ (exists B :e R, forall x :e R, x :e s -> abs_SNo x <= B) -> (sup s = inf s <-> exists a :e R, s = {a}).
Admitted.

// HOL Light: sets.ml:4983 / REAL_INF_LE
// Source hash: md5:1f4ff29c633a13a0d8c1fc30a88eadf2
// Status: transport_required (bridges: hol_real_R)
Theorem REAL_INF_LE : forall s c= R, forall a b y :e R, y :e s /\ (y <= b /\ (forall x :e R, x :e s -> a <= x)) -> inf s <= b.
Admitted.

// HOL Light: sets.ml:4987 / REAL_LE_INF_EQ
// Source hash: md5:ed8be3ed84740a24e9d145e634f1d5fc
// Status: transport_required (bridges: hol_real_R)
Theorem REAL_LE_INF_EQ : forall s c= R, forall y :e R, ~ s = Empty /\ (exists b :e R, forall x :e R, x :e s -> b <= x) -> (y <= inf s <-> forall x :e R, x :e s -> y <= x).
Admitted.

// HOL Light: sets.ml:4992 / INF_UNIQUE
// Source hash: md5:247255fcd2875b317cc7745c4a435baf
// Status: transport_required (bridges: hol_real_R)
Theorem INF_UNIQUE : forall s c= R, forall b :e R, (forall c :e R, (forall x :e R, x :e s -> c <= x) <-> c <= b) -> inf s = b.
Admitted.

// HOL Light: sets.ml:4997 / INF_UNION
// Source hash: md5:5c4800110aae7c1f2a99d17686a8499a
// Status: transport_required (bridges: hol_real_R)
Theorem INF_UNION : forall s t c= R, ~ s = Empty /\ (~ t = Empty /\ ((exists b :e R, forall x :e R, x :e s -> b <= x) /\ (exists c :e R, forall x :e R, x :e t -> c <= x))) -> inf (s :\/: t) = if inf s <= inf t then inf s else inf t.
Admitted.

// HOL Light: sets.ml:5005 / INF_LE_ELEMENT
// Source hash: md5:c2dd8396212ad2073dabf039cd036967
// Status: transport_required (bridges: hol_real_R)
Theorem INF_LE_ELEMENT : forall s c= R, forall a :e R, (exists b :e R, forall x :e R, x :e s -> b <= x) /\ a :e s -> inf s <= a.
Admitted.

// HOL Light: sets.ml:5009 / INF_APPROACH
// Source hash: md5:b7d88063914643b0f366c50922013018
// Status: transport_required (bridges: hol_real_R)
Theorem INF_APPROACH : forall s c= R, forall c :e R, ~ s = Empty /\ ((exists b :e R, forall x :e R, x :e s -> b <= x) /\ inf s < c) -> exists x :e R, x :e s /\ x < c.
Admitted.

// HOL Light: sets.ml:5020 / REAL_MIN_INF
// Source hash: md5:368ecdd89c374a6669d966adfb89650d
// Status: transport_required (bridges: hol_real_R)
Theorem REAL_MIN_INF : forall x y :e R, (if x <= y then x else y) = inf {x,y}.
Admitted.

// HOL Light: sets.ml:5033 / has_inf
// Source hash: md5:68d83551dfae810d4147394a0c56b070
// Status: transport_required (bridges: hol_real_R)
Theorem has_inf : forall s c= R, forall b :e R, is_glb s b <-> forall c :e R, (forall x :e R, x :e s -> c <= x) <-> c <= b.
Admitted.

