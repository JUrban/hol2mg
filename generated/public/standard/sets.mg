// Source hash: md5:d438ac14503aef868eba9703a2579b74
// Status: transport_required (bridges: hol_real_R)
Theorem HAS_SUP_UBOUND : forall s c= R, forall b x :e R, is_lub s b /\ x :e s -> x <= b.
Admitted.

