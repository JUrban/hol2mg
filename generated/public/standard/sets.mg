Theorem CARD_SUBSET_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall s c= B, forall t c= A, finite t /\ s c= {f x | x :e t} -> finite_cardinality s <= finite_cardinality t.
Admitted.

