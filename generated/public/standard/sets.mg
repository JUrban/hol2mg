Theorem BIJECTIONS_HAS_SIZE : forall A B:set, A <> Empty -> B <> Empty -> forall n :e omega, forall s c= A, forall t c= B, forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e B, g x :e A) -> (forall x :e A, x :e s -> f x :e t /\ g (f x) = x) /\ ((forall y :e B, y :e t -> g y :e s /\ f (g y) = y) /\ equip s n) -> equip t n.
Admitted.

