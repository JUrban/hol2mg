// Status: generalization_required (bridges: empty_case:A)
Theorem UNIV_SUBSET : forall A:set, forall s c= A, A c= s <-> s = A.
let A.
let s. assume Hs.
apply iffI.
- assume H1.
  apply (set_ext (s) (A)).
  + exact Hs.
  + exact H1.
- assume H.
  let x. assume Hx.
  exact ((H (fun hl__u hl__v => hl__u = (s)) (fun q H => H)) (fun hl__u hl__v => x :e hl__u) Hx).
Qed.

