Theorem INJECTIVE_ON_LEFT_INVERSE : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall s c= A, (forall x y :e A, x :e s /\ (y :e s /\ f x = f y) -> x = y) <-> exists g:set -> set, (forall x :e B, g x :e A) /\ forall x :e A, x :e s -> g (f x) = x.
