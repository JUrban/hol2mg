// HOL Light: Library/products.ml:714 / PRODUCT_OFFSET
// Source hash: md5:9c20f7dc16a9e5735a4e771ec63108a8
// Status: transport_required (bridges: add_nat_add_SNo, hol_num_omega, hol_product_finprod, hol_real_R)
