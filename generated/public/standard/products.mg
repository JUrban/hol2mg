// Status: transport_required (bridges: hol_num_omega, hol_product_finprod, hol_real_R, nat_le_SNoLe, omega_Subq_R)
Theorem PRODUCT_POS_LE_NUMSEG : forall f:set -> set, (forall x :e omega, f x :e R) -> forall m n :e omega, (forall x :e omega, m <= x /\ x <= n -> 0 <= f x) -> 0 <= finprod {i :e omega | m <= i /\ i <= n} f.
