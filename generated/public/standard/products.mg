Theorem PRODUCT_NEG : forall A:set, A <> Empty -> forall f:set -> set, (forall x :e A, f x :e R) -> forall s c= A, finite s -> finprod s (fun i:set => - f i) = (- 1) ^ finite_cardinality s * finprod s f.
