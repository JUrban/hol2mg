// Status: transport_required (bridges: hol_num_omega, hol_product_finprod, hol_real_R, nat_le_SNoLe, omega_Subq_R)
Theorem PRODUCT_CLAUSES_NUMSEG : forall f:set -> set, (forall x :e omega, f x :e R) -> (forall m :e omega, finprod {i :e omega | m <= i /\ i <= 0} f = if m = 0 then f 0 else 1) /\ forall m n :e omega, finprod {i :e omega | m <= i /\ i <= ordsucc n} f = if m <= ordsucc n then finprod {i :e omega | m <= i /\ i <= n} f * f (ordsucc n) else finprod {i :e omega | m <= i /\ i <= n} f.
