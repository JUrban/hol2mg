Theorem PRODUCT_DIV_NUMSEG : forall f:set -> set, (forall x :e omega, f x :e R) -> forall g:set -> set, (forall x :e omega, g x :e R) -> forall m n :e omega, finprod {i :e omega | m <= i /\ i <= n} (fun x:set => f x :/: g x) = finprod {i :e omega | m <= i /\ i <= n} f :/: finprod {i :e omega | m <= i /\ i <= n} g.
