// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_has_size_equip, hol_nproduct_finprod, hol_num_omega, nat_le_SNoLe)
Theorem HAS_SIZE_CART : forall A N:set, A <> Empty -> N <> Empty -> forall P:set -> set -> prop, forall m:set -> set, (forall x :e omega, m x :e omega) -> (forall i :e omega, 1 <= i /\ i <= dimindex N -> equip {x :e A | P i x} (m i)) -> equip {v :e A :^: idx N | forall i :e omega, 1 <= i /\ i <= dimindex N -> P i (v i)} (finprod (idx N) m).
Admitted.

// HOL Light: Library/products.ml:333 / CARD_CART
// Source hash: md5:8b10b6fb3663639114432b3699de1cba
// Status: transport_required (bridges: hol_card_finite_cardinality, hol_cart_setexp, hol_dimindex, hol_finite_finite, hol_nproduct_finprod, hol_num_omega, nat_le_SNoLe)
Theorem CARD_CART : forall A N:set, A <> Empty -> N <> Empty -> forall P:set -> set -> prop, (forall i :e omega, 1 <= i /\ i <= dimindex N -> finite {x :e A | P i x}) -> finite_cardinality {v :e A :^: idx N | forall i :e omega, 1 <= i /\ i <= dimindex N -> P i (v i)} = finprod (idx N) (fun i:set => finite_cardinality {x :e A | P i x}).
Admitted.

// HOL Light: Library/products.ml:357 / IPRODUCT_SUPPORT
