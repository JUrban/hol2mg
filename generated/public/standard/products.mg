// Status: generalization_required (bridges: empty_case:A, hol_product_finprod, hol_real_R)
Theorem PRODUCT_UNIV : forall A:set, forall f:set -> set, (forall x :e A, f x :e R) -> forall s c= A, {x :e A | f x <> neutral_of R (fun a:set => fun b:set => a * b)} c= s -> finprod s f = finprod A f.
Admitted.

// HOL Light: Library/products.ml:937 / PRODUCT_PAIR
// Source hash: md5:2011dbce13e28710f2e164aed62b9445
// Status: transport_required (bridges: add_nat_add_SNo, hol_num_omega, hol_product_finprod, hol_real_R, mul_nat_mul_SNo)
Theorem PRODUCT_PAIR : forall f:set -> set, (forall x :e omega, f x :e R) -> forall m n :e omega, finprod {i :e omega | 2 * m <= i /\ i <= 2 * n + 1} f = finprod {i :e omega | m <= i /\ i <= n} (fun i:set => f (2 * i) * f (2 * i + 1)).
Admitted.

// HOL Light: Library/products.ml:942 / PRODUCT_REFLECT
// Source hash: md5:0499689526ef9fa924e8d24eeb39657c
// Status: transport_required (bridges: hol_num_omega, hol_product_finprod, hol_real_R, nat_lt_SNoLt, omega_Subq_R)
Theorem PRODUCT_REFLECT : forall x:set -> set, (forall x :e omega, x x :e R) -> forall m n :e omega, finprod {i :e omega | m <= i /\ i <= n} x = if n < m then 1 else finprod {i :e omega | 0 <= i /\ i <= minus_nat n m} (fun i:set => x (minus_nat n i)).
Admitted.

