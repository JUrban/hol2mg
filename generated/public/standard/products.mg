// HOL Light: Library/products.ml:937 / PRODUCT_PAIR
// Source hash: md5:2011dbce13e28710f2e164aed62b9445
// Status: transport_required (bridges: add_nat_add_SNo, hol_num_omega, hol_product_finprod, hol_real_R, mul_nat_mul_SNo)
Theorem PRODUCT_PAIR : forall f:set -> set, (forall x :e omega, f x :e R) -> forall m n :e omega, finprod {i :e omega | 2 * m <= i /\ i <= 2 * n + 1} f = finprod {i :e omega | m <= i /\ i <= n} (fun i:set => f (2 * i) * f (2 * i + 1)).
Admitted.

// HOL Light: Library/products.ml:942 / PRODUCT_REFLECT
