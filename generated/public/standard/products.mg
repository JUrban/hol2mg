Theorem PRODUCT_EQ_0 : forall A:set, A <> Empty -> forall f:set -> set, (forall x :e A, f x :e R) -> forall s c= A, finite s -> (finprod s f = 0 <-> exists x :e A, x :e s /\ f x = 0).
