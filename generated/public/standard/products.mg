// Status: transport_required (bridges: hol_num_omega, hol_product_finprod, hol_real_R, nat_le_SNoLe, omega_Subq_R)
Theorem PRODUCT_POS_LT_NUMSEG : forall f:set -> set, (forall x :e omega, f x :e R) -> forall m n :e omega, (forall x :e omega, m <= x /\ x <= n -> 0 < f x) -> 0 < finprod {i :e omega | m <= i /\ i <= n} f.
Admitted.

// HOL Light: Library/products.ml:714 / PRODUCT_OFFSET
// Source hash: md5:9c20f7dc16a9e5735a4e771ec63108a8
// Status: transport_required (bridges: add_nat_add_SNo, hol_num_omega, hol_product_finprod, hol_real_R)
Theorem PRODUCT_OFFSET : forall n :e omega, forall f:set -> set, (forall x :e omega, f x :e R) -> forall m p :e omega, finprod {i :e omega | m + p <= i /\ i <= n + p} f = finprod {i :e omega | m <= i /\ i <= n} (fun i:set => f (i + p)).
Admitted.

