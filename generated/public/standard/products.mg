// HOL Light: Library/products.ml:813 / PRODUCT_CONST_NUMSEG
// Source hash: md5:604489948bdb56cb274b5dea6ce893d2
// Status: transport_required (bridges: add_nat_add_SNo, hol_num_omega, hol_product_finprod, hol_real_R)
