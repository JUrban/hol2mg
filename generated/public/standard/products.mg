// Status: transport_required (bridges: hol_num_omega, hol_product_finprod, hol_real_R)
Theorem PRODUCT_CONST_NUMSEG_1 : forall c :e R, forall n :e omega, finprod (idx_n n) (fun x:set => c) = c ^ n.
