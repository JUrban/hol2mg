Theorem PRODUCT_EQ : forall A:set, A <> Empty -> forall f:set -> set, (forall x :e A, f x :e R) -> forall g:set -> set, (forall x :e A, g x :e R) -> forall s c= A, (forall x :e A, x :e s -> f x = g x) -> finprod s f = finprod s g.
Admitted.

