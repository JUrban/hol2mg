// Status: transport_required (bridges: add_nat_add_SNo, hol_int_int, hol_num_omega, hol_product_finprod, nat_le_SNoLe)
Theorem IPRODUCT_CLAUSES_LEFT : forall f:set -> set, (forall x :e omega, f x :e int) -> forall m n :e omega, m <= n -> finprod {i :e omega | m <= i /\ i <= n} f = f m * finprod {i :e omega | m + 1 <= i /\ i <= n} f.
Admitted.

// HOL Light: Library/products.ml:595 / IPRODUCT_CLAUSES_RIGHT
// Source hash: md5:5424d462eff0a7d8b1fadce5ed1af978
// Status: transport_required (bridges: hol_int_int, hol_num_omega, hol_product_finprod, nat_le_SNoLe, nat_lt_SNoLt)
Theorem IPRODUCT_CLAUSES_RIGHT : forall f:set -> set, (forall x :e omega, f x :e int) -> forall m n :e omega, 0 < n /\ m <= n -> finprod {i :e omega | m <= i /\ i <= n} f = finprod {i :e omega | m <= i /\ i <= minus_nat n 1} f * f n.
Admitted.

// HOL Light: Library/products.ml:600 / INT_OF_NUM_NPRODUCT
// Source hash: md5:b9749c696c5515c7e8e32e0f97f658df
// Status: generalization_required (bridges: empty_case:A, hol_finite_finite, hol_int_int, hol_nproduct_finprod, hol_num_omega, hol_product_finprod, omega_Subq_int)
Theorem INT_OF_NUM_NPRODUCT : forall A:set, forall f:set -> set, (forall x :e A, f x :e omega) -> forall s c= A, finite s -> finprod s f = finprod s f.
Admitted.

// HOL Light: Library/products.ml:605 / IPRODUCT_SUPERSET
// Source hash: md5:8f94a58c03a4ddf9fcb394b95a999c95
// Status: generalization_required (bridges: empty_case:A, hol_int_int, hol_num_omega, hol_product_finprod, omega_Subq_int)
Theorem IPRODUCT_SUPERSET : forall A:set, forall f:set -> set, (forall x :e A, f x :e int) -> forall u v c= A, u c= v /\ (forall x :e A, x :e v /\ ~ x :e u -> f x = 1) -> finprod v f = finprod u f.
Admitted.

// HOL Light: Library/products.ml:612 / IPRODUCT_UNIV
// Source hash: md5:aac3a02ca08356396426b4490ed0ef76
// Status: generalization_required (bridges: empty_case:A, hol_int_int, hol_product_finprod)
Theorem IPRODUCT_UNIV : forall A:set, forall f:set -> set, (forall x :e A, f x :e int) -> forall s c= A, {x :e A | f x <> neutral_of int (fun a:set => fun b:set => a * b)} c= s -> finprod s f = finprod A f.
Admitted.

// HOL Light: Library/products.ml:618 / IPRODUCT_PAIR
// Source hash: md5:1f6d246e944d61e6d8ba26ce3c620e77
// Status: transport_required (bridges: add_nat_add_SNo, hol_int_int, hol_num_omega, hol_product_finprod, mul_nat_mul_SNo)
Theorem IPRODUCT_PAIR : forall f:set -> set, (forall x :e omega, f x :e int) -> forall m n :e omega, finprod {i :e omega | 2 * m <= i /\ i <= 2 * n + 1} f = finprod {i :e omega | m <= i /\ i <= n} (fun i:set => f (2 * i) * f (2 * i + 1)).
Admitted.

// HOL Light: Library/products.ml:623 / IPRODUCT_REFLECT
// Source hash: md5:ee40b76504f563679eeed52b51ffb0fe
// Status: transport_required (bridges: hol_int_int, hol_num_omega, hol_product_finprod, nat_lt_SNoLt, omega_Subq_int)
Theorem IPRODUCT_REFLECT : forall x:set -> set, (forall x :e omega, x x :e int) -> forall m n :e omega, finprod {i :e omega | m <= i /\ i <= n} x = if n < m then 1 else finprod {i :e omega | 0 <= i /\ i <= minus_nat n m} (fun i:set => x (minus_nat n i)).
Admitted.

// HOL Light: Library/products.ml:630 / IPRODUCT_DELETE
// Source hash: md5:176e334b68dfaa64630ecf40567eb35b
// Status: generalization_required (bridges: empty_case:A, hol_finite_finite, hol_int_int, hol_product_finprod)
Theorem IPRODUCT_DELETE : forall A:set, forall f:set -> set, (forall x :e A, f x :e int) -> forall s c= A, forall a :e A, finite s /\ a :e s -> f a * finprod (s :\: {a}) f = finprod s f.
Admitted.

// HOL Light: Library/products.ml:635 / IPRODUCT_DELTA
// Source hash: md5:09f7f3e82d8ed2abe41453bef53e05c0
// Status: generalization_required (bridges: empty_case:A, hol_int_int, hol_num_omega, hol_product_finprod, omega_Subq_int)
Theorem IPRODUCT_DELTA : forall A:set, forall b :e int, forall s c= A, forall a :e A, finprod s (fun x:set => if x = a then b else 1) = if a :e s then b else 1.
Admitted.

// HOL Light: Library/products.ml:641 / INT_POW_NSUM
// Source hash: md5:52e9e0659f5802e91f3c43d50ea9dd15
// Status: transport_required (bridges: hol_finite_finite, hol_int_int, hol_nsum_finsum, hol_num_omega, hol_product_finprod)
Theorem INT_POW_NSUM : forall A:set, A <> Empty -> forall x :e int, forall n:set -> set, (forall x0 :e A, n x0 :e omega) -> forall s c= A, finite s -> x ^ finsum s n = finprod s (fun i:set => x ^ n i).
Admitted.

// HOL Light: Library/products.ml:664 / PRODUCT_SUPPORT
// Source hash: md5:20495e97075bf7c44766b4c27f4de546
// Status: generalization_required (bridges: empty_case:A, hol_product_finprod, hol_real_R)
Theorem PRODUCT_SUPPORT : forall A:set, forall f:set -> set, (forall x :e A, f x :e R) -> forall s c= A, finprod {x :e s | f x <> neutral_of R (fun a:set => fun b:set => a * b)} f = finprod s f.
Admitted.

// HOL Light: Library/products.ml:668 / PRODUCT_UNION
// Source hash: md5:46562e5a9a802c17cf2749bb2cbb8604
// Status: transport_required (bridges: hol_finite_finite, hol_product_finprod, hol_real_R)
Theorem PRODUCT_UNION : forall A:set, A <> Empty -> forall f:set -> set, (forall x :e A, f x :e R) -> forall s t c= A, finite s /\ (finite t /\ s :/\: t = Empty) -> finprod (s :\/: t) f = finprod s f * finprod t f.
Admitted.

// HOL Light: Library/products.ml:673 / PRODUCT_IMAGE
// Source hash: md5:5c12751fc191cf637b4b22b8e2232939
// Status: transport_required (bridges: hol_product_finprod, hol_real_R)
Theorem PRODUCT_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e B, f x :e A) -> forall g:set -> set, (forall x :e A, g x :e R) -> forall s c= B, (forall x y :e B, x :e s /\ (y :e s /\ f x = f y) -> x = y) -> finprod {f x | x :e s} g = finprod s (fun x:set => g (f x)).
Admitted.

// HOL Light: Library/products.ml:679 / PRODUCT_INJECTION
// Source hash: md5:101dc7bb6f72de80e2dcdc70cc65f962
// Status: transport_required (bridges: hol_finite_finite, hol_product_finprod, hol_real_R)
Theorem PRODUCT_INJECTION : forall A:set, A <> Empty -> forall f:set -> set, (forall x :e A, f x :e R) -> forall p:set -> set, (forall x :e A, p x :e A) -> forall s c= A, finite s /\ ((forall x :e A, x :e s -> p x :e s) /\ (forall x y :e A, x :e s /\ (y :e s /\ p x = p y) -> x = y)) -> finprod s (fun x:set => f (p x)) = finprod s f.
Admitted.

// HOL Light: Library/products.ml:687 / PRODUCT_ADD_SPLIT
// Source hash: md5:16f7c9f4947a38a51af9ecca0650af8a
// Status: transport_required (bridges: add_nat_add_SNo, hol_num_omega, hol_product_finprod, hol_real_R, nat_le_SNoLe)
Theorem PRODUCT_ADD_SPLIT : forall f:set -> set, (forall x :e omega, f x :e R) -> forall m n p :e omega, m <= n + 1 -> finprod {i :e omega | m <= i /\ i <= n + p} f = finprod {i :e omega | m <= i /\ i <= n} f * finprod {i :e omega | n + 1 <= i /\ i <= n + p} f.
Admitted.

// HOL Light: Library/products.ml:694 / PRODUCT_POS_LE
// Source hash: md5:df4e9276927f7a21eae0031521b0ecaf
// Status: transport_required (bridges: hol_finite_finite, hol_num_omega, hol_product_finprod, hol_real_R, omega_Subq_R)
Theorem PRODUCT_POS_LE : forall A:set, A <> Empty -> forall f:set -> set, (forall x :e A, f x :e R) -> forall s c= A, finite s /\ (forall x :e A, x :e s -> 0 <= f x) -> 0 <= finprod s f.
Admitted.

