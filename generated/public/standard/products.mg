Theorem PRODUCT_SUPERSET : forall A:set, forall f:set -> set, (forall x :e A, f x :e R) -> forall u v c= A, u c= v /\ (forall x :e A, x :e v /\ ~ x :e u -> f x = 1) -> finprod v f = finprod u f.
