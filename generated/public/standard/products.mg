// HOL Light: Library/products.ml:909 / PRODUCT_CLAUSES_LEFT
// Source hash: md5:c4a18be6af2461da10912fecde084689
// Status: transport_required (bridges: add_nat_add_SNo, hol_num_omega, hol_product_finprod, hol_real_R, nat_le_SNoLe)
Theorem PRODUCT_CLAUSES_LEFT : forall f:set -> set, (forall x :e omega, f x :e R) -> forall m n :e omega, m <= n -> finprod {i :e omega | m <= i /\ i <= n} f = f m * finprod {i :e omega | m + 1 <= i /\ i <= n} f.
Admitted.

// HOL Light: Library/products.ml:914 / PRODUCT_CLAUSES_RIGHT
// Source hash: md5:3a39ca37e68f9b052256a6d75a6578fd
// Status: transport_required (bridges: hol_num_omega, hol_product_finprod, hol_real_R, nat_le_SNoLe, nat_lt_SNoLt)
Theorem PRODUCT_CLAUSES_RIGHT : forall f:set -> set, (forall x :e omega, f x :e R) -> forall m n :e omega, 0 < n /\ m <= n -> finprod {i :e omega | m <= i /\ i <= n} f = finprod {i :e omega | m <= i /\ i <= minus_nat n 1} f * f n.
Admitted.

