// Status: transport_required (bridges: hol_num_omega, hol_real_R)
Theorem REAL_LE_RSQRT : forall x y :e R, x ^ 2 <= y -> x <= if 0 <= y then sqrt_SNo_nonneg y else - sqrt_SNo_nonneg (- y).
Admitted.

