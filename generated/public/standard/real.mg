// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem SQRT_POS_LT : forall x :e R, 0 < x -> 0 < if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x).
