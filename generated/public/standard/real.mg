// Source hash: md5:3ebd69eeb0d4c9e17748c0f936f29e17
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem SQRT_EQ_1 : forall x :e R, (if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x)) = 1 <-> x = 1.
