// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem SQRT_LT_0 : forall x :e R, 0 < (if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x)) <-> 0 < x.
