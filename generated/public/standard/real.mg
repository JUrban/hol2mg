// Source hash: md5:421277d55dc0edea3e04b6b0bc1c1ab9
// Status: transport_required (bridges: hol_real_R)
Theorem SQRT_MONO_LE : forall x y :e R, x <= y -> (if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x)) <= if 0 <= y then sqrt_SNo_nonneg y else - sqrt_SNo_nonneg (- y).
