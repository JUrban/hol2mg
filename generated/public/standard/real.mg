// HOL Light: real.ml:1929 / SQRT_EVEN_POW2
// Source hash: md5:c8f2219659bdf350d24796b7d61c191d
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem SQRT_EVEN_POW2 : forall n :e omega, even_nat n -> (if 0 <= 2 ^ n then sqrt_SNo_nonneg (2 ^ n) else - sqrt_SNo_nonneg (- 2 ^ n)) = 2 ^ div_nat n 2.
Admitted.

// HOL Light: real.ml:1934 / REAL_DIV_SQRT
// Source hash: md5:19c1302164a80387d065b1628b59a56b
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem REAL_DIV_SQRT : forall x :e R, 0 <= x -> x :/: (if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x)) = if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x).
Admitted.

// HOL Light: real.ml:1941 / REAL_RSQRT_LE
// Source hash: md5:7aef40e3fcb93c329794139d541c8a2a
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem REAL_RSQRT_LE : forall x y :e R, 0 <= x /\ (0 <= y /\ x <= (if 0 <= y then sqrt_SNo_nonneg y else - sqrt_SNo_nonneg (- y))) -> x ^ 2 <= y.
Admitted.

// HOL Light: real.ml:1945 / REAL_LSQRT_LE
// Source hash: md5:1ffa11e8808c52b2c6500803f66d5aed
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem REAL_LSQRT_LE : forall x y :e R, 0 <= x /\ (if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x)) <= y -> x <= y ^ 2.
Admitted.

// HOL Light: real.ml:1949 / REAL_SQRT_POW_2
// Source hash: md5:392632ddd5781a97c2b4ff005f325f1f
// Status: transport_required (bridges: hol_num_omega, hol_real_R)
Theorem REAL_SQRT_POW_2 : forall x :e R, (if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x)) ^ 2 = abs_SNo x.
Admitted.

// HOL Light: real.ml:1953 / REAL_ABS_LE_SQRT_POS
// Source hash: md5:dee2f776c30f5bdfe0f6d914f2d46369
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem REAL_ABS_LE_SQRT_POS : forall x y :e R, 0 <= x /\ 0 <= y -> abs_SNo ((if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x)) + - if 0 <= y then sqrt_SNo_nonneg y else - sqrt_SNo_nonneg (- y)) <= if 0 <= abs_SNo (x + - y) then sqrt_SNo_nonneg (abs_SNo (x + - y)) else - sqrt_SNo_nonneg (- abs_SNo (x + - y)).
Admitted.

// HOL Light: real.ml:1967 / REAL_ABS_LE_SQRT
// Source hash: md5:ce3dabfe69c4654d09ea84cf6365a884
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem REAL_ABS_LE_SQRT : forall x y :e R, abs_SNo ((if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x)) + - if 0 <= y then sqrt_SNo_nonneg y else - sqrt_SNo_nonneg (- y)) <= if 0 <= 2 * abs_SNo (x + - y) then sqrt_SNo_nonneg (2 * abs_SNo (x + - y)) else - sqrt_SNo_nonneg (- 2 * abs_SNo (x + - y)).
Admitted.

