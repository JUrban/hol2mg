// Status: transport_required (bridges: hol_real_R)
Theorem SQRT_DIV : forall x y :e R, (if 0 <= x :/: y then sqrt_SNo_nonneg (x :/: y) else - sqrt_SNo_nonneg (- x :/: y)) = (if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x)) :/: if 0 <= y then sqrt_SNo_nonneg y else - sqrt_SNo_nonneg (- y).
Admitted.

