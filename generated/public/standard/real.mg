// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem SQRT_POW_2 : forall x :e R, 0 <= x -> (if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x)) ^ 2 = x.
Admitted.

// HOL Light: real.ml:1837 / SQRT_POW2
// Source hash: md5:c9e532d4ae28f19cced07c0bb0a2fbab
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem SQRT_POW2 : forall x :e R, (if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x)) ^ 2 = x <-> 0 <= x.
Admitted.

// HOL Light: real.ml:1841 / SQRT_MUL
// Source hash: md5:037bfab9468cfaa5178cfd6b1e41a0a8
// Status: transport_required (bridges: hol_real_R)
Theorem SQRT_MUL : forall x y :e R, (if 0 <= x * y then sqrt_SNo_nonneg (x * y) else - sqrt_SNo_nonneg (- x * y)) = (if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x)) * if 0 <= y then sqrt_SNo_nonneg y else - sqrt_SNo_nonneg (- y).
