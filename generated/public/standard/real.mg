// Status: transport_required (bridges: hol_real_R)
Theorem REAL_SGN_EQ_INEQ : forall x y :e R, (if 0 < x then 1 else if x < 0 then - 1 else 0) = (if 0 < y then 1 else if y < 0 then - 1 else 0) <-> x = y \/ abs_SNo (x + - y) < if abs_SNo x <= abs_SNo y then abs_SNo y else abs_SNo x.
Admitted.

// HOL Light: real.ml:1623 / REAL_SGNS_EQ
// Source hash: md5:b12611944c097b17e591bc53123cad46
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem REAL_SGNS_EQ : forall x y :e R, (if 0 < x then 1 else if x < 0 then - 1 else 0) = (if 0 < y then 1 else if y < 0 then - 1 else 0) <-> (x = 0 <-> y = 0) /\ ((0 < x <-> 0 < y) /\ (x < 0 <-> y < 0)).
Admitted.

// HOL Light: real.ml:1630 / REAL_SGNS_EQ_ALT
// Source hash: md5:b2b54e6eb3282ccfeb4bbf84445deb55
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem REAL_SGNS_EQ_ALT : forall x y :e R, (if 0 < x then 1 else if x < 0 then - 1 else 0) = (if 0 < y then 1 else if y < 0 then - 1 else 0) <-> (x = 0 -> y = 0) /\ ((0 < x -> 0 < y) /\ (x < 0 -> y < 0)).
Admitted.

// HOL Light: real.ml:1641 / REAL_WLOG_LE
// Source hash: md5:be2fe79adb0fa7756db5fb551324119f
// Status: transport_required (bridges: hol_real_R)
Theorem REAL_WLOG_LE : forall P:set -> set -> prop, (forall x y :e R, P x y <-> P y x) /\ (forall x y :e R, x <= y -> P x y) -> forall x y :e R, P x y.
Admitted.

// HOL Light: real.ml:1645 / REAL_WLOG_LT
// Source hash: md5:8472bc6418f9ddb1fa484241145fb1d8
// Status: transport_required (bridges: hol_real_R)
Theorem REAL_WLOG_LT : forall P:set -> set -> prop, (forall x :e R, P x x) /\ ((forall x y :e R, P x y <-> P y x) /\ (forall x y :e R, x < y -> P x y)) -> forall x y :e R, P x y.
Admitted.

// HOL Light: real.ml:1650 / REAL_WLOG_LE_3
// Source hash: md5:0116a37aa7ee1be862334b1b5702dd48
// Status: transport_required (bridges: hol_real_R)
Theorem REAL_WLOG_LE_3 : forall P:set -> set -> set -> prop, (forall x y z :e R, P x y z -> P y x z /\ P x z y) /\ (forall x y z :e R, x <= y /\ y <= z -> P x y z) -> forall x y z :e R, P x y z.
Admitted.

// HOL Light: real.ml:1663 / sqrt
// Source hash: md5:64ef60a7123c0c8a638ee7fcefc57918
// Status: transport_required (bridges: choose_in_spec, hol_num_omega, hol_real_R)
Theorem sqrt : forall x :e R, (if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x)) = choose_in R (fun y:set => (if 0 < y then 1 else if y < 0 then - 1 else 0) = (if 0 < x then 1 else if x < 0 then - 1 else 0) /\ y ^ 2 = abs_SNo x).
Admitted.

// HOL Light: real.ml:1666 / SQRT_UNIQUE
// Source hash: md5:e765e2c48d8108cd080f1284cf72647b
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem SQRT_UNIQUE : forall x y :e R, 0 <= y /\ y ^ 2 = x -> (if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x)) = y.
Admitted.

// HOL Light: real.ml:1677 / POW_2_SQRT
// Source hash: md5:03fea7ab8e7e29b7b9193b439d509c47
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem POW_2_SQRT : forall x :e R, 0 <= x -> (if 0 <= x ^ 2 then sqrt_SNo_nonneg (x ^ 2) else - sqrt_SNo_nonneg (- x ^ 2)) = x.
Admitted.

// HOL Light: real.ml:1681 / SQRT_0
// Source hash: md5:4107f97fa027c77d18bded7d67cdb9d5
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem SQRT_0 : (if 0 <= 0 then sqrt_SNo_nonneg 0 else - sqrt_SNo_nonneg (- 0)) = 0.
Admitted.

// HOL Light: real.ml:1685 / SQRT_1
// Source hash: md5:e5a784fe40959d8236553c3b4ad06f0d
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem SQRT_1 : (if 0 <= 1 then sqrt_SNo_nonneg 1 else - sqrt_SNo_nonneg (- 1)) = 1.
Admitted.

// HOL Light: real.ml:1689 / POW_2_SQRT_ABS
// Source hash: md5:3309a6904d738a4dee8c3183243e464b
// Status: transport_required (bridges: hol_num_omega, hol_real_R)
Theorem POW_2_SQRT_ABS : forall x :e R, (if 0 <= x ^ 2 then sqrt_SNo_nonneg (x ^ 2) else - sqrt_SNo_nonneg (- x ^ 2)) = abs_SNo x.
Admitted.

// HOL Light: real.ml:1695 / SQRT_WORKS_GEN
// Source hash: md5:32b68fe266a98305f99d70902b4c7971
// Status: transport_required (bridges: hol_num_omega, hol_real_R)
Theorem SQRT_WORKS_GEN : forall x :e R, (if 0 < if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x) then 1 else if (if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x)) < 0 then - 1 else 0) = (if 0 < x then 1 else if x < 0 then - 1 else 0) /\ (if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x)) ^ 2 = abs_SNo x.
Admitted.

// HOL Light: real.ml:1800 / SQRT_UNIQUE_GEN
// Source hash: md5:962c5c99c90a69ef082b4e220662a6b0
// Status: transport_required (bridges: hol_num_omega, hol_real_R)
Theorem SQRT_UNIQUE_GEN : forall x y :e R, (if 0 < y then 1 else if y < 0 then - 1 else 0) = (if 0 < x then 1 else if x < 0 then - 1 else 0) /\ y ^ 2 = abs_SNo x -> (if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x)) = y.
Admitted.

// HOL Light: real.ml:1810 / SQRT_NEG
// Source hash: md5:270a54a5b49ca2a4d9c734345937b606
// Status: transport_required (bridges: hol_real_R)
Theorem SQRT_NEG : forall x :e R, (if 0 <= - x then sqrt_SNo_nonneg (- x) else - sqrt_SNo_nonneg (- - x)) = - if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x).
Admitted.

// HOL Light: real.ml:1816 / REAL_SGN_SQRT
// Source hash: md5:6246426ec2fcb2d6ac2b297bc2c03047
// Status: transport_required (bridges: hol_real_R)
Theorem REAL_SGN_SQRT : forall x :e R, (if 0 < if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x) then 1 else if (if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x)) < 0 then - 1 else 0) = if 0 < x then 1 else if x < 0 then - 1 else 0.
Admitted.

// HOL Light: real.ml:1820 / SQRT_WORKS
// Source hash: md5:d2ba33ce3887617991fbab15942ed453
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem SQRT_WORKS : forall x :e R, 0 <= x -> 0 <= (if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x)) /\ (if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x)) ^ 2 = x.
Admitted.

