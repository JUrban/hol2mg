// Source hash: md5:f554cf1ff947587ebd5e3decca2a9ff5
// Status: transport_required (bridges: hol_real_R)
Theorem SQRT_MONO_LE_EQ : forall x y :e R, (if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x)) <= (if 0 <= y then sqrt_SNo_nonneg y else - sqrt_SNo_nonneg (- y)) <-> x <= y.
