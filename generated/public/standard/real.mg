// Status: transport_required (bridges: hol_real_R)
Theorem REAL_ABS_SQRT : forall x :e R, abs_SNo (if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x)) = if 0 <= abs_SNo x then sqrt_SNo_nonneg (abs_SNo x) else - sqrt_SNo_nonneg (- abs_SNo x).
