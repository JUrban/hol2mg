// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem REAL_LE_LSQRT : forall x y :e R, 0 <= y /\ x <= y ^ 2 -> (if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x)) <= y.
