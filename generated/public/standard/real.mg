// Source hash: md5:b1afb305396a9b59d372376b8aaeb0c0
// Status: transport_required (bridges: hol_real_R)
Theorem SQRT_MONO_LT_EQ : forall x y :e R, (if 0 <= x then sqrt_SNo_nonneg x else - sqrt_SNo_nonneg (- x)) < (if 0 <= y then sqrt_SNo_nonneg y else - sqrt_SNo_nonneg (- y)) <-> x < y.
