Theorem INT_SUB_POW_L1 : forall x :e int, forall n :e omega, 1 <= n -> 1 + - x ^ n = (1 + - x) * finsum {i :e omega | 0 <= i /\ i <= minus_nat n 1} (fun i:set => x ^ i).
