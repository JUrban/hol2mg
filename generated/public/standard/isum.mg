Theorem ISUM_ZERO_EXISTS : forall A:set, forall u:set -> set, (forall x :e A, u x :e int) -> forall s c= A, finite s /\ finsum s u = 0 -> (forall i :e A, i :e s -> u i = 0) \/ exists j k :e A, j :e s /\ (u j < 0 /\ (k :e s /\ 0 < u k)).
