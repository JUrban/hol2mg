// Status: transport_required (bridges: hol_finite_finite, hol_int_int, hol_num_omega, hol_sum_finsum, omega_Subq_int)
Theorem ISUM_IMAGE_NONZERO : forall A B:set, A <> Empty -> B <> Empty -> forall d:set -> set, (forall x :e B, d x :e int) -> forall i:set -> set, (forall x :e A, i x :e B) -> forall s c= A, finite s /\ (forall x y :e A, x :e s /\ (y :e s /\ (~ x = y /\ i x = i y)) -> d (i x) = 0) -> finsum {i x | x :e s} d = finsum s (fun x:set => d (i x)).
