// Status: transport_required (bridges: hol_finite_finite, hol_int_int, hol_sum_finsum)
Theorem ISUM_INJECTION : forall A:set, A <> Empty -> forall f:set -> set, (forall x :e A, f x :e int) -> forall p:set -> set, (forall x :e A, p x :e A) -> forall s c= A, finite s /\ ((forall x :e A, x :e s -> p x :e s) /\ (forall x y :e A, x :e s /\ (y :e s /\ p x = p y) -> x = y)) -> finsum s (fun x:set => f (p x)) = finsum s f.
Admitted.

