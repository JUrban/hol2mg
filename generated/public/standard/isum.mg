Theorem ISUM_INCL_EXCL : forall A:set, forall s t c= A, forall f:set -> set, (forall x :e A, f x :e int) -> finite s /\ finite t -> finsum s f + finsum t f = finsum (s :\/: t) f + finsum (s :/\: t) f.
