// Status: transport_required (bridges: add_nat_add_SNo, hol_int_int, hol_num_omega, hol_sum_finsum, nat_le_SNoLe, omega_Subq_int)
Theorem ISUM_PARTIAL_PRE : forall f:set -> set, (forall x :e omega, f x :e int) -> forall g:set -> set, (forall x :e omega, g x :e int) -> forall m n :e omega, finsum {i :e omega | m <= i /\ i <= n} (fun k:set => f k * (g k + - g (minus_nat k 1))) = if m <= n then (f (n + 1) * g n + - f m * g (minus_nat m 1)) + - finsum {i :e omega | m <= i /\ i <= n} (fun k:set => g k * (f (k + 1) + - f k)) else 0.
