// Status: generalization_required (bridges: hol_prod_setprod, hol_typedef_matroid)
Theorem submatroid_thm : forall A:set, A <> Empty -> forall s c= A, forall m :e matroid A, submatroid A m s = ({x :e A | matroid_span A m (matroid_set A m :/\: s) x},fun x :e Power A => {x0 :e A | matroid_span A m x x0}).
