// Status: transport_required (bridges: hol_typedef_matroid)
Theorem SUBMATROID : forall A:set, A <> Empty -> (forall m :e matroid A, forall s c= A, matroid_subspace A m s -> matroid_set A (submatroid A m s) = s) /\ forall m :e matroid A, forall s x c= A, forall x0 :e A, matroid_span A (submatroid A m s) x x0 <-> matroid_span A m x x0.
Admitted.

