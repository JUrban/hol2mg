// Status: transport_required (bridges: hol_finite_finite, hol_list_finseq, hol_num_omega, nat_le_SNoLe)
Theorem SUSLIN_REGULAR : forall A:set, A <> Empty -> forall u c= Power A, (forall c c= Power A, finite c /\ (~ c = Empty /\ c c= u) -> {x :e A | forall Y :e c, x :e Y} :e u) -> suslin A u = {suslin_operation A (fun x:set => fun x0:set => x0 :e f x) | f :e Power A :^: finseq omega, (forall l :e finseq omega, ~ l = seq_nil -> f l :e u) /\ forall s:set -> set, (forall x :e omega, s x :e omega) -> forall m n :e omega, 1 <= m /\ m <= n -> f (seq_mk n s) c= f (seq_mk m s)}.
Admitted.

// HOL Light:  / SUSLIN_SUBSET
// Source hash: md5:e408b616fd38259821c15b52b51c44b8
// Status: exact_native
Theorem SUSLIN_SUBSET : forall A:set, A <> Empty -> forall C D c= Power A, C c= D -> suslin A C c= suslin A D.
Admitted.

// HOL Light:  / SUSLIN_SUPERSET
// Source hash: md5:df75bf6e6422a43e9915fb68f9e229d8
// Status: exact_native
Theorem SUSLIN_SUPERSET : forall A:set, A <> Empty -> forall u c= Power A, u c= suslin A u.
Admitted.

// HOL Light:  / SUSLIN_SUSLIN
// Source hash: md5:464965fc071704dabfaefe193a0be33c
// Status: exact_native
Theorem SUSLIN_SUSLIN : forall A:set, A <> Empty -> forall u c= Power A, suslin A (suslin A u) = suslin A u.
Admitted.

// HOL Light:  / SUSLIN_UNION
// Source hash: md5:7dff975a5560e8619ca41504fa88f2c7
// Status: exact_native
Theorem SUSLIN_UNION : forall A:set, A <> Empty -> forall C c= Power A, forall s t c= A, s :e suslin A C /\ t :e suslin A C -> s :\/: t :e suslin A C.
Admitted.

// HOL Light:  / SUSLIN_UNIONS
// Source hash: md5:b8d7e74f932cd7c40c90e82027031fcd
// Status: transport_required (bridges: hol_countable)
Theorem SUSLIN_UNIONS : forall A:set, A <> Empty -> forall C f c= Power A, countable f /\ (~ f = Empty /\ (forall s c= A, s :e f -> s :e suslin A C)) -> Union f :e suslin A C.
Admitted.

// HOL Light:  / TRIANGLE_LEMMA
// Source hash: md5:c0b4c20d689f99bdaf0086400b2bd7bd
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem TRIANGLE_LEMMA : forall x y z :e R, 0 <= x /\ (0 <= y /\ (0 <= z /\ x ^ 2 <= y ^ 2 + z ^ 2)) -> x <= y + z.
Admitted.

// HOL Light:  / UPPER_BOUND_FINITE_SET
