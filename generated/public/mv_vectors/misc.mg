// Status: transport_required (bridges: hol_num_omega, hol_real_R, hol_sum_finsum, nat_le_SNoLe, omega_Subq_R)
Theorem SUM_GP_MULTIPLIED : forall x :e R, forall m n :e omega, m <= n -> (1 + - x) * finsum {i :e omega | m <= i /\ i <= n} (fun i:set => x ^ i) = x ^ m + - x ^ ordsucc n.
Admitted.

// HOL Light:  / SUM_GP_OFFSET
// Source hash: md5:10b07ead8205b7b96091efe13fe8b43a
// Status: transport_required (bridges: add_nat_add_SNo, hol_num_omega, hol_real_R, hol_sum_finsum, omega_Subq_R)
Theorem SUM_GP_OFFSET : forall x :e R, forall m n :e omega, finsum {i :e omega | m <= i /\ i <= m + n} (fun i:set => x ^ i) = if x = 1 then n + 1 else x ^ m * (1 + - x ^ ordsucc n) :/: (1 + - x).
Admitted.

