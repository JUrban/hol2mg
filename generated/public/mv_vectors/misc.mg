// Source hash: md5:21453985dbd27d3c1579c5d73e0a1dbb
// Status: transport_required (bridges: hol_countable, hol_num_omega)
Theorem GENERAL_REDUCTION_THEOREM : forall A:set, A <> Empty -> forall P:set -> prop, P Empty /\ ((forall s t c= A, P s /\ P t -> P (s :\/: t)) /\ (forall s t c= A, P s /\ P t -> P (s :\: t))) -> forall s :e Power A :^: omega, (forall n :e omega, exists u c= Power A, countable u /\ (forall c :e u, P c) /\ Union u = s n) -> exists t :e Power A :^: omega, (forall n :e omega, exists u c= Power A, countable u /\ (forall c :e u, P c) /\ Union u = t n) /\ ((forall n :e omega, t n c= s n) /\ ((forall x y :e omega, x <> y -> t x :/\: t y = Empty) /\ Union {t n | n :e omega, n :e omega} = Union {s n | n :e omega, n :e omega})).
Admitted.

