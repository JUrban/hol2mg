// Status: transport_required (bridges: hol_finite_finite, hol_num_omega, nat_le_SNoLe)
Theorem UPPER_BOUND_FINITE_SET : forall A:set, A <> Empty -> forall f:set -> set, (forall x :e A, f x :e omega) -> forall s c= A, finite s -> exists a :e omega, forall x :e A, x :e s -> f x <= a.
Admitted.

