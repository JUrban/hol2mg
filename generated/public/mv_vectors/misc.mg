Admitted.

// HOL Light:  / SUM_GP
// Source hash: md5:3b6983aaadd5ef0cda39d3081837e538
// Status: transport_required (bridges: add_nat_add_SNo, hol_num_omega, hol_real_R, hol_sum_finsum, nat_lt_SNoLt, omega_Subq_R)
Theorem SUM_GP : forall x :e R, forall m n :e omega, finsum {i :e omega | m <= i /\ i <= n} (fun i:set => x ^ i) = if n < m then 0 else if x = 1 then minus_nat (n + 1) m else (x ^ m + - x ^ ordsucc n) :/: (1 + - x).
Admitted.

// HOL Light:  / SUM_GP_BASIC
// Source hash: md5:90d0718180c4b1f31f9d330f75e3320e
// Status: transport_required (bridges: hol_num_omega, hol_real_R, hol_sum_finsum, omega_Subq_R)
Theorem SUM_GP_BASIC : forall x :e R, forall n :e omega, (1 + - x) * finsum {i :e omega | 0 <= i /\ i <= n} (fun i:set => x ^ i) = 1 + - x ^ ordsucc n.
Admitted.

// HOL Light:  / SUM_GP_MULTIPLIED
