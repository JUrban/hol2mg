// Status: transport_required (bridges: hol_finite_finite, hol_prod_setprod, hol_typedef_topology)
Theorem PASTING_LEMMA_EXISTS_CLOSED : forall A B K:set, A <> Empty -> B <> Empty -> K <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set -> set, (forall x :e K, forall y :e A, f x y :e B) -> forall t :e Power A :^: K, forall k c= K, finite k /\ (topspace A top c= Union {t i | i :e K, i :e k} /\ ((forall i :e K, i :e k -> closed_in A top (t i) /\ continuous_map A B (subtopology A top (t i),top') (f i)) /\ (forall i j :e K, forall x :e A, i :e k /\ (j :e k /\ x :e topspace A top :/\: (t i :/\: t j)) -> f i x = f j x))) -> exists g:set -> set, (forall x :e A, g x :e B) /\ (continuous_map A B (top,top') g /\ forall x :e A, forall i :e K, i :e k /\ x :e topspace A top :/\: t i -> g x = f i x).
