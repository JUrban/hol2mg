// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HOMEOMORPHIC_MAP_SUBTOPOLOGIES_ALT : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall s c= A, forall t c= B, homeomorphic_map A B (top,top') f /\ (forall x :e A, x :e topspace A top /\ f x :e topspace B top' -> (f x :e t <-> x :e s)) -> homeomorphic_map A B (subtopology A top s,subtopology B top' t) f.
Admitted.

// HOL Light: Multivariate/metric.ml:5533 / HOMEOMORPHIC_MAPS_PROD
// Source hash: md5:1691deb1e1ec30df6fbbb9b368907ab4
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HOMEOMORPHIC_MAPS_PROD : forall A B C D:set, A <> Empty -> B <> Empty -> C <> Empty -> D <> Empty -> forall top1 :e topology A, forall top2 :e topology C, forall top3 :e topology B, forall top4 :e topology D, forall f :e B :^: A, forall g :e D :^: C, forall f' :e A :^: B, forall g' :e C :^: D, homeomorphic_maps (A :*: C) (B :*: D) (prod_topology A C top1 top2,prod_topology B D top3 top4) (fun p :e A :*: C => (f (p 0),g (p 1)),fun p :e B :*: D => (f' (p 0),g' (p 1))) <-> topspace (A :*: C) (prod_topology A C top1 top2) = Empty /\ topspace (B :*: D) (prod_topology B D top3 top4) = Empty \/ homeomorphic_maps A B (top1,top3) (f,f') /\ homeomorphic_maps C D (top2,top4) (g,g').
Admitted.

