// Status: transport_required (bridges: hol_typedef_topology)
Theorem UNIONS_PATH_COMPONENTS_OF : forall A:set, A <> Empty -> forall top :e topology A, Union (path_components_of A top) = topspace A top.
Admitted.

// HOL Light: Multivariate/metric.ml:22689 / PATH_COMPONENTS_OF_MAXIMAL
// Source hash: md5:aa95e0aabbacec01eb52c02c0a79ec6a
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem PATH_COMPONENTS_OF_MAXIMAL : forall A:set, forall top :e topology A, forall s c c= A, c :e path_components_of A top /\ (path_connected_in A top s /\ ~ c :/\: s = Empty) -> s c= c.
Admitted.

