// Status: transport_required (bridges: hol_typedef_topology)
Theorem NONEMPTY_PATH_COMPONENTS_OF : forall A:set, A <> Empty -> forall top :e topology A, forall c c= A, c :e path_components_of A top -> ~ c = Empty.
Admitted.

