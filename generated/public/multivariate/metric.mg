// Source hash: md5:bc21754e93fabb6dd18f3efc381b1b47
// Status: transport_required (bridges: hol_typedef_topology)
Theorem PARACOMPACT_HAUSDORFF_EXPANSION_LEMMA : forall A:set, A <> Empty -> forall top :e topology A, forall B c= Power A, paracompact_space A top /\ (hausdorff_space A top /\ ((forall b c= A, b :e B -> b c= topspace A top) /\ locally_finite_in A top B)) -> exists f :e Power A :^: Power A, (forall b c= A, b :e B -> f b :e top) /\ ((forall b c= A, b :e B -> b c= f b) /\ locally_finite_in A top {f b | b :e Power A, b :e B}).
Admitted.

// HOL Light: Multivariate/metric.ml:44478 / PARACOMPACT_SPACE_EQ_CLOSED_REFINEMENT
// Source hash: md5:b33d7e1698a19a7242ba81f019e7a279
// Status: transport_required (bridges: hol_typedef_topology)
Theorem PARACOMPACT_SPACE_EQ_CLOSED_REFINEMENT : forall A:set, A <> Empty -> forall top :e topology A, regular_space A top -> (paracompact_space A top <-> forall U c= Power A, (forall u c= A, u :e U -> u :e top) /\ Union U = topspace A top -> exists V c= Power A, (forall v c= A, v :e V -> closed_in A top v) /\ (Union V = topspace A top /\ ((forall v c= A, v :e V -> exists u c= A, u :e U /\ v c= u) /\ locally_finite_in A top V))).
Admitted.

