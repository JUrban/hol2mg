// Source hash: md5:9e26c06d899beacf72e6822ccc5584bd
// Status: transport_required (bridges: hol_typedef_topology)
Theorem DERIVED_SET_SUBSET_GEN : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, derived_set_of A top s c= s <-> closed_in A top (topspace A top :/\: s).
Admitted.

// HOL Light: Multivariate/metric.ml:1228 / DERIVED_SET_SUBSET
// Source hash: md5:6859d7bc7e162c22ab1ea0e759a2ec78
// Status: transport_required (bridges: hol_typedef_topology)
Theorem DERIVED_SET_SUBSET : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, s c= topspace A top -> (derived_set_of A top s c= s <-> closed_in A top s).
Admitted.

// HOL Light: Multivariate/metric.ml:1234 / CLOSED_IN_DERIVED_SET
// Source hash: md5:a9e49726dfbd9dcc4ca52ba1bdbffdc2
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CLOSED_IN_DERIVED_SET : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, closed_in A (subtopology A top t) s <-> s c= topspace A top /\ (s c= t /\ forall x :e A, x :e derived_set_of A top s /\ x :e t -> x :e s).
Admitted.

// HOL Light: Multivariate/metric.ml:1245 / CLOSED_IN_INTER_CLOSURE_OF
