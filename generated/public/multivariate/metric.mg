// Status: transport_required (bridges: hol_list_finseq, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_topology, omega_Subq_R)
Theorem NORMAL_SPACE_EQ_URYSOHN : forall A:set, A <> Empty -> forall top :e topology A, normal_space A top <-> forall s t c= A, closed_in A top s /\ (closed_in A top t /\ s :/\: t = Empty) -> exists f:set -> set, (forall x :e A, f x :e R) /\ (continuous_map A R (top,subtopology R euclideanreal (closed_real_interval (seq_cons (0,1) seq_nil))) f /\ ((forall x :e A, x :e s -> f x = 0) /\ forall x :e A, x :e t -> f x = 1)).
