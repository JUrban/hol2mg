// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_metric)
Theorem LIPSCHITZ_CONTINUOUS_MAP_INTO_SUBMETRIC : forall A B:set, A <> Empty -> B <> Empty -> forall m1 :e metric A, forall m2 :e metric B, forall s c= B, forall f:set -> set, (forall x :e A, f x :e B) -> (lipschitz_continuous_map B A (m1,submetric B m2 s) f <-> {f x | x :e mspace A m1} c= s /\ lipschitz_continuous_map B A (m1,m2) f).
Admitted.

// HOL Light: Multivariate/metric.ml:30435 / LIPSCHITZ_CONTINUOUS_MAP_CONST
