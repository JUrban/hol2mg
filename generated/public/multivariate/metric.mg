Theorem LOCALLY_CONNECTED_SPACE_OPEN_SUBSET : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, locally_connected_space A top /\ s :e top -> locally_connected_space A (subtopology A top s).
Admitted.

// HOL Light: Multivariate/metric.ml:25856 / LOCALLY_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE
// Source hash: md5:2ea8e3c8297aaf049da14b6fdadcc503
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem LOCALLY_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> quotient_map A B (top,top') f /\ locally_connected_space A top -> locally_connected_space B top'.
Admitted.

// HOL Light: Multivariate/metric.ml:25906 / LOCALLY_CONNECTED_SPACE_RETRACTION_MAP_IMAGE
// Source hash: md5:1012c5db7bb2977ca8621234178655b7
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem LOCALLY_CONNECTED_SPACE_RETRACTION_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall r:set -> set, (forall x :e A, r x :e B) -> retraction_map A B (top,top') r /\ locally_connected_space A top -> locally_connected_space B top'.
Admitted.

