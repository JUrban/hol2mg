Theorem ALEXANDROFF_HAUSDORFF : forall A:set, A <> Empty -> forall top :e topology A, compact_space A top /\ (metrizable_space A top /\ ~ topspace A top = Empty) -> exists f:set -> set, (forall x :e Power omega, f x :e A) /\ (continuous_map (Power omega) A (cantor_space,top) f /\ {f x | x :e topspace (Power omega) cantor_space} = topspace A top).
Admitted.

// HOL Light: Multivariate/metric.ml:46197 / DENSE_FUNCTION_ON_DYADIC
// Source hash: md5:ae5f6e1dacab8b415991e562008d14c1
// Status: transport_required (bridges: hol_list_finseq, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_topology, omega_Subq_R)
Theorem DENSE_FUNCTION_ON_DYADIC : forall A:set, A <> Empty -> forall m :e metric A, forall e0 :e R, mcomplete A m /\ (0 < e0 /\ (forall eps :e R, 0 < eps -> exists del :e R, 0 < del /\ forall x y :e A, x :e mspace A m /\ (y :e mspace A m /\ mdist A m (x,y) < del) -> exists c c= A, connected_in A (mtopology A m) c /\ (x :e c /\ (y :e c /\ (mbounded A m c /\ mdiameter A m c < eps))))) -> exists d :e R, 0 < d /\ forall x y :e A, x :e mspace A m /\ (y :e mspace A m /\ mdist A m (x,y) < d) -> exists f:set -> set, (forall x0 :e R, f x0 :e A) /\ exists s c= R, s c= closed_real_interval (seq_cons (0,1) seq_nil) /\ (closed_real_interval (seq_cons (0,1) seq_nil) c= closure_of R euclideanreal s /\ (0 :e s /\ (1 :e s /\ (f 0 = x /\ (f 1 = y /\ ({f x | x :e s} c= mspace A m /\ ((forall a :e R, a :e s -> mdist A m (x,f a) <= e0 :/: 4) /\ uniformly_continuous_map A R (submetric R real_euclidean_metric s,m) f))))))).
Admitted.

// HOL Light: Multivariate/metric.ml:47706 / COMPACT_LOCALLY_CONNECTED_NEARBY_PATH
// Source hash: md5:258d1923748c7f434cde11e46331de23
// Status: transport_required (bridges: hol_list_finseq, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_topology, omega_Subq_R)
Theorem COMPACT_LOCALLY_CONNECTED_NEARBY_PATH : forall A:set, A <> Empty -> forall m :e metric A, compact_space A (mtopology A m) /\ locally_connected_space A (mtopology A m) -> forall e0 :e R, 0 < e0 -> exists d :e R, 0 < d /\ forall x y :e A, x :e mspace A m /\ (y :e mspace A m /\ mdist A m (x,y) < d) -> exists g:set -> set, (forall x0 :e R, g x0 :e A) /\ (path_in A (mtopology A m) g /\ (g 0 = x /\ (g 1 = y /\ ({g x | x :e closed_real_interval (seq_cons (0,1) seq_nil)} c= mspace A m /\ mdiameter A m {g x | x :e closed_real_interval (seq_cons (0,1) seq_nil)} < e0)))).
Admitted.

