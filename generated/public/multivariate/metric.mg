// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_MAP_PAIRWISE : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e topology A, forall top1 :e topology B, forall top2 :e topology C, forall f:set -> set, (forall x :e A, f x :e B :*: C) -> (continuous_map A (B :*: C) (top,prod_topology B C top1 top2) f <-> continuous_map A B (top,top1) (fun x:set => f x 0) /\ continuous_map A C (top,top2) (fun x:set => f x 1)).
