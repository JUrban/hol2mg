// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_metric)
Theorem MCOMPLETE_PROD_METRIC : forall A B:set, A <> Empty -> B <> Empty -> forall m1 :e metric A, forall m2 :e metric B, mcomplete (A :*: B) (prod_metric A B m1 m2) <-> mspace A m1 = Empty \/ (mspace B m2 = Empty \/ mcomplete A m1 /\ mcomplete B m2).
Admitted.

