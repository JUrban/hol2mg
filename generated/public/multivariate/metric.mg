// Source hash: md5:9a27afdfb7772976ea9d937f402efcbf
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem TOPOLOGICAL_PROPERTY_OF_PROD_COMPONENT : forall A B:set, A <> Empty -> B <> Empty -> forall P Q R0:set -> prop, forall top1 :e topology A, forall top2 :e topology B, (forall a :e A, a :e topspace A top1 /\ P (prod_topology A B top1 top2) -> P (subtopology (A :*: B) (prod_topology A B top1 top2) ({a} :*: topspace B top2))) /\ ((forall b :e B, b :e topspace B top2 /\ P (prod_topology A B top1 top2) -> P (subtopology (A :*: B) (prod_topology A B top1 top2) (topspace A top1 :*: {b}))) /\ ((forall top :e topology (A :*: B), forall top' :e topology A, homeomorphic_space (A :*: B) A top top' -> (P top <-> Q top')) /\ (forall top :e topology (A :*: B), forall top' :e topology B, homeomorphic_space (A :*: B) B top top' -> (P top <-> R0 top')))) -> P (prod_topology A B top1 top2) -> topspace (A :*: B) (prod_topology A B top1 top2) = Empty \/ Q top1 /\ R0 top2.
Admitted.

// HOL Light: Multivariate/metric.ml:5714 / PRODUCT_TOPOLOGY_HOMEOMORPHIC_COMPONENT
// Source hash: md5:960550b96f951ebc59447f0dd49cc427
// Status: generalization_required (bridges: empty_case:K, hol_typedef_topology)
Theorem PRODUCT_TOPOLOGY_HOMEOMORPHIC_COMPONENT : forall A K:set, A <> Empty -> forall tops:set -> set, (forall x :e K, tops x :e topology A) -> forall k c= K, forall i :e K, i :e k /\ (forall j :e K, j :e k /\ ~ j = i -> exists a :e A, topspace A (tops j) = {a}) -> homeomorphic_space (A :^: K) A (product_topology A K k tops) (tops i).
Admitted.

// HOL Light: Multivariate/metric.ml:5733 / TOPOLOGICAL_PROPERTY_OF_PRODUCT_COMPONENT
// Source hash: md5:71258c1d9e32a8872db518aa35559219
// Status: generalization_required (bridges: empty_case:K, hol_fun_setexp, hol_typedef_topology)
Theorem TOPOLOGICAL_PROPERTY_OF_PRODUCT_COMPONENT : forall A K:set, A <> Empty -> forall P Q:set -> prop, forall tops:set -> set, (forall x :e K, tops x :e topology A) -> forall k c= K, (forall z :e A :^: K, forall i :e K, z :e topspace (A :^: K) (product_topology A K k tops) /\ (P (product_topology A K k tops) /\ i :e k) -> P (subtopology (A :^: K) (product_topology A K k tops) {f :e A :^: K | (forall i0 :e k, f i0 :e {x0 :e A | (i0 = i -> x0 :e topspace A (tops i)) /\ (~ i0 = i -> x0 :e {z i0})}) /\ forall i0 :e K, ~ i0 :e k -> f i0 = choose_in A (fun y:set => False)})) /\ (forall top :e topology (A :^: K), forall top' :e topology A, homeomorphic_space (A :^: K) A top top' -> (P top <-> Q top')) -> P (product_topology A K k tops) -> topspace (A :^: K) (product_topology A K k tops) = Empty \/ forall i :e K, i :e k -> Q (tops i).
Admitted.

// HOL Light: Multivariate/metric.ml:5763 / HOMEOMORPHIC_SPACE_PROD_TOPOLOGY
// Source hash: md5:be55f894ac7db6be72b68cddef843c75
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HOMEOMORPHIC_SPACE_PROD_TOPOLOGY : forall A B C D:set, A <> Empty -> B <> Empty -> C <> Empty -> D <> Empty -> forall top1 :e topology A, forall top1' :e topology B, forall top2 :e topology C, forall top2' :e topology D, homeomorphic_space A B top1 top1' /\ homeomorphic_space C D top2 top2' -> homeomorphic_space (A :*: C) (B :*: D) (prod_topology A C top1 top2) (prod_topology B D top1' top2').
Admitted.

