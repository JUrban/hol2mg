Theorem LOCALLY_FCCOVERABLE_SPACE_CHAIN : forall A:set, forall m :e metric A, forall s u c= A, forall a :e A, forall r :e R, s c= mspace A m /\ (a :e s /\ (a :e mspace A m /\ (0 < r /\ (s :/\: mcball A m (a,2 * r) c= u /\ (locally_connected_space A (subtopology A (mtopology A m) s) /\ (forall e0 :e R, 0 < e0 -> exists c c= Power A, finite c /\ ((forall w c= A, w :e c -> w c= s /\ (connected_in A (mtopology A m) w /\ (mbounded A m w /\ mdiameter A m w <= e0))) /\ forall x :e A, x :e s /\ x :e mball A m (a,2 * r) -> exists w c= A, w :e c /\ x :e w))))))) -> exists v c= A, v :e subtopology A (mtopology A m) s /\ (connected_in A (subtopology A (mtopology A m) s) v /\ (a :e v /\ (v c= u /\ fccoverable_in A m v))).
Admitted.

