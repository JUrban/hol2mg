// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem QUASI_COMPONENT_OF_EQ_EMPTY : forall A:set, forall top :e topology A, forall x :e A, (forall x0 :e A, quasi_component_of A top x x0 <-> x0 :e Empty) <-> ~ x :e topspace A top.
Admitted.

// HOL Light: Multivariate/metric.ml:26244 / QUASI_COMPONENT_OF
// Source hash: md5:78ea49a5494c54c7c02a45196d516564
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem QUASI_COMPONENT_OF : forall A:set, forall top :e topology A, forall x y :e A, quasi_component_of A top x y <-> x :e topspace A top /\ (y :e topspace A top /\ forall t c= A, x :e t /\ (closed_in A top t /\ t :e top) -> y :e t).
Admitted.

// HOL Light: Multivariate/metric.ml:26258 / QUASI_COMPONENT_OF_ALT
// Source hash: md5:1238e43485858c198f4884bf5cc67433
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem QUASI_COMPONENT_OF_ALT : forall A:set, forall top :e topology A, forall x y :e A, quasi_component_of A top x y <-> x :e topspace A top /\ (y :e topspace A top /\ ~ exists u v c= A, u :e top /\ (v :e top /\ (u :\/: v = topspace A top /\ (u :/\: v = Empty /\ (x :e u /\ y :e v))))).
Admitted.

// HOL Light: Multivariate/metric.ml:26274 / QUASI_COMPONENT_OF_SET
// Source hash: md5:e3041848005f9ba021be2066d81f6559
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem QUASI_COMPONENT_OF_SET : forall A:set, forall top :e topology A, forall x x0 :e A, quasi_component_of A top x x0 <-> (x :e topspace A top -> x0 :e {x0 :e A | forall Y :e {t :e Power A | closed_in A top t /\ (t :e top /\ x :e t)}, x0 :e Y}) /\ (~ x :e topspace A top -> x0 :e Empty).
Admitted.

// HOL Light: Multivariate/metric.ml:26286 / QUASI_COMPONENT_OF_SEPARATED
// Source hash: md5:2d401a2498d05840998a590d057384ea
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem QUASI_COMPONENT_OF_SEPARATED : forall A:set, forall top :e topology A, forall x y :e A, quasi_component_of A top x y <-> x :e topspace A top /\ (y :e topspace A top /\ ~ exists u v c= A, separated_in A top u v /\ (u :\/: v = topspace A top /\ (x :e u /\ y :e v))).
Admitted.

