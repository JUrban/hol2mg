Theorem CLOSED_MAP_RESTRICTION : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall u c= A, forall v c= B, closed_map A B (top,top') f /\ {x :e A | x :e topspace A top /\ f x :e v} = u -> closed_map A B (subtopology A top u,subtopology B top' v) f.
