Theorem EXPANSION_SET_CONTAINS : forall A:set, forall top :e topology A, forall C c= Power A, forall b c= A, Union C = topspace A top /\ b c= topspace A top -> b c= topspace A top :\: Union {c :e Power A | c :e C /\ c :/\: b = Empty}.
