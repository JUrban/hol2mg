// Source hash: md5:f6f105d407e6661d8c2fe04b5ba46aec
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATED_BETWEEN_COMPACT_CONNECTED_COMPONENT : forall A:set, A <> Empty -> forall top :e topology A, forall c t c= A, locally_compact_space A top /\ (hausdorff_space A top /\ (c :e connected_components_of A top /\ (compact_in A top c /\ (closed_in A top t /\ c :/\: t = Empty)))) -> separated_between A top c t.
Admitted.

// HOL Light: Multivariate/metric.ml:27171 / WILDER_LOCALLY_COMPACT_COMPONENT_THM
// Source hash: md5:3bf13235570754b6207bf65237be6002
// Status: transport_required (bridges: hol_typedef_topology)
Theorem WILDER_LOCALLY_COMPACT_COMPONENT_THM : forall A:set, A <> Empty -> forall top :e topology A, forall c w c= A, locally_compact_space A top /\ (hausdorff_space A top /\ (c :e connected_components_of A top /\ (compact_in A top c /\ (w :e top /\ c c= w)))) -> exists u v c= A, u :e top /\ (v :e top /\ (u :/\: v = Empty /\ (u :\/: v = topspace A top /\ (c c= u /\ u c= w)))).
Admitted.

