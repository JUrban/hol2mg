// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem PATH_CONNECTED_SPACE_IMP_PATH_COMPONENT_OF : forall A:set, forall top :e topology A, forall a b :e A, path_connected_space A top /\ (a :e topspace A top /\ b :e topspace A top) -> path_component_of A top a b.
