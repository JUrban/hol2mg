// Status: transport_required (bridges: hol_typedef_topology)
Theorem CLOSURE_OF_HULL : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, s c= topspace A top -> closure_of A top s = hull A {x :e Power A | closed_in A top x} s.
Admitted.

// HOL Light: Multivariate/metric.ml:1280 / CLOSURE_OF_MINIMAL
