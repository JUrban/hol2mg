// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem QUASI_COMPONENT_OF_CLOPEN_CASES : forall A:set, forall top :e topology A, forall c t c= A, c :e quasi_components_of A top /\ (closed_in A top t /\ t :e top) -> c c= t \/ c :/\: t = Empty.
Admitted.

