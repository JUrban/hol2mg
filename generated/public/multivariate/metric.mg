// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem PATH_COMPONENT_OF_EQ_EMPTY : forall A:set, forall top :e topology A, forall x :e A, (forall x0 :e A, path_component_of A top x x0 <-> x0 :e Empty) <-> ~ x :e topspace A top.
