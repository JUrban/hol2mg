Admitted.

// HOL Light: Multivariate/metric.ml:14801 / CONNECTED_COMPONENT_OF_EQ_OVERLAP
// Source hash: md5:f8495a99700f376b035ce4e54dfada90
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_COMPONENT_OF_EQ_OVERLAP : forall A:set, forall top :e topology A, forall x y :e A, (forall x0 :e A, connected_component_of A top x x0 <-> connected_component_of A top y x0) <-> ~ x :e topspace A top /\ ~ y :e topspace A top \/ ~ {x0 :e A | connected_component_of A top x x0} :/\: {x0 :e A | connected_component_of A top y x0} = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:14810 / CONNECTED_COMPONENT_OF_NONOVERLAP
// Source hash: md5:f05ed3555e7e4ce5a23711581260e7b3
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_COMPONENT_OF_NONOVERLAP : forall A:set, forall top :e topology A, forall x y :e A, {x0 :e A | connected_component_of A top x x0} :/\: {x0 :e A | connected_component_of A top y x0} = Empty <-> ~ x :e topspace A top \/ (~ y :e topspace A top \/ ~ forall x0 :e A, connected_component_of A top x x0 <-> connected_component_of A top y x0).
Admitted.

// HOL Light: Multivariate/metric.ml:14819 / CONNECTED_COMPONENT_OF_OVERLAP
// Source hash: md5:0448b3517794ab02351790c690cac09a
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_COMPONENT_OF_OVERLAP : forall A:set, forall top :e topology A, forall x y :e A, ~ {x0 :e A | connected_component_of A top x x0} :/\: {x0 :e A | connected_component_of A top y x0} = Empty <-> x :e topspace A top /\ (y :e topspace A top /\ forall x0 :e A, connected_component_of A top x x0 <-> connected_component_of A top y x0).
Admitted.

// HOL Light: Multivariate/metric.ml:14828 / CONNECTED_COMPONENTS_OF_DISJOINT
// Source hash: md5:96ad74aba90ab8c9be770db1e09896f8
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_COMPONENTS_OF_DISJOINT : forall A:set, A <> Empty -> forall top :e topology A, forall c c' c= A, c :e connected_components_of A top /\ c' :e connected_components_of A top -> (c :/\: c' = Empty <-> ~ c = c').
Admitted.

// HOL Light: Multivariate/metric.ml:14835 / CONNECTED_COMPONENTS_OF_OVERLAP
// Source hash: md5:189c05e51927181e10a9d6eeb98cabc4
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_COMPONENTS_OF_OVERLAP : forall A:set, A <> Empty -> forall top :e topology A, forall c c' c= A, c :e connected_components_of A top /\ c' :e connected_components_of A top -> (~ c :/\: c' = Empty <-> c = c').
Admitted.

// HOL Light: Multivariate/metric.ml:14842 / CONNECTED_IN_IFF_CONNECTED_COMPONENT_OF
// Source hash: md5:0b790ab9b47df1f6c9faa3d45a25c7ff
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_IN_IFF_CONNECTED_COMPONENT_OF : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, connected_in A top s <-> s c= topspace A top /\ forall x y :e A, x :e s /\ y :e s -> connected_component_of A (subtopology A top s) x y.
Admitted.

// HOL Light: Multivariate/metric.ml:14861 / PAIRWISE_SEPARATED_CONNECTED_COMPONENTS_OF
// Source hash: md5:35fb2b5f30023179d24c22e533591ce2
// Status: transport_required (bridges: hol_typedef_topology)
Theorem PAIRWISE_SEPARATED_CONNECTED_COMPONENTS_OF : forall A:set, A <> Empty -> forall top :e topology A, forall x y :e connected_components_of A top, x <> y -> separated_in A top x y.
Admitted.

// HOL Light: Multivariate/metric.ml:14868 / CARD_LE_CONNECTED_COMPONENTS_OF_TOPSPACE
// Source hash: md5:2cca4ad886d06144e3aedb4053efe55b
// Status: transport_required (bridges: hol_le_c_atleastp, hol_typedef_topology)
Theorem CARD_LE_CONNECTED_COMPONENTS_OF_TOPSPACE : forall A:set, A <> Empty -> forall top :e topology A, atleastp (connected_components_of A top) (topspace A top).
Admitted.

