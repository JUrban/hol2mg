// Source hash: md5:b1c56ccf0d7f2e203e0a5937cece11da
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem KC_SPACE_PROD_TOPOLOGY_GEN : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, kc_space A top /\ (kc_space B top' /\ ((forall k c= A, compact_in A top k -> hausdorff_space A (subtopology A top k)) \/ (forall l c= B, compact_in B top' l -> hausdorff_space B (subtopology B top' l)))) -> kc_space (A :*: B) (prod_topology A B top top').
Admitted.

