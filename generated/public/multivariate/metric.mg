Theorem GDELTA_IN_DESCENDING : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, s :e gdelta_in A top <-> exists c :e Power A :^: omega, (forall n :e omega, c n :e top) /\ ((forall n :e omega, c (n + 1) c= c n) /\ {x :e A | forall Y :e {c n | n :e omega, n :e omega}, x :e Y} = s).
Admitted.

// HOL Light: Multivariate/metric.ml:11086 / HOMEOMORPHIC_MAP_FSIGMANESS
// Source hash: md5:488bb2de0c2ed382b90e63ff79d22a36
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HOMEOMORPHIC_MAP_FSIGMANESS : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall top :e topology A, forall top' :e topology B, forall u c= A, homeomorphic_map A B (top,top') f /\ u c= topspace A top -> ({f x | x :e u} :e fsigma_in B top' <-> u :e fsigma_in A top).
Admitted.

