// Status: transport_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_topology)
Theorem GDELTA_HOMEOMORPHIC_SPACE_CLOSED_IN_PRODUCT : forall A K:set, A <> Empty -> K <> Empty -> forall top :e topology A, forall s :e Power A :^: K, forall k c= K, metrizable_space A top /\ (forall i :e K, i :e k -> s i :e top) -> exists t c= A :*: R :^: K, closed_in (A :*: R :^: K) (prod_topology A (R :^: K) top (product_topology R K k (fun i:set => euclideanreal))) t /\ homeomorphic_space A (A :*: R :^: K) (subtopology A top {x :e A | forall Y :e {s i | i :e K, i :e k}, x :e Y}) (subtopology (A :*: R :^: K) (prod_topology A (R :^: K) top (product_topology R K k (fun i:set => euclideanreal))) t).
Admitted.

