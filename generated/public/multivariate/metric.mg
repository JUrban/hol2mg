// Source hash: md5:a08df72ca06013998e7faa147da501c8
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem REGULAR_SPACE_PERFECT_MAP_IMAGE_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> hausdorff_space A top /\ perfect_map A B (top,top') f -> (regular_space A top <-> regular_space B top').
Admitted.

// HOL Light: Multivariate/metric.ml:16642 / locally_compact_space
// Source hash: md5:3a3e058d9d446808a2f5b98a228aebdc
// Status: transport_required (bridges: hol_typedef_topology)
Theorem locally_compact_space_thm : forall A:set, A <> Empty -> forall top :e topology A, locally_compact_space A top <-> forall x :e A, x :e topspace A top -> exists u k c= A, u :e top /\ (compact_in A top k /\ (x :e u /\ u c= k)).
Admitted.

