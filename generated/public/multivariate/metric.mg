// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem QUOTIENT_MAP_PROD_RIGHT : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e topology A, forall top1 :e topology B, forall top2 :e topology C, forall f:set -> set, (forall x :e B, f x :e C) -> locally_compact_space A top /\ ((hausdorff_space A top \/ regular_space A top) /\ quotient_map B C (top1,top2) f) -> quotient_map (A :*: B) (A :*: C) (prod_topology A B top top1,prod_topology A C top top2) (fun p:set => (p 0,f (p 1))).
Admitted.

