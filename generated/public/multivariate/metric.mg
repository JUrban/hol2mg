// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_COMPONENTS_OF_SUBSET_SING : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, connected_components_of A top c= {s} <-> connected_space A top /\ (topspace A top = Empty \/ topspace A top = s).
Admitted.

// HOL Light: Multivariate/metric.ml:14732 / CONNECTED_SPACE_IFF_COMPONENTS_SUBSET_SING
