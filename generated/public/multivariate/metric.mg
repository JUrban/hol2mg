// Source hash: md5:64be8659143395ced9ee927612f9ab2f
// Status: transport_required (bridges: hol_typedef_metric)
Theorem MBOUNDED_INTER : forall A:set, A <> Empty -> forall m :e metric A, forall s t c= A, mbounded A m s /\ mbounded A m t -> mbounded A m (s :/\: t).
Admitted.

// HOL Light: Multivariate/metric.ml:12281 / MBOUNDED_UNION
// Source hash: md5:752727eddb2ae6dc4edaa7ec280c2d48
// Status: transport_required (bridges: hol_typedef_metric)
Theorem MBOUNDED_UNION : forall A:set, A <> Empty -> forall m :e metric A, forall s t c= A, mbounded A m (s :\/: t) <-> mbounded A m s /\ mbounded A m t.
Admitted.

// HOL Light: Multivariate/metric.ml:12300 / MBOUNDED_UNIONS
// Source hash: md5:e80200331db37babee3f055f8024a391
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_metric)
Theorem MBOUNDED_UNIONS : forall A:set, A <> Empty -> forall m :e metric A, forall f c= Power A, finite f /\ (forall s c= A, s :e f -> mbounded A m s) -> mbounded A m (Union f).
Admitted.

// HOL Light: Multivariate/metric.ml:12309 / MBOUNDED_CLOSURE_OF
// Source hash: md5:f5e0d99abf088bca47f248bbe6042f9b
// Status: transport_required (bridges: hol_typedef_metric, hol_typedef_topology)
Theorem MBOUNDED_CLOSURE_OF : forall A:set, A <> Empty -> forall m :e metric A, forall s c= A, mbounded A m s -> mbounded A m (closure_of A (mtopology A m) s).
Admitted.

// HOL Light: Multivariate/metric.ml:12317 / MBOUNDED_CLOSURE_OF_EQ
// Source hash: md5:af09b95b200b0840ac33cf74fd287b5c
// Status: transport_required (bridges: hol_typedef_metric, hol_typedef_topology)
Theorem MBOUNDED_CLOSURE_OF_EQ : forall A:set, A <> Empty -> forall m :e metric A, forall s c= A, s c= mspace A m -> (mbounded A m (closure_of A (mtopology A m) s) <-> mbounded A m s).
Admitted.

