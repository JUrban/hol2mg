// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATED_BETWEEN_QUASI_COMPONENT_COMPACT : forall A:set, A <> Empty -> forall top :e topology A, forall c k c= A, c :e quasi_components_of A top /\ compact_in A top k -> (separated_between A top c k <-> c :/\: k = Empty).
Admitted.

