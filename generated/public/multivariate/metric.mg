// HOL Light: Multivariate/metric.ml:49760 / SEPARATION_BY_CLOSED_INTERMEDIATES_COUNT
// Source hash: md5:82c6276cec1129b90ce78075ff4743dc
// Status: transport_required (bridges: hol_has_size_equip, hol_num_omega, hol_typedef_topology)
Theorem SEPARATION_BY_CLOSED_INTERMEDIATES_COUNT : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, forall n :e omega, hereditarily A {x :e topology A | normal_space A x} top /\ (exists u c= Power A, equip u n /\ ((forall x y :e u, x <> y -> separated_in A top x y) /\ ((forall t c= A, t :e u -> ~ t = Empty) /\ Union u = topspace A top :\: s))) -> exists c c= A, closed_in A top c /\ (c c= s /\ forall d c= A, closed_in A top d /\ (c c= d /\ d c= s) -> exists u c= Power A, equip u n /\ ((forall x y :e u, x <> y -> separated_in A top x y) /\ ((forall t c= A, t :e u -> ~ t = Empty) /\ Union u = topspace A top :\: d))).
Admitted.

// HOL Light: Multivariate/metric.ml:49801 / SEPARATION_BY_CLOSED_INTERMEDIATES_GEN
// Source hash: md5:78237dd89895a7fb108242bb133b2d97
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATION_BY_CLOSED_INTERMEDIATES_GEN : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, hereditarily A {x :e topology A | normal_space A x} top /\ ~ connected_in A top (topspace A top :\: s) -> exists c c= A, closed_in A top c /\ (c c= s /\ forall d c= A, closed_in A top d /\ (c c= d /\ d c= s) -> ~ connected_in A top (topspace A top :\: d)).
Admitted.

// HOL Light: Multivariate/metric.ml:49826 / SEPARATION_BY_CLOSED_INTERMEDIATES_EQ_COUNT
