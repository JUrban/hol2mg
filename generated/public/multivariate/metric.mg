// Status: transport_required (bridges: hol_typedef_topology)
Theorem NORMAL_SPACE_DUAL : forall A:set, A <> Empty -> forall top :e topology A, normal_space A top <-> forall u v c= A, u :e top /\ (v :e top /\ u :\/: v = topspace A top) -> exists s t c= A, closed_in A top s /\ (closed_in A top t /\ (s c= u /\ (t c= v /\ s :\/: t = topspace A top))).
Admitted.

