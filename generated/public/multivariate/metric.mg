// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HAUSDORFF_NORMAL_SPACE_CLOSED_CONTINUOUS_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> normal_space A top /\ (closed_map A B (top,top') f /\ (continuous_map A B (top,top') f /\ ({f x | x :e topspace A top} = topspace B top' /\ t1_space B top'))) -> hausdorff_space B top'.
