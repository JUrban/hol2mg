// HOL Light: Multivariate/metric.ml:44173 / LOCALLY_FINITE_IN_HOMEOMORPHIC_IMAGE
// Source hash: md5:d97572cb672f352e7391e65ec68b052b
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem LOCALLY_FINITE_IN_HOMEOMORPHIC_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f :e B :^: A, forall g :e A :^: B, forall V c= Power A, homeomorphic_maps A B (top,top') (f,g) /\ locally_finite_in A top V -> locally_finite_in B top' {{x0 :e B | x0 :e {f x0 | x0 :e x}} | x :e V}.
Admitted.

