// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem K_SPACE_PERFECT_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> k_space A top /\ perfect_map A B (top,top') f -> k_space B top'.
