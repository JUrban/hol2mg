// Status: generalization_required (bridges: empty_case:A, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, omega_Subq_R)
Theorem MCBALL_EQ_EMPTY : forall A:set, forall m :e metric A, forall x :e A, forall r :e R, mcball A m (x,r) = Empty <-> ~ x :e mspace A m \/ r < 0.
Admitted.

