// HOL Light: Multivariate/metric.ml:11182 / borel_in_CASES
// Source hash: md5:24be53f14cbc7a8ab5d1be40731457f6
// Status: transport_required (bridges: hol_countable, hol_typedef_topology)
Theorem borel_in_CASES : forall A:set, A <> Empty -> forall top :e topology A, forall a c= A, borel_in A top a <-> a :e top \/ ((exists s c= A, a = topspace A top :\: s /\ borel_in A top s) \/ exists u c= Power A, a = Union u /\ (countable u /\ forall s c= A, s :e u -> borel_in A top s)).
Admitted.

// HOL Light: Multivariate/metric.ml:11182 / borel_in_INDUCT
// Source hash: md5:3cdf5c61f2ec6697c3bcfcc82b398d7a
// Status: transport_required (bridges: hol_countable, hol_typedef_topology)
Theorem borel_in_INDUCT : forall A:set, A <> Empty -> forall top :e topology A, forall borel_in':set -> prop, (forall s c= A, s :e top -> borel_in' s) /\ ((forall s c= A, borel_in' s -> borel_in' (topspace A top :\: s)) /\ (forall u c= Power A, countable u /\ (forall s c= A, s :e u -> borel_in' s) -> borel_in' (Union u))) -> forall a c= A, borel_in A top a -> borel_in' a.
Admitted.

// HOL Light: Multivariate/metric.ml:11182 / borel_in_RULES
// Source hash: md5:85fb7335adc289d7874e6a26c03b091e
// Status: transport_required (bridges: hol_countable, hol_typedef_topology)
Theorem borel_in_RULES : forall A:set, A <> Empty -> forall top :e topology A, (forall s c= A, s :e top -> borel_in A top s) /\ ((forall s c= A, borel_in A top s -> borel_in A top (topspace A top :\: s)) /\ forall u c= Power A, countable u /\ (forall s c= A, s :e u -> borel_in A top s) -> borel_in A top (Union u)).
Admitted.

