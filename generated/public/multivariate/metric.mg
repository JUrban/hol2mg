// Status: transport_required (bridges: hol_typedef_topology)
Theorem LOCALLY_CONNECTED_SPACE_IM_KLEINEN : forall A:set, A <> Empty -> forall top :e topology A, locally_connected_space A top <-> forall v c= A, forall x :e A, v :e top /\ x :e v -> exists u c= A, u :e top /\ (x :e u /\ (u c= v /\ forall y :e A, y :e u -> exists c c= A, connected_in A top c /\ (c c= v /\ (x :e c /\ y :e c)))).
Admitted.

