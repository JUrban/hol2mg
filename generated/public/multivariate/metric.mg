// Source hash: md5:bf9dcaa8b90fa04ae26fe49821e37d01
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HOMOTOPIC_THROUGH_CONTRACTIBLE_SPACE : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e B, g x :e C) -> forall f':set -> set, (forall x :e A, f' x :e B) -> forall g':set -> set, (forall x :e B, g' x :e C) -> forall top1 :e topology A, forall top2 :e topology B, forall top3 :e topology C, continuous_map A B (top1,top2) f /\ (continuous_map A B (top1,top2) f' /\ (continuous_map B C (top2,top3) g /\ (continuous_map B C (top2,top3) g' /\ (contractible_space B top2 /\ path_connected_space C top3)))) -> homotopic_with C A {h :e C :^: A | True} (top1,top3) (fun x:set => g (f x)) (fun x:set => g' (f' x)).
Admitted.

