Theorem LOCALLY_COMPACT_SPACE_NEIGHBOURHOOD_BASE_CLOSED_IN : forall A:set, A <> Empty -> forall top :e topology A, hausdorff_space A top \/ regular_space A top -> (locally_compact_space A top <-> neighbourhood_base_of A {c :e Power A | compact_in A top c /\ closed_in A top c} top).
