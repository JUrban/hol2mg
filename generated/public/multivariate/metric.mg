Admitted.

// HOL Light: Multivariate/metric.ml:9458 / PROPER_MAP_FROM_COMPOSITION_LEFT
// Source hash: md5:91f9d00bc4f734ae525f6310b226cd7d
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem PROPER_MAP_FROM_COMPOSITION_LEFT : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e topology A, forall top' :e topology B, forall top'' :e topology C, forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e B, g x :e C) -> proper_map A C (top,top'') (fun x:set => g (f x)) /\ (continuous_map A B (top,top') f /\ {f x | x :e topspace A top} = topspace B top') -> proper_map B C (top',top'') g.
Admitted.

// HOL Light: Multivariate/metric.ml:9474 / PROPER_MAP_FROM_COMPOSITION_RIGHT_INJ
// Source hash: md5:9bd62e17e7c3dc41cbf766c0d8f1f45e
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem PROPER_MAP_FROM_COMPOSITION_RIGHT_INJ : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e topology A, forall top' :e topology B, forall top'' :e topology C, forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e B, g x :e C) -> proper_map A C (top,top'') (fun x:set => g (f x)) /\ ({f x | x :e topspace A top} c= topspace B top' /\ (continuous_map B C (top',top'') g /\ (forall x y :e B, x :e topspace B top' /\ (y :e topspace B top' /\ g x = g y) -> x = y))) -> proper_map A B (top,top') f.
Admitted.

// HOL Light: Multivariate/metric.ml:9492 / PROPER_MAP_PROD
// Source hash: md5:99210db120622c19b88d505df98c4479
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem PROPER_MAP_PROD : forall A B C D:set, A <> Empty -> B <> Empty -> C <> Empty -> D <> Empty -> forall top1 :e topology A, forall top1' :e topology C, forall top2 :e topology B, forall top2' :e topology D, forall f:set -> set, (forall x :e A, f x :e C) -> forall g:set -> set, (forall x :e B, g x :e D) -> (proper_map (A :*: B) (C :*: D) (prod_topology A B top1 top2,prod_topology C D top1' top2') (fun p:set => (f (p 0),g (p 1))) <-> topspace (A :*: B) (prod_topology A B top1 top2) = Empty \/ proper_map A C (top1,top1') f /\ proper_map B D (top2,top2') g).
Admitted.

// HOL Light: Multivariate/metric.ml:9594 / PROPER_MAP_PAIRED
// Source hash: md5:af447d2e904c1b3f6d0abfb00bb30abd
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem PROPER_MAP_PAIRED : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e topology A, forall top1 :e topology B, forall top2 :e topology C, forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e A, g x :e C) -> hausdorff_space A top /\ (proper_map A B (top,top1) f /\ proper_map A C (top,top2) g) \/ (hausdorff_space B top1 /\ (continuous_map A B (top,top1) f /\ proper_map A C (top,top2) g) \/ hausdorff_space C top2 /\ (proper_map A B (top,top1) f /\ continuous_map A C (top,top2) g)) -> proper_map A (B :*: C) (top,prod_topology B C top1 top2) (fun x:set => (f x,g x)).
Admitted.

// HOL Light: Multivariate/metric.ml:9625 / PROPER_MAP_PAIRWISE
// Source hash: md5:76c2ae790d6afe15898858086e39081c
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem PROPER_MAP_PAIRWISE : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e topology A, forall top1 :e topology B, forall top2 :e topology C, forall f:set -> set, (forall x :e A, f x :e B :*: C) -> hausdorff_space A top /\ (proper_map A B (top,top1) (fun x:set => f x 0) /\ proper_map A C (top,top2) (fun x:set => f x 1)) \/ (hausdorff_space B top1 /\ (continuous_map A B (top,top1) (fun x:set => f x 0) /\ proper_map A C (top,top2) (fun x:set => f x 1)) \/ hausdorff_space C top2 /\ (proper_map A B (top,top1) (fun x:set => f x 0) /\ continuous_map A C (top,top2) (fun x:set => f x 1))) -> proper_map A (B :*: C) (top,prod_topology B C top1 top2) f.
Admitted.

