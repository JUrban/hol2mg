// Status: transport_required (bridges: hol_typedef_topology)
Theorem COMPACT_IN_IMP_CLOSED_IN : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, hausdorff_space A top /\ compact_in A top s -> closed_in A top s.
Admitted.

