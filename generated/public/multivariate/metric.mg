Theorem EVENTUALLY_WITHIN_IMP : forall A:set, A <> Empty -> forall net0 :e net A, forall P s c= A, eventually A P (within A net0 s) <-> eventually A {x :e A | x :e s -> x :e P} net0.
Admitted.

