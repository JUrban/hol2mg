// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HOMEOMORPHIC_MAPS_SUBTOPOLOGIES : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f :e B :^: A, forall g :e A :^: B, forall s c= A, forall t c= B, homeomorphic_maps A B (top,top') (f,g) /\ {f x | x :e topspace A top :/\: s} = topspace B top' :/\: t -> homeomorphic_maps A B (subtopology A top s,subtopology B top' t) (f,g).
