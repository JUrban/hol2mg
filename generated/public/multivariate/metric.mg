// Source hash: md5:15779ea3cd0c86aeb7363bb5a6c7e481
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem LOCALLY_CONNECTED_SPACE_PROD_TOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, locally_connected_space (A :*: B) (prod_topology A B top1 top2) <-> topspace (A :*: B) (prod_topology A B top1 top2) = Empty \/ locally_connected_space A top1 /\ locally_connected_space B top2.
Admitted.

// HOL Light: Multivariate/metric.ml:26052 / LOCALLY_CONNECTED_SPACE_PRODUCT_TOPOLOGY
// Source hash: md5:677b7bc153ae200975fe92905cb98b59
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem LOCALLY_CONNECTED_SPACE_PRODUCT_TOPOLOGY : forall A K:set, A <> Empty -> K <> Empty -> forall tops:set -> set, (forall x :e K, tops x :e topology A) -> forall k c= K, locally_connected_space (A :^: K) (product_topology A K k tops) <-> topspace (A :^: K) (product_topology A K k tops) = Empty \/ finite {i :e K | i :e k /\ ~ connected_space A (tops i)} /\ forall i :e K, i :e k -> locally_connected_space A (tops i).
Admitted.

// HOL Light: Multivariate/metric.ml:26168 / LOCALLY_CONNECTED_SPACE_SUM_TOPOLOGY
// Source hash: md5:d9c9c91824c6e15d2bb510edca924306
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem LOCALLY_CONNECTED_SPACE_SUM_TOPOLOGY : forall A K:set, A <> Empty -> K <> Empty -> forall k c= K, forall top:set -> set, (forall x :e K, top x :e topology A) -> (locally_connected_space (K :*: A) (sum_topology A K k top) <-> forall i :e K, i :e k -> locally_connected_space A (top i)).
Admitted.

// HOL Light: Multivariate/metric.ml:26205 / quasi_component_of
// Source hash: md5:3db9daa7a4b56a4b4654a1ca9957a389
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem quasi_component_of_thm : forall A:set, forall top :e topology A, forall x y :e A, quasi_component_of A top x y <-> x :e topspace A top /\ (y :e topspace A top /\ forall t c= A, closed_in A top t /\ t :e top -> (x :e t <-> y :e t)).
Admitted.

// HOL Light: Multivariate/metric.ml:26210 / quasi_components_of
// Source hash: md5:49d801e49f28921f60f6375859a91290
// Status: transport_required (bridges: hol_typedef_topology)
Theorem quasi_components_of_thm : forall A:set, A <> Empty -> forall top :e topology A, quasi_components_of A top = {{x0 :e A | quasi_component_of A top x x0} | x :e A, x :e topspace A top}.
Admitted.

