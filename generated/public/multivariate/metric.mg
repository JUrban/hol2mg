// Source hash: md5:7c4d7700164b43841d046a4c8ec83e36
// Status: transport_required (bridges: hol_typedef_topology)
Theorem INTERIOR_OF_UNION_EQ_EMPTY : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, closed_in A top s \/ closed_in A top t -> (interior_of A top (s :\/: t) = Empty <-> interior_of A top s = Empty /\ interior_of A top t = Empty).
Admitted.

