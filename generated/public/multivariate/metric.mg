// HOL Light: Multivariate/metric.ml:768 / ISTOPOLOGY_BASE_ALT
// Source hash: md5:2540e94eed613bd2b3c2411ec0f39ac6
// Status: exact_native
Theorem ISTOPOLOGY_BASE_ALT : forall A:set, A <> Empty -> forall P:set -> prop, istopology A {x :e Power A | exists u c= Power A, True /\ (forall c :e u, P c) /\ Union u = x} <-> forall s t c= A, (exists u c= Power A, True /\ (forall c :e u, P c) /\ Union u = s) /\ (exists u c= Power A, True /\ (forall c :e u, P c) /\ Union u = t) -> exists u c= Power A, True /\ (forall c :e u, P c) /\ Union u = s :/\: t.
Admitted.

// HOL Light: Multivariate/metric.ml:779 / ISTOPOLOGY_BASE_EQ
// Source hash: md5:61a9df5fa17d3bad546ddbca7d6f802e
// Status: exact_native
Theorem ISTOPOLOGY_BASE_EQ : forall A:set, A <> Empty -> forall P:set -> prop, istopology A {x :e Power A | exists u c= Power A, True /\ (forall c :e u, P c) /\ Union u = x} <-> forall s t c= A, P s /\ P t -> exists u c= Power A, True /\ (forall c :e u, P c) /\ Union u = s :/\: t.
Admitted.

// HOL Light: Multivariate/metric.ml:785 / ISTOPOLOGY_BASE
// Source hash: md5:bc6a7da54e0de8da26359274f7108d69
// Status: exact_native
Theorem ISTOPOLOGY_BASE : forall A:set, A <> Empty -> forall P:set -> prop, (forall s t c= A, P s /\ P t -> P (s :/\: t)) -> istopology A {x :e Power A | exists u c= Power A, True /\ (forall c :e u, P c) /\ Union u = x}.
Admitted.

// HOL Light: Multivariate/metric.ml:792 / MINIMAL_TOPOLOGY_BASE
// Source hash: md5:1e3dae12e2addfb692c6ee0471725733
// Status: generalization_required (bridges: hol_typedef_topology)
Theorem MINIMAL_TOPOLOGY_BASE : forall A:set, A <> Empty -> forall top :e topology A, forall P:set -> prop, (forall s c= A, P s -> s :e top) /\ (forall s t c= A, P s /\ P t -> P (s :/\: t)) -> forall s c= A, s :e {x :e Power A | exists u c= Power A, True /\ (forall c :e u, P c) /\ Union u = x} -> s :e top.
Admitted.

// HOL Light: Multivariate/metric.ml:802 / OPEN_IN_TOPOLOGY_BASE_UNIQUE
// Source hash: md5:099221e3468b02ca651dfbf214043456
// Status: transport_required (bridges: hol_typedef_topology)
Theorem OPEN_IN_TOPOLOGY_BASE_UNIQUE : forall A:set, A <> Empty -> forall top :e topology A, forall B c= Power A, (forall x c= A, x :e top <-> exists u c= Power A, True /\ (forall x0 :e u, x0 :e B) /\ Union u = x) <-> (forall v c= A, v :e B -> v :e top) /\ forall u c= A, forall x :e A, u :e top /\ x :e u -> exists v c= A, v :e B /\ (x :e v /\ v c= u).
Admitted.

// HOL Light: Multivariate/metric.ml:821 / TOPOLOGY_BASE_UNIQUE
// Source hash: md5:ba6c0c0a771386109f1f31c8ad8c3a0b
// Status: generalization_required (bridges: hol_typedef_topology)
Theorem TOPOLOGY_BASE_UNIQUE : forall A:set, A <> Empty -> forall top :e topology A, forall P:set -> prop, (forall s c= A, P s -> s :e top) /\ (forall u c= A, forall x :e A, u :e top /\ x :e u -> exists b c= A, P b /\ (x :e b /\ b c= u)) -> {x :e Power A | exists u c= Power A, True /\ (forall c :e u, P c) /\ Union u = x} = top.
Admitted.

// HOL Light: Multivariate/metric.ml:830 / TOPOLOGY_BASES_EQ
// Source hash: md5:949ef947bc6ad03fa64255030ebc5c0b
// Status: generalization_required (bridges: hol_typedef_topology)
Theorem TOPOLOGY_BASES_EQ : forall A:set, A <> Empty -> forall P Q:set -> prop, (forall u c= A, forall x :e A, P u /\ x :e u -> exists v c= A, Q v /\ (x :e v /\ v c= u)) /\ (forall v c= A, forall x :e A, Q v /\ x :e v -> exists u c= A, P u /\ (x :e u /\ u c= v)) -> {x :e Power A | exists u c= Power A, True /\ (forall c :e u, P c) /\ Union u = x} = {x :e Power A | exists u c= Power A, True /\ (forall c :e u, Q c) /\ Union u = x}.
Admitted.

// HOL Light: Multivariate/metric.ml:843 / ISTOPOLOGY_SUBBASE
// Source hash: md5:e46900c906bc2623d6b1b6c311eead98
// Status: transport_required (bridges: hol_finite_finite)
Theorem ISTOPOLOGY_SUBBASE : forall A:set, A <> Empty -> forall P:set -> prop, forall s c= A, istopology A {x :e Power A | exists u c= Power A, True /\ (forall x0 :e u, x0 :e relative_to A {x01 :e Power A | exists u c= Power A, finite u /\ (forall c :e u, P c) /\ {x :e A | forall Y :e u, x :e Y} = x01} s) /\ Union u = x}.
Admitted.

// HOL Light: Multivariate/metric.ml:850 / OPEN_IN_SUBBASE
// Source hash: md5:57dd87f24f10c473fab6bcc2a5435c92
// Status: generalization_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem OPEN_IN_SUBBASE : forall A:set, A <> Empty -> forall B:set -> prop, forall u s c= A, s :e {x :e Power A | exists u0 c= Power A, True /\ (forall x0 :e u0, x0 :e relative_to A {x01 :e Power A | exists u c= Power A, finite u /\ (forall c :e u, B c) /\ {x :e A | forall Y :e u, x :e Y} = x01} u) /\ Union u0 = x} <-> exists u0 c= Power A, True /\ (forall x :e u0, x :e relative_to A {x1 :e Power A | exists u c= Power A, finite u /\ (forall c :e u, B c) /\ {x0 :e A | forall Y :e u, x0 :e Y} = x1} u) /\ Union u0 = s.
Admitted.

// HOL Light: Multivariate/metric.ml:859 / TOPSPACE_SUBBASE
// Source hash: md5:7c4601562e552edba00d97614d9a1586
// Status: generalization_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem TOPSPACE_SUBBASE : forall A:set, A <> Empty -> forall B:set -> prop, forall u c= A, topspace A {x :e Power A | exists u0 c= Power A, True /\ (forall x0 :e u0, x0 :e relative_to A {x01 :e Power A | exists u c= Power A, finite u /\ (forall c :e u, B c) /\ {x :e A | forall Y :e u, x :e Y} = x01} u) /\ Union u0 = x} = u.
Admitted.

// HOL Light: Multivariate/metric.ml:877 / MINIMAL_TOPOLOGY_SUBBASE
// Source hash: md5:edc7c195144e418b48988997303555ef
// Status: generalization_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem MINIMAL_TOPOLOGY_SUBBASE : forall A:set, A <> Empty -> forall top :e topology A, forall u c= A, forall P:set -> prop, (forall s c= A, P s -> s :e top) /\ u :e top -> forall s c= A, s :e {x :e Power A | exists u0 c= Power A, True /\ (forall x0 :e u0, x0 :e relative_to A {x01 :e Power A | exists u c= Power A, finite u /\ (forall c :e u, P c) /\ {x :e A | forall Y :e u, x :e Y} = x01} u) /\ Union u0 = x} -> s :e top.
Admitted.

// HOL Light: Multivariate/metric.ml:896 / ISTOPOLOGY_SUBBASE_UNIV
// Source hash: md5:34fd6d44fd89a7b295492429c59eb1c4
// Status: transport_required (bridges: hol_finite_finite)
Theorem ISTOPOLOGY_SUBBASE_UNIV : forall A:set, A <> Empty -> forall P:set -> prop, istopology A {x :e Power A | exists u c= Power A, True /\ (forall x0 :e u, exists u c= Power A, finite u /\ (forall c :e u, P c) /\ {x :e A | forall Y :e u, x :e Y} = x0) /\ Union u = x}.
Admitted.

// HOL Light: Multivariate/metric.ml:906 / hereditarily
// Source hash: md5:e3c69439edc7232dfe9e66001e0786a9
// Status: transport_required (bridges: hol_typedef_topology)
Theorem hereditarily_thm : forall A:set, A <> Empty -> forall P c= topology A, forall top :e topology A, hereditarily A P top <-> forall s c= A, s c= topspace A top -> subtopology A top s :e P.
Admitted.

// HOL Light: Multivariate/metric.ml:910 / HEREDITARILY
// Source hash: md5:48a501986747cc6e7ce8be14f709a378
// Status: transport_required (bridges: hol_typedef_topology)
Theorem HEREDITARILY : forall A:set, A <> Empty -> forall P c= topology A, forall top :e topology A, hereditarily A P top <-> forall s c= A, subtopology A top s :e P.
Admitted.

// HOL Light: Multivariate/metric.ml:918 / HEREDITARILY_MONO
// Source hash: md5:771f46d2caf0c2c331bb437e429b9350
// Status: transport_required (bridges: hol_typedef_topology)
Theorem HEREDITARILY_MONO : forall A:set, A <> Empty -> forall t :e topology A, forall P c= topology A, forall Q:set -> prop, (forall top :e topology A, top :e P -> Q t) -> forall top :e topology A, hereditarily A P top -> hereditarily A P top.
Admitted.

// HOL Light: Multivariate/metric.ml:924 / HEREDITARILY_INC
// Source hash: md5:7923e8018caace42f88d388ff527c6b1
// Status: transport_required (bridges: hol_typedef_topology)
Theorem HEREDITARILY_INC : forall A:set, A <> Empty -> forall top :e topology A, forall P c= topology A, hereditarily A P top -> top :e P.
Admitted.

// HOL Light: Multivariate/metric.ml:928 / HEREDITARILY_SUBTOPOLOGY
// Source hash: md5:02839f861eafb2fbedc992ce509d3d93
// Status: transport_required (bridges: hol_typedef_topology)
Theorem HEREDITARILY_SUBTOPOLOGY : forall A:set, A <> Empty -> forall P c= topology A, forall top :e topology A, forall s c= A, hereditarily A P top -> hereditarily A P (subtopology A top s).
Admitted.

// HOL Light: Multivariate/metric.ml:940 / derived_set_of
// Source hash: md5:08015ecb0493a7c515b4d7a34854be71
// Status: transport_required (bridges: hol_typedef_topology)
Theorem derived_set_of_thm : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, derived_set_of A top s = {x :e A | x :e topspace A top /\ forall t c= A, x :e t /\ t :e top -> exists y :e A, ~ y = x /\ (y :e s /\ y :e t)}.
Admitted.

// HOL Light: Multivariate/metric.ml:946 / DERIVED_SET_OF_RESTRICT
// Source hash: md5:414c15ce4c0df9f3ccda32a39f4fd99b
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem DERIVED_SET_OF_RESTRICT : forall A:set, forall top :e topology A, forall s c= A, derived_set_of A top s = derived_set_of A top (topspace A top :/\: s).
Admitted.

// HOL Light: Multivariate/metric.ml:952 / IN_DERIVED_SET_OF
// Source hash: md5:b315b129e8ffaeaf687b250eb3221afb
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem IN_DERIVED_SET_OF : forall A:set, forall top :e topology A, forall s c= A, forall x :e A, x :e derived_set_of A top s <-> x :e topspace A top /\ forall t c= A, x :e t /\ t :e top -> exists y :e A, ~ y = x /\ (y :e s /\ y :e t).
Admitted.

// HOL Light: Multivariate/metric.ml:959 / DERIVED_SET_OF_SUBSET_TOPSPACE
// Source hash: md5:0c9295a2230f7cb5679095a518f55363
// Status: transport_required (bridges: hol_typedef_topology)
Theorem DERIVED_SET_OF_SUBSET_TOPSPACE : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, derived_set_of A top s c= topspace A top.
Admitted.

// HOL Light: Multivariate/metric.ml:963 / DERIVED_SET_OF_SUBTOPOLOGY
// Source hash: md5:bc6c274db4456a7703b5ed8c990ee611
// Status: transport_required (bridges: hol_typedef_topology)
Theorem DERIVED_SET_OF_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e topology A, forall u s c= A, derived_set_of A (subtopology A top u) s = u :/\: derived_set_of A top (u :/\: s).
Admitted.

// HOL Light: Multivariate/metric.ml:975 / DERIVED_SET_OF_SUBSET_SUBTOPOLOGY
// Source hash: md5:e4d7f060d6b089b8ae77fcab633e0bc0
// Status: transport_required (bridges: hol_typedef_topology)
Theorem DERIVED_SET_OF_SUBSET_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, derived_set_of A (subtopology A top s) t c= s.
Admitted.

// HOL Light: Multivariate/metric.ml:979 / DERIVED_SET_OF_EMPTY
// Source hash: md5:dd6f9a77e55bfc695dbf58e25be5a788
// Status: transport_required (bridges: hol_typedef_topology)
Theorem DERIVED_SET_OF_EMPTY : forall A:set, A <> Empty -> forall top :e topology A, derived_set_of A top Empty = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:984 / DERIVED_SET_OF_MONO
// Source hash: md5:1ab48bcc4537ef5add64e6829b52d08d
// Status: transport_required (bridges: hol_typedef_topology)
Theorem DERIVED_SET_OF_MONO : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, s c= t -> derived_set_of A top s c= derived_set_of A top t.
Admitted.

// HOL Light: Multivariate/metric.ml:989 / DERIVED_SET_OF_UNION
// Source hash: md5:10222c231cd5cbbcb4b2a76f9e6ec3eb
// Status: transport_required (bridges: hol_typedef_topology)
Theorem DERIVED_SET_OF_UNION : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, derived_set_of A top (s :\/: t) = derived_set_of A top s :\/: derived_set_of A top t.
Admitted.

// HOL Light: Multivariate/metric.ml:1006 / DERIVED_SET_OF_UNIONS
// Source hash: md5:343df38757045f48af2eac8192c1a414
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem DERIVED_SET_OF_UNIONS : forall A:set, A <> Empty -> forall top :e topology A, forall f c= Power A, finite f -> derived_set_of A top (Union f) = Union {derived_set_of A top s | s :e Power A, s :e f}.
Admitted.

// HOL Light: Multivariate/metric.ml:1015 / DERIVED_SET_OF_TOPSPACE
// Source hash: md5:1c5f2ef375cf8422bcde051b4c83eae1
// Status: transport_required (bridges: hol_typedef_topology)
Theorem DERIVED_SET_OF_TOPSPACE : forall A:set, A <> Empty -> forall top :e topology A, derived_set_of A top (topspace A top) = {x :e A | x :e topspace A top /\ ~ {x} :e top}.
Admitted.

// HOL Light: Multivariate/metric.ml:1027 / DISCRETE_TOPOLOGY_UNIQUE_DERIVED_SET
// Source hash: md5:3141c235b849417a6006fe8a6b55dcfb
// Status: transport_required (bridges: hol_typedef_topology)
Theorem DISCRETE_TOPOLOGY_UNIQUE_DERIVED_SET : forall A:set, A <> Empty -> forall top :e topology A, forall u c= A, discrete_topology A u = top <-> topspace A top = u /\ derived_set_of A top u = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:1035 / SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_EQ
// Source hash: md5:d81ee60d46777414c190d7ef4c3ac957
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_EQ : forall A:set, A <> Empty -> forall top :e topology A, forall u c= A, subtopology A top u = discrete_topology A u <-> u c= topspace A top /\ u :/\: derived_set_of A top u = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:1044 / SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY
// Source hash: md5:06acde30894e95fdfb4c2664b5564781
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, s c= topspace A top /\ s :/\: derived_set_of A top s = Empty -> subtopology A top s = discrete_topology A s.
Admitted.

// HOL Light: Multivariate/metric.ml:1050 / SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_GEN
// Source hash: md5:564110dd1f81c734cf580b9be5289afa
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_GEN : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, s :/\: derived_set_of A top s = Empty -> subtopology A top s = discrete_topology A (topspace A top :/\: s).
Admitted.

