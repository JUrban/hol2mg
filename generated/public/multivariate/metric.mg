// Status: transport_required (bridges: hol_typedef_net)
Theorem EVENTUALLY_IMP_WITHIN : forall A:set, A <> Empty -> forall net0 :e net A, forall P s c= A, eventually A P net0 -> eventually A P (within A net0 s).
Admitted.

