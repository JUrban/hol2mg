// HOL Light: Multivariate/metric.ml:27574 / K_SPACE_SUBTOPOLOGY
// Source hash: md5:1bc883cdd631b7c0a50934d4e2c03fe5
// Status: transport_required (bridges: hol_typedef_topology)
Theorem K_SPACE_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, (forall t c= A, t c= topspace A top /\ (t c= s /\ (forall k c= A, compact_in A top k -> closed_in A (subtopology A top (k :/\: s)) (k :/\: t))) -> closed_in A (subtopology A top s) t) /\ (forall k c= A, compact_in A top k -> k_space A (subtopology A top (k :/\: s))) -> k_space A (subtopology A top s).
Admitted.

// HOL Light: Multivariate/metric.ml:27599 / K_SPACE_SUBTOPOLOGY_OPEN
// Source hash: md5:7215b86c7df902b37e70ad60a48aa6f6
// Status: transport_required (bridges: hol_typedef_topology)
Theorem K_SPACE_SUBTOPOLOGY_OPEN : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, (forall t c= A, t c= topspace A top /\ (t c= s /\ (forall k c= A, compact_in A top k -> k :/\: t :e subtopology A top (k :/\: s))) -> t :e subtopology A top s) /\ (forall k c= A, compact_in A top k -> k_space A (subtopology A top (k :/\: s))) -> k_space A (subtopology A top s).
Admitted.

