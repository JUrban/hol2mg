// Source hash: md5:737e8c7ed3c91145b560f0acbb55d6e0
// Status: transport_required (bridges: hol_typedef_topology)
Theorem METRIZABLE_IMP_T1_SPACE : forall A:set, A <> Empty -> forall top :e topology A, metrizable_space A top -> t1_space A top.
Admitted.

