// Status: transport_required (bridges: hol_typedef_topology)
Theorem KC_SPACE_EXPANSIVE : forall A:set, A <> Empty -> forall top top' :e topology A, topspace A top' = topspace A top /\ (forall u c= A, u :e top -> u :e top') -> kc_space A top -> kc_space A top'.
Admitted.

