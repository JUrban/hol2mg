Theorem COMPACT_KC_EQ_MAXIMAL_COMPACT_SPACE : forall A:set, A <> Empty -> forall top :e topology A, compact_space A top -> (kc_space A top <-> forall top' :e topology A, topspace A top' = topspace A top /\ ((forall s c= A, s :e top -> s :e top') /\ compact_space A top') -> top' = top).
Admitted.

