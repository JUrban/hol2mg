// HOL Light: Multivariate/metric.ml:45192 / LOCALLY_CONSTANT_REFINEMENT
// Source hash: md5:d91ce0a294ff77bcb7a66f6571fd7b25
// Status: transport_required (bridges: hol_num_omega, hol_real_R, hol_typedef_metric, hol_typedef_topology, omega_Subq_R)
Theorem LOCALLY_CONSTANT_REFINEMENT : forall A:set, A <> Empty -> forall m :e metric A, forall h :e Power A :^: Power omega, forall e0 :e R, compact_space A (mtopology A m) /\ (0 < e0 /\ ((forall x c= omega, closed_in A (mtopology A m) (h x)) /\ ((forall x c= omega, ~ h x = Empty) /\ ((forall x c= omega, h x c= mspace A m) /\ ((forall x c= omega, exists u c= Power omega, u :e cantor_space /\ (x :e u /\ forall y c= omega, y :e u -> h y = h x)) /\ (forall a :e A, a :e mspace A m -> exists x c= omega, a :e h x)))))) -> exists h' :e Power A :^: Power omega, (forall x c= omega, closed_in A (mtopology A m) (h' x)) /\ ((forall x c= omega, ~ h' x = Empty) /\ ((forall x c= omega, h' x c= mspace A m) /\ ((forall x c= omega, mdiameter A m (h' x) < e0) /\ ((forall x c= omega, h' x c= h x) /\ ((forall x c= omega, exists u c= Power omega, u :e cantor_space /\ (x :e u /\ forall y c= omega, y :e u -> h' y = h' x)) /\ forall a :e A, a :e mspace A m -> exists x c= omega, a :e h' x))))).
Admitted.

// HOL Light: Multivariate/metric.ml:45783 / ALEXANDROFF_HAUSDORFF
