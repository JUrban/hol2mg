// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem COMPACT_IMP_PERFECT_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> k_space B top' /\ (kc_space B top' /\ (continuous_map A B (top,top') f /\ ({f x | x :e topspace A top} = topspace B top' /\ (forall k c= B, compact_in B top' k -> compact_in A top {x :e A | x :e topspace A top /\ f x :e k})))) -> perfect_map A B (top,top') f.
