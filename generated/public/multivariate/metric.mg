Theorem path_in_thm : forall A:set, A <> Empty -> forall top :e topology A, forall g:set -> set, (forall x :e R, g x :e A) -> (path_in A top g <-> continuous_map R A (subtopology R euclideanreal (closed_real_interval (seq_cons (0,1) seq_nil)),top) g).
Admitted.

