// Source hash: md5:6f5dca52f0495192489364eb8b5249fb
// Status: transport_required (bridges: hol_typedef_topology)
Theorem HOMEOMORPHIC_LOCALLY_COMPACT_SPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, homeomorphic_space A B top top' -> (locally_compact_space A top <-> locally_compact_space B top').
Admitted.

// HOL Light: Multivariate/metric.ml:16684 / LOCALLY_COMPACT_SPACE_RETRACTION_MAP_IMAGE
// Source hash: md5:8103e89f0f1b8e3c3e131f66b1437c39
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem LOCALLY_COMPACT_SPACE_RETRACTION_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall r:set -> set, (forall x :e A, r x :e B) -> retraction_map A B (top,top') r /\ locally_compact_space A top -> locally_compact_space B top'.
Admitted.

