// Source hash: md5:41d3b857b0da742d85bd517cefe79034
// Status: transport_required (bridges: hol_typedef_metric, hol_typedef_topology)
Theorem FORALL_METRIZABLE_SPACE : forall A:set, A <> Empty -> forall P:set -> set -> prop, (forall top :e topology A, metrizable_space A top -> P top (topspace A top)) <-> forall m :e metric A, P (mtopology A m) (mspace A m).
Admitted.

// HOL Light: Multivariate/metric.ml:12698 / EXISTS_METRIZABLE_SPACE
// Source hash: md5:ea075b71bdd244c3eb08a9432b6911ff
// Status: transport_required (bridges: hol_typedef_metric, hol_typedef_topology)
Theorem EXISTS_METRIZABLE_SPACE : forall A:set, A <> Empty -> forall P:set -> set -> prop, (exists top :e topology A, metrizable_space A top /\ P top (topspace A top)) <-> exists m :e metric A, P (mtopology A m) (mspace A m).
Admitted.

// HOL Light: Multivariate/metric.ml:12704 / METRIZABLE_SPACE_DISCRETE_TOPOLOGY
// Source hash: md5:9eb438e13b12380f79c975e193e8aeef
// Status: transport_required (bridges: hol_typedef_topology)
Theorem METRIZABLE_SPACE_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u c= A, metrizable_space A (discrete_topology A u).
Admitted.

// HOL Light: Multivariate/metric.ml:12708 / METRIZABLE_SPACE_SUBTOPOLOGY
// Source hash: md5:4854d3109922b167d967975660c73cc1
// Status: transport_required (bridges: hol_typedef_topology)
Theorem METRIZABLE_SPACE_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, metrizable_space A top -> metrizable_space A (subtopology A top s).
Admitted.

// HOL Light: Multivariate/metric.ml:12713 / HOMEOMORPHIC_METRIZABLE_SPACE
// Source hash: md5:7ef145ea858b30e46a0a3f241c7bd704
// Status: transport_required (bridges: hol_typedef_topology)
Theorem HOMEOMORPHIC_METRIZABLE_SPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, homeomorphic_space A B top top' -> (metrizable_space A top <-> metrizable_space B top').
Admitted.

// HOL Light: Multivariate/metric.ml:12759 / METRIZABLE_SPACE_RETRACTION_MAP_IMAGE
// Source hash: md5:b8d400da2edcf2d199ce62a0205a1ee2
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem METRIZABLE_SPACE_RETRACTION_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall r:set -> set, (forall x :e A, r x :e B) -> retraction_map A B (top,top') r /\ metrizable_space A top -> metrizable_space B top'.
Admitted.

