// Status: generalization_required (bridges: empty_case:B, hol_finite_finite, hol_typedef_net)
Theorem FORALL_EVENTUALLY : forall A B:set, A <> Empty -> forall net0 :e net A, forall p :e Power A :^: B, forall s c= B, finite s /\ ~ s = Empty -> ((forall a :e B, a :e s -> eventually A (p a) net0) <-> eventually A {x :e A | forall a :e B, a :e s -> x :e p a} net0).
Admitted.

