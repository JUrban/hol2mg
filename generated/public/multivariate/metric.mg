// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem QUASI_COMPONENT_OF_MONO : forall A:set, forall top :e topology A, forall s t c= A, forall x y :e A, quasi_component_of A (subtopology A top s) x y /\ s c= t -> quasi_component_of A (subtopology A top t) x y.
