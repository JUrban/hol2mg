// Source hash: md5:db1455b2d5ddcf1f4c2d613fc299baea
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARABLE_SPACE_OPEN_SUBSET : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, separable_space A top /\ s :e top -> separable_space A (subtopology A top s).
Admitted.

// HOL Light: Multivariate/metric.ml:10395 / SEPARABLE_SPACE_CONTINUOUS_MAP_IMAGE
// Source hash: md5:c96b89c2b377484fb55fd4068a078da3
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem SEPARABLE_SPACE_CONTINUOUS_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> separable_space A top /\ (continuous_map A B (top,top') f /\ {f x | x :e topspace A top} = topspace B top') -> separable_space B top'.
Admitted.

// HOL Light: Multivariate/metric.ml:10409 / SEPARABLE_SPACE_QUOTIENT_MAP_IMAGE
// Source hash: md5:a16c0e9b6bea6445f8cf2ce24d05f804
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem SEPARABLE_SPACE_QUOTIENT_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall q:set -> set, (forall x :e A, q x :e B) -> quotient_map A B (top,top') q /\ separable_space A top -> separable_space B top'.
Admitted.

// HOL Light: Multivariate/metric.ml:10416 / SEPARABLE_SPACE_RETRACTION_MAP_IMAGE
// Source hash: md5:69e0e5e4116e866d43f94d299ba04ea0
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem SEPARABLE_SPACE_RETRACTION_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall r:set -> set, (forall x :e A, r x :e B) -> retraction_map A B (top,top') r /\ separable_space A top -> separable_space B top'.
Admitted.

// HOL Light: Multivariate/metric.ml:10423 / HOMEOMORPHIC_SEPARABLE_SPACE
// Source hash: md5:0cb2dd650d20dc301804162cf9790369
// Status: transport_required (bridges: hol_typedef_topology)
Theorem HOMEOMORPHIC_SEPARABLE_SPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, homeomorphic_space A B top top' -> (separable_space A top <-> separable_space B top').
Admitted.

// HOL Light: Multivariate/metric.ml:10431 / SEPARABLE_SPACE_DISCRETE_TOPOLOGY
// Source hash: md5:b7af3932dc4a15881531df196c6428af
// Status: transport_required (bridges: hol_countable, hol_typedef_topology)
Theorem SEPARABLE_SPACE_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u c= A, separable_space A (discrete_topology A u) <-> countable u.
Admitted.

// HOL Light: Multivariate/metric.ml:10438 / SECOND_COUNTABLE_IMP_SEPARABLE_SPACE
// Source hash: md5:aa14a32f5dea1c21a67558acb14ef904
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SECOND_COUNTABLE_IMP_SEPARABLE_SPACE : forall A:set, A <> Empty -> forall top :e topology A, second_countable A top -> separable_space A top.
Admitted.

// HOL Light: Multivariate/metric.ml:10455 / SECOND_COUNTABLE_IMP_LINDELOF_SPACE
