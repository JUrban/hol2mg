Theorem NULLHOMOTOPIC_THROUGH_CONTRACTIBLE_SPACE : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e B, g x :e C) -> forall top1 :e topology A, forall top2 :e topology B, forall top3 :e topology C, continuous_map A B (top1,top2) f /\ (continuous_map B C (top2,top3) g /\ contractible_space B top2) -> exists c :e C, homotopic_with C A {h :e C :^: A | True} (top1,top3) (fun x:set => g (f x)) (fun x:set => c).
