// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_QUASI_COMPONENT_OF : forall A:set, A <> Empty -> forall top :e topology A, forall c c= A, c :e quasi_components_of A top -> (c :e connected_components_of A top <-> connected_in A top c).
