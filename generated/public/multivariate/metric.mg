// Source hash: md5:6f3770b9b9b5d1252d325899b1e579e5
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem RETRACTION_MAPS_COMPOSE : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top1 :e topology A, forall top2 :e topology B, forall top3 :e topology C, forall f :e B :^: A, forall g :e C :^: B, forall f' :e A :^: B, forall g' :e B :^: C, retraction_maps A B (top1,top2) (f,f') /\ retraction_maps B C (top2,top3) (g,g') -> retraction_maps A C (top1,top3) (fun x :e A => g (f x),fun x :e C => f' (g' x)).
Admitted.

// HOL Light: Multivariate/metric.ml:6090 / RETRACTION_MAP_COMPOSE
// Source hash: md5:a6ed359b1e1f374bfd2a36454b08684d
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem RETRACTION_MAP_COMPOSE : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top1 :e topology A, forall top2 :e topology B, forall top3 :e topology C, forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e B, g x :e C) -> retraction_map A B (top1,top2) f /\ retraction_map B C (top2,top3) g -> retraction_map A C (top1,top3) (fun x:set => g (f x)).
Admitted.

// HOL Light: Multivariate/metric.ml:6097 / SECTION_MAP_COMPOSE
// Source hash: md5:c539fcbab23c326cba27988f407b236f
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem SECTION_MAP_COMPOSE : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top1 :e topology A, forall top2 :e topology B, forall top3 :e topology C, forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e B, g x :e C) -> section_map A B (top1,top2) f /\ section_map B C (top2,top3) g -> section_map A C (top1,top3) (fun x:set => g (f x)).
Admitted.

// HOL Light: Multivariate/metric.ml:6104 / SURJECTIVE_SECTION_EQ_HOMEOMORPHIC_MAP
// Source hash: md5:4da8188e2658c03226bcd8b94e3b88a1
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem SURJECTIVE_SECTION_EQ_HOMEOMORPHIC_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> (section_map A B (top,top') f /\ {f x | x :e topspace A top} = topspace B top' <-> homeomorphic_map A B (top,top') f).
Admitted.

// HOL Light: Multivariate/metric.ml:6111 / SURJECTIVE_RETRACTION_OR_SECTION_MAP
// Source hash: md5:2343c003d46c6e97e26cfd6c0e0cbb45
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem SURJECTIVE_RETRACTION_OR_SECTION_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> {f x | x :e topspace A top} = topspace B top' -> (retraction_map A B (top,top') f \/ section_map A B (top,top') f <-> retraction_map A B (top,top') f).
Admitted.

// HOL Light: Multivariate/metric.ml:6119 / RETRACTION_IMP_SURJECTIVE_MAP
// Source hash: md5:a38dc1d1d4d2286946803590ddc1b1f1
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem RETRACTION_IMP_SURJECTIVE_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> retraction_map A B (top,top') f -> {f x | x :e topspace A top} = topspace B top'.
Admitted.

// HOL Light: Multivariate/metric.ml:6125 / SECTION_IMP_INJECTIVE_MAP
// Source hash: md5:6137de208ab21ec43898b67d29a6657a
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_typedef_topology)
Theorem SECTION_IMP_INJECTIVE_MAP : forall A B:set, B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> section_map A B (top,top') f -> forall x y :e A, x :e topspace A top /\ y :e topspace A top -> (f x = f y <-> x = y).
Admitted.

// HOL Light: Multivariate/metric.ml:6132 / RETRACTION_MAPS_TO_RETRACT_MAPS
// Source hash: md5:6c1bf2ae3abe3ff649b4958d67d54fc4
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem RETRACTION_MAPS_TO_RETRACT_MAPS : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall r :e B :^: A, forall s :e A :^: B, retraction_maps A B (top,top') (r,s) -> retraction_maps A A (top,subtopology A top {s x | x :e topspace B top'}) (fun x :e A => s (r x),fun x :e A => x).
Admitted.

// HOL Light: Multivariate/metric.ml:6143 / EMBEDDING_EQ_SECTION_MAP
// Source hash: md5:fa972486e17928f14aa2bdfff27a044f
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem EMBEDDING_EQ_SECTION_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> (embedding_map A B (top,top') f <-> section_map A B (top,subtopology B top' {f x | x :e topspace A top}) f).
Admitted.

// HOL Light: Multivariate/metric.ml:6152 / RETRACTION_MAP_INTO_SUBTOPOLOGY
// Source hash: md5:796be8ef7ff9368346444255a1cb5b91
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem RETRACTION_MAP_INTO_SUBTOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall t c= B, forall r:set -> set, (forall x :e A, r x :e B) -> retraction_map A B (top,top') r /\ {r x | x :e topspace A top} c= t -> retraction_map A B (top,subtopology B top' t) r.
Admitted.

// HOL Light: Multivariate/metric.ml:6161 / RETRACTION_MAPS_SUBTOPOLOGIES
// Source hash: md5:16f108fa1c3670c9cc1946d2ed83e80b
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem RETRACTION_MAPS_SUBTOPOLOGIES : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall s c= A, forall t c= B, forall r :e B :^: A, forall r' :e A :^: B, retraction_maps A B (top,top') (r,r') /\ ({r x | x :e s} c= t /\ {r' x | x :e t} c= s) -> retraction_maps A B (subtopology A top s,subtopology B top' t) (r,r').
Admitted.

// HOL Light: Multivariate/metric.ml:6172 / RETRACTION_MAP_FST
// Source hash: md5:1fa9527874582ee97cb3bbde9cfc558b
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem RETRACTION_MAP_FST : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, retraction_map (A :*: B) A (prod_topology A B top1 top2,top1) (fun x:set => x 0) <-> topspace B top2 = Empty -> topspace A top1 = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:6190 / RETRACTION_MAP_SND
// Source hash: md5:63de5bcf6635c263ab28ad235c25af1e
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem RETRACTION_MAP_SND : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, retraction_map (A :*: B) B (prod_topology A B top1 top2,top2) (fun x:set => x 1) <-> topspace A top1 = Empty -> topspace B top2 = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:6208 / RETRACTION_MAP_PRODUCT_PROJECTION
// Source hash: md5:da2f27e2cfeecbf30a3949b4f3ac55ba
// Status: generalization_required (bridges: empty_case:K, hol_prod_setprod, hol_typedef_topology)
Theorem RETRACTION_MAP_PRODUCT_PROJECTION : forall A K:set, A <> Empty -> forall k c= K, forall tops:set -> set, (forall x :e K, tops x :e topology A) -> forall i :e K, i :e k -> (retraction_map (A :^: K) A (product_topology A K k tops,tops i) (fun x:set => x i) <-> topspace (A :^: K) (product_topology A K k tops) = Empty -> topspace A (tops i) = Empty).
Admitted.

// HOL Light: Multivariate/metric.ml:6234 / DISCRETE_SPACE_RETRACTION_MAP_IMAGE
// Source hash: md5:1df94d9ebeedffc459c6569d390ce794
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem DISCRETE_SPACE_RETRACTION_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall r:set -> set, (forall x :e A, r x :e B) -> retraction_map A B (top,top') r /\ discrete_space A top -> discrete_space B top'.
Admitted.

// HOL Light: Multivariate/metric.ml:6240 / HOMEOMORPHIC_DISCRETE_SPACE
// Source hash: md5:adc87dd6e44dc8e09ba0a7a031cc06ee
// Status: transport_required (bridges: hol_typedef_topology)
Theorem HOMEOMORPHIC_DISCRETE_SPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, homeomorphic_space A B top top' -> (discrete_space A top <-> discrete_space B top').
Admitted.

// HOL Light: Multivariate/metric.ml:6248 / HOMEOMORPHIC_DISCRETE_SPACES
// Source hash: md5:6b2d96ebf1ab9370b36ccd7050ceaf68
// Status: transport_required (bridges: hol_eq_c_equip, hol_typedef_topology)
Theorem HOMEOMORPHIC_DISCRETE_SPACES : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, discrete_space A top /\ discrete_space B top' -> (homeomorphic_space A B top top' <-> equip (topspace A top) (topspace B top')).
Admitted.

// HOL Light: Multivariate/metric.ml:6265 / retract_of_space
// Source hash: md5:cf02de8ba548bb029379dc2d381a5f87
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem retract_of_space_thm : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, retract_of_space A s top <-> s c= topspace A top /\ exists r:set -> set, (forall x :e A, r x :e A) /\ (continuous_map A A (top,subtopology A top s) r /\ forall x :e A, x :e s -> r x = x).
Admitted.

// HOL Light: Multivariate/metric.ml:6271 / RETRACT_OF_SPACE_RETRACTION_MAPS
// Source hash: md5:064e7f441e0e843006f133c1c2b15054
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem RETRACT_OF_SPACE_RETRACTION_MAPS : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, retract_of_space A s top <-> s c= topspace A top /\ exists r :e A :^: A, retraction_maps A A (top,subtopology A top s) (r,fun x :e A => x).
Admitted.

// HOL Light: Multivariate/metric.ml:6280 / RETRACT_OF_SPACE_SECTION_MAP
// Source hash: md5:09b8c9c27e26f1a6f20000b5fd205908
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem RETRACT_OF_SPACE_SECTION_MAP : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, retract_of_space A s top <-> s c= topspace A top /\ section_map A A (subtopology A top s,top) (fun x:set => x).
Admitted.

// HOL Light: Multivariate/metric.ml:6288 / RETRACT_OF_SPACE_IMP_SUBSET
// Source hash: md5:870e7be5fe84f0babb29d1c7e7a27f31
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem RETRACT_OF_SPACE_IMP_SUBSET : forall A:set, forall top :e topology A, forall s c= A, retract_of_space A s top -> s c= topspace A top.
Admitted.

// HOL Light: Multivariate/metric.ml:6292 / RETRACT_OF_SPACE_TOPSPACE
// Source hash: md5:5d7bab4b50121cfc0eb7c9f273e0e693
// Status: transport_required (bridges: hol_typedef_topology)
Theorem RETRACT_OF_SPACE_TOPSPACE : forall A:set, A <> Empty -> forall top :e topology A, retract_of_space A (topspace A top) top.
Admitted.

// HOL Light: Multivariate/metric.ml:6299 / RETRACT_OF_SPACE_EMPTY
// Source hash: md5:690002827c6aedd317bf2018e016d02a
// Status: transport_required (bridges: hol_typedef_topology)
Theorem RETRACT_OF_SPACE_EMPTY : forall A:set, A <> Empty -> forall top :e topology A, retract_of_space A Empty top <-> topspace A top = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:6306 / RETRACT_OF_SPACE_IMP_NONEMPTY
// Source hash: md5:f4a1b440e1a74ebc348b43f1cf68a53e
// Status: transport_required (bridges: hol_typedef_topology)
Theorem RETRACT_OF_SPACE_IMP_NONEMPTY : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, retract_of_space A s top /\ ~ topspace A top = Empty -> ~ s = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:6311 / RETRACT_OF_SPACE_SING
// Source hash: md5:045ef110c06c373613ba04d287dd0ecd
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem RETRACT_OF_SPACE_SING : forall A:set, forall top :e topology A, forall a :e A, retract_of_space A {a} top <-> a :e topspace A top.
Admitted.

// HOL Light: Multivariate/metric.ml:6320 / RETRACT_OF_SPACE_TRANS
// Source hash: md5:37a285b85fce1e78885a72b8d5b3ca30
// Status: transport_required (bridges: hol_typedef_topology)
Theorem RETRACT_OF_SPACE_TRANS : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, retract_of_space A s top /\ retract_of_space A t (subtopology A top s) -> retract_of_space A t top.
Admitted.

// HOL Light: Multivariate/metric.ml:6335 / RETRACT_OF_SPACE_SUBTOPOLOGY
// Source hash: md5:28905e9bbc1bc56acc7fe1a7ba0a1102
// Status: transport_required (bridges: hol_typedef_topology)
Theorem RETRACT_OF_SPACE_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e topology A, forall s u c= A, retract_of_space A s top /\ s c= u -> retract_of_space A s (subtopology A top u).
Admitted.

// HOL Light: Multivariate/metric.ml:6345 / RETRACT_OF_SPACE_CLOPEN
// Source hash: md5:39e4cc3dc20fb295b2473903b231cb0a
// Status: transport_required (bridges: hol_typedef_topology)
Theorem RETRACT_OF_SPACE_CLOPEN : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, s :e top /\ (closed_in A top s /\ (s = Empty -> topspace A top = Empty)) -> retract_of_space A s top.
Admitted.

// HOL Light: Multivariate/metric.ml:6365 / RETRACT_OF_SPACE_DISJOINT_UNION
// Source hash: md5:60e0b6a7f9b2e273c3d29b6e845f68d3
// Status: transport_required (bridges: hol_typedef_topology)
Theorem RETRACT_OF_SPACE_DISJOINT_UNION : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, s :e top /\ (t :e top /\ (s :/\: t = Empty /\ (s :\/: t = topspace A top /\ (s = Empty -> topspace A top = Empty)))) -> retract_of_space A s top.
Admitted.

// HOL Light: Multivariate/metric.ml:6377 / RETRACTION_MAPS_SECTION_IMAGE
// Source hash: md5:693b6cd56d4ff369c8436db033b717bd
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem RETRACTION_MAPS_SECTION_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall r :e B :^: A, forall s :e A :^: B, retraction_maps A B (top,top') (r,s) -> retract_of_space A {s x | x :e topspace B top'} top /\ homeomorphic_space A B (subtopology A top {s x | x :e topspace B top'}) top'.
Admitted.

// HOL Light: Multivariate/metric.ml:6392 / HEREDITARY_IMP_RETRACTIVE_PROPERTY
// Source hash: md5:190a60e412976428c1262ce3ed9a0edc
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HEREDITARY_IMP_RETRACTIVE_PROPERTY : forall A B:set, A <> Empty -> B <> Empty -> forall P Q:set -> prop, (forall top :e topology A, forall s c= A, P top -> P (subtopology A top s)) /\ (forall top :e topology A, forall top' :e topology B, homeomorphic_space A B top top' -> (P top <-> Q top')) -> forall top :e topology A, forall top' :e topology B, forall r:set -> set, (forall x :e A, r x :e B) -> retraction_map A B (top,top') r /\ P top -> Q top'.
Admitted.

// HOL Light: Multivariate/metric.ml:6410 / compact_in
// Source hash: md5:efca2089b61ad30ebaa83ed26893a2a4
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem compact_in_thm : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, compact_in A top s <-> s c= topspace A top /\ forall U c= Power A, (forall u c= A, u :e U -> u :e top) /\ s c= Union U -> exists V c= Power A, finite V /\ (V c= U /\ s c= Union V).
Admitted.

// HOL Light: Multivariate/metric.ml:6417 / compact_space
// Source hash: md5:0467717f1879e92e9c1bb75d8019ef4c
// Status: transport_required (bridges: hol_typedef_topology)
Theorem compact_space_thm : forall A:set, A <> Empty -> forall top :e topology A, compact_space A top <-> compact_in A top (topspace A top).
Admitted.

// HOL Light: Multivariate/metric.ml:6420 / COMPACT_SPACE_ALT
// Source hash: md5:254f86225981444aaf9225d763f5414c
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem COMPACT_SPACE_ALT : forall A:set, A <> Empty -> forall top :e topology A, compact_space A top <-> forall U c= Power A, (forall u c= A, u :e U -> u :e top) /\ topspace A top c= Union U -> exists V c= Power A, finite V /\ (V c= U /\ topspace A top c= Union V).
Admitted.

// HOL Light: Multivariate/metric.ml:6428 / COMPACT_SPACE
// Source hash: md5:462fd24a2afac6a76cfc37b9569e534f
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem COMPACT_SPACE : forall A:set, A <> Empty -> forall top :e topology A, compact_space A top <-> forall U c= Power A, (forall u c= A, u :e U -> u :e top) /\ Union U = topspace A top -> exists V c= Power A, finite V /\ (V c= U /\ Union V = topspace A top).
Admitted.

// HOL Light: Multivariate/metric.ml:6439 / COMPACT_IN_ABSOLUTE
// Source hash: md5:7d5491340d9079150188078fbb7afe07
// Status: transport_required (bridges: hol_typedef_topology)
Theorem COMPACT_IN_ABSOLUTE : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, compact_in A (subtopology A top s) s <-> compact_in A top s.
Admitted.

// HOL Light: Multivariate/metric.ml:6451 / COMPACT_IN_SUBSPACE
// Source hash: md5:967459421273b41e7438e7b2aeb05645
// Status: transport_required (bridges: hol_typedef_topology)
Theorem COMPACT_IN_SUBSPACE : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, compact_in A top s <-> s c= topspace A top /\ compact_space A (subtopology A top s).
Admitted.

// HOL Light: Multivariate/metric.ml:6462 / COMPACT_SPACE_SUBTOPOLOGY
// Source hash: md5:a7fa8a225dcd482b232dbe16860c3901
// Status: transport_required (bridges: hol_typedef_topology)
Theorem COMPACT_SPACE_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, compact_in A top s -> compact_space A (subtopology A top s).
Admitted.

// HOL Light: Multivariate/metric.ml:6466 / COMPACT_IN_SUBTOPOLOGY
// Source hash: md5:10c339f9c2ed753e764c2cc7f20d8f8b
// Status: transport_required (bridges: hol_typedef_topology)
Theorem COMPACT_IN_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, compact_in A (subtopology A top s) t <-> compact_in A top t /\ t c= s.
Admitted.

// HOL Light: Multivariate/metric.ml:6475 / COMPACT_IN_SUBSET_TOPSPACE
// Source hash: md5:054ccff993c444f049ae998d6f2041b7
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem COMPACT_IN_SUBSET_TOPSPACE : forall A:set, forall top :e topology A, forall s c= A, compact_in A top s -> s c= topspace A top.
Admitted.

// HOL Light: Multivariate/metric.ml:6479 / COMPACT_IN_CONTRACTIVE
// Source hash: md5:6d6034c3c037d93b26b15b634c8fff05
// Status: transport_required (bridges: hol_typedef_topology)
Theorem COMPACT_IN_CONTRACTIVE : forall A:set, A <> Empty -> forall top top' :e topology A, topspace A top' = topspace A top /\ (forall u c= A, u :e top -> u :e top') -> forall s c= A, compact_in A top' s -> compact_in A top s.
Admitted.

// HOL Light: Multivariate/metric.ml:6488 / COMPACT_SPACE_CONTRACTIVE
// Source hash: md5:cd2c5f8099b5ae07d261caecd761ff11
// Status: transport_required (bridges: hol_typedef_topology)
Theorem COMPACT_SPACE_CONTRACTIVE : forall A:set, A <> Empty -> forall top top' :e topology A, topspace A top' = topspace A top /\ (forall u c= A, u :e top -> u :e top') -> compact_space A top' -> compact_space A top.
Admitted.

// HOL Light: Multivariate/metric.ml:6495 / FINITE_IMP_COMPACT_IN
// Source hash: md5:475d16572ed0ba75ea7ac7d28b45c380
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem FINITE_IMP_COMPACT_IN : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, s c= topspace A top /\ finite s -> compact_in A top s.
Admitted.

// HOL Light: Multivariate/metric.ml:6501 / COMPACT_IN_EMPTY
// Source hash: md5:55d035889023a45dd7776dbabbb9c471
// Status: transport_required (bridges: hol_typedef_topology)
Theorem COMPACT_IN_EMPTY : forall A:set, A <> Empty -> forall top :e topology A, compact_in A top Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:6506 / COMPACT_SPACE_TOPSPACE_EMPTY
// Source hash: md5:fffc19bf0654fdb0ce4f0337e30fe1f0
// Status: transport_required (bridges: hol_typedef_topology)
Theorem COMPACT_SPACE_TOPSPACE_EMPTY : forall A:set, A <> Empty -> forall top :e topology A, topspace A top = Empty -> compact_space A top.
Admitted.

// HOL Light: Multivariate/metric.ml:6510 / FINITE_IMP_COMPACT_IN_EQ
// Source hash: md5:5d5d1ba139a7a3ec5accba0e84245699
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem FINITE_IMP_COMPACT_IN_EQ : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, finite s -> (compact_in A top s <-> s c= topspace A top).
Admitted.

// HOL Light: Multivariate/metric.ml:6515 / COMPACT_IN_SING
// Source hash: md5:fe1488e3775faddbc8e407c817dd9748
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem COMPACT_IN_SING : forall A:set, forall top :e topology A, forall a :e A, compact_in A top {a} <-> a :e topspace A top.
Admitted.

// HOL Light: Multivariate/metric.ml:6519 / CLOSED_COMPACT_IN
// Source hash: md5:cda927e0b1c9da3ba957818419bafbf0
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CLOSED_COMPACT_IN : forall A:set, A <> Empty -> forall top :e topology A, forall k c c= A, compact_in A top k /\ (c c= k /\ closed_in A top c) -> compact_in A top c.
Admitted.

// HOL Light: Multivariate/metric.ml:6545 / CLOSED_IN_COMPACT_SPACE
// Source hash: md5:7ee524af0bb12bd752d182a151ff6b92
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CLOSED_IN_COMPACT_SPACE : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, compact_space A top /\ closed_in A top s -> compact_in A top s.
Admitted.

// HOL Light: Multivariate/metric.ml:6552 / COMPACT_INTER_CLOSED_IN
// Source hash: md5:cee9262f32f36f836066da4215d69557
// Status: transport_required (bridges: hol_typedef_topology)
Theorem COMPACT_INTER_CLOSED_IN : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, compact_in A top s /\ closed_in A top t -> compact_in A top (s :/\: t).
Admitted.

// HOL Light: Multivariate/metric.ml:6565 / CLOSED_INTER_COMPACT_IN
// Source hash: md5:864a3a9686927ee3c54ae8e7a849b2ad
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CLOSED_INTER_COMPACT_IN : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, closed_in A top s /\ compact_in A top t -> compact_in A top (s :/\: t).
Admitted.

// HOL Light: Multivariate/metric.ml:6570 / COMPACT_IN_UNION
// Source hash: md5:3ec5c9c0033cb4eba1abd73985dac5b7
// Status: transport_required (bridges: hol_typedef_topology)
Theorem COMPACT_IN_UNION : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, compact_in A top s /\ compact_in A top t -> compact_in A top (s :\/: t).
Admitted.

// HOL Light: Multivariate/metric.ml:6585 / COMPACT_IN_UNIONS
// Source hash: md5:5759fc713bcf5b44115b48eb83e8be59
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem COMPACT_IN_UNIONS : forall A:set, A <> Empty -> forall top :e topology A, forall f c= Power A, finite f /\ (forall s c= A, s :e f -> compact_in A top s) -> compact_in A top (Union f).
Admitted.

// HOL Light: Multivariate/metric.ml:6594 / COMPACT_IN_SUBTOPOLOGY_IMP_COMPACT
// Source hash: md5:0b726fc0ae91940de41a75efe3ae1bcc
// Status: transport_required (bridges: hol_typedef_topology)
Theorem COMPACT_IN_SUBTOPOLOGY_IMP_COMPACT : forall A:set, A <> Empty -> forall top :e topology A, forall k s c= A, compact_in A (subtopology A top s) k -> compact_in A top k.
Admitted.

// HOL Light: Multivariate/metric.ml:6633 / COMPACT_IMP_COMPACT_IN_SUBTOPOLOGY
// Source hash: md5:8ab0f8a9fa96d6bc245db173357b0455
// Status: transport_required (bridges: hol_typedef_topology)
Theorem COMPACT_IMP_COMPACT_IN_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e topology A, forall k s c= A, compact_in A top k /\ k c= s -> compact_in A (subtopology A top s) k.
Admitted.

// HOL Light: Multivariate/metric.ml:6665 / CLOSED_IN_COMPACT_SUBTOPOLOGY
// Source hash: md5:3fb29f2c7a5992fb805d3a260ca0a7f9
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CLOSED_IN_COMPACT_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e topology A, forall k s c= A, compact_in A top k /\ closed_in A (subtopology A top k) s -> compact_in A top s.
Admitted.

// HOL Light: Multivariate/metric.ml:6672 / COMPACT_SPACE_FIP
// Source hash: md5:e676c5ae359431010b85b98f31165100
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem COMPACT_SPACE_FIP : forall A:set, A <> Empty -> forall top :e topology A, compact_space A top <-> forall f c= Power A, (forall c c= A, c :e f -> closed_in A top c) /\ (forall f' c= Power A, finite f' /\ f' c= f -> ~ {x :e A | forall Y :e f', x :e Y} = Empty) -> ~ {x :e A | forall Y :e f, x :e Y} = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:6730 / COMPACT_IN_FIP
// Source hash: md5:b451682f78006271778f0f54d26cd37d
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem COMPACT_IN_FIP : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, compact_in A top s <-> s c= topspace A top /\ forall f c= Power A, (forall c c= A, c :e f -> closed_in A top c) /\ (forall f' c= Power A, finite f' /\ f' c= f -> ~ s :/\: {x :e A | forall Y :e f', x :e Y} = Empty) -> ~ s :/\: {x :e A | forall Y :e f, x :e Y} = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:6765 / COMPACT_SPACE_IMP_NEST
// Source hash: md5:2f3244e7f34bde368534e273f45a76c8
// Status: transport_required (bridges: hol_num_omega, hol_typedef_topology, nat_le_SNoLe)
Theorem COMPACT_SPACE_IMP_NEST : forall A:set, A <> Empty -> forall top :e topology A, forall c :e Power A :^: omega, compact_space A top /\ ((forall n :e omega, closed_in A top (c n)) /\ ((forall n :e omega, ~ c n = Empty) /\ (forall m n :e omega, m <= n -> c n c= c m))) -> ~ {x :e A | forall Y :e {c n | n :e omega, n :e omega}, x :e Y} = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:6796 / COMPACT_IN_DISCRETE_TOPOLOGY
// Source hash: md5:2dbedb2c2063f97d3c358728a49a2f9b
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem COMPACT_IN_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u s c= A, compact_in A (discrete_topology A u) s <-> s c= u /\ finite s.
Admitted.

// HOL Light: Multivariate/metric.ml:6810 / COMPACT_SPACE_DISCRETE_TOPOLOGY
// Source hash: md5:66d4255bfb56a24cc846ce7f8e6ad1ef
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem COMPACT_SPACE_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u c= A, compact_space A (discrete_topology A u) <-> finite u.
Admitted.

// HOL Light: Multivariate/metric.ml:6815 / COMPACT_SPACE_IMP_BOLZANO_WEIERSTRASS
// Source hash: md5:9d7aa0df6f8b9b2969a61cc6c268ec29
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem COMPACT_SPACE_IMP_BOLZANO_WEIERSTRASS : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, compact_space A top /\ (infinite s /\ s c= topspace A top) -> ~ derived_set_of A top s = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:6828 / COMPACT_IN_IMP_BOLZANO_WEIERSTRASS
// Source hash: md5:6993158dbeb5f0db740cc8cd4f2f6a02
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem COMPACT_IN_IMP_BOLZANO_WEIERSTRASS : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, compact_in A top s /\ (infinite t /\ t c= s) -> ~ s :/\: derived_set_of A top t = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:6838 / COMPACT_CLOSURE_OF_IMP_BOLZANO_WEIERSTRASS
// Source hash: md5:5883e7ac87921df7de00a2b1dddd0d27
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem COMPACT_CLOSURE_OF_IMP_BOLZANO_WEIERSTRASS : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, compact_in A top (closure_of A top s) /\ (infinite t /\ (t c= s /\ t c= topspace A top)) -> ~ derived_set_of A top t = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:6850 / DISCRETE_COMPACT_IN_EQ_FINITE
// Source hash: md5:7d9f3d49ac397d62138c697344aebb88
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem DISCRETE_COMPACT_IN_EQ_FINITE : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, s :/\: derived_set_of A top s = Empty -> (compact_in A top s <-> s c= topspace A top /\ finite s).
Admitted.

// HOL Light: Multivariate/metric.ml:6862 / DISCRETE_COMPACT_SPACE_EQ_FINITE
// Source hash: md5:bb79d196c3f1ba0841fce98a4dcb620e
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem DISCRETE_COMPACT_SPACE_EQ_FINITE : forall A:set, A <> Empty -> forall top :e topology A, derived_set_of A top (topspace A top) = Empty -> (compact_space A top <-> finite (topspace A top)).
Admitted.

// HOL Light: Multivariate/metric.ml:6869 / IMAGE_COMPACT_IN
// Source hash: md5:3a6ade3b2225410109aedd60ebaf569c
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem IMAGE_COMPACT_IN : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall s c= A, compact_in A top s /\ continuous_map A B (top,top') f -> compact_in B top' {f x | x :e s}.
Admitted.

// HOL Light: Multivariate/metric.ml:6905 / HOMEOMORPHIC_COMPACT_SPACE
// Source hash: md5:db1ff8ad8f555324beee961d68bceaf5
// Status: transport_required (bridges: hol_typedef_topology)
Theorem HOMEOMORPHIC_COMPACT_SPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, homeomorphic_space A B top top' -> (compact_space A top <-> compact_space B top').
Admitted.

// HOL Light: Multivariate/metric.ml:6919 / HOMEOMORPHIC_MAP_COMPACTNESS
// Source hash: md5:48ac4f5105489f619118ba2f5a947356
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HOMEOMORPHIC_MAP_COMPACTNESS : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall top :e topology A, forall top' :e topology B, forall u c= A, homeomorphic_map A B (top,top') f /\ u c= topspace A top -> (compact_in B top' {f x | x :e u} <-> compact_in A top u).
Admitted.

// HOL Light: Multivariate/metric.ml:6934 / HOMEOMORPHIC_MAP_COMPACTNESS_EQ
// Source hash: md5:9a4462b8c65d49eac6811bc7bd43ae72
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HOMEOMORPHIC_MAP_COMPACTNESS_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall top :e topology A, forall top' :e topology B, forall u c= A, homeomorphic_map A B (top,top') f -> (compact_in A top u <-> u c= topspace A top /\ compact_in B top' {f x | x :e u}).
Admitted.

// HOL Light: Multivariate/metric.ml:6941 / COMPACT_SPACE_QUOTIENT_MAP_IMAGE
// Source hash: md5:66419def21de1953d9ee1202c5ab2b0f
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem COMPACT_SPACE_QUOTIENT_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall q:set -> set, (forall x :e A, q x :e B) -> quotient_map A B (top,top') q /\ compact_space A top -> compact_space B top'.
Admitted.

// HOL Light: Multivariate/metric.ml:6950 / COMPACT_SPACE_RETRACTION_MAP_IMAGE
// Source hash: md5:719bdd8355f0922395b4a7369e96e933
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem COMPACT_SPACE_RETRACTION_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall r:set -> set, (forall x :e A, r x :e B) -> retraction_map A B (top,top') r /\ compact_space A top -> compact_space B top'.
Admitted.

// HOL Light: Multivariate/metric.ml:6957 / ALEXANDER_SUBBASE_THEOREM
// Source hash: md5:fdc4a098dd6baa7aa2efa9304e899450
// Status: generalization_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem ALEXANDER_SUBBASE_THEOREM : forall A:set, A <> Empty -> forall top :e topology A, forall B c= Power A, {x :e Power A | exists u c= Power A, True /\ (forall x0 :e u, x0 :e relative_to A {x01 :e Power A | exists u c= Power A, finite u /\ (forall x1 :e u, x1 :e B) /\ {x :e A | forall Y :e u, x :e Y} = x01} (Union B)) /\ Union u = x} = top /\ (forall C c= Power A, C c= B /\ Union C = topspace A top -> exists C' c= Power A, finite C' /\ (C' c= C /\ Union C' = topspace A top)) -> compact_space A top.
Admitted.

// HOL Light: Multivariate/metric.ml:7070 / ALEXANDER_SUBBASE_THEOREM_ALT
// Source hash: md5:70bdb70fe787716b8a281f5d98315697
// Status: generalization_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem ALEXANDER_SUBBASE_THEOREM_ALT : forall A:set, A <> Empty -> forall top :e topology A, forall B c= Power A, forall u c= A, u c= Union B /\ ({x :e Power A | exists u0 c= Power A, True /\ (forall x0 :e u0, x0 :e relative_to A {x01 :e Power A | exists u c= Power A, finite u /\ (forall x1 :e u, x1 :e B) /\ {x :e A | forall Y :e u, x :e Y} = x01} u) /\ Union u0 = x} = top /\ (forall C c= Power A, C c= B /\ u c= Union C -> exists C' c= Power A, finite C' /\ (C' c= C /\ u c= Union C'))) -> compact_space A top.
Admitted.

// HOL Light: Multivariate/metric.ml:7098 / COMPACT_SPACE_PROD_TOPOLOGY
// Source hash: md5:2be4d34780017405d16b79299a514290
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem COMPACT_SPACE_PROD_TOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, compact_space (A :*: B) (prod_topology A B top1 top2) <-> topspace (A :*: B) (prod_topology A B top1 top2) = Empty \/ compact_space A top1 /\ compact_space B top2.
Admitted.

// HOL Light: Multivariate/metric.ml:7199 / COMPACT_IN_CROSS
// Source hash: md5:284e86dfbeec977113cf4acb29a30e69
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem COMPACT_IN_CROSS : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, forall s c= A, forall t c= B, compact_in (A :*: B) (prod_topology A B top1 top2) (s :*: t) <-> s = Empty \/ (t = Empty \/ compact_in A top1 s /\ compact_in B top2 t).
Admitted.

// HOL Light: Multivariate/metric.ml:7212 / COMPACT_SPACE_PRODUCT_TOPOLOGY
// Source hash: md5:90eea0a9843e45d87e189692d0dbdb20
// Status: transport_required (bridges: hol_typedef_topology)
Theorem COMPACT_SPACE_PRODUCT_TOPOLOGY : forall A K:set, A <> Empty -> K <> Empty -> forall tops:set -> set, (forall x :e K, tops x :e topology A) -> forall t c= K, compact_space (A :^: K) (product_topology A K t tops) <-> topspace (A :^: K) (product_topology A K t tops) = Empty \/ forall k :e K, k :e t -> compact_space A (tops k).
Admitted.

// HOL Light: Multivariate/metric.ml:7294 / COMPACT_IN_CARTESIAN_PRODUCT
// Source hash: md5:b445186e1832216ae7db1b1598b3b022
// Status: transport_required (bridges: hol_fun_setexp, hol_typedef_topology)
Theorem COMPACT_IN_CARTESIAN_PRODUCT : forall A K:set, A <> Empty -> K <> Empty -> forall tops:set -> set, (forall x :e K, tops x :e topology A) -> forall s :e Power A :^: K, forall k c= K, compact_in (A :^: K) (product_topology A K k tops) {f :e A :^: K | (forall i :e k, f i :e s i) /\ forall i :e K, ~ i :e k -> f i = choose_in A (fun y:set => False)} <-> {f :e A :^: K | (forall i :e k, f i :e s i) /\ forall i :e K, ~ i :e k -> f i = choose_in A (fun y:set => False)} = Empty \/ forall i :e K, i :e k -> compact_in A (tops i) (s i).
Admitted.

// HOL Light: Multivariate/metric.ml:7305 / TUBE_LEMMA_LEFT
// Source hash: md5:5e00da32bb084e6e4ef449699a9694de
// Status: generalization_required (bridges: empty_case:B, hol_prod_setprod, hol_typedef_topology)
Theorem TUBE_LEMMA_LEFT : forall A B:set, A <> Empty -> forall top :e topology A, forall top' :e topology B, forall k c= A, forall y :e B, forall w c= A :*: B, w :e prod_topology A B top top' /\ (compact_in A top k /\ (y :e topspace B top' /\ k :*: {y} c= w)) -> exists u c= A, exists v c= B, u :e top /\ (v :e top' /\ (k c= u /\ (y :e v /\ u :*: v c= w))).
Admitted.

// HOL Light: Multivariate/metric.ml:7348 / TUBE_LEMMA_RIGHT
// Source hash: md5:f60044eaf163991fb6a4cd12d4175e77
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_typedef_topology)
Theorem TUBE_LEMMA_RIGHT : forall A B:set, B <> Empty -> forall top :e topology A, forall top' :e topology B, forall x :e A, forall k c= B, forall w c= A :*: B, w :e prod_topology A B top top' /\ (compact_in B top' k /\ (x :e topspace A top /\ {x} :*: k c= w)) -> exists u c= A, exists v c= B, u :e top /\ (v :e top' /\ (x :e u /\ (k c= v /\ u :*: v c= w))).
Admitted.

// HOL Light: Multivariate/metric.ml:7391 / CLOSED_MAP_FST
// Source hash: md5:f70e12083e700d97e1d004353f5c443a
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CLOSED_MAP_FST : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, compact_space B top' -> closed_map (A :*: B) A (prod_topology A B top top',top) (fun x:set => x 0).
Admitted.

// HOL Light: Multivariate/metric.ml:7414 / CLOSED_MAP_SND
// Source hash: md5:8c27aefb56a22baac56958047f6afed8
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CLOSED_MAP_SND : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, compact_space A top -> closed_map (A :*: B) B (prod_topology A B top top',top') (fun x:set => x 1).
Admitted.

// HOL Light: Multivariate/metric.ml:7428 / WALLACE_THEOREM_PROD_TOPOLOGY
// Source hash: md5:e70a7f178b52fe528c30322c7ff485d6
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem WALLACE_THEOREM_PROD_TOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall w c= A :*: B, forall k c= A, forall l c= B, compact_in A top k /\ (compact_in B top' l /\ (w :e prod_topology A B top top' /\ k :*: l c= w)) -> exists u c= A, exists v c= B, u :e top /\ (v :e top' /\ (k c= u /\ (l c= v /\ u :*: v c= w))).
Admitted.

// HOL Light: Multivariate/metric.ml:7470 / LOCALLY_FINITE_COVER_OF_COMPACT_SPACE
// Source hash: md5:a5868e7dc713741b42643405dd8a8b4a
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem LOCALLY_FINITE_COVER_OF_COMPACT_SPACE : forall A:set, A <> Empty -> forall top :e topology A, forall u c= Power A, compact_space A top /\ (topspace A top c= Union u /\ locally_finite_in A top u) -> finite u.
Admitted.

// HOL Light: Multivariate/metric.ml:7502 / separated_in
// Source hash: md5:37aa3b604008f43335cf416e0ddc9564
// Status: transport_required (bridges: hol_typedef_topology)
Theorem separated_in_thm : forall A:set, A <> Empty -> forall t c= A, forall top :e topology A, forall s c= A, separated_in A top s t <-> s c= topspace A top /\ (t c= topspace A top /\ (s :/\: closure_of A top t = Empty /\ t :/\: closure_of A top s = Empty)).
Admitted.

// HOL Light: Multivariate/metric.ml:7507 / SEPARATED_IN_EMPTY
// Source hash: md5:1b599d48d21660793a610970422317b1
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATED_IN_EMPTY : forall A:set, A <> Empty -> (forall top :e topology A, forall s c= A, separated_in A top s Empty <-> s c= topspace A top) /\ forall top :e topology A, forall s c= A, separated_in A top Empty s <-> s c= topspace A top.
Admitted.

