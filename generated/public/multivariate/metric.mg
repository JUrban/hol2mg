// Source hash: md5:c180a83b944ff16bec142dc482344736
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem PATH_COMPONENT_OF_EQUIV : forall A:set, forall top :e topology A, forall x y :e A, path_component_of A top x y <-> x :e topspace A top /\ (y :e topspace A top /\ forall x0 :e A, path_component_of A top x x0 <-> path_component_of A top y x0).
Admitted.

// HOL Light: Multivariate/metric.ml:22641 / PATH_COMPONENT_OF_DISJOINT
// Source hash: md5:2c70645e12b078438911f12cab289910
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem PATH_COMPONENT_OF_DISJOINT : forall A:set, forall top :e topology A, forall x y :e A, {x0 :e A | path_component_of A top x x0} :/\: {x0 :e A | path_component_of A top y x0} = Empty <-> ~ path_component_of A top x y.
Admitted.

// HOL Light: Multivariate/metric.ml:22649 / PATH_COMPONENT_OF_EQ
// Source hash: md5:2eea09fde0a7a16e20e0bff6ceb5444c
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem PATH_COMPONENT_OF_EQ : forall A:set, forall top :e topology A, forall x y :e A, (forall x0 :e A, path_component_of A top x x0 <-> path_component_of A top y x0) <-> ~ x :e topspace A top /\ ~ y :e topspace A top \/ x :e topspace A top /\ (y :e topspace A top /\ path_component_of A top x y).
Admitted.

