// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, hol_typedef_net, hol_typedef_topology)
Theorem BOREL_MEASURABLE_MAP_LIMIT : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, forall f:set -> set -> set, (forall x :e omega, forall y :e A, f x y :e B) -> forall g:set -> set, (forall x :e A, g x :e B) -> metrizable_space B top2 /\ ((forall n :e omega, borel_measurable_map A B (top1,top2) (f n)) /\ (forall x :e A, x :e topspace A top1 -> limit omega B top2 (fun k:set => f k x) (g x) sequentially)) -> borel_measurable_map A B (top1,top2) g.
Admitted.

// HOL Light: Multivariate/metric.ml:19877 / cauchy_in
