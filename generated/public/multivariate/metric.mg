// Status: transport_required (bridges: hol_typedef_net)
Theorem EVENTUALLY_EQ_MP : forall A:set, A <> Empty -> forall net0 :e net A, forall P Q c= A, eventually A {x :e A | x :e P <-> x :e Q} net0 /\ eventually A P net0 -> eventually A Q net0.
