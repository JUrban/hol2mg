// Source hash: md5:6ae8b36fa6440e443888f6ff86ab2106
// Status: transport_required (bridges: hol_typedef_topology)
Theorem BOUNDARY_BUMPING_THEOREM : forall A:set, A <> Empty -> forall top :e topology A, forall s c c= A, connected_space A top /\ (compact_space A top /\ (hausdorff_space A top /\ (s c= topspace A top /\ s <> topspace A top /\ c :e connected_components_of A (subtopology A top s)))) -> ~ frontier_of A top c :/\: frontier_of A top s = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:27385 / k_space
// Source hash: md5:7ac302aed31e7537583643d927b8747f
// Status: transport_required (bridges: hol_typedef_topology)
Theorem k_space_thm : forall A:set, A <> Empty -> forall top :e topology A, k_space A top <-> forall s c= A, s c= topspace A top -> (closed_in A top s <-> forall k c= A, compact_in A top k -> closed_in A (subtopology A top k) (k :/\: s)).
Admitted.

// HOL Light: Multivariate/metric.ml:27392 / K_SPACE
// Source hash: md5:f401897c9a9d060d8df7987fd8b8bbf5
// Status: transport_required (bridges: hol_typedef_topology)
Theorem K_SPACE : forall A:set, A <> Empty -> forall top :e topology A, k_space A top <-> forall s c= A, s c= topspace A top /\ (forall k c= A, compact_in A top k -> closed_in A (subtopology A top k) (k :/\: s)) -> closed_in A top s.
Admitted.

// HOL Light: Multivariate/metric.ml:27402 / K_SPACE_OPEN
// Source hash: md5:3a3b6a3ed61dc0ad9f7a6d7fdf725485
// Status: transport_required (bridges: hol_typedef_topology)
Theorem K_SPACE_OPEN : forall A:set, A <> Empty -> forall top :e topology A, k_space A top <-> forall s c= A, s c= topspace A top /\ (forall k c= A, compact_in A top k -> k :/\: s :e subtopology A top k) -> s :e top.
Admitted.

