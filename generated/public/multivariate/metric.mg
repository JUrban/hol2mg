// Source hash: md5:05642db91aa6cdc9ef2eedf4537a5e46
// Status: transport_required (bridges: hol_typedef_metric, hol_typedef_topology)
Theorem metrizable_space_thm : forall A:set, A <> Empty -> forall top :e topology A, metrizable_space A top <-> exists m :e metric A, top = mtopology A m.
Admitted.

