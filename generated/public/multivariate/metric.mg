// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem QUASI_COMPONENT_OF_NONOVERLAP : forall A:set, forall top :e topology A, forall x y :e A, {x0 :e A | quasi_component_of A top x x0} :/\: {x0 :e A | quasi_component_of A top y x0} = Empty <-> ~ x :e topspace A top \/ (~ y :e topspace A top \/ ~ forall x0 :e A, quasi_component_of A top x x0 <-> quasi_component_of A top y x0).
Admitted.

// HOL Light: Multivariate/metric.ml:26442 / QUASI_COMPONENT_OF_OVERLAP
// Source hash: md5:01784d8e72623fee00364b352d58ebc0
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem QUASI_COMPONENT_OF_OVERLAP : forall A:set, forall top :e topology A, forall x y :e A, ~ {x0 :e A | quasi_component_of A top x x0} :/\: {x0 :e A | quasi_component_of A top y x0} = Empty <-> x :e topspace A top /\ (y :e topspace A top /\ forall x0 :e A, quasi_component_of A top x x0 <-> quasi_component_of A top y x0).
Admitted.

