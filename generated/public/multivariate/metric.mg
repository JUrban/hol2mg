Theorem IN_INTERIOR_OF_MBALL : forall A:set, forall m :e metric A, forall s c= A, forall x :e A, x :e interior_of A (mtopology A m) s <-> x :e mspace A m /\ exists e0 :e R, 0 < e0 /\ mball A m (x,e0) c= s.
Admitted.

