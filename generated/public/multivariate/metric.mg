// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HEREDITARILY_NORMAL_SPACE_RETRACTION_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall r:set -> set, (forall x :e A, r x :e B) -> retraction_map A B (top,top') r /\ hereditarily A {x :e topology A | normal_space A x} top -> hereditarily B {x :e topology B | normal_space B x} top'.
Admitted.

// HOL Light: Multivariate/metric.ml:23880 / URYSOHN_LEMMA
// Source hash: md5:21e5bdff5bc1aa3e6a117c58b55753ba
// Status: transport_required (bridges: hol_list_finseq, hol_prod_setprod, hol_real_R, hol_typedef_topology)
Theorem URYSOHN_LEMMA : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, forall a b :e R, a <= b /\ (normal_space A top /\ (closed_in A top s /\ (closed_in A top t /\ s :/\: t = Empty))) -> exists f:set -> set, (forall x :e A, f x :e R) /\ (continuous_map A R (top,subtopology R euclideanreal (closed_real_interval (seq_cons (a,b) seq_nil))) f /\ ((forall x :e A, x :e s -> f x = a) /\ forall x :e A, x :e t -> f x = b)).
Admitted.

