Theorem INTERIOR_OF_SUBTOPOLOGY_MONO : forall A:set, A <> Empty -> forall top :e topology A, forall s t u c= A, s c= t /\ t c= u -> interior_of A (subtopology A top u) s c= interior_of A (subtopology A top t) s.
Admitted.

// HOL Light: Multivariate/metric.ml:1660 / INTERIOR_OF_SUBTOPOLOGY_OPEN
