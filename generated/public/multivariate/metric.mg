// Status: transport_required (bridges: hol_num_omega, hol_real_R)
Theorem real_summable_thm : forall f:set -> set, (forall x :e omega, f x :e R) -> forall s c= omega, real_summable s f <-> exists l :e R, real_sums f l s.
