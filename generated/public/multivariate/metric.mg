// Source hash: md5:84949507c8878f25856942756f90c776
// Status: transport_required (bridges: hol_typedef_topology)
Theorem T1_OR_HAUSDORFF_SPACE : forall A:set, A <> Empty -> forall top :e topology A, t1_space A top \/ hausdorff_space A top <-> t1_space A top.
Admitted.

// HOL Light: Multivariate/metric.ml:8048 / HAUSDORFF_SPACE_SING_INTERS_OPENS
// Source hash: md5:0f8dfbb850bfa2326f7feadbc395997b
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem HAUSDORFF_SPACE_SING_INTERS_OPENS : forall A:set, forall top :e topology A, forall a :e A, hausdorff_space A top /\ a :e topspace A top -> {x :e A | forall Y :e {u :e Power A | u :e top /\ a :e u}, x :e Y} = {a}.
Admitted.

// HOL Light: Multivariate/metric.ml:8056 / HAUSDORFF_SPACE_SING_INTERS_CLOSED
// Source hash: md5:a631e7ca028806f9be772a0db3d33682
// Status: transport_required (bridges: hol_typedef_topology)
Theorem HAUSDORFF_SPACE_SING_INTERS_CLOSED : forall A:set, A <> Empty -> forall top :e topology A, hausdorff_space A top <-> forall x :e A, x :e topspace A top -> {x0 :e A | forall Y :e {u :e Power A | closed_in A top u /\ x :e interior_of A top u}, x0 :e Y} = {x}.
Admitted.

// HOL Light: Multivariate/metric.ml:8075 / HAUSDORFF_SPACE_SUBTOPOLOGY
// Source hash: md5:ade7bebd977937e74a0770d1a9adaa1f
// Status: transport_required (bridges: hol_typedef_topology)
Theorem HAUSDORFF_SPACE_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, hausdorff_space A top -> hausdorff_space A (subtopology A top s).
Admitted.

// HOL Light: Multivariate/metric.ml:8087 / HAUSDORFF_SPACE_COMPACT_SEPARATION
// Source hash: md5:c193cdc557eb56143cc743c65cb8ce7f
// Status: transport_required (bridges: hol_typedef_topology)
Theorem HAUSDORFF_SPACE_COMPACT_SEPARATION : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, hausdorff_space A top /\ (compact_in A top s /\ (compact_in A top t /\ s :/\: t = Empty)) -> exists u v c= A, u :e top /\ (v :e top /\ (s c= u /\ (t c= v /\ u :/\: v = Empty))).
Admitted.

// HOL Light: Multivariate/metric.ml:8154 / HAUSDORFF_SPACE_COMPACT_SETS
// Source hash: md5:3804159b51b2a12f4201cde204474a2a
// Status: transport_required (bridges: hol_typedef_topology)
Theorem HAUSDORFF_SPACE_COMPACT_SETS : forall A:set, A <> Empty -> forall top :e topology A, hausdorff_space A top <-> forall s t c= A, compact_in A top s /\ (compact_in A top t /\ s :/\: t = Empty) -> exists u v c= A, u :e top /\ (v :e top /\ (s c= u /\ (t c= v /\ u :/\: v = Empty))).
Admitted.

