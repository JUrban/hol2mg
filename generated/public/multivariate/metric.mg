Theorem OPEN_CONNECTED_FINE_COVER : forall A:set, forall m :e metric A, forall u c= A, forall e0 :e R, locally_connected_space A (mtopology A m) /\ (u :e mtopology A m /\ 0 < e0) -> forall x :e A, x :e u -> exists v c= A, v :e mtopology A m /\ (connected_in A (mtopology A m) v /\ (x :e v /\ (v c= u /\ (closure_of A (mtopology A m) v c= u /\ forall y z :e A, y :e v /\ z :e v -> mdist A m (y,z) < e0)))).
Admitted.

