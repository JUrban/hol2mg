// Status: generalization_required (bridges: empty_case:K, hol_typedef_topology)
Theorem HOMEOMORPHIC_SPACE_SINGLETON_PRODUCT : forall A K:set, A <> Empty -> forall tops:set -> set, (forall x :e K, tops x :e topology A) -> forall k :e K, homeomorphic_space (A :^: K) A (product_topology A K {k} tops) (tops k).
