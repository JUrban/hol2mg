// Status: transport_required (bridges: hol_typedef_topology)
Theorem QUASI_EQ_CONNECTED_COMPONENTS_OF_POINTWISE_ALT : forall A:set, A <> Empty -> forall top :e topology A, quasi_components_of A top = connected_components_of A top <-> forall x x0 :e A, quasi_component_of A top x x0 <-> connected_component_of A top x x0.
Admitted.

