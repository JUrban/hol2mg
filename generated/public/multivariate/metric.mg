Theorem CLOSURE_OF_MINIMAL_EQ : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, s c= topspace A top /\ closed_in A top t -> (closure_of A top s c= t <-> s c= t).
Admitted.

// HOL Light: Multivariate/metric.ml:1291 / CLOSURE_OF_UNIQUE
// Source hash: md5:bb3d7c1092cad8936c983ac21134d2b6
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CLOSURE_OF_UNIQUE : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, s c= t /\ (closed_in A top t /\ (forall t' c= A, s c= t' /\ closed_in A top t' -> t c= t')) -> closure_of A top s = t.
Admitted.

