// HOL Light: Multivariate/metric.ml:32352 / CONVERGENT_EQ_ZERO_OSCILLATION_GEN
// Source hash: md5:19c2d66947ab364d67e6dabd25a2b1c0
// Status: generalization_required (bridges: empty_case:A, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_net, hol_typedef_topology, omega_Subq_R)
Theorem CONVERGENT_EQ_ZERO_OSCILLATION_GEN : forall A B:set, B <> Empty -> forall top :e topology A, forall m :e metric B, forall f:set -> set, (forall x :e A, f x :e B) -> forall s c= A, forall a :e A, mcomplete B m /\ {f x | x :e topspace A top :/\: s} c= mspace B m -> ((exists l :e B, limit A B (mtopology B m) f l (within A (atpointof A top a) s)) <-> ~ mspace B m = Empty /\ (a :e topspace A top -> forall e0 :e R, 0 < e0 -> exists u c= A, u :e top /\ (a :e u /\ forall x y :e A, x :e s :/\: u :\: {a} /\ y :e s :/\: u :\: {a} -> mdist B m (f x,f y) < e0))).
Admitted.

// HOL Light: Multivariate/metric.ml:32467 / GDELTA_IN_POINTS_OF_CONVERGENCE_WITHIN
// Source hash: md5:42d52154f1bfc12894fae3e18979bd72
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_net, hol_typedef_topology)
Theorem GDELTA_IN_POINTS_OF_CONVERGENCE_WITHIN : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall s c= A, completely_metrizable_space B top' /\ (continuous_map A B (subtopology A top s,top') f \/ t1_space A top /\ {f x | x :e s} c= topspace B top') -> {x :e A | x :e topspace A top /\ exists l :e B, limit A B top' f l (within A (atpointof A top x) s)} :e gdelta_in A top.
Admitted.

// HOL Light: Multivariate/metric.ml:32555 / LAVRENTIEV_EXTENSION_GEN
// Source hash: md5:fa277189f69a114499756f93151314fe
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem LAVRENTIEV_EXTENSION_GEN : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall s c= A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> s c= topspace A top /\ (completely_metrizable_space B top' /\ continuous_map A B (subtopology A top s,top') f) -> exists u c= A, exists g:set -> set, (forall x :e A, g x :e B) /\ (u :e gdelta_in A top /\ (s c= u /\ (continuous_map A B (subtopology A top (closure_of A top s :/\: u),top') g /\ forall x :e A, x :e s -> g x = f x))).
Admitted.

// HOL Light: Multivariate/metric.ml:32583 / LAVRENTIEV_EXTENSION
// Source hash: md5:9b0f6a2391d1da721b67a41b37bb83b1
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem LAVRENTIEV_EXTENSION : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall s c= A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> s c= topspace A top /\ ((metrizable_space A top \/ topspace A top c= closure_of A top s) /\ (completely_metrizable_space B top' /\ continuous_map A B (subtopology A top s,top') f)) -> exists u c= A, exists g:set -> set, (forall x :e A, g x :e B) /\ (u :e gdelta_in A top /\ (s c= u /\ (u c= closure_of A top s /\ (continuous_map A B (subtopology A top u,top') g /\ forall x :e A, x :e s -> g x = f x)))).
Admitted.

// HOL Light: Multivariate/metric.ml:32615 / mdiameter
// Source hash: md5:c8100bd2cf227127dfe4ae3909013e1f
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, omega_Subq_R)
Theorem mdiameter_thm : forall A:set, A <> Empty -> forall s c= A, forall m :e metric A, mdiameter A m s = if s = Empty then 0 else sup (\/_ x :e A, {mdist A m (x,y) | y :e A, x :e s /\ y :e s}).
Admitted.

// HOL Light: Multivariate/metric.ml:32620 / MDIAMETER_EMPTY
// Source hash: md5:58b9cf8bdd976329af1b1a559ca71d7e
// Status: transport_required (bridges: hol_num_omega, hol_real_R, hol_typedef_metric, omega_Subq_R)
Theorem MDIAMETER_EMPTY : forall A:set, A <> Empty -> forall m :e metric A, mdiameter A m Empty = 0.
Admitted.

// HOL Light: Multivariate/metric.ml:32624 / MDIAMETER_SING
// Source hash: md5:30fb045da3504119bed28428a6ee9cab
// Status: generalization_required (bridges: empty_case:A, hol_num_omega, hol_real_R, hol_typedef_metric, omega_Subq_R)
Theorem MDIAMETER_SING : forall A:set, forall m :e metric A, forall x :e A, x :e mspace A m -> mdiameter A m {x} = 0.
Admitted.

// HOL Light: Multivariate/metric.ml:32631 / MDIAMETER_POS_LE
// Source hash: md5:b104aabd01639bbe9b2f0f7d6db6bee2
// Status: transport_required (bridges: hol_num_omega, hol_real_R, hol_typedef_metric, omega_Subq_R)
Theorem MDIAMETER_POS_LE : forall A:set, A <> Empty -> forall m :e metric A, forall s c= A, mbounded A m s -> 0 <= mdiameter A m s.
Admitted.

// HOL Light: Multivariate/metric.ml:32648 / MDIAMETER_BOUNDED
// Source hash: md5:49b9df08166aa72a96c099ae225086d4
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, omega_Subq_R)
Theorem MDIAMETER_BOUNDED : forall A:set, A <> Empty -> forall m :e metric A, forall s c= A, mbounded A m s -> (forall x y :e A, x :e s /\ y :e s -> mdist A m (x,y) <= mdiameter A m s) /\ forall d :e R, 0 <= d /\ d < mdiameter A m s -> exists x y :e A, x :e s /\ (y :e s /\ d < mdist A m (x,y)).
Admitted.

// HOL Light: Multivariate/metric.ml:32671 / MDIAMETER_BOUNDED_BOUND
// Source hash: md5:c8621528132c5aa924dbc4c72dda5b8e
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem MDIAMETER_BOUNDED_BOUND : forall A:set, forall m :e metric A, forall s c= A, forall x y :e A, mbounded A m s /\ (x :e s /\ y :e s) -> mdist A m (x,y) <= mdiameter A m s.
Admitted.

// HOL Light: Multivariate/metric.ml:32677 / MDIAMETER_LE
// Source hash: md5:159b6677222589e6c38ecb36d798e6c5
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, omega_Subq_R)
Theorem MDIAMETER_LE : forall A:set, A <> Empty -> forall m :e metric A, forall s c= A, forall d :e R, s c= mspace A m /\ ((~ s = Empty \/ 0 <= d) /\ (forall x y :e A, x :e s /\ y :e s -> mdist A m (x,y) <= d)) -> mdiameter A m s <= d.
Admitted.

// HOL Light: Multivariate/metric.ml:32688 / MBOUNDED_AND_MDIAMETER_LE
// Source hash: md5:87275699cc9c1588f09011d619ef7a74
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, omega_Subq_R)
Theorem MBOUNDED_AND_MDIAMETER_LE : forall A:set, A <> Empty -> forall m :e metric A, forall s c= A, forall r :e R, s c= mspace A m -> (mbounded A m s /\ mdiameter A m s <= r <-> 0 <= r /\ forall x y :e A, x :e s /\ y :e s -> mdist A m (x,y) <= r).
Admitted.

// HOL Light: Multivariate/metric.ml:32705 / MDIAMETER_SUBSET
// Source hash: md5:2fbc6c24f7864f5f1d0742ccaa82aa0a
// Status: transport_required (bridges: hol_real_R, hol_typedef_metric)
Theorem MDIAMETER_SUBSET : forall A:set, A <> Empty -> forall m :e metric A, forall s t c= A, s c= t /\ mbounded A m t -> mdiameter A m s <= mdiameter A m t.
Admitted.

