Theorem SUBMETRIC_PROD_METRIC : forall A B:set, A <> Empty -> B <> Empty -> forall m1 :e metric A, forall m2 :e metric B, forall s c= A, forall t c= B, submetric (A :*: B) (prod_metric A B m1 m2) (s :*: t) = prod_metric A B (submetric A m1 s) (submetric B m2 t).
