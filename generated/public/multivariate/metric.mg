Theorem MBOUNDED_IMP_IN_MSPACE : forall A:set, forall m :e metric A, forall s c= A, forall x :e A, mbounded A m s /\ x :e s -> x :e mspace A m.
Admitted.

// HOL Light: Multivariate/metric.ml:32728 / MDIAMETER_CLOSURE
// Source hash: md5:a1ffe2158e7d025211d953f407b68f32
// Status: transport_required (bridges: hol_real_R, hol_typedef_metric, hol_typedef_topology)
Theorem MDIAMETER_CLOSURE : forall A:set, A <> Empty -> forall m :e metric A, forall s c= A, mbounded A m s -> mdiameter A m (closure_of A (mtopology A m) s) = mdiameter A m s.
Admitted.

// HOL Light: Multivariate/metric.ml:32797 / MDIAMETER_COMPACT_ATTAINED
// Source hash: md5:7d508277f4837f24a6ac07733b66f422
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_topology)
Theorem MDIAMETER_COMPACT_ATTAINED : forall A:set, forall m :e metric A, forall s c= A, compact_in A (mtopology A m) s /\ ~ s = Empty -> exists x y :e A, x :e s /\ (y :e s /\ mdist A m (x,y) = mdiameter A m s).
Admitted.

// HOL Light: Multivariate/metric.ml:32827 / MDIAMETER_SUBSET_MCBALL_NONEMPTY
// Source hash: md5:7fbaa0dbbd74d883e1951dda92326382
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem MDIAMETER_SUBSET_MCBALL_NONEMPTY : forall A:set, forall m :e metric A, forall s c= A, mbounded A m s /\ ~ s = Empty -> exists z :e A, z :e s /\ s c= mcball A m (z,mdiameter A m s).
Admitted.

// HOL Light: Multivariate/metric.ml:32837 / MDIAMETER_SUBSET_MCBALL
// Source hash: md5:17e112b576a0458ed16a5d931fc8b8fd
// Status: transport_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem MDIAMETER_SUBSET_MCBALL : forall A:set, A <> Empty -> forall m :e metric A, forall s c= A, mbounded A m s -> exists z :e A, s c= mcball A m (z,mdiameter A m s).
Admitted.

// HOL Light: Multivariate/metric.ml:32847 / MDIAMETER_EQ_0
// Source hash: md5:d817f717db0e5774c0544834e4dc8875
// Status: transport_required (bridges: hol_num_omega, hol_real_R, hol_typedef_metric, omega_Subq_R)
Theorem MDIAMETER_EQ_0 : forall A:set, A <> Empty -> forall m :e metric A, forall s c= A, mbounded A m s -> (mdiameter A m s = 0 <-> s = Empty \/ exists a :e A, s = {a}).
Admitted.

// HOL Light: Multivariate/metric.ml:32862 / MDIAMETER_UNION_LE
// Source hash: md5:6ff1071f07b2ca3c7ed87f7a387d2956
// Status: generalization_required (bridges: empty_case:A, hol_real_R, hol_typedef_metric)
Theorem MDIAMETER_UNION_LE : forall A:set, forall m :e metric A, forall s t c= A, mbounded A m s /\ (mbounded A m t /\ ~ s :/\: t = Empty) -> mdiameter A m (s :\/: t) <= mdiameter A m s + mdiameter A m t.
Admitted.

// HOL Light: Multivariate/metric.ml:32910 / MDIAMETER_SUBMETRIC
// Source hash: md5:b6972ee26a4ca8c10581068a0c27a79a
// Status: transport_required (bridges: hol_real_R, hol_typedef_metric)
Theorem MDIAMETER_SUBMETRIC : forall A:set, A <> Empty -> forall m :e metric A, forall s t c= A, mdiameter A (submetric A m s) t = mdiameter A m t.
Admitted.

// HOL Light: Multivariate/metric.ml:32914 / LEBESGUE_COVERING_LEMMA
// Source hash: md5:29aa4672320856b6469b516f1a183b64
// Status: transport_required (bridges: hol_num_omega, hol_real_R, hol_typedef_metric, hol_typedef_topology, omega_Subq_R)
Theorem LEBESGUE_COVERING_LEMMA : forall A:set, A <> Empty -> forall m :e metric A, forall s c= A, forall c c= Power A, compact_in A (mtopology A m) s /\ (~ c = Empty /\ (s c= Union c /\ (forall b c= A, b :e c -> b :e mtopology A m))) -> exists d :e R, 0 < d /\ forall t c= A, t c= s /\ mdiameter A m t <= d -> exists b c= A, b :e c /\ t c= b.
Admitted.

// HOL Light: Multivariate/metric.ml:32946 / LEBESGUE_COVERING_LEMMA_GEN
// Source hash: md5:1c4a304338ff2788e7336183440e4d46
// Status: transport_required (bridges: hol_num_omega, hol_real_R, hol_typedef_metric, hol_typedef_topology, omega_Subq_R)
Theorem LEBESGUE_COVERING_LEMMA_GEN : forall A:set, A <> Empty -> forall m :e metric A, forall u s c= A, forall c c= Power A, compact_in A (mtopology A m) s /\ (~ c = Empty /\ (s c= Union c /\ (forall b c= A, b :e c -> b :e subtopology A (mtopology A m) u))) -> exists d :e R, 0 < d /\ forall t c= A, t c= s /\ mdiameter A m t <= d -> exists b c= A, b :e c /\ t c= b.
Admitted.

// HOL Light: Multivariate/metric.ml:33016 / WELLCHAINED_ELEMENTS
// Source hash: md5:6acd0b31aad05dd4173239791c079347
// Status: generalization_required (bridges: empty_case:A, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, nat_le_SNoLe, nat_lt_SNoLt)
Theorem WELLCHAINED_ELEMENTS : forall A:set, forall m :e metric A, forall s c= A, forall a b :e A, forall e0 :e R, (exists p:set -> set, (forall x :e omega, p x :e A) /\ exists n :e omega, p 0 = a /\ (p n = b /\ ((forall i :e omega, i <= n -> p i :e s) /\ forall i :e omega, i < n -> mdist A m (p i,p (ordsucc i)) < e0))) <-> a :e s /\ (b :e s /\ forall c c= A, c c= s /\ (a :e c /\ (forall x y :e A, x :e c /\ (y :e s /\ mdist A m (x,y) < e0) -> y :e c)) -> b :e c).
Admitted.

// HOL Light: Multivariate/metric.ml:33061 / WELLCHAINED_SETS
// Source hash: md5:3eab5d10931e867b59ccdd9018d16a6d
// Status: generalization_required (bridges: empty_case:A, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, nat_le_SNoLe, nat_lt_SNoLt)
Theorem WELLCHAINED_SETS : forall A:set, forall m :e metric A, forall s c= A, forall e0 :e R, (forall a b :e A, a :e s /\ b :e s -> exists p:set -> set, (forall x :e omega, p x :e A) /\ exists n :e omega, p 0 = a /\ (p n = b /\ ((forall i :e omega, i <= n -> p i :e s) /\ forall i :e omega, i < n -> mdist A m (p i,p (ordsucc i)) < e0))) <-> forall c c= A, c c= s /\ (~ c = Empty /\ (forall x y :e A, x :e c /\ (y :e s /\ mdist A m (x,y) < e0) -> y :e c)) -> c = s.
Admitted.

// HOL Light: Multivariate/metric.ml:33081 / EPSILON_ABSORBING_IMP_CLOPEN
// Source hash: md5:3a81d7d33f2795612d0880e922cb1529
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_topology, omega_Subq_R)
Theorem EPSILON_ABSORBING_IMP_CLOPEN : forall A:set, A <> Empty -> forall m :e metric A, forall s c c= A, forall e0 :e R, s c= mspace A m /\ (c c= s /\ (0 < e0 /\ (forall x y :e A, x :e c /\ (y :e s /\ mdist A m (x,y) < e0) -> y :e c))) -> c :e subtopology A (mtopology A m) s /\ closed_in A (subtopology A (mtopology A m) s) c.
Admitted.

// HOL Light: Multivariate/metric.ml:33129 / CONNECTED_IN_IMP_WELLCHAINED
// Source hash: md5:181d7197d3147d8dd4e637bc1c62639b
// Status: generalization_required (bridges: empty_case:A, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_topology, nat_le_SNoLe, nat_lt_SNoLt, omega_Subq_R)
Theorem CONNECTED_IN_IMP_WELLCHAINED : forall A:set, forall m :e metric A, forall s c= A, forall e0 :e R, forall a b :e A, connected_in A (mtopology A m) s /\ (0 < e0 /\ (a :e s /\ b :e s)) -> exists p:set -> set, (forall x :e omega, p x :e A) /\ exists n :e omega, p 0 = a /\ (p n = b /\ ((forall i :e omega, i <= n -> p i :e s) /\ forall i :e omega, i < n -> mdist A m (p i,p (ordsucc i)) < e0)).
Admitted.

// HOL Light: Multivariate/metric.ml:33151 / CONNECTED_COMPONENT_OF_IMP_WELLCHAINED
// Source hash: md5:48d5a8b6ac2b105803e0e4d1c6253501
// Status: generalization_required (bridges: empty_case:A, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_topology, nat_le_SNoLe, nat_lt_SNoLt, omega_Subq_R)
Theorem CONNECTED_COMPONENT_OF_IMP_WELLCHAINED : forall A:set, forall m :e metric A, forall s c= A, forall a b :e A, forall e0 :e R, 0 < e0 /\ connected_component_of A (subtopology A (mtopology A m) s) a b -> exists p:set -> set, (forall x :e omega, p x :e A) /\ exists n :e omega, p 0 = a /\ (p n = b /\ ((forall i :e omega, i <= n -> p i :e s) /\ forall i :e omega, i < n -> mdist A m (p i,p (ordsucc i)) < e0)).
Admitted.

// HOL Light: Multivariate/metric.ml:33168 / CONNECTED_EQ_WELLCHAINED_IN
// Source hash: md5:0d4c66330cf19638b7e809ed2b6f3d30
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_topology, nat_le_SNoLe, nat_lt_SNoLt, omega_Subq_R)
Theorem CONNECTED_EQ_WELLCHAINED_IN : forall A:set, A <> Empty -> forall m :e metric A, forall s c= A, compact_in A (mtopology A m) s -> (connected_in A (mtopology A m) s <-> forall e0 :e R, 0 < e0 -> forall a b :e A, a :e s /\ b :e s -> exists p:set -> set, (forall x :e omega, p x :e A) /\ exists n :e omega, p 0 = a /\ (p n = b /\ ((forall i :e omega, i <= n -> p i :e s) /\ forall i :e omega, i < n -> mdist A m (p i,p (ordsucc i)) < e0))).
Admitted.

// HOL Light: Multivariate/metric.ml:33247 / CONNECTED_COMPONENT_OF_EQ_WELLCHAINED
// Source hash: md5:4db38d44d42f0423a70dcef6e00f30a4
// Status: generalization_required (bridges: empty_case:A, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_topology, nat_le_SNoLe, nat_lt_SNoLt, omega_Subq_R)
Theorem CONNECTED_COMPONENT_OF_EQ_WELLCHAINED : forall A:set, forall m :e metric A, forall K c= A, forall a b :e A, compact_in A (mtopology A m) K -> (connected_component_of A (subtopology A (mtopology A m) K) a b <-> a :e K /\ (b :e K /\ forall e0 :e R, 0 < e0 -> exists p:set -> set, (forall x :e omega, p x :e A) /\ exists n :e omega, p 0 = a /\ (p n = b /\ ((forall i :e omega, i <= n -> p i :e K) /\ forall i :e omega, i < n -> mdist A m (p i,p (ordsucc i)) < e0)))).
Admitted.

// HOL Light: Multivariate/metric.ml:33383 / NESTED_COMPACT_APPROX
// Source hash: md5:02875fcd04042fdf37c28625f863c36d
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_topology, omega_Subq_R)
Theorem NESTED_COMPACT_APPROX : forall A:set, A <> Empty -> forall m :e metric A, forall s :e Power A :^: omega, (forall n :e omega, compact_in A (mtopology A m) (s n)) /\ (forall n :e omega, s (ordsucc n) c= s n) -> forall e0 :e R, 0 < e0 -> exists N :e omega, forall x :e A, x :e s N -> exists y :e A, y :e {x :e A | forall Y :e {s n | n :e omega, n :e omega}, x :e Y} /\ mdist A m (x,y) < e0.
Admitted.

// HOL Light: Multivariate/metric.ml:33482 / MDIST_TRIANGLE_LT
// Source hash: md5:e4b09fef9aaa5a3526cca69850398d27
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem MDIST_TRIANGLE_LT : forall A:set, forall m :e metric A, forall x y z :e A, forall a b :e R, x :e mspace A m /\ (y :e mspace A m /\ (z :e mspace A m /\ (mdist A m (x,y) < a /\ mdist A m (y,z) < b))) -> mdist A m (x,z) < a + b.
Admitted.

// HOL Light: Multivariate/metric.ml:33493 / WELLCHAINED_INTERS
// Source hash: md5:dffa2624fb283f4bb7f4062203e5e416
// Status: generalization_required (bridges: empty_case:A, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_topology, nat_le_SNoLe, nat_lt_SNoLt)
Theorem WELLCHAINED_INTERS : forall A:set, forall m :e metric A, forall s :e Power A :^: omega, forall d e0 :e R, d < e0 /\ ((forall n :e omega, compact_in A (mtopology A m) (s n)) /\ ((forall n :e omega, s (ordsucc n) c= s n) /\ (forall n :e omega, forall a b :e A, a :e s n /\ b :e s n -> exists p:set -> set, (forall x :e omega, p x :e A) /\ exists k :e omega, p 0 = a /\ (p k = b /\ ((forall i :e omega, i <= k -> p i :e s n) /\ forall i :e omega, i < k -> mdist A m (p i,p (ordsucc i)) < d))))) -> forall a b :e A, a :e {x :e A | forall Y :e {s n | n :e omega, n :e omega}, x :e Y} /\ b :e {x :e A | forall Y :e {s n | n :e omega, n :e omega}, x :e Y} -> exists p:set -> set, (forall x :e omega, p x :e A) /\ exists k :e omega, p 0 = a /\ (p k = b /\ ((forall i :e omega, i <= k -> p i :e {x :e A | forall Y :e {s n | n :e omega, n :e omega}, x :e Y}) /\ forall i :e omega, i < k -> mdist A m (p i,p (ordsucc i)) < e0)).
Admitted.

// HOL Light: Multivariate/metric.ml:33626 / fccoverable_space
// Source hash: md5:52e42eae33a4f3cd0dc1a8cb15e7fde5
// Status: transport_required (bridges: hol_finite_finite, hol_num_omega, hol_real_R, hol_typedef_metric, hol_typedef_topology, omega_Subq_R)
Theorem fccoverable_space_thm : forall A:set, A <> Empty -> forall m :e metric A, fccoverable_space A m <-> forall e0 :e R, 0 < e0 -> exists c c= Power A, finite c /\ (Union c = mspace A m /\ forall t c= A, t :e c -> connected_in A (mtopology A m) t /\ (mbounded A m t /\ mdiameter A m t <= e0)).
Admitted.

// HOL Light: Multivariate/metric.ml:33639 / ulc_space
// Source hash: md5:b1593a94de8b77ecc62a6576eb38b5ce
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_topology, omega_Subq_R)
Theorem ulc_space_thm : forall A:set, A <> Empty -> forall m :e metric A, ulc_space A m <-> forall e0 :e R, 0 < e0 -> exists d :e R, 0 < d /\ forall x y :e A, x :e mspace A m /\ (y :e mspace A m /\ mdist A m (x,y) < d) -> exists c c= A, x :e c /\ (y :e c /\ (c c= mspace A m /\ (connected_in A (mtopology A m) c /\ (mbounded A m c /\ mdiameter A m c <= e0)))).
Admitted.

// HOL Light: Multivariate/metric.ml:33651 / fccoverable_in
// Source hash: md5:e29ccab2b938f68306ce5949ce43c529
// Status: transport_required (bridges: hol_finite_finite, hol_num_omega, hol_real_R, hol_typedef_metric, hol_typedef_topology, omega_Subq_R)
Theorem fccoverable_in_thm : forall A:set, A <> Empty -> forall s c= A, forall m :e metric A, fccoverable_in A m s <-> s c= mspace A m /\ forall e0 :e R, 0 < e0 -> exists c c= Power A, finite c /\ (Union c = s /\ forall t c= A, t :e c -> connected_in A (mtopology A m) t /\ (mbounded A m t /\ mdiameter A m t <= e0)).
Admitted.

