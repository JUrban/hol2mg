// Source hash: md5:a90c8651e792771441fe408f4909e87e
// Status: transport_required (bridges: hol_typedef_topology)
Theorem METRIZABLE_IMP_HAUSDORFF_SPACE : forall A:set, A <> Empty -> forall top :e topology A, metrizable_space A top -> hausdorff_space A top.
Admitted.

