// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, nat_le_SNoLe, omega_Subq_R)
Theorem cauchy_in_thm : forall A:set, A <> Empty -> forall m :e metric A, forall s:set -> set, (forall x :e omega, s x :e A) -> (cauchy_in A m s <-> (forall n :e omega, s n :e mspace A m) /\ forall e0 :e R, 0 < e0 -> exists N :e omega, forall n n' :e omega, N <= n /\ N <= n' -> mdist A m (s n,s n') < e0).
Admitted.

