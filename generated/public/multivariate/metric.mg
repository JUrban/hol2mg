// Status: transport_required (bridges: hol_list_finseq, hol_prod_setprod, hol_real_R, hol_typedef_topology)
Theorem PATH_CONNECTED_IN_EUCLIDEANREAL_INTERVAL : (forall a b :e R, path_connected_in R euclideanreal (closed_real_interval (seq_cons (a,b) seq_nil))) /\ forall a b :e R, path_connected_in R euclideanreal (open_real_interval (a,b)).
Admitted.

