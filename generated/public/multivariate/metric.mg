// Source hash: md5:38872ca22564c3e41ae149453c25f9a3
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem PROPER_MAP_FROM_COMPOSITION_RIGHT : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e topology A, forall top' :e topology B, forall top'' :e topology C, forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e B, g x :e C) -> hausdorff_space B top' /\ (proper_map A C (top,top'') (fun x:set => g (f x)) /\ (continuous_map A B (top,top') f /\ continuous_map B C (top',top'') g)) -> proper_map A B (top,top') f.
