// Status: transport_required (bridges: hol_typedef_topology)
Theorem LOCALLY_COMPACT_SPACE_CLOSED_SUBSET : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, locally_compact_space A top /\ closed_in A top s -> locally_compact_space A (subtopology A top s).
Admitted.

// HOL Light: Multivariate/metric.ml:17015 / LOCALLY_COMPACT_SPACE_OPEN_SUBSET
// Source hash: md5:ccb45829e62a8e16bdbaed32e9dd7dfb
// Status: transport_required (bridges: hol_typedef_topology)
Theorem LOCALLY_COMPACT_SPACE_OPEN_SUBSET : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, (hausdorff_space A top \/ regular_space A top) /\ (locally_compact_space A top /\ s :e top) -> locally_compact_space A (subtopology A top s).
Admitted.

