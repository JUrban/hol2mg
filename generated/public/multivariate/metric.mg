Theorem OPEN_IN_INTER_DERIVED_SET_OF_EQ : forall A:set, forall top :e topology A, forall s t c= A, s :e top -> s :/\: derived_set_of A top t = s :/\: derived_set_of A top (s :/\: t).
Admitted.

// HOL Light: Multivariate/metric.ml:1086 / closure_of
// Source hash: md5:4c7e8b283875053a0b2c19674271f055
// Status: transport_required (bridges: hol_typedef_topology)
Theorem closure_of_thm : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, closure_of A top s = {x :e A | x :e topspace A top /\ forall t c= A, x :e t /\ t :e top -> exists y :e A, y :e s /\ y :e t}.
Admitted.

