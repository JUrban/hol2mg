// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem QUOTIENT_MAP_PROD_LEFT : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top1 :e topology A, forall top2 :e topology B, forall top :e topology C, forall f:set -> set, (forall x :e A, f x :e B) -> locally_compact_space C top /\ ((hausdorff_space C top \/ regular_space C top) /\ quotient_map A B (top1,top2) f) -> quotient_map (A :*: C) (B :*: C) (prod_topology A C top1 top,prod_topology B C top2 top) (fun p:set => (f (p 0),p 1)).
Admitted.

