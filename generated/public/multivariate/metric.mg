// Status: transport_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_topology)
Theorem PATH_IN_COMPOSE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e R, g x :e A) -> path_in A top g /\ continuous_map A B (top,top') f -> path_in B top' (fun x:set => f (g x)).
