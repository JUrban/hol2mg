Theorem HOMEOMORPHIC_EQ_INJECTIVE_PERFECT_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> (homeomorphic_map A B (top,top') f <-> perfect_map A B (top,top') f /\ forall x y :e A, x :e topspace A top /\ y :e topspace A top -> (f x = f y <-> x = y)).
