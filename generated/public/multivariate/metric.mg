Theorem QUASI_EQ_CONNECTED_COMPONENTS_OF_ALT : forall A:set, A <> Empty -> forall top :e topology A, quasi_components_of A top = connected_components_of A top <-> forall c c= A, c :e quasi_components_of A top -> connected_in A top c.
Admitted.

