// Status: transport_required (bridges: hol_list_finseq, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_topology, omega_Subq_R)
Theorem homotopic_with_thm : forall A B:set, A <> Empty -> B <> Empty -> forall X :e topology B, forall Y :e topology A, forall p:set -> set, (forall x :e B, p x :e A) -> forall q:set -> set, (forall x :e B, q x :e A) -> forall P c= A :^: B, homotopic_with A B P (X,Y) p q <-> exists h:set -> set, (forall x :e R :*: B, h x :e A) /\ (continuous_map (R :*: B) A (prod_topology R B (subtopology R euclideanreal (closed_real_interval (seq_cons (0,1) seq_nil))) X,Y) h /\ ((forall x :e B, h (0,x) = p x) /\ ((forall x :e B, h (1,x) = q x) /\ forall t :e R, t :e closed_real_interval (seq_cons (0,1) seq_nil) -> (fun x :e B => h (t,x)) :e P))).
Admitted.

