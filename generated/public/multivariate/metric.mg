Theorem LIPSCHITZ_CONTINUOUS_MAP_ID : forall A:set, A <> Empty -> forall m1 :e metric A, lipschitz_continuous_map A A (m1,m1) (fun x:set => x).
Admitted.

// HOL Light: Multivariate/metric.ml:30451 / LIPSCHITZ_CONTINUOUS_MAP_COMPOSE
// Source hash: md5:d6acb9afa5f9fcb815d622194be1b347
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_metric)
Theorem LIPSCHITZ_CONTINUOUS_MAP_COMPOSE : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall m1 :e metric A, forall m2 :e metric B, forall m3 :e metric C, forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e B, g x :e C) -> lipschitz_continuous_map B A (m1,m2) f /\ lipschitz_continuous_map C B (m2,m3) g -> lipschitz_continuous_map C A (m1,m3) (fun x:set => g (f x)).
Admitted.

// HOL Light: Multivariate/metric.ml:30464 / uniformly_continuous_map
// Source hash: md5:2fcc740ac80bfe0c684d42f84a050710
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, omega_Subq_R)
Theorem uniformly_continuous_map_thm : forall A B:set, A <> Empty -> B <> Empty -> forall m1 :e metric B, forall m2 :e metric A, forall f:set -> set, (forall x :e B, f x :e A) -> (uniformly_continuous_map A B (m1,m2) f <-> {f x | x :e mspace B m1} c= mspace A m2 /\ forall e0 :e R, 0 < e0 -> exists d :e R, 0 < d /\ forall x x' :e B, x :e mspace B m1 /\ (x' :e mspace B m1 /\ mdist B m1 (x',x) < d) -> mdist A m2 (f x',f x) < e0).
Admitted.

