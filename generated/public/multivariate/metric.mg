Admitted.

// HOL Light: Multivariate/metric.ml:39603 / CFUNSPACE_MDIST_LT
// Source hash: md5:5dc33404b94090cca397f49e7b707396
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_topology)
Theorem CFUNSPACE_MDIST_LT : forall A B:set, B <> Empty -> forall top :e topology A, forall m :e metric B, forall f g :e B :^: A, forall a :e R, forall x :e A, compact_in A top (topspace A top) /\ (f :e mspace (B :^: A) (cfunspace A B top m) /\ (g :e mspace (B :^: A) (cfunspace A B top m) /\ (mdist (B :^: A) (cfunspace A B top m) (f,g) < a /\ x :e topspace A top))) -> mdist B m (f x,g x) < a.
