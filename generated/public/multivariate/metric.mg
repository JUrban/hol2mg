// HOL Light: Multivariate/metric.ml:26424 / QUASI_COMPONENT_OF_EQ_OVERLAP
// Source hash: md5:de5cd6bd093e4a9bf016d9cbc81f83d5
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem QUASI_COMPONENT_OF_EQ_OVERLAP : forall A:set, forall top :e topology A, forall x y :e A, (forall x0 :e A, quasi_component_of A top x x0 <-> quasi_component_of A top y x0) <-> ~ x :e topspace A top /\ ~ y :e topspace A top \/ ~ {x0 :e A | quasi_component_of A top x x0} :/\: {x0 :e A | quasi_component_of A top y x0} = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:26433 / QUASI_COMPONENT_OF_NONOVERLAP
