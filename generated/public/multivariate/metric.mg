Admitted.

// HOL Light: Multivariate/metric.ml:9438 / PROPER_MAP_IN_SUBTOPOLOGY
// Source hash: md5:644789be9b02af36f49f5a64f2be3ef1
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem PROPER_MAP_IN_SUBTOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall s c= B, forall f:set -> set, (forall x :e A, f x :e B) -> closed_in B top' s -> (proper_map A B (top,subtopology B top' s) f <-> proper_map A B (top,top') f /\ {f x | x :e topspace A top} c= s).
Admitted.

