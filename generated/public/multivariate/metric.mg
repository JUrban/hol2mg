// Status: transport_required (bridges: hol_typedef_net)
Theorem EVENTUALLY_MONO : forall A:set, A <> Empty -> forall net0 :e net A, forall p q c= A, (forall x :e A, x :e p -> x :e q) /\ eventually A p net0 -> eventually A q net0.
Admitted.

