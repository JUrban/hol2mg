Admitted.

// HOL Light: Multivariate/metric.ml:44577 / DIMENSION_LE_CASES
// Source hash: md5:16408c3a4efbfa11e548a3f1aa3bdeca
// Status: transport_required (bridges: hol_int_int, hol_num_omega, hol_typedef_topology, omega_Subq_int)
Theorem DIMENSION_LE_CASES : forall A:set, A <> Empty -> forall a0 :e topology A, forall a1 :e int, dimension_le A a0 a1 <-> - 1 <= a1 /\ forall v c= A, forall a :e A, v :e a0 /\ a :e v -> exists u c= A, a :e u /\ (u c= v /\ (u :e a0 /\ dimension_le A (subtopology A a0 (frontier_of A a0 u)) (a1 + - 1))).
Admitted.

// HOL Light: Multivariate/metric.ml:44577 / DIMENSION_LE_INDUCT
// Source hash: md5:8aa29ba0fb86922635247d942765afbd
// Status: transport_required (bridges: hol_int_int, hol_num_omega, hol_typedef_topology, omega_Subq_int)
Theorem DIMENSION_LE_INDUCT : forall A:set, A <> Empty -> forall dimension_le':set -> set -> prop, (forall top :e topology A, forall n :e int, - 1 <= n /\ (forall v c= A, forall a :e A, v :e top /\ a :e v -> exists u c= A, a :e u /\ (u c= v /\ (u :e top /\ dimension_le' (subtopology A top (frontier_of A top u)) (n + - 1)))) -> dimension_le' top n) -> forall a0 :e topology A, forall a1 :e int, dimension_le A a0 a1 -> dimension_le' a0 a1.
Admitted.

// HOL Light: Multivariate/metric.ml:44577 / DIMENSION_LE_RULES
// Source hash: md5:511db359e68f324acebd294e6f503bb7
// Status: transport_required (bridges: hol_int_int, hol_num_omega, hol_typedef_topology, omega_Subq_int)
Theorem DIMENSION_LE_RULES : forall A:set, A <> Empty -> forall top :e topology A, forall n :e int, - 1 <= n /\ (forall v c= A, forall a :e A, v :e top /\ a :e v -> exists u c= A, a :e u /\ (u c= v /\ (u :e top /\ dimension_le A (subtopology A top (frontier_of A top u)) (n + - 1)))) -> dimension_le A top n.
Admitted.

// HOL Light: Multivariate/metric.ml:44586 / DIMENSION_LE_NEIGHBOURHOOD_BASE
