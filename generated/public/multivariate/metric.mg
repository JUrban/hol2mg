// Source hash: md5:1aec6626bd9864128600bd388317f956
// Status: transport_required (bridges: hol_typedef_topology)
Theorem REGULAR_CLOSURE_REFINEMENT_COVERS : forall A:set, A <> Empty -> forall top :e topology A, forall U c= Power A, regular_space A top /\ ((forall u c= A, u :e U -> u :e top) /\ Union U = topspace A top) -> Union {b :e Power A | b :e top /\ exists u c= A, u :e U /\ closure_of A top b c= u} = topspace A top.
Admitted.

// HOL Light: Multivariate/metric.ml:42262 / LF_COVERING_IMP_LF_CLOSED
// Source hash: md5:9dad3d12fa77e515173d7377bd061364
// Status: transport_required (bridges: hol_typedef_topology)
Theorem LF_COVERING_IMP_LF_CLOSED : forall A:set, A <> Empty -> forall top :e topology A, regular_space A top /\ (forall B c= Power A, (forall b c= A, b :e B -> b :e top) /\ Union B = topspace A top -> exists C c= Power A, Union C = topspace A top /\ (locally_finite_in A top C /\ forall c c= A, c :e C -> exists b c= A, b :e B /\ c c= b)) -> forall U c= Power A, (forall u c= A, u :e U -> u :e top) /\ Union U = topspace A top -> exists W c= Power A, Union W = topspace A top /\ (locally_finite_in A top W /\ ((forall w c= A, w :e W -> closed_in A top w) /\ forall w c= A, w :e W -> exists u c= A, u :e U /\ w c= u)).
Admitted.

// HOL Light: Multivariate/metric.ml:42326 / EXPANSION_SET_OPEN
// Source hash: md5:5edc56f3346ba9a6ff9b9cc5625c2c11
// Status: transport_required (bridges: hol_typedef_topology)
Theorem EXPANSION_SET_OPEN : forall A:set, A <> Empty -> forall top :e topology A, forall C c= Power A, forall b c= A, locally_finite_in A top C /\ ((forall c c= A, c :e C -> closed_in A top c) /\ b c= topspace A top) -> topspace A top :\: Union {c :e Power A | c :e C /\ c :/\: b = Empty} :e top.
Admitted.

