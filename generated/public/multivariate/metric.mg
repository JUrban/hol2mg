// Status: transport_required (bridges: hol_list_finseq, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_topology, omega_Subq_R)
Theorem completely_regular_space_thm : forall A:set, A <> Empty -> forall top :e topology A, completely_regular_space A top <-> forall s c= A, forall x :e A, closed_in A top s /\ x :e topspace A top :\: s -> exists f:set -> set, (forall x0 :e A, f x0 :e R) /\ (continuous_map A R (top,subtopology R euclideanreal (closed_real_interval (seq_cons (0,1) seq_nil))) f /\ (f x = 0 /\ forall x0 :e A, x0 :e s -> f x0 = 1)).
Admitted.

