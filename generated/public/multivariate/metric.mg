// Status: transport_required (bridges: hol_typedef_topology)
Theorem SECOND_COUNTABLE_IMP_LINDELOF_SPACE : forall A:set, A <> Empty -> forall top :e topology A, second_countable A top -> lindelof_space A top.
Admitted.

// HOL Light: Multivariate/metric.ml:10479 / net_tybij
// Source hash: md5:d7d089616de5f75437794a1190d8cd74
// Status: generalization_required (bridges: hol_prod_setprod, hol_typedef_net)
Theorem net_tybij : forall A:set, A <> Empty -> (forall a :e net A, a = a) /\ forall r :e Power (Power A) :*: Power A, (forall s t c= A, s :e r 0 /\ t :e r 0 -> s :/\: t :e r 0) <-> r = r.
Admitted.

// HOL Light: Multivariate/metric.ml:10486 / netfilter
// Source hash: md5:b0486ab12ad318521bb37caded036ece
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_net)
Theorem netfilter_thm : forall A:set, A <> Empty -> forall n :e net A, netfilter A n = n 0.
Admitted.

// HOL Light: Multivariate/metric.ml:10489 / netlimits
// Source hash: md5:c307bc2dc4a59258bbea58e6ac5cfe9b
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_net)
Theorem netlimits_thm : forall A:set, A <> Empty -> forall n :e net A, netlimits A n = n 1.
Admitted.

// HOL Light: Multivariate/metric.ml:10492 / netlimit
// Source hash: md5:b398cfee2b7b08c9c6dec595009f4046
// Status: transport_required (bridges: choose_in_spec, hol_typedef_net)
Theorem netlimit_thm : forall A:set, A <> Empty -> forall n :e net A, netlimit A n = choose_in A (fun x:set => x :e netlimits A n).
Admitted.

// HOL Light: Multivariate/metric.ml:10495 / NET
// Source hash: md5:f4925e0cd65839708305c707fb75dad1
// Status: generalization_required (bridges: empty_case:A, empty_case:B, hol_typedef_net)
Theorem NET : forall A B C:set, C <> Empty -> forall n :e net C, forall s :e A, forall t :e B, forall s0 t0 c= C, s0 :e netfilter C n /\ t0 :e netfilter C n -> s0 :/\: t0 :e netfilter C n.
Admitted.

// HOL Light: Multivariate/metric.ml:10506 / within
// Source hash: md5:c45af53fe7bf69915dd6ac2a712146fe
// Status: generalization_required (bridges: hol_prod_setprod, hol_typedef_net)
Theorem within_thm : forall A:set, A <> Empty -> forall s c= A, forall net0 :e net A, within A net0 s = (relative_to A (netfilter A net0) s,netlimits A net0).
Admitted.

// HOL Light: Multivariate/metric.ml:10509 / NETLIMITS_WITHIN
// Source hash: md5:60fcbf52938ac2dc3d62f15229699a13
// Status: transport_required (bridges: hol_typedef_net)
Theorem NETLIMITS_WITHIN : forall A:set, A <> Empty -> forall n :e net A, forall s c= A, netlimits A (within A n s) = netlimits A n.
Admitted.

// HOL Light: Multivariate/metric.ml:10509 / WITHIN
// Source hash: md5:cd3e47e2686a6a2e6a08afcdc1499f74
// Status: transport_required (bridges: hol_typedef_net)
Theorem WITHIN : forall A:set, A <> Empty -> forall n :e net A, forall s c= A, netfilter A (within A n s) = relative_to A (netfilter A n) s.
Admitted.

// HOL Light: Multivariate/metric.ml:10526 / NET_WITHIN_UNIV
// Source hash: md5:d29645dcab004ce6654b2ac8d82b72b3
// Status: transport_required (bridges: hol_typedef_net)
Theorem NET_WITHIN_UNIV : forall A:set, A <> Empty -> forall net0 :e net A, within A net0 A = net0.
Admitted.

// HOL Light: Multivariate/metric.ml:10535 / WITHIN_WITHIN
// Source hash: md5:97cebddce9d27e9fd4a5c58723517bb1
// Status: transport_required (bridges: hol_typedef_net)
Theorem WITHIN_WITHIN : forall A:set, A <> Empty -> forall net0 :e net A, forall s t c= A, within A (within A net0 s) t = within A net0 (s :/\: t).
Admitted.

// HOL Light: Multivariate/metric.ml:10548 / eventually
// Source hash: md5:6813e73aa9cd7853047e540feb2f784b
// Status: transport_required (bridges: hol_typedef_net)
Theorem eventually_thm : forall A:set, A <> Empty -> forall net0 :e net A, forall P c= A, eventually A P net0 <-> netfilter A net0 = Empty \/ exists u c= A, u :e netfilter A net0 /\ forall x :e A, x :e u :\: netlimits A net0 -> x :e P.
Admitted.

