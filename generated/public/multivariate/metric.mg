// Source hash: md5:ea816b81cdac4ad5faaddf0ee96f1983
// Status: transport_required (bridges: hol_typedef_topology)
Theorem METRIZABLE_IMP_FIRST_COUNTABLE : forall A:set, A <> Empty -> forall top :e topology A, metrizable_space A top -> first_countable A top.
Admitted.

