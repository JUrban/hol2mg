// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem QUASI_EQ_CONNECTED_COMPONENT_OF_EQ : forall A:set, forall top :e topology A, forall x :e A, (forall x0 :e A, quasi_component_of A top x x0 <-> connected_component_of A top x x0) <-> connected_in A top {x0 :e A | quasi_component_of A top x x0}.
