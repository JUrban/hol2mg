// Source hash: md5:e3ae72c5af91c11ccf2734b006699b25
// Status: transport_required (bridges: hol_typedef_metric)
Theorem MBOUNDED_EMPTY : forall A:set, A <> Empty -> forall m :e metric A, mbounded A m Empty.
Admitted.

