Theorem URYSOHN_COMPLETELY_REGULAR_CLOSED_COMPACT : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, forall a b :e R, a <= b /\ (completely_regular_space A top /\ (closed_in A top s /\ (compact_in A top t /\ s :/\: t = Empty))) -> exists f:set -> set, (forall x :e A, f x :e R) /\ (continuous_map A R (top,subtopology R euclideanreal (closed_real_interval (seq_cons (a,b) seq_nil))) f /\ ((forall x :e A, x :e t -> f x = a) /\ forall x :e A, x :e s -> f x = b)).
