// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem DISCRETE_SPACE_PROD_TOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, discrete_space (A :*: B) (prod_topology A B top1 top2) <-> topspace (A :*: B) (prod_topology A B top1 top2) = Empty \/ discrete_space A top1 /\ discrete_space B top2.
