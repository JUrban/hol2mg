// HOL Light: Multivariate/metric.ml:5101 / homeomorphic_map
// Source hash: md5:93a86d28d7e368eeb393ad4f8aa2a933
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem homeomorphic_map_thm : forall A B:set, A <> Empty -> B <> Empty -> forall top' :e topology B, forall top :e topology A, forall f:set -> set, (forall x :e A, f x :e B) -> (homeomorphic_map A B (top,top') f <-> quotient_map A B (top,top') f /\ forall x y :e A, x :e topspace A top /\ y :e topspace A top -> (f x = f y <-> x = y)).
Admitted.

// HOL Light: Multivariate/metric.ml:5107 / homeomorphic_maps
// Source hash: md5:02cf88904ad95228e1a11fcb153de3c8
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem homeomorphic_maps_thm : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f :e B :^: A, forall g :e A :^: B, homeomorphic_maps A B (top,top') (f,g) <-> continuous_map A B (top,top') (fun x:set => f x) /\ (continuous_map B A (top',top) (fun x:set => g x) /\ ((forall x :e A, x :e topspace A top -> g (f x) = x) /\ forall y :e B, y :e topspace B top' -> f (g y) = y)).
Admitted.

// HOL Light: Multivariate/metric.ml:5114 / HOMEOMORPHIC_MAP_EQ
// Source hash: md5:6f44892aac852e30271d9c239b5314f5
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HOMEOMORPHIC_MAP_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e A, g x :e B) -> (forall x :e A, x :e topspace A top -> f x = g x) /\ homeomorphic_map A B (top,top') f -> homeomorphic_map A B (top,top') g.
Admitted.

// HOL Light: Multivariate/metric.ml:5120 / HOMEOMORPHIC_MAPS_EQ
// Source hash: md5:1e247adb7e05722ff619bad631ef63ae
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HOMEOMORPHIC_MAPS_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f f' :e B :^: A, forall g g' :e A :^: B, (forall x :e A, x :e topspace A top -> f x = f' x) /\ ((forall x :e B, x :e topspace B top' -> g x = g' x) /\ homeomorphic_maps A B (top,top') (f,g)) -> homeomorphic_maps A B (top,top') (f',g').
Admitted.

// HOL Light: Multivariate/metric.ml:5133 / HOMEOMORPHIC_MAPS_SYM
// Source hash: md5:0d15f4959868c3481e43356ac8b63a92
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HOMEOMORPHIC_MAPS_SYM : forall A B:set, A <> Empty -> B <> Empty -> forall f :e B :^: A, forall g :e A :^: B, forall top :e topology A, forall top' :e topology B, homeomorphic_maps A B (top,top') (f,g) <-> homeomorphic_maps B A (top',top) (g,f).
Admitted.

