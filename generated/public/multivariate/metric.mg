// Source hash: md5:523e93a9f3b5f12ca04b6d5253062256
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem K_SPACE_AS_QUOTIENT : forall A:set, A <> Empty -> forall top :e topology A, k_space A top <-> exists q:set -> set, (forall x :e Power A :*: A, q x :e A) /\ exists top' :e topology (Power A :*: A), locally_compact_space (Power A :*: A) top' /\ quotient_map (Power A :*: A) A (top',top) q.
Admitted.

