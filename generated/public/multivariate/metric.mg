// HOL Light: Multivariate/metric.ml:44685 / DIMENSION_LE_EQ_SUBTOPOLOGY
// Source hash: md5:6f8c2e0e24f9f6e811f53cdd34d454ca
// Status: transport_required (bridges: hol_int_int, hol_num_omega, hol_typedef_topology, omega_Subq_int)
Theorem DIMENSION_LE_EQ_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, forall n :e int, dimension_le A (subtopology A top s) n <-> - 1 <= n /\ forall v c= A, forall a :e A, v :e top /\ (a :e v /\ a :e s) -> exists u c= A, a :e u /\ (u c= v /\ (u :e top /\ dimension_le A (subtopology A top (frontier_of A (subtopology A top s) (s :/\: u))) (n + - 1))).
Admitted.

