// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem PATH_COMPONENTS_OF_SUBSET : forall A:set, forall top :e topology A, forall c c= A, c :e path_components_of A top -> c c= topspace A top.
