// Status: transport_required (bridges: hol_typedef_topology)
Theorem PAIRWISE_DISJOINT_PATH_COMPONENTS_OF : forall A:set, A <> Empty -> forall top :e topology A, forall x y :e path_components_of A top, x <> y -> x :/\: y = Empty.
