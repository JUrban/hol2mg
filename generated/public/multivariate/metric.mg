// Status: transport_required (bridges: hol_typedef_topology)
Theorem CLOSURE_OF_SUBSET_TOPSPACE : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, closure_of A top s c= topspace A top.
Admitted.

