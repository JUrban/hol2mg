// Source hash: md5:ef4ff72d6f856ff395b19eb3e2744c1c
// Status: transport_required (bridges: hol_typedef_topology)
Theorem LF_COVERING_IMP_LF_OPEN : forall A:set, A <> Empty -> forall top :e topology A, regular_space A top /\ (forall B c= Power A, (forall b c= A, b :e B -> b :e top) /\ Union B = topspace A top -> exists C c= Power A, Union C = topspace A top /\ (locally_finite_in A top C /\ ((forall c c= A, c :e C -> closed_in A top c) /\ forall c c= A, c :e C -> exists b c= A, b :e B /\ c c= b))) -> forall U c= Power A, (forall u c= A, u :e U -> u :e top) /\ Union U = topspace A top -> exists W c= Power A, Union W = topspace A top /\ (locally_finite_in A top W /\ ((forall w c= A, w :e W -> w :e top) /\ forall w c= A, w :e W -> exists u c= A, u :e U /\ w c= u)).
Admitted.

// HOL Light: Multivariate/metric.ml:42596 / MICHAEL_LEMMA
// Source hash: md5:cf52a8b472e16b35d32de21b67185a25
// Status: transport_required (bridges: hol_typedef_topology)
Theorem MICHAEL_LEMMA : forall A:set, A <> Empty -> forall top :e topology A, regular_space A top -> (forall U c= Power A, (forall u c= A, u :e U -> u :e top) /\ Union U = topspace A top -> exists V c= Power A, (forall v c= A, v :e V -> v :e top) /\ (Union V = topspace A top /\ ((forall v c= A, v :e V -> exists u c= A, u :e U /\ v c= u) /\ sigma_locally_finite_in A top V))) -> forall U c= Power A, (forall u c= A, u :e U -> u :e top) /\ Union U = topspace A top -> exists V c= Power A, (forall v c= A, v :e V -> v :e top) /\ (Union V = topspace A top /\ ((forall v c= A, v :e V -> exists u c= A, u :e U /\ v c= u) /\ locally_finite_in A top V)).
Admitted.

