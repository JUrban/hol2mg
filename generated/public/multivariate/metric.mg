// HOL Light: Multivariate/metric.ml:30023 / prod_metric
// Source hash: md5:d95fa769e2b073f4d20df653ffa88d62
// Status: generalization_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem prod_metric_thm : forall A B:set, A <> Empty -> B <> Empty -> forall m1 :e metric A, forall m2 :e metric B, prod_metric A B m1 m2 = (mspace A m1 :*: mspace B m2,fun p :e A :*: B :*: (A :*: B) => if 0 <= mdist A m1 (p 0 0,p 1 0) ^ 2 + mdist B m2 (p 0 1,p 1 1) ^ 2 then sqrt_SNo_nonneg (mdist A m1 (p 0 0,p 1 0) ^ 2 + mdist B m2 (p 0 1,p 1 1) ^ 2) else - sqrt_SNo_nonneg (- (mdist A m1 (p 0 0,p 1 0) ^ 2 + mdist B m2 (p 0 1,p 1 1) ^ 2))).
Admitted.

// HOL Light: Multivariate/metric.ml:30029 / PROD_METRIC
// Source hash: md5:2dacb78c8af61d5ca814950d43928547
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem PROD_METRIC : forall A B:set, A <> Empty -> B <> Empty -> (forall m1 :e metric A, forall m2 :e metric B, mspace (A :*: B) (prod_metric A B m1 m2) = mspace A m1 :*: mspace B m2) /\ forall m1 :e metric A, forall m2 :e metric B, forall x :e A :*: B :*: (A :*: B), mdist (A :*: B) (prod_metric A B m1 m2) x = if 0 <= mdist A m1 (x 0 0,x 1 0) ^ 2 + mdist B m2 (x 0 1,x 1 1) ^ 2 then sqrt_SNo_nonneg (mdist A m1 (x 0 0,x 1 0) ^ 2 + mdist B m2 (x 0 1,x 1 1) ^ 2) else - sqrt_SNo_nonneg (- (mdist A m1 (x 0 0,x 1 0) ^ 2 + mdist B m2 (x 0 1,x 1 1) ^ 2)).
Admitted.

// HOL Light: Multivariate/metric.ml:30071 / COMPONENT_LE_PROD_METRIC
// Source hash: md5:a62681b717f192851e7d0fef5aed20e5
// Status: generalization_required (bridges: empty_case:A, empty_case:B, hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem COMPONENT_LE_PROD_METRIC : forall A B:set, forall m1 :e metric A, forall m2 :e metric B, forall x1 :e A, forall y1 :e B, forall x2 :e A, forall y2 :e B, mdist A m1 (x1,x2) <= mdist (A :*: B) (prod_metric A B m1 m2) ((x1,y1),(x2,y2)) /\ mdist B m2 (y1,y2) <= mdist (A :*: B) (prod_metric A B m1 m2) ((x1,y1),(x2,y2)).
Admitted.

// HOL Light: Multivariate/metric.ml:30079 / PROD_METRIC_LE_COMPONENTS
// Source hash: md5:8ae64c6a770750a6df71ca69e29f410a
// Status: generalization_required (bridges: empty_case:A, empty_case:B, hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem PROD_METRIC_LE_COMPONENTS : forall A B:set, forall m1 :e metric A, forall m2 :e metric B, forall x1 :e A, forall y1 :e B, forall x2 :e A, forall y2 :e B, x1 :e mspace A m1 /\ (x2 :e mspace A m1 /\ (y1 :e mspace B m2 /\ y2 :e mspace B m2)) -> mdist (A :*: B) (prod_metric A B m1 m2) ((x1,y1),(x2,y2)) <= mdist A m1 (x1,x2) + mdist B m2 (y1,y2).
Admitted.

