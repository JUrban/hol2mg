// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HOMEOMORPHIC_MAP_FSIGMANESS_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall top :e topology A, forall top' :e topology B, forall u c= A, homeomorphic_map A B (top,top') f -> (u :e fsigma_in A top <-> u c= topspace A top /\ {f x | x :e u} :e fsigma_in B top').
Admitted.

