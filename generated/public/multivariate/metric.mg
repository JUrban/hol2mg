// HOL Light: Multivariate/metric.ml:9982 / lindelof_space
// Source hash: md5:0ed48380f7c7224964e1d4681c9526bd
// Status: transport_required (bridges: hol_countable, hol_typedef_topology)
Theorem lindelof_space_thm : forall A:set, A <> Empty -> forall top :e topology A, lindelof_space A top <-> forall U c= Power A, (forall u c= A, u :e U -> u :e top) /\ Union U = topspace A top -> exists V c= Power A, countable V /\ (V c= U /\ Union V = topspace A top).
Admitted.

// HOL Light: Multivariate/metric.ml:9987 / LINDELOF_SPACE_ALT
// Source hash: md5:c21893b2d3c7c196093901f602611663
// Status: transport_required (bridges: hol_countable, hol_typedef_topology)
Theorem LINDELOF_SPACE_ALT : forall A:set, A <> Empty -> forall top :e topology A, lindelof_space A top <-> forall U c= Power A, (forall u c= A, u :e U -> u :e top) /\ topspace A top c= Union U -> exists V c= Power A, countable V /\ (V c= U /\ topspace A top c= Union V).
Admitted.

