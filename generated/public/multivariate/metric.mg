Theorem QUASI_EQ_CONNECTED_COMPONENTS_OF_INCLUSION : forall A:set, A <> Empty -> forall top :e topology A, quasi_components_of A top = connected_components_of A top <-> connected_components_of A top c= quasi_components_of A top \/ quasi_components_of A top c= connected_components_of A top.
Admitted.

// HOL Light: Multivariate/metric.ml:26965 / QUASI_EQ_CONNECTED_COMPONENTS_OF
// Source hash: md5:b560e4e0223038d99388a41d5848907b
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem QUASI_EQ_CONNECTED_COMPONENTS_OF : forall A:set, A <> Empty -> forall top :e topology A, finite (connected_components_of A top) \/ (finite (quasi_components_of A top) \/ (locally_connected_space A top \/ compact_space A top /\ (hausdorff_space A top \/ (regular_space A top \/ normal_space A top)))) -> quasi_components_of A top = connected_components_of A top.
Admitted.

