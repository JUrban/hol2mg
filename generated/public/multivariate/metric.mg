// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem HEREDITARILY_NORMAL_SEPARATION_PAIRWISE : forall A:set, A <> Empty -> forall top :e topology A, hereditarily A {x :e topology A | normal_space A x} top <-> forall u c= Power A, finite u /\ ((forall s c= A, s :e u -> s c= topspace A top) /\ (forall x y :e u, x <> y -> separated_in A top x y)) -> exists f :e Power A :^: Power A, (forall s c= A, s :e u -> f s :e top /\ s c= f s) /\ forall x y :e u, x <> y -> f x :/\: f y = Empty.
Admitted.

