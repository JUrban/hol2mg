// HOL Light: Multivariate/metric.ml:22091 / PATH_CONNECTED_IN
// Source hash: md5:3bb6d69f94d4f7500d7cf5fba601cce1
// Status: transport_required (bridges: hol_list_finseq, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_topology, omega_Subq_R)
Theorem PATH_CONNECTED_IN : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, path_connected_in A top s <-> s c= topspace A top /\ forall x y :e A, x :e s /\ y :e s -> exists g:set -> set, (forall x0 :e R, g x0 :e A) /\ (path_in A top g /\ ({g x | x :e closed_real_interval (seq_cons (0,1) seq_nil)} c= s /\ (g 0 = x /\ g 1 = y))).
