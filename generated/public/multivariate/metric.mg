// Source hash: md5:1cf4e868463f8e72e0a0731c858f6c4f
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem OPEN_MAP_INTO_K_SPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> k_space B top' /\ ({f x | x :e topspace A top} c= topspace B top' /\ (forall k c= B, compact_in B top' k -> open_map A B (subtopology A top {x :e A | x :e topspace A top /\ f x :e k},subtopology B top' k) f)) -> open_map A B (top,top') f.
Admitted.

