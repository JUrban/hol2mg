Theorem FORALL_OPEN_IN_HOMEOMORPHIC_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall top :e topology A, forall top' :e topology B, forall P:set -> prop, homeomorphic_map A B (top,top') f -> ((forall v c= B, v :e top' -> P v) <-> forall u c= A, u :e top -> P {f x | x :e u}).
