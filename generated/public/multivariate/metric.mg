Theorem path_connected_space_thm : forall A:set, A <> Empty -> forall top :e topology A, path_connected_space A top <-> forall x y :e A, x :e topspace A top /\ y :e topspace A top -> exists g:set -> set, (forall x0 :e R, g x0 :e A) /\ (path_in A top g /\ (g 0 = x /\ g 1 = y)).
