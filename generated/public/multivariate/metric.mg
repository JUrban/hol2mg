// Source hash: md5:54276090570033b2289372a03badaa28
// Status: generalization_required (bridges: empty_case:A, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, omega_Subq_R)
Theorem CENTRE_IN_MCBALL_EQ : forall A:set, forall m :e metric A, forall x :e A, forall r :e R, x :e mcball A m (x,r) <-> x :e mspace A m /\ 0 <= r.
Admitted.

