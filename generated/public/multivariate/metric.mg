// Source hash: md5:ea8b697d1882bfd8002ae5474bbaa392
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_IN_EQ_NOT_SEPARATED_SUBSET : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, connected_in A top s <-> s c= topspace A top /\ ~ exists c1 c2 c= A, s c= c1 :\/: c2 /\ (~ s :/\: c1 = Empty /\ (~ s :/\: c2 = Empty /\ separated_in A top c1 c2)).
Admitted.

// HOL Light: Multivariate/metric.ml:13380 / CONNECTED_SPACE_EQ_NOT_SEPARATED
// Source hash: md5:f7f47dc5239c375027b9780bfdcb0a34
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_SPACE_EQ_NOT_SEPARATED : forall A:set, A <> Empty -> forall top :e topology A, connected_space A top <-> ~ exists c1 c2 c= A, c1 :\/: c2 = topspace A top /\ (~ c1 = Empty /\ (~ c2 = Empty /\ separated_in A top c1 c2)).
Admitted.

// HOL Light: Multivariate/metric.ml:13388 / CONNECTED_SPACE_EQ_NOT_SEPARATED_SUBSET
// Source hash: md5:242574649068463700e2a48efe236ff9
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_SPACE_EQ_NOT_SEPARATED_SUBSET : forall A:set, A <> Empty -> forall top :e topology A, connected_space A top <-> ~ exists c1 c2 c= A, topspace A top c= c1 :\/: c2 /\ (~ c1 = Empty /\ (~ c2 = Empty /\ separated_in A top c1 c2)).
Admitted.

// HOL Light: Multivariate/metric.ml:13397 / CONNECTED_IN_SUBSET_SEPARATED_UNION
// Source hash: md5:0ad24d0ea6a12f991d4bb8ba9b2cb838
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_IN_SUBSET_SEPARATED_UNION : forall A:set, forall top :e topology A, forall s t c c= A, connected_in A top c /\ (separated_in A top s t /\ c c= s :\/: t) -> c c= s \/ c c= t.
Admitted.

// HOL Light: Multivariate/metric.ml:13406 / CONNECTED_IN_NONSEPARATED_UNION
// Source hash: md5:0febd185d75beff9ea5b11986e9c13f1
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_IN_NONSEPARATED_UNION : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, connected_in A top s /\ (connected_in A top t /\ ~ separated_in A top s t) -> connected_in A top (s :\/: t).
Admitted.

// HOL Light: Multivariate/metric.ml:13423 / CONNECTED_IN_UNIONS_STRONG
// Source hash: md5:f63952815c235dd9b0f69e43020b15f3
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_IN_UNIONS_STRONG : forall A:set, forall top :e topology A, forall f c= Power A, (forall s c= A, s :e f -> connected_in A top s) /\ ~ Union f :/\: {x :e A | forall Y :e {closure_of A top s | s :e Power A, s :e f}, x :e Y} = Empty -> connected_in A top (Union f).
Admitted.

// HOL Light: Multivariate/metric.ml:13473 / CONNECTED_IN_CHAIN
// Source hash: md5:9dfca09d7bf01ca1bca28925316815e3
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_IN_CHAIN : forall A:set, A <> Empty -> forall top :e topology A, forall f c= Power A, hausdorff_space A top /\ (~ f = Empty /\ ((forall s c= A, s :e f -> compact_in A top s /\ connected_in A top s) /\ (forall s t c= A, s :e f /\ t :e f -> s c= t \/ t c= s))) -> connected_in A top {x :e A | forall Y :e f, x :e Y}.
Admitted.

// HOL Light: Multivariate/metric.ml:13645 / CONNECTED_IN_CHAIN_GEN
// Source hash: md5:e353fb236c65ee88989fcbf1aad207e3
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_IN_CHAIN_GEN : forall A:set, A <> Empty -> forall top :e topology A, forall f c= Power A, hausdorff_space A top /\ ((forall s c= A, s :e f -> closed_in A top s /\ connected_in A top s) /\ ((exists s c= A, s :e f /\ compact_in A top s) /\ (forall s t c= A, s :e f /\ t :e f -> s c= t \/ t c= s))) -> connected_in A top {x :e A | forall Y :e f, x :e Y}.
Admitted.

// HOL Light: Multivariate/metric.ml:13672 / CONNECTED_IN_NEST
// Source hash: md5:adfdac0cbcda205684dc0128cbc8e8d4
// Status: transport_required (bridges: hol_num_omega, hol_typedef_topology, nat_le_SNoLe)
Theorem CONNECTED_IN_NEST : forall A:set, A <> Empty -> forall top :e topology A, forall s :e Power A :^: omega, hausdorff_space A top /\ ((forall n :e omega, compact_in A top (s n) /\ connected_in A top (s n)) /\ (forall m n :e omega, m <= n -> s n c= s m)) -> connected_in A top {x :e A | forall Y :e {s n | n :e omega, n :e omega}, x :e Y}.
Admitted.

// HOL Light: Multivariate/metric.ml:13685 / CONNECTED_IN_NEST_GEN
// Source hash: md5:d5400ee70f85a11b5f3e27aadfa7f335
// Status: transport_required (bridges: hol_num_omega, hol_typedef_topology, nat_le_SNoLe)
Theorem CONNECTED_IN_NEST_GEN : forall A:set, A <> Empty -> forall top :e topology A, forall s :e Power A :^: omega, hausdorff_space A top /\ ((forall n :e omega, closed_in A top (s n) /\ connected_in A top (s n)) /\ ((exists n :e omega, compact_in A top (s n)) /\ (forall m n :e omega, m <= n -> s n c= s m))) -> connected_in A top {x :e A | forall Y :e {s n | n :e omega, n :e omega}, x :e Y}.
Admitted.

// HOL Light: Multivariate/metric.ml:13700 / CONNECTED_IN_EQ_SUBSET_SEPARATED_UNION
// Source hash: md5:61c75d61c5a517834715dc858f56205f
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_IN_EQ_SUBSET_SEPARATED_UNION : forall A:set, A <> Empty -> forall top :e topology A, forall c c= A, connected_in A top c <-> c c= topspace A top /\ forall s t c= A, separated_in A top s t /\ c c= s :\/: t -> c c= s \/ c c= t.
Admitted.

// HOL Light: Multivariate/metric.ml:13717 / CONNECTED_IN_CLOPEN_CASES
// Source hash: md5:931aa446fb1edf30d84a914ac8f212c2
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_IN_CLOPEN_CASES : forall A:set, forall top :e topology A, forall c t c= A, connected_in A top c /\ (closed_in A top t /\ t :e top) -> c c= t \/ c :/\: t = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:13728 / CONNECTED_SPACE_CLOSURES
// Source hash: md5:b1985af3eeb615a861184e5908541780
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_SPACE_CLOSURES : forall A:set, A <> Empty -> forall top :e topology A, connected_space A top <-> ~ exists e1 e2 c= A, e1 :\/: e2 = topspace A top /\ (closure_of A top e1 :/\: closure_of A top e2 = Empty /\ (~ e1 = Empty /\ ~ e2 = Empty)).
Admitted.

// HOL Light: Multivariate/metric.ml:13749 / CONNECTED_IN_INTER_FRONTIER_OF
// Source hash: md5:74c26033ebba6ba7cef583d4d813b37c
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_IN_INTER_FRONTIER_OF : forall A:set, forall top :e topology A, forall s t c= A, connected_in A top s /\ (~ s :/\: t = Empty /\ ~ s :\: t = Empty) -> ~ s :/\: frontier_of A top t = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:13775 / CONNECTED_IN_CONTINUOUS_MAP_IMAGE
// Source hash: md5:aa7d9b146c85e5666e7b5975d8a9f3fc
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONNECTED_IN_CONTINUOUS_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall top :e topology A, forall top' :e topology B, forall s c= A, continuous_map A B (top,top') f /\ connected_in A top s -> connected_in B top' {f x | x :e s}.
Admitted.

// HOL Light: Multivariate/metric.ml:13792 / HOMEOMORPHIC_CONNECTED_SPACE
// Source hash: md5:fff8d53b644f08ed2e563a52fc3753d1
// Status: transport_required (bridges: hol_typedef_topology)
Theorem HOMEOMORPHIC_CONNECTED_SPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, homeomorphic_space A B top top' -> (connected_space A top <-> connected_space B top').
Admitted.

// HOL Light: Multivariate/metric.ml:13806 / HOMEOMORPHIC_MAP_CONNECTEDNESS
// Source hash: md5:104109fd7a3435b5f288d4ed982998fa
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HOMEOMORPHIC_MAP_CONNECTEDNESS : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall top :e topology A, forall top' :e topology B, forall u c= A, homeomorphic_map A B (top,top') f /\ u c= topspace A top -> (connected_in B top' {f x | x :e u} <-> connected_in A top u).
Admitted.

// HOL Light: Multivariate/metric.ml:13821 / HOMEOMORPHIC_MAP_CONNECTEDNESS_EQ
// Source hash: md5:2811024f07ee6c9707c954b70ede9c9f
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HOMEOMORPHIC_MAP_CONNECTEDNESS_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall top :e topology A, forall top' :e topology B, forall u c= A, homeomorphic_map A B (top,top') f -> (connected_in A top u <-> u c= topspace A top /\ connected_in B top' {f x | x :e u}).
Admitted.

// HOL Light: Multivariate/metric.ml:13828 / CONNECTED_SPACE_QUOTIENT_MAP_IMAGE
// Source hash: md5:d36107e5af91606255e04f83750e6b44
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONNECTED_SPACE_QUOTIENT_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall q:set -> set, (forall x :e A, q x :e B) -> quotient_map A B (top,top') q /\ connected_space A top -> connected_space B top'.
Admitted.

// HOL Light: Multivariate/metric.ml:13837 / CONNECTED_SPACE_RETRACTION_MAP_IMAGE
// Source hash: md5:3f17b7898a561cf39e2a7db308d4b344
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONNECTED_SPACE_RETRACTION_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall r:set -> set, (forall x :e A, r x :e B) -> retraction_map A B (top,top') r /\ connected_space A top -> connected_space B top'.
Admitted.

// HOL Light: Multivariate/metric.ml:13844 / CONNECTED_IN_DISCRETE_TOPOLOGY
// Source hash: md5:7b042ba4f6ee78580d5bb21237814af9
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_IN_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u s c= A, connected_in A (discrete_topology A u) s <-> s c= u /\ exists a :e A, s c= {a}.
Admitted.

// HOL Light: Multivariate/metric.ml:13864 / CONNECTED_SPACE_DISCRETE_TOPOLOGY
// Source hash: md5:1a7c9a878326c26b87ca557ea47eb69d
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_SPACE_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u c= A, connected_space A (discrete_topology A u) <-> exists a :e A, u c= {a}.
Admitted.

// HOL Light: Multivariate/metric.ml:13871 / CONNECTED_IN_IMP_PERFECT_GEN
// Source hash: md5:f4d6a97a5d9db40025cb88aa44adf8cf
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_IN_IMP_PERFECT_GEN : forall A:set, forall top :e topology A, forall s c= A, t1_space A top /\ (connected_in A top s /\ ~ (exists a :e A, s = {a})) -> s c= derived_set_of A top s.
Admitted.

// HOL Light: Multivariate/metric.ml:13888 / CONNECTED_IN_IMP_PERFECT
// Source hash: md5:28f99134ff57039a66338c78f08f3163
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_IN_IMP_PERFECT : forall A:set, forall top :e topology A, forall s c= A, hausdorff_space A top /\ (connected_in A top s /\ ~ (exists a :e A, s = {a})) -> s c= derived_set_of A top s.
Admitted.

// HOL Light: Multivariate/metric.ml:13894 / CARD_LE_PAIRWISE_SEPARATED_CONNECTED_IN
// Source hash: md5:359355f2b163965d36ef50ea3d545be1
// Status: transport_required (bridges: hol_finite_finite, hol_le_c_atleastp, hol_typedef_topology)
Theorem CARD_LE_PAIRWISE_SEPARATED_CONNECTED_IN : forall A:set, A <> Empty -> forall top :e topology A, forall u v c= Power A, finite u /\ ((forall x y :e u, x <> y -> separated_in A top x y) /\ ((forall c c= A, c :e u -> ~ c = Empty) /\ ((forall c c= A, c :e v -> connected_in A top c) /\ Union u = Union v))) -> atleastp u v.
Admitted.

// HOL Light: Multivariate/metric.ml:13918 / CONNECTED_SPACE_PROD_TOPOLOGY
// Source hash: md5:d6e2abaadc4a0913fb7b381eb2e2e4ba
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONNECTED_SPACE_PROD_TOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, connected_space (A :*: B) (prod_topology A B top1 top2) <-> topspace (A :*: B) (prod_topology A B top1 top2) = Empty \/ connected_space A top1 /\ connected_space B top2.
Admitted.

// HOL Light: Multivariate/metric.ml:13995 / CONNECTED_IN_CROSS
// Source hash: md5:21d5a767f473147b50ee49e90c003a4e
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONNECTED_IN_CROSS : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, forall s c= A, forall t c= B, connected_in (A :*: B) (prod_topology A B top1 top2) (s :*: t) <-> s = Empty \/ (t = Empty \/ connected_in A top1 s /\ connected_in B top2 t).
Admitted.

// HOL Light: Multivariate/metric.ml:14008 / CONNECTED_SPACE_PRODUCT_TOPOLOGY
// Source hash: md5:1c9a95ccc9e54a3fe170710408bc065a
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_SPACE_PRODUCT_TOPOLOGY : forall A K:set, A <> Empty -> K <> Empty -> forall tops:set -> set, (forall x :e K, tops x :e topology A) -> forall k c= K, connected_space (A :^: K) (product_topology A K k tops) <-> topspace (A :^: K) (product_topology A K k tops) = Empty \/ forall i :e K, i :e k -> connected_space A (tops i).
Admitted.

// HOL Light: Multivariate/metric.ml:14212 / CONNECTED_IN_CARTESIAN_PRODUCT
// Source hash: md5:b5fabc54d256313019c842d644f5bd43
// Status: transport_required (bridges: hol_fun_setexp, hol_typedef_topology)
Theorem CONNECTED_IN_CARTESIAN_PRODUCT : forall A K:set, A <> Empty -> K <> Empty -> forall tops:set -> set, (forall x :e K, tops x :e topology A) -> forall s :e Power A :^: K, forall k c= K, connected_in (A :^: K) (product_topology A K k tops) {f :e A :^: K | (forall i :e k, f i :e s i) /\ forall i :e K, ~ i :e k -> f i = choose_in A (fun y:set => False)} <-> {f :e A :^: K | (forall i :e k, f i :e s i) /\ forall i :e K, ~ i :e k -> f i = choose_in A (fun y:set => False)} = Empty \/ forall i :e K, i :e k -> connected_in A (tops i) (s i).
Admitted.

// HOL Light: Multivariate/metric.ml:14227 / separated_between
// Source hash: md5:74be5bf55ab7fb978b983a6be0d979db
// Status: transport_required (bridges: hol_typedef_topology)
Theorem separated_between_thm : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, separated_between A top s t <-> exists u v c= A, u :e top /\ (v :e top /\ (u :\/: v = topspace A top /\ (u :/\: v = Empty /\ (s c= u /\ t c= v)))).
Admitted.

// HOL Light: Multivariate/metric.ml:14233 / SEPARATED_BETWEEN_ALT
// Source hash: md5:4a525273bac7c7cc0e9ae1e5bd6116cc
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATED_BETWEEN_ALT : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, separated_between A top s t <-> exists u v c= A, closed_in A top u /\ (closed_in A top v /\ (u :\/: v = topspace A top /\ (u :/\: v = Empty /\ (s c= u /\ t c= v)))).
Admitted.

// HOL Light: Multivariate/metric.ml:14245 / SEPARATED_BETWEEN
// Source hash: md5:4c53d53d5e5313adfab6df5b24eec25e
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATED_BETWEEN : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, separated_between A top s t <-> exists u c= A, closed_in A top u /\ (u :e top /\ (s c= u /\ t c= topspace A top :\: u)).
Admitted.

// HOL Light: Multivariate/metric.ml:14258 / SEPARATED_BETWEEN_MONO
// Source hash: md5:6b1c2f32c20a770ee49286f715335269
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATED_BETWEEN_MONO : forall A:set, A <> Empty -> forall top :e topology A, forall s t s' t' c= A, separated_between A top s t /\ (s' c= s /\ t' c= t) -> separated_between A top s' t'.
Admitted.

// HOL Light: Multivariate/metric.ml:14268 / SEPARATED_BETWEEN_REFL
// Source hash: md5:b8ba8c4dcce10ff94874127301589368
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATED_BETWEEN_REFL : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, separated_between A top s s <-> s = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:14276 / SEPARATED_BETWEEN_SYM
// Source hash: md5:318a9eb0c7409b24d70d754fc0c42488
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATED_BETWEEN_SYM : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, separated_between A top s t <-> separated_between A top t s.
Admitted.

// HOL Light: Multivariate/metric.ml:14281 / SEPARATED_BETWEEN_IMP_SUBSET
// Source hash: md5:1d371b2cf9b7cb6072fc7a3f322b4ea7
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem SEPARATED_BETWEEN_IMP_SUBSET : forall A:set, forall top :e topology A, forall s t c= A, separated_between A top s t -> s c= topspace A top /\ t c= topspace A top.
Admitted.

// HOL Light: Multivariate/metric.ml:14288 / SEPARATED_BETWEEN_EMPTY
// Source hash: md5:002eafbe6b4af33a3de1c58b84dd1da1
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATED_BETWEEN_EMPTY : forall A:set, A <> Empty -> (forall top :e topology A, forall s c= A, separated_between A top Empty s <-> s c= topspace A top) /\ forall top :e topology A, forall s c= A, separated_between A top s Empty <-> s c= topspace A top.
Admitted.

// HOL Light: Multivariate/metric.ml:14297 / SEPARATED_BETWEEN_UNION
// Source hash: md5:b102831c23a6ddd70cc29ec0caa9b3e5
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATED_BETWEEN_UNION : forall A:set, A <> Empty -> (forall top :e topology A, forall s t u c= A, separated_between A top s (t :\/: u) <-> separated_between A top s t /\ separated_between A top s u) /\ forall top :e topology A, forall s t u c= A, separated_between A top (s :\/: t) u <-> separated_between A top s u /\ separated_between A top t u.
Admitted.

// HOL Light: Multivariate/metric.ml:14317 / SEPARATED_BETWEEN_IMP_DISJOINT
// Source hash: md5:376be33ace8d86cbc92875852d923173
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem SEPARATED_BETWEEN_IMP_DISJOINT : forall A:set, forall top :e topology A, forall s t c= A, separated_between A top s t -> s :/\: t = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:14321 / SEPARATED_BETWEEN_IMP_SEPARATED_IN
// Source hash: md5:419100737441fd9b8c5ed9388f61af42
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATED_BETWEEN_IMP_SEPARATED_IN : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, separated_between A top s t -> separated_in A top s t.
Admitted.

// HOL Light: Multivariate/metric.ml:14329 / SEPARATED_BETWEEN_FULL
// Source hash: md5:0a0af4c05a4ac21d5750210f97e3d594
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATED_BETWEEN_FULL : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, s :\/: t = topspace A top -> (separated_between A top s t <-> s :/\: t = Empty /\ (closed_in A top s /\ (s :e top /\ (closed_in A top t /\ t :e top)))).
Admitted.

// HOL Light: Multivariate/metric.ml:14351 / SEPARATED_BETWEEN_EQ_SEPARATED_IN
// Source hash: md5:3437fa8836a3ef57d468f5fc855e1dde
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATED_BETWEEN_EQ_SEPARATED_IN : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, s :\/: t = topspace A top -> (separated_between A top s t <-> separated_in A top s t).
Admitted.

// HOL Light: Multivariate/metric.ml:14357 / SEPARATED_BETWEEN_POINTWISE_LEFT
// Source hash: md5:ef550ba585e87bbb81b086ede8f2d70a
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATED_BETWEEN_POINTWISE_LEFT : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, compact_in A top s -> (separated_between A top s t <-> (s = Empty -> t c= topspace A top) /\ forall x :e A, x :e s -> separated_between A top {x} t).
Admitted.

// HOL Light: Multivariate/metric.ml:14385 / SEPARATED_BETWEEN_POINTWISE_RIGHT
// Source hash: md5:03f840d353678f8a03faa44e097460bb
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATED_BETWEEN_POINTWISE_RIGHT : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, compact_in A top t -> (separated_between A top s t <-> (t = Empty -> s c= topspace A top) /\ forall y :e A, y :e t -> separated_between A top s {y}).
Admitted.

// HOL Light: Multivariate/metric.ml:14394 / SEPARATED_BETWEEN_CLOSURE_OF
// Source hash: md5:b24d7152c46606ab3b621f805827a5a5
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATED_BETWEEN_CLOSURE_OF : forall A:set, A <> Empty -> (forall top :e topology A, forall s t c= A, s c= topspace A top -> (separated_between A top (closure_of A top s) t <-> separated_between A top s t)) /\ forall top :e topology A, forall s t c= A, t c= topspace A top -> (separated_between A top s (closure_of A top t) <-> separated_between A top s t).
Admitted.

// HOL Light: Multivariate/metric.ml:14407 / SEPARATED_BETWEEN_CLOSURE_OF_EQ
// Source hash: md5:e56b1e01b9e600b8a334b8da6bc4b314
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATED_BETWEEN_CLOSURE_OF_EQ : forall A:set, A <> Empty -> (forall top :e topology A, forall s t c= A, separated_between A top s t <-> s c= topspace A top /\ separated_between A top (closure_of A top s) t) /\ forall top :e topology A, forall s t c= A, separated_between A top s t <-> t c= topspace A top /\ separated_between A top s (closure_of A top t).
Admitted.

// HOL Light: Multivariate/metric.ml:14418 / SEPARATED_BETWEEN_FRONTIER_OF_EQ
// Source hash: md5:ba7695a9edaa476ae98e8b3fce577b30
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATED_BETWEEN_FRONTIER_OF_EQ : forall A:set, A <> Empty -> (forall top :e topology A, forall s t c= A, separated_between A top s t <-> s c= topspace A top /\ (s :/\: t = Empty /\ separated_between A top (frontier_of A top s) t)) /\ forall top :e topology A, forall s t c= A, separated_between A top s t <-> t c= topspace A top /\ (s :/\: t = Empty /\ separated_between A top s (frontier_of A top t)).
Admitted.

// HOL Light: Multivariate/metric.ml:14453 / SEPARATED_BETWEEN_FRONTIER_OF
// Source hash: md5:bf79862b1418083645d8c0884910c162
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATED_BETWEEN_FRONTIER_OF : forall A:set, A <> Empty -> (forall top :e topology A, forall s t c= A, s c= topspace A top /\ s :/\: t = Empty -> (separated_between A top (frontier_of A top s) t <-> separated_between A top s t)) /\ forall top :e topology A, forall s t c= A, t c= topspace A top /\ s :/\: t = Empty -> (separated_between A top s (frontier_of A top t) <-> separated_between A top s t).
Admitted.

// HOL Light: Multivariate/metric.ml:14464 / CONNECTED_SPACE_SEPARATED_BETWEEN
// Source hash: md5:e33c8a599ccd7bd93771497f64ca9f99
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_SPACE_SEPARATED_BETWEEN : forall A:set, A <> Empty -> forall top :e topology A, connected_space A top <-> forall s t c= A, separated_between A top s t -> s = Empty \/ t = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:14471 / CONNECTED_SPACE_IMP_SEPARATED_BETWEEN_TRIVIAL
// Source hash: md5:ab2e654ae925868f843dda769f20345a
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_SPACE_IMP_SEPARATED_BETWEEN_TRIVIAL : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, connected_space A top -> (separated_between A top s t <-> s = Empty /\ t c= topspace A top \/ s c= topspace A top /\ t = Empty).
Admitted.

// HOL Light: Multivariate/metric.ml:14483 / connected_component_of
// Source hash: md5:0a7ddcb66f15db32eed243cf2494b120
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem connected_component_of_thm : forall A:set, forall top :e topology A, forall x y :e A, connected_component_of A top x y <-> exists t c= A, connected_in A top t /\ (x :e t /\ y :e t).
Admitted.

// HOL Light: Multivariate/metric.ml:14487 / connected_components_of
// Source hash: md5:4a37f307f3337b73fc6cf6814627aca8
// Status: transport_required (bridges: hol_typedef_topology)
Theorem connected_components_of_thm : forall A:set, A <> Empty -> forall top :e topology A, connected_components_of A top = {{x0 :e A | connected_component_of A top x x0} | x :e A, x :e topspace A top}.
Admitted.

// HOL Light: Multivariate/metric.ml:14491 / CONNECTED_COMPONENT_IN_TOPSPACE
// Source hash: md5:cefd26bec6768398065ecafe5d5f4eaf
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_COMPONENT_IN_TOPSPACE : forall A:set, forall top :e topology A, forall x y :e A, connected_component_of A top x y -> x :e topspace A top /\ y :e topspace A top.
Admitted.

// HOL Light: Multivariate/metric.ml:14498 / CONNECTED_COMPONENT_OF_REFL
// Source hash: md5:ede43c2c90bbfdee9e2ee648ccb610e6
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_COMPONENT_OF_REFL : forall A:set, forall top :e topology A, forall x :e A, connected_component_of A top x x <-> x :e topspace A top.
Admitted.

// HOL Light: Multivariate/metric.ml:14505 / CONNECTED_COMPONENT_OF_SYM
// Source hash: md5:6335ccd741e6eee1239475ecae80fb71
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_COMPONENT_OF_SYM : forall A:set, forall top :e topology A, forall x y :e A, connected_component_of A top x y <-> connected_component_of A top y x.
Admitted.

// HOL Light: Multivariate/metric.ml:14510 / CONNECTED_COMPONENT_OF_TRANS
// Source hash: md5:9731b1ad7b6ca090a4be6e00346b6bd8
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_COMPONENT_OF_TRANS : forall A:set, forall top :e topology A, forall x y z :e A, connected_component_of A top x y /\ connected_component_of A top y z -> connected_component_of A top x z.
Admitted.

// HOL Light: Multivariate/metric.ml:14522 / CONNECTED_COMPONENT_OF_SUBTOPOLOGY
// Source hash: md5:ce745a183a155e737029afdaeb914bf7
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_COMPONENT_OF_SUBTOPOLOGY : forall A:set, forall top :e topology A, forall s c= A, forall x y :e A, connected_component_of A (subtopology A top s) x y -> connected_component_of A top x y.
Admitted.

// HOL Light: Multivariate/metric.ml:14529 / CONNECTED_COMPONENT_OF_MONO
// Source hash: md5:e7c9a2435dba6bd9531d4033024e47b3
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_COMPONENT_OF_MONO : forall A:set, forall top :e topology A, forall s t c= A, forall x y :e A, connected_component_of A (subtopology A top s) x y /\ s c= t -> connected_component_of A (subtopology A top t) x y.
Admitted.

// HOL Light: Multivariate/metric.ml:14536 / CONNECTED_COMPONENT_OF_SET
// Source hash: md5:522c1abb1fd91c12fb08ddac2b96e140
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_COMPONENT_OF_SET : forall A:set, forall top :e topology A, forall x x0 :e A, connected_component_of A top x x0 <-> x0 :e {y :e A | exists t c= A, connected_in A top t /\ (x :e t /\ y :e t)}.
Admitted.

// HOL Light: Multivariate/metric.ml:14543 / CONNECTED_COMPONENT_OF_SUBSET_TOPSPACE
// Source hash: md5:4e0ef1441a243174962fee9f74bbd39f
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_COMPONENT_OF_SUBSET_TOPSPACE : forall A:set, forall top :e topology A, forall x :e A, {x0 :e A | connected_component_of A top x x0} c= topspace A top.
Admitted.

// HOL Light: Multivariate/metric.ml:14547 / CONNECTED_COMPONENT_OF_SUBTOPOLOGY_EQ
// Source hash: md5:19843e45f401a6971e3e371eb5ce8d76
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_COMPONENT_OF_SUBTOPOLOGY_EQ : forall A:set, forall top :e topology A, forall u c= A, forall x :e A, (forall x0 :e A, connected_component_of A (subtopology A top u) x x0 <-> connected_component_of A top x x0) <-> {x0 :e A | connected_component_of A top x x0} c= u.
Admitted.

// HOL Light: Multivariate/metric.ml:14555 / CONNECTED_COMPONENTS_OF_SUBTOPOLOGY
// Source hash: md5:f3b8258a96ba8eed195199e3e9b4a067
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_COMPONENTS_OF_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e topology A, forall u c c= A, c :e connected_components_of A top /\ c c= u -> c :e connected_components_of A (subtopology A top u).
Admitted.

// HOL Light: Multivariate/metric.ml:14569 / CONNECTED_COMPONENT_OF_EQ_EMPTY
// Source hash: md5:3b360b1882a694b84da90f2add69dcc1
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_COMPONENT_OF_EQ_EMPTY : forall A:set, forall top :e topology A, forall x :e A, (forall x0 :e A, connected_component_of A top x x0 <-> x0 :e Empty) <-> ~ x :e topspace A top.
Admitted.

// HOL Light: Multivariate/metric.ml:14574 / CONNECTED_SPACE_IFF_CONNECTED_COMPONENT
// Source hash: md5:6777c5aee547348076680bcd9f40a310
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_SPACE_IFF_CONNECTED_COMPONENT : forall A:set, A <> Empty -> forall top :e topology A, connected_space A top <-> forall x y :e A, x :e topspace A top /\ y :e topspace A top -> connected_component_of A top x y.
Admitted.

// HOL Light: Multivariate/metric.ml:14582 / CONNECTED_SPACE_IMP_CONNECTED_COMPONENT_OF
// Source hash: md5:357e44f4924e3d0a86b19948ad29b67b
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_SPACE_IMP_CONNECTED_COMPONENT_OF : forall A:set, forall top :e topology A, forall a b :e A, connected_space A top /\ (a :e topspace A top /\ b :e topspace A top) -> connected_component_of A top a b.
Admitted.

// HOL Light: Multivariate/metric.ml:14588 / CONNECTED_SPACE_CONNECTED_COMPONENT_SET
// Source hash: md5:8782d4698839b48dd38d72fe335d8f88
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_SPACE_CONNECTED_COMPONENT_SET : forall A:set, A <> Empty -> forall top :e topology A, connected_space A top <-> forall x :e A, x :e topspace A top -> forall x0 :e A, connected_component_of A top x x0 <-> x0 :e topspace A top.
Admitted.

// HOL Light: Multivariate/metric.ml:14596 / CONNECTED_COMPONENT_OF_MAXIMAL
// Source hash: md5:d8b25915b0b271d97dc438c880ff13ea
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_COMPONENT_OF_MAXIMAL : forall A:set, forall top :e topology A, forall s c= A, forall x :e A, connected_in A top s /\ x :e s -> s c= {x0 :e A | connected_component_of A top x x0}.
Admitted.

// HOL Light: Multivariate/metric.ml:14603 / CONNECTED_COMPONENT_OF_EQUIV
// Source hash: md5:f59f760b17700ad2c1bd830a04e1d423
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_COMPONENT_OF_EQUIV : forall A:set, forall top :e topology A, forall x y :e A, connected_component_of A top x y <-> x :e topspace A top /\ (y :e topspace A top /\ forall x0 :e A, connected_component_of A top x x0 <-> connected_component_of A top y x0).
Admitted.

// HOL Light: Multivariate/metric.ml:14612 / CONNECTED_COMPONENT_OF_DISJOINT
// Source hash: md5:a6877adb233614bcac29f5a67948e932
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_COMPONENT_OF_DISJOINT : forall A:set, forall top :e topology A, forall x y :e A, {x0 :e A | connected_component_of A top x x0} :/\: {x0 :e A | connected_component_of A top y x0} = Empty <-> ~ connected_component_of A top x y.
Admitted.

// HOL Light: Multivariate/metric.ml:14621 / CONNECTED_COMPONENT_OF_EQ
// Source hash: md5:24990be6fe6e8ffc959e68b3cbd09977
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_COMPONENT_OF_EQ : forall A:set, forall top :e topology A, forall x y :e A, (forall x0 :e A, connected_component_of A top x x0 <-> connected_component_of A top y x0) <-> ~ x :e topspace A top /\ ~ y :e topspace A top \/ x :e topspace A top /\ (y :e topspace A top /\ connected_component_of A top x y).
Admitted.

// HOL Light: Multivariate/metric.ml:14630 / CONNECTED_IN_CONNECTED_COMPONENT_OF
// Source hash: md5:f9284ea08fb671222dc4c1aa6f1023cc
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
