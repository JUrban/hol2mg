// Source hash: md5:de75415dad9d60d19ed99ed06cb57251
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_IN_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, connected_in A (subtopology A top s) t <-> connected_in A top t /\ t c= s.
Admitted.

// HOL Light: Multivariate/metric.ml:13099 / CONNECTED_SPACE_EQ
// Source hash: md5:c4e0faf749bf622c2d33aec8a757cb55
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_SPACE_EQ : forall A:set, A <> Empty -> forall top :e topology A, connected_space A top <-> ~ exists e1 e2 c= A, e1 :e top /\ (e2 :e top /\ (e1 :\/: e2 = topspace A top /\ (e1 :/\: e2 = Empty /\ (~ e1 = Empty /\ ~ e2 = Empty)))).
Admitted.

// HOL Light: Multivariate/metric.ml:13109 / CONNECTED_SPACE_CLOSED_IN
// Source hash: md5:697e2b461344b4c163a13f58b64300dd
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_SPACE_CLOSED_IN : forall A:set, A <> Empty -> forall top :e topology A, connected_space A top <-> ~ exists e1 e2 c= A, closed_in A top e1 /\ (closed_in A top e2 /\ (topspace A top c= e1 :\/: e2 /\ (e1 :/\: e2 = Empty /\ (~ e1 = Empty /\ ~ e2 = Empty)))).
Admitted.

// HOL Light: Multivariate/metric.ml:13126 / CONNECTED_SPACE_CLOSED_IN_EQ
// Source hash: md5:3d2c8df17e570c5dbe9db2c5b2b8a651
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_SPACE_CLOSED_IN_EQ : forall A:set, A <> Empty -> forall top :e topology A, connected_space A top <-> ~ exists e1 e2 c= A, closed_in A top e1 /\ (closed_in A top e2 /\ (e1 :\/: e2 = topspace A top /\ (e1 :/\: e2 = Empty /\ (~ e1 = Empty /\ ~ e2 = Empty)))).
Admitted.

// HOL Light: Multivariate/metric.ml:13136 / CONNECTED_SPACE_CLOPEN_IN
// Source hash: md5:f46ea8e27dd21da72f5196715acfd8c5
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_SPACE_CLOPEN_IN : forall A:set, A <> Empty -> forall top :e topology A, connected_space A top <-> forall t c= A, t :e top /\ closed_in A top t -> t = Empty \/ t = topspace A top.
Admitted.

// HOL Light: Multivariate/metric.ml:13151 / CONNECTED_SPACE_EQ_FRONTIER_EQ_EMPTY
// Source hash: md5:a46120bf654f3592729cccf60fc1f1bf
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_SPACE_EQ_FRONTIER_EQ_EMPTY : forall A:set, A <> Empty -> forall top :e topology A, connected_space A top <-> forall s c= A, s c= topspace A top /\ frontier_of A top s = Empty -> s = Empty \/ s = topspace A top.
Admitted.

// HOL Light: Multivariate/metric.ml:13159 / CONNECTED_SPACE_FRONTIER_EQ_EMPTY
// Source hash: md5:07aa864fa8e66319c219249d5865fe1b
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_SPACE_FRONTIER_EQ_EMPTY : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, connected_space A top /\ s c= topspace A top -> (frontier_of A top s = Empty <-> s = Empty \/ s = topspace A top).
Admitted.

// HOL Light: Multivariate/metric.ml:13166 / CONNECTED_IN
// Source hash: md5:95b2e6dfb80576c8fd2b51a2da5fddc2
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_IN : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, connected_in A top s <-> s c= topspace A top /\ ~ exists e1 e2 c= A, e1 :e top /\ (e2 :e top /\ (s c= e1 :\/: e2 /\ (e1 :/\: (e2 :/\: s) = Empty /\ (~ e1 :/\: s = Empty /\ ~ e2 :/\: s = Empty)))).
Admitted.

// HOL Light: Multivariate/metric.ml:13186 / CONNECTED_IN_CLOSED_IN
// Source hash: md5:e378b2e2cafa400d449aa31a422bb26b
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_IN_CLOSED_IN : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, connected_in A top s <-> s c= topspace A top /\ ~ exists e1 e2 c= A, closed_in A top e1 /\ (closed_in A top e2 /\ (s c= e1 :\/: e2 /\ (e1 :/\: (e2 :/\: s) = Empty /\ (~ e1 :/\: s = Empty /\ ~ e2 :/\: s = Empty)))).
Admitted.

// HOL Light: Multivariate/metric.ml:13206 / CONNECTED_IN_EMPTY
// Source hash: md5:e841b292908fa083a8779a683a86cbdc
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_IN_EMPTY : forall A:set, A <> Empty -> forall top :e topology A, connected_in A top Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:13210 / CONNECTED_SPACE_TOPSPACE_EMPTY
// Source hash: md5:fef7fe6173a2c73914ff31e044d172dd
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_SPACE_TOPSPACE_EMPTY : forall A:set, A <> Empty -> forall top :e topology A, topspace A top = Empty -> connected_space A top.
Admitted.

// HOL Light: Multivariate/metric.ml:13214 / CONNECTED_IN_SING
// Source hash: md5:9285b4c7587ea70eb0601ebe52b336f1
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_IN_SING : forall A:set, forall top :e topology A, forall a :e A, connected_in A top {a} <-> a :e topspace A top.
Admitted.

// HOL Light: Multivariate/metric.ml:13220 / CONNECTED_IN_ABSOLUTE
// Source hash: md5:bec2d457739b97ff94245a824dbc9f69
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_IN_ABSOLUTE : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, connected_in A (subtopology A top s) s <-> connected_in A top s.
Admitted.

// HOL Light: Multivariate/metric.ml:13226 / CONNECTED_IN_UNIONS
// Source hash: md5:32fb8a4def87f964439d6c78acd409eb
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_IN_UNIONS : forall A:set, forall top :e topology A, forall u c= Power A, (forall s c= A, s :e u -> connected_in A top s) /\ ~ {x :e A | forall Y :e u, x :e Y} = Empty -> connected_in A top (Union u).
Admitted.

// HOL Light: Multivariate/metric.ml:13255 / CONNECTED_IN_UNION
// Source hash: md5:21779b36017389a4ef786df79218099e
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_IN_UNION : forall A:set, forall top :e topology A, forall s t c= A, connected_in A top s /\ (connected_in A top t /\ ~ s :/\: t = Empty) -> connected_in A top (s :\/: t).
Admitted.

// HOL Light: Multivariate/metric.ml:13263 / CONNECTED_SPACE_SUBCONNECTED
// Source hash: md5:7b69392a77652e771d3022b8cf1e7901
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_SPACE_SUBCONNECTED : forall A:set, A <> Empty -> forall top :e topology A, connected_space A top <-> forall x y :e A, x :e topspace A top /\ y :e topspace A top -> exists s c= A, connected_in A top s /\ (x :e s /\ y :e s).
Admitted.

// HOL Light: Multivariate/metric.ml:13285 / CONNECTED_IN_INTERMEDIATE_CLOSURE_OF
// Source hash: md5:e4257946b46e80bc95904ea4768bf2aa
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_IN_INTERMEDIATE_CLOSURE_OF : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, connected_in A top s /\ (s c= t /\ t c= closure_of A top s) -> connected_in A top t.
Admitted.

// HOL Light: Multivariate/metric.ml:13306 / CONNECTED_IN_CLOSURE_OF
// Source hash: md5:1487256e8cd925350d16d86e154319c3
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_IN_CLOSURE_OF : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, connected_in A top s -> connected_in A top (closure_of A top s).
Admitted.

// HOL Light: Multivariate/metric.ml:13314 / CONNECTED_IN_SEPARATION
// Source hash: md5:c196651b1b09de3106690f7e70b24c60
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_IN_SEPARATION : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, connected_in A top s <-> s c= topspace A top /\ ~ exists c1 c2 c= A, c1 :\/: c2 = s /\ (~ c1 = Empty /\ (~ c2 = Empty /\ (c1 :/\: closure_of A top c2 = Empty /\ c2 :/\: closure_of A top c1 = Empty))).
Admitted.

// HOL Light: Multivariate/metric.ml:13314 / CONNECTED_IN_SEPARATION_ALT
// Source hash: md5:5f0f67524e5de385b0cd65a7ca8cdb45
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_IN_SEPARATION_ALT : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, connected_in A top s <-> s c= topspace A top /\ ~ exists c1 c2 c= A, s c= c1 :\/: c2 /\ (~ c1 :/\: s = Empty /\ (~ c2 :/\: s = Empty /\ (c1 :/\: closure_of A top c2 = Empty /\ c2 :/\: closure_of A top c1 = Empty))).
Admitted.

// HOL Light: Multivariate/metric.ml:13353 / CONNECTED_IN_EQ_NOT_SEPARATED
// Source hash: md5:150f526b04d9cf93905a27c25c5ee1a2
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_IN_EQ_NOT_SEPARATED : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, connected_in A top s <-> s c= topspace A top /\ ~ exists c1 c2 c= A, c1 :\/: c2 = s /\ (~ c1 = Empty /\ (~ c2 = Empty /\ separated_in A top c1 c2)).
Admitted.

