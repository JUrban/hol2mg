// Source hash: md5:73352db22cd59b31361d5bcd408552fc
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem SEPARATED_IN_IMP_DISJOINT : forall A:set, forall top :e topology A, forall s t c= A, separated_in A top s t -> s :/\: t = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:7532 / SEPARATED_IN_MONO
// Source hash: md5:ab0ad7c079ea2c564ac0672736554cf7
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATED_IN_MONO : forall A:set, A <> Empty -> forall top :e topology A, forall s t s' t' c= A, separated_in A top s t /\ (s' c= s /\ t' c= t) -> separated_in A top s' t'.
Admitted.

// HOL Light: Multivariate/metric.ml:7545 / SEPARATED_IN_OPEN_SETS
// Source hash: md5:eed20ab5c82bdaf068041bc317bcd5d9
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATED_IN_OPEN_SETS : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, s :e top /\ t :e top -> (separated_in A top s t <-> s :/\: t = Empty).
Admitted.

// HOL Light: Multivariate/metric.ml:7553 / SEPARATED_IN_CLOSED_SETS
// Source hash: md5:f75dead867bae6374d53de38e55ebae6
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATED_IN_CLOSED_SETS : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, closed_in A top s /\ closed_in A top t -> (separated_in A top s t <-> s :/\: t = Empty).
Admitted.

// HOL Light: Multivariate/metric.ml:7560 / SEPARATED_IN_COMPLEMENT
// Source hash: md5:a32f623893c70426f74b4c319ffbb1cd
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATED_IN_COMPLEMENT : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, separated_in A top s (topspace A top :\: s) <-> closed_in A top s /\ s :e top.
Admitted.

// HOL Light: Multivariate/metric.ml:7572 / SEPARATED_IN_SUBTOPOLOGY
// Source hash: md5:ca32c65c271acd316cd694b994657bbf
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATED_IN_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e topology A, forall u s t c= A, separated_in A (subtopology A top u) s t <-> s c= u /\ (t c= u /\ separated_in A top s t).
Admitted.

// HOL Light: Multivariate/metric.ml:7583 / SEPARATED_IN_DISCRETE_TOPOLOGY
// Source hash: md5:1b6d6ca3b5a277b9b077bc4cf180207a
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATED_IN_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u s t c= A, separated_in A (discrete_topology A u) s t <-> s c= u /\ (t c= u /\ s :/\: t = Empty).
Admitted.

// HOL Light: Multivariate/metric.ml:7590 / SEPARATED_EQ_DISTINGUISHABLE
// Source hash: md5:aa91252b74f36ac6706314e58b02a144
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem SEPARATED_EQ_DISTINGUISHABLE : forall A:set, forall top :e topology A, forall x y :e A, separated_in A top {x} {y} <-> x :e topspace A top /\ (y :e topspace A top /\ ((exists u c= A, u :e top /\ (x :e u /\ ~ y :e u)) /\ exists v c= A, v :e top /\ (y :e v /\ ~ x :e v))).
Admitted.

// HOL Light: Multivariate/metric.ml:7599 / SEPARATED_IN_UNION
// Source hash: md5:287b449e95210eaef6af7f1e80e25b98
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATED_IN_UNION : forall A:set, A <> Empty -> (forall top :e topology A, forall s t u c= A, separated_in A top s (t :\/: u) <-> separated_in A top s t /\ separated_in A top s u) /\ forall top :e topology A, forall s t u c= A, separated_in A top (s :\/: t) u <-> separated_in A top s u /\ separated_in A top t u.
Admitted.

// HOL Light: Multivariate/metric.ml:7608 / SEPARATED_IN_UNIONS
// Source hash: md5:0d6fcca1dbbb359b8fc3c165db650686
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem SEPARATED_IN_UNIONS : forall A:set, A <> Empty -> (forall top :e topology A, forall s c= A, forall u c= Power A, finite u -> (separated_in A top s (Union u) <-> s c= topspace A top /\ forall t c= A, t :e u -> separated_in A top s t)) /\ forall top :e topology A, forall s c= A, forall u c= Power A, finite u -> (separated_in A top (Union u) s <-> (forall t c= A, t :e u -> separated_in A top s t) /\ s c= topspace A top).
Admitted.

// HOL Light: Multivariate/metric.ml:7621 / SEPARATED_IN_DIFFS
// Source hash: md5:370f7abb9c797ee11be23731802d5223
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATED_IN_DIFFS : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, s :e top /\ t :e top \/ closed_in A top s /\ closed_in A top t -> separated_in A top (s :\: t) (t :\: s).
Admitted.

// HOL Light: Multivariate/metric.ml:7641 / SEPARATION_CLOSED_IN_UNION_GEN
// Source hash: md5:13094122ebd92de7e5792a2ffade5d51
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATION_CLOSED_IN_UNION_GEN : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, separated_in A top s t <-> s c= topspace A top /\ (t c= topspace A top /\ (s :/\: t = Empty /\ (closed_in A (subtopology A top (s :\/: t)) s /\ closed_in A (subtopology A top (s :\/: t)) t))).
Admitted.

// HOL Light: Multivariate/metric.ml:7652 / SEPARATION_OPEN_IN_UNION_GEN
// Source hash: md5:13341d532079adae8c99ad99c8a36b34
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATION_OPEN_IN_UNION_GEN : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, separated_in A top s t <-> s c= topspace A top /\ (t c= topspace A top /\ (s :/\: t = Empty /\ (s :e subtopology A top (s :\/: t) /\ t :e subtopology A top (s :\/: t)))).
Admitted.

// HOL Light: Multivariate/metric.ml:7668 / SEPARATED_IN_FULL
// Source hash: md5:1b4b70dd86a5303c02f8527ce6b6b32a
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARATED_IN_FULL : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, s :\/: t = topspace A top -> (separated_in A top s t <-> s :/\: t = Empty /\ (closed_in A top s /\ (s :e top /\ (closed_in A top t /\ t :e top)))).
Admitted.

// HOL Light: Multivariate/metric.ml:7683 / HOMEOMORPHIC_MAP_SEPARATION
// Source hash: md5:4be4c3bbe10f0e98ea0e6088173af299
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HOMEOMORPHIC_MAP_SEPARATION : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall top :e topology A, forall top' :e topology B, forall s t c= A, homeomorphic_map A B (top,top') f /\ (s c= topspace A top /\ t c= topspace A top) -> (separated_in B top' {f x | x :e s} {f x | x :e t} <-> separated_in A top s t).
Admitted.

// HOL Light: Multivariate/metric.ml:7705 / t1_space
// Source hash: md5:1e11da0bece913e7c6fb623f094975e2
// Status: transport_required (bridges: hol_typedef_topology)
Theorem t1_space_thm : forall A:set, A <> Empty -> forall top :e topology A, t1_space A top <-> forall x y :e A, x :e topspace A top /\ (y :e topspace A top /\ ~ x = y) -> exists u c= A, u :e top /\ (x :e u /\ ~ y :e u).
Admitted.

// HOL Light: Multivariate/metric.ml:7710 / T1_SPACE_EXPANSIVE
// Source hash: md5:76a173347d1ed5112fdf096a0dbcb98f
// Status: transport_required (bridges: hol_typedef_topology)
Theorem T1_SPACE_EXPANSIVE : forall A:set, A <> Empty -> forall top top' :e topology A, topspace A top' = topspace A top /\ (forall u c= A, u :e top -> u :e top') -> t1_space A top -> t1_space A top'.
Admitted.

// HOL Light: Multivariate/metric.ml:7716 / T1_SPACE_ALT
// Source hash: md5:7bd985017223521727e7c7e1a7fd6609
// Status: transport_required (bridges: hol_typedef_topology)
Theorem T1_SPACE_ALT : forall A:set, A <> Empty -> forall top :e topology A, t1_space A top <-> forall x y :e A, x :e topspace A top /\ (y :e topspace A top /\ ~ x = y) -> exists u c= A, closed_in A top u /\ (x :e u /\ ~ y :e u).
Admitted.

// HOL Light: Multivariate/metric.ml:7723 / T1_SPACE_SEPARATED_IN
// Source hash: md5:e8fcc4813bc357cf9a79bb937b8a7996
// Status: transport_required (bridges: hol_typedef_topology)
Theorem T1_SPACE_SEPARATED_IN : forall A:set, A <> Empty -> forall top :e topology A, t1_space A top <-> forall x y :e A, x :e topspace A top /\ (y :e topspace A top /\ ~ x = y) -> separated_in A top {x} {y}.
Admitted.

// HOL Light: Multivariate/metric.ml:7730 / T1_SPACE_DERIVED_SET_OF_SING
// Source hash: md5:95a4e086bb503b249da6c1f8d194eb30
// Status: transport_required (bridges: hol_typedef_topology)
Theorem T1_SPACE_DERIVED_SET_OF_SING : forall A:set, A <> Empty -> forall top :e topology A, t1_space A top <-> forall x :e A, x :e topspace A top -> derived_set_of A top {x} = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:7738 / T1_SPACE_DERIVED_SET_OF_FINITE
// Source hash: md5:019222050e27d735845b44d458cd8760
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem T1_SPACE_DERIVED_SET_OF_FINITE : forall A:set, A <> Empty -> forall top :e topology A, t1_space A top <-> forall s c= A, finite s -> derived_set_of A top s = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:7748 / T1_SPACE_CLOSED_IN_SING
// Source hash: md5:5e222a720b3e1f22a7e0973485596f96
// Status: transport_required (bridges: hol_typedef_topology)
Theorem T1_SPACE_CLOSED_IN_SING : forall A:set, A <> Empty -> forall top :e topology A, t1_space A top <-> forall x :e A, x :e topspace A top -> closed_in A top {x}.
Admitted.

// HOL Light: Multivariate/metric.ml:7758 / CLOSED_IN_T1_SING
// Source hash: md5:af16dfad62cf65f1b1955d1474193063
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CLOSED_IN_T1_SING : forall A:set, forall top :e topology A, forall a :e A, t1_space A top /\ a :e topspace A top -> closed_in A top {a}.
Admitted.

// HOL Light: Multivariate/metric.ml:7762 / T1_SPACE_CLOSED_IN_FINITE
// Source hash: md5:1d1b2ad3f14dcb9969b42984527d15fb
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem T1_SPACE_CLOSED_IN_FINITE : forall A:set, A <> Empty -> forall top :e topology A, t1_space A top <-> forall s c= A, finite s /\ s c= topspace A top -> closed_in A top s.
Admitted.

// HOL Light: Multivariate/metric.ml:7773 / CLOSURE_OF_SING
// Source hash: md5:4bc5f53d3424780135574453392787ba
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CLOSURE_OF_SING : forall A:set, forall top :e topology A, forall a :e A, t1_space A top -> closure_of A top {a} = if a :e topspace A top then {a} else Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:7784 / SEPARATED_IN_SING
// Source hash: md5:6a4a808ffee4193e74fbb0eb6fa1f899
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem SEPARATED_IN_SING : forall A:set, (forall top :e topology A, forall s c= A, forall a :e A, t1_space A top -> (separated_in A top {a} s <-> a :e topspace A top /\ (s c= topspace A top /\ ~ a :e closure_of A top s))) /\ forall top :e topology A, forall s c= A, forall a :e A, t1_space A top -> (separated_in A top s {a} <-> a :e topspace A top /\ (s c= topspace A top /\ ~ a :e closure_of A top s)).
Admitted.

// HOL Light: Multivariate/metric.ml:7801 / T1_SPACE_OPEN_IN_DELETE
// Source hash: md5:bfb0f145b9b1bd750cef7a23e60d3c38
// Status: transport_required (bridges: hol_typedef_topology)
Theorem T1_SPACE_OPEN_IN_DELETE : forall A:set, A <> Empty -> forall top :e topology A, t1_space A top <-> forall u c= A, forall x :e A, u :e top /\ x :e u -> u :\: {x} :e top.
Admitted.

// HOL Light: Multivariate/metric.ml:7816 / T1_SPACE_OPEN_IN_DELETE_ALT
// Source hash: md5:043b84a3fbaa1ba5a9d7e2ea3014e942
// Status: transport_required (bridges: hol_typedef_topology)
Theorem T1_SPACE_OPEN_IN_DELETE_ALT : forall A:set, A <> Empty -> forall top :e topology A, t1_space A top <-> forall u c= A, forall x :e A, u :e top -> u :\: {x} :e top.
Admitted.

// HOL Light: Multivariate/metric.ml:7822 / T1_SPACE_INTERS_OPEN_SUPERSETS
// Source hash: md5:f3f3151884df6cfa4335640fece2bf2c
// Status: transport_required (bridges: hol_typedef_topology)
Theorem T1_SPACE_INTERS_OPEN_SUPERSETS : forall A:set, A <> Empty -> forall top :e topology A, t1_space A top <-> forall s c= A, s c= topspace A top -> {x :e A | forall Y :e {u :e Power A | u :e top /\ s c= u}, x :e Y} = s.
Admitted.

// HOL Light: Multivariate/metric.ml:7822 / T1_SPACE_SING_INTERS_OPEN
// Source hash: md5:e3c68411d7fafd41f919193dcd6f4fb6
// Status: transport_required (bridges: hol_typedef_topology)
Theorem T1_SPACE_SING_INTERS_OPEN : forall A:set, A <> Empty -> forall top :e topology A, t1_space A top <-> forall x :e A, x :e topspace A top -> {x0 :e A | forall Y :e {u :e Power A | u :e top /\ x :e u}, x0 :e Y} = {x}.
Admitted.

// HOL Light: Multivariate/metric.ml:7846 / T1_SPACE_DERIVED_SET_OF_INFINITE_OPEN_IN
// Source hash: md5:ed4420ce9821c456c03de44bc46b6d96
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem T1_SPACE_DERIVED_SET_OF_INFINITE_OPEN_IN : forall A:set, A <> Empty -> forall top :e topology A, t1_space A top <-> forall s c= A, derived_set_of A top s = {x :e A | x :e topspace A top /\ forall u c= A, x :e u /\ u :e top -> infinite (s :/\: u)}.
Admitted.

// HOL Light: Multivariate/metric.ml:7872 / FINITE_T1_SPACE_IMP_DISCRETE_TOPOLOGY
// Source hash: md5:9a1cb3b2135d32874d18a25dd86f9f64
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem FINITE_T1_SPACE_IMP_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall top :e topology A, forall u c= A, topspace A top = u /\ (finite u /\ t1_space A top) -> top = discrete_topology A u.
Admitted.

// HOL Light: Multivariate/metric.ml:7880 / T1_SPACE_SUBTOPOLOGY
// Source hash: md5:84500e500f549a1967b27e9ff2886db5
// Status: transport_required (bridges: hol_typedef_topology)
Theorem T1_SPACE_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e topology A, forall u c= A, t1_space A top -> t1_space A (subtopology A top u).
Admitted.

// HOL Light: Multivariate/metric.ml:7887 / CLOSED_IN_DERIVED_SET_OF_GEN
// Source hash: md5:626ef71f62b2a512a180f4d1916d5387
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CLOSED_IN_DERIVED_SET_OF_GEN : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, t1_space A top -> closed_in A top (derived_set_of A top s).
Admitted.

// HOL Light: Multivariate/metric.ml:7904 / DERIVED_SET_OF_DERIVED_SET_SUBSET_GEN
// Source hash: md5:6b1847fbac1e8d02e7e0f3611b6629d0
// Status: transport_required (bridges: hol_typedef_topology)
Theorem DERIVED_SET_OF_DERIVED_SET_SUBSET_GEN : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, t1_space A top -> derived_set_of A top (derived_set_of A top s) c= derived_set_of A top s.
Admitted.

// HOL Light: Multivariate/metric.ml:7912 / SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_GEN_FINITE
// Source hash: md5:c7fdb947d9d6ec490e90a3c96adef6b0
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_GEN_FINITE : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, t1_space A top /\ finite s -> subtopology A top s = discrete_topology A (topspace A top :/\: s).
Admitted.

// HOL Light: Multivariate/metric.ml:7920 / SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_FINITE
// Source hash: md5:30d96f4914304f38ad6e11ad52a7ba80
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_FINITE : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, t1_space A top /\ (s c= topspace A top /\ finite s) -> subtopology A top s = discrete_topology A s.
Admitted.

// HOL Light: Multivariate/metric.ml:7928 / T1_SPACE_CLOSED_MAP_IMAGE
// Source hash: md5:9203867cee5b347bc634d30a5d3d504b
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem T1_SPACE_CLOSED_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall top :e topology A, forall top' :e topology B, closed_map A B (top,top') f /\ ({f x | x :e topspace A top} = topspace B top' /\ t1_space A top) -> t1_space B top'.
Admitted.

// HOL Light: Multivariate/metric.ml:7940 / HOMEOMORPHIC_T1_SPACE
// Source hash: md5:18b37255b961d56eca390b2cf41d3b18
// Status: transport_required (bridges: hol_typedef_topology)
Theorem HOMEOMORPHIC_T1_SPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, homeomorphic_space A B top top' -> (t1_space A top <-> t1_space B top').
Admitted.

// HOL Light: Multivariate/metric.ml:7952 / T1_SPACE_RETRACTION_MAP_IMAGE
// Source hash: md5:4fa006dc90db26cead94c50af44a4c78
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem T1_SPACE_RETRACTION_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall r:set -> set, (forall x :e A, r x :e B) -> retraction_map A B (top,top') r /\ t1_space A top -> t1_space B top'.
Admitted.

// HOL Light: Multivariate/metric.ml:7958 / T1_SPACE_PROD_TOPOLOGY
// Source hash: md5:4fd938ba615dca5ea25b6b33907a250d
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem T1_SPACE_PROD_TOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, t1_space (A :*: B) (prod_topology A B top1 top2) <-> topspace (A :*: B) (prod_topology A B top1 top2) = Empty \/ t1_space A top1 /\ t1_space B top2.
Admitted.

// HOL Light: Multivariate/metric.ml:7968 / T1_SPACE_PRODUCT_TOPOLOGY
// Source hash: md5:5c492474c305dc149c56ad49193d5da2
// Status: transport_required (bridges: hol_typedef_topology)
Theorem T1_SPACE_PRODUCT_TOPOLOGY : forall A K:set, A <> Empty -> K <> Empty -> forall tops:set -> set, (forall x :e K, tops x :e topology A) -> forall k c= K, t1_space (A :^: K) (product_topology A K k tops) <-> topspace (A :^: K) (product_topology A K k tops) = Empty \/ forall i :e K, i :e k -> t1_space A (tops i).
Admitted.

// HOL Light: Multivariate/metric.ml:7988 / CARD_LE_TOPSPACE_CLOSED_SETS
// Source hash: md5:5bc333b942985b297f20ee53660f0ddc
// Status: transport_required (bridges: hol_le_c_atleastp, hol_typedef_topology)
Theorem CARD_LE_TOPSPACE_CLOSED_SETS : forall A:set, A <> Empty -> forall top :e topology A, t1_space A top -> atleastp (topspace A top) {s :e Power A | closed_in A top s}.
Admitted.

// HOL Light: Multivariate/metric.ml:7994 / CARD_LE_TOPSPACE_OPEN_SETS
// Source hash: md5:b06d2b405dfefb349cc11b4e02037f8a
// Status: transport_required (bridges: hol_le_c_atleastp, hol_typedef_topology)
Theorem CARD_LE_TOPSPACE_OPEN_SETS : forall A:set, A <> Empty -> forall top :e topology A, t1_space A top -> atleastp (topspace A top) {s :e Power A | s :e top}.
Admitted.

// HOL Light: Multivariate/metric.ml:8001 / INFINITE_PERFECT_SET_GEN
// Source hash: md5:b0d71ceadcd239d9a08e84ef739f6e9a
// Status: generalization_required (bridges: empty_case:A, hol_finite_finite, hol_typedef_topology)
Theorem INFINITE_PERFECT_SET_GEN : forall A:set, forall top :e topology A, forall s c= A, t1_space A top /\ (s c= derived_set_of A top s /\ ~ s = Empty) -> infinite s.
Admitted.

// HOL Light: Multivariate/metric.ml:8018 / hausdorff_space
// Source hash: md5:36b9df1a3680164e3cc27ec4d573700a
// Status: transport_required (bridges: hol_typedef_topology)
Theorem hausdorff_space_thm : forall A:set, A <> Empty -> forall top :e topology A, hausdorff_space A top <-> forall x y :e A, x :e topspace A top /\ (y :e topspace A top /\ ~ x = y) -> exists u v c= A, u :e top /\ (v :e top /\ (x :e u /\ (y :e v /\ u :/\: v = Empty))).
Admitted.

// HOL Light: Multivariate/metric.ml:8024 / HAUSDORFF_SPACE_EXPANSIVE
// Source hash: md5:e75cf2b9656177131c8f35a2a1a40aef
// Status: transport_required (bridges: hol_typedef_topology)
Theorem HAUSDORFF_SPACE_EXPANSIVE : forall A:set, A <> Empty -> forall top top' :e topology A, topspace A top' = topspace A top /\ (forall u c= A, u :e top -> u :e top') -> hausdorff_space A top -> hausdorff_space A top'.
Admitted.

// HOL Light: Multivariate/metric.ml:8030 / HAUSDORFF_SPACE_TOPSPACE_EMPTY
// Source hash: md5:92abd7a2a9a75a7d37c083d7de29e1e5
// Status: transport_required (bridges: hol_typedef_topology)
Theorem HAUSDORFF_SPACE_TOPSPACE_EMPTY : forall A:set, A <> Empty -> forall top :e topology A, topspace A top = Empty -> hausdorff_space A top.
Admitted.

// HOL Light: Multivariate/metric.ml:8034 / HAUSDORFF_IMP_T1_SPACE
// Source hash: md5:63fef4c2092432106777b531fb5caa0e
// Status: transport_required (bridges: hol_typedef_topology)
Theorem HAUSDORFF_IMP_T1_SPACE : forall A:set, A <> Empty -> forall top :e topology A, hausdorff_space A top -> t1_space A top.
Admitted.

// HOL Light: Multivariate/metric.ml:8038 / CLOSED_IN_DERIVED_SET_OF
// Source hash: md5:f7c045de0be51d59176e70ee5072bab4
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CLOSED_IN_DERIVED_SET_OF : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, hausdorff_space A top -> closed_in A top (derived_set_of A top s).
Admitted.

