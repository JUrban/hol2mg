// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem OPEN_MAP_PROD : forall A B C D:set, A <> Empty -> B <> Empty -> C <> Empty -> D <> Empty -> forall top1 :e topology A, forall top1' :e topology C, forall top2 :e topology B, forall top2' :e topology D, forall f:set -> set, (forall x :e A, f x :e C) -> forall g:set -> set, (forall x :e B, g x :e D) -> (open_map (A :*: B) (C :*: D) (prod_topology A B top1 top2,prod_topology C D top1' top2') (fun p:set => (f (p 0),g (p 1))) <-> topspace (A :*: B) (prod_topology A B top1 top2) = Empty \/ open_map A C (top1,top1') f /\ open_map B D (top2,top2') g).
Admitted.

// HOL Light: Multivariate/metric.ml:4029 / IN_PROD_TOPOLOGY_CLOSURE_OF
// Source hash: md5:10743000ecd557df3b4e699a39fb6d5c
// Status: generalization_required (bridges: empty_case:A, empty_case:B, hol_prod_setprod, hol_typedef_topology)
Theorem IN_PROD_TOPOLOGY_CLOSURE_OF : forall A B:set, forall top1 :e topology A, forall top2 :e topology B, forall s c= A :*: B, forall z :e A :*: B, z :e closure_of (A :*: B) (prod_topology A B top1 top2) s -> z 0 :e closure_of A top1 {x 0 | x :e s} /\ z 1 :e closure_of B top2 {x 1 | x :e s}.
Admitted.

// HOL Light: Multivariate/metric.ml:4043 / CLOSED_MAP_PROD
// Source hash: md5:496aab83b35bdb4e983ec0f0e6900495
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CLOSED_MAP_PROD : forall A B C D:set, A <> Empty -> B <> Empty -> C <> Empty -> D <> Empty -> forall top1 :e topology A, forall top1' :e topology C, forall top2 :e topology B, forall top2' :e topology D, forall f:set -> set, (forall x :e A, f x :e C) -> forall g:set -> set, (forall x :e B, g x :e D) -> closed_map (A :*: B) (C :*: D) (prod_topology A B top1 top2,prod_topology C D top1' top2') (fun p:set => (f (p 0),g (p 1))) -> topspace (A :*: B) (prod_topology A B top1 top2) = Empty \/ closed_map A C (top1,top1') f /\ closed_map B D (top2,top2') g.
Admitted.

// HOL Light: Multivariate/metric.ml:4069 / PROD_TOPOLOGY_EQ
// Source hash: md5:c977e4862961d738e888fa17be4c4c19
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem PROD_TOPOLOGY_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, forall top1' :e topology A, forall top2' :e topology B, prod_topology A B top1 top2 = prod_topology A B top1' top2' <-> topspace (A :*: B) (prod_topology A B top1 top2) = Empty /\ topspace (A :*: B) (prod_topology A B top1' top2') = Empty \/ top1 = top1' /\ top2 = top2'.
Admitted.

// HOL Light: Multivariate/metric.ml:4096 / product_topology
// Source hash: md5:be9e642a87e3c602217fff57ea281a77
// Status: generalization_required (bridges: choose_in_spec, hol_finite_finite, hol_typedef_topology)
Theorem product_topology_thm : forall A K:set, A <> Empty -> K <> Empty -> forall t c= K, forall tops:set -> set, (forall x :e K, tops x :e topology A) -> product_topology A K t tops = {x :e Power (A :^: K) | exists u c= Power (A :^: K), True /\ (forall x0 :e u, x0 :e relative_to (A :^: K) {x01 :e Power (A :^: K) | exists u c= Power (A :^: K), finite u /\ (forall x1 :e u, x1 :e \/_ k :e K, {{x11 :e A :^: K | x11 k :e u} | u :e Power A, k :e t /\ u :e tops k}) /\ {x :e A :^: K | forall Y :e u, x :e Y} = x01} {x01 :e A :^: K | (forall x :e K, ~ x :e t -> x01 x = choose_in A (fun y:set => False)) /\ forall k :e K, k :e t -> x01 k :e topspace A (tops k)}) /\ Union u = x}.
Admitted.

// HOL Light: Multivariate/metric.ml:4105 / TOPSPACE_PRODUCT_TOPOLOGY
// Source hash: md5:6c89b9dfe933356edcbe5e335d48fc8a
// Status: transport_required (bridges: hol_fun_setexp, hol_typedef_topology)
Theorem TOPSPACE_PRODUCT_TOPOLOGY : forall A K:set, A <> Empty -> K <> Empty -> forall tops:set -> set, (forall x :e K, tops x :e topology A) -> forall t c= K, topspace (A :^: K) (product_topology A K t tops) = {f :e A :^: K | (forall i :e t, f i :e {x0 :e A | x0 :e topspace A (tops i)}) /\ forall i :e K, ~ i :e t -> f i = choose_in A (fun y:set => False)}.
Admitted.

// HOL Light: Multivariate/metric.ml:4111 / TOPSPACE_PRODUCT_TOPOLOGY_ALT
// Source hash: md5:0b72c8f531f396f306943422a70e051d
// Status: transport_required (bridges: choose_in_spec, hol_typedef_topology)
Theorem TOPSPACE_PRODUCT_TOPOLOGY_ALT : forall A K:set, A <> Empty -> K <> Empty -> forall tops:set -> set, (forall x :e K, tops x :e topology A) -> forall t c= K, topspace (A :^: K) (product_topology A K t tops) = {x :e A :^: K | (forall x0 :e K, ~ x0 :e t -> x x0 = choose_in A (fun y:set => False)) /\ forall k :e K, k :e t -> x k :e topspace A (tops k)}.
Admitted.

// HOL Light: Multivariate/metric.ml:4117 / PRODUCT_TOPOLOGY_EMPTY_DISCRETE
// Source hash: md5:03d9ccf2add2dc846a1a4dfe60638ff4
// Status: transport_required (bridges: choose_in_spec, hol_typedef_topology)
Theorem PRODUCT_TOPOLOGY_EMPTY_DISCRETE : forall A K:set, A <> Empty -> K <> Empty -> forall tops:set -> set, (forall x :e K, tops x :e topology A) -> product_topology A K Empty tops = discrete_topology (A :^: K) {fun x :e K => choose_in A (fun x:set => False)}.
Admitted.

// HOL Light: Multivariate/metric.ml:4123 / OPEN_IN_PRODUCT_TOPOLOGY
// Source hash: md5:2f7c9984c0f63da37e5fd268ac85f156
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem OPEN_IN_PRODUCT_TOPOLOGY : forall A K:set, A <> Empty -> K <> Empty -> forall tops:set -> set, (forall x :e K, tops x :e topology A) -> forall t c= K, forall x c= A :^: K, x :e product_topology A K t tops <-> exists u c= Power (A :^: K), True /\ (forall x0 :e u, x0 :e relative_to (A :^: K) {x01 :e Power (A :^: K) | exists u c= Power (A :^: K), finite u /\ (forall x1 :e u, x1 :e \/_ k :e K, {{x11 :e A :^: K | x11 k :e u} | u :e Power A, k :e t /\ u :e tops k}) /\ {x :e A :^: K | forall Y :e u, x :e Y} = x01} (topspace (A :^: K) (product_topology A K t tops))) /\ Union u = x.
Admitted.

// HOL Light: Multivariate/metric.ml:4133 / SUBTOPOLOGY_CARTESIAN_PRODUCT
