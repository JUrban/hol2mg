// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem QUASI_COMPONENTS_OF_SET : forall A:set, forall top :e topology A, forall c c= A, c :e quasi_components_of A top -> {x :e A | forall Y :e {t :e Power A | closed_in A top t /\ (t :e top /\ c c= t)}, x :e Y} = c.
Admitted.

