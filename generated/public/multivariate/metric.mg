Theorem CLOSED_EQ_CONTINUOUS_INVERSE_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e B, g x :e A) -> (forall x :e A, x :e topspace A top -> f x :e topspace B top' /\ g (f x) = x) /\ (forall y :e B, y :e topspace B top' -> g y :e topspace A top /\ f (g y) = y) -> (closed_map A B (top,top') f <-> continuous_map B A (top',top) g).
Admitted.

// HOL Light: Multivariate/metric.ml:5296 / HOMEOMORPHIC_MAPS_MAP
// Source hash: md5:d4ff7596181f455c7ba761975b0f44a6
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HOMEOMORPHIC_MAPS_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f :e B :^: A, forall g :e A :^: B, homeomorphic_maps A B (top,top') (f,g) <-> homeomorphic_map A B (top,top') (fun x:set => f x) /\ (homeomorphic_map B A (top',top) (fun x:set => g x) /\ ((forall x :e A, x :e topspace A top -> g (f x) = x) /\ forall y :e B, y :e topspace B top' -> f (g y) = y)).
Admitted.

