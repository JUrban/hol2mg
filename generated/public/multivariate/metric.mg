Theorem FINITE_IMP_LOCALLY_FINITE_IN : forall A:set, A <> Empty -> forall top :e topology A, forall u c= Power A, finite u /\ Union u c= topspace A top -> locally_finite_in A top u.
Admitted.

// HOL Light: Multivariate/metric.ml:2118 / LOCALLY_FINITE_IN_SUBSET
// Source hash: md5:63935853c3adbfe3d2c85eba6ede9f7b
// Status: transport_required (bridges: hol_typedef_topology)
Theorem LOCALLY_FINITE_IN_SUBSET : forall A:set, A <> Empty -> forall top :e topology A, forall u v c= Power A, locally_finite_in A top u /\ v c= u -> locally_finite_in A top v.
Admitted.

// HOL Light: Multivariate/metric.ml:2130 / LOCALLY_FINITE_IN_REFINEMENT
// Source hash: md5:274938dc65da2a4c325658c84a06a054
// Status: transport_required (bridges: hol_typedef_topology)
Theorem LOCALLY_FINITE_IN_REFINEMENT : forall A:set, A <> Empty -> forall top :e topology A, forall u c= Power A, forall f :e Power A :^: Power A, locally_finite_in A top u /\ (forall s c= A, s :e u -> f s c= s) -> locally_finite_in A top {f s | s :e Power A, s :e u}.
Admitted.

// HOL Light: Multivariate/metric.ml:2148 / LOCALLY_FINITE_IN_SUBTOPOLOGY
// Source hash: md5:acd67ba743c72afed341976d5e5f7a3c
// Status: transport_required (bridges: hol_typedef_topology)
Theorem LOCALLY_FINITE_IN_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, forall u c= Power A, locally_finite_in A top u /\ (forall t c= A, t :e u -> t c= s) -> locally_finite_in A (subtopology A top s) u.
Admitted.

// HOL Light: Multivariate/metric.ml:2160 / LOCALLY_FINITE_IN_SUBTOPOLOGY_EQ
// Source hash: md5:70a59e9cfe26ff87594e0c0ab1c4c56f
// Status: transport_required (bridges: hol_typedef_topology)
Theorem LOCALLY_FINITE_IN_SUBTOPOLOGY_EQ : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, forall u c= Power A, closed_in A top s -> (locally_finite_in A (subtopology A top s) u <-> locally_finite_in A top u /\ forall t c= A, t :e u -> t c= s).
Admitted.

// HOL Light: Multivariate/metric.ml:2180 / CLOSED_IN_LOCALLY_FINITE_UNIONS
// Source hash: md5:8cfdc3a6afa37929e866acc20a3b112e
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CLOSED_IN_LOCALLY_FINITE_UNIONS : forall A:set, A <> Empty -> forall top :e topology A, forall f c= Power A, (forall s c= A, s :e f -> closed_in A top s) /\ locally_finite_in A top f -> closed_in A top (Union f).
Admitted.

// HOL Light: Multivariate/metric.ml:2199 / LOCALLY_FINITE_IN_CLOSURES
// Source hash: md5:2534a4dfaeaf5163390236b59a7214af
// Status: transport_required (bridges: hol_typedef_topology)
Theorem LOCALLY_FINITE_IN_CLOSURES : forall A:set, A <> Empty -> forall top :e topology A, forall f c= Power A, locally_finite_in A top f -> locally_finite_in A top {closure_of A top s | s :e Power A, s :e f}.
Admitted.

// HOL Light: Multivariate/metric.ml:2216 / CLOSED_IN_UNIONS_LOCALLY_FINITE_CLOSURES
// Source hash: md5:4ecbe1fdf0801bad4354d0d83b343169
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CLOSED_IN_UNIONS_LOCALLY_FINITE_CLOSURES : forall A:set, A <> Empty -> forall top :e topology A, forall f c= Power A, locally_finite_in A top f -> closed_in A top (Union {closure_of A top s | s :e Power A, s :e f}).
Admitted.

// HOL Light: Multivariate/metric.ml:2223 / CLOSURE_OF_UNIONS_SUBSET
// Source hash: md5:a1dfab4062e2c2abd62d4dfb4b5743cd
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CLOSURE_OF_UNIONS_SUBSET : forall A:set, A <> Empty -> forall top :e topology A, forall f c= Power A, Union {closure_of A top s | s :e Power A, s :e f} c= closure_of A top (Union f).
Admitted.

// HOL Light: Multivariate/metric.ml:2230 / CLOSURE_OF_LOCALLY_FINITE_UNIONS
// Source hash: md5:9bb359c26f3978f58c69b8b5eaa9a6a5
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CLOSURE_OF_LOCALLY_FINITE_UNIONS : forall A:set, A <> Empty -> forall top :e topology A, forall f c= Power A, locally_finite_in A top f -> closure_of A top (Union f) = Union {closure_of A top s | s :e Power A, s :e f}.
Admitted.

// HOL Light: Multivariate/metric.ml:2244 / continuous_map
// Source hash: md5:225cace8d20b1bc696555c6b916acbf4
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem continuous_map_thm : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> (continuous_map A B (top,top') f <-> (forall x :e A, x :e topspace A top -> f x :e topspace B top') /\ forall u c= B, u :e top' -> {x :e A | x :e topspace A top /\ f x :e u} :e top).
Admitted.

// HOL Light: Multivariate/metric.ml:2251 / CONTINUOUS_MAP
// Source hash: md5:cf11634b3ccc557c5d2fa75ff886330a
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology B, forall top' :e topology A, forall f:set -> set, (forall x :e B, f x :e A) -> (continuous_map B A (top,top') f <-> {f x | x :e topspace B top} c= topspace A top' /\ forall u c= A, u :e top' -> {x :e B | x :e topspace B top /\ f x :e u} :e top).
Admitted.

// HOL Light: Multivariate/metric.ml:2259 / CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE
// Source hash: md5:2314db12d0d5698695a84a84aa9d25da
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> continuous_map A B (top,top') f -> {f x | x :e topspace A top} c= topspace B top'.
Admitted.

// HOL Light: Multivariate/metric.ml:2264 / CONTINUOUS_MAP_ON_EMPTY
// Source hash: md5:6f69287294fa42c43f4a5188bea22f67
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_MAP_ON_EMPTY : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> topspace A top = Empty -> continuous_map A B (top,top') f.
Admitted.

// HOL Light: Multivariate/metric.ml:2268 / CONTINUOUS_MAP_INTO_EMPTY
// Source hash: md5:a9313d3efda0e8de64804202b31ee2fc
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_MAP_INTO_EMPTY : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> topspace B top' = Empty -> (continuous_map A B (top,top') f <-> topspace A top = Empty).
Admitted.

// HOL Light: Multivariate/metric.ml:2276 / CONTINUOUS_MAP_CLOSED_IN
// Source hash: md5:ab403f185cbe2bf66d4ceee075ab1a65
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_MAP_CLOSED_IN : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> (continuous_map A B (top,top') f <-> (forall x :e A, x :e topspace A top -> f x :e topspace B top') /\ forall c c= B, closed_in B top' c -> closed_in A top {x :e A | x :e topspace A top /\ f x :e c}).
Admitted.

// HOL Light: Multivariate/metric.ml:2293 / OPEN_IN_CONTINUOUS_MAP_PREIMAGE
// Source hash: md5:91c27ffc1b2a21a2eb76623463b93eb7
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem OPEN_IN_CONTINUOUS_MAP_PREIMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall top :e topology A, forall top' :e topology B, forall u c= B, continuous_map A B (top,top') f /\ u :e top' -> {x :e A | x :e topspace A top /\ f x :e u} :e top.
Admitted.

// HOL Light: Multivariate/metric.ml:2299 / CLOSED_IN_CONTINUOUS_MAP_PREIMAGE
// Source hash: md5:5d09035bf52f8423cf13a9226f62ac76
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CLOSED_IN_CONTINUOUS_MAP_PREIMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall top :e topology A, forall top' :e topology B, forall c c= B, continuous_map A B (top,top') f /\ closed_in B top' c -> closed_in A top {x :e A | x :e topspace A top /\ f x :e c}.
Admitted.

// HOL Light: Multivariate/metric.ml:2305 / OPEN_IN_CONTINUOUS_MAP_PREIMAGE_GEN
// Source hash: md5:8f2a1cae8424dc6c79e8a894b14b9726
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem OPEN_IN_CONTINUOUS_MAP_PREIMAGE_GEN : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall top :e topology A, forall top' :e topology B, forall u c= A, forall v c= B, continuous_map A B (top,top') f /\ (u :e top /\ v :e top') -> {x :e A | x :e u /\ f x :e v} :e top.
Admitted.

// HOL Light: Multivariate/metric.ml:2318 / CLOSED_IN_CONTINUOUS_MAP_PREIMAGE_GEN
// Source hash: md5:60b0e2ac4c44275a7967f0d9ac343020
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CLOSED_IN_CONTINUOUS_MAP_PREIMAGE_GEN : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall top :e topology A, forall top' :e topology B, forall u c= A, forall v c= B, continuous_map A B (top,top') f /\ (closed_in A top u /\ closed_in B top' v) -> closed_in A top {x :e A | x :e u /\ f x :e v}.
Admitted.

// HOL Light: Multivariate/metric.ml:2331 / CONTINUOUS_MAP_IMAGE_CLOSURE_SUBSET
// Source hash: md5:340968bef96b5dd90f66615af5b6b928
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_MAP_IMAGE_CLOSURE_SUBSET : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall s c= A, continuous_map A B (top,top') f -> {f x | x :e closure_of A top s} c= closure_of B top' {f x | x :e s}.
Admitted.

// HOL Light: Multivariate/metric.ml:2392 / CONTINUOUS_MAP_CLOSURE_PREIMAGE_SUBSET
// Source hash: md5:3a744bc15eeab8e30f074ad8ff7b4cca
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_MAP_CLOSURE_PREIMAGE_SUBSET : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall t c= B, continuous_map A B (top,top') f -> closure_of A top {x :e A | x :e topspace A top /\ f x :e t} c= {x :e A | x :e topspace A top /\ f x :e closure_of B top' t}.
Admitted.

// HOL Light: Multivariate/metric.ml:2426 / CONTINUOUS_MAP_INTERIOR_PREIMAGE_SUBSET
// Source hash: md5:9a501131818190212ecfe3d1eac4dc24
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_MAP_INTERIOR_PREIMAGE_SUBSET : forall A B:set, B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall t c= B, continuous_map A B (top,top') f -> {x :e A | x :e topspace A top /\ f x :e interior_of B top' t} c= interior_of A top {x :e A | x :e topspace A top /\ f x :e t}.
Admitted.

// HOL Light: Multivariate/metric.ml:2468 / CONTINUOUS_MAP_FRONTIER_FRONTIER_PREIMAGE_SUBSET
// Source hash: md5:d1455e94a7cbf32f3962ea8118a923a7
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_MAP_FRONTIER_FRONTIER_PREIMAGE_SUBSET : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall t c= B, continuous_map A B (top,top') f -> frontier_of A top {x :e A | x :e topspace A top /\ f x :e t} c= {x :e A | x :e topspace A top /\ f x :e frontier_of B top' t}.
Admitted.

// HOL Light: Multivariate/metric.ml:2483 / CONTINUOUS_MAP_ID
// Source hash: md5:30ec39ac4174317f3aea720d26f20566
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_MAP_ID : forall A:set, A <> Empty -> forall top :e topology A, continuous_map A A (top,top) (fun x:set => x).
Admitted.

// HOL Light: Multivariate/metric.ml:2490 / TOPOLOGY_FINER_CONTINUOUS_ID
// Source hash: md5:5fe865d4fd2849327a77366fb4bab1cb
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem TOPOLOGY_FINER_CONTINUOUS_ID : forall A:set, A <> Empty -> forall top top' :e topology A, topspace A top' = topspace A top -> ((forall s c= A, s :e top -> s :e top') <-> continuous_map A A (top',top) (fun x:set => x)).
Admitted.

// HOL Light: Multivariate/metric.ml:2498 / CONTINUOUS_MAP_CONST
// Source hash: md5:1cd34b174c32d548e298ee38878c7983
// Status: generalization_required (bridges: empty_case:B, hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_MAP_CONST : forall A B:set, A <> Empty -> forall top1 :e topology A, forall top2 :e topology B, forall c :e B, continuous_map A B (top1,top2) (fun x:set => c) <-> topspace A top1 = Empty \/ c :e topspace B top2.
Admitted.

// HOL Light: Multivariate/metric.ml:2512 / CONTINUOUS_MAP_COMPOSE
// Source hash: md5:ef33b82b14f9f4417de1999f26cc13ff
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_MAP_COMPOSE : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e topology A, forall top' :e topology B, forall top'' :e topology C, forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e B, g x :e C) -> continuous_map A B (top,top') f /\ continuous_map B C (top',top'') g -> continuous_map A C (top,top'') (fun x:set => g (f x)).
Admitted.

// HOL Light: Multivariate/metric.ml:2523 / CONTINUOUS_MAP_EQ
// Source hash: md5:3a518340c70f83d1de900992f057fb0f
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_MAP_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e A, g x :e B) -> (forall x :e A, x :e topspace A top -> f x = g x) /\ continuous_map A B (top,top') f -> continuous_map A B (top,top') g.
Admitted.

// HOL Light: Multivariate/metric.ml:2534 / RESTRICTION_CONTINUOUS_MAP
// Source hash: md5:48cfe93119e3ff2a18fae2bd4e756822
// Status: transport_required (bridges: choose_in_spec, hol_prod_setprod, hol_typedef_topology)
Theorem RESTRICTION_CONTINUOUS_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall s c= A, topspace A top c= s -> (continuous_map A B (top,top') (fun x:set => if x :e s then f x else choose_in B (fun y:set => False)) <-> continuous_map A B (top,top') f).
Admitted.

// HOL Light: Multivariate/metric.ml:2543 / CONTINUOUS_MAP_IN_SUBTOPOLOGY
// Source hash: md5:e6c166bc065e761391a47f3f9d94e021
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_MAP_IN_SUBTOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall s c= B, forall f:set -> set, (forall x :e A, f x :e B) -> (continuous_map A B (top,subtopology B top' s) f <-> continuous_map A B (top,top') f /\ {f x | x :e topspace A top} c= s).
Admitted.

// HOL Light: Multivariate/metric.ml:2568 / CONTINUOUS_MAP_FROM_SUBTOPOLOGY
// Source hash: md5:25bee4d1d8f3f403b189def6d2e5749d
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_MAP_FROM_SUBTOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall s c= A, continuous_map A B (top,top') f -> continuous_map A B (subtopology A top s,top') f.
Admitted.

// HOL Light: Multivariate/metric.ml:2578 / CONTINUOUS_MAP_INTO_FULLTOPOLOGY
// Source hash: md5:52ab278abf8c6199f5288f384fae8e21
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_MAP_INTO_FULLTOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall t c= B, continuous_map A B (top,subtopology B top' t) f -> continuous_map A B (top,top') f.
Admitted.

// HOL Light: Multivariate/metric.ml:2584 / CONTINUOUS_MAP_INTO_SUBTOPOLOGY
// Source hash: md5:0275b9786ca248040e24ef2fe9338103
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_MAP_INTO_SUBTOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall t c= B, continuous_map A B (top,top') f /\ {f x | x :e topspace A top} c= t -> continuous_map A B (top,subtopology B top' t) f.
Admitted.

// HOL Light: Multivariate/metric.ml:2591 / CONTINUOUS_MAP_FROM_SUBTOPOLOGY_MONO
// Source hash: md5:be14e0bec706e51ffffa9a3589b3b2c4
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_MAP_FROM_SUBTOPOLOGY_MONO : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology B, forall top' :e topology A, forall f:set -> set, (forall x :e B, f x :e A) -> forall s t c= B, continuous_map B A (subtopology B top t,top') f /\ s c= t -> continuous_map B A (subtopology B top s,top') f.
Admitted.

// HOL Light: Multivariate/metric.ml:2598 / CONTINUOUS_MAP_FROM_DISCRETE_TOPOLOGY
// Source hash: md5:878a01cf2bb1d8c3670248a7f86faa2b
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_MAP_FROM_DISCRETE_TOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall top :e topology B, forall u c= A, continuous_map A B (discrete_topology A u,top) f <-> {f x | x :e u} c= topspace B top.
Admitted.

// HOL Light: Multivariate/metric.ml:2605 / PASTING_LEMMA
// Source hash: md5:16ae26a2db9e1c933ef1d5fcb37202a9
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem PASTING_LEMMA : forall A B K:set, A <> Empty -> B <> Empty -> K <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set -> set, (forall x :e K, forall y :e A, f x y :e B) -> forall g:set -> set, (forall x :e A, g x :e B) -> forall t :e Power A :^: K, forall k c= K, (forall i :e K, i :e k -> t i :e top /\ continuous_map A B (subtopology A top (t i),top') (f i)) /\ ((forall i j :e K, forall x :e A, i :e k /\ (j :e k /\ x :e topspace A top :/\: (t i :/\: t j)) -> f i x = f j x) /\ (forall x :e A, x :e topspace A top -> exists j :e K, j :e k /\ (x :e t j /\ g x = f j x))) -> continuous_map A B (top,top') g.
Admitted.

// HOL Light: Multivariate/metric.ml:2628 / PASTING_LEMMA_EXISTS
// Source hash: md5:192c0b1ff462c21fd585185ac2fb350e
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem PASTING_LEMMA_EXISTS : forall A B K:set, A <> Empty -> B <> Empty -> K <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set -> set, (forall x :e K, forall y :e A, f x y :e B) -> forall t :e Power A :^: K, forall k c= K, topspace A top c= Union {t i | i :e K, i :e k} /\ ((forall i :e K, i :e k -> t i :e top /\ continuous_map A B (subtopology A top (t i),top') (f i)) /\ (forall i j :e K, forall x :e A, i :e k /\ (j :e k /\ x :e topspace A top :/\: (t i :/\: t j)) -> f i x = f j x)) -> exists g:set -> set, (forall x :e A, g x :e B) /\ (continuous_map A B (top,top') g /\ forall x :e A, forall i :e K, i :e k /\ x :e topspace A top :/\: t i -> g x = f i x).
Admitted.

// HOL Light: Multivariate/metric.ml:2645 / PASTING_LEMMA_LOCALLY_FINITE
// Source hash: md5:6b3ab132c09a15c09b55879ede13ee1a
// Status: transport_required (bridges: hol_finite_finite, hol_prod_setprod, hol_typedef_topology)
Theorem PASTING_LEMMA_LOCALLY_FINITE : forall A B K:set, A <> Empty -> B <> Empty -> K <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set -> set, (forall x :e K, forall y :e A, f x y :e B) -> forall g:set -> set, (forall x :e A, g x :e B) -> forall t :e Power A :^: K, forall k c= K, (forall x :e A, x :e topspace A top -> exists v c= A, v :e top /\ (x :e v /\ finite {i :e K | i :e k /\ ~ t i :/\: v = Empty})) /\ ((forall i :e K, i :e k -> closed_in A top (t i) /\ continuous_map A B (subtopology A top (t i),top') (f i)) /\ ((forall i j :e K, forall x :e A, i :e k /\ (j :e k /\ x :e topspace A top :/\: (t i :/\: t j)) -> f i x = f j x) /\ (forall x :e A, x :e topspace A top -> exists j :e K, j :e k /\ (x :e t j /\ g x = f j x)))) -> continuous_map A B (top,top') g.
Admitted.

// HOL Light: Multivariate/metric.ml:2685 / PASTING_LEMMA_EXISTS_LOCALLY_FINITE
// Source hash: md5:67a2571445a8f952ca1ce5fae1bf61fc
// Status: transport_required (bridges: hol_finite_finite, hol_prod_setprod, hol_typedef_topology)
Theorem PASTING_LEMMA_EXISTS_LOCALLY_FINITE : forall A B K:set, A <> Empty -> B <> Empty -> K <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set -> set, (forall x :e K, forall y :e A, f x y :e B) -> forall t :e Power A :^: K, forall k c= K, (forall x :e A, x :e topspace A top -> exists v c= A, v :e top /\ (x :e v /\ finite {i :e K | i :e k /\ ~ t i :/\: v = Empty})) /\ (topspace A top c= Union {t i | i :e K, i :e k} /\ ((forall i :e K, i :e k -> closed_in A top (t i) /\ continuous_map A B (subtopology A top (t i),top') (f i)) /\ (forall i j :e K, forall x :e A, i :e k /\ (j :e k /\ x :e topspace A top :/\: (t i :/\: t j)) -> f i x = f j x))) -> exists g:set -> set, (forall x :e A, g x :e B) /\ (continuous_map A B (top,top') g /\ forall x :e A, forall i :e K, i :e k /\ x :e topspace A top :/\: t i -> g x = f i x).
Admitted.

// HOL Light: Multivariate/metric.ml:2705 / PASTING_LEMMA_CLOSED
// Source hash: md5:7f76cf2dc3453c3b0f7860a22b14a0b1
// Status: transport_required (bridges: hol_finite_finite, hol_prod_setprod, hol_typedef_topology)
Theorem PASTING_LEMMA_CLOSED : forall A B K:set, A <> Empty -> B <> Empty -> K <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set -> set, (forall x :e K, forall y :e A, f x y :e B) -> forall g:set -> set, (forall x :e A, g x :e B) -> forall t :e Power A :^: K, forall k c= K, finite k /\ ((forall i :e K, i :e k -> closed_in A top (t i) /\ continuous_map A B (subtopology A top (t i),top') (f i)) /\ ((forall i j :e K, forall x :e A, i :e k /\ (j :e k /\ x :e topspace A top :/\: (t i :/\: t j)) -> f i x = f j x) /\ (forall x :e A, x :e topspace A top -> exists j :e K, j :e k /\ (x :e t j /\ g x = f j x)))) -> continuous_map A B (top,top') g.
Admitted.

