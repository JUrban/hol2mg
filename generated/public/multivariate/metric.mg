// Source hash: md5:b1e6ddeca44c27a2f3158d529199a6b6
// Status: transport_required (bridges: hol_typedef_net)
Theorem NONTRIVIAL_LIMIT_WITHIN : forall A:set, A <> Empty -> forall net0 :e net A, forall s c= A, trivial_limit A net0 -> trivial_limit A (within A net0 s).
Admitted.

