// HOL Light: Multivariate/metric.ml:30386 / lipschitz_continuous_map
// Source hash: md5:3797ef647403216ea7a394b226486801
// Status: transport_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem lipschitz_continuous_map_thm : forall A B:set, A <> Empty -> B <> Empty -> forall m2 :e metric A, forall f:set -> set, (forall x :e B, f x :e A) -> forall m1 :e metric B, lipschitz_continuous_map A B (m1,m2) f <-> {f x | x :e mspace B m1} c= mspace A m2 /\ exists B0 :e R, forall x y :e B, x :e mspace B m1 /\ y :e mspace B m1 -> mdist A m2 (f x,f y) <= B0 * mdist B m1 (x,y).
Admitted.

// HOL Light: Multivariate/metric.ml:30392 / LIPSCHITZ_CONTINUOUS_MAP_POS
// Source hash: md5:f28a85eaa99ac6b34ccc85c0fcb2b801
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, omega_Subq_R)
Theorem LIPSCHITZ_CONTINUOUS_MAP_POS : forall A B:set, A <> Empty -> B <> Empty -> forall m1 :e metric A, forall m2 :e metric B, forall f:set -> set, (forall x :e A, f x :e B) -> (lipschitz_continuous_map B A (m1,m2) f <-> {f x | x :e mspace A m1} c= mspace B m2 /\ exists B0 :e R, 0 < B0 /\ forall x y :e A, x :e mspace A m1 /\ y :e mspace A m1 -> mdist B m2 (f x,f y) <= B0 * mdist A m1 (x,y)).
Admitted.

// HOL Light: Multivariate/metric.ml:30408 / LIPSCHITZ_CONTINUOUS_MAP_EQ
// Source hash: md5:ec763fcaf4e449c50162ff49a884bfe7
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_metric)
Theorem LIPSCHITZ_CONTINUOUS_MAP_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall m1 :e metric B, forall m2 :e metric A, forall f:set -> set, (forall x :e B, f x :e A) -> forall g:set -> set, (forall x :e B, g x :e A) -> (forall x :e B, x :e mspace B m1 -> f x = g x) /\ lipschitz_continuous_map A B (m1,m2) f -> lipschitz_continuous_map A B (m1,m2) g.
Admitted.

