Theorem COMPACT_QUASI_EQ_CONNECTED_COMPONENTS_OF : forall A:set, A <> Empty -> forall top :e topology A, forall c c= A, locally_compact_space A top /\ (hausdorff_space A top /\ compact_in A top c) -> (c :e quasi_components_of A top <-> c :e connected_components_of A top).
