// Source hash: md5:27f508a8603ab4a93f1f6aa29b49c300
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem LF_CLOSED_PERFECT_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall W c= Power A, perfect_map A B (top,top') f /\ (locally_finite_in A top W /\ (forall w c= A, w :e W -> closed_in A top w)) -> locally_finite_in B top' {{x0 :e B | x0 :e {f x0 | x0 :e x}} | x :e W} /\ forall v c= B, v :e {{x0 :e B | x0 :e {f x0 | x0 :e x}} | x :e W} -> closed_in B top' v.
