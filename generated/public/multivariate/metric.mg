// Status: transport_required (bridges: hol_typedef_topology)
Theorem NORMAL_SPACE_FSIGMAS : forall A:set, A <> Empty -> forall top :e topology A, normal_space A top <-> forall s t c= A, s :e fsigma_in A top /\ (t :e fsigma_in A top /\ separated_in A top s t) -> exists u v c= A, u :e top /\ (v :e top /\ (s c= u /\ (t c= v /\ u :/\: v = Empty))).
Admitted.

