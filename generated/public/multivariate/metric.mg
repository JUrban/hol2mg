// HOL Light: Multivariate/metric.ml:5945 / TOPOLOGICAL_PROPERTY_OF_SUM_COMPONENT
// Source hash: md5:86cfdf11493c58f5847830375bcabb40
// Status: generalization_required (bridges: empty_case:K, hol_prod_setprod, hol_typedef_topology)
Theorem TOPOLOGICAL_PROPERTY_OF_SUM_COMPONENT : forall A K:set, A <> Empty -> forall P Q:set -> prop, forall tops:set -> set, (forall x :e K, tops x :e topology A) -> forall k c= K, (forall top :e topology (K :*: A), forall s c= K :*: A, P top /\ (closed_in (K :*: A) top s /\ s :e top) -> P (subtopology (K :*: A) top s)) /\ (forall top :e topology (K :*: A), forall top' :e topology A, homeomorphic_space (K :*: A) A top top' -> (P top <-> Q top')) -> P (sum_topology A K k tops) -> forall i :e K, i :e k -> Q (tops i).
Admitted.

// HOL Light: Multivariate/metric.ml:5972 / retraction_maps
// Source hash: md5:5d9060cd3d7e8d36c3130059c6b8ffbf
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem retraction_maps_thm : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f :e B :^: A, forall g :e A :^: B, retraction_maps A B (top,top') (f,g) <-> continuous_map A B (top,top') (fun x:set => f x) /\ (continuous_map B A (top',top) (fun x:set => g x) /\ forall x :e B, x :e topspace B top' -> f (g x) = x).
Admitted.

