// Source hash: md5:35633e03e5b8e70d16f02f981aab3b3e
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem KOLMOGOROV_QUOTIENT_LIFT_EXISTS : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall s c= A, s c= topspace A top /\ (t0_space B top' /\ continuous_map A B (subtopology A top s,top') f) -> exists g:set -> set, (forall x :e A, g x :e B) /\ (continuous_map A B (subtopology A top {kolmogorov_quotient A top x | x :e s},top') g /\ forall x :e A, x :e s -> g (kolmogorov_quotient A top x) = f x).
Admitted.

