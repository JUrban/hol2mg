Theorem OPEN_IN_CONNECTED_COMPONENTS_OF_LOCALLY_CONNECTED_SPACE : forall A:set, A <> Empty -> forall top :e topology A, forall c c= A, locally_connected_space A top /\ c :e connected_components_of A top -> c :e top.
Admitted.

// HOL Light: Multivariate/metric.ml:25800 / WEAKLY_LOCALLY_CONNECTED_AT
