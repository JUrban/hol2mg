// Status: transport_required (bridges: hol_countable, hol_typedef_topology)
Theorem LINDELOF_SPACE_UNIONS : forall A:set, A <> Empty -> forall top :e topology A, forall U c= Power A, countable U /\ (forall c c= A, c :e U -> lindelof_space A (subtopology A top c)) -> lindelof_space A (subtopology A top (Union U)).
Admitted.

