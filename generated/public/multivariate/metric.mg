Theorem COMPACT_NESTED_INTERS : forall A:set, A <> Empty -> forall m :e metric A, forall c :e Power A :^: omega :^: omega, forall N:set -> set, (forall x :e omega, N x :e omega) -> mcomplete A m /\ ((forall n i :e omega, i <= N n -> c n i c= mspace A m) /\ (forall n i :e omega, i <= N n -> forall x y :e A, x :e c n i /\ y :e c n i -> mdist A m (x,y) < recip_SNo (n + 1))) -> compact_in A (mtopology A m) {x :e A | forall Y :e {Union {closure_of A (mtopology A m) (c n i) | i :e omega, i <= N n} | n :e omega, n :e omega}, x :e Y}.
