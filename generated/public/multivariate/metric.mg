// Source hash: md5:6e77ff78a19b2dd6a6d2539dad1e24c0
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem KC_SPACE_CONTINUOUS_INJECTIVE_MAP_PREIMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> continuous_map A B (top,top') f /\ ((forall x y :e A, x :e topspace A top /\ (y :e topspace A top /\ f x = f y) -> x = y) /\ kc_space B top') -> kc_space A top.
Admitted.

