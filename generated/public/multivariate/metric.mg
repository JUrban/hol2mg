// Status: transport_required (bridges: hol_countable, hol_typedef_topology)
Theorem COUNTABLE_IMP_LINDELOF_SPACE : forall A:set, A <> Empty -> forall top :e topology A, countable (topspace A top) -> lindelof_space A top.
Admitted.

// HOL Light: Multivariate/metric.ml:10046 / LINDELOF_SPACE_SUBTOPOLOGY
// Source hash: md5:c2d65cd3ea30d8a1e62c66be52e8dbe9
// Status: transport_required (bridges: hol_countable, hol_typedef_topology)
Theorem LINDELOF_SPACE_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, lindelof_space A (subtopology A top s) <-> forall U c= Power A, (forall u c= A, u :e U -> u :e top) /\ topspace A top :/\: s c= Union U -> exists V c= Power A, countable V /\ (V c= U /\ topspace A top :/\: s c= Union V).
Admitted.

