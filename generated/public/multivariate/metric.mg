// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_topology, omega_Subq_R)
Theorem METRIC_DERIVED_SET_OF : forall A:set, A <> Empty -> forall m :e metric A, forall s c= A, derived_set_of A (mtopology A m) s = {x :e A | x :e mspace A m /\ forall r :e R, 0 < r -> exists y :e A, ~ y = x /\ (y :e s /\ y :e mball A m (x,r))}.
Admitted.

