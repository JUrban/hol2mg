// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem PATH_COMPONENT_OF_MONO : forall A:set, forall top :e topology A, forall s t c= A, forall x y :e A, path_component_of A (subtopology A top s) x y /\ s c= t -> path_component_of A (subtopology A top t) x y.
