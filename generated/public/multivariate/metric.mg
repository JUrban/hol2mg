// HOL Light: Multivariate/metric.ml:27223 / BOUNDARY_BUMPING_THEOREM_CLOSED_GEN
// Source hash: md5:76a0a0f0641d81b7962a6d3fd57e6d0f
// Status: transport_required (bridges: hol_typedef_topology)
Theorem BOUNDARY_BUMPING_THEOREM_CLOSED_GEN : forall A:set, A <> Empty -> forall top :e topology A, forall s c c= A, connected_space A top /\ (locally_compact_space A top /\ (hausdorff_space A top /\ (closed_in A top s /\ (~ s = topspace A top /\ (compact_in A top c /\ c :e connected_components_of A (subtopology A top s)))))) -> ~ c :/\: frontier_of A top s = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:27255 / BOUNDARY_BUMPING_THEOREM_CLOSED
