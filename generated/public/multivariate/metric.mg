// Status: transport_required (bridges: hol_typedef_topology)
Theorem LOCALLY_COMPACT_SPACE_NEIGHBOURHOOD_BASE_OPEN_CLOSURE_OF : forall A:set, A <> Empty -> forall top :e topology A, hausdorff_space A top \/ regular_space A top -> (locally_compact_space A top <-> neighbourhood_base_of A {u :e Power A | u :e top /\ compact_in A top (closure_of A top u)} top).
