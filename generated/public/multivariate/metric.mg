// Source hash: md5:7969adb77664d7cdfce4bc74ae186129
// Status: transport_required (bridges: hol_typedef_metric)
Theorem MBOUNDED_SUBMETRIC : forall A:set, A <> Empty -> forall t c= A, forall m :e metric A, forall s c= A, mbounded A (submetric A m s) t <-> mbounded A m (s :/\: t) /\ t c= s.
Admitted.

