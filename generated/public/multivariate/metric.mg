// HOL Light: Multivariate/metric.ml:24222 / TIETZE_EXTENSION_CLOSED_REAL_INTERVAL
// Source hash: md5:3fd884e79610c5c5195837a36d9d5353
// Status: transport_required (bridges: hol_list_finseq, hol_prod_setprod, hol_real_R, hol_typedef_topology)
Theorem TIETZE_EXTENSION_CLOSED_REAL_INTERVAL : forall A:set, A <> Empty -> forall top :e topology A, forall f:set -> set, (forall x :e A, f x :e R) -> forall s c= A, forall a b :e R, normal_space A top /\ (closed_in A top s /\ (a <= b /\ (continuous_map A R (subtopology A top s,euclideanreal) f /\ (forall x :e A, x :e s -> f x :e closed_real_interval (seq_cons (a,b) seq_nil))))) -> exists g:set -> set, (forall x :e A, g x :e R) /\ (continuous_map A R (top,euclideanreal) g /\ ((forall x :e A, x :e topspace A top -> g x :e closed_real_interval (seq_cons (a,b) seq_nil)) /\ forall x :e A, x :e s -> g x = f x)).
Admitted.

// HOL Light: Multivariate/metric.ml:24354 / TIETZE_EXTENSION_REALINTERVAL
// Source hash: md5:fc1928e376cdb590d37c9c69e2f43e77
// Status: transport_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_topology)
Theorem TIETZE_EXTENSION_REALINTERVAL : forall A:set, A <> Empty -> forall top :e topology A, forall f:set -> set, (forall x :e A, f x :e R) -> forall s c= A, forall t c= R, normal_space A top /\ (closed_in A top s /\ (is_realinterval t /\ (~ t = Empty /\ (continuous_map A R (subtopology A top s,euclideanreal) f /\ (forall x :e A, x :e s -> f x :e t))))) -> exists g:set -> set, (forall x :e A, g x :e R) /\ (continuous_map A R (top,euclideanreal) g /\ ((forall x :e A, x :e topspace A top -> g x :e t) /\ forall x :e A, x :e s -> g x = f x)).
Admitted.

// HOL Light: Multivariate/metric.ml:24463 / NORMAL_SPACE_EQ_TIETZE
// Source hash: md5:0630ad95ce4e31b60979f2b81cedc973
// Status: transport_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_topology)
Theorem NORMAL_SPACE_EQ_TIETZE : forall A:set, A <> Empty -> forall top :e topology A, normal_space A top <-> forall f:set -> set, (forall x :e A, f x :e R) -> forall s c= A, closed_in A top s /\ continuous_map A R (subtopology A top s,euclideanreal) f -> exists g:set -> set, (forall x :e A, g x :e R) /\ (continuous_map A R (top,euclideanreal) g /\ forall x :e A, x :e s -> g x = f x).
Admitted.

