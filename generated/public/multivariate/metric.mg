// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HOMEOMORPHIC_MAP_COMPOSE : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e topology A, forall top' :e topology B, forall top'' :e topology C, forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e B, g x :e C) -> homeomorphic_map A B (top,top') f /\ homeomorphic_map B C (top',top'') g -> homeomorphic_map A C (top,top'') (fun x:set => g (f x)).
