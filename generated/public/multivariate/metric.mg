// HOL Light: Multivariate/metric.ml:37490 / capped_metric
// Source hash: md5:44bfd6acb3d9552cdc6318d23de9dbe7
// Status: generalization_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, omega_Subq_R)
Theorem capped_metric_thm : forall A:set, A <> Empty -> forall d :e R, forall m :e metric A, capped_metric A d m = if d <= 0 then m else (mspace A m,fun p :e A :*: A => if d <= mdist A m (p 0,p 1) then d else mdist A m (p 0,p 1)).
Admitted.

// HOL Light: Multivariate/metric.ml:37495 / CAPPED_METRIC
// Source hash: md5:1cda436e9971fb97923ad709ebe77587
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, omega_Subq_R)
Theorem CAPPED_METRIC : forall A:set, A <> Empty -> forall d :e R, forall m :e metric A, mspace A (capped_metric A d m) = mspace A m /\ forall x :e A :*: A, mdist A (capped_metric A d m) x = if d <= 0 then mdist A m (x 0,x 1) else if d <= mdist A m (x 0,x 1) then d else mdist A m (x 0,x 1).
Admitted.

// HOL Light: Multivariate/metric.ml:37514 / MDIST_CAPPED
