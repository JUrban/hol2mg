Theorem CHAIN_IN_OPEN_CONNECTED_SET : forall A:set, forall m :e metric A, forall g c= A, forall e0 :e R, forall a' b' :e A, locally_connected_space A (mtopology A m) /\ (g :e mtopology A m /\ (connected_in A (mtopology A m) g /\ (a' :e g /\ (b' :e g /\ 0 < e0)))) -> exists c' :e Power A :^: omega, exists M' :e omega, (forall i :e omega, i <= M' -> c' i :e mtopology A m /\ (connected_in A (mtopology A m) (c' i) /\ closure_of A (mtopology A m) (c' i) c= g)) /\ (a' :e c' 0 /\ (b' :e c' M' /\ ((forall i :e omega, i < M' -> ~ c' i :/\: c' (ordsucc i) = Empty) /\ forall i :e omega, i <= M' -> forall x y :e A, x :e c' i /\ y :e c' i -> mdist A m (x,y) < e0))).
Admitted.

// HOL Light: Multivariate/metric.ml:36121 / CHAIN_REFINEMENT_STEP
// Source hash: md5:0322ef91a85647a92c807d8cdd6c6686
// Status: generalization_required (bridges: empty_case:A, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_topology, nat_le_SNoLe, nat_lt_SNoLt, omega_Subq_R)
Theorem CHAIN_REFINEMENT_STEP : forall A:set, forall m :e metric A, forall g :e Power A :^: omega, forall M :e omega, forall e0 :e R, forall a b :e A, locally_connected_space A (mtopology A m) /\ ((forall i :e omega, i <= M -> g i :e mtopology A m /\ connected_in A (mtopology A m) (g i)) /\ (a :e g 0 /\ (b :e g M /\ ((forall i :e omega, i < M -> ~ g i :/\: g (ordsucc i) = Empty) /\ 0 < e0)))) -> exists g' :e Power A :^: omega, exists M' :e omega, (forall i :e omega, i <= M' -> g' i :e mtopology A m /\ connected_in A (mtopology A m) (g' i)) /\ (a :e g' 0 /\ (b :e g' M' /\ ((forall i :e omega, i < M' -> ~ g' i :/\: g' (ordsucc i) = Empty) /\ ((forall i :e omega, i <= M' -> forall x y :e A, x :e g' i /\ y :e g' i -> mdist A m (x,y) < e0) /\ ((forall j :e omega, j <= M' -> exists i :e omega, i <= M /\ closure_of A (mtopology A m) (g' j) c= g i) /\ ((exists ff:set -> set, (forall x :e omega, ff x :e omega) /\ ((forall j :e omega, j <= M' -> ff j <= M /\ closure_of A (mtopology A m) (g' j) c= g (ff j)) /\ ((forall j1 j2 :e omega, j1 <= j2 /\ j2 <= M' -> ff j1 <= ff j2) /\ forall i :e omega, i <= M -> exists j :e omega, j <= M' /\ ff j = i))) /\ forall i :e omega, i <= M -> exists j :e omega, j <= M' /\ closure_of A (mtopology A m) (g' j) c= g i)))))).
Admitted.

// HOL Light: Multivariate/metric.ml:36278 / CHAIN_HIERARCHY
// Source hash: md5:aace667e3beab268b92f5bbdf3818e66
// Status: generalization_required (bridges: add_nat_add_SNo, empty_case:A, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_topology, nat_le_SNoLe, nat_lt_SNoLt, omega_Subq_R)
Theorem CHAIN_HIERARCHY : forall A:set, forall m :e metric A, forall a b :e A, connected_space A (mtopology A m) /\ (locally_connected_space A (mtopology A m) /\ (a :e mspace A m /\ b :e mspace A m)) -> exists c :e Power A :^: omega :^: omega, exists N:set -> set, (forall x :e omega, N x :e omega) /\ ((forall n i :e omega, i <= N n -> c n i :e mtopology A m) /\ ((forall n i :e omega, i <= N n -> connected_in A (mtopology A m) (c n i)) /\ ((forall n :e omega, a :e c n 0) /\ ((forall n :e omega, b :e c n (N n)) /\ ((forall n i :e omega, i < N n -> ~ c n i :/\: c n (ordsucc i) = Empty) /\ ((forall n i :e omega, i <= N n -> forall x y :e A, x :e c n i /\ y :e c n i -> mdist A m (x,y) < recip_SNo (n + 1)) /\ ((forall n j :e omega, j <= N (ordsucc n) -> exists i :e omega, i <= N n /\ closure_of A (mtopology A m) (c (ordsucc n) j) c= c n i) /\ ((forall n i :e omega, i <= N n -> exists j :e omega, j <= N (ordsucc n) /\ closure_of A (mtopology A m) (c (ordsucc n) j) c= c n i) /\ forall n :e omega, exists ff:set -> set, (forall x :e omega, ff x :e omega) /\ ((forall j :e omega, j <= N (ordsucc n) -> ff j <= N n /\ closure_of A (mtopology A m) (c (ordsucc n) j) c= c n (ff j)) /\ ((forall j1 j2 :e omega, j1 <= j2 /\ j2 <= N (ordsucc n) -> ff j1 <= ff j2) /\ forall i :e omega, i <= N n -> exists j :e omega, j <= N (ordsucc n) /\ ff j = i)))))))))).
Admitted.

// HOL Light: Multivariate/metric.ml:36359 / MCOMPLETE_DYADIC_APPROXIMATION
// Source hash: md5:9fb011b526d29a9cec12e867df9980b1
// Status: generalization_required (bridges: empty_case:A, exp_nat_exp_SNo_nat, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_topology, nat_le_SNoLe, omega_Subq_R)
Theorem MCOMPLETE_DYADIC_APPROXIMATION : forall A:set, forall m :e metric A, forall a b :e A, mcomplete A m /\ (connected_space A (mtopology A m) /\ (locally_connected_space A (mtopology A m) /\ (a :e mspace A m /\ b :e mspace A m))) -> exists f:set -> set, (forall x :e R, f x :e A) /\ (f 0 = a /\ (f 1 = b /\ ((forall m' n :e omega, m' <= 2 ^ n -> f (m' :/: 2 ^ n) :e mspace A m) /\ forall j :e omega, exists d :e R, 0 < d /\ forall n m1 m2 :e omega, m1 <= 2 ^ n /\ (m2 <= 2 ^ n /\ abs_SNo (m1 :/: 2 ^ n + - m2 :/: 2 ^ n) < d) -> mdist A m (f (m1 :/: 2 ^ n),f (m2 :/: 2 ^ n)) < recip_SNo (2 ^ j)))).
Admitted.

