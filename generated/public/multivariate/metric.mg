// Status: transport_required (bridges: hol_real_R, hol_typedef_topology)
Theorem PATH_CONNECTED_IN_EUCLIDEANREAL : forall s c= R, path_connected_in R euclideanreal s <-> is_realinterval s.
Admitted.

// HOL Light: Multivariate/metric.ml:22335 / PATH_CONNECTED_IN_DISCRETE_TOPOLOGY
// Source hash: md5:bc96b6bc8fe30af83804bcd6e89937fe
// Status: transport_required (bridges: hol_typedef_topology)
Theorem PATH_CONNECTED_IN_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u s c= A, path_connected_in A (discrete_topology A u) s <-> s c= u /\ exists a :e A, s c= {a}.
Admitted.

// HOL Light: Multivariate/metric.ml:22347 / PATH_CONNECTED_SPACE_DISCRETE_TOPOLOGY
// Source hash: md5:6f5c563b39bf3df819b234ecfff7ab07
// Status: transport_required (bridges: hol_typedef_topology)
Theorem PATH_CONNECTED_SPACE_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u c= A, path_connected_space A (discrete_topology A u) <-> exists a :e A, u c= {a}.
Admitted.

// HOL Light: Multivariate/metric.ml:22355 / PATH_CONNECTED_SPACE_PROD_TOPOLOGY
// Source hash: md5:7ee820380bcb8459af49d310f06a67e3
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem PATH_CONNECTED_SPACE_PROD_TOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, path_connected_space (A :*: B) (prod_topology A B top1 top2) <-> topspace (A :*: B) (prod_topology A B top1 top2) = Empty \/ path_connected_space A top1 /\ path_connected_space B top2.
Admitted.

// HOL Light: Multivariate/metric.ml:22390 / PATH_CONNECTED_IN_CROSS
// Source hash: md5:f74e0c4a346d34a0394dbe9a87ffcb0b
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem PATH_CONNECTED_IN_CROSS : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, forall s c= A, forall t c= B, path_connected_in (A :*: B) (prod_topology A B top1 top2) (s :*: t) <-> s = Empty \/ (t = Empty \/ path_connected_in A top1 s /\ path_connected_in B top2 t).
Admitted.

// HOL Light: Multivariate/metric.ml:22404 / PATH_CONNECTED_SPACE_PRODUCT_TOPOLOGY
// Source hash: md5:b928c48bf0ab5f47b7dca2d0eb08e10b
// Status: transport_required (bridges: hol_typedef_topology)
Theorem PATH_CONNECTED_SPACE_PRODUCT_TOPOLOGY : forall A K:set, A <> Empty -> K <> Empty -> forall tops:set -> set, (forall x :e K, tops x :e topology A) -> forall k c= K, path_connected_space (A :^: K) (product_topology A K k tops) <-> topspace (A :^: K) (product_topology A K k tops) = Empty \/ forall i :e K, i :e k -> path_connected_space A (tops i).
Admitted.

// HOL Light: Multivariate/metric.ml:22447 / PATH_CONNECTED_IN_CARTESIAN_PRODUCT
// Source hash: md5:def9c2ce76f3bfe23cdf3966e39f2c11
// Status: transport_required (bridges: hol_fun_setexp, hol_typedef_topology)
Theorem PATH_CONNECTED_IN_CARTESIAN_PRODUCT : forall A K:set, A <> Empty -> K <> Empty -> forall tops:set -> set, (forall x :e K, tops x :e topology A) -> forall s :e Power A :^: K, forall k c= K, path_connected_in (A :^: K) (product_topology A K k tops) {f :e A :^: K | (forall i :e k, f i :e s i) /\ forall i :e K, ~ i :e k -> f i = choose_in A (fun y:set => False)} <-> {f :e A :^: K | (forall i :e k, f i :e s i) /\ forall i :e K, ~ i :e k -> f i = choose_in A (fun y:set => False)} = Empty \/ forall i :e K, i :e k -> path_connected_in A (tops i) (s i).
Admitted.

// HOL Light: Multivariate/metric.ml:22462 / path_component_of
// Source hash: md5:8cf1b6dc3b673da1b8a10357190afefb
// Status: generalization_required (bridges: empty_case:A, hol_num_omega, hol_real_R, hol_typedef_topology, omega_Subq_R)
Theorem path_component_of_thm : forall A:set, forall top :e topology A, forall x y :e A, path_component_of A top x y <-> exists g:set -> set, (forall x0 :e R, g x0 :e A) /\ (path_in A top g /\ (g 0 = x /\ g 1 = y)).
Admitted.

// HOL Light: Multivariate/metric.ml:22466 / path_components_of
// Source hash: md5:12f1162c3c082857b539e2ae28601a06
// Status: transport_required (bridges: hol_typedef_topology)
Theorem path_components_of_thm : forall A:set, A <> Empty -> forall top :e topology A, path_components_of A top = {{x0 :e A | path_component_of A top x x0} | x :e A, x :e topspace A top}.
Admitted.

