// Source hash: md5:a7ba831cba52dbac012dbad21f72ef8e
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem FORALL_IN_CLOSURE_OF_GEN : forall A:set, forall top :e topology A, forall P:set -> prop, forall s c= A, (forall x :e A, x :e s -> P x) /\ closed_in A top {x :e A | x :e closure_of A top s /\ P x} -> forall x :e A, x :e closure_of A top s -> P x.
Admitted.

