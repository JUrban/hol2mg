// Status: transport_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_topology)
Theorem TIETZE_EXTENSION_COMPLETELY_REGULAR : forall A:set, A <> Empty -> forall top :e topology A, forall f:set -> set, (forall x :e A, f x :e R) -> forall s c= A, forall t c= R, completely_regular_space A top /\ (compact_in A top s /\ (is_realinterval t /\ (~ t = Empty /\ (continuous_map A R (subtopology A top s,euclideanreal) f /\ (forall x :e A, x :e s -> f x :e t))))) -> exists g:set -> set, (forall x :e A, g x :e R) /\ (continuous_map A R (top,euclideanreal) g /\ ((forall x :e A, x :e topspace A top -> g x :e t) /\ forall x :e A, x :e s -> g x = f x)).
Admitted.

// HOL Light: Multivariate/metric.ml:40926 / GDELTA_HOMEOMORPHIC_SPACE_CLOSED_IN_PRODUCT
