// Source hash: md5:402d003875091aaa4b2cf504f76ddef6
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CLOSED_MAP_PAIRED_GEN : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e topology A, forall top1 :e topology B, forall top2 :e topology C, forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e A, g x :e C) -> closed_map A B (top,top1) f /\ (closed_map A C (top,top2) g /\ (regular_space B top1 /\ (continuous_map A B (top,top1) f /\ (forall z :e C, z :e topspace C top2 -> closed_in A top {x :e A | x :e topspace A top /\ g x = z})) \/ regular_space C top2 /\ (continuous_map A C (top,top2) g /\ (forall y :e B, y :e topspace B top1 -> closed_in A top {x :e A | x :e topspace A top /\ f x = y})))) -> closed_map A (B :*: C) (top,prod_topology B C top1 top2) (fun x:set => (f x,g x)).
Admitted.

// HOL Light: Multivariate/metric.ml:16473 / CLOSED_MAP_PAIRED
// Source hash: md5:69ec88c7f3270f0af4ec5e5425515b4a
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CLOSED_MAP_PAIRED : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e topology A, forall top1 :e topology B, forall top2 :e topology C, forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e A, g x :e C) -> closed_map A B (top,top1) f /\ (continuous_map A B (top,top1) f /\ (closed_map A C (top,top2) g /\ (continuous_map A C (top,top2) g /\ (t1_space B top1 /\ regular_space C top2 \/ regular_space B top1 /\ t1_space C top2)))) -> closed_map A (B :*: C) (top,prod_topology B C top1 top2) (fun x:set => (f x,g x)).
Admitted.

// HOL Light: Multivariate/metric.ml:16487 / CLOSED_MAP_PAIRWISE
// Source hash: md5:8737da270b707a35beb4ab117e78638b
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CLOSED_MAP_PAIRWISE : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e topology A, forall top1 :e topology B, forall top2 :e topology C, forall f:set -> set, (forall x :e A, f x :e B :*: C) -> closed_map A B (top,top1) (fun x:set => f x 0) /\ (continuous_map A B (top,top1) (fun x:set => f x 0) /\ (closed_map A C (top,top2) (fun x:set => f x 1) /\ (continuous_map A C (top,top2) (fun x:set => f x 1) /\ (t1_space B top1 /\ regular_space C top2 \/ regular_space B top1 /\ t1_space C top2)))) -> closed_map A (B :*: C) (top,prod_topology B C top1 top2) f.
Admitted.

// HOL Light: Multivariate/metric.ml:16497 / CLOSED_MAP_PAIRED_CLOSED_MAP_RIGHT
// Source hash: md5:cf09a13f4f4545547e6b541dba39fdc7
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CLOSED_MAP_PAIRED_CLOSED_MAP_RIGHT : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> closed_map A B (top,top') f /\ ((forall y :e B, y :e topspace B top' -> closed_in A top {x :e A | x :e topspace A top /\ f x = y}) /\ regular_space A top) -> closed_map A (A :*: B) (top,prod_topology A B top top') (fun x:set => (x,f x)).
Admitted.

// HOL Light: Multivariate/metric.ml:16507 / CLOSED_MAP_PAIRED_CLOSED_MAP_LEFT
// Source hash: md5:920d6999372e6007407982a7036cbad3
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CLOSED_MAP_PAIRED_CLOSED_MAP_LEFT : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> closed_map A B (top,top') f /\ ((forall y :e B, y :e topspace B top' -> closed_in A top {x :e A | x :e topspace A top /\ f x = y}) /\ regular_space A top) -> closed_map A (B :*: A) (top,prod_topology B A top' top) (fun x:set => (f x,x)).
Admitted.

// HOL Light: Multivariate/metric.ml:16523 / CLOSED_MAP_IMP_CLOSED_GRAPH
// Source hash: md5:bb8b79bfb452f232c151ff9966920848
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CLOSED_MAP_IMP_CLOSED_GRAPH : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> closed_map A B (top,top') f /\ ((forall y :e B, y :e topspace B top' -> closed_in A top {x :e A | x :e topspace A top /\ f x = y}) /\ regular_space A top) -> closed_in (A :*: B) (prod_topology A B top top') {(x,f x) | x :e A, x :e topspace A top}.
Admitted.

// HOL Light: Multivariate/metric.ml:16538 / PROPER_MAP_PAIRED_CLOSED_MAP_RIGHT
// Source hash: md5:3323b24d497adabad3fbe261f4ef5c31
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem PROPER_MAP_PAIRED_CLOSED_MAP_RIGHT : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> closed_map A B (top,top') f /\ ((forall y :e B, y :e topspace B top' -> closed_in A top {x :e A | x :e topspace A top /\ f x = y}) /\ regular_space A top) -> proper_map A (A :*: B) (top,prod_topology A B top top') (fun x:set => (x,f x)).
Admitted.

// HOL Light: Multivariate/metric.ml:16549 / PROPER_MAP_PAIRED_CLOSED_MAP_LEFT
// Source hash: md5:927904fd3b555db3e6ff75f6db11c3c7
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem PROPER_MAP_PAIRED_CLOSED_MAP_LEFT : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> closed_map A B (top,top') f /\ ((forall y :e B, y :e topspace B top' -> closed_in A top {x :e A | x :e topspace A top /\ f x = y}) /\ regular_space A top) -> proper_map A (B :*: A) (top,prod_topology B A top' top) (fun x:set => (f x,x)).
Admitted.

// HOL Light: Multivariate/metric.ml:16560 / REGULAR_SPACE_CONTINUOUS_PROPER_MAP_IMAGE
// Source hash: md5:1174a87b6a892525b1fae64070fa1c44
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem REGULAR_SPACE_CONTINUOUS_PROPER_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> regular_space A top /\ (continuous_map A B (top,top') f /\ (proper_map A B (top,top') f /\ {f x | x :e topspace A top} = topspace B top')) -> regular_space B top'.
Admitted.

// HOL Light: Multivariate/metric.ml:16593 / REGULAR_SPACE_PERFECT_MAP_IMAGE
// Source hash: md5:89d71777b632791942c5806d26dd5ca6
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem REGULAR_SPACE_PERFECT_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> regular_space A top /\ perfect_map A B (top,top') f -> regular_space B top'.
Admitted.

