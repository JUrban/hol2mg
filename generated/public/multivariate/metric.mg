Theorem regular_space_thm : forall A:set, A <> Empty -> forall top :e topology A, regular_space A top <-> forall c c= A, forall a :e A, closed_in A top c /\ a :e topspace A top :\: c -> exists u v c= A, u :e top /\ (v :e top /\ (a :e u /\ (c c= v /\ u :/\: v = Empty))).
