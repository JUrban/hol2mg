// HOL Light: Multivariate/metric.ml:26316 / QUASI_COMPONENT_OF_EQUIV
// Source hash: md5:ac3f97f7e104a1ca5a7c6f830cb1a5d7
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem QUASI_COMPONENT_OF_EQUIV : forall A:set, forall top :e topology A, forall x y :e A, quasi_component_of A top x y <-> x :e topspace A top /\ (y :e topspace A top /\ forall x0 :e A, quasi_component_of A top x x0 <-> quasi_component_of A top y x0).
Admitted.

// HOL Light: Multivariate/metric.ml:26325 / QUASI_COMPONENT_OF_DISJOINT
// Source hash: md5:e8f2c64a23fc6a59b6a0575ee343c89c
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem QUASI_COMPONENT_OF_DISJOINT : forall A:set, forall top :e topology A, forall x y :e A, {x0 :e A | quasi_component_of A top x x0} :/\: {x0 :e A | quasi_component_of A top y x0} = Empty <-> ~ quasi_component_of A top x y.
Admitted.

// HOL Light: Multivariate/metric.ml:26334 / QUASI_COMPONENT_OF_EQ
// Source hash: md5:1ed4e0d775fb7eeb697d9d0c63996262
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem QUASI_COMPONENT_OF_EQ : forall A:set, forall top :e topology A, forall x y :e A, (forall x0 :e A, quasi_component_of A top x x0 <-> quasi_component_of A top y x0) <-> ~ x :e topspace A top /\ ~ y :e topspace A top \/ x :e topspace A top /\ (y :e topspace A top /\ quasi_component_of A top x y).
Admitted.

