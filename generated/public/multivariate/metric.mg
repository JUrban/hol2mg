// Status: transport_required (bridges: hol_typedef_topology)
Theorem K_SPACE_CLOSED_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, k_space A top /\ closed_in A top s -> k_space A (subtopology A top s).
