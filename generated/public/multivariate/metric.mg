// Status: transport_required (bridges: hol_typedef_topology)
Theorem LOCALLY_COMPACT_SPACE_COMPACT_CLOSED_IN : forall A:set, A <> Empty -> forall top :e topology A, hausdorff_space A top \/ regular_space A top -> (locally_compact_space A top <-> forall x :e A, x :e topspace A top -> exists u k c= A, u :e top /\ (compact_in A top k /\ (closed_in A top k /\ (x :e u /\ u c= k)))).
Admitted.

