// Source hash: md5:6290b02bf42d02f52273685308befe97
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem IN_CLOSURE_OF : forall A:set, forall top :e topology A, forall s c= A, forall x :e A, x :e closure_of A top s <-> x :e topspace A top /\ forall t c= A, x :e t /\ t :e top -> exists y :e A, y :e s /\ y :e t.
Admitted.

// HOL Light: Multivariate/metric.ml:1103 / CLOSURE_OF
// Source hash: md5:b2165d93208cfea8af81b9ad28a26421
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CLOSURE_OF : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, closure_of A top s = topspace A top :/\: (s :\/: derived_set_of A top s).
Admitted.

