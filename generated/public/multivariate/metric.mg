// Status: transport_required (bridges: hol_typedef_topology)
Theorem paracompact_space_thm : forall A:set, A <> Empty -> forall top :e topology A, paracompact_space A top <-> forall U c= Power A, (forall u c= A, u :e U -> u :e top) /\ Union U = topspace A top -> exists V c= Power A, (forall v c= A, v :e V -> v :e top) /\ (Union V = topspace A top /\ ((forall v c= A, v :e V -> exists u c= A, u :e U /\ v c= u) /\ locally_finite_in A top V)).
