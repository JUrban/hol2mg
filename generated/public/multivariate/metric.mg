Theorem OPEN_QUASI_EQ_CONNECTED_COMPONENTS_OF : forall A:set, A <> Empty -> forall top :e topology A, forall c c= A, c :e top -> (c :e quasi_components_of A top <-> c :e connected_components_of A top).
Admitted.

// HOL Light: Multivariate/metric.ml:26810 / QUASI_COMPONENT_OF_CONTINUOUS_IMAGE
// Source hash: md5:730da14d414960bb7143cb9a9ca71c00
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_typedef_topology)
Theorem QUASI_COMPONENT_OF_CONTINUOUS_IMAGE : forall A B:set, B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall x y :e A, continuous_map A B (top,top') f /\ quasi_component_of A top x y -> quasi_component_of B top' (f x) (f y).
Admitted.

// HOL Light: Multivariate/metric.ml:26825 / QUASI_COMPONENT_OF_DISCRETE_TOPOLOGY
// Source hash: md5:c57ca94c9e3362778a59221bdd7da2fd
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem QUASI_COMPONENT_OF_DISCRETE_TOPOLOGY : forall A:set, forall u c= A, forall x x0 :e A, quasi_component_of A (discrete_topology A u) x x0 <-> (x :e u -> x0 :e SetAdjoin Empty x) /\ (~ x :e u -> x0 :e Empty).
Admitted.

// HOL Light: Multivariate/metric.ml:26837 / QUASI_COMPONENTS_OF_DISCRETE_TOPOLOGY
// Source hash: md5:09d42dae918f620ee71c45c7bc1e86cb
// Status: transport_required (bridges: hol_typedef_topology)
Theorem QUASI_COMPONENTS_OF_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u c= A, quasi_components_of A (discrete_topology A u) = {{x} | x :e A, x :e u}.
Admitted.

// HOL Light: Multivariate/metric.ml:26845 / HOMEOMORPHIC_MAP_QUASI_COMPONENT_OF
// Source hash: md5:427d472cb10a274709822fa19369951c
// Status: generalization_required (bridges: empty_case:A, empty_case:B, hol_prod_setprod, hol_typedef_topology)
Theorem HOMEOMORPHIC_MAP_QUASI_COMPONENT_OF : forall A B:set, forall f:set -> set, (forall x :e A, f x :e B) -> forall top :e topology A, forall top' :e topology B, forall x :e A, homeomorphic_map A B (top,top') f /\ x :e topspace A top -> forall x0 :e B, quasi_component_of B top' (f x) x0 <-> x0 :e {f x0 | x0 :e {x1 :e A | quasi_component_of A top x x1}}.
Admitted.

// HOL Light: Multivariate/metric.ml:26864 / HOMEOMORPHIC_MAP_QUASI_COMPONENTS_OF
// Source hash: md5:407ddc9950d063f8fab61d4e4693adf7
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HOMEOMORPHIC_MAP_QUASI_COMPONENTS_OF : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall top :e topology A, forall top' :e topology B, homeomorphic_map A B (top,top') f -> quasi_components_of B top' = {{x0 :e B | x0 :e {f x0 | x0 :e x}} | x :e quasi_components_of A top}.
Admitted.

