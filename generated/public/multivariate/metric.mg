// HOL Light: Multivariate/metric.ml:10220 / second_countable
// Source hash: md5:9577a94caf0b03c8fc4a8faca3919147
// Status: transport_required (bridges: hol_countable, hol_typedef_topology)
Theorem second_countable_thm : forall A:set, A <> Empty -> forall top :e topology A, second_countable A top <-> exists b c= Power A, countable b /\ ((forall v c= A, v :e b -> v :e top) /\ forall u c= A, forall x :e A, u :e top /\ x :e u -> exists v c= A, v :e b /\ (x :e v /\ v c= u)).
Admitted.

// HOL Light: Multivariate/metric.ml:10227 / first_countable
// Source hash: md5:9e839deb18e2e9d43965a0b91a0501b3
// Status: transport_required (bridges: hol_countable, hol_typedef_topology)
Theorem first_countable_thm : forall A:set, A <> Empty -> forall top :e topology A, first_countable A top <-> forall x :e A, x :e topspace A top -> exists b c= Power A, countable b /\ ((forall v c= A, v :e b -> v :e top) /\ forall u c= A, u :e top /\ x :e u -> exists v c= A, v :e b /\ (x :e v /\ v c= u)).
Admitted.

// HOL Light: Multivariate/metric.ml:10235 / separable_space
// Source hash: md5:43120608288838a9f5a227a73f44a582
// Status: transport_required (bridges: hol_countable, hol_typedef_topology)
Theorem separable_space_thm : forall A:set, A <> Empty -> forall top :e topology A, separable_space A top <-> exists c c= A, countable c /\ (c c= topspace A top /\ closure_of A top c = topspace A top).
Admitted.

// HOL Light: Multivariate/metric.ml:10241 / SECOND_COUNTABLE
// Source hash: md5:e90e9e77c0a83963884b0c66b8f1c6c5
// Status: transport_required (bridges: hol_countable, hol_typedef_topology)
Theorem SECOND_COUNTABLE : forall A:set, A <> Empty -> forall top :e topology A, second_countable A top <-> exists b c= Power A, countable b /\ forall x c= A, x :e top <-> exists u c= Power A, True /\ (forall x0 :e u, x0 :e b) /\ Union u = x.
Admitted.

