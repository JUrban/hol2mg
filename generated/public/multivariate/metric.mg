// Status: transport_required (bridges: hol_typedef_topology)
Theorem INTERIOR_OF_SUBTOPOLOGY_OPEN : forall A:set, A <> Empty -> forall top :e topology A, forall u s c= A, u :e top -> interior_of A (subtopology A top u) s = u :/\: interior_of A top s.
Admitted.

// HOL Light: Multivariate/metric.ml:1670 / DENSE_INTERSECTS_OPEN
// Source hash: md5:d15c42dc0577f0f0110b6237cbe5f2a6
// Status: transport_required (bridges: hol_typedef_topology)
Theorem DENSE_INTERSECTS_OPEN : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, closure_of A top s = topspace A top <-> forall t c= A, t :e top /\ ~ t = Empty -> ~ s :/\: t = Empty.
Admitted.

