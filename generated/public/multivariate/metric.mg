Theorem LIPSCHITZ_CONTINUOUS_MAP_FROM_SUBMETRIC : forall A B:set, A <> Empty -> B <> Empty -> forall m1 :e metric A, forall m2 :e metric B, forall s c= A, forall f:set -> set, (forall x :e A, f x :e B) -> lipschitz_continuous_map B A (m1,m2) f -> lipschitz_continuous_map B A (submetric A m1 s,m2) f.
Admitted.

