// Source hash: md5:2cdb63f27092f17e9b8570e27136250c
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SEPARABLE_METRIZABLE_IMP_SECOND_COUNTABLE : forall A:set, A <> Empty -> forall top :e topology A, separable_space A top /\ metrizable_space A top -> second_countable A top.
Admitted.

// HOL Light: Multivariate/metric.ml:12945 / SECOND_COUNTABLE_CLOSED_MAP_IMAGE
// Source hash: md5:3b2b809a421f627d5e8f2a3c6b4af1c1
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem SECOND_COUNTABLE_CLOSED_MAP_IMAGE : forall B C:set, B <> Empty -> C <> Empty -> forall f:set -> set, (forall x :e B, f x :e C) -> forall top :e topology B, forall top' :e topology C, continuous_map B C (top,top') f /\ (closed_map B C (top,top') f /\ (compact_space B top /\ (hausdorff_space C top' /\ ({f x | x :e topspace B top} = topspace C top' /\ second_countable B top)))) -> second_countable C top'.
Admitted.

// HOL Light: Multivariate/metric.ml:13067 / connected_space
// Source hash: md5:a3f22996701071d69fd0a1e1e5f054f0
// Status: transport_required (bridges: hol_typedef_topology)
Theorem connected_space_thm : forall A:set, A <> Empty -> forall top :e topology A, connected_space A top <-> ~ exists e1 e2 c= A, e1 :e top /\ (e2 :e top /\ (topspace A top c= e1 :\/: e2 /\ (e1 :/\: e2 = Empty /\ (~ e1 = Empty /\ ~ e2 = Empty)))).
Admitted.

