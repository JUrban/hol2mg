// HOL Light: Multivariate/metric.ml:11277 / FSIGMA_IMP_BOREL_IN
// Source hash: md5:4fbe0a76ffcba8bb9f64ec210dc01301
// Status: transport_required (bridges: hol_typedef_topology)
Theorem FSIGMA_IMP_BOREL_IN : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, s :e fsigma_in A top -> borel_in A top s.
Admitted.

// HOL Light: Multivariate/metric.ml:11286 / GDELTA_IMP_BOREL_IN
// Source hash: md5:b874b9bf15f5ebcad2d27e5aeec853b8
// Status: transport_required (bridges: hol_typedef_topology)
Theorem GDELTA_IMP_BOREL_IN : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, s :e gdelta_in A top -> borel_in A top s.
Admitted.

// HOL Light: Multivariate/metric.ml:11290 / OPEN_IN_SUBTOPOLOGY_BOREL_IN
// Source hash: md5:c8889cb16df3a164f9aede5e476210e6
// Status: transport_required (bridges: hol_typedef_topology)
Theorem OPEN_IN_SUBTOPOLOGY_BOREL_IN : forall A:set, A <> Empty -> forall top :e topology A, forall t s c= A, s :e subtopology A top t /\ borel_in A top t -> borel_in A top s.
Admitted.

// HOL Light: Multivariate/metric.ml:11298 / CLOSED_IN_SUBTOPOLOGY_BOREL_IN
// Source hash: md5:20d53ec0efbfb1613b4f224f5416a9b7
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CLOSED_IN_SUBTOPOLOGY_BOREL_IN : forall A:set, A <> Empty -> forall top :e topology A, forall t s c= A, closed_in A (subtopology A top t) s /\ borel_in A top t -> borel_in A top s.
Admitted.

// HOL Light: Multivariate/metric.ml:11306 / BOREL_IN_SUBTOPOLOGY
// Source hash: md5:ebc195bbd487c8d8139e9a2cfa504b61
// Status: transport_required (bridges: hol_typedef_topology)
Theorem BOREL_IN_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e topology A, forall u s c= A, borel_in A (subtopology A top u) s <-> exists t c= A, borel_in A top t /\ s = t :/\: u.
Admitted.

// HOL Light: Multivariate/metric.ml:11341 / BOREL_FROM_SUBTOPOLOGY
// Source hash: md5:17ccff0bd5601a039522ec8149401214
// Status: transport_required (bridges: hol_typedef_topology)
Theorem BOREL_FROM_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e topology A, forall u s c= A, borel_in A (subtopology A top u) s /\ borel_in A top u -> borel_in A top s.
Admitted.

// HOL Light: Multivariate/metric.ml:11346 / BOREL_IN_INTER_SUBTOPOLOGY
// Source hash: md5:4870af2ad58dd5aeebcc58ca96e7851c
// Status: transport_required (bridges: hol_typedef_topology)
Theorem BOREL_IN_INTER_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, borel_in A top t -> borel_in A (subtopology A top s) (t :/\: s).
Admitted.

// HOL Light: Multivariate/metric.ml:11351 / BOREL_IN_SUBTOPOLOGY_EQ
// Source hash: md5:fcce9d74b7d5b8d3f479e1a24ceb6b20
// Status: transport_required (bridges: hol_typedef_topology)
Theorem BOREL_IN_SUBTOPOLOGY_EQ : forall A:set, A <> Empty -> forall top :e topology A, forall u s c= A, borel_in A top u -> (borel_in A (subtopology A top u) s <-> borel_in A top s /\ s c= u).
Admitted.

// HOL Light: Multivariate/metric.ml:11358 / BOREL_IN_CONTINUOUS_MAP_PREIMAGE
// Source hash: md5:9260e15dead34a21007a6be3d321ed75
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem BOREL_IN_CONTINUOUS_MAP_PREIMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall t c= B, continuous_map A B (top1,top2) f /\ borel_in B top2 t -> borel_in A top1 {x :e A | x :e topspace A top1 /\ f x :e t}.
Admitted.

// HOL Light: Multivariate/metric.ml:11388 / BOREL_IN_HOMEOMORPHIC_MAP_IMAGE
// Source hash: md5:63756ce1ab912042cb93e0dd7b010ac8
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem BOREL_IN_HOMEOMORPHIC_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall s c= A, homeomorphic_map A B (top,top') f /\ borel_in A top s -> borel_in B top' {f x | x :e s}.
Admitted.

// HOL Light: Multivariate/metric.ml:11403 / BOREL_IN_HOMEOMORPHIC_MAPS_IMAGE_EQ
// Source hash: md5:b2463878fc0c97398a160ed6e8bd8611
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem BOREL_IN_HOMEOMORPHIC_MAPS_IMAGE_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f :e B :^: A, forall g :e A :^: B, forall s c= A, homeomorphic_maps A B (top,top') (f,g) /\ s c= topspace A top -> (borel_in B top' {f x | x :e s} <-> borel_in A top s).
Admitted.

// HOL Light: Multivariate/metric.ml:11412 / BOREL_IN_HOMEOMORPHIC_MAP_IMAGE_EQ
// Source hash: md5:0e033adfc9e85247e744f18b222b6de1
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem BOREL_IN_HOMEOMORPHIC_MAP_IMAGE_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall s c= A, homeomorphic_map A B (top,top') f /\ s c= topspace A top -> (borel_in B top' {f x | x :e s} <-> borel_in A top s).
Admitted.

// HOL Light: Multivariate/metric.ml:11424 / borel_measurable_map
// Source hash: md5:87c6a9cb3026495ef753597c26aa0bbf
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem borel_measurable_map_thm : forall A B:set, A <> Empty -> B <> Empty -> forall top2 :e topology B, forall top1 :e topology A, forall f:set -> set, (forall x :e A, f x :e B) -> (borel_measurable_map A B (top1,top2) f <-> (forall x :e A, x :e topspace A top1 -> f x :e topspace B top2) /\ forall u c= B, borel_in B top2 u -> borel_in A top1 {x :e A | x :e topspace A top1 /\ f x :e u}).
Admitted.

// HOL Light: Multivariate/metric.ml:11430 / BOREL_MEASURABLE_MAP_OPEN_IN
// Source hash: md5:029cd5e91273dbedfd3432561aaf038c
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem BOREL_MEASURABLE_MAP_OPEN_IN : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> (borel_measurable_map A B (top1,top2) f <-> (forall x :e A, x :e topspace A top1 -> f x :e topspace B top2) /\ forall c c= B, c :e top2 -> borel_in A top1 {x :e A | x :e topspace A top1 /\ f x :e c}).
Admitted.

// HOL Light: Multivariate/metric.ml:11455 / BOREL_MEASURABLE_MAP_CLOSED_IN
// Source hash: md5:c95b276173f30381b8afcb12627dcb93
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem BOREL_MEASURABLE_MAP_CLOSED_IN : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> (borel_measurable_map A B (top1,top2) f <-> (forall x :e A, x :e topspace A top1 -> f x :e topspace B top2) /\ forall c c= B, closed_in B top2 c -> borel_in A top1 {x :e A | x :e topspace A top1 /\ f x :e c}).
Admitted.

// HOL Light: Multivariate/metric.ml:11475 / BOREL_MEASURABLE_MAP_IMAGE_SUBSET_TOPSPACE
// Source hash: md5:65c808933ebb93a8323109b5aa2c0f35
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem BOREL_MEASURABLE_MAP_IMAGE_SUBSET_TOPSPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> borel_measurable_map A B (top1,top2) f -> {f x | x :e topspace A top1} c= topspace B top2.
Admitted.

// HOL Light: Multivariate/metric.ml:11481 / CONTINUOUS_IMP_BOREL_MEASURABLE_MAP
// Source hash: md5:3b2cc676e65cb1ac6b53a57b0284b733
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_IMP_BOREL_MEASURABLE_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> continuous_map A B (top1,top2) f -> borel_measurable_map A B (top1,top2) f.
Admitted.

// HOL Light: Multivariate/metric.ml:11488 / BOREL_MEASURABLE_MAP_ID
// Source hash: md5:a0c2d26e9138d0f823359c911a8bfb84
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem BOREL_MEASURABLE_MAP_ID : forall A:set, A <> Empty -> forall top :e topology A, borel_measurable_map A A (top,top) (fun x:set => x).
Admitted.

// HOL Light: Multivariate/metric.ml:11492 / BOREL_MEASURABLE_MAP_CONST
// Source hash: md5:04011c9f69b09ada7a3d636c67c73f1b
// Status: generalization_required (bridges: empty_case:B, hol_prod_setprod, hol_typedef_topology)
Theorem BOREL_MEASURABLE_MAP_CONST : forall A B:set, A <> Empty -> forall top1 :e topology A, forall top2 :e topology B, forall c :e B, borel_measurable_map A B (top1,top2) (fun x:set => c) <-> topspace A top1 = Empty \/ c :e topspace B top2.
Admitted.

// HOL Light: Multivariate/metric.ml:11508 / BOREL_MEASURABLE_MAP_EQ
// Source hash: md5:edc6ad4593d76cbdc56bf8c1ee53fb81
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem BOREL_MEASURABLE_MAP_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e A, g x :e B) -> (forall x :e A, x :e topspace A top1 -> f x = g x) /\ borel_measurable_map A B (top1,top2) f -> borel_measurable_map A B (top1,top2) g.
Admitted.

// HOL Light: Multivariate/metric.ml:11522 / BOREL_MEASURABLE_MAP_COMPOSE
// Source hash: md5:d6fb952c708f11bbfaf227576268d768
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem BOREL_MEASURABLE_MAP_COMPOSE : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top1 :e topology A, forall top2 :e topology B, forall top3 :e topology C, forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e B, g x :e C) -> borel_measurable_map A B (top1,top2) f /\ borel_measurable_map B C (top2,top3) g -> borel_measurable_map A C (top1,top3) (fun x:set => g (f x)).
Admitted.

// HOL Light: Multivariate/metric.ml:11536 / BOREL_MEASURABLE_MAP_FROM_SUBTOPOLOGY
// Source hash: md5:03e438400c9ac55cc3d2683ed23b8fa8
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem BOREL_MEASURABLE_MAP_FROM_SUBTOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall s c= A, borel_measurable_map A B (top1,top2) f -> borel_measurable_map A B (subtopology A top1 s,top2) f.
Admitted.

// HOL Light: Multivariate/metric.ml:11550 / BOREL_MEASURABLE_MAP_INTO_SUBTOPOLOGY
// Source hash: md5:761ddfc4e004bf5409f0263d4ba70fc2
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem BOREL_MEASURABLE_MAP_INTO_SUBTOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall s c= B, borel_measurable_map A B (top1,subtopology B top2 s) f <-> borel_measurable_map A B (top1,top2) f /\ {f x | x :e topspace A top1} c= s.
Admitted.

// HOL Light: Multivariate/metric.ml:11575 / is_metric_space
// Source hash: md5:de33a1978776f9c63f92642fb0047670
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem is_metric_space_thm : forall A:set, A <> Empty -> forall s c= A, forall d :e R :^: (A :*: A), is_metric_space A (s,d) <-> (forall x y :e A, x :e s /\ y :e s -> 0 <= d (x,y)) /\ ((forall x y :e A, x :e s /\ y :e s -> (d (x,y) = 0 <-> x = y)) /\ ((forall x y :e A, x :e s /\ y :e s -> d (x,y) = d (y,x)) /\ forall x y z :e A, x :e s /\ (y :e s /\ z :e s) -> d (x,z) <= d (x,y) + d (y,z))).
Admitted.

// HOL Light: Multivariate/metric.ml:11582 / IS_METRIC_SPACE
// Source hash: md5:8279baa69296b7c64db4900c9b8bb119
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem IS_METRIC_SPACE : forall A:set, A <> Empty -> forall s c= A, forall d :e R :^: (A :*: A), is_metric_space A (s,d) <-> (forall x y :e A, x :e s /\ y :e s -> (d (x,y) = 0 <-> x = y)) /\ forall x y z :e A, x :e s /\ (y :e s /\ z :e s) -> d (x,z) <= d (y,x) + d (y,z).
Admitted.

// HOL Light: Multivariate/metric.ml:11597 / metric_tybij
// Source hash: md5:e783c59972e20f15bb3bfe87b5dfe4bb
// Status: generalization_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem metric_tybij : forall A:set, A <> Empty -> (forall a :e metric A, a = a) /\ forall r :e Power A :*: R :^: (A :*: A), is_metric_space A r <-> r = r.
Admitted.

// HOL Light: Multivariate/metric.ml:11603 / IS_METRIC_SPACE_SUBSPACE
// Source hash: md5:308929510de82fc6100d2e7394ebcbfe
// Status: transport_required (bridges: hol_prod_setprod, hol_real_R)
Theorem IS_METRIC_SPACE_SUBSPACE : forall A:set, A <> Empty -> forall s c= A, forall d :e R :^: (A :*: A), is_metric_space A (s,d) -> forall s' c= A, s' c= s -> is_metric_space A (s',d).
Admitted.

// HOL Light: Multivariate/metric.ml:11608 / mspace
// Source hash: md5:63a4a3e5301b9b8ab056fff53a4b8853
// Status: transport_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem mspace_thm : forall A:set, A <> Empty -> forall m :e metric A, mspace A m = m 0.
Admitted.

// HOL Light: Multivariate/metric.ml:11611 / mdist
// Source hash: md5:1f35c5c9d89c78347f7c86c57690104e
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem mdist_thm : forall A:set, forall m :e metric A, forall x :e A :*: A, mdist A m x = m 1 x.
Admitted.

// HOL Light: Multivariate/metric.ml:11614 / METRIC
// Source hash: md5:c2086e63439a22a14ca24c194c2a967c
// Status: generalization_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem METRIC : forall A:set, A <> Empty -> forall s c= A, forall d :e R :^: (A :*: A), is_metric_space A (s,d) -> mspace A (s,d) = s /\ forall x :e A :*: A, mdist A (s,d) x = d x.
Admitted.

// HOL Light: Multivariate/metric.ml:11620 / MSPACE
// Source hash: md5:ae1d537b90b02074e3b4d7a0d82443ca
// Status: generalization_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem MSPACE : forall A:set, A <> Empty -> forall s c= A, forall d :e R :^: (A :*: A), is_metric_space A (s,d) -> mspace A (s,d) = s.
Admitted.

// HOL Light: Multivariate/metric.ml:11624 / MDIST
// Source hash: md5:06498f38c1a5dbfb4f0c17e571c81462
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem MDIST : forall A:set, forall s c= A, forall d :e R :^: (A :*: A), is_metric_space A (s,d) -> forall x :e A :*: A, mdist A (s,d) x = d x.
Admitted.

// HOL Light: Multivariate/metric.ml:11650 / REAL_ABS_MDIST
// Source hash: md5:10780492c5afb03b60feba4af2520615
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem REAL_ABS_MDIST : forall A:set, forall m :e metric A, forall x y :e A, x :e mspace A m /\ y :e mspace A m -> abs_SNo (mdist A m (x,y)) = mdist A m (x,y).
Admitted.

// HOL Light: Multivariate/metric.ml:11655 / MDIST_POS_LT
// Source hash: md5:b2c823a3b8e1da7f88706b06b0ea9358
// Status: generalization_required (bridges: empty_case:A, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, omega_Subq_R)
Theorem MDIST_POS_LT : forall A:set, forall m :e metric A, forall x y :e A, x :e mspace A m /\ (y :e mspace A m /\ ~ x = y) -> 0 < mdist A m (x,y).
Admitted.

// HOL Light: Multivariate/metric.ml:11660 / MDIST_REFL
// Source hash: md5:8c90e6d4f78f6ebb2d9b15ea2bcdc0ac
// Status: generalization_required (bridges: empty_case:A, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, omega_Subq_R)
Theorem MDIST_REFL : forall A:set, forall m :e metric A, forall x :e A, x :e mspace A m -> mdist A m (x,x) = 0.
Admitted.

// HOL Light: Multivariate/metric.ml:11664 / MDIST_POS_EQ
// Source hash: md5:67ec83d31a6982ed5e863d195ecd10fa
// Status: generalization_required (bridges: empty_case:A, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, omega_Subq_R)
Theorem MDIST_POS_EQ : forall A:set, forall m :e metric A, forall x y :e A, x :e mspace A m /\ y :e mspace A m -> (0 < mdist A m (x,y) <-> ~ x = y).
Admitted.

// HOL Light: Multivariate/metric.ml:11670 / MDIST_REVERSE_TRIANGLE
// Source hash: md5:e7b219e074622aa20ffb32936018b2a7
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem MDIST_REVERSE_TRIANGLE : forall A:set, forall m :e metric A, forall x y z :e A, x :e mspace A m /\ (y :e mspace A m /\ z :e mspace A m) -> abs_SNo (mdist A m (x,y) + - mdist A m (y,z)) <= mdist A m (x,z).
Admitted.

// HOL Light: Multivariate/metric.ml:11687 / mball
// Source hash: md5:9b9f307003f6e45d111ed1c3c6e39a91
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem mball_thm : forall A:set, forall m :e metric A, forall x :e A, forall r :e R, mball A m (x,r) = {y :e A | x :e mspace A m /\ (y :e mspace A m /\ mdist A m (x,y) < r)}.
Admitted.

// HOL Light: Multivariate/metric.ml:11691 / IN_MBALL
// Source hash: md5:c7dde3bd874efc23dac15b4588a484ae
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem IN_MBALL : forall A:set, forall m :e metric A, forall x y :e A, forall r :e R, y :e mball A m (x,r) <-> x :e mspace A m /\ (y :e mspace A m /\ mdist A m (x,y) < r).
Admitted.

// HOL Light: Multivariate/metric.ml:11697 / CENTRE_IN_MBALL
// Source hash: md5:e8172892c44753179052282acb6f0949
// Status: generalization_required (bridges: empty_case:A, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, omega_Subq_R)
Theorem CENTRE_IN_MBALL : forall A:set, forall m :e metric A, forall x :e A, forall r :e R, 0 < r /\ x :e mspace A m -> x :e mball A m (x,r).
Admitted.

// HOL Light: Multivariate/metric.ml:11701 / CENTRE_IN_MBALL_EQ
// Source hash: md5:424408e1325482e1e51c51893bad5c9f
// Status: generalization_required (bridges: empty_case:A, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, omega_Subq_R)
Theorem CENTRE_IN_MBALL_EQ : forall A:set, forall m :e metric A, forall x :e A, forall r :e R, x :e mball A m (x,r) <-> x :e mspace A m /\ 0 < r.
Admitted.

// HOL Light: Multivariate/metric.ml:11707 / MBALL_SUBSET_MSPACE
// Source hash: md5:e0e14da4e1f5f3c475208bd885e5a08d
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem MBALL_SUBSET_MSPACE : forall A:set, forall m :e metric A, forall x :e A, forall r :e R, mball A m (x,r) c= mspace A m.
Admitted.

// HOL Light: Multivariate/metric.ml:11711 / MBALL_EMPTY
// Source hash: md5:30ffe49f7fae8af0bb6b212f89ad78a6
// Status: generalization_required (bridges: empty_case:A, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, omega_Subq_R)
Theorem MBALL_EMPTY : forall A:set, forall m :e metric A, forall x :e A, forall r :e R, r <= 0 -> mball A m (x,r) = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:11716 / MBALL_EMPTY_ALT
// Source hash: md5:981d7df343d0d7b4b6c66f0b8ff7f033
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem MBALL_EMPTY_ALT : forall A:set, forall m :e metric A, forall x :e A, forall r :e R, ~ x :e mspace A m -> mball A m (x,r) = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:11720 / MBALL_EQ_EMPTY
// Source hash: md5:43b05dd4abbbd08413fe5de0ef8898c5
// Status: generalization_required (bridges: empty_case:A, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, omega_Subq_R)
Theorem MBALL_EQ_EMPTY : forall A:set, forall m :e metric A, forall x :e A, forall r :e R, mball A m (x,r) = Empty <-> ~ x :e mspace A m \/ r <= 0.
Admitted.

// HOL Light: Multivariate/metric.ml:11726 / MBALL_SUBSET
// Source hash: md5:5f8f0360e2b8dcfe1ea3c3f4f3aa6257
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem MBALL_SUBSET : forall A:set, forall m :e metric A, forall x y :e A, forall a b :e R, y :e mspace A m /\ mdist A m (x,y) + a <= b -> mball A m (x,a) c= mball A m (y,b).
Admitted.

// HOL Light: Multivariate/metric.ml:11736 / DISJOINT_MBALL
// Source hash: md5:2a1778d41ac0c8fb0a8db29b9b30d818
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem DISJOINT_MBALL : forall A:set, forall m :e metric A, forall x x' :e A, forall r r' :e R, r + r' <= mdist A m (x,x') -> mball A m (x,r) :/\: mball A m (x',r') = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:11748 / MBALL_SUBSET_CONCENTRIC
// Source hash: md5:c72d50e94af7a0fee2e938421397b19c
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem MBALL_SUBSET_CONCENTRIC : forall A:set, forall m :e metric A, forall x :e A, forall r1 r2 :e R, r1 <= r2 -> mball A m (x,r1) c= mball A m (x,r2).
Admitted.

// HOL Light: Multivariate/metric.ml:11756 / submetric
// Source hash: md5:c42a9355d1640d77a8f6a5a1c90074f1
// Status: generalization_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem submetric_thm : forall A:set, A <> Empty -> forall s c= A, forall m :e metric A, submetric A m s = (s :/\: mspace A m,fun x :e A :*: A => mdist A m x).
Admitted.

// HOL Light: Multivariate/metric.ml:11759 / SUBMETRIC
// Source hash: md5:166710d83dfaed9a7cf322a6c610335c
// Status: transport_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem SUBMETRIC : forall A:set, A <> Empty -> (forall m :e metric A, forall s c= A, mspace A (submetric A m s) = s :/\: mspace A m) /\ forall m :e metric A, forall s c= A, forall x :e A :*: A, mdist A (submetric A m s) x = mdist A m x.
Admitted.

// HOL Light: Multivariate/metric.ml:11768 / MBALL_SUBMETRIC_EQ
// Source hash: md5:ebb5c8355fe386c7b473ed71fe2353af
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem MBALL_SUBMETRIC_EQ : forall A:set, forall m :e metric A, forall s c= A, forall a :e A, forall r :e R, mball A (submetric A m s) (a,r) = if a :e s then s :/\: mball A m (a,r) else Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:11775 / MBALL_SUBMETRIC
// Source hash: md5:1b4db9faa5c30006e54b3b560fad0942
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem MBALL_SUBMETRIC : forall A:set, forall m :e metric A, forall s c= A, forall x :e A, forall r :e R, x :e s -> mball A (submetric A m s) (x,r) = mball A m (x,r) :/\: s.
Admitted.

// HOL Light: Multivariate/metric.ml:11779 / SUBMETRIC_UNIV
// Source hash: md5:cd6bf0aaaa5e9bcafd50bf7f0d0c4cc0
// Status: transport_required (bridges: hol_typedef_metric)
Theorem SUBMETRIC_UNIV : forall A:set, A <> Empty -> forall m :e metric A, submetric A m A = m.
Admitted.

// HOL Light: Multivariate/metric.ml:11783 / SUBMETRIC_SUBMETRIC
// Source hash: md5:1de14290ba4242345a480f6c76e09edb
// Status: transport_required (bridges: hol_typedef_metric)
Theorem SUBMETRIC_SUBMETRIC : forall A:set, A <> Empty -> forall m :e metric A, forall s t c= A, submetric A (submetric A m s) t = submetric A m (s :/\: t).
Admitted.

// HOL Light: Multivariate/metric.ml:11790 / SUBMETRIC_MSPACE
// Source hash: md5:65dcce534ca4261b5120a48cb2340334
// Status: transport_required (bridges: hol_typedef_metric)
Theorem SUBMETRIC_MSPACE : forall A:set, A <> Empty -> forall m :e metric A, submetric A m (mspace A m) = m.
Admitted.

// HOL Light: Multivariate/metric.ml:11796 / SUBMETRIC_RESTRICT
// Source hash: md5:4eb0f676fd09a484f2d63e1da955d93a
// Status: generalization_required (bridges: empty_case:A, hol_typedef_metric)
Theorem SUBMETRIC_RESTRICT : forall A:set, forall m :e metric A, forall s c= A, submetric A m s = submetric A m (mspace A m :/\: s).
Admitted.

// HOL Light: Multivariate/metric.ml:11806 / mtopology
// Source hash: md5:d4efc80ba7e8f41604a1993d606023b9
// Status: generalization_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_topology, omega_Subq_R)
Theorem mtopology_thm : forall A:set, A <> Empty -> forall m :e metric A, mtopology A m = {u :e Power A | u c= mspace A m /\ forall x :e A, x :e u -> exists r :e R, 0 < r /\ mball A m (x,r) c= u}.
Admitted.

// HOL Light: Multivariate/metric.ml:11811 / IS_TOPOLOGY_METRIC_TOPOLOGY
// Source hash: md5:d77b08411b57341d4ae60d3ad41baac1
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, omega_Subq_R)
Theorem IS_TOPOLOGY_METRIC_TOPOLOGY : forall A:set, A <> Empty -> forall m :e metric A, istopology A {u :e Power A | u c= mspace A m /\ forall x :e A, x :e u -> exists r :e R, 0 < r /\ mball A m (x,r) c= u}.
Admitted.

// HOL Light: Multivariate/metric.ml:11828 / OPEN_IN_MTOPOLOGY
// Source hash: md5:85eae5666be2d70273d524b32a4ac872
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_topology, omega_Subq_R)
Theorem OPEN_IN_MTOPOLOGY : forall A:set, A <> Empty -> forall m :e metric A, forall u c= A, u :e mtopology A m <-> u c= mspace A m /\ forall x :e A, x :e u -> exists r :e R, 0 < r /\ mball A m (x,r) c= u.
Admitted.

// HOL Light: Multivariate/metric.ml:11841 / TOPSPACE_MTOPOLOGY
// Source hash: md5:e05e14837f7df4370be2f6886f567f38
// Status: transport_required (bridges: hol_typedef_metric, hol_typedef_topology)
Theorem TOPSPACE_MTOPOLOGY : forall A:set, A <> Empty -> forall m :e metric A, topspace A (mtopology A m) = mspace A m.
Admitted.

// HOL Light: Multivariate/metric.ml:11855 / SUBTOPOLOGY_MSPACE
// Source hash: md5:3131a12fecff7d9eeb043e029c7b9231
// Status: transport_required (bridges: hol_typedef_metric, hol_typedef_topology)
Theorem SUBTOPOLOGY_MSPACE : forall A:set, A <> Empty -> forall m :e metric A, subtopology A (mtopology A m) (mspace A m) = mtopology A m.
Admitted.

// HOL Light: Multivariate/metric.ml:11859 / OPEN_IN_MSPACE
// Source hash: md5:e21788026eec9f5b21caf6fcc1e8f4c1
// Status: transport_required (bridges: hol_typedef_metric, hol_typedef_topology)
Theorem OPEN_IN_MSPACE : forall A:set, A <> Empty -> forall m :e metric A, mspace A m :e mtopology A m.
Admitted.

// HOL Light: Multivariate/metric.ml:11863 / CLOSED_IN_MSPACE
// Source hash: md5:c9bc862ace32f691cd67bd46ddd5f3e4
// Status: transport_required (bridges: hol_typedef_metric, hol_typedef_topology)
Theorem CLOSED_IN_MSPACE : forall A:set, A <> Empty -> forall m :e metric A, closed_in A (mtopology A m) (mspace A m).
Admitted.

// HOL Light: Multivariate/metric.ml:11867 / OPEN_IN_MBALL
// Source hash: md5:8c7b67e90d69e1c7d9e3f3fa64a2f6a7
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_topology)
Theorem OPEN_IN_MBALL : forall A:set, forall m :e metric A, forall x :e A, forall r :e R, mball A m (x,r) :e mtopology A m.
Admitted.

// HOL Light: Multivariate/metric.ml:11879 / MTOPOLOGY_SUBMETRIC
// Source hash: md5:50be9b73ad2c271e715bb4bc426a68e2
// Status: transport_required (bridges: hol_typedef_metric, hol_typedef_topology)
Theorem MTOPOLOGY_SUBMETRIC : forall A:set, A <> Empty -> forall m :e metric A, forall s c= A, mtopology A (submetric A m s) = subtopology A (mtopology A m) s.
Admitted.

// HOL Light: Multivariate/metric.ml:11913 / METRIC_INJECTIVE_IMAGE
// Source hash: md5:f58c6b6b2e3ee7db74a14a96944b7499
// Status: generalization_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem METRIC_INJECTIVE_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall m :e metric B, forall s c= A, {f x | x :e s} c= mspace B m /\ (forall x y :e A, x :e s /\ (y :e s /\ f x = f y) -> x = y) -> mspace A (s,fun p :e A :*: A => mdist B m (f (p 0),f (p 1))) = s /\ forall x :e A :*: A, mdist A (s,fun p :e A :*: A => mdist B m (f (p 0),f (p 1))) x = mdist B m (f (x 0),f (x 1)).
Admitted.

// HOL Light: Multivariate/metric.ml:11928 / MTOPOLOGY_BASE
// Source hash: md5:9cda32abd3231a0a41647cc82ed0ffc0
// Status: generalization_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_topology, omega_Subq_R)
Theorem MTOPOLOGY_BASE : forall A:set, A <> Empty -> forall m :e metric A, mtopology A m = {x :e Power A | exists u c= Power A, True /\ (forall x0 :e u, x0 :e \/_ x01 :e A, {mball A m (x01,r) | r :e R, x01 :e mspace A m /\ 0 < r}) /\ Union u = x}.
Admitted.

// HOL Light: Multivariate/metric.ml:11942 / CLOSED_IN_METRIC
// Source hash: md5:6155b4d4a6c11ce9c8a8fd896a00cb78
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_topology, omega_Subq_R)
Theorem CLOSED_IN_METRIC : forall A:set, A <> Empty -> forall m :e metric A, forall c c= A, closed_in A (mtopology A m) c <-> c c= mspace A m /\ forall x :e A, x :e mspace A m :\: c -> exists r :e R, 0 < r /\ c :/\: mball A m (x,r) = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:11950 / mcball
// Source hash: md5:4db8ea14bc76cd451091b22b30bd0161
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem mcball_thm : forall A:set, forall m :e metric A, forall x :e A, forall r :e R, mcball A m (x,r) = {y :e A | x :e mspace A m /\ (y :e mspace A m /\ mdist A m (x,y) <= r)}.
Admitted.

// HOL Light: Multivariate/metric.ml:11954 / IN_MCBALL
// Source hash: md5:34d321780b173025f97bcb0f0f13afe2
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem IN_MCBALL : forall A:set, forall m :e metric A, forall x :e A, forall r :e R, forall y :e A, y :e mcball A m (x,r) <-> x :e mspace A m /\ (y :e mspace A m /\ mdist A m (x,y) <= r).
Admitted.

// HOL Light: Multivariate/metric.ml:11960 / CENTRE_IN_MCBALL
// Source hash: md5:797ab0e71f25e378c9ed79a645ffd9aa
// Status: generalization_required (bridges: empty_case:A, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, omega_Subq_R)
Theorem CENTRE_IN_MCBALL : forall A:set, forall m :e metric A, forall x :e A, forall r :e R, 0 <= r /\ x :e mspace A m -> x :e mcball A m (x,r).
Admitted.

