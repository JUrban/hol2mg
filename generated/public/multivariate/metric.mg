Theorem MDIST_CFUNSPACE_LE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall m :e metric B, forall B0 :e R, forall f g :e B :^: A, 0 <= B0 /\ (forall x :e A, x :e topspace A top -> mdist B m (f x,g x) <= B0) -> mdist (B :^: A) (cfunspace A B top m) (f,g) <= B0.
