// Status: transport_required (bridges: hol_typedef_topology)
Theorem CLOSURE_OF_SUBSET_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, closure_of A (subtopology A top s) t c= s.
