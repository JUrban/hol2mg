Theorem UNIFORMLY_CONTINUOUS_MAP_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall m1 :e metric B, forall m2 :e metric A, forall f:set -> set, (forall x :e B, f x :e A) -> forall g:set -> set, (forall x :e B, g x :e A) -> (forall x :e B, x :e mspace B m1 -> f x = g x) /\ uniformly_continuous_map A B (m1,m2) f -> uniformly_continuous_map A B (m1,m2) g.
Admitted.

