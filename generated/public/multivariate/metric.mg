// Source hash: md5:9ec69a04ecc8a75dd9e0d83310a09397
// Status: generalization_required (bridges: empty_case:A, hol_finite_finite, hol_prod_setprod, hol_typedef_topology)
Theorem LOCALLY_FINITE_PRODUCT_TUBES : forall A B:set, B <> Empty -> forall top :e topology A, forall top' :e topology B, forall W c= Power A, forall U c= Power (A :*: B), forall Ux :e Power (Power (A :*: B)) :^: A, forall xw:set -> set, (forall x :e Power A, xw x :e A) -> locally_finite_in A top W /\ ((forall w c= A, w :e W -> finite (Ux (xw w))) /\ ((forall w c= A, w :e W -> Ux (xw w) c= U) /\ (forall u c= A :*: B, u :e U -> u :e prod_topology A B top top'))) -> locally_finite_in (A :*: B) (prod_topology A B top top') (\/_ w :e Power A, {(w :*: topspace B top') :/\: u | u :e Power (A :*: B), w :e W /\ u :e Ux (xw w)}).
Admitted.

// HOL Light: Multivariate/metric.ml:43262 / COMPACT_TUBE_COVER
// Source hash: md5:e8f175778959f0aaf588b80885ce1725
// Status: generalization_required (bridges: empty_case:A, hol_finite_finite, hol_prod_setprod, hol_typedef_topology)
Theorem COMPACT_TUBE_COVER : forall A B:set, B <> Empty -> forall top :e topology A, forall top' :e topology B, forall x :e A, forall U c= Power (A :*: B), compact_space B top' /\ (x :e topspace A top /\ ((forall u c= A :*: B, u :e U -> u :e prod_topology A B top top') /\ {x} :*: topspace B top' c= Union U)) -> exists v c= A, exists Ux c= Power (A :*: B), v :e top /\ (x :e v /\ (finite Ux /\ (Ux c= U /\ v :*: topspace B top' c= Union Ux))).
Admitted.

// HOL Light: Multivariate/metric.ml:43306 / PARACOMPACT_SPACE_PRODUCT_COMPACT_LEFT
// Source hash: md5:b360518f72210aeea653ad60eb4413fb
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem PARACOMPACT_SPACE_PRODUCT_COMPACT_LEFT : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, paracompact_space A top /\ compact_space B top' -> paracompact_space (A :*: B) (prod_topology A B top top').
Admitted.

// HOL Light: Multivariate/metric.ml:43447 / PARACOMPACT_SPACE_PRODUCT_COMPACT_RIGHT
