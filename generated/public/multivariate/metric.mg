// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem PROPER_IMP_CONTINUOUS_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> kc_space A top /\ (compact_space B top' /\ proper_map A B (top,top') f) -> continuous_map A B (top,top') f.
Admitted.

// HOL Light: Multivariate/metric.ml:9365 / PROPER_MAP_FST
