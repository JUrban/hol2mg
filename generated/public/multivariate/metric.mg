Admitted.

// HOL Light: Multivariate/metric.ml:12184 / mbounded
// Source hash: md5:2dee59ebf7c2a981cb32710444931747
// Status: transport_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem mbounded_thm : forall A:set, A <> Empty -> forall s c= A, forall m :e metric A, mbounded A m s <-> exists c :e A, exists b :e R, s c= mcball A m (c,b).
Admitted.

// HOL Light: Multivariate/metric.ml:12187 / MBOUNDED_POS
// Source hash: md5:83eaec229fbbf10b3970542db919b2f5
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, omega_Subq_R)
Theorem MBOUNDED_POS : forall A:set, A <> Empty -> forall m :e metric A, forall s c= A, mbounded A m s <-> exists c :e A, exists b :e R, 0 < b /\ s c= mcball A m (c,b).
Admitted.

// HOL Light: Multivariate/metric.ml:12198 / MBOUNDED_ALT
// Source hash: md5:e7242f4430641febded06ba24adc9e61
// Status: transport_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem MBOUNDED_ALT : forall A:set, A <> Empty -> forall m :e metric A, forall s c= A, mbounded A m s <-> s c= mspace A m /\ exists b :e R, forall x y :e A, x :e s /\ y :e s -> mdist A m (x,y) <= b.
Admitted.

// HOL Light: Multivariate/metric.ml:12219 / MBOUNDED_ALT_POS
// Source hash: md5:28c28ebc1f8bdfc43808e163fe734ca6
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, omega_Subq_R)
Theorem MBOUNDED_ALT_POS : forall A:set, A <> Empty -> forall m :e metric A, forall s c= A, mbounded A m s <-> s c= mspace A m /\ exists B :e R, 0 < B /\ forall x y :e A, x :e s /\ y :e s -> mdist A m (x,y) <= B.
Admitted.

// HOL Light: Multivariate/metric.ml:12230 / MBOUNDED_SUBSET
// Source hash: md5:323ac72754ba0a36a85c10c9acde8276
// Status: transport_required (bridges: hol_typedef_metric)
Theorem MBOUNDED_SUBSET : forall A:set, A <> Empty -> forall m :e metric A, forall s t c= A, mbounded A m t /\ s c= t -> mbounded A m s.
Admitted.

// HOL Light: Multivariate/metric.ml:12234 / MBOUNDED_SUBSET_MSPACE
// Source hash: md5:b686b74270ef4b7cad098b1741348e8a
// Status: generalization_required (bridges: empty_case:A, hol_typedef_metric)
Theorem MBOUNDED_SUBSET_MSPACE : forall A:set, forall m :e metric A, forall s c= A, mbounded A m s -> s c= mspace A m.
Admitted.

// HOL Light: Multivariate/metric.ml:12240 / MBOUNDED
// Source hash: md5:328e3f09a722ec14e5a5e2cb0fd21c72
// Status: transport_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem MBOUNDED : forall A:set, A <> Empty -> forall m :e metric A, forall s c= A, mbounded A m s <-> s = Empty \/ (forall x :e A, x :e s -> x :e mspace A m) /\ exists c :e A, exists b :e R, c :e mspace A m /\ forall x :e A, x :e s -> mdist A m (c,x) <= b.
Admitted.

