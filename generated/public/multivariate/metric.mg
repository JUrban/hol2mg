// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem T0_SPACE_RETRACTION_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall r:set -> set, (forall x :e A, r x :e B) -> retraction_map A B (top,top') r /\ t0_space A top -> t0_space B top'.
Admitted.

// HOL Light: Multivariate/metric.ml:15755 / T0_SPACE_PROD_TOPOLOGY
// Source hash: md5:3928e92d8eab67a96a6fdf383544a87a
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem T0_SPACE_PROD_TOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, t0_space (A :*: B) (prod_topology A B top1 top2) <-> topspace (A :*: B) (prod_topology A B top1 top2) = Empty \/ t0_space A top1 /\ t0_space B top2.
Admitted.

// HOL Light: Multivariate/metric.ml:15770 / T0_SPACE_PRODUCT_TOPOLOGY
// Source hash: md5:16cc95f8c3a9db88a8d32dc5662dcf43
// Status: transport_required (bridges: hol_typedef_topology)
Theorem T0_SPACE_PRODUCT_TOPOLOGY : forall A K:set, A <> Empty -> K <> Empty -> forall tops:set -> set, (forall x :e K, tops x :e topology A) -> forall k c= K, t0_space (A :^: K) (product_topology A K k tops) <-> topspace (A :^: K) (product_topology A K k tops) = Empty \/ forall i :e K, i :e k -> t0_space A (tops i).
Admitted.

// HOL Light: Multivariate/metric.ml:15802 / kolmogorov_quotient
