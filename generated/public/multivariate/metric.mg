Theorem PRODUCT_TOPOLOGY_EQ : forall A K:set, A <> Empty -> K <> Empty -> forall k c= K, forall top:set -> set, (forall x :e K, top x :e topology A) -> forall top':set -> set, (forall x :e K, top' x :e topology A) -> (product_topology A K k top = product_topology A K k top' <-> topspace (A :^: K) (product_topology A K k top) = Empty /\ topspace (A :^: K) (product_topology A K k top') = Empty \/ forall i :e K, i :e k -> top i = top' i).
