// Status: transport_required (bridges: hol_typedef_topology)
Theorem CUT_WIRE_FENCE_THEOREM : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, compact_space A top /\ (hausdorff_space A top /\ (closed_in A top s /\ (closed_in A top t /\ (forall c c= A, connected_in A top c -> c :/\: s = Empty \/ c :/\: t = Empty)))) -> separated_between A top s t.
Admitted.

