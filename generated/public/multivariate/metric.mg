// Status: transport_required (bridges: hol_has_size_equip, hol_num_omega, hol_typedef_topology)
Theorem SEPARATION_BY_CLOSED_INTERMEDIATES_EQ_COUNT : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, forall n :e omega, locally_connected_space A top /\ hereditarily A {x :e topology A | normal_space A x} top -> ((exists u c= Power A, equip u n /\ ((forall x y :e u, x <> y -> separated_in A top x y) /\ ((forall t c= A, t :e u -> ~ t = Empty) /\ Union u = topspace A top :\: s))) <-> exists c c= A, closed_in A top c /\ (c c= s /\ forall d c= A, closed_in A top d /\ (c c= d /\ d c= s) -> exists u c= Power A, equip u n /\ ((forall x y :e u, x <> y -> separated_in A top x y) /\ ((forall t c= A, t :e u -> ~ t = Empty) /\ Union u = topspace A top :\: d)))).
Admitted.

