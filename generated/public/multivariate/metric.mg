// Source hash: md5:3eac9f3411b0757f7a495575ace402ec
// Status: transport_required (bridges: hol_typedef_metric, hol_typedef_topology)
Theorem FORALL_METRIC_TOPOLOGY : forall A:set, A <> Empty -> forall P:set -> set -> prop, (forall m :e metric A, P (mtopology A m) (mspace A m)) <-> forall top :e topology A, metrizable_space A top -> P top (topspace A top).
Admitted.

