// Source hash: md5:42f4c2321a69ea550dfa3ad6d3e65f4e
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CLOSED_IMP_GDELTA_IN : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, metrizable_space A top /\ closed_in A top s -> s :e gdelta_in A top.
Admitted.

