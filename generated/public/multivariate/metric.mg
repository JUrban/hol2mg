// Status: transport_required (bridges: hol_typedef_topology)
Theorem CUT_WIRE_FENCE_THEOREM_GEN : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, compact_space A top /\ ((hausdorff_space A top \/ (regular_space A top \/ normal_space A top)) /\ (compact_in A top s /\ (closed_in A top t /\ (forall c c= A, connected_in A top c -> c :/\: s = Empty \/ c :/\: t = Empty)))) -> separated_between A top s t.
Admitted.

// HOL Light: Multivariate/metric.ml:27066 / CUT_WIRE_FENCE_THEOREM
