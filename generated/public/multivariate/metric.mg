Theorem PATH_IMAGE_SUBSET_TOPSPACE : forall A:set, A <> Empty -> forall top :e topology A, forall g:set -> set, (forall x :e R, g x :e A) -> path_in A top g -> {g x | x :e closed_real_interval (seq_cons (0,1) seq_nil)} c= topspace A top.
