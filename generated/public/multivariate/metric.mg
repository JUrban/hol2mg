Theorem KC_SPACE_PROPER_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> kc_space A top /\ (proper_map A B (top,top') f /\ {f x | x :e topspace A top} = topspace B top') -> kc_space B top'.
