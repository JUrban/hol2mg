Theorem ISOMETRY_IMP_HOMEOMORPHIC_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall m :e metric A, forall m' :e metric B, forall f:set -> set, (forall x :e A, f x :e B) -> {f x | x :e mspace A m} = mspace B m' /\ (forall x y :e A, x :e mspace A m /\ y :e mspace A m -> mdist B m' (f x,f y) = mdist A m (x,y)) -> homeomorphic_map A B (mtopology A m,mtopology B m') f.
Admitted.

// HOL Light: Multivariate/metric.ml:31835 / CONTINUOUS_MAP_ON_INTERMEDIATE_CLOSURE_OF
// Source hash: md5:41f0727a9cc6b63f549f78e646f948e6
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_net, hol_typedef_topology)
Theorem CONTINUOUS_MAP_ON_INTERMEDIATE_CLOSURE_OF : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall s t c= A, regular_space B top' /\ (t c= closure_of A top s /\ (forall x :e A, x :e t -> limit A B top' f (f x) (within A (atpointof A top x) s))) -> continuous_map A B (subtopology A top t,top') f.
Admitted.

