Theorem METRIC_COVER_SIGMA_LOCALLY_FINITE : forall A:set, A <> Empty -> forall m :e metric A, forall U c= Power A, (forall u c= A, u :e U -> u :e mtopology A m) /\ Union U = mspace A m -> exists V c= Power A, (forall v c= A, v :e V -> v :e mtopology A m) /\ (Union V = mspace A m /\ ((forall v c= A, v :e V -> exists u c= A, u :e U /\ v c= u) /\ sigma_locally_finite_in A (mtopology A m) V)).
Admitted.

// HOL Light: Multivariate/metric.ml:41859 / SIGMA_LOCALLY_FINITE_IMP_LOCALLY_FINITE_COVERING
// Source hash: md5:fffca28a67aa157d47b63e4e5a196bef
// Status: transport_required (bridges: hol_typedef_topology)
Theorem SIGMA_LOCALLY_FINITE_IMP_LOCALLY_FINITE_COVERING : forall A:set, A <> Empty -> forall top :e topology A, forall B c= Power A, (forall b c= A, b :e B -> b :e top) /\ (sigma_locally_finite_in A top B /\ Union B = topspace A top) -> exists C c= Power A, Union C = Union B /\ (locally_finite_in A top C /\ forall c c= A, c :e C -> exists b c= A, b :e B /\ c c= b).
Admitted.

