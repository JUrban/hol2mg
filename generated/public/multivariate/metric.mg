Theorem PATH_CONNECTED_IN_CONTINUOUS_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall top :e topology A, forall top' :e topology B, forall s c= A, continuous_map A B (top,top') f /\ path_connected_in A top s -> path_connected_in B top' {f x | x :e s}.
