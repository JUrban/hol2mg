// Source hash: md5:98eb31c45163c518e46a7afa13435ca1
// Status: transport_required (bridges: hol_typedef_topology)
Theorem INTERIOR_OF_LOCALLY_CONNECTED_SUBSPACE_COMPONENT : forall A:set, A <> Empty -> forall top :e topology A, forall s c c= A, locally_connected_space A top /\ c :e connected_components_of A (subtopology A top s) -> interior_of A top c = c :/\: interior_of A top s.
Admitted.

