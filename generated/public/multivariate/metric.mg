Admitted.

// HOL Light: Multivariate/metric.ml:21533 / CONTINUOUS_MAP_UNIFORM_LIMIT
// Source hash: md5:38529dfabc3a9fd97dec8f08b1096cf5
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_net, hol_typedef_topology, omega_Subq_R)
Theorem CONTINUOUS_MAP_UNIFORM_LIMIT : forall A B K:set, A <> Empty -> B <> Empty -> K <> Empty -> forall net0 :e net K, forall top :e topology A, forall m :e metric B, forall f:set -> set -> set, (forall x :e K, forall y :e A, f x y :e B) -> forall g:set -> set, (forall x :e A, g x :e B) -> ~ trivial_limit K net0 /\ (eventually K {n :e K | continuous_map A B (top,mtopology B m) (f n)} net0 /\ (forall e0 :e R, 0 < e0 -> eventually K {n :e K | forall x :e A, x :e topspace A top -> g x :e mspace B m /\ mdist B m (f n x,g x) < e0} net0)) -> continuous_map A B (top,mtopology B m) g.
Admitted.

// HOL Light: Multivariate/metric.ml:21563 / CONTINUOUS_MAP_UNIFORM_LIMIT_ALT
