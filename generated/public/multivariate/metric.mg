// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem QUASI_COMPONENT_OF_TRANS : forall A:set, forall top :e topology A, forall x y z :e A, quasi_component_of A top x y /\ quasi_component_of A top y z -> quasi_component_of A top x z.
Admitted.

