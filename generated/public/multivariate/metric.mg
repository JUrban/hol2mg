// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem PARACOMPACT_SPACE_PRODUCT_COMPACT_RIGHT : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, compact_space A top /\ paracompact_space B top' -> paracompact_space (A :*: B) (prod_topology A B top top').
Admitted.

// HOL Light: Multivariate/metric.ml:43462 / PARACOMPACT_HAUSDORFF_CLOSURE_REFINEMENT
// Source hash: md5:53916936765e0e9367e2d0be3327d722
// Status: transport_required (bridges: hol_typedef_topology)
Theorem PARACOMPACT_HAUSDORFF_CLOSURE_REFINEMENT : forall A:set, A <> Empty -> forall top :e topology A, forall U c= Power A, paracompact_space A top /\ (hausdorff_space A top /\ ((forall u c= A, u :e U -> u :e top) /\ Union U = topspace A top)) -> exists V c= Power A, exists r :e Power A :^: Power A, (forall v c= A, v :e V -> v :e top) /\ (Union V = topspace A top /\ (locally_finite_in A top V /\ forall v c= A, v :e V -> r v :e U /\ closure_of A top v c= r v)).
Admitted.

// HOL Light: Multivariate/metric.ml:43542 / PARACOMPACT_HAUSDORFF_INDEXED_SHRINKING
// Source hash: md5:c2e8bed2cd95f33669b276be188972a9
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem PARACOMPACT_HAUSDORFF_INDEXED_SHRINKING : forall A:set, A <> Empty -> forall top :e topology A, forall U c= Power A, paracompact_space A top /\ (hausdorff_space A top /\ ((forall u c= A, u :e U -> u :e top) /\ Union U = topspace A top)) -> exists v :e Power A :^: Power A, (forall u c= A, u :e U -> v u :e top /\ closure_of A top (v u) c= u) /\ (Union {v x | x :e U} = topspace A top /\ forall x :e A, x :e topspace A top -> exists N c= A, N :e top /\ (x :e N /\ finite {u :e Power A | u :e U /\ ~ v u :/\: N = Empty})).
Admitted.

// HOL Light: Multivariate/metric.ml:43627 / CONTINUOUS_MAP_SUM_LOCALLY_FINITE
// Source hash: md5:02382431a1cdf41cdc78e9888e2ba44d
// Status: transport_required (bridges: hol_finite_finite, hol_num_omega, hol_prod_setprod, hol_real_R, hol_sum_finsum, hol_typedef_topology, omega_Subq_R)
Theorem CONTINUOUS_MAP_SUM_LOCALLY_FINITE : forall A K:set, A <> Empty -> K <> Empty -> forall top :e topology A, forall f:set -> set -> set, (forall x :e K, forall y :e A, f x y :e R) -> forall v :e Power A :^: K, forall U c= K, (forall u :e K, u :e U -> continuous_map A R (top,euclideanreal) (f u)) /\ ((forall u :e K, u :e U -> forall x :e A, x :e topspace A top /\ ~ x :e v u -> f u x = 0) /\ (forall x :e A, x :e topspace A top -> exists N c= A, N :e top /\ (x :e N /\ finite {u :e K | u :e U /\ ~ v u :/\: N = Empty}))) -> continuous_map A R (top,euclideanreal) (fun x:set => finsum U (fun u:set => f u x)).
Admitted.

// HOL Light: Multivariate/metric.ml:43696 / PARACOMPACT_PARTITION_OF_UNITY
// Source hash: md5:1d22a4a20ad2ace3e5b1e215cc38ddb3
// Status: transport_required (bridges: hol_finite_finite, hol_num_omega, hol_prod_setprod, hol_real_R, hol_sum_finsum, hol_typedef_topology, omega_Subq_R)
Theorem PARACOMPACT_PARTITION_OF_UNITY : forall A:set, A <> Empty -> forall top :e topology A, forall U c= Power A, paracompact_space A top /\ (hausdorff_space A top /\ ((forall u c= A, u :e U -> u :e top) /\ Union U = topspace A top)) -> exists phi:set -> set -> set, (forall x :e Power A, forall y :e A, phi x y :e R) /\ ((forall u c= A, u :e U -> continuous_map A R (top,euclideanreal) (phi u) /\ ((forall x :e A, x :e topspace A top -> 0 <= phi u x) /\ {x :e A | x :e topspace A top /\ ~ phi u x = 0} c= u)) /\ ((forall x :e A, x :e topspace A top -> exists N c= A, N :e top /\ (x :e N /\ finite {u :e Power A | u :e U /\ ~ N :/\: {y :e A | y :e topspace A top /\ ~ phi u y = 0} = Empty})) /\ forall x :e A, x :e topspace A top -> finsum U (fun u:set => phi u x) = 1)).
Admitted.

