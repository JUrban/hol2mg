// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem INTERIOR_OF_CROSS : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, forall s c= A, forall t c= B, interior_of (A :*: B) (prod_topology A B top1 top2) (s :*: t) = interior_of A top1 s :*: interior_of B top2 t.
Admitted.

