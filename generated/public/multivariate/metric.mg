// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HOMEOMORPHIC_MAP_GDELTANESS : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall top :e topology A, forall top' :e topology B, forall u c= A, homeomorphic_map A B (top,top') f /\ u c= topspace A top -> ({f x | x :e u} :e gdelta_in B top' <-> u :e gdelta_in A top).
