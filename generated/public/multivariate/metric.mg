// Source hash: md5:6af2af2c6ad221c1be54d43fc482ea60
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem KC_SPACE_ONE_POINT_COMPACTIFICATION_GEN : forall A:set, forall top :e topology A, forall a :e A, compact_space A top -> (kc_space A top <-> topspace A top :\: {a} :e top /\ ((forall k c= A, compact_in A top k /\ ~ a :e k -> closed_in A top k) /\ (k_space A (subtopology A top (topspace A top :\: {a})) /\ kc_space A (subtopology A top (topspace A top :\: {a}))))).
Admitted.

// HOL Light: Multivariate/metric.ml:28287 / alexandroff_compactification
// Source hash: md5:4c52e6d4733d7881fc666ca683583cfc
// Status: generalization_required (bridges: hol_one_1, hol_sum_setsum, hol_typedef_topology)
Theorem alexandroff_compactification_thm : forall A:set, A <> Empty -> forall top :e topology A, alexandroff_compactification A top = {{Inj0 x | x :e u} | u :e Power A, u :e top} :\/: {SetAdjoin {Inj0 x | x :e topspace A top :\: c} (Inj1 0) | c :e Power A, compact_in A top c /\ closed_in A top c}.
Admitted.

// HOL Light: Multivariate/metric.ml:28293 / OPEN_IN_ALEXANDROFF_COMPACTIFICATION
// Source hash: md5:f815c69a7fb798dab5cf6cd86bce5f16
// Status: transport_required (bridges: hol_one_1, hol_sum_setsum, hol_typedef_topology)
Theorem OPEN_IN_ALEXANDROFF_COMPACTIFICATION : forall A:set, A <> Empty -> forall top :e topology A, forall v c= A :+: 1, v :e alexandroff_compactification A top <-> (exists u c= A, u :e top /\ v = {Inj0 x | x :e u}) \/ exists c c= A, compact_in A top c /\ (closed_in A top c /\ v = SetAdjoin {Inj0 x | x :e topspace A top :\: c} (Inj1 0)).
Admitted.

// HOL Light: Multivariate/metric.ml:28393 / TOPSPACE_ALEXANDROFF_COMPACTIFICATION
// Source hash: md5:6a118e759dc60d098913c43730a1e797
// Status: transport_required (bridges: hol_one_1, hol_sum_setsum, hol_typedef_topology)
Theorem TOPSPACE_ALEXANDROFF_COMPACTIFICATION : forall A:set, A <> Empty -> forall top :e topology A, topspace (A :+: 1) (alexandroff_compactification A top) = SetAdjoin {Inj0 x | x :e topspace A top} (Inj1 0).
Admitted.

// HOL Light: Multivariate/metric.ml:28405 / CLOSED_IN_ALEXANDROFF_COMPACTIFICATION
// Source hash: md5:1c179c5a5da95887643d1c32e5f5436d
// Status: transport_required (bridges: hol_one_1, hol_sum_setsum, hol_typedef_topology)
Theorem CLOSED_IN_ALEXANDROFF_COMPACTIFICATION : forall A:set, A <> Empty -> forall top :e topology A, forall c c= A :+: 1, closed_in (A :+: 1) (alexandroff_compactification A top) c <-> (exists k c= A, compact_in A top k /\ (closed_in A top k /\ c = {Inj0 x | x :e k})) \/ exists u c= A, u :e top /\ c = topspace (A :+: 1) (alexandroff_compactification A top) :\: {Inj0 x | x :e u}.
Admitted.

