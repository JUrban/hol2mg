// Source hash: md5:46a93184a77defc5069454eb02eba7eb
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_topology, omega_Subq_R)
Theorem METRIC_CONTINUOUS_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall m :e metric A, forall m' :e metric B, forall f:set -> set, (forall x :e A, f x :e B) -> (continuous_map A B (mtopology A m,mtopology B m') f <-> (forall x :e A, x :e mspace A m -> f x :e mspace B m') /\ forall a :e A, forall e0 :e R, 0 < e0 /\ a :e mspace A m -> exists d :e R, 0 < d /\ forall x :e A, x :e mspace A m /\ mdist A m (a,x) < d -> mdist B m' (f a,f x) < e0).
Admitted.

