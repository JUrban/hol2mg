// Source hash: md5:a0e742fa2a3672535b89b5ab6f3dd559
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem locally_finite_in_thm : forall A:set, A <> Empty -> forall top :e topology A, forall U c= Power A, locally_finite_in A top U <-> (forall u c= A, u :e U -> u c= topspace A top) /\ forall x :e A, x :e topspace A top -> exists v c= A, v :e top /\ (x :e v /\ finite {u :e Power A | u :e U /\ ~ u :/\: v = Empty}).
Admitted.

