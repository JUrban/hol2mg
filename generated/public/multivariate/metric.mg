// Status: transport_required (bridges: hol_typedef_topology)
Theorem COMPLEMENT_PATH_COMPONENTS_OF_UNIONS : forall A:set, A <> Empty -> forall top :e topology A, forall c c= A, c :e path_components_of A top -> topspace A top :\: c = Union (path_components_of A top :\: {c}).
Admitted.

