Theorem K_SPACE_QUOTIENT_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall q:set -> set, (forall x :e A, q x :e B) -> quotient_map A B (top,top') q /\ k_space A top -> k_space B top'.
