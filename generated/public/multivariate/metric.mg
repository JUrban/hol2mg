Theorem PEANO_GAP_FILLING_EXTENSION : forall A:set, A <> Empty -> forall top :e topology A, forall f:set -> set, (forall x :e R, f x :e A) -> forall C c= R, compact_space A top /\ (metrizable_space A top /\ (connected_space A top /\ (locally_connected_space A top /\ (~ topspace A top = Empty /\ (C c= closed_real_interval (seq_cons (0,1) seq_nil) /\ (closed_in R (subtopology R euclideanreal (closed_real_interval (seq_cons (0,1) seq_nil))) C /\ (continuous_map R A (subtopology R euclideanreal C,top) f /\ {f x | x :e C} = topspace A top))))))) -> exists F:set -> set, (forall x :e R, F x :e A) /\ (continuous_map R A (subtopology R euclideanreal (closed_real_interval (seq_cons (0,1) seq_nil)),top) F /\ {F x | x :e closed_real_interval (seq_cons (0,1) seq_nil)} = topspace A top).
