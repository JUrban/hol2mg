// Source hash: md5:089a99bc1975368da2dec0a199a09fb1
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HOMOTOPY_DOMINATED_CONTRACTIBILITY : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e B, g x :e A) -> forall top :e topology A, forall top' :e topology B, continuous_map A B (top,top') f /\ (continuous_map B A (top',top) g /\ (homotopic_with B B {x :e B :^: B | True} (top',top') (fun x:set => f (g x)) (fun x:set => x) /\ contractible_space A top)) -> contractible_space B top'.
