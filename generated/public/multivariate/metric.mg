Theorem PATH_CONNECTED_SPACE_IFF_PATH_COMPONENT : forall A:set, A <> Empty -> forall top :e topology A, path_connected_space A top <-> forall x y :e A, x :e topspace A top /\ y :e topspace A top -> path_component_of A top x y.
Admitted.

