// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem WEAKLY_LOCALLY_CONNECTED_AT : forall A:set, forall top :e topology A, forall x :e A, weakly_locally_connected_at A x top <-> forall v c= A, v :e top /\ x :e v -> exists u c= A, u :e top /\ (x :e u /\ (u c= v /\ forall y :e A, y :e u -> exists c c= A, connected_in A top c /\ (c c= v /\ (x :e c /\ y :e c)))).
Admitted.

