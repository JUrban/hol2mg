// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_MAP_FROM_K_SPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> k_space A top /\ (forall k c= A, compact_in A top k -> continuous_map A B (subtopology A top k,top') f) -> continuous_map A B (top,top') f.
Admitted.

// HOL Light: Multivariate/metric.ml:27805 / CLOSED_MAP_INTO_K_SPACE
// Source hash: md5:15181e619f6f624a18074d0c67fe2312
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CLOSED_MAP_INTO_K_SPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> k_space B top' /\ ({f x | x :e topspace A top} c= topspace B top' /\ (forall k c= B, compact_in B top' k -> closed_map A B (subtopology A top {x :e A | x :e topspace A top /\ f x :e k},subtopology B top' k) f)) -> closed_map A B (top,top') f.
Admitted.

