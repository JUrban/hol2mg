// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_net, hol_typedef_topology, nat_le_SNoLe, omega_Subq_R)
Theorem CONTINUOUS_MAP_UNIFORMLY_CAUCHY_LIMIT : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall ms :e metric B, forall f:set -> set -> set, (forall x :e omega, forall y :e A, f x y :e B) -> ~ trivial_limit omega sequentially /\ (mcomplete B ms /\ (eventually omega {n :e omega | continuous_map A B (top,mtopology B ms) (f n)} sequentially /\ (forall e0 :e R, 0 < e0 -> exists N :e omega, forall m n :e omega, forall x :e A, N <= m /\ (N <= n /\ x :e topspace A top) -> mdist B ms (f m x,f n x) < e0))) -> exists g:set -> set, (forall x :e A, g x :e B) /\ (continuous_map A B (top,mtopology B ms) g /\ forall e0 :e R, 0 < e0 -> eventually omega {n :e omega | forall x :e A, x :e topspace A top -> mdist B ms (f n x,g x) < e0} sequentially).
Admitted.

