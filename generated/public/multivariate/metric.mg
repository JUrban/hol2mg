// HOL Light: Multivariate/metric.ml:2736 / CONTINUOUS_MAP_CASES
// Source hash: md5:6e4efb99bb48983328cb582d89c52389
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_MAP_CASES : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall P:set -> prop, forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e A, g x :e B) -> continuous_map A B (subtopology A top (closure_of A top {x :e A | P x}),top') f /\ (continuous_map A B (subtopology A top (closure_of A top {x :e A | ~ P x}),top') g /\ (forall x :e A, x :e frontier_of A top {x0 :e A | P x0} -> f x = g x)) -> continuous_map A B (top,top') (fun x:set => if P x then f x else g x).
Admitted.

// HOL Light: Multivariate/metric.ml:2763 / CONTINUOUS_MAP_CASES_ALT
// Source hash: md5:1a9df466c5df87ebecd95ca57fc08fb4
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_MAP_CASES_ALT : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall P:set -> prop, forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e A, g x :e B) -> continuous_map A B (subtopology A top (closure_of A top {x :e A | x :e topspace A top /\ P x}),top') f /\ (continuous_map A B (subtopology A top (closure_of A top {x :e A | x :e topspace A top /\ ~ P x}),top') g /\ (forall x :e A, x :e frontier_of A top {x0 :e A | x0 :e topspace A top /\ P x0} -> f x = g x)) -> continuous_map A B (top,top') (fun x:set => if P x then f x else g x).
Admitted.

// HOL Light: Multivariate/metric.ml:2775 / CONTINUOUS_MAP_CASES_FUNCTION
// Source hash: md5:91ad48db2dea1f569762d61fded20a94
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_MAP_CASES_FUNCTION : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e topology A, forall top' :e topology B, forall top'' :e topology C, forall p:set -> set, (forall x :e A, p x :e C) -> forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e A, g x :e B) -> forall u c= C, continuous_map A C (top,top'') p /\ (continuous_map A B (subtopology A top {x :e A | x :e topspace A top /\ p x :e closure_of C top'' u},top') f /\ (continuous_map A B (subtopology A top {x :e A | x :e topspace A top /\ p x :e closure_of C top'' (topspace C top'' :\: u)},top') g /\ (forall x :e A, x :e topspace A top /\ p x :e frontier_of C top'' u -> f x = g x))) -> continuous_map A B (top,top') (fun x:set => if p x :e u then f x else g x).
Admitted.

// HOL Light: Multivariate/metric.ml:2807 / CONTINUOUS_MAP_SEPARATED_UNION
// Source hash: md5:5ffdac24550a92657c268e5e783be7e4
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_MAP_SEPARATED_UNION : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall s t c= A, continuous_map A B (subtopology A top s,top') f /\ (continuous_map A B (subtopology A top t,top') f /\ (s :/\: closure_of A top t = Empty /\ t :/\: closure_of A top s = Empty)) -> continuous_map A B (subtopology A top (s :\/: t),top') f.
Admitted.

