Admitted.

// HOL Light: Multivariate/metric.ml:31893 / CONTINUOUS_MAP_EXTENSION_POINTWISE_ALT
// Source hash: md5:bf445b77172ef50e8cd31e1a9ab206f1
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_net, hol_typedef_topology)
Theorem CONTINUOUS_MAP_EXTENSION_POINTWISE_ALT : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall s t c= A, regular_space B top2 /\ (s c= t /\ (t c= closure_of A top1 s /\ (continuous_map A B (subtopology A top1 s,top2) f /\ (forall x :e A, x :e t :\: s -> exists l :e B, limit A B top2 f l (within A (atpointof A top1 x) s))))) -> exists g:set -> set, (forall x :e A, g x :e B) /\ (continuous_map A B (subtopology A top1 t,top2) g /\ forall x :e A, x :e s -> g x = f x).
Admitted.

// HOL Light: Multivariate/metric.ml:31916 / CONTINUOUS_MAP_EXTENSION_POINTWISE
// Source hash: md5:6b083853e27313191addff151fbf8e53
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_MAP_EXTENSION_POINTWISE : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall s t c= A, regular_space B top2 /\ (s c= t /\ (t c= closure_of A top1 s /\ (forall x :e A, x :e t -> exists g:set -> set, (forall x0 :e A, g x0 :e B) /\ (continuous_map A B (subtopology A top1 (SetAdjoin s x),top2) g /\ forall x0 :e A, x0 :e s -> g x0 = f x0)))) -> exists g:set -> set, (forall x :e A, g x :e B) /\ (continuous_map A B (subtopology A top1 t,top2) g /\ forall x :e A, x :e s -> g x = f x).
Admitted.

