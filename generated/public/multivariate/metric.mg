Theorem CONTINUOUS_MAP_PROD : forall A B C D:set, A <> Empty -> B <> Empty -> C <> Empty -> D <> Empty -> forall top1 :e topology A, forall top2 :e topology C, forall top3 :e topology B, forall top4 :e topology D, forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e C, g x :e D) -> (continuous_map (A :*: C) (B :*: D) (prod_topology A C top1 top2,prod_topology B D top3 top4) (fun p:set => (f (p 0),g (p 1))) <-> topspace (A :*: C) (prod_topology A C top1 top2) = Empty \/ continuous_map A B (top1,top3) f /\ continuous_map C D (top2,top4) g).
Admitted.

