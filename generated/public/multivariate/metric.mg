Theorem PATH_CONNECTED_SPACE_PATH_COMPONENT_SET : forall A:set, A <> Empty -> forall top :e topology A, path_connected_space A top <-> forall x :e A, x :e topspace A top -> forall x0 :e A, path_component_of A top x x0 <-> x0 :e topspace A top.
Admitted.

