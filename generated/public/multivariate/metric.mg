// Source hash: md5:e9185b5973612666d946a58ecf838725
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem FINITE_CONNECTED_COMPONENTS_OF_FINITE : forall A:set, A <> Empty -> forall top :e topology A, finite (topspace A top) -> finite (connected_components_of A top).
Admitted.

// HOL Light: Multivariate/metric.ml:14886 / CONNECTED_COMPONENT_OF_UNIQUE
// Source hash: md5:4bccc3477fb015ad012638d8ae75c209
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_COMPONENT_OF_UNIQUE : forall A:set, forall top :e topology A, forall c c= A, forall x :e A, x :e c /\ (connected_in A top c /\ (forall c' c= A, x :e c' /\ connected_in A top c' -> c' c= c)) -> forall x0 :e A, connected_component_of A top x x0 <-> x0 :e c.
Admitted.

// HOL Light: Multivariate/metric.ml:14895 / CLOSED_IN_CONNECTED_COMPONENT_OF_SUBTOPOLOGY
// Source hash: md5:2478b106f5398b31d42a26c46c93891e
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CLOSED_IN_CONNECTED_COMPONENT_OF_SUBTOPOLOGY : forall A:set, A <> Empty -> forall s c= A, forall top :e topology A, forall c c= A, c :e connected_components_of A (subtopology A top s) /\ closure_of A top c c= s -> closed_in A top c.
Admitted.

// HOL Light: Multivariate/metric.ml:14913 / CONNECTED_COMPONENT_OF_DISCRETE_TOPOLOGY
// Source hash: md5:d8c0deed8c621ad05a7d06c7d8781999
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CONNECTED_COMPONENT_OF_DISCRETE_TOPOLOGY : forall A:set, forall u c= A, forall x x0 :e A, connected_component_of A (discrete_topology A u) x x0 <-> (x :e u -> x0 :e SetAdjoin Empty x) /\ (~ x :e u -> x0 :e Empty).
Admitted.

// HOL Light: Multivariate/metric.ml:14923 / CONNECTED_COMPONENTS_OF_DISCRETE_TOPOLOGY
// Source hash: md5:7044b9b1397d07a4a7684752b076ae0d
// Status: transport_required (bridges: hol_typedef_topology)
Theorem CONNECTED_COMPONENTS_OF_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u c= A, connected_components_of A (discrete_topology A u) = {{x} | x :e A, x :e u}.
Admitted.

// HOL Light: Multivariate/metric.ml:14931 / CARD_LE_CONNNECTED_COMPONENTS_CONNECTED_IN
// Source hash: md5:4e17a392f04879ad35f2d6130ba1a9a4
// Status: transport_required (bridges: hol_le_c_atleastp, hol_typedef_topology)
Theorem CARD_LE_CONNNECTED_COMPONENTS_CONNECTED_IN : forall A:set, A <> Empty -> forall top :e topology A, forall u c= Power A, (forall c c= A, c :e u -> connected_in A top c) /\ Union u = topspace A top -> atleastp (connected_components_of A top) u.
Admitted.

// HOL Light: Multivariate/metric.ml:14955 / CARD_LE_CONNECTED_COMPONENTS_ALT
// Source hash: md5:56581cb62bb9831e801945fac95e150b
// Status: transport_required (bridges: hol_has_size_equip, hol_le_c_atleastp, hol_num_omega, hol_typedef_topology)
Theorem CARD_LE_CONNECTED_COMPONENTS_ALT : forall A:set, A <> Empty -> forall top :e topology A, forall n :e omega, atleastp (idx_n n) (connected_components_of A top) <-> n = 0 \/ exists u c= Power A, equip u n /\ ((forall x y :e u, x <> y -> separated_in A top x y) /\ ((forall t c= A, t :e u -> ~ t = Empty) /\ Union u = topspace A top)).
Admitted.

// HOL Light: Multivariate/metric.ml:15056 / CONNECTED_COMPONENT_OF_CONTINUOUS_IMAGE
// Source hash: md5:11ebaee644d0e96242ee4f373552681a
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_typedef_topology)
Theorem CONNECTED_COMPONENT_OF_CONTINUOUS_IMAGE : forall A B:set, B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall x y :e A, continuous_map A B (top,top') f /\ connected_component_of A top x y -> connected_component_of B top' (f x) (f y).
Admitted.

// HOL Light: Multivariate/metric.ml:15067 / HOMEOMORPHIC_MAP_CONNECTED_COMPONENT_OF
// Source hash: md5:eb62a7e0a3bba9d70c46b09e2bbee419
// Status: generalization_required (bridges: empty_case:A, empty_case:B, hol_prod_setprod, hol_typedef_topology)
Theorem HOMEOMORPHIC_MAP_CONNECTED_COMPONENT_OF : forall A B:set, forall f:set -> set, (forall x :e A, f x :e B) -> forall top :e topology A, forall top' :e topology B, forall x :e A, homeomorphic_map A B (top,top') f /\ x :e topspace A top -> forall x0 :e B, connected_component_of B top' (f x) x0 <-> x0 :e {f x0 | x0 :e {x1 :e A | connected_component_of A top x x1}}.
Admitted.

// HOL Light: Multivariate/metric.ml:15086 / HOMEOMORPHIC_MAP_CONNECTED_COMPONENTS_OF
// Source hash: md5:35ba95b6bd34dc4bae1c977f42dc5408
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HOMEOMORPHIC_MAP_CONNECTED_COMPONENTS_OF : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall top :e topology A, forall top' :e topology B, homeomorphic_map A B (top,top') f -> connected_components_of B top' = {{x0 :e B | x0 :e {f x0 | x0 :e x}} | x :e connected_components_of A top}.
Admitted.

// HOL Light: Multivariate/metric.ml:15097 / CONNECTED_COMPONENT_OF_PAIR
// Source hash: md5:08cb1a59d56aa0a368108bd920d771e7
// Status: generalization_required (bridges: empty_case:A, empty_case:B, hol_prod_setprod, hol_typedef_topology)
Theorem CONNECTED_COMPONENT_OF_PAIR : forall A B:set, forall top1 :e topology A, forall top2 :e topology B, forall x :e A, forall y :e B, forall x0 :e A :*: B, connected_component_of (A :*: B) (prod_topology A B top1 top2) (x,y) x0 <-> x0 :e {x1 :e A | connected_component_of A top1 x x1} :*: {x1 :e B | connected_component_of B top2 y x1}.
Admitted.

// HOL Light: Multivariate/metric.ml:15122 / CONNECTED_COMPONENTS_OF_PROD_TOPOLOGY
// Source hash: md5:56b29817021bc2d837359e12268407dd
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONNECTED_COMPONENTS_OF_PROD_TOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, connected_components_of (A :*: B) (prod_topology A B top1 top2) = \/_ c1 :e Power A, {c1 :*: c2 | c2 :e Power B, c1 :e connected_components_of A top1 /\ c2 :e connected_components_of B top2}.
Admitted.

// HOL Light: Multivariate/metric.ml:15132 / CONNECTED_COMPONENT_OF_PRODUCT_TOPOLOGY
// Source hash: md5:7fa07f615939b8b0b8e14d6b28c81f69
// Status: transport_required (bridges: choose_in_spec, hol_fun_setexp, hol_typedef_topology)
Theorem CONNECTED_COMPONENT_OF_PRODUCT_TOPOLOGY : forall A K:set, A <> Empty -> K <> Empty -> forall k c= K, forall tops:set -> set, (forall x :e K, tops x :e topology A) -> forall x x0 :e A :^: K, connected_component_of (A :^: K) (product_topology A K k tops) x x0 <-> ((forall x0 :e K, ~ x0 :e k -> x x0 = choose_in A (fun y:set => False)) -> x0 :e {f :e A :^: K | (forall i :e k, f i :e {x2 :e A | connected_component_of A (tops i) (x i) x2}) /\ forall i :e K, ~ i :e k -> f i = choose_in A (fun y:set => False)}) /\ (~ (forall x0 :e K, ~ x0 :e k -> x x0 = choose_in A (fun y:set => False)) -> x0 :e Empty).
Admitted.

// HOL Light: Multivariate/metric.ml:15165 / CONNECTED_COMPONENTS_OF_PRODUCT_TOPOLOGY
// Source hash: md5:e5402cc2943a7fc55080bf1e07968934
// Status: transport_required (bridges: hol_fun_setexp, hol_typedef_topology)
Theorem CONNECTED_COMPONENTS_OF_PRODUCT_TOPOLOGY : forall A K:set, A <> Empty -> K <> Empty -> forall k c= K, forall tops:set -> set, (forall x :e K, tops x :e topology A) -> connected_components_of (A :^: K) (product_topology A K k tops) = {{f :e A :^: K | (forall i :e k, f i :e c i) /\ forall i :e K, ~ i :e k -> f i = choose_in A (fun y:set => False)} | c :e Power A :^: K, forall i :e K, i :e k -> c i :e connected_components_of A (tops i)}.
Admitted.

// HOL Light: Multivariate/metric.ml:15201 / monotone_map
// Source hash: md5:f9a425124fdd84e375f117c79b430889
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem monotone_map_thm : forall A B:set, A <> Empty -> B <> Empty -> forall top' :e topology B, forall top :e topology A, forall f:set -> set, (forall x :e A, f x :e B) -> (monotone_map A B (top,top') f <-> {f x | x :e topspace A top} c= topspace B top' /\ forall y :e B, y :e topspace B top' -> connected_in A top {x :e A | x :e topspace A top /\ f x = y}).
Admitted.

// HOL Light: Multivariate/metric.ml:15207 / MONOTONE_MAP
// Source hash: md5:4d1dcb286aaf8af7cdcef0f711354233
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem MONOTONE_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> (monotone_map A B (top,top') f <-> {f x | x :e topspace A top} c= topspace B top' /\ forall y :e B, connected_in A top {x :e A | x :e topspace A top /\ f x = y}).
Admitted.

// HOL Light: Multivariate/metric.ml:15219 / MONOTONE_MAP_IN_SUBTOPOLOGY
// Source hash: md5:e3ca12ffa50ab675c751fae35ad0d49e
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem MONOTONE_MAP_IN_SUBTOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall s c= B, forall f:set -> set, (forall x :e A, f x :e B) -> (monotone_map A B (top,subtopology B top' s) f <-> monotone_map A B (top,top') f /\ {f x | x :e topspace A top} c= s).
Admitted.

// HOL Light: Multivariate/metric.ml:15225 / MONOTONE_MAP_FROM_SUBTOPOLOGY
// Source hash: md5:a27fd4c1fb981348e45f102dbfd482c8
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem MONOTONE_MAP_FROM_SUBTOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall s c= A, forall f:set -> set, (forall x :e A, f x :e B) -> monotone_map A B (top,top') f /\ (forall x y :e A, x :e topspace A top /\ (y :e topspace A top /\ (x :e s /\ f x = f y)) -> y :e s) -> monotone_map A B (subtopology A top s,top') f.
Admitted.

// HOL Light: Multivariate/metric.ml:15242 / MONOTONE_MAP_RESTRICTION
// Source hash: md5:99d7d7a2f21b2cea53c5f3059609215e
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem MONOTONE_MAP_RESTRICTION : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall u c= A, forall v c= B, monotone_map A B (top,top') f /\ {x :e A | x :e topspace A top /\ f x :e v} = u -> monotone_map A B (subtopology A top u,subtopology B top' v) f.
Admitted.

// HOL Light: Multivariate/metric.ml:15251 / INJECTIVE_IMP_MONOTONE_MAP
// Source hash: md5:ed3a18dff79334a6e6982e7956078ff2
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem INJECTIVE_IMP_MONOTONE_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> {f x | x :e topspace A top} c= topspace B top' /\ (forall x y :e A, x :e topspace A top /\ (y :e topspace A top /\ f x = f y) -> x = y) -> monotone_map A B (top,top') f.
Admitted.

// HOL Light: Multivariate/metric.ml:15267 / EMBEDDING_IMP_MONOTONE_MAP
// Source hash: md5:52b40b678a6ee7b4ef79c4341e7c98cb
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem EMBEDDING_IMP_MONOTONE_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> embedding_map A B (top,top') f -> monotone_map A B (top,top') f.
Admitted.

// HOL Light: Multivariate/metric.ml:15274 / SECTION_IMP_MONOTONE_MAP
// Source hash: md5:cb241a91fac2ab5ffc02ed4224fc15f5
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem SECTION_IMP_MONOTONE_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> section_map A B (top,top') f -> monotone_map A B (top,top') f.
Admitted.

// HOL Light: Multivariate/metric.ml:15279 / HOMEOMORPHIC_IMP_MONOTONE_MAP
// Source hash: md5:b0c6d54f1aa6e78aa54b06d0ba75afe9
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HOMEOMORPHIC_IMP_MONOTONE_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> homeomorphic_map A B (top,top') f -> monotone_map A B (top,top') f.
Admitted.

// HOL Light: Multivariate/metric.ml:15285 / CONNECTED_SPACE_MONOTONE_QUOTIENT_MAP_PREIMAGE
// Source hash: md5:0b4707ce02948f7f40b5b1bcbc46b367
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONNECTED_SPACE_MONOTONE_QUOTIENT_MAP_PREIMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> monotone_map A B (top,top') f /\ (quotient_map A B (top,top') f /\ connected_space B top') -> connected_space A top.
Admitted.

// HOL Light: Multivariate/metric.ml:15311 / CONNECTED_IN_MONOTONE_QUOTIENT_MAP_PREIMAGE
// Source hash: md5:8d082f88cdab761f8b473ff870d7fae7
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONNECTED_IN_MONOTONE_QUOTIENT_MAP_PREIMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall c c= B, monotone_map A B (top,top') f /\ (quotient_map A B (top,top') f /\ (connected_in B top' c /\ (c :e top' \/ closed_in B top' c))) -> connected_in A top {x :e A | x :e topspace A top /\ f x :e c}.
Admitted.

// HOL Light: Multivariate/metric.ml:15325 / MONOTONE_OPEN_MAP
// Source hash: md5:d0d704debc0b1edf7b94bda7686e42b2
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem MONOTONE_OPEN_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> continuous_map A B (top,top') f /\ (open_map A B (top,top') f /\ {f x | x :e topspace A top} = topspace B top') -> (monotone_map A B (top,top') f <-> forall c c= B, connected_in B top' c -> connected_in A top {x :e A | x :e topspace A top /\ f x :e c}).
Admitted.

// HOL Light: Multivariate/metric.ml:15349 / MONOTONE_CLOSED_MAP
// Source hash: md5:8f8c912d31636399b68fdbb22a8256a2
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem MONOTONE_CLOSED_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> continuous_map A B (top,top') f /\ (closed_map A B (top,top') f /\ {f x | x :e topspace A top} = topspace B top') -> (monotone_map A B (top,top') f <-> forall c c= B, connected_in B top' c -> connected_in A top {x :e A | x :e topspace A top /\ f x :e c}).
Admitted.

// HOL Light: Multivariate/metric.ml:15384 / neighbourhood_base_at
// Source hash: md5:c257c9c870d5e0d099ae861fd7b00257
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem neighbourhood_base_at_thm : forall A:set, forall top :e topology A, forall P c= Power A, forall x :e A, neighbourhood_base_at A x P top <-> forall w c= A, w :e top /\ x :e w -> exists u v c= A, u :e top /\ (v :e P /\ (x :e u /\ (u c= v /\ v c= w))).
Admitted.

// HOL Light: Multivariate/metric.ml:15390 / neighbourhood_base_of
// Source hash: md5:6859fff280643946426d6ecfbc071fc3
// Status: transport_required (bridges: hol_typedef_topology)
Theorem neighbourhood_base_of_thm : forall A:set, A <> Empty -> forall P c= Power A, forall top :e topology A, neighbourhood_base_of A P top <-> forall x :e A, x :e topspace A top -> neighbourhood_base_at A x P top.
Admitted.

// HOL Light: Multivariate/metric.ml:15394 / NEIGHBOURHOOD_BASE_OF
// Source hash: md5:338ad84ab43b37094cc479ea80a3e489
// Status: transport_required (bridges: hol_typedef_topology)
Theorem NEIGHBOURHOOD_BASE_OF : forall A:set, A <> Empty -> forall top :e topology A, forall P c= Power A, neighbourhood_base_of A P top <-> forall w c= A, forall x :e A, w :e top /\ x :e w -> exists u v c= A, u :e top /\ (v :e P /\ (x :e u /\ (u c= v /\ v c= w))).
Admitted.

// HOL Light: Multivariate/metric.ml:15403 / NEIGHBOURHOOD_BASE_AT_MONO
// Source hash: md5:fb69cdc6dec277ee59a6fcd5d6ced97e
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem NEIGHBOURHOOD_BASE_AT_MONO : forall A:set, forall top :e topology A, forall P Q c= Power A, forall x :e A, (forall s c= A, s :e P /\ x :e s -> s :e Q) /\ neighbourhood_base_at A x P top -> neighbourhood_base_at A x Q top.
Admitted.

// HOL Light: Multivariate/metric.ml:15411 / NEIGHBOURHOOD_BASE_OF_MONO
// Source hash: md5:359b44ac8fcfaef62ebcfd9957c45ef4
// Status: transport_required (bridges: hol_typedef_topology)
Theorem NEIGHBOURHOOD_BASE_OF_MONO : forall A:set, A <> Empty -> forall top :e topology A, forall P Q c= Power A, (forall s c= A, s :e P -> s :e Q) /\ neighbourhood_base_of A P top -> neighbourhood_base_of A Q top.
Admitted.

// HOL Light: Multivariate/metric.ml:15418 / OPEN_NEIGHBOURHOOD_BASE_AT
// Source hash: md5:cc84426582fe05143b2625bd79bd2573
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem OPEN_NEIGHBOURHOOD_BASE_AT : forall A:set, forall top :e topology A, forall P c= Power A, forall x :e A, (forall s c= A, s :e P /\ x :e s -> s :e top) -> (neighbourhood_base_at A x P top <-> forall w c= A, w :e top /\ x :e w -> exists u c= A, u :e P /\ (x :e u /\ u c= w)).
Admitted.

// HOL Light: Multivariate/metric.ml:15426 / OPEN_NEIGHBOURHOOD_BASE_OF
// Source hash: md5:e9dcb7764fc48b3f4ffba9f260609e8c
// Status: transport_required (bridges: hol_typedef_topology)
Theorem OPEN_NEIGHBOURHOOD_BASE_OF : forall A:set, A <> Empty -> forall top :e topology A, forall P c= Power A, (forall s c= A, s :e P -> s :e top) -> (neighbourhood_base_of A P top <-> forall w c= A, forall x :e A, w :e top /\ x :e w -> exists u c= A, u :e P /\ (x :e u /\ u c= w)).
Admitted.

// HOL Light: Multivariate/metric.ml:15435 / OPEN_IN_TOPOLOGY_NEIGHBOURHOOD_BASE_UNIQUE
// Source hash: md5:06d66c229739e40293fe6ffecc5f3c29
// Status: transport_required (bridges: hol_typedef_topology)
Theorem OPEN_IN_TOPOLOGY_NEIGHBOURHOOD_BASE_UNIQUE : forall A:set, A <> Empty -> forall top :e topology A, forall b c= Power A, (forall x c= A, x :e top <-> exists u c= Power A, True /\ (forall x0 :e u, x0 :e b) /\ Union u = x) <-> (forall u c= A, u :e b -> u :e top) /\ neighbourhood_base_of A b top.
Admitted.

// HOL Light: Multivariate/metric.ml:15444 / NEIGHBOURHOOD_BASE_OF_OPEN_SUBSET
// Source hash: md5:57f775d2ec2fd0b29116ffda5577753f
// Status: transport_required (bridges: hol_typedef_topology)
Theorem NEIGHBOURHOOD_BASE_OF_OPEN_SUBSET : forall A:set, A <> Empty -> forall top :e topology A, forall P c= Power A, forall s c= A, neighbourhood_base_of A P top /\ s :e top -> neighbourhood_base_of A P (subtopology A top s).
Admitted.

// HOL Light: Multivariate/metric.ml:15459 / NEIGHBOURHOOD_BASE_AT_TOPOLOGY_BASE
// Source hash: md5:826cebaf1a21a9ca285870a98d9ead2c
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem NEIGHBOURHOOD_BASE_AT_TOPOLOGY_BASE : forall A:set, forall P c= Power A, forall top :e topology A, forall b c= Power A, forall x :e A, (forall x0 c= A, x0 :e top <-> exists u c= Power A, True /\ (forall x1 :e u, x1 :e b) /\ Union u = x0) -> (neighbourhood_base_at A x P top <-> forall w c= A, w :e b /\ x :e w -> exists u v c= A, u :e top /\ (v :e P /\ (x :e u /\ (u c= v /\ v c= w)))).
Admitted.

// HOL Light: Multivariate/metric.ml:15475 / NEIGHBOURHOOD_BASE_OF_TOPOLOGY_BASE
// Source hash: md5:3bed7848e9514e4d8bc7fbd0aeefb132
// Status: transport_required (bridges: hol_typedef_topology)
Theorem NEIGHBOURHOOD_BASE_OF_TOPOLOGY_BASE : forall A:set, A <> Empty -> forall P c= Power A, forall top :e topology A, forall b c= Power A, (forall x c= A, x :e top <-> exists u c= Power A, True /\ (forall x0 :e u, x0 :e b) /\ Union u = x) -> (neighbourhood_base_of A P top <-> forall w c= A, forall x :e A, w :e b /\ x :e w -> exists u v c= A, u :e top /\ (v :e P /\ (x :e u /\ (u c= v /\ v c= w)))).
Admitted.

// HOL Light: Multivariate/metric.ml:15492 / NEIGHBOURHOOD_BASE_AT_UNLOCALIZED
// Source hash: md5:e34dde8b56c87eff2507069bd9a87feb
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem NEIGHBOURHOOD_BASE_AT_UNLOCALIZED : forall A:set, forall top :e topology A, forall P c= Power A, forall x :e A, (forall s t c= A, s :e P /\ (t :e top /\ (x :e t /\ t c= s)) -> t :e P) -> (neighbourhood_base_at A x P top <-> x :e topspace A top -> exists u v c= A, u :e top /\ (v :e P /\ (x :e u /\ (u c= v /\ v c= topspace A top)))).
Admitted.

// HOL Light: Multivariate/metric.ml:15511 / NEIGHBOURHOOD_BASE_OF_UNLOCALIZED
// Source hash: md5:dc9def7f9f8924e139017603736fcf11
// Status: transport_required (bridges: hol_typedef_topology)
Theorem NEIGHBOURHOOD_BASE_OF_UNLOCALIZED : forall A:set, A <> Empty -> forall top :e topology A, forall P c= Power A, (forall s t c= A, s :e P /\ (t :e top /\ (~ t = Empty /\ t c= s)) -> t :e P) -> (neighbourhood_base_of A P top <-> forall x :e A, x :e topspace A top -> exists u v c= A, u :e top /\ (v :e P /\ (x :e u /\ (u c= v /\ v c= topspace A top)))).
Admitted.

// HOL Light: Multivariate/metric.ml:15526 / NEIGHBOURHOOD_BASE_AT_DISCRETE_TOPOLOGY
// Source hash: md5:736346c94eca7c219b8d16ce50733f3b
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem NEIGHBOURHOOD_BASE_AT_DISCRETE_TOPOLOGY : forall A:set, forall P c= Power A, forall u c= A, forall x :e A, neighbourhood_base_at A x P (discrete_topology A u) <-> x :e u -> {x} :e P.
Admitted.

// HOL Light: Multivariate/metric.ml:15542 / NEIGHBOURHOOD_BASE_OF_DISCRETE_TOPOLOGY
// Source hash: md5:c4e397604b98cd1b5e4c6bb3f3bb102f
// Status: transport_required (bridges: hol_typedef_topology)
Theorem NEIGHBOURHOOD_BASE_OF_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall P c= Power A, forall u c= A, neighbourhood_base_of A P (discrete_topology A u) <-> forall x :e A, x :e u -> {x} :e P.
Admitted.

// HOL Light: Multivariate/metric.ml:15550 / NEIGHBOURHOOD_BASE_AT_WITH_SUBSET
// Source hash: md5:4936d227ba6b4ce6c09298f47d3cddc1
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem NEIGHBOURHOOD_BASE_AT_WITH_SUBSET : forall A:set, forall P c= Power A, forall top :e topology A, forall u c= A, forall x :e A, u :e top /\ x :e u -> (neighbourhood_base_at A x P top <-> neighbourhood_base_at A x {t :e Power A | t c= u /\ t :e P} top).
Admitted.

// HOL Light: Multivariate/metric.ml:15562 / NEIGHBOURHOOD_BASE_OF_WITH_SUBSET
// Source hash: md5:5022e5e183b0c2a40e2eadb0991824a8
// Status: transport_required (bridges: hol_typedef_topology)
Theorem NEIGHBOURHOOD_BASE_OF_WITH_SUBSET : forall A:set, A <> Empty -> forall P c= Power A, forall top :e topology A, neighbourhood_base_of A P top <-> neighbourhood_base_of A {t :e Power A | t c= topspace A top /\ t :e P} top.
Admitted.

// HOL Light: Multivariate/metric.ml:15574 / SECOND_COUNTABLE_NEIGHBOURHOOD_BASE_ALT
// Source hash: md5:934340e7527e6f694968d49694868bde
// Status: transport_required (bridges: hol_countable, hol_typedef_topology)
Theorem SECOND_COUNTABLE_NEIGHBOURHOOD_BASE_ALT : forall A:set, A <> Empty -> forall top :e topology A, second_countable A top <-> exists b c= Power A, countable b /\ ((forall v c= A, v :e b -> v :e top) /\ neighbourhood_base_of A b top).
Admitted.

// HOL Light: Multivariate/metric.ml:15582 / FIRST_COUNTABLE_NEIGHBOURHOOD_BASE_ALT
// Source hash: md5:50d8651e9c2c60331a63d081e8328ab9
// Status: transport_required (bridges: hol_countable, hol_typedef_topology)
Theorem FIRST_COUNTABLE_NEIGHBOURHOOD_BASE_ALT : forall A:set, A <> Empty -> forall top :e topology A, first_countable A top <-> forall x :e A, x :e topspace A top -> exists b c= Power A, countable b /\ ((forall v c= A, v :e b -> v :e top) /\ neighbourhood_base_at A x b top).
Admitted.

// HOL Light: Multivariate/metric.ml:15596 / SECOND_COUNTABLE_NEIGHBOURHOOD_BASE
// Source hash: md5:5d41792cb392c73c80dea6afc2538362
// Status: transport_required (bridges: hol_countable, hol_typedef_topology)
Theorem SECOND_COUNTABLE_NEIGHBOURHOOD_BASE : forall A:set, A <> Empty -> forall top :e topology A, second_countable A top <-> exists b c= Power A, countable b /\ neighbourhood_base_of A b top.
Admitted.

// HOL Light: Multivariate/metric.ml:15616 / FIRST_COUNTABLE_NEIGHBOURHOOD_BASE
// Source hash: md5:0969b2be9592711d3b979f00c0e24883
// Status: transport_required (bridges: hol_countable, hol_typedef_topology)
Theorem FIRST_COUNTABLE_NEIGHBOURHOOD_BASE : forall A:set, A <> Empty -> forall top :e topology A, first_countable A top <-> forall x :e A, x :e topspace A top -> exists b c= Power A, countable b /\ neighbourhood_base_at A x b top.
Admitted.

// HOL Light: Multivariate/metric.ml:15643 / t0_space
// Source hash: md5:75487e4bb922d31a0470f589d330c269
// Status: transport_required (bridges: hol_typedef_topology)
Theorem t0_space_thm : forall A:set, A <> Empty -> forall top :e topology A, t0_space A top <-> forall x y :e A, x :e topspace A top /\ (y :e topspace A top /\ ~ x = y) -> exists u c= A, u :e top /\ ~ (x :e u <-> y :e u).
Admitted.

// HOL Light: Multivariate/metric.ml:15648 / T0_SPACE_EXPANSIVE
// Source hash: md5:73dec082e450b6f304877a8ff03b2d1f
// Status: transport_required (bridges: hol_typedef_topology)
Theorem T0_SPACE_EXPANSIVE : forall A:set, A <> Empty -> forall top top' :e topology A, topspace A top' = topspace A top /\ (forall u c= A, u :e top -> u :e top') -> t0_space A top -> t0_space A top'.
Admitted.

// HOL Light: Multivariate/metric.ml:15654 / T1_IMP_T0_SPACE
// Source hash: md5:97b322ffabf99c9eb8a95b02f9d6237e
// Status: transport_required (bridges: hol_typedef_topology)
Theorem T1_IMP_T0_SPACE : forall A:set, A <> Empty -> forall top :e topology A, t1_space A top -> t0_space A top.
Admitted.

// HOL Light: Multivariate/metric.ml:15658 / T1_EQ_SYMMETRIC_T0_SPACE_ALT
// Source hash: md5:b828e87c10aa320e172d414cb8d992d5
// Status: transport_required (bridges: hol_typedef_topology)
Theorem T1_EQ_SYMMETRIC_T0_SPACE_ALT : forall A:set, A <> Empty -> forall top :e topology A, t1_space A top <-> t0_space A top /\ forall x y :e A, x :e topspace A top /\ y :e topspace A top -> (x :e closure_of A top {y} <-> y :e closure_of A top {x}).
Admitted.

// HOL Light: Multivariate/metric.ml:15673 / T1_EQ_SYMMETRIC_T0_SPACE
// Source hash: md5:b2199eb44d95e346ec8aa3f75b3282e8
// Status: transport_required (bridges: hol_typedef_topology)
Theorem T1_EQ_SYMMETRIC_T0_SPACE : forall A:set, A <> Empty -> forall top :e topology A, t1_space A top <-> t0_space A top /\ forall x y :e A, x :e closure_of A top {y} <-> y :e closure_of A top {x}.
Admitted.

// HOL Light: Multivariate/metric.ml:15689 / HAUSDORFF_IMP_T0_SPACE
// Source hash: md5:b0c79a1d5021e5c16a41d6ce27c266e1
// Status: transport_required (bridges: hol_typedef_topology)
Theorem HAUSDORFF_IMP_T0_SPACE : forall A:set, A <> Empty -> forall top :e topology A, hausdorff_space A top -> t0_space A top.
Admitted.

// HOL Light: Multivariate/metric.ml:15693 / T0_SPACE
// Source hash: md5:bf61a2c5f7221affd61d55e5a8c11e73
// Status: transport_required (bridges: hol_typedef_topology)
Theorem T0_SPACE : forall A:set, A <> Empty -> forall top :e topology A, t0_space A top <-> forall x y :e A, x :e topspace A top /\ (y :e topspace A top /\ ~ x = y) -> exists c c= A, closed_in A top c /\ ~ (x :e c <-> y :e c).
Admitted.

// HOL Light: Multivariate/metric.ml:15700 / HOMEOMORPHIC_T0_SPACE
// Source hash: md5:1b58fb64785632e6513055c190411f7d
// Status: transport_required (bridges: hol_typedef_topology)
Theorem HOMEOMORPHIC_T0_SPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, homeomorphic_space A B top top' -> (t0_space A top <-> t0_space B top').
Admitted.

// HOL Light: Multivariate/metric.ml:15725 / T0_SPACE_CLOSURE_OF_SING
// Source hash: md5:ec4f0d9498dfd79459e48e2570cc029f
// Status: transport_required (bridges: hol_typedef_topology)
Theorem T0_SPACE_CLOSURE_OF_SING : forall A:set, A <> Empty -> forall top :e topology A, t0_space A top <-> forall x y :e A, x :e topspace A top /\ (y :e topspace A top /\ closure_of A top {x} = closure_of A top {y}) -> x = y.
Admitted.

// HOL Light: Multivariate/metric.ml:15736 / T0_SPACE_DISCRETE_TOPOLOGY
// Source hash: md5:087b975031ba23d9fbd26e987c0e78a3
// Status: transport_required (bridges: hol_typedef_topology)
Theorem T0_SPACE_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall s c= A, t0_space A (discrete_topology A s).
Admitted.

// HOL Light: Multivariate/metric.ml:15742 / T0_SPACE_SUBTOPOLOGY
// Source hash: md5:dd2e1dcab073abc6fc969c399567b4da
// Status: transport_required (bridges: hol_typedef_topology)
Theorem T0_SPACE_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e topology A, forall u c= A, t0_space A top -> t0_space A (subtopology A top u).
Admitted.

// HOL Light: Multivariate/metric.ml:15749 / T0_SPACE_RETRACTION_MAP_IMAGE
