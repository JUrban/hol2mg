// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem SURJECTIVE_EMBEDDING_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> (embedding_map A B (top,top') f /\ {f x | x :e topspace A top} = topspace B top' <-> homeomorphic_map A B (top,top') f).
Admitted.

