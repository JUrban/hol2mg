// Status: transport_required (bridges: hol_typedef_metric, hol_typedef_topology)
Theorem CFUNSPACE_SUBSET_FUNSPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall m :e metric B, mspace (B :^: A) (cfunspace A B top m) c= mspace (B :^: A) (funspace A B (topspace A top) m).
Admitted.

// HOL Light: Multivariate/metric.ml:39579 / MDIST_CFUNSPACE_EQ_MDIST_FUNSPACE
// Source hash: md5:308416f97f9a754f55abe6f4ed0ae165
// Status: transport_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_topology)
Theorem MDIST_CFUNSPACE_EQ_MDIST_FUNSPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall m :e metric B, forall f g :e B :^: A, mdist (B :^: A) (cfunspace A B top m) (f,g) = mdist (B :^: A) (funspace A B (topspace A top) m) (f,g).
Admitted.

// HOL Light: Multivariate/metric.ml:39584 / CFUNSPACE_MDIST_LE
// Source hash: md5:28cd5dfe56492ae155c2406529bfbb86
// Status: transport_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_topology)
Theorem CFUNSPACE_MDIST_LE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall m :e metric B, forall f g :e B :^: A, forall a :e R, ~ topspace A top = Empty /\ (f :e mspace (B :^: A) (cfunspace A B top m) /\ g :e mspace (B :^: A) (cfunspace A B top m)) -> (mdist (B :^: A) (cfunspace A B top m) (f,g) <= a <-> forall x :e A, x :e topspace A top -> mdist B m (f x,g x) <= a).
Admitted.

