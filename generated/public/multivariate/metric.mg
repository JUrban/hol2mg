Theorem sigma_locally_finite_in_thm : forall A:set, A <> Empty -> forall top :e topology A, forall U c= Power A, sigma_locally_finite_in A top U <-> exists f :e Power (Power A) :^: omega, (forall n :e omega, locally_finite_in A top (f n)) /\ U = Union {f n | n :e omega, n :e omega}.
