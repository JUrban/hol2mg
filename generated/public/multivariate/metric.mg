// Source hash: md5:cc310d5c3a1d73130bde1303da85f16c
// Status: transport_required (bridges: hol_num_omega, hol_typedef_metric, hol_typedef_net, hol_typedef_topology)
Theorem mcomplete_thm : forall A:set, A <> Empty -> forall m :e metric A, mcomplete A m <-> forall s:set -> set, (forall x :e omega, s x :e A) -> cauchy_in A m s -> exists x :e A, limit omega A (mtopology A m) s x sequentially.
Admitted.

// HOL Light: Multivariate/metric.ml:19890 / MCOMPLETE
// Source hash: md5:a070fcc58e11babe523c171f24ce8b35
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_net, hol_typedef_topology, nat_le_SNoLe, omega_Subq_R)
Theorem MCOMPLETE : forall A:set, A <> Empty -> forall m :e metric A, mcomplete A m <-> forall s:set -> set, (forall x :e omega, s x :e A) -> eventually omega {n :e omega | s n :e mspace A m} sequentially /\ (forall e0 :e R, 0 < e0 -> exists N :e omega, forall n n' :e omega, N <= n /\ N <= n' -> mdist A m (s n,s n') < e0) -> exists x :e A, limit omega A (mtopology A m) s x sequentially.
Admitted.

