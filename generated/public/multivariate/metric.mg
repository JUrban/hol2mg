Theorem OPEN_EQ_CONTINUOUS_INVERSE_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e B, g x :e A) -> (forall x :e A, x :e topspace A top -> f x :e topspace B top' /\ g (f x) = x) /\ (forall y :e B, y :e topspace B top' -> g y :e topspace A top /\ f (g y) = y) -> (open_map A B (top,top') f <-> continuous_map B A (top',top) g).
