// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CLOSED_IN_CROSS : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, forall s c= A, forall t c= B, closed_in (A :*: B) (prod_topology A B top1 top2) (s :*: t) <-> s = Empty \/ (t = Empty \/ closed_in A top1 s /\ closed_in B top2 t).
Admitted.

