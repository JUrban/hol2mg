// Source hash: md5:5cecc348ea8ead359c731f938c9bae0d
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem K_SPACE_PROD_TOPOLOGY_LEFT : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, locally_compact_space A top /\ ((hausdorff_space A top \/ regular_space A top) /\ k_space B top') -> k_space (A :*: B) (prod_topology A B top top').
Admitted.

