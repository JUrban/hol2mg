Theorem METRIC_INTERIOR_OF : forall A:set, A <> Empty -> forall m :e metric A, forall s c= A, interior_of A (mtopology A m) s = {x :e A | x :e mspace A m /\ exists e0 :e R, 0 < e0 /\ mball A m (x,e0) c= s}.
Admitted.

