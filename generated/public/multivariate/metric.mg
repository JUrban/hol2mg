// Source hash: md5:2990232fecbf67482cadbad271234c0a
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem RETRACTION_MAPS_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f f' :e B :^: A, forall g g' :e A :^: B, (forall x :e A, x :e topspace A top -> f x = f' x) /\ ((forall x :e B, x :e topspace B top' -> g x = g' x) /\ retraction_maps A B (top,top') (f,g)) -> retraction_maps A B (top,top') (f',g').
Admitted.

