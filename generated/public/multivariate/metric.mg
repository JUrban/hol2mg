Theorem LOCALLY_FINITE_COVER_OF_LINDELOF_SPACE : forall A:set, A <> Empty -> forall top :e topology A, forall u c= Power A, lindelof_space A top /\ (topspace A top c= Union u /\ locally_finite_in A top u) -> countable u.
Admitted.

