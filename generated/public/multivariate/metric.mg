// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem PROPER_MAP_FROM_SUBTOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall c c= A, proper_map A B (top,top') f /\ closed_in A top c -> proper_map A B (subtopology A top c,top') f.
Admitted.

