Theorem QUOTIENT_MAP_ONTO_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> {f x | x :e topspace A top} c= topspace B top' /\ (forall u c= B, u c= topspace B top' -> ({x :e A | x :e topspace A top /\ f x :e u} :e top <-> u :e top')) -> quotient_map A B (top,subtopology B top' {f x | x :e topspace A top}) f.
Admitted.

// HOL Light: Multivariate/metric.ml:3623 / QUOTIENT_MAP_LIFT_EXISTS
// Source hash: md5:290cc0510427b0070c7c102ff9b7717e
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem QUOTIENT_MAP_LIFT_EXISTS : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e topology A, forall top' :e topology B, forall top'' :e topology C, forall f:set -> set, (forall x :e A, f x :e B) -> forall h:set -> set, (forall x :e A, h x :e C) -> quotient_map A B (top,top') f /\ (continuous_map A C (top,top'') h /\ (forall x y :e A, x :e topspace A top /\ (y :e topspace A top /\ f x = f y) -> h x = h y)) -> exists g:set -> set, (forall x :e B, g x :e C) /\ (continuous_map B C (top',top'') g /\ ({g x | x :e topspace B top'} = {h x | x :e topspace A top} /\ forall x :e A, x :e topspace A top -> g (f x) = h x)).
Admitted.

// HOL Light: Multivariate/metric.ml:3643 / DISCRETE_SPACE_QUOTIENT_MAP_IMAGE
// Source hash: md5:f9a9e95c69997cfd6b77963051a7ffe2
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem DISCRETE_SPACE_QUOTIENT_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall q:set -> set, (forall x :e A, q x :e B) -> quotient_map A B (top,top') q /\ discrete_space A top -> discrete_space B top'.
Admitted.

// HOL Light: Multivariate/metric.ml:3659 / prod_topology
// Source hash: md5:a1e771f5df91b978f5b2e5cb1ad14f4b
// Status: generalization_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem prod_topology_thm : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, prod_topology A B top1 top2 = {x :e Power (A :*: B) | exists u c= Power (A :*: B), True /\ (forall x0 :e u, x0 :e \/_ s :e Power A, {s :*: t | t :e Power B, s :e top1 /\ t :e top2}) /\ Union u = x}.
Admitted.

// HOL Light: Multivariate/metric.ml:3664 / OPEN_IN_PROD_TOPOLOGY
// Source hash: md5:8b99679941b04ecd6b6cbce1cf34fb3f
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem OPEN_IN_PROD_TOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, forall x c= A :*: B, x :e prod_topology A B top1 top2 <-> exists u c= Power (A :*: B), True /\ (forall x0 :e u, x0 :e \/_ s :e Power A, {s :*: t | t :e Power B, s :e top1 /\ t :e top2}) /\ Union u = x.
Admitted.

// HOL Light: Multivariate/metric.ml:3678 / TOPSPACE_PROD_TOPOLOGY
// Source hash: md5:bd772c3b0f5e2eac3a92679e44e875ca
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem TOPSPACE_PROD_TOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, topspace (A :*: B) (prod_topology A B top1 top2) = topspace A top1 :*: topspace B top2.
Admitted.

// HOL Light: Multivariate/metric.ml:3700 / SUBTOPOLOGY_CROSS
// Source hash: md5:71c0917f0283af818a2d9cd78f6f8c66
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem SUBTOPOLOGY_CROSS : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, forall s c= A, forall t c= B, subtopology (A :*: B) (prod_topology A B top1 top2) (s :*: t) = prod_topology A B (subtopology A top1 s) (subtopology B top2 t).
Admitted.

// HOL Light: Multivariate/metric.ml:3714 / PROD_TOPOLOGY_SUBTOPOLOGY
// Source hash: md5:0a8094517df45e8271a059b61bd716e7
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem PROD_TOPOLOGY_SUBTOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> (forall top :e topology A, forall top' :e topology B, forall s c= A, prod_topology A B (subtopology A top s) top' = subtopology (A :*: B) (prod_topology A B top top') (s :*: topspace B top')) /\ forall top :e topology A, forall top' :e topology B, forall t c= B, prod_topology A B top (subtopology B top' t) = subtopology (A :*: B) (prod_topology A B top top') (topspace A top :*: t).
Admitted.

// HOL Light: Multivariate/metric.ml:3723 / PROD_TOPOLOGY_DISCRETE_TOPOLOGY
// Source hash: md5:4a1d83c1462d81e2e4c7e2c7681373ac
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem PROD_TOPOLOGY_DISCRETE_TOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall s c= A, forall t c= B, prod_topology A B (discrete_topology A s) (discrete_topology B t) = discrete_topology (A :*: B) (s :*: t).
Admitted.

// HOL Light: Multivariate/metric.ml:3738 / OPEN_IN_PROD_TOPOLOGY_ALT
