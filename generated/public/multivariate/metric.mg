// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem embedding_map_thm : forall A B:set, A <> Empty -> B <> Empty -> forall top' :e topology B, forall top :e topology A, forall f:set -> set, (forall x :e A, f x :e B) -> (embedding_map A B (top,top') f <-> homeomorphic_map A B (top,subtopology B top' {f x | x :e topspace A top}) f).
Admitted.

// HOL Light: Multivariate/metric.ml:5802 / EMBEDDING_MAP_EQ
// Source hash: md5:bc87c86a6532da368ce29b9d397b49c9
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem EMBEDDING_MAP_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e A, g x :e B) -> (forall x :e A, x :e topspace A top -> f x = g x) /\ embedding_map A B (top,top') f -> embedding_map A B (top,top') g.
Admitted.

// HOL Light: Multivariate/metric.ml:5809 / EMBEDDING_MAP_COMPOSE
// Source hash: md5:2abf7c4722d69b83e0aff5734eef07cd
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem EMBEDDING_MAP_COMPOSE : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e topology A, forall top' :e topology B, forall top'' :e topology C, forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e B, g x :e C) -> embedding_map A B (top,top') f /\ embedding_map B C (top',top'') g -> embedding_map A C (top,top'') (fun x:set => g (f x)).
Admitted.

