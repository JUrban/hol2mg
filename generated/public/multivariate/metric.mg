Theorem NORMAL_SPACE_EQ_URYSOHN_GEN : forall A:set, A <> Empty -> forall top :e topology A, forall a b :e R, a < b -> (normal_space A top <-> forall s t c= A, closed_in A top s /\ (closed_in A top t /\ s :/\: t = Empty) -> exists f:set -> set, (forall x :e A, f x :e R) /\ (continuous_map A R (top,subtopology R euclideanreal (closed_real_interval (seq_cons (a,b) seq_nil))) f /\ ((forall x :e A, x :e s -> f x = a) /\ forall x :e A, x :e t -> f x = b))).
Admitted.

// HOL Light: Multivariate/metric.ml:24201 / NORMAL_SPACE_EQ_URYSOHN_ALT
// Source hash: md5:456418584c0709f57f3058a527103d1f
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_topology, omega_Subq_R)
Theorem NORMAL_SPACE_EQ_URYSOHN_ALT : forall A:set, A <> Empty -> forall top :e topology A, normal_space A top <-> forall s t c= A, closed_in A top s /\ (closed_in A top t /\ s :/\: t = Empty) -> exists f:set -> set, (forall x :e A, f x :e R) /\ (continuous_map A R (top,euclideanreal) f /\ ((forall x :e A, x :e s -> f x = 0) /\ forall x :e A, x :e t -> f x = 1)).
