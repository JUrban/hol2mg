// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem OPEN_IN_PROD_TOPOLOGY_ALT : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, forall s c= A :*: B, s :e prod_topology A B top1 top2 <-> forall x :e A, forall y :e B, (x,y) :e s -> exists u c= A, exists v c= B, u :e top1 /\ (v :e top2 /\ (x :e u /\ (y :e v /\ u :*: v c= s))).
Admitted.

