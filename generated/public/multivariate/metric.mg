Theorem LIMIT_REAL_DIV : forall A:set, A <> Empty -> forall net0 :e net A, forall f:set -> set, (forall x :e A, f x :e R) -> forall g:set -> set, (forall x :e A, g x :e R) -> forall l m :e R, limit A R euclideanreal f l net0 /\ (limit A R euclideanreal g m net0 /\ ~ m = 0) -> limit A R euclideanreal (fun x:set => f x :/: g x) (l :/: m) net0.
Admitted.

// HOL Light: Multivariate/metric.ml:19617 / LIMIT_INF
// Source hash: md5:57afa3a995b25664cef459f868cdb646
// Status: transport_required (bridges: hol_finite_finite, hol_real_R, hol_typedef_net, hol_typedef_topology)
Theorem LIMIT_INF : forall A K:set, A <> Empty -> K <> Empty -> forall net0 :e net A, forall f:set -> set -> set, (forall x :e A, forall y :e K, f x y :e R) -> forall l:set -> set, (forall x :e K, l x :e R) -> forall k c= K, finite k /\ (forall i :e K, i :e k -> limit A R euclideanreal (fun x:set => f x i) (l i) net0) -> limit A R euclideanreal (fun x:set => inf {f x i | i :e K, i :e k}) (inf {l i | i :e K, i :e k}) net0.
Admitted.

