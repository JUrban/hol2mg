// Source hash: md5:5c7b84cafb92a553221db307be0ffaa7
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HOMOTOPIC_WITH_PROD_TOPOLOGY : forall A B C D:set, A <> Empty -> B <> Empty -> C <> Empty -> D <> Empty -> forall p c= B :^: A, forall q c= D :^: C, forall r c= (B :*: D) :^: (A :*: C), forall top1 :e topology A, forall top1' :e topology B, forall top2 :e topology C, forall top2' :e topology D, forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e C, g x :e D) -> forall f':set -> set, (forall x :e A, f' x :e B) -> forall g':set -> set, (forall x :e C, g' x :e D) -> homotopic_with B A p (top1,top1') f f' /\ (homotopic_with D C q (top2,top2') g g' /\ (forall i :e B :^: A, forall j :e D :^: C, i :e p /\ j :e q -> (fun p0 :e A :*: C => (i (p0 0),j (p0 1))) :e r)) -> homotopic_with (B :*: D) (A :*: C) r (prod_topology A C top1 top2,prod_topology B D top1' top2') (fun z:set => (f (z 0),g (z 1))) (fun z:set => (f' (z 0),g' (z 1))).
Admitted.

// HOL Light: Multivariate/metric.ml:29369 / HOMOTOPIC_WITH_PRODUCT_TOPOLOGY
// Source hash: md5:843341b617f5304c05762ae88fc31deb
// Status: transport_required (bridges: choose_in_spec, hol_prod_setprod, hol_typedef_topology)
Theorem HOMOTOPIC_WITH_PRODUCT_TOPOLOGY : forall A B K:set, A <> Empty -> B <> Empty -> K <> Empty -> forall k c= K, forall tops:set -> set, (forall x :e K, tops x :e topology A) -> forall tops':set -> set, (forall x :e K, tops' x :e topology B) -> forall p :e Power (B :^: A) :^: K, forall q c= B :^: K :^: (A :^: K), forall f:set -> set -> set, (forall x :e K, forall y :e A, f x y :e B) -> forall g:set -> set -> set, (forall x :e K, forall y :e A, g x y :e B) -> (forall i :e K, i :e k -> homotopic_with B A (p i) (tops i,tops' i) (f i) (g i)) /\ (forall h :e B :^: A :^: K, (forall i :e K, i :e k -> h i :e p i) -> (fun x :e A :^: K => fun x0 :e K => if x0 :e k then h x0 (x x0) else choose_in B (fun y:set => False)) :e q) -> homotopic_with (B :^: K) (A :^: K) q (product_topology A K k tops,product_topology B K k tops') (fun x:set => fun x0 :e K => if x0 :e k then f x0 (x x0) else choose_in B (fun y:set => False)) (fun x:set => fun x0 :e K => if x0 :e k then g x0 (x x0) else choose_in B (fun y:set => False)).
Admitted.

// HOL Light: Multivariate/metric.ml:29405 / homotopy_equivalent_space
// Source hash: md5:665f1fd92b876f0a11c055d3ab4a3d9c
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem homotopy_equivalent_space_thm : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, homotopy_equivalent_space A B top top' <-> exists f:set -> set, (forall x :e A, f x :e B) /\ exists g:set -> set, (forall x :e B, g x :e A) /\ (continuous_map A B (top,top') f /\ (continuous_map B A (top',top) g /\ (homotopic_with A A {x :e A :^: A | True} (top,top) (fun x:set => g (f x)) (fun x:set => x) /\ homotopic_with B B {x :e B :^: B | True} (top',top') (fun x:set => f (g x)) (fun x:set => x)))).
Admitted.

