// Status: generalization_required (bridges: choose_in_spec, empty_case:A, hol_typedef_topology)
Theorem kolmogorov_quotient_thm : forall A:set, forall top :e topology A, forall x :e A, kolmogorov_quotient A top x = choose_in A (fun y:set => forall u c= A, u :e top -> (y :e u <-> x :e u)).
Admitted.

