Theorem real_sums_thm : forall s c= omega, forall f:set -> set, (forall x :e omega, f x :e R) -> forall l :e R, real_sums f l s <-> tendsto_real omega (fun n:set => finsum (s :/\: {i :e omega | 0 <= i /\ i <= n}) f) l sequentially.
