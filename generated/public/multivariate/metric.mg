// Status: transport_required (bridges: hol_typedef_topology)
Theorem CLOSURE_OF_CLOSED_IN : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, closed_in A top s -> closure_of A top s = s.
Admitted.

