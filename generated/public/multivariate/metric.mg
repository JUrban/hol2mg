// Status: generalization_required (bridges: empty_case:B, hol_prod_setprod, hol_typedef_metric)
Theorem LIPSCHITZ_CONTINUOUS_MAP_CONST : forall A B:set, A <> Empty -> forall m1 :e metric A, forall m2 :e metric B, forall c :e B, lipschitz_continuous_map B A (m1,m2) (fun x:set => c) <-> mspace A m1 = Empty \/ c :e mspace B m2.
Admitted.

