Theorem PROPER_MAP_SND : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, proper_map (A :*: B) B (prod_topology A B top top',top') (fun x:set => x 1) <-> compact_space A top \/ topspace B top' = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:9409 / PROPER_MAP_INTO_SUBTOPOLOGY
// Source hash: md5:83a2a7920b67140e334799c110190c9a
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem PROPER_MAP_INTO_SUBTOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall c c= B, proper_map A B (top,top') f /\ {f x | x :e topspace A top} c= c -> proper_map A B (top,subtopology B top' c) f.
Admitted.

