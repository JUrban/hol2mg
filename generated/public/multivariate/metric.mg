// Status: generalization_required (bridges: empty_case:A, hol_num_omega, hol_typedef_topology, nat_le_SNoLe, nat_lt_SNoLt)
Theorem CHAIN_FROM_OPEN_COVER : forall A:set, forall top :e topology A, forall U c= Power A, forall a b :e A, connected_space A top /\ (a :e topspace A top /\ (b :e topspace A top /\ ((forall x :e A, x :e topspace A top -> exists u c= A, u :e U /\ x :e u) /\ (forall u c= A, u :e U -> u :e top)))) -> exists c :e Power A :^: omega, exists n :e omega, (forall i :e omega, i <= n -> c i :e U) /\ (a :e c 0 /\ (b :e c n /\ forall i :e omega, i < n -> ~ c i :/\: c (ordsucc i) = Empty)).
