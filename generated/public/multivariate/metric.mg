// Source hash: md5:3f1716dbdff73d66b4824e1aded64f07
// Status: transport_required (bridges: hol_num_omega, hol_typedef_net, nat_lt_SNoLt)
Theorem EVENTUALLY_NO_SUBSEQUENCE : forall P c= omega, eventually omega P sequentially <-> ~ exists r:set -> set, (forall x :e omega, r x :e omega) /\ ((forall m n :e omega, m < n -> r m < r n) /\ forall n :e omega, ~ r n :e P).
Admitted.

// HOL Light: Multivariate/metric.ml:10840 / EVENTUALLY_UBOUND_LE_SEQUENTIALLY
// Source hash: md5:bad70fb8482cc4d26ab6b6db05b0ff12
// Status: transport_required (bridges: hol_num_omega, hol_real_R, hol_typedef_net)
Theorem EVENTUALLY_UBOUND_LE_SEQUENTIALLY : forall f:set -> set, (forall x :e omega, f x :e R) -> ((exists b :e R, eventually omega {n :e omega | f n <= b} sequentially) <-> exists b :e R, forall n :e omega, f n <= b).
Admitted.

// HOL Light: Multivariate/metric.ml:10869 / EVENTUALLY_LBOUND_LE_SEQUENTIALLY
// Source hash: md5:3bf8ad456e2aef7840f0c857d92344f1
// Status: transport_required (bridges: hol_num_omega, hol_real_R, hol_typedef_net)
Theorem EVENTUALLY_LBOUND_LE_SEQUENTIALLY : forall f:set -> set, (forall x :e omega, f x :e R) -> ((exists b :e R, eventually omega {n :e omega | b <= f n} sequentially) <-> exists b :e R, forall n :e omega, b <= f n).
Admitted.

// HOL Light: Multivariate/metric.ml:10902 / fsigma_in
// Source hash: md5:70abcfcc84801852fcce3bdb45c787e1
// Status: transport_required (bridges: hol_countable, hol_typedef_topology)
Theorem fsigma_in_thm : forall A:set, A <> Empty -> forall top :e topology A, forall x c= A, x :e fsigma_in A top <-> exists u c= Power A, countable u /\ (forall x0 :e u, closed_in A top x0) /\ Union u = x.
Admitted.

// HOL Light: Multivariate/metric.ml:10905 / gdelta_in
// Source hash: md5:7e1fbfd3b6ecf147df810018b316290a
// Status: transport_required (bridges: hol_countable, hol_typedef_topology)
Theorem gdelta_in_thm : forall A:set, A <> Empty -> forall top :e topology A, gdelta_in A top = relative_to A {x :e Power A | exists u c= Power A, countable u /\ (forall x0 :e u, x0 :e top) /\ {x0 :e A | forall Y :e u, x0 :e Y} = x} (topspace A top).
Admitted.

// HOL Light: Multivariate/metric.ml:10909 / FSIGMA_IN_ASCENDING
// Source hash: md5:a5f65fc243cebea1db8d2936fcd7bd2f
// Status: transport_required (bridges: add_nat_add_SNo, hol_num_omega, hol_typedef_topology)
Theorem FSIGMA_IN_ASCENDING : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, s :e fsigma_in A top <-> exists c :e Power A :^: omega, (forall n :e omega, closed_in A top (c n)) /\ ((forall n :e omega, c n c= c (n + 1)) /\ Union {c n | n :e omega, n :e omega} = s).
Admitted.

// HOL Light: Multivariate/metric.ml:10919 / GDELTA_IN_ALT
// Source hash: md5:85bde63897abef6c2c378755c072b4a5
// Status: transport_required (bridges: hol_countable, hol_typedef_topology)
Theorem GDELTA_IN_ALT : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, s :e gdelta_in A top <-> s c= topspace A top /\ exists u c= Power A, countable u /\ (forall x :e u, x :e top) /\ {x :e A | forall Y :e u, x :e Y} = s.
Admitted.

