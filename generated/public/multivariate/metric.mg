// Status: transport_required (bridges: hol_typedef_metric, hol_typedef_topology)
Theorem T1_SPACE_MTOPOLOGY : forall A:set, A <> Empty -> forall m :e metric A, t1_space A (mtopology A m).
Admitted.

// HOL Light: Multivariate/metric.ml:12635 / discrete_metric
// Source hash: md5:bdc416d8208757b37ca3b03ab68a6703
// Status: generalization_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, omega_Subq_R)
Theorem discrete_metric_thm : forall A:set, A <> Empty -> forall s c= A, discrete_metric A s = (s,fun p :e A :*: A => if p 0 = p 1 then 0 else 1).
Admitted.

// HOL Light: Multivariate/metric.ml:12638 / DISCRETE_METRIC
// Source hash: md5:9ace00113208c399e73d8c348598b5f4
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_metric, omega_Subq_R)
Theorem DISCRETE_METRIC : forall A:set, A <> Empty -> (forall s c= A, mspace A (discrete_metric A s) = s) /\ forall s c= A, forall x y :e A, mdist A (discrete_metric A s) (x,y) = if x = y then 0 else 1.
Admitted.

// HOL Light: Multivariate/metric.ml:12650 / MTOPOLOGY_DISCRETE_METRIC
// Source hash: md5:41a3da05367993a6a59a22865fe32e1a
// Status: transport_required (bridges: hol_typedef_metric, hol_typedef_topology)
Theorem MTOPOLOGY_DISCRETE_METRIC : forall A:set, A <> Empty -> forall s c= A, mtopology A (discrete_metric A s) = discrete_topology A s.
Admitted.

// HOL Light: Multivariate/metric.ml:12660 / DISCRETE_ULTRAMETRIC
// Source hash: md5:90967860157ed874877ca1bd9bbaf64b
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_real_R, hol_typedef_metric)
Theorem DISCRETE_ULTRAMETRIC : forall A:set, forall s c= A, forall x y z :e A, mdist A (discrete_metric A s) (x,z) <= if mdist A (discrete_metric A s) (x,y) <= mdist A (discrete_metric A s) (y,z) then mdist A (discrete_metric A s) (y,z) else mdist A (discrete_metric A s) (x,y).
Admitted.

// HOL Light: Multivariate/metric.ml:12669 / MBOUNDED_DISCRETE_METRIC
// Source hash: md5:951e2b79dfc66544d104548b365d1ba4
// Status: transport_required (bridges: hol_typedef_metric)
Theorem MBOUNDED_DISCRETE_METRIC : forall A:set, A <> Empty -> forall u s c= A, mbounded A (discrete_metric A u) s <-> s c= u.
Admitted.

