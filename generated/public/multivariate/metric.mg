// Status: transport_required (bridges: hol_typedef_topology)
Theorem LOCALLY_COMPACT_SPACE_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u c= A, locally_compact_space A (discrete_topology A u).
Admitted.

// HOL Light: Multivariate/metric.ml:17049 / LOCALLY_COMPACT_SPACE_CONTINUOUS_OPEN_MAP_IMAGE
// Source hash: md5:932759b025ba33312ff9d438c70838ef
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem LOCALLY_COMPACT_SPACE_CONTINUOUS_OPEN_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> continuous_map A B (top,top') f /\ (open_map A B (top,top') f /\ ({f x | x :e topspace A top} = topspace B top' /\ locally_compact_space A top)) -> locally_compact_space B top'.
Admitted.

// HOL Light: Multivariate/metric.ml:17066 / LOCALLY_COMPACT_SUBSPACE_OPEN_IN_CLOSURE_OF
// Source hash: md5:12af53fe3f6d137a372f4b470c7d6825
// Status: transport_required (bridges: hol_typedef_topology)
Theorem LOCALLY_COMPACT_SUBSPACE_OPEN_IN_CLOSURE_OF : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, hausdorff_space A top /\ (s c= topspace A top /\ locally_compact_space A (subtopology A top s)) -> s :e subtopology A top (closure_of A top s).
Admitted.

// HOL Light: Multivariate/metric.ml:17092 / LOCALLY_COMPACT_SUBSPACE_CLOSED_INTER_OPEN_IN
// Source hash: md5:2afea38d4c2521dd74eeae7cad649bcd
// Status: transport_required (bridges: hol_typedef_topology)
Theorem LOCALLY_COMPACT_SUBSPACE_CLOSED_INTER_OPEN_IN : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, hausdorff_space A top /\ (s c= topspace A top /\ locally_compact_space A (subtopology A top s)) -> exists c u c= A, closed_in A top c /\ (u :e top /\ c :/\: u = s).
Admitted.

// HOL Light: Multivariate/metric.ml:17103 / LOCALLY_COMPACT_SUBSPACE_OPEN_IN_CLOSURE_OF_EQ
// Source hash: md5:71e2368ccb9c92175c76beab0647ca3e
// Status: transport_required (bridges: hol_typedef_topology)
Theorem LOCALLY_COMPACT_SUBSPACE_OPEN_IN_CLOSURE_OF_EQ : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, hausdorff_space A top /\ locally_compact_space A top -> (s :e subtopology A top (closure_of A top s) <-> s c= topspace A top /\ locally_compact_space A (subtopology A top s)).
Admitted.

// HOL Light: Multivariate/metric.ml:17123 / LOCALLY_COMPACT_SUBSPACE_CLOSED_INTER_OPEN_IN_EQ
// Source hash: md5:b65b5d52a7f567a372a3143493739b8d
// Status: transport_required (bridges: hol_typedef_topology)
Theorem LOCALLY_COMPACT_SUBSPACE_CLOSED_INTER_OPEN_IN_EQ : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, hausdorff_space A top /\ locally_compact_space A top -> ((exists c u c= A, closed_in A top c /\ (u :e top /\ c :/\: u = s)) <-> s c= topspace A top /\ locally_compact_space A (subtopology A top s)).
Admitted.

// HOL Light: Multivariate/metric.ml:17142 / DENSE_LOCALLY_COMPACT_OPEN_IN_HAUSDORFF_SPACE
// Source hash: md5:89fa1ab5c3fe33b29f5e4606c03c53a2
// Status: transport_required (bridges: hol_typedef_topology)
Theorem DENSE_LOCALLY_COMPACT_OPEN_IN_HAUSDORFF_SPACE : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, hausdorff_space A top /\ (s c= topspace A top /\ (closure_of A top s = topspace A top /\ locally_compact_space A (subtopology A top s))) -> s :e top.
Admitted.

// HOL Light: Multivariate/metric.ml:17154 / LOCALLY_COMPACT_SPACE_PROD_TOPOLOGY
// Source hash: md5:01c3a1f139145fb2e975c65ad51ae4a8
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem LOCALLY_COMPACT_SPACE_PROD_TOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, locally_compact_space (A :*: B) (prod_topology A B top1 top2) <-> topspace (A :*: B) (prod_topology A B top1 top2) = Empty \/ locally_compact_space A top1 /\ locally_compact_space B top2.
Admitted.

// HOL Light: Multivariate/metric.ml:17186 / LOCALLY_COMPACT_SPACE_PRODUCT_TOPOLOGY
// Source hash: md5:40409572953a939555580f3e40f2b4ab
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem LOCALLY_COMPACT_SPACE_PRODUCT_TOPOLOGY : forall A K:set, A <> Empty -> K <> Empty -> forall tops:set -> set, (forall x :e K, tops x :e topology A) -> forall k c= K, locally_compact_space (A :^: K) (product_topology A K k tops) <-> topspace (A :^: K) (product_topology A K k tops) = Empty \/ finite {i :e K | i :e k /\ ~ compact_space A (tops i)} /\ forall i :e K, i :e k -> locally_compact_space A (tops i).
Admitted.

// HOL Light: Multivariate/metric.ml:17278 / LOCALLY_COMPACT_SPACE_SUM_TOPOLOGY
// Source hash: md5:2eca66a885f9f8c3a0ea1d11ea0e9cd4
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
