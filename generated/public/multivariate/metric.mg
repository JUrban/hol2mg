// Status: transport_required (bridges: hol_typedef_topology)
Theorem CLOSURE_OF_CLOSURE_OF : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, closure_of A top (closure_of A top s) = closure_of A top s.
Admitted.

// HOL Light: Multivariate/metric.ml:1273 / CLOSURE_OF_HULL
