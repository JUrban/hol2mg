Theorem INTERIOR_OF_CLOSED_IN_UNION_EMPTY_INTERIOR_OF : forall A:set, forall top :e topology A, forall s t c= A, closed_in A top s /\ interior_of A top t = Empty -> interior_of A top (s :\/: t) = interior_of A top s.
Admitted.

