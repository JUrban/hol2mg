// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem QUOTIENT_MAP_PROD : forall A B C D:set, A <> Empty -> B <> Empty -> C <> Empty -> D <> Empty -> forall top1 :e topology A, forall top2 :e topology C, forall top1' :e topology B, forall top2' :e topology D, forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e C, g x :e D) -> (locally_compact_space A top1 /\ ((hausdorff_space A top1 \/ regular_space A top1) /\ (locally_compact_space D top2' /\ (hausdorff_space D top2' \/ regular_space D top2'))) \/ locally_compact_space B top1' /\ ((hausdorff_space B top1' \/ regular_space B top1') /\ (locally_compact_space C top2 /\ (hausdorff_space C top2 \/ regular_space C top2)))) /\ (quotient_map A B (top1,top1') f /\ quotient_map C D (top2,top2') g) -> quotient_map (A :*: C) (B :*: D) (prod_topology A C top1 top2,prod_topology B D top1' top2') (fun p:set => (f (p 0),g (p 1))).
Admitted.

