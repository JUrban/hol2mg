Theorem KOLMOGOROV_QUOTIENT_CONTINUOUS_MAP : forall A B:set, B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall x :e A, continuous_map A B (top,top') f /\ (t0_space B top' /\ x :e topspace A top) -> f (kolmogorov_quotient A top x) = f x.
Admitted.

