// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem OPEN_IN_CROSS : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, forall s c= A, forall t c= B, s :*: t :e prod_topology A B top1 top2 <-> s = Empty \/ (t = Empty \/ s :e top1 /\ t :e top2).
