// Status: transport_required (bridges: hol_typedef_topology)
Theorem CLOSURE_OF_ALT : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, closure_of A top s = topspace A top :/\: s :\/: derived_set_of A top s.
Admitted.

// HOL Light: Multivariate/metric.ml:1120 / DERIVED_SET_OF_SUBSET_CLOSURE_OF
// Source hash: md5:aba7c7a392354bbde67a163ab9709a10
// Status: transport_required (bridges: hol_typedef_topology)
Theorem DERIVED_SET_OF_SUBSET_CLOSURE_OF : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, derived_set_of A top s c= closure_of A top s.
