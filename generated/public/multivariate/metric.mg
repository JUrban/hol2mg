// Status: transport_required (bridges: hol_typedef_topology)
Theorem BOUNDARY_BUMPING_THEOREM_CLOSED : forall A:set, A <> Empty -> forall top :e topology A, forall s c c= A, connected_space A top /\ (compact_space A top /\ (hausdorff_space A top /\ (closed_in A top s /\ (~ s = topspace A top /\ c :e connected_components_of A (subtopology A top s))))) -> ~ c :/\: frontier_of A top s = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:27268 / INTERMEDIATE_CONTINUUM_EXISTS
// Source hash: md5:b76ef5b021bfe22010057a6cf3f49425
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem INTERMEDIATE_CONTINUUM_EXISTS : forall A:set, forall top :e topology A, forall c u c= A, connected_space A top /\ (locally_compact_space A top /\ (hausdorff_space A top /\ (compact_in A top c /\ (connected_in A top c /\ (~ c = Empty /\ (~ c = topspace A top /\ (u :e top /\ c c= u))))))) -> exists d c= A, compact_in A top d /\ (connected_in A top d /\ (c c= d /\ c <> d /\ (d c= u /\ d <> u))).
Admitted.

// HOL Light: Multivariate/metric.ml:27320 / BOUNDARY_BUMPING_THEOREM_GEN
// Source hash: md5:3cd6697bbde546a1b4a38545bc634d4c
// Status: transport_required (bridges: hol_typedef_topology)
Theorem BOUNDARY_BUMPING_THEOREM_GEN : forall A:set, A <> Empty -> forall top :e topology A, forall s c c= A, connected_space A top /\ (locally_compact_space A top /\ (hausdorff_space A top /\ (s c= topspace A top /\ s <> topspace A top /\ (c :e connected_components_of A (subtopology A top s) /\ compact_in A top (closure_of A top c))))) -> ~ frontier_of A top c :/\: frontier_of A top s = Empty.
Admitted.

