Theorem CLOSED_IN_HAUSDORFF_SING : forall A:set, forall top :e topology A, forall x :e A, hausdorff_space A top /\ x :e topspace A top -> closed_in A top {x}.
Admitted.

// HOL Light: Multivariate/metric.ml:8188 / CLOSED_IN_HAUSDORFF_SING_EQ
// Source hash: md5:de9c3f20f1d659c4f0601296979301e1
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem CLOSED_IN_HAUSDORFF_SING_EQ : forall A:set, forall top :e topology A, forall x :e A, hausdorff_space A top -> (closed_in A top {x} <-> x :e topspace A top).
Admitted.

// HOL Light: Multivariate/metric.ml:8194 / HAUSDORFF_SPACE_DISCRETE_TOPOLOGY
// Source hash: md5:0b6c6e686b1fc6f99af48f0d25949e67
// Status: transport_required (bridges: hol_typedef_topology)
Theorem HAUSDORFF_SPACE_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u c= A, hausdorff_space A (discrete_topology A u).
Admitted.

// HOL Light: Multivariate/metric.ml:8201 / COMPACT_IN_INTER
// Source hash: md5:957ae0c17e00a77fd96e11f906fef16d
// Status: transport_required (bridges: hol_typedef_topology)
Theorem COMPACT_IN_INTER : forall A:set, A <> Empty -> forall top :e topology A, forall s t c= A, hausdorff_space A top /\ (compact_in A top s /\ compact_in A top t) -> compact_in A top (s :/\: t).
Admitted.

// HOL Light: Multivariate/metric.ml:8207 / FINITE_TOPSPACE_IMP_DISCRETE_TOPOLOGY
// Source hash: md5:0b441a9d7d1a73db040e9d918915f360
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem FINITE_TOPSPACE_IMP_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u c= A, forall top :e topology A, topspace A top = u /\ (finite u /\ hausdorff_space A top) -> top = discrete_topology A u.
Admitted.

// HOL Light: Multivariate/metric.ml:8214 / DERIVED_SET_OF_FINITE
// Source hash: md5:6a58f3307cfad663ed80d0ceccc56980
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem DERIVED_SET_OF_FINITE : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, hausdorff_space A top /\ finite s -> derived_set_of A top s = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:8219 / DERIVED_SET_OF_SING
// Source hash: md5:0b25e7e61f6ac261c6cd83eecc9c2d97
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem DERIVED_SET_OF_SING : forall A:set, forall top :e topology A, forall x :e A, hausdorff_space A top -> derived_set_of A top {x} = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:8223 / CLOSED_IN_HAUSDORFF_FINITE
// Source hash: md5:75b4740636259557f4afa27bfe5bb07a
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem CLOSED_IN_HAUSDORFF_FINITE : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, hausdorff_space A top /\ (s c= topspace A top /\ finite s) -> closed_in A top s.
Admitted.

// HOL Light: Multivariate/metric.ml:8229 / OPEN_IN_HAUSDORFF_DELETE
// Source hash: md5:4566ad61b2cff6df49892eee7d8dad64
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem OPEN_IN_HAUSDORFF_DELETE : forall A:set, forall top :e topology A, forall s c= A, forall x :e A, hausdorff_space A top /\ s :e top -> s :\: {x} :e top.
Admitted.

// HOL Light: Multivariate/metric.ml:8234 / CLOSED_IN_HAUSDORFF_FINITE_EQ
// Source hash: md5:e158494f89696766713a177b6e7a5cbf
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem CLOSED_IN_HAUSDORFF_FINITE_EQ : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, hausdorff_space A top /\ finite s -> (closed_in A top s <-> s c= topspace A top).
Admitted.

// HOL Light: Multivariate/metric.ml:8240 / DERIVED_SET_OF_INFINITE_OPEN_IN
// Source hash: md5:877c167607ec665540594d4ce675e5ea
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem DERIVED_SET_OF_INFINITE_OPEN_IN : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, hausdorff_space A top -> derived_set_of A top s = {x :e A | x :e topspace A top /\ forall u c= A, x :e u /\ u :e top -> infinite (s :/\: u)}.
Admitted.

// HOL Light: Multivariate/metric.ml:8250 / HAUSDORFF_SPACE_DISCRETE_COMPACT_IN
// Source hash: md5:be453f813f891987cbffb0b3b983c327
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem HAUSDORFF_SPACE_DISCRETE_COMPACT_IN : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, hausdorff_space A top -> (s :/\: derived_set_of A top s = Empty /\ compact_in A top s <-> s c= topspace A top /\ finite s).
Admitted.

// HOL Light: Multivariate/metric.ml:8265 / HAUSDORFF_SPACE_FINITE_TOPSPACE
// Source hash: md5:f30130d8617073affcca97bbafd1df17
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem HAUSDORFF_SPACE_FINITE_TOPSPACE : forall A:set, A <> Empty -> forall top :e topology A, hausdorff_space A top -> (derived_set_of A top (topspace A top) = Empty /\ compact_space A top <-> finite (topspace A top)).
Admitted.

// HOL Light: Multivariate/metric.ml:8277 / DERIVED_SET_OF_DERIVED_SET_SUBSET
// Source hash: md5:0fd252c1e14b7ac4f86e69c4c3569ce6
// Status: transport_required (bridges: hol_typedef_topology)
Theorem DERIVED_SET_OF_DERIVED_SET_SUBSET : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, hausdorff_space A top -> derived_set_of A top (derived_set_of A top s) c= derived_set_of A top s.
Admitted.

// HOL Light: Multivariate/metric.ml:8285 / HAUSDORFF_SPACE_INJECTIVE_PREIMAGE
// Source hash: md5:e993d2beb3d0542268deabe4d1817c8a
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HAUSDORFF_SPACE_INJECTIVE_PREIMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> continuous_map A B (top,top') f /\ ((forall x y :e A, x :e topspace A top /\ (y :e topspace A top /\ f x = f y) -> x = y) /\ hausdorff_space B top') -> hausdorff_space A top.
Admitted.

// HOL Light: Multivariate/metric.ml:8302 / HOMEOMORPHIC_HAUSDORFF_SPACE
// Source hash: md5:01c7f570f6558e9dc76098d7957bb8b8
// Status: transport_required (bridges: hol_typedef_topology)
Theorem HOMEOMORPHIC_HAUSDORFF_SPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, homeomorphic_space A B top top' -> (hausdorff_space A top <-> hausdorff_space B top').
Admitted.

// HOL Light: Multivariate/metric.ml:8314 / HAUSDORFF_SPACE_RETRACTION_MAP_IMAGE
// Source hash: md5:28263152e024ff49a58aa8b570c84ec1
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HAUSDORFF_SPACE_RETRACTION_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall r:set -> set, (forall x :e A, r x :e B) -> retraction_map A B (top,top') r /\ hausdorff_space A top -> hausdorff_space B top'.
Admitted.

// HOL Light: Multivariate/metric.ml:8321 / COMPACT_HAUSDORFF_SPACE_OPTIMAL
// Source hash: md5:2dbce23e33e97a51ea3c55dc7bdf9c73
// Status: transport_required (bridges: hol_typedef_topology)
Theorem COMPACT_HAUSDORFF_SPACE_OPTIMAL : forall A:set, A <> Empty -> forall top top' :e topology A, topspace A top' = topspace A top /\ ((forall u c= A, u :e top -> u :e top') /\ (hausdorff_space A top /\ compact_space A top')) -> top' = top.
Admitted.

// HOL Light: Multivariate/metric.ml:8338 / CONTINUOUS_IMP_CLOSED_MAP
// Source hash: md5:a99d42e46b1be35d7fac930aca49c7ed
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_IMP_CLOSED_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> compact_space A top /\ (hausdorff_space B top' /\ continuous_map A B (top,top') f) -> closed_map A B (top,top') f.
Admitted.

// HOL Light: Multivariate/metric.ml:8347 / CONTINUOUS_IMP_QUOTIENT_MAP
// Source hash: md5:29f8b321418bfa7377b638ffeeebc638
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_IMP_QUOTIENT_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> compact_space A top /\ (hausdorff_space B top' /\ (continuous_map A B (top,top') f /\ {f x | x :e topspace A top} = topspace B top')) -> quotient_map A B (top,top') f.
Admitted.

// HOL Light: Multivariate/metric.ml:8355 / CONTINUOUS_IMP_HOMEOMORPHIC_MAP
// Source hash: md5:2da423d66ef1358aafd0caf081f86b3c
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_IMP_HOMEOMORPHIC_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> compact_space A top /\ (hausdorff_space B top' /\ (continuous_map A B (top,top') f /\ ({f x | x :e topspace A top} = topspace B top' /\ (forall x y :e A, x :e topspace A top /\ y :e topspace A top -> (f x = f y <-> x = y))))) -> homeomorphic_map A B (top,top') f.
Admitted.

// HOL Light: Multivariate/metric.ml:8365 / CONTINUOUS_IMP_EMBEDDING_MAP
// Source hash: md5:17f15a110563b4e485656d15e7f696e9
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_IMP_EMBEDDING_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> compact_space A top /\ (hausdorff_space B top' /\ (continuous_map A B (top,top') f /\ (forall x y :e A, x :e topspace A top /\ y :e topspace A top -> (f x = f y <-> x = y)))) -> embedding_map A B (top,top') f.
Admitted.

// HOL Light: Multivariate/metric.ml:8380 / CONTINUOUS_INVERSE_MAP
// Source hash: md5:46fb8785302bab5155b6a8d0b17961bb
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_INVERSE_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e B, g x :e A) -> forall s c= B, compact_space A top /\ (hausdorff_space B top' /\ (continuous_map A B (top,top') f /\ ((forall x :e A, x :e topspace A top -> g (f x) = x) /\ s c= {f x | x :e topspace A top}))) -> continuous_map B A (subtopology B top' s,top) g.
Admitted.

// HOL Light: Multivariate/metric.ml:8404 / HAUSDORFF_SPACE_PROD_TOPOLOGY
// Source hash: md5:f30e48ac8a57433aa0fdff10e1bcd769
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HAUSDORFF_SPACE_PROD_TOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, hausdorff_space (A :*: B) (prod_topology A B top1 top2) <-> topspace (A :*: B) (prod_topology A B top1 top2) = Empty \/ hausdorff_space A top1 /\ hausdorff_space B top2.
Admitted.

// HOL Light: Multivariate/metric.ml:8439 / HAUSDORFF_SPACE_PRODUCT_TOPOLOGY
// Source hash: md5:83769ecbac42f2b2217c4ea95f842afa
// Status: transport_required (bridges: hol_typedef_topology)
Theorem HAUSDORFF_SPACE_PRODUCT_TOPOLOGY : forall A K:set, A <> Empty -> K <> Empty -> forall tops:set -> set, (forall x :e K, tops x :e topology A) -> forall k c= K, hausdorff_space (A :^: K) (product_topology A K k tops) <-> topspace (A :^: K) (product_topology A K k tops) = Empty \/ forall i :e K, i :e k -> hausdorff_space A (tops i).
Admitted.

// HOL Light: Multivariate/metric.ml:8482 / HAUSDORFF_SPACE_CLOSED_NEIGHBOURHOOD
// Source hash: md5:701c7809ba6365ce01b1370c2b49022d
// Status: transport_required (bridges: hol_typedef_topology)
Theorem HAUSDORFF_SPACE_CLOSED_NEIGHBOURHOOD : forall A:set, A <> Empty -> forall top :e topology A, hausdorff_space A top <-> forall x :e A, x :e topspace A top -> exists u c c= A, u :e top /\ (closed_in A top c /\ (hausdorff_space A (subtopology A top c) /\ (x :e u /\ u c= c))).
Admitted.

// HOL Light: Multivariate/metric.ml:8516 / INFINITE_PERFECT_SET
// Source hash: md5:bea841f8d77e8e821c4a34f195869eec
// Status: generalization_required (bridges: empty_case:A, hol_finite_finite, hol_typedef_topology)
Theorem INFINITE_PERFECT_SET : forall A:set, forall top :e topology A, forall s c= A, hausdorff_space A top /\ (s c= derived_set_of A top s /\ ~ s = Empty) -> infinite s.
Admitted.

// HOL Light: Multivariate/metric.ml:8526 / HAUSDORFF_SPACE_CLOSED_IN_DIAGONAL
// Source hash: md5:c3c1cb4f562fc6ef04aae7956c682cc6
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HAUSDORFF_SPACE_CLOSED_IN_DIAGONAL : forall A:set, A <> Empty -> forall top :e topology A, hausdorff_space A top <-> closed_in (A :*: A) (prod_topology A A top top) {(x,x) | x :e A, x :e topspace A top}.
Admitted.

// HOL Light: Multivariate/metric.ml:8541 / CLOSED_MAP_DIAG_EQ
// Source hash: md5:65e600e47b72a5192e9b16228ed5247d
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CLOSED_MAP_DIAG_EQ : forall A:set, A <> Empty -> forall top :e topology A, closed_map A (A :*: A) (top,prod_topology A A top top) (fun x:set => (x,x)) <-> hausdorff_space A top.
Admitted.

// HOL Light: Multivariate/metric.ml:8555 / CLOSED_IN_CONTINUOUS_MAPS_EQ
// Source hash: md5:efa4618f30e91802fa650f24f0b321ac
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CLOSED_IN_CONTINUOUS_MAPS_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e A, g x :e B) -> forall top :e topology A, forall top' :e topology B, hausdorff_space B top' /\ (continuous_map A B (top,top') f /\ continuous_map A B (top,top') g) -> closed_in A top {x :e A | x :e topspace A top /\ f x = g x}.
Admitted.

// HOL Light: Multivariate/metric.ml:8573 / FORALL_IN_CLOSURE_OF_EQ
// Source hash: md5:0b80957d5b12a98e728cdfa6afb28a6d
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_typedef_topology)
Theorem FORALL_IN_CLOSURE_OF_EQ : forall A B:set, B <> Empty -> forall s c= A, forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e A, g x :e B) -> hausdorff_space B top' /\ (continuous_map A B (top,top') f /\ (continuous_map A B (top,top') g /\ (forall x :e A, x :e s -> f x = g x))) -> forall x :e A, x :e closure_of A top s -> f x = g x.
Admitted.

// HOL Light: Multivariate/metric.ml:8592 / RETRACT_OF_SPACE_IMP_CLOSED_IN
// Source hash: md5:93231f36df58256ef2220bda6298443b
// Status: transport_required (bridges: hol_typedef_topology)
Theorem RETRACT_OF_SPACE_IMP_CLOSED_IN : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, hausdorff_space A top /\ retract_of_space A s top -> closed_in A top s.
Admitted.

// HOL Light: Multivariate/metric.ml:8603 / WEAKLY_HEREDITARY_IMP_RETRACTIVE_PROPERTY
// Source hash: md5:9c4dd5540fb94677b4c01eee5808c384
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem WEAKLY_HEREDITARY_IMP_RETRACTIVE_PROPERTY : forall A B:set, A <> Empty -> B <> Empty -> forall P Q:set -> prop, (forall top :e topology A, P top -> hausdorff_space A top) /\ ((forall top :e topology A, forall s c= A, P top /\ closed_in A top s -> P (subtopology A top s)) /\ (forall top :e topology A, forall top' :e topology B, homeomorphic_space A B top top' -> (P top <-> Q top'))) -> forall top :e topology A, forall top' :e topology B, forall r:set -> set, (forall x :e A, r x :e B) -> retraction_map A B (top,top') r /\ P top -> Q top'.
Admitted.

// HOL Light: Multivariate/metric.ml:8621 / HOMEOMORPHIC_MAPS_GRAPH
// Source hash: md5:c54fa9b40d7cbc6931100c8973f2244f
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HOMEOMORPHIC_MAPS_GRAPH : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> (homeomorphic_maps A (A :*: B) (top,subtopology (A :*: B) (prod_topology A B top top') {(x,f x) | x :e topspace A top}) (fun x :e A => (x,f x),fun x :e A :*: B => x 0) <-> continuous_map A B (top,top') f).
Admitted.

// HOL Light: Multivariate/metric.ml:8642 / EMBEDDING_MAP_GRAPH
// Source hash: md5:0c7c418bddeea8fdcfe2d727a802853d
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem EMBEDDING_MAP_GRAPH : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> (embedding_map A (A :*: B) (top,prod_topology A B top top') (fun x:set => (x,f x)) <-> continuous_map A B (top,top') f).
Admitted.

// HOL Light: Multivariate/metric.ml:8655 / CONTINUOUS_MAP_IMP_CLOSED_GRAPH
// Source hash: md5:cb072b58cd2cba179bd1f43c229474d7
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem CONTINUOUS_MAP_IMP_CLOSED_GRAPH : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> continuous_map A B (top,top') f /\ hausdorff_space B top' -> closed_in (A :*: B) (prod_topology A B top top') {(x,f x) | x :e A, x :e topspace A top}.
Admitted.

