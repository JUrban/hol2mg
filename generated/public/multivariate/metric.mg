// HOL Light: Multivariate/metric.ml:22295 / PATH_CONNECTED_SPACE_SUBCONNECTED
// Source hash: md5:b389e5b6c2bcdcba13bb1d29ddb975fe
// Status: transport_required (bridges: hol_typedef_topology)
Theorem PATH_CONNECTED_SPACE_SUBCONNECTED : forall A:set, A <> Empty -> forall top :e topology A, path_connected_space A top <-> forall x y :e A, x :e topspace A top /\ y :e topspace A top -> exists s c= A, path_connected_in A top s /\ (x :e s /\ y :e s).
Admitted.

// HOL Light: Multivariate/metric.ml:22316 / PATH_CONNECTED_IN_EUCLIDEANREAL
