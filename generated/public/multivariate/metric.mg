// HOL Light: Multivariate/metric.ml:39711 / METRIC_COMPLETION_EXPLICIT
// Source hash: md5:cb3de891df94de66caf141fe8a433253
// Status: transport_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_topology)
Theorem METRIC_COMPLETION_EXPLICIT : forall A:set, A <> Empty -> forall m :e metric A, exists s c= R :^: A, exists f :e R :^: A :^: A, s c= mspace (R :^: A) (funspace A R (mspace A m) real_euclidean_metric) /\ (mcomplete (R :^: A) (submetric (R :^: A) (funspace A R (mspace A m) real_euclidean_metric) s) /\ ({f x | x :e mspace A m} c= s /\ (closure_of (R :^: A) (mtopology (R :^: A) (funspace A R (mspace A m) real_euclidean_metric)) {f x | x :e mspace A m} = s /\ forall x y :e A, x :e mspace A m /\ y :e mspace A m -> mdist (R :^: A) (funspace A R (mspace A m) real_euclidean_metric) (f x,f y) = mdist A m (x,y)))).
Admitted.

// HOL Light: Multivariate/metric.ml:39768 / METRIC_COMPLETION
// Source hash: md5:5850fb3040201fb0bffbe2414f2fcd42
// Status: transport_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_metric, hol_typedef_topology)
Theorem METRIC_COMPLETION : forall A:set, A <> Empty -> forall m :e metric A, exists m' :e metric (R :^: A), exists f :e R :^: A :^: A, mcomplete (R :^: A) m' /\ ({f x | x :e mspace A m} c= mspace (R :^: A) m' /\ (closure_of (R :^: A) (mtopology (R :^: A) m') {f x | x :e mspace A m} = mspace (R :^: A) m' /\ forall x y :e A, x :e mspace A m /\ y :e mspace A m -> mdist (R :^: A) m' (f x,f y) = mdist A m (x,y))).
Admitted.

// HOL Light: Multivariate/metric.ml:39786 / METRIZABLE_SPACE_COMPLETION
// Source hash: md5:ed236c2315797748c64584a73a6807ad
// Status: transport_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_topology)
Theorem METRIZABLE_SPACE_COMPLETION : forall A:set, A <> Empty -> forall top :e topology A, metrizable_space A top -> exists top' :e topology (R :^: A), exists f :e R :^: A :^: A, completely_metrizable_space (R :^: A) top' /\ (embedding_map A (R :^: A) (top,top') (fun x:set => f x) /\ closure_of (R :^: A) top' {f x | x :e topspace A top} = topspace (R :^: A) top').
Admitted.

// HOL Light: Multivariate/metric.ml:39804 / METRIC_BAIRE_CATEGORY
// Source hash: md5:c11cf562dbebf27127c83ba1d57d97aa
// Status: transport_required (bridges: hol_countable, hol_typedef_metric, hol_typedef_topology)
Theorem METRIC_BAIRE_CATEGORY : forall A:set, A <> Empty -> forall m :e metric A, forall g c= Power A, mcomplete A m /\ (countable g /\ (forall t c= A, t :e g -> t :e mtopology A m /\ closure_of A (mtopology A m) t = mspace A m)) -> closure_of A (mtopology A m) {x :e A | forall Y :e g, x :e Y} = mspace A m.
Admitted.

// HOL Light: Multivariate/metric.ml:39980 / METRIC_BAIRE_CATEGORY_ALT
// Source hash: md5:5fd698cc1a2a98fd263bebd50dbf7e77
// Status: transport_required (bridges: hol_countable, hol_typedef_metric, hol_typedef_topology)
Theorem METRIC_BAIRE_CATEGORY_ALT : forall A:set, A <> Empty -> forall m :e metric A, forall g c= Power A, mcomplete A m /\ (countable g /\ (forall t c= A, t :e g -> closed_in A (mtopology A m) t /\ interior_of A (mtopology A m) t = Empty)) -> interior_of A (mtopology A m) (Union g) = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:40006 / BAIRE_CATEGORY_ALT
// Source hash: md5:023ff5b0d1cee5232b2e4b12a7070dab
// Status: transport_required (bridges: hol_countable, hol_typedef_topology)
Theorem BAIRE_CATEGORY_ALT : forall A:set, A <> Empty -> forall top :e topology A, forall g c= Power A, (completely_metrizable_space A top \/ locally_compact_space A top /\ (hausdorff_space A top \/ regular_space A top)) /\ (countable g /\ (forall t c= A, t :e g -> closed_in A top t /\ interior_of A top t = Empty)) -> interior_of A top (Union g) = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:40105 / BAIRE_CATEGORY
// Source hash: md5:8ca4b7829c08f67802f61a966debeb7a
// Status: transport_required (bridges: hol_countable, hol_typedef_topology)
Theorem BAIRE_CATEGORY : forall A:set, A <> Empty -> forall top :e topology A, forall g c= Power A, (completely_metrizable_space A top \/ locally_compact_space A top /\ (hausdorff_space A top \/ regular_space A top)) /\ (countable g /\ (forall t c= A, t :e g -> t :e top /\ closure_of A top t = topspace A top)) -> closure_of A top {x :e A | forall Y :e g, x :e Y} = topspace A top.
Admitted.

// HOL Light: Multivariate/metric.ml:40143 / LOCALLY_CONNECTED_NOT_COUNTABLE_CLOSED_UNION
// Source hash: md5:f8237a15049dc09d2b60c67a468045f7
// Status: transport_required (bridges: hol_countable, hol_typedef_topology)
Theorem LOCALLY_CONNECTED_NOT_COUNTABLE_CLOSED_UNION : forall A:set, A <> Empty -> forall top :e topology A, forall u c= Power A, ~ topspace A top = Empty /\ (connected_space A top /\ (locally_connected_space A top /\ ((completely_metrizable_space A top \/ locally_compact_space A top /\ hausdorff_space A top) /\ (countable u /\ ((forall x y :e u, x <> y -> x :/\: y = Empty) /\ ((forall c c= A, c :e u -> closed_in A top c /\ ~ c = Empty) /\ Union u = topspace A top)))))) -> u = {topspace A top}.
Admitted.

// HOL Light: Multivariate/metric.ml:40277 / REAL_SIERPINSKI_LEMMA
// Source hash: md5:1c6d709be9d74633220f755f78858ffa
// Status: transport_required (bridges: hol_countable, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem REAL_SIERPINSKI_LEMMA : forall a b :e R, forall u c= Power R, a <= b /\ (countable u /\ ((forall x y :e u, x <> y -> x :/\: y = Empty) /\ ((forall c c= R, c :e u -> real_closed c /\ ~ c = Empty) /\ Union u = closed_real_interval (seq_cons (a,b) seq_nil)))) -> u = {closed_real_interval (seq_cons (a,b) seq_nil)}.
Admitted.

