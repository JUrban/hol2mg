// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem OPEN_MAP_PREIMAGE_NEIGHBOURHOOD : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> (open_map A B (top,top') f <-> {f x | x :e topspace A top} c= topspace B top' /\ forall u c= A, forall t c= B, closed_in A top u /\ (t c= topspace B top' /\ {x :e A | x :e topspace A top /\ f x :e t} c= u) -> exists v c= B, closed_in B top' v /\ (t c= v /\ {x :e A | x :e topspace A top /\ f x :e v} c= u)).
Admitted.

