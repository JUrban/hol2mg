// Source hash: md5:d0f6da62b2de0bf4286014eb402b3a08
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem DEFORMATION_RETRACTION_IMP_HOMOTOPY_EQUIVALENT_SPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall r :e B :^: A, forall s :e A :^: B, homotopic_with A A {x :e A :^: A | True} (top,top) (fun x:set => s (r x)) (fun x:set => x) /\ retraction_maps A B (top,top') (r,s) -> homotopy_equivalent_space A B top top'.
Admitted.

// HOL Light: Multivariate/metric.ml:29478 / DEFORMATION_RETRACT_IMP_HOMOTOPY_EQUIVALENT_SPACE
// Source hash: md5:88e9c140e4c83499545f457c48a2c85a
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem DEFORMATION_RETRACT_IMP_HOMOTOPY_EQUIVALENT_SPACE : forall A:set, A <> Empty -> forall top top' :e topology A, forall r :e A :^: A, homotopic_with A A {x :e A :^: A | True} (top,top) (fun x:set => r x) (fun x:set => x) /\ retraction_maps A A (top,top') (r,fun x :e A => x) -> homotopy_equivalent_space A A top top'.
Admitted.

// HOL Light: Multivariate/metric.ml:29488 / DEFORMATION_RETRACT_OF_SPACE
// Source hash: md5:5d735b1d57eecd93da7c1f3dc899be75
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem DEFORMATION_RETRACT_OF_SPACE : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, s c= topspace A top /\ (exists r :e A :^: A, homotopic_with A A {x :e A :^: A | True} (top,top) (fun x:set => x) (fun x:set => r x) /\ retraction_maps A A (top,subtopology A top s) (r,fun x :e A => x)) <-> retract_of_space A s top /\ exists f:set -> set, (forall x :e A, f x :e A) /\ (homotopic_with A A {x :e A :^: A | True} (top,top) (fun x:set => x) f /\ {f x | x :e topspace A top} c= s).
Admitted.

