// Source hash: md5:52a16df3cd3049c2d5b6d500225dfbe2
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem PATH_CONNECTED_IN_UNION : forall A:set, forall top :e topology A, forall s t c= A, path_connected_in A top s /\ (path_connected_in A top t /\ ~ s :/\: t = Empty) -> path_connected_in A top (s :\/: t).
Admitted.

// HOL Light: Multivariate/metric.ml:22768 / PATH_CONNECTED_SPACE_IFF_COMPONENTS_EQ
// Source hash: md5:212ccfac8e5e9b9ca68acd0fca1b50cc
// Status: transport_required (bridges: hol_typedef_topology)
Theorem PATH_CONNECTED_SPACE_IFF_COMPONENTS_EQ : forall A:set, A <> Empty -> forall top :e topology A, path_connected_space A top <-> forall c c' c= A, c :e path_components_of A top /\ c' :e path_components_of A top -> c = c'.
Admitted.

// HOL Light: Multivariate/metric.ml:22778 / PATH_COMPONENTS_OF_EQ_EMPTY
// Source hash: md5:d6d0bb325667b2053b939a12f3d0cd7e
// Status: transport_required (bridges: hol_typedef_topology)
Theorem PATH_COMPONENTS_OF_EQ_EMPTY : forall A:set, A <> Empty -> forall top :e topology A, path_components_of A top = Empty <-> topspace A top = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:22782 / PATH_COMPONENTS_OF_EMPTY_SPACE
// Source hash: md5:9c27fede1dbd35922efcdde313302eb8
// Status: transport_required (bridges: hol_typedef_topology)
Theorem PATH_COMPONENTS_OF_EMPTY_SPACE : forall A:set, A <> Empty -> forall top :e topology A, topspace A top = Empty -> path_components_of A top = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:22786 / PATH_COMPONENTS_OF_SUBSET_SING
// Source hash: md5:ef800341c0d09eed63336decdbc7fcf9
// Status: transport_required (bridges: hol_typedef_topology)
Theorem PATH_COMPONENTS_OF_SUBSET_SING : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, path_components_of A top c= {s} <-> path_connected_space A top /\ (topspace A top = Empty \/ topspace A top = s).
Admitted.

// HOL Light: Multivariate/metric.ml:22799 / PATH_CONNECTED_SPACE_IFF_COMPONENTS_SUBSET_SING
// Source hash: md5:ac39c2c32dc9e9739e2be6e4eff6d450
// Status: transport_required (bridges: hol_typedef_topology)
Theorem PATH_CONNECTED_SPACE_IFF_COMPONENTS_SUBSET_SING : forall A:set, A <> Empty -> forall top :e topology A, path_connected_space A top <-> exists a c= A, path_components_of A top c= {a}.
Admitted.

// HOL Light: Multivariate/metric.ml:22804 / PATH_COMPONENTS_OF_EQ_SING
// Source hash: md5:0b1f073bf48ca971f402cd18bb4c2e94
// Status: transport_required (bridges: hol_typedef_topology)
Theorem PATH_COMPONENTS_OF_EQ_SING : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, path_components_of A top = {s} <-> path_connected_space A top /\ (~ topspace A top = Empty /\ s = topspace A top).
Admitted.

// HOL Light: Multivariate/metric.ml:22813 / PATH_COMPONENTS_OF_PATH_CONNECTED_SPACE
// Source hash: md5:aff754317d324eb96403c54598a36019
// Status: transport_required (bridges: hol_typedef_topology)
Theorem PATH_COMPONENTS_OF_PATH_CONNECTED_SPACE : forall A:set, A <> Empty -> forall top :e topology A, path_connected_space A top -> path_components_of A top = if topspace A top = Empty then Empty else {topspace A top}.
Admitted.

// HOL Light: Multivariate/metric.ml:22821 / PATH_COMPONENT_SUBSET_CONNECTED_COMPONENT_OF
// Source hash: md5:636fd38c8f839a6d93035aa4de07f007
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem PATH_COMPONENT_SUBSET_CONNECTED_COMPONENT_OF : forall A:set, forall top :e topology A, forall x :e A, {x0 :e A | path_component_of A top x x0} c= {x0 :e A | connected_component_of A top x x0}.
Admitted.

// HOL Light: Multivariate/metric.ml:22830 / PATH_IMP_CONNECTED_COMPONENT_OF
// Source hash: md5:a17e8c2562a411a1e4312c91c1f2231d
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem PATH_IMP_CONNECTED_COMPONENT_OF : forall A:set, forall top :e topology A, forall x y :e A, path_component_of A top x y -> connected_component_of A top x y.
Admitted.

// HOL Light: Multivariate/metric.ml:22836 / EXISTS_PATH_COMPONENT_OF_SUPERSET
// Source hash: md5:d6f1c520b5979b44e5e134ee051d4073
// Status: transport_required (bridges: hol_typedef_topology)
Theorem EXISTS_PATH_COMPONENT_OF_SUPERSET : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, path_connected_in A top s /\ ~ topspace A top = Empty -> exists c c= A, c :e path_components_of A top /\ s c= c.
Admitted.

// HOL Light: Multivariate/metric.ml:22852 / PATH_COMPONENT_OF_EQ_OVERLAP
// Source hash: md5:0759d0c26397da293215c1fe475041f8
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem PATH_COMPONENT_OF_EQ_OVERLAP : forall A:set, forall top :e topology A, forall x y :e A, (forall x0 :e A, path_component_of A top x x0 <-> path_component_of A top y x0) <-> ~ x :e topspace A top /\ ~ y :e topspace A top \/ ~ {x0 :e A | path_component_of A top x x0} :/\: {x0 :e A | path_component_of A top y x0} = Empty.
Admitted.

// HOL Light: Multivariate/metric.ml:22861 / PATH_COMPONENT_OF_NONOVERLAP
// Source hash: md5:81af5bbe7ec99b2ef05fc8eb6089f055
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem PATH_COMPONENT_OF_NONOVERLAP : forall A:set, forall top :e topology A, forall x y :e A, {x0 :e A | path_component_of A top x x0} :/\: {x0 :e A | path_component_of A top y x0} = Empty <-> ~ x :e topspace A top \/ (~ y :e topspace A top \/ ~ forall x0 :e A, path_component_of A top x x0 <-> path_component_of A top y x0).
Admitted.

// HOL Light: Multivariate/metric.ml:22870 / PATH_COMPONENT_OF_OVERLAP
// Source hash: md5:181d8b5731a3d0e95cd114c3b04ad799
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem PATH_COMPONENT_OF_OVERLAP : forall A:set, forall top :e topology A, forall x y :e A, ~ {x0 :e A | path_component_of A top x x0} :/\: {x0 :e A | path_component_of A top y x0} = Empty <-> x :e topspace A top /\ (y :e topspace A top /\ forall x0 :e A, path_component_of A top x x0 <-> path_component_of A top y x0).
Admitted.

// HOL Light: Multivariate/metric.ml:22879 / PATH_COMPONENTS_OF_DISJOINT
// Source hash: md5:a36fc0a376e633149891b5086cec22a8
// Status: transport_required (bridges: hol_typedef_topology)
Theorem PATH_COMPONENTS_OF_DISJOINT : forall A:set, A <> Empty -> forall top :e topology A, forall c c' c= A, c :e path_components_of A top /\ c' :e path_components_of A top -> (c :/\: c' = Empty <-> ~ c = c').
Admitted.

// HOL Light: Multivariate/metric.ml:22886 / PATH_COMPONENTS_OF_OVERLAP
// Source hash: md5:c0251c3e828887eb42fbe565b5cc7c3d
// Status: transport_required (bridges: hol_typedef_topology)
Theorem PATH_COMPONENTS_OF_OVERLAP : forall A:set, A <> Empty -> forall top :e topology A, forall c c' c= A, c :e path_components_of A top /\ c' :e path_components_of A top -> (~ c :/\: c' = Empty <-> c = c').
Admitted.

// HOL Light: Multivariate/metric.ml:22893 / CARD_LE_PATH_COMPONENTS_OF_TOPSPACE
// Source hash: md5:b53f3a3d439aec6805ce18ec3e3314cb
// Status: transport_required (bridges: hol_le_c_atleastp, hol_typedef_topology)
Theorem CARD_LE_PATH_COMPONENTS_OF_TOPSPACE : forall A:set, A <> Empty -> forall top :e topology A, atleastp (path_components_of A top) (topspace A top).
Admitted.

// HOL Light: Multivariate/metric.ml:22904 / FINITE_PATH_COMPONENTS_OF_FINITE
// Source hash: md5:face42ad19163d4a31b30dcb41bb5972
// Status: transport_required (bridges: hol_finite_finite, hol_typedef_topology)
Theorem FINITE_PATH_COMPONENTS_OF_FINITE : forall A:set, A <> Empty -> forall top :e topology A, finite (topspace A top) -> finite (path_components_of A top).
Admitted.

// HOL Light: Multivariate/metric.ml:22911 / PATH_COMPONENT_OF_UNIQUE
// Source hash: md5:d945162501b906a07ecabd9ee3e1a256
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem PATH_COMPONENT_OF_UNIQUE : forall A:set, forall top :e topology A, forall c c= A, forall x :e A, x :e c /\ (path_connected_in A top c /\ (forall c' c= A, x :e c' /\ path_connected_in A top c' -> c' c= c)) -> forall x0 :e A, path_component_of A top x x0 <-> x0 :e c.
Admitted.

// HOL Light: Multivariate/metric.ml:22920 / PATH_COMPONENT_OF_DISCRETE_TOPOLOGY
// Source hash: md5:31b1d53227b98472339f6b1ac836022e
// Status: generalization_required (bridges: empty_case:A, hol_typedef_topology)
Theorem PATH_COMPONENT_OF_DISCRETE_TOPOLOGY : forall A:set, forall u c= A, forall x x0 :e A, path_component_of A (discrete_topology A u) x x0 <-> (x :e u -> x0 :e SetAdjoin Empty x) /\ (~ x :e u -> x0 :e Empty).
Admitted.

// HOL Light: Multivariate/metric.ml:22931 / PATH_COMPONENTS_OF_DISCRETE_TOPOLOGY
// Source hash: md5:a39bd1724c1f708796e2750dcfa52d79
// Status: transport_required (bridges: hol_typedef_topology)
Theorem PATH_COMPONENTS_OF_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u c= A, path_components_of A (discrete_topology A u) = {{x} | x :e A, x :e u}.
Admitted.

// HOL Light: Multivariate/metric.ml:22939 / PATH_COMPONENT_OF_CONTINUOUS_IMAGE
// Source hash: md5:8f01031555b4980b91d8fb219c7959ba
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod, hol_typedef_topology)
Theorem PATH_COMPONENT_OF_CONTINUOUS_IMAGE : forall A B:set, B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> forall x y :e A, continuous_map A B (top,top') f /\ path_component_of A top x y -> path_component_of B top' (f x) (f y).
Admitted.

// HOL Light: Multivariate/metric.ml:22950 / HOMEOMORPHIC_MAP_PATH_COMPONENT_OF
// Source hash: md5:3f1cfd4b41e464f726d57909da5801a0
// Status: generalization_required (bridges: empty_case:A, empty_case:B, hol_prod_setprod, hol_typedef_topology)
Theorem HOMEOMORPHIC_MAP_PATH_COMPONENT_OF : forall A B:set, forall f:set -> set, (forall x :e A, f x :e B) -> forall top :e topology A, forall top' :e topology B, forall x :e A, homeomorphic_map A B (top,top') f /\ x :e topspace A top -> forall x0 :e B, path_component_of B top' (f x) x0 <-> x0 :e {f x0 | x0 :e {x1 :e A | path_component_of A top x x1}}.
Admitted.

// HOL Light: Multivariate/metric.ml:22969 / HOMEOMORPHIC_MAP_PATH_COMPONENTS_OF
// Source hash: md5:3acd6aca97eaa7d3ecbff541961cf44d
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HOMEOMORPHIC_MAP_PATH_COMPONENTS_OF : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall top :e topology A, forall top' :e topology B, homeomorphic_map A B (top,top') f -> path_components_of B top' = {{x0 :e B | x0 :e {f x0 | x0 :e x}} | x :e path_components_of A top}.
Admitted.

// HOL Light: Multivariate/metric.ml:22979 / PATH_COMPONENT_OF_PAIR
// Source hash: md5:75a78927fc5ea8e567a8e261d37bfa0d
// Status: generalization_required (bridges: empty_case:A, empty_case:B, hol_prod_setprod, hol_typedef_topology)
Theorem PATH_COMPONENT_OF_PAIR : forall A B:set, forall top1 :e topology A, forall top2 :e topology B, forall x :e A, forall y :e B, forall x0 :e A :*: B, path_component_of (A :*: B) (prod_topology A B top1 top2) (x,y) x0 <-> x0 :e {x1 :e A | path_component_of A top1 x x1} :*: {x1 :e B | path_component_of B top2 y x1}.
Admitted.

// HOL Light: Multivariate/metric.ml:23004 / PATH_COMPONENTS_OF_PROD_TOPOLOGY
// Source hash: md5:c190a57fb2ed4b17876c11f3562c000f
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem PATH_COMPONENTS_OF_PROD_TOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e topology A, forall top2 :e topology B, path_components_of (A :*: B) (prod_topology A B top1 top2) = \/_ c1 :e Power A, {c1 :*: c2 | c2 :e Power B, c1 :e path_components_of A top1 /\ c2 :e path_components_of B top2}.
Admitted.

// HOL Light: Multivariate/metric.ml:23014 / PATH_COMPONENT_OF_PRODUCT_TOPOLOGY
// Source hash: md5:8da4f03c1342b1198463529127cf8c55
// Status: transport_required (bridges: choose_in_spec, hol_fun_setexp, hol_typedef_topology)
Theorem PATH_COMPONENT_OF_PRODUCT_TOPOLOGY : forall A K:set, A <> Empty -> K <> Empty -> forall k c= K, forall tops:set -> set, (forall x :e K, tops x :e topology A) -> forall x x0 :e A :^: K, path_component_of (A :^: K) (product_topology A K k tops) x x0 <-> ((forall x0 :e K, ~ x0 :e k -> x x0 = choose_in A (fun y:set => False)) -> x0 :e {f :e A :^: K | (forall i :e k, f i :e {x2 :e A | path_component_of A (tops i) (x i) x2}) /\ forall i :e K, ~ i :e k -> f i = choose_in A (fun y:set => False)}) /\ (~ (forall x0 :e K, ~ x0 :e k -> x x0 = choose_in A (fun y:set => False)) -> x0 :e Empty).
Admitted.

// HOL Light: Multivariate/metric.ml:23047 / PATH_COMPONENTS_OF_PRODUCT_TOPOLOGY
// Source hash: md5:d97b725475252956a28e06970c51d48e
// Status: transport_required (bridges: hol_fun_setexp, hol_typedef_topology)
Theorem PATH_COMPONENTS_OF_PRODUCT_TOPOLOGY : forall A K:set, A <> Empty -> K <> Empty -> forall k c= K, forall tops:set -> set, (forall x :e K, tops x :e topology A) -> path_components_of (A :^: K) (product_topology A K k tops) = {{f :e A :^: K | (forall i :e k, f i :e c i) /\ forall i :e K, ~ i :e k -> f i = choose_in A (fun y:set => False)} | c :e Power A :^: K, forall i :e K, i :e k -> c i :e path_components_of A (tops i)}.
Admitted.

// HOL Light: Multivariate/metric.ml:23082 / EMBEDDING_MAP_INTO_EUCLIDEANREAL
// Source hash: md5:d6dea2e30a80750b9d09326156593b7a
// Status: transport_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_topology)
Theorem EMBEDDING_MAP_INTO_EUCLIDEANREAL : forall A:set, A <> Empty -> forall top :e topology A, forall f:set -> set, (forall x :e A, f x :e R) -> path_connected_space A top -> (embedding_map A R (top,euclideanreal) f <-> continuous_map A R (top,euclideanreal) f /\ forall x y :e A, x :e topspace A top /\ (y :e topspace A top /\ f x = f y) -> x = y).
Admitted.

// HOL Light: Multivariate/metric.ml:23186 / MONOTONE_MAP_INTO_EUCLIDEANREAL_ALT
// Source hash: md5:53da14fc737b44ee69570093e152ccab
// Status: transport_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_topology)
Theorem MONOTONE_MAP_INTO_EUCLIDEANREAL_ALT : forall A:set, A <> Empty -> forall top :e topology A, forall f:set -> set, (forall x :e A, f x :e R) -> continuous_map A R (top,euclideanreal) f -> ((forall k c= R, is_realinterval k -> connected_in A top {x :e A | x :e topspace A top /\ f x :e k}) <-> connected_space A top /\ monotone_map A R (top,euclideanreal) f).
Admitted.

// HOL Light: Multivariate/metric.ml:23297 / MONOTONE_MAP_INTO_EUCLIDEANREAL
// Source hash: md5:beeb86c88d60eb5bd11440259a8325e1
// Status: transport_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_topology)
Theorem MONOTONE_MAP_INTO_EUCLIDEANREAL : forall A:set, A <> Empty -> forall top :e topology A, forall f:set -> set, (forall x :e A, f x :e R) -> connected_space A top /\ continuous_map A R (top,euclideanreal) f -> (monotone_map A R (top,euclideanreal) f <-> forall k c= R, is_realinterval k -> connected_in A top {x :e A | x :e topspace A top /\ f x :e k}).
Admitted.

// HOL Light: Multivariate/metric.ml:23305 / MONOTONE_MAP_EUCLIDEANREAL_ALT
// Source hash: md5:232130ce8100bb02311f05d7dc1bb247
// Status: transport_required (bridges: hol_real_R)
Theorem MONOTONE_MAP_EUCLIDEANREAL_ALT : forall f:set -> set, (forall x :e R, f x :e R) -> forall s c= R, (forall c c= R, is_realinterval c -> is_realinterval {x :e R | x :e s /\ f x :e c}) <-> is_realinterval s /\ ((forall x y :e R, x :e s /\ (y :e s /\ x <= y) -> f x <= f y) \/ forall x y :e R, x :e s /\ (y :e s /\ x <= y) -> f y <= f x).
Admitted.

// HOL Light: Multivariate/metric.ml:23328 / MONOTONE_MAP_EUCLIDEANREAL
// Source hash: md5:4ee1a166a2c8a046e6bfc772c63535dd
// Status: transport_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_topology)
Theorem MONOTONE_MAP_EUCLIDEANREAL : forall f:set -> set, (forall x :e R, f x :e R) -> forall s c= R, is_realinterval s /\ continuous_map R R (subtopology R euclideanreal s,euclideanreal) f -> (monotone_map R R (subtopology R euclideanreal s,euclideanreal) f <-> (forall x y :e R, x :e s /\ (y :e s /\ x <= y) -> f x <= f y) \/ forall x y :e R, x :e s /\ (y :e s /\ x <= y) -> f y <= f x).
Admitted.

// HOL Light: Multivariate/metric.ml:23340 / INJECTIVE_EQ_MONOTONE_MAP
// Source hash: md5:e07fcc962097db2ad8bcf3300428a14b
// Status: transport_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_topology)
Theorem INJECTIVE_EQ_MONOTONE_MAP : forall f:set -> set, (forall x :e R, f x :e R) -> forall s c= R, is_realinterval s /\ continuous_map R R (subtopology R euclideanreal s,euclideanreal) f -> ((forall x y :e R, x :e s /\ (y :e s /\ f x = f y) -> x = y) <-> (forall x y :e R, x :e s /\ (y :e s /\ x < y) -> f x < f y) \/ forall x y :e R, x :e s /\ (y :e s /\ x < y) -> f y < f x).
Admitted.

// HOL Light: Multivariate/metric.ml:23355 / INJECTIVE_EQ_REAL_OPEN_MAP_EUCLIDEANREAL
// Source hash: md5:2b5b8709257e98ab0c7df75e629ab20a
// Status: transport_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_topology)
Theorem INJECTIVE_EQ_REAL_OPEN_MAP_EUCLIDEANREAL : forall f:set -> set, (forall x :e R, f x :e R) -> forall s c= R, is_realinterval s /\ continuous_map R R (subtopology R euclideanreal s,euclideanreal) f -> ((forall x y :e R, x :e s /\ (y :e s /\ f x = f y) -> x = y) <-> forall u c= R, real_open u /\ u c= s -> real_open {f x | x :e u}).
Admitted.

// HOL Light: Multivariate/metric.ml:23488 / normal_space
// Source hash: md5:4483973862b3a97120c36bc7f20f109b
// Status: transport_required (bridges: hol_typedef_topology)
Theorem normal_space_thm : forall A:set, A <> Empty -> forall top :e topology A, normal_space A top <-> forall s t c= A, closed_in A top s /\ (closed_in A top t /\ s :/\: t = Empty) -> exists u v c= A, u :e top /\ (v :e top /\ (s c= u /\ (t c= v /\ u :/\: v = Empty))).
Admitted.

// HOL Light: Multivariate/metric.ml:23495 / NORMAL_SPACE_RETRACTION_MAP_IMAGE
// Source hash: md5:63f72014dbd7becc39139f9051ab7f72
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem NORMAL_SPACE_RETRACTION_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall r:set -> set, (forall x :e A, r x :e B) -> retraction_map A B (top,top') r /\ normal_space A top -> normal_space B top'.
Admitted.

// HOL Light: Multivariate/metric.ml:23522 / HOMEOMORPHIC_NORMAL_SPACE
// Source hash: md5:18d61c8b8bd61db0794156399fb3ac0b
// Status: transport_required (bridges: hol_typedef_topology)
Theorem HOMEOMORPHIC_NORMAL_SPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, homeomorphic_space A B top top' -> (normal_space A top <-> normal_space B top').
Admitted.

// HOL Light: Multivariate/metric.ml:23530 / NORMAL_SPACE
// Source hash: md5:6c8db94b304c54c6763db45890a625b3
// Status: transport_required (bridges: hol_typedef_topology)
Theorem NORMAL_SPACE : forall A:set, A <> Empty -> forall top :e topology A, normal_space A top <-> forall s t c= A, closed_in A top s /\ (closed_in A top t /\ s :/\: t = Empty) -> exists u c= A, u :e top /\ (s c= u /\ t :/\: closure_of A top u = Empty).
Admitted.

// HOL Light: Multivariate/metric.ml:23554 / NORMAL_SPACE_ALT
// Source hash: md5:5ed19ef5b23678afbb58feb8e301d7d1
// Status: transport_required (bridges: hol_typedef_topology)
Theorem NORMAL_SPACE_ALT : forall A:set, A <> Empty -> forall top :e topology A, normal_space A top <-> forall s u c= A, closed_in A top s /\ (u :e top /\ s c= u) -> exists v c= A, v :e top /\ (s c= v /\ closure_of A top v c= u).
Admitted.

// HOL Light: Multivariate/metric.ml:23564 / NORMAL_SPACE_CLOSURES
// Source hash: md5:298c3a13e1bc249af7610a58be1ec1cc
// Status: transport_required (bridges: hol_typedef_topology)
Theorem NORMAL_SPACE_CLOSURES : forall A:set, A <> Empty -> forall top :e topology A, normal_space A top <-> forall s t c= A, s c= topspace A top /\ (t c= topspace A top /\ closure_of A top s :/\: closure_of A top t = Empty) -> exists u v c= A, u :e top /\ (v :e top /\ (s c= u /\ (t c= v /\ u :/\: v = Empty))).
Admitted.

// HOL Light: Multivariate/metric.ml:23582 / NORMAL_SPACE_DISJOINT_CLOSURES
// Source hash: md5:b75ed659c83efcba60282d0be5e39549
// Status: transport_required (bridges: hol_typedef_topology)
Theorem NORMAL_SPACE_DISJOINT_CLOSURES : forall A:set, A <> Empty -> forall top :e topology A, normal_space A top <-> forall s t c= A, closed_in A top s /\ (closed_in A top t /\ s :/\: t = Empty) -> exists u v c= A, u :e top /\ (v :e top /\ (s c= u /\ (t c= v /\ closure_of A top u :/\: closure_of A top v = Empty))).
Admitted.

