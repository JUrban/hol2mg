Theorem SECOND_COUNTABLE_OPEN_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall top :e topology A, forall top' :e topology B, continuous_map A B (top,top') f /\ (open_map A B (top,top') f /\ ({f x | x :e topspace A top} = topspace B top' /\ second_countable A top)) -> second_countable B top'.
