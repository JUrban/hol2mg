// Status: transport_required (bridges: hol_typedef_topology)
Theorem LINDELOF_SPACE_CLOSED_IN_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e topology A, forall s c= A, lindelof_space A top /\ closed_in A top s -> lindelof_space A (subtopology A top s).
Admitted.

