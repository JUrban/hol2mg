Theorem BOUNDED_EQUIVALENT_METRIC : forall A:set, A <> Empty -> forall m :e metric A, forall d :e R, 0 < d -> exists m' :e metric A, mspace A m' = mspace A m /\ (mtopology A m' = mtopology A m /\ forall x y :e A, mdist A m' (x,y) < d).
