// HOL Light: Multivariate/metric.ml:23818 / NORMAL_SPACE_CONTINUOUS_CLOSED_MAP_IMAGE
// Source hash: md5:daaf8182615c61cfa0d791aeef422c15
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem NORMAL_SPACE_CONTINUOUS_CLOSED_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> continuous_map A B (top,top') f /\ (closed_map A B (top,top') f /\ ({f x | x :e topspace A top} = topspace B top' /\ normal_space A top)) -> normal_space B top'.
Admitted.

// HOL Light: Multivariate/metric.ml:23841 / HEREDITARILY_NORMAL_SPACE_CONTINUOUS_CLOSED_MAP_IMAGE
// Source hash: md5:dd03ac6fedadb1da18fc97ad7ccf9c7f
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HEREDITARILY_NORMAL_SPACE_CONTINUOUS_CLOSED_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> continuous_map A B (top,top') f /\ (closed_map A B (top,top') f /\ ({f x | x :e topspace A top} = topspace B top' /\ hereditarily A {x :e topology A | normal_space A x} top)) -> hereditarily B {x :e topology B | normal_space B x} top'.
Admitted.

