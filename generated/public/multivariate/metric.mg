// Source hash: md5:5d45907f2e25a77b2e9ba5f865111e9d
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HOMEOMORPHIC_MAPS_COMPOSE : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e topology A, forall top' :e topology B, forall top'' :e topology C, forall f :e B :^: A, forall g :e C :^: B, forall h :e A :^: B, forall k :e B :^: C, homeomorphic_maps A B (top,top') (f,h) /\ homeomorphic_maps B C (top',top'') (g,k) -> homeomorphic_maps A C (top,top'') (fun x :e A => g (f x),fun x :e C => h (k x)).
Admitted.

// HOL Light: Multivariate/metric.ml:5195 / HOMEOMORPHIC_EQ_EVERYTHING_MAP
// Source hash: md5:b9063ad1f2cb58584ae5545133b6a338
// Status: transport_required (bridges: hol_prod_setprod, hol_typedef_topology)
Theorem HOMEOMORPHIC_EQ_EVERYTHING_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e topology A, forall top' :e topology B, forall f:set -> set, (forall x :e A, f x :e B) -> (homeomorphic_map A B (top,top') f <-> continuous_map A B (top,top') f /\ (open_map A B (top,top') f /\ (closed_map A B (top,top') f /\ ({f x | x :e topspace A top} = topspace B top' /\ forall x y :e A, x :e topspace A top /\ y :e topspace A top -> (f x = f y <-> x = y))))).
Admitted.

