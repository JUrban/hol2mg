// HOL Light: Multivariate/derivatives.ml:1581 / HAS_DERIVATIVE_INVERSE_WITHIN
// Source hash: md5:5c364637a4bff8e56f9d2f65056ecdbe
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_net)
