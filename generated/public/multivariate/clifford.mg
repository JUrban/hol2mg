// Status: generalization_required (bridges: choose_in_spec, empty_case:A, hol_finite_finite, hol_num_omega)
Theorem seqiterate_thm : forall A:set, forall op :e A :^: A :^: A, forall f :e A :^: omega, forall s c= omega, seqiterate A op s f = if infinite s \/ s = Empty then neutral_of A (fun a:set => fun b:set => op a b) else if s = {choose_in omega (fun n:set => n :e s /\ forall m :e omega, m :e s -> n <= m)} then f (choose_in omega (fun n:set => n :e s /\ forall m :e omega, m :e s -> n <= m)) else op (f (choose_in omega (fun n:set => n :e s /\ forall m :e omega, m :e s -> n <= m))) (seqiterate A op (s :\: {choose_in omega (fun n:set => n :e s /\ forall m :e omega, m :e s -> n <= m)}) f).
