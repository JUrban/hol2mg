// HOL Light: Multivariate/clifford.ml:872 / seqiterate_EXISTS
// Source hash: md5:6b4bf781ca36b3522e4fee25da635e60
// Status: transport_required (bridges: choose_in_spec, hol_finite_finite, hol_num_omega)
Theorem seqiterate_EXISTS : forall A:set, A <> Empty -> forall op:set -> set -> set, (forall x y :e A, op x y :e A) -> forall f:set -> set, (forall x :e omega, f x :e A) -> exists h:set -> set, (forall x :e Power omega, h x :e A) /\ forall s c= omega, h s = if infinite s \/ s = Empty then neutral_of A op else if s = {choose_in omega (fun n:set => n :e s /\ forall m :e omega, m :e s -> n <= m)} then f (choose_in omega (fun n:set => n :e s /\ forall m :e omega, m :e s -> n <= m)) else op (f (choose_in omega (fun n:set => n :e s /\ forall m :e omega, m :e s -> n <= m))) (h (s :\: {choose_in omega (fun n:set => n :e s /\ forall m :e omega, m :e s -> n <= m)})).
Admitted.

