Theorem SEQITERATE_CLAUSES : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> (forall op :e A :^: A :^: A, forall f :e A :^: omega, seqiterate A op Empty f = neutral_of A (fun a:set => fun b:set => op a b)) /\ ((forall op :e B :^: B :^: B, forall f :e B :^: omega, forall i :e omega, seqiterate B op {i} f = f i) /\ forall op :e C :^: C :^: C, forall f :e C :^: omega, forall i :e omega, forall s c= omega, finite s /\ (~ s = Empty /\ (forall j :e omega, j :e s -> i < j)) -> seqiterate C op (SetAdjoin s i) f = op (f i) (seqiterate C op s f)).
