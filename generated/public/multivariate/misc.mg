Theorem suslin_operation_thm : forall A:set, A <> Empty -> forall f :e Power A :^: finseq omega, suslin_operation A (fun x:set => fun x0:set => x0 :e f x) = Union {{x :e A | forall Y :e {f (seq_mk n (fun x:set => s x)) | n :e omega, 1 <= n}, x :e Y} | s :e omega :^: omega, s :e omega :^: omega}.
