// HOL Light:  / VECTORIZE_COMPONENT
// Source hash: md5:15dc8a4dbc7780133707c250547f72ef
// Status: transport_required (bridges: add_nat_add_SNo, hol_cart_setexp, hol_dimindex, hol_finite_prod_idx, hol_num_omega, mul_nat_mul_SNo, nat_le_SNoLe)
Theorem VECTORIZE_COMPONENT : forall A M N:set, A <> Empty -> M <> Empty -> N <> Empty -> forall m :e A :^: idx N :^: idx M, forall i :e omega, 1 <= i /\ i <= dimindex M * dimindex N -> vectorize A M N m i = m (1 + div_nat (minus_nat i 1) (dimindex N)) (1 + mod_nat (minus_nat i 1) (dimindex N)).
Admitted.

// HOL Light:  / VECTORIZE_EQ
// Source hash: md5:99a417ffb80187bae0fa501979211e83
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_prod_idx, hol_real_R)
Theorem VECTORIZE_EQ : forall M N:set, M <> Empty -> N <> Empty -> forall m1 m2 :e R :^: idx N :^: idx M, vectorize R M N m1 = vectorize R M N m2 <-> m1 = m2.
Admitted.

// HOL Light:  / VECTORIZE_GSPEC
// Source hash: md5:6dc1cf0af913969f63896733951c1107
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_prod_idx)
Theorem VECTORIZE_GSPEC : forall A M N:set, A <> Empty -> M <> Empty -> N <> Empty -> forall P:set -> prop, {vectorize A M N m | m :e A :^: idx N :^: idx M, P m} = {v :e A :^: idx_n (dimindex M * dimindex N) | P (matrify A M N v)}.
Admitted.

// HOL Light:  / VECTORIZE_MATRIFY
// Source hash: md5:a9e4fe245e083b1a6ef9624cdd2870e5
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_prod_idx)
Theorem VECTORIZE_MATRIFY : forall A M N:set, A <> Empty -> M <> Empty -> N <> Empty -> forall a :e A :^: idx_n (dimindex M * dimindex N), vectorize A M N (matrify A M N a) = a.
Admitted.

// HOL Light:  / VECTOR_VARIATION_COMPOSE_INCREASING
// Source hash: md5:fcf7a352ed1104c3818dd732e31bf5b0
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem VECTOR_VARIATION_COMPOSE_INCREASING : forall N:set, N <> Empty -> forall f:set -> set, (forall x :e R :^: idx 1, f x :e R :^: idx 1) -> forall g:set -> set, (forall x :e R :^: idx 1, g x :e R :^: idx N) -> forall a b :e R :^: idx 1, (forall x y :e R :^: idx 1, x :e closed_interval 1 (seq_cons (a,b) seq_nil) /\ (y :e closed_interval 1 (seq_cons (a,b) seq_nil) /\ drop x <= drop y) -> drop (f x) <= drop (f y)) /\ has_bounded_variation_on N g (closed_interval 1 (seq_cons (f a,f b) seq_nil)) -> vector_variation N (closed_interval 1 (seq_cons (a,b) seq_nil)) (fun x:set => g (f x)) <= vector_variation N (closed_interval 1 (seq_cons (f a,f b) seq_nil)) g.
Admitted.

// HOL Light:  / VECTOR_VARIATION_COMPOSE_INCREASING_GEN
// Source hash: md5:b0388a3e1cc28db93c05e8041106fb94
// Status: transport_required (bridges: hol_cart_setexp, hol_one_1, hol_real_R)
Theorem VECTOR_VARIATION_COMPOSE_INCREASING_GEN : forall N:set, N <> Empty -> forall f:set -> set, (forall x :e R :^: idx 1, f x :e R :^: idx 1) -> forall g:set -> set, (forall x :e R :^: idx 1, g x :e R :^: idx N) -> forall s t c= R :^: idx 1, is_interval 1 s /\ (is_interval 1 t /\ ({f x | x :e s} c= t /\ ((forall x y :e R :^: idx 1, x :e s /\ (y :e s /\ drop x <= drop y) -> drop (f x) <= drop (f y)) /\ has_bounded_variation_on N g t))) -> vector_variation N s (fun x:set => g (f x)) <= vector_variation N t g.
Admitted.

// HOL Light:  / VECTOR_VARIATION_REFLECT_INTERVAL
// Source hash: md5:451a772b0d5518dff7188206ca270d97
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem VECTOR_VARIATION_REFLECT_INTERVAL : forall N:set, N <> Empty -> forall f:set -> set, (forall x :e R :^: idx 1, f x :e R :^: idx N) -> forall u v :e R :^: idx 1, vector_variation N (closed_interval 1 (seq_cons (u,v) seq_nil)) (fun x:set => f (vector_neg 1 x)) = vector_variation N (closed_interval 1 (seq_cons (vector_neg 1 v,vector_neg 1 u) seq_nil)) f.
Admitted.

// HOL Light:  / VECTOR_VARIATION_TRANSLATION_INTERVAL
// Source hash: md5:b611ab2242f5521c4b8109169c3f1c55
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem VECTOR_VARIATION_TRANSLATION_INTERVAL : forall N:set, N <> Empty -> forall a :e R :^: idx 1, forall f:set -> set, (forall x :e R :^: idx 1, f x :e R :^: idx N) -> forall u v :e R :^: idx 1, vector_variation N (closed_interval 1 (seq_cons (u,v) seq_nil)) (fun x:set => f (vector_add 1 a x)) = vector_variation N (closed_interval 1 (seq_cons (vector_add 1 a u,vector_add 1 a v) seq_nil)) f.
Admitted.

// HOL Light:  / VECTOR_VARIATION_VECTOR_VARIATION
// Source hash: md5:7c354fdb5277fe9a5b98b18b2790a09e
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem VECTOR_VARIATION_VECTOR_VARIATION : forall N:set, N <> Empty -> forall f:set -> set, (forall x :e R :^: idx 1, f x :e R :^: idx N) -> forall a b :e R :^: idx 1, has_bounded_variation_on N f (closed_interval 1 (seq_cons (a,b) seq_nil)) -> vector_variation 1 (closed_interval 1 (seq_cons (a,b) seq_nil)) (fun x:set => lift (vector_variation N (closed_interval 1 (seq_cons (a,x) seq_nil)) f)) = vector_variation N (closed_interval 1 (seq_cons (a,b) seq_nil)) f.
Admitted.

