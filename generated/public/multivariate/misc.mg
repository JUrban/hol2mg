Theorem HULL_IMAGE : forall A:set, A <> Empty -> forall P c= Power A, forall f:set -> set, (forall x :e A, f x :e A) -> forall s c= A, (forall s0 c= A, hull A P s0 :e P) /\ ((forall s0 c= A, {f x | x :e s0} :e P <-> s0 :e P) /\ ((forall x y :e A, f x = f y -> x = y) /\ (forall y :e A, exists x :e A, f x = y))) -> hull A P {f x | x :e s} = {f x | x :e hull A P s}.
Admitted.

