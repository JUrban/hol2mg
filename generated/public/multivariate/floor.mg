Theorem REAL_FRAC_POS_LT : forall x :e R, 0 < x + - floor_R x <-> ~ x :e int.
Admitted.

// HOL Light: Library/floor.ml:418 / FRAC_NUM
// Source hash: md5:a50cb7ba859b49e07b44f6bc5b28a735
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem FRAC_NUM : forall n :e omega, n + - floor_R n = 0.
Admitted.

// HOL Light: Library/floor.ml:422 / REAL_FLOOR_REFL
// Source hash: md5:79cb2428320a2d2ba9a0bcbfaaef3502
// Status: transport_required (bridges: hol_real_R, int_Subq_R)
Theorem REAL_FLOOR_REFL : forall x :e R, x :e int -> floor_R x = x.
Admitted.

// HOL Light: Library/floor.ml:426 / REAL_FRAC_ZERO
// Source hash: md5:49ae89f13968227c2810cdf9ea9af20d
// Status: transport_required (bridges: hol_num_omega, hol_real_R, int_Subq_R, omega_Subq_R)
Theorem REAL_FRAC_ZERO : forall x :e R, x :e int -> x + - floor_R x = 0.
Admitted.

// HOL Light: Library/floor.ml:430 / REAL_FLOOR_ADD
// Source hash: md5:17a4dd3ba8d56c74ad7a73222bcbc741
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem REAL_FLOOR_ADD : forall x y :e R, floor_R (x + y) = if (x + - floor_R x) + y + - floor_R y < 1 then floor_R x + floor_R y else (floor_R x + floor_R y) + 1.
Admitted.

// HOL Light: Library/floor.ml:438 / REAL_FLOOR_TRIANGLE
// Source hash: md5:5bd9fb69b3cc1a29ad91f36904fa02cc
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem REAL_FLOOR_TRIANGLE : forall x y :e R, floor_R x + floor_R y <= floor_R (x + y) /\ floor_R (x + y) <= (floor_R x + floor_R y) + 1.
Admitted.

// HOL Light: Library/floor.ml:444 / REAL_FLOOR_NEG
// Source hash: md5:91a456fd0503351c2e89ec4d7e1f9a5b
// Status: transport_required (bridges: hol_num_omega, hol_real_R, int_Subq_R, omega_Subq_R)
Theorem REAL_FLOOR_NEG : forall x :e R, floor_R (- x) = if x :e int then - x else - (floor_R x + 1).
Admitted.

// HOL Light: Library/floor.ml:451 / REAL_FRAC_ADD
// Source hash: md5:a75d0bb27fdc33a859c5a7a232d3c95a
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem REAL_FRAC_ADD : forall x y :e R, (x + y) + - floor_R (x + y) = if (x + - floor_R x) + y + - floor_R y < 1 then (x + - floor_R x) + y + - floor_R y else ((x + - floor_R x) + y + - floor_R y) + - 1.
Admitted.

// HOL Light: Library/floor.ml:456 / FLOOR_POS_LE
// Source hash: md5:c0e54700bf44641d1195aed31d0aebc4
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem FLOOR_POS_LE : forall x :e R, 0 <= floor_R x <-> 0 <= x.
Admitted.

// HOL Light: Library/floor.ml:460 / FRAC_UNIQUE
// Source hash: md5:b7b4a8681a0978aa8ee103e6c46bc6d5
// Status: transport_required (bridges: hol_num_omega, hol_real_R, int_Subq_R, omega_Subq_R)
Theorem FRAC_UNIQUE : forall x a :e R, x + - a :e int /\ (0 <= a /\ a < 1) <-> x + - floor_R x = a.
Admitted.

// HOL Light: Library/floor.ml:466 / REAL_FRAC_EQ
// Source hash: md5:d4b97c0fa382c07e9f8f53b60dd162e3
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem REAL_FRAC_EQ : forall x :e R, x + - floor_R x = x <-> 0 <= x /\ x < 1.
Admitted.

// HOL Light: Library/floor.ml:470 / INTEGER_ROUND
// Source hash: md5:676b593d4cacb3fd761b1654c0dd68e5
// Status: transport_required (bridges: hol_num_omega, hol_real_R, int_Subq_R, omega_Subq_R)
Theorem INTEGER_ROUND : forall x :e R, exists n :e R, n :e int /\ abs_SNo (x + - n) <= 1 :/: 2.
Admitted.

// HOL Light: Library/floor.ml:476 / FRAC_DIV_MOD
// Source hash: md5:bc80a85a27a77c72cc59e0a50214b692
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem FRAC_DIV_MOD : forall m n :e omega, ~ n = 0 -> m :/: n + - floor_R (m :/: n) = mod_nat m n :/: n.
Admitted.

// HOL Light: Library/floor.ml:490 / FRAC_NEG
// Source hash: md5:bd85cb82b6719266fb96456b6487ddfc
// Status: transport_required (bridges: hol_num_omega, hol_real_R, int_Subq_R, omega_Subq_R)
Theorem FRAC_NEG : forall x :e R, - x + - floor_R (- x) = if x :e int then 0 else 1 + - (x + - floor_R x).
Admitted.

// HOL Light: Library/floor.ml:495 / REAL_FLOOR_FLOOR_DIV
// Source hash: md5:b1ac8cfbb2b810b2aff4b739402dae5c
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem REAL_FLOOR_FLOOR_DIV : forall x :e R, forall n :e omega, floor_R (floor_R x :/: n) = floor_R (x :/: n).
Admitted.

// HOL Light: Library/floor.ml:509 / INTEGER_EXISTS_BETWEEN_ALT
// Source hash: md5:f01f76d63fc88266aa814b19d6b0c4b5
// Status: transport_required (bridges: hol_num_omega, hol_real_R, int_Subq_R, omega_Subq_R)
Theorem INTEGER_EXISTS_BETWEEN_ALT : forall x y :e R, x + 1 <= y -> exists n :e R, n :e int /\ (x < n /\ n <= y).
Admitted.

// HOL Light: Library/floor.ml:514 / INTEGER_EXISTS_BETWEEN_LT
// Source hash: md5:0622cf8ce3b692660ef1148c07da994d
// Status: transport_required (bridges: hol_num_omega, hol_real_R, int_Subq_R, omega_Subq_R)
Theorem INTEGER_EXISTS_BETWEEN_LT : forall x y :e R, x + 1 < y -> exists n :e R, n :e int /\ (x < n /\ n < y).
Admitted.

// HOL Light: Library/floor.ml:524 / INTEGER_EXISTS_BETWEEN
// Source hash: md5:10169eab9695a28878ac05322a80eb96
// Status: transport_required (bridges: hol_num_omega, hol_real_R, int_Subq_R, omega_Subq_R)
Theorem INTEGER_EXISTS_BETWEEN : forall x y :e R, x + 1 <= y -> exists n :e R, n :e int /\ (x <= n /\ n < y).
Admitted.

// HOL Light: Library/floor.ml:533 / INTEGER_EXISTS_BETWEEN_ABS
// Source hash: md5:83a545d1b31b1a613f24f961eb0a7af3
// Status: transport_required (bridges: hol_num_omega, hol_real_R, int_Subq_R, omega_Subq_R)
Theorem INTEGER_EXISTS_BETWEEN_ABS : forall x y :e R, 1 <= abs_SNo (x + - y) -> exists n :e R, n :e int /\ (x <= n /\ n < y \/ y <= n /\ n < x).
Admitted.

// HOL Light: Library/floor.ml:543 / INTEGER_EXISTS_BETWEEN_ABS_LT
// Source hash: md5:8ff3157dc54addb2f13ad6d2c061ef48
// Status: transport_required (bridges: hol_num_omega, hol_real_R, int_Subq_R, omega_Subq_R)
Theorem INTEGER_EXISTS_BETWEEN_ABS_LT : forall x y :e R, 1 < abs_SNo (x + - y) -> exists n :e R, n :e int /\ (x < n /\ n < y \/ y < n /\ n < x).
Admitted.

// HOL Light: Library/floor.ml:557 / REAL_OF_INT_OF_REAL
// Source hash: md5:884e4ec7b202cf2b9672513bbbbd5f33
// Status: generalization_required (bridges: hol_int_int, hol_real_R, int_Subq_R)
Theorem REAL_OF_INT_OF_REAL : forall x :e R, x :e int -> (if x :e int then x else 0) = x.
Admitted.

