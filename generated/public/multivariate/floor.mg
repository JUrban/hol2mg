// Status: transport_required (bridges: hol_finite_finite, hol_real_R)
Theorem INFINITE_RATIONAL : infinite {x :e R | x :e rational}.
Admitted.

// HOL Light: Library/floor.ml:677 / PADIC_RATIONAL_APPROXIMATION_STRADDLE
// Source hash: md5:7880a8361080895f245f7ad0ef14a38f
// Status: transport_required (bridges: hol_num_omega, hol_real_R, int_Subq_R, omega_Subq_R)
Theorem PADIC_RATIONAL_APPROXIMATION_STRADDLE : forall p x e0 :e R, 0 < e0 /\ 1 < p -> exists n :e omega, exists q r :e R, q :e int /\ (r :e int /\ (q :/: p ^ n < x /\ (x < r :/: p ^ n /\ abs_SNo (q :/: p ^ n + - r :/: p ^ n) < e0))).
Admitted.

// HOL Light: Library/floor.ml:743 / RATIONAL_APPROXIMATION
// Source hash: md5:b589664318fa47eb545d28d0f3ece9fd
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem RATIONAL_APPROXIMATION : forall x e0 :e R, 0 < e0 -> exists r :e R, r :e rational /\ abs_SNo (r + - x) < e0.
Admitted.

// HOL Light: Library/floor.ml:753 / RATIONAL_BETWEEN
// Source hash: md5:959c17100122e8ad6ad2061cc59ede6c
// Status: transport_required (bridges: hol_real_R)
Theorem RATIONAL_BETWEEN : forall a b :e R, a < b -> exists q :e R, q :e rational /\ (a < q /\ q < b).
Admitted.

// HOL Light: Library/floor.ml:760 / RATIONAL_BETWEEN_EQ
// Source hash: md5:f22aabcc1e58f5c6403061fc3a95c318
// Status: transport_required (bridges: hol_real_R)
Theorem RATIONAL_BETWEEN_EQ : forall a b :e R, (exists q :e R, q :e rational /\ (a < q /\ q < b)) <-> a < b.
Admitted.

// HOL Light: Library/floor.ml:764 / RATIONAL_APPROXIMATION_STRADDLE
// Source hash: md5:1c3752b4fc496a4272fd2cd84f9b356c
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem RATIONAL_APPROXIMATION_STRADDLE : forall x e0 :e R, 0 < e0 -> exists a b :e R, a :e rational /\ (b :e rational /\ (a < x /\ (x < b /\ abs_SNo (b + - a) < e0))).
Admitted.

// HOL Light: Library/floor.ml:779 / RATIONAL_APPROXIMATION_ABOVE
// Source hash: md5:3c97b79fc5db2df307141a7502d1c114
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem RATIONAL_APPROXIMATION_ABOVE : forall x e0 :e R, 0 < e0 -> exists q :e R, q :e rational /\ (x < q /\ q < x + e0).
Admitted.

// HOL Light: Library/floor.ml:787 / RATIONAL_APPROXIMATION_BELOW
// Source hash: md5:d9883c34880f411bbc19ab385681f883
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem RATIONAL_APPROXIMATION_BELOW : forall x e0 :e R, 0 < e0 -> exists q :e R, q :e rational /\ (x + - e0 < q /\ q < x).
Admitted.

// HOL Light: Library/floor.ml:794 / INFINITE_RATIONAL_IN_RANGE
// Source hash: md5:aff900c3aca26a609cf346202dd7c603
// Status: transport_required (bridges: hol_finite_finite, hol_real_R)
Theorem INFINITE_RATIONAL_IN_RANGE : forall a b :e R, a < b -> infinite {q :e R | q :e rational /\ (a < q /\ q < b)}.
Admitted.

// HOL Light: Library/floor.ml:817 / REAL_CONGRUENCE
// Source hash: md5:0755911ffa5d381d03e9a37f27d2be83
// Status: transport_required (bridges: hol_num_omega, hol_real_R, int_Subq_R, omega_Subq_R)
Theorem REAL_CONGRUENCE : forall a b n :e omega, (exists q1 q2 :e omega, a + n * q1 = b + n * q2) <-> (n = 0 -> a = b) /\ (~ n = 0 -> (a + - b) :/: n :e int).
Admitted.

// HOL Light: Library/floor.ml:832 / REAL_INT_CONGRUENCE
// Source hash: md5:68a2b5d90b0ae62ba69dd665ead30ef0
// Status: transport_required (bridges: hol_int_int, hol_num_omega, hol_real_R, int_Subq_R, omega_Subq_int)
Theorem REAL_INT_CONGRUENCE : forall a b n :e int, divides_int n (a + - b) <-> (n = 0 -> a = b) /\ (~ n = 0 -> (a + - b) :/: n :e int).
Admitted.

