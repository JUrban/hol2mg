// Source hash: md5:1d1e4a1399322dd5aef50bca7cdef59e
// Status: transport_required (bridges: hol_int_int, hol_real_R, int_Subq_R)
Theorem IMAGE_REAL_OF_INT_UNIV : forall x :e R, x :e int <-> x :e int.
Admitted.

// HOL Light: Library/floor.ml:570 / HAS_SIZE_INTSEG_NUM
// Source hash: md5:4468e517dca0ac219e00cc8f058b104f
// Status: transport_required (bridges: add_nat_add_SNo, hol_has_size_equip, hol_num_omega, hol_real_R, int_Subq_R, omega_Subq_R)
Theorem HAS_SIZE_INTSEG_NUM : forall m n :e omega, equip {x :e R | x :e int /\ (m <= x /\ x <= n)} (minus_nat (n + 1) m).
Admitted.

// HOL Light: Library/floor.ml:585 / FINITE_INTSEG
// Source hash: md5:25660519ca8497f5686af7c7d4e01530
// Status: transport_required (bridges: hol_finite_finite, hol_real_R, int_Subq_R)
Theorem FINITE_INTSEG : forall a b :e R, finite {x :e R | x :e int /\ (a <= x /\ x <= b)}.
Admitted.

// HOL Light: Library/floor.ml:604 / HAS_SIZE_INTSEG_INT
// Source hash: md5:2c5815ed2fc6504f288d151e90ec971c
// Status: generalization_required (bridges: hol_has_size_equip, hol_int_int, hol_num_omega, hol_real_R, int_Subq_R, omega_Subq_R)
Theorem HAS_SIZE_INTSEG_INT : forall a b :e R, a :e int /\ b :e int -> equip {x :e R | x :e int /\ (a <= x /\ x <= b)} (if b < a then 0 else if (if (b + - a) + 1 :e int then (b + - a) + 1 else 0) :e omega then if (b + - a) + 1 :e int then (b + - a) + 1 else 0 else 0).
Admitted.

// HOL Light: Library/floor.ml:630 / CARD_INTSEG_INT
// Source hash: md5:2800252d64afe27f964f79101007a892
// Status: generalization_required (bridges: hol_card_finite_cardinality, hol_int_int, hol_num_omega, hol_real_R, int_Subq_R, omega_Subq_R)
Theorem CARD_INTSEG_INT : forall a b :e R, a :e int /\ b :e int -> finite_cardinality {x :e R | x :e int /\ (a <= x /\ x <= b)} = if b < a then 0 else if (if (b + - a) + 1 :e int then (b + - a) + 1 else 0) :e omega then if (b + - a) + 1 :e int then (b + - a) + 1 else 0 else 0.
Admitted.

// HOL Light: Library/floor.ml:638 / REAL_CARD_INTSEG_INT
// Source hash: md5:4232f2ecf6963538bb6da80b38d2fe65
// Status: transport_required (bridges: hol_card_finite_cardinality, hol_num_omega, hol_real_R, int_Subq_R, omega_Subq_R)
Theorem REAL_CARD_INTSEG_INT : forall a b :e R, a :e int /\ b :e int -> finite_cardinality {x :e R | x :e int /\ (a <= x /\ x <= b)} = if b < a then 0 else (b + - a) + 1.
Admitted.

