Theorem RETRACT_OF_LOCALLY_PATH_CONNECTED : forall N:set, N <> Empty -> forall s t c= R :^: idx N, retract_of N s t /\ locally N {x :e Power (R :^: idx N) | path_connected N x} t -> locally N {x :e Power (R :^: idx N) | path_connected N x} s.
Admitted.

