// Source hash: md5:4485e420ee839a9dd414c80d7dbb646e
// Status: transport_required (bridges: hol_nsum_finsum, hol_num_omega)
Theorem NSUM_PERMUTE_NUMSEG : forall f:set -> set, (forall x :e omega, f x :e omega) -> forall p:set -> set, (forall x :e omega, p x :e omega) -> forall m n :e omega, permutes omega p {i :e omega | m <= i /\ i <= n} -> finsum {i :e omega | m <= i /\ i <= n} f = finsum {i :e omega | m <= i /\ i <= n} (fun x:set => f (p x)).
