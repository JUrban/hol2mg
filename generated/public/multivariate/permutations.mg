// Status: transport_required (bridges: hol_finite_finite)
Theorem EVENPERM_TRANSFER : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall s c= A, forall p:set -> set, (forall x :e A, p x :e A) -> forall q:set -> set, (forall x :e B, q x :e B) -> finite s /\ ((forall x y :e A, x :e s /\ (y :e s /\ f x = f y) -> x = y) /\ (permutes A p s /\ ((forall x :e A, x :e s -> q (f x) = f (p x)) /\ (forall y :e B, ~ y :e {f x | x :e s} -> q y = y)))) -> (evenperm B q <-> evenperm A p).
