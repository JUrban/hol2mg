// HOL Light: Library/permutations.ml:683 / swapseq_INDUCT
// Source hash: md5:bc344b78c2300369eeaf68fdbad430a0
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem swapseq_INDUCT : forall A:set, A <> Empty -> forall swapseq':set -> set -> prop, swapseq' 0 (fun x :e A => x) /\ (forall a b :e A, forall p :e A :^: A, forall n :e omega, swapseq' n p /\ ~ a = b -> swapseq' (ordsucc n) (fun x :e A => swap A (a,b) (p x))) -> forall a0 :e omega, forall a1 :e A :^: A, swapseq A a0 (fun x:set => a1 x) -> swapseq' a0 a1.
