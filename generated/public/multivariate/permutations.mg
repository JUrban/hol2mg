Theorem PERMUTES_INSERT_LEMMA : forall A:set, forall p:set -> set, (forall x :e A, p x :e A) -> forall a :e A, forall s c= A, permutes A p (SetAdjoin s a) -> permutes A (fun x:set => swap A (a,p a) (p x)) s.
