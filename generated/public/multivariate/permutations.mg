// HOL Light: Library/permutations.ml:683 / swapseq_CASES
// Source hash: md5:1a22039f5e43bec187621e8c728e53ef
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem swapseq_CASES : forall A:set, A <> Empty -> forall a0 :e omega, forall a1:set -> set, (forall x :e A, a1 x :e A) -> (swapseq A a0 a1 <-> a0 = 0 /\ (forall x :e A, a1 x = x) \/ exists a b :e A, exists p:set -> set, (forall x :e A, p x :e A) /\ exists n :e omega, a0 = ordsucc n /\ ((forall x :e A, a1 x = swap A (a,b) (p x)) /\ (swapseq A n p /\ ~ a = b))).
