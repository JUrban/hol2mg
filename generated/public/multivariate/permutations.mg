// HOL Light: Library/permutations.ml:1487 / SIGN_CYCLIC
// Source hash: md5:492da8eb710d94fad5ca18e977c3fd4d
// Status: transport_required (bridges: add_nat_add_SNo, hol_num_omega, hol_real_R, nat_lt_SNoLt, omega_Subq_R)
Theorem SIGN_CYCLIC : forall n :e omega, sign omega (fun i:set => if i < n then mod_nat (i + 1) n else i) = (- 1) ^ minus_nat n 1.
Admitted.

// HOL Light: Library/permutations.ml:1494 / SIGN_CYCLIC_N
