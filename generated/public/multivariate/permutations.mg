// HOL Light: Library/permutations.ml:631 / THREE_CYCLE_AS_COMMUTATOR
// Source hash: md5:6e18b6f895065643bb994d15d08292f0
// Status: generalization_required (bridges: empty_case:A)
Theorem THREE_CYCLE_AS_COMMUTATOR : forall A:set, forall a b c d e0 :e A, ~ a = b /\ (~ a = c /\ (~ a = d /\ (~ a = e0 /\ (~ b = c /\ (~ b = d /\ (~ b = e0 /\ (~ c = d /\ (~ c = e0 /\ ~ d = e0)))))))) -> forall x :e A, three_cycle A a b c x = three_cycle A d c a (three_cycle A c b e0 (three_cycle A d a c (three_cycle A c e0 b x))).
