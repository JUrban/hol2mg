// HOL Light: Library/permutations.ml:391 / CARD_PERMUTATIONS
// Source hash: md5:89eadc60c0ce670170c8f08e512f1af0
// Status: transport_required (bridges: hol_card_finite_cardinality, hol_fact_factorial, hol_finite_finite, hol_num_omega)
Theorem CARD_PERMUTATIONS : forall A:set, A <> Empty -> forall s c= A, finite s -> finite_cardinality {p :e A :^: A | permutes A (fun x:set => p x) s} = factorial (finite_cardinality s).
Admitted.

// HOL Light: Library/permutations.ml:399 / PERMUTES_FINITE_INJECTIVE
// Source hash: md5:385661ad822c5fd1582c9f1e86f7e237
// Status: transport_required (bridges: hol_finite_finite)
Theorem PERMUTES_FINITE_INJECTIVE : forall A:set, A <> Empty -> forall s c= A, forall p:set -> set, (forall x :e A, p x :e A) -> finite s -> (permutes A p s <-> (forall x :e A, ~ x :e s -> p x = x) /\ ((forall x :e A, x :e s -> p x :e s) /\ forall x y :e A, x :e s /\ (y :e s /\ p x = p y) -> x = y)).
Admitted.

// HOL Light: Library/permutations.ml:415 / PERMUTES_FINITE_SURJECTIVE
// Source hash: md5:2c32a64799631e677ac02fd08a288e3e
// Status: transport_required (bridges: hol_finite_finite)
Theorem PERMUTES_FINITE_SURJECTIVE : forall A:set, A <> Empty -> forall s c= A, forall p:set -> set, (forall x :e A, p x :e A) -> finite s -> (permutes A p s <-> (forall x :e A, ~ x :e s -> p x = x) /\ ((forall x :e A, x :e s -> p x :e s) /\ forall y :e A, y :e s -> exists x :e A, x :e s /\ p x = y)).
Admitted.

// HOL Light: Library/permutations.ml:434 / RESTRICT_PERMUTES_SUBSET
// Source hash: md5:724ac71afc3196275c86e36f572d5760
// Status: transport_required (bridges: hol_finite_finite)
Theorem RESTRICT_PERMUTES_SUBSET : forall A:set, A <> Empty -> forall s t c= A, forall f:set -> set, (forall x :e A, f x :e A) -> finite t /\ (t c= s /\ (permutes A f s /\ {f x | x :e t} = t)) -> permutes A (fun x:set => if x :e t then f x else x) t.
Admitted.

// HOL Light: Library/permutations.ml:454 / RESTRICT_I
// Source hash: md5:991dd3be3219898bbf70f6d8a5e8f094
// Status: generalization_required (bridges: empty_case:A)
Theorem RESTRICT_I : forall A:set, forall t c= A, forall x :e A, (if x :e t then x else x) = x.
Admitted.

// HOL Light: Library/permutations.ml:461 / RESTRICT_COMPOSE
// Source hash: md5:be4fc018bceaea4184c91aeea75fac42
// Status: generalization_required (bridges: empty_case:A)
Theorem RESTRICT_COMPOSE : forall A:set, forall s t c= A, forall f:set -> set, (forall x :e A, f x :e A) -> forall g:set -> set, (forall x :e A, g x :e A) -> t c= s /\ (permutes A f s /\ (permutes A g s /\ ({f x | x :e t} = t /\ {g x | x :e t} = t))) -> forall x :e A, (if x :e t then f (g x) else x) = if (if x :e t then g x else x) :e t then f (if x :e t then g x else x) else if x :e t then g x else x.
Admitted.

// HOL Light: Library/permutations.ml:476 / RESTRICT_INVERSE
// Source hash: md5:8674353a319a633331e4472f98103e90
// Status: generalization_required (bridges: empty_case:A, hol_finite_finite)
Theorem RESTRICT_INVERSE : forall A:set, forall s t c= A, forall f:set -> set, (forall x :e A, f x :e A) -> finite t /\ (t c= s /\ (permutes A f s /\ {f x | x :e t} = t)) -> forall x :e A, (if x :e t then inverse A A f x else x) = inverse A A (fun x0:set => if x0 :e t then f x0 else x0) x.
Admitted.

// HOL Light: Library/permutations.ml:527 / RESTRICT_SWAP
// Source hash: md5:94aa868347e5b0ffd514e4b928d2ded8
// Status: generalization_required (bridges: empty_case:A, hol_prod_setprod)
Theorem RESTRICT_SWAP : forall A:set, forall s c= A, forall a b :e A, a :e s /\ b :e s -> forall x :e A, (if x :e s then swap A (a,b) x else x) = swap A (a,b) x.
Admitted.

// HOL Light: Library/permutations.ml:541 / ITERATE_PERMUTE
// Source hash: md5:f07b4a76a1acef0b41c9f07d2d6c7e48
// Status: transport_required (bridges: hol_iterate)
Theorem ITERATE_PERMUTE : forall A B:set, A <> Empty -> B <> Empty -> forall op:set -> set -> set, (forall x y :e B, op x y :e B) -> (forall x y :e B, op x y = op y x) /\ (forall x y z :e B, op x (op y z) = op (op x y) z) /\ (forall x :e B, op (neutral_of B op) x = x) -> forall f:set -> set, (forall x :e A, f x :e B) -> forall p:set -> set, (forall x :e A, p x :e A) -> forall s c= A, permutes A p s -> iterate_op B op s f = iterate_op B op s (fun x:set => f (p x)).
Admitted.

// HOL Light: Library/permutations.ml:548 / NSUM_PERMUTE
// Source hash: md5:e33a81fd4e8811b7f62a41457c47f998
