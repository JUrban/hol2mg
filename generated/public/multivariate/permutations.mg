Theorem NSUM_PERMUTE : forall A:set, A <> Empty -> forall f:set -> set, (forall x :e A, f x :e omega) -> forall p:set -> set, (forall x :e A, p x :e A) -> forall s c= A, permutes A p s -> finsum s f = finsum s (fun x:set => f (p x)).
Admitted.

