// Status: transport_required (bridges: hol_finite_finite, hol_real_R)
Theorem SIGN_TRANSFER : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall s c= A, forall p:set -> set, (forall x :e A, p x :e A) -> forall q:set -> set, (forall x :e B, q x :e B) -> finite s /\ ((forall x y :e A, x :e s /\ (y :e s /\ f x = f y) -> x = y) /\ (permutes A p s /\ ((forall x :e A, x :e s -> q (f x) = f (p x)) /\ (forall y :e B, ~ y :e {f x | x :e s} -> q y = y)))) -> sign B q = sign A p.
Admitted.

// HOL Light: Library/permutations.ml:1142 / SIGN_CARTESIAN_PRODUCT
// Source hash: md5:b35d81693918fa6f32f2e49f8196627c
// Status: transport_required (bridges: hol_card_finite_cardinality, hol_finite_finite, hol_num_omega, hol_prod_setprod, hol_real_R)
Theorem SIGN_CARTESIAN_PRODUCT : forall A B:set, A <> Empty -> B <> Empty -> forall p:set -> set, (forall x :e A, p x :e A) -> forall q:set -> set, (forall x :e B, q x :e B) -> forall s c= A, forall t c= B, finite s /\ (finite t /\ (permutes A p s /\ permutes B q t)) -> sign (A :*: B) (fun p0:set => if p0 0 :e s /\ p0 1 :e t then (p (p0 0),q (p0 1)) else (p0 0,p0 1)) = sign A p ^ finite_cardinality t * sign B q ^ finite_cardinality s.
Admitted.

