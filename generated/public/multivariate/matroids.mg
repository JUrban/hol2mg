// Status: transport_required (bridges: hol_typedef_matroid)
Theorem MATROID_INDEPENDENT_SUBMATROID : forall A:set, A <> Empty -> forall m :e matroid A, forall s b c= A, s c= matroid_set A m -> (matroid_independent A (submatroid A m s) b <-> b c= {x :e A | matroid_span A m s x} /\ matroid_independent A m b).
Admitted.

// HOL Light: Library/matroids.ml:974 / MATROID_SPANNING_SUBMATROID
// Source hash: md5:db5c27ecc46936ee4412dc0bc5384220
// Status: transport_required (bridges: hol_typedef_matroid)
Theorem MATROID_SPANNING_SUBMATROID : forall A:set, A <> Empty -> forall m :e matroid A, forall s b c= A, s c= matroid_set A m -> (matroid_spanning A (submatroid A m s) b <-> b c= {x :e A | matroid_span A m s x} /\ forall x :e A, matroid_span A m b x <-> matroid_span A m s x).
Admitted.

// HOL Light: Library/matroids.ml:981 / MATROID_SPANNING_SUBMATROID_SELF
