Theorem MATROID_BASIS_EQ_MAXIMAL_INDEPENDENT : forall A:set, A <> Empty -> forall m :e matroid A, forall s c= A, matroid_basis A m s <-> matroid_independent A m s /\ forall s' c= A, s c= s' /\ s <> s' -> ~ matroid_independent A m s'.
Admitted.

// HOL Light: Library/matroids.ml:445 / MATROID_BASIS_EQ_MINIMAL_SPANNING
// Source hash: md5:df2462beb7bbe19fbbf10dbee3afddc9
// Status: transport_required (bridges: hol_typedef_matroid)
Theorem MATROID_BASIS_EQ_MINIMAL_SPANNING : forall A:set, A <> Empty -> forall m :e matroid A, forall s c= A, matroid_basis A m s <-> matroid_spanning A m s /\ forall s' c= A, s' c= s /\ s' <> s -> ~ matroid_spanning A m s'.
Admitted.

// HOL Light: Library/matroids.ml:461 / MATROID_INDEPENDENT_CHAIN
// Source hash: md5:beb602f3613426adfff0fd4e9a0c481d
// Status: transport_required (bridges: hol_typedef_matroid)
Theorem MATROID_INDEPENDENT_CHAIN : forall A:set, A <> Empty -> forall m :e matroid A, forall c c= Power A, (forall s c= A, s :e c -> matroid_independent A m s) /\ (forall s t c= A, s :e c /\ t :e c -> s c= t \/ t c= s) -> matroid_independent A m (Union c).
Admitted.

// HOL Light: Library/matroids.ml:476 / MATROID_SPAN_CHAIN
// Source hash: md5:cd2cbc2c2e550a51b0fa0fdea3bac8af
// Status: generalization_required (bridges: empty_case:A, hol_typedef_matroid)
Theorem MATROID_SPAN_CHAIN : forall A:set, forall m :e matroid A, forall c c= Power A, ~ c = Empty /\ ((forall s c= A, s :e c -> s c= matroid_set A m) /\ (forall s t c= A, s :e c /\ t :e c -> s c= t \/ t c= s)) -> forall x :e A, matroid_span A m (Union c) x <-> x :e Union {{x0 :e A | matroid_span A m s x0} | s :e Power A, s :e c}.
Admitted.

// HOL Light: Library/matroids.ml:495 / MATROID_INTERMEDIATE_SPAN
// Source hash: md5:325a145375a242ade1ac8564f023420a
// Status: generalization_required (bridges: empty_case:A, hol_typedef_matroid)
Theorem MATROID_INTERMEDIATE_SPAN : forall A:set, forall m :e matroid A, forall s t c= A, matroid_independent A m s /\ (t c= matroid_set A m /\ s c= {x :e A | matroid_span A m t x}) -> exists b c= A, s c= b /\ (b c= s :\/: t /\ (matroid_independent A m b /\ forall x :e A, matroid_span A m b x <-> matroid_span A m t x)).
Admitted.

// HOL Light: Library/matroids.ml:525 / MATROID_INTERMEDIATE_BASIS
// Source hash: md5:e926a3f44f2ce721c8729e5207ef9612
// Status: transport_required (bridges: hol_typedef_matroid)
Theorem MATROID_INTERMEDIATE_BASIS : forall A:set, A <> Empty -> forall m :e matroid A, forall s t c= A, matroid_independent A m s /\ matroid_spanning A m t -> exists b c= A, s c= b /\ (b c= s :\/: t /\ matroid_basis A m b).
Admitted.

// HOL Light: Library/matroids.ml:534 / MATROID_INDEPENDENT_EXTENDS_TO_BASIS
// Source hash: md5:ca513053a1fcf510da4d00b4fc75810d
// Status: transport_required (bridges: hol_typedef_matroid)
Theorem MATROID_INDEPENDENT_EXTENDS_TO_BASIS : forall A:set, A <> Empty -> forall m :e matroid A, forall s c= A, matroid_independent A m s -> exists b c= A, s c= b /\ matroid_basis A m b.
Admitted.

// HOL Light: Library/matroids.ml:542 / MATROID_BASIS_EXISTS
// Source hash: md5:dad66f43760d6d1e66e6a2025e06a9be
// Status: transport_required (bridges: hol_typedef_matroid)
Theorem MATROID_BASIS_EXISTS : forall A:set, A <> Empty -> forall m :e matroid A, exists b c= A, matroid_basis A m b.
Admitted.

// HOL Light: Library/matroids.ml:546 / MATROID_SPANNING_CONTAINS_BASIS
// Source hash: md5:469fb2c66d63240fdab0dd739725e6d7
// Status: transport_required (bridges: hol_typedef_matroid)
Theorem MATROID_SPANNING_CONTAINS_BASIS : forall A:set, A <> Empty -> forall m :e matroid A, forall s c= A, matroid_spanning A m s -> exists b c= A, b c= s /\ matroid_basis A m b.
Admitted.

// HOL Light: Library/matroids.ml:554 / MATROID_SPAN_DEPENDENCE
// Source hash: md5:a37f5d1d72f5321105dea2db87fa7315
// Status: generalization_required (bridges: empty_case:A, hol_typedef_matroid)
Theorem MATROID_SPAN_DEPENDENCE : forall A:set, forall m :e matroid A, forall s c= A, forall x :e A, x :e matroid_set A m /\ s c= matroid_set A m -> (x :e {x0 :e A | matroid_span A m s x0} <-> x :e s \/ exists t c= A, t c= s /\ (matroid_independent A m t /\ SetAdjoin t x :e matroid_dependent A m)).
Admitted.

// HOL Light: Library/matroids.ml:575 / MATROID_STEINITZ_EXCHANGE
// Source hash: md5:b05c149fcdcc83cadf09eda481842fb6
// Status: transport_required (bridges: hol_card_finite_cardinality, hol_finite_finite, hol_has_size_equip, hol_num_omega, hol_typedef_matroid)
Theorem MATROID_STEINITZ_EXCHANGE : forall A:set, A <> Empty -> forall m :e matroid A, forall s t c= A, t c= matroid_set A m /\ (finite s /\ (matroid_independent A m s /\ s c= {x :e A | matroid_span A m t x})) -> exists t' c= A, t' c= t /\ (equip t' (finite_cardinality s) /\ forall x :e A, matroid_span A m ((t :\: t') :\/: s) x <-> matroid_span A m t x).
Admitted.

// HOL Light: Library/matroids.ml:634 / MATROID_INDEPENDENT_CARD_LE_SPAN_FINITE
// Source hash: md5:76c2b6b98e7bf293202527c524e8bfab
// Status: transport_required (bridges: hol_card_finite_cardinality, hol_finite_finite, hol_num_omega, hol_typedef_matroid, nat_le_SNoLe)
Theorem MATROID_INDEPENDENT_CARD_LE_SPAN_FINITE : forall A:set, A <> Empty -> forall m :e matroid A, forall s t c= A, finite t /\ (t c= matroid_set A m /\ (matroid_independent A m s /\ s c= {x :e A | matroid_span A m t x})) -> finite s /\ finite_cardinality s <= finite_cardinality t.
Admitted.

