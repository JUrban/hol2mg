Theorem SUBMATROID_SET : forall A:set, A <> Empty -> forall m :e matroid A, submatroid A m (matroid_set A m) = m.
Admitted.

// HOL Light: Library/matroids.ml:966 / MATROID_INDEPENDENT_SUBMATROID
