// Status: generalization_required (bridges: empty_case:A, hol_finite_finite, hol_typedef_matroid)
Theorem MATROID_EQ_SPANS_FINITE : forall A:set, forall m :e matroid A, forall s t c= A, matroid_independent A m s /\ (matroid_independent A m t /\ (forall x :e A, matroid_span A m s x <-> matroid_span A m t x)) -> (finite s <-> finite t).
Admitted.

