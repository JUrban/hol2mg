// Status: generalization_required (bridges: empty_case:A, hol_typedef_matroid)
Theorem MATROID_SPAN_SUBSET_SUBSPACE : forall A:set, forall m :e matroid A, forall s t c= A, s c= t /\ matroid_subspace A m t -> {x :e A | matroid_span A m s x} c= t.
Admitted.

// HOL Light: Library/matroids.ml:916 / submatroid
// Source hash: md5:2ded485caf4395d8d8387fceab9a4179
// Status: generalization_required (bridges: hol_prod_setprod, hol_typedef_matroid)
Theorem submatroid_thm : forall A:set, A <> Empty -> forall s c= A, forall m :e matroid A, submatroid A m s = ({x :e A | matroid_span A m (matroid_set A m :/\: s) x},fun x :e Power A => {x0 :e A | matroid_span A m x x0}).
Admitted.

// HOL Light: Library/matroids.ml:920 / SUBMATROID_GEN
// Source hash: md5:3b5043b400099e9e6619fdbc23cc6327
// Status: generalization_required (bridges: empty_case:A, hol_typedef_matroid)
Theorem SUBMATROID_GEN : forall A:set, (forall m :e matroid A, forall s c= A, forall x :e A, x :e matroid_set A (submatroid A m s) <-> matroid_span A m (matroid_set A m :/\: s) x) /\ forall m :e matroid A, forall s x c= A, forall x0 :e A, matroid_span A (submatroid A m s) x x0 <-> matroid_span A m x x0.
Admitted.

// HOL Light: Library/matroids.ml:940 / SUBMATROID
// Source hash: md5:2117c275a1e3b58f3a0640ca0109975f
// Status: transport_required (bridges: hol_typedef_matroid)
Theorem SUBMATROID : forall A:set, A <> Empty -> (forall m :e matroid A, forall s c= A, matroid_subspace A m s -> matroid_set A (submatroid A m s) = s) /\ forall m :e matroid A, forall s x c= A, forall x0 :e A, matroid_span A (submatroid A m s) x x0 <-> matroid_span A m x x0.
Admitted.

// HOL Light: Library/matroids.ml:947 / SUBMATROID_SPAN
// Source hash: md5:b7337b6cb95f1409469e5ba972104111
// Status: generalization_required (bridges: empty_case:A, hol_typedef_matroid)
Theorem SUBMATROID_SPAN : forall A:set, forall m :e matroid A, forall s c= A, s c= matroid_set A m -> submatroid A m {x :e A | matroid_span A m s x} = submatroid A m s.
Admitted.

