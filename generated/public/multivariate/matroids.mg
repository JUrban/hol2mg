Admitted.

// HOL Light: Library/matroids.ml:847 / MATROID_SUBSPACE
// Source hash: md5:fe5aac9b1f8b6b6da02927653273f10f
// Status: transport_required (bridges: hol_typedef_matroid)
Theorem MATROID_SUBSPACE : forall A:set, A <> Empty -> forall m :e matroid A, forall s c= A, matroid_subspace A m s <-> s c= matroid_set A m /\ {x :e A | matroid_span A m s x} c= s.
Admitted.

// HOL Light: Library/matroids.ml:854 / MATROID_SUBSPACE_INTERS
// Source hash: md5:49f3cf47f2414b5e75bc7272d878e249
// Status: transport_required (bridges: hol_typedef_matroid)
Theorem MATROID_SUBSPACE_INTERS : forall A:set, A <> Empty -> forall m :e matroid A, forall f c= Power A, ~ f = Empty /\ (forall s c= A, s :e f -> matroid_subspace A m s) -> matroid_subspace A m {x :e A | forall Y :e f, x :e Y}.
Admitted.

// HOL Light: Library/matroids.ml:865 / MATROID_SUBSPACE_INTER
// Source hash: md5:3f5e7655b59cda5bfda96648b7b14e32
// Status: transport_required (bridges: hol_typedef_matroid)
Theorem MATROID_SUBSPACE_INTER : forall A:set, A <> Empty -> forall m :e matroid A, forall s t c= A, matroid_subspace A m s /\ matroid_subspace A m t -> matroid_subspace A m (s :/\: t).
Admitted.

// HOL Light: Library/matroids.ml:872 / MATROID_SPAN_INTER_SPANS
// Source hash: md5:3e1496906fda0f9169c3653230137c18
// Status: generalization_required (bridges: empty_case:A, hol_typedef_matroid)
Theorem MATROID_SPAN_INTER_SPANS : forall A:set, forall m :e matroid A, forall s t c= A, s c= matroid_set A m /\ t c= matroid_set A m -> forall x :e A, matroid_span A m ({x0 :e A | matroid_span A m s x0} :/\: {x0 :e A | matroid_span A m t x0}) x <-> x :e {x0 :e A | matroid_span A m s x0} :/\: {x0 :e A | matroid_span A m t x0}.
Admitted.

// HOL Light: Library/matroids.ml:880 / MATROID_SUBSPACE_CHAIN
// Source hash: md5:49a6f6d37b7fd21fcf17064d5dccda20
// Status: transport_required (bridges: hol_typedef_matroid)
Theorem MATROID_SUBSPACE_CHAIN : forall A:set, A <> Empty -> forall m :e matroid A, forall c c= Power A, ~ c = Empty /\ ((forall s c= A, s :e c -> matroid_subspace A m s) /\ (forall s t c= A, s :e c /\ t :e c -> s c= t \/ t c= s)) -> matroid_subspace A m (Union c).
Admitted.

// HOL Light: Library/matroids.ml:889 / MATROID_SPAN_SUBSPACE
// Source hash: md5:71974e94da522bac38cbcd96ecfde0fc
// Status: generalization_required (bridges: empty_case:A, hol_typedef_matroid)
Theorem MATROID_SPAN_SUBSPACE : forall A:set, forall m :e matroid A, forall s b c= A, b c= s /\ (s c= {x :e A | matroid_span A m b x} /\ matroid_subspace A m s) -> forall x :e A, matroid_span A m b x <-> x :e s.
Admitted.

// HOL Light: Library/matroids.ml:896 / MATROID_SPAN_EQ_SELF
// Source hash: md5:2a895cb5570d06ee2cafd74b27c8d6b4
// Status: transport_required (bridges: hol_typedef_matroid)
