Admitted.

// HOL Light: Library/prime.ml:679 / PRIME
// Source hash: md5:edcdbce33545242fb45f60ed4f76194e
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, nat_lt_SNoLt)
Theorem PRIME : forall p :e omega, prime_nat p <-> ~ p = 0 /\ (~ p = 1 /\ forall m :e omega, 0 < m /\ m < p -> gcd_int p m = 1).
Admitted.

// HOL Light: Library/prime.ml:694 / PRIME_PRIME_FACTOR
// Source hash: md5:a6cab7f94bcc1dc970a1496fa35c668f
// Status: transport_required (bridges: hol_num_omega)
Theorem PRIME_PRIME_FACTOR : forall n :e omega, prime_nat n <-> ~ n = 1 /\ forall p :e omega, prime_nat p /\ divides_nat p n -> p = n.
Admitted.

// HOL Light: Library/prime.ml:705 / PRIME_FACTOR_LT
// Source hash: md5:914d6958736bc0e930e1d463059257b3
// Status: transport_required (bridges: hol_num_omega, mul_nat_mul_SNo, nat_lt_SNoLt)
Theorem PRIME_FACTOR_LT : forall n m p :e omega, prime_nat p /\ (~ n = 0 /\ n = p * m) -> m < n.
Admitted.

// HOL Light: Library/prime.ml:712 / COPRIME_PRIME_EQ
// Source hash: md5:649c91949267a67e88b45da250de6312
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem COPRIME_PRIME_EQ : forall a b :e omega, gcd_int a b = 1 <-> forall p :e omega, ~ (prime_nat p /\ (divides_nat p a /\ divides_nat p b)).
Admitted.

// HOL Light: Library/prime.ml:724 / GCD_PRIME_CASES
// Source hash: md5:76924345088d04386e537af3e8cf74b8
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem GCD_PRIME_CASES : (forall p n :e omega, prime_nat p -> gcd_int p n = if divides_nat p n then p else 1) /\ forall p n :e omega, prime_nat p -> gcd_int n p = if divides_nat p n then p else 1.
Admitted.

// HOL Light: Library/prime.ml:733 / GCD_2_CASES
// Source hash: md5:2b2cff92f6cc38e3efafd606696c12d4
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem GCD_2_CASES : (forall n :e omega, gcd_int 2 n = if even_nat n then 2 else 1) /\ forall n :e omega, gcd_int n 2 = if even_nat n then 2 else 1.
Admitted.

// HOL Light: Library/prime.ml:738 / COPRIME_PRIMEPOW
// Source hash: md5:3d8b0683636503f70b0460dbd027e9a0
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, hol_prod_setprod)
Theorem COPRIME_PRIMEPOW : forall p k m :e omega, prime_nat p /\ ~ k = 0 -> (gcd_int m (p ^ k) = 1 <-> ~ divides_nat p m).
Admitted.

// HOL Light: Library/prime.ml:743 / COPRIME_BEZOUT_STRONG
// Source hash: md5:c2b9c54fc8581e4a66a2b9d6d78d1a99
// Status: transport_required (bridges: add_nat_add_SNo, hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem COPRIME_BEZOUT_STRONG : forall a b :e omega, gcd_int a b = 1 /\ ~ b = 1 -> exists x y :e omega, a * x = b * y + 1.
Admitted.

// HOL Light: Library/prime.ml:750 / COPRIME_BEZOUT_ALT
// Source hash: md5:a735222114688ba67da575ab70c3efc0
// Status: transport_required (bridges: add_nat_add_SNo, hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem COPRIME_BEZOUT_ALT : forall a b :e omega, gcd_int a b = 1 /\ ~ a = 0 -> exists x y :e omega, a * x = b * y + 1.
Admitted.

// HOL Light: Library/prime.ml:757 / BEZOUT_PRIME
// Source hash: md5:54d67b2dfdb772d150f87c66b0dda540
// Status: transport_required (bridges: add_nat_add_SNo, hol_num_omega, mul_nat_mul_SNo)
Theorem BEZOUT_PRIME : forall a p :e omega, prime_nat p /\ ~ divides_nat p a -> exists x y :e omega, a * x = p * y + 1.
Admitted.

// HOL Light: Library/prime.ml:762 / PRIME_DIVEXP
// Source hash: md5:e05038a390df938851f587e243fc8433
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega)
Theorem PRIME_DIVEXP : forall n p x :e omega, prime_nat p /\ divides_nat p (x ^ n) -> divides_nat p x.
Admitted.

// HOL Light: Library/prime.ml:771 / PRIME_DIVEXP_N
// Source hash: md5:c2e489d25c6805ad3dab04f2aeb90349
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega)
Theorem PRIME_DIVEXP_N : forall n p x :e omega, prime_nat p /\ divides_nat p (x ^ n) -> divides_nat (p ^ n) (x ^ n).
Admitted.

// HOL Light: Library/prime.ml:776 / PRIME_DIVEXP_EQ
// Source hash: md5:2411fb1f10cbc8974c1709a5a01ae732
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega)
Theorem PRIME_DIVEXP_EQ : forall n p x :e omega, prime_nat p -> (divides_nat p (x ^ n) <-> divides_nat p x /\ ~ n = 0).
Admitted.

// HOL Light: Library/prime.ml:782 / COPRIME_SOS
// Source hash: md5:a52b4a9c0ba8f078f97d99add372775b
// Status: transport_required (bridges: add_nat_add_SNo, exp_nat_exp_SNo_nat, hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem COPRIME_SOS : forall x y :e omega, gcd_int x y = 1 -> gcd_int (x * y) (x ^ 2 + y ^ 2) = 1.
Admitted.

// HOL Light: Library/prime.ml:786 / PRIME_IMP_NZ
// Source hash: md5:983121c1abb3dab5d912bcff4550c9ef
// Status: transport_required (bridges: hol_num_omega)
Theorem PRIME_IMP_NZ : forall p :e omega, prime_nat p -> ~ p = 0.
Admitted.

// HOL Light: Library/prime.ml:790 / DISTINCT_PRIME_COPRIME
// Source hash: md5:41a64c8003eb0e3075855aff82857e3e
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem DISTINCT_PRIME_COPRIME : forall p q :e omega, prime_nat p /\ (prime_nat q /\ ~ p = q) -> gcd_int p q = 1.
Admitted.

// HOL Light: Library/prime.ml:794 / PRIME_COPRIME_LT
// Source hash: md5:63f90b15dd56a85ac89f4495bc56ea3a
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, nat_lt_SNoLt)
Theorem PRIME_COPRIME_LT : forall x p :e omega, prime_nat p /\ (0 < x /\ x < p) -> gcd_int x p = 1.
Admitted.

// HOL Light: Library/prime.ml:799 / DIVIDES_PRIME_PRIME
// Source hash: md5:0592a060bf39cdd5974e202c2b9f559b
// Status: transport_required (bridges: hol_num_omega)
Theorem DIVIDES_PRIME_PRIME : forall p q :e omega, prime_nat p /\ prime_nat q -> (divides_nat p q <-> p = q).
Admitted.

// HOL Light: Library/prime.ml:803 / COPRIME_PRIME_PRIME
// Source hash: md5:b0d35fd56c0210091a44164fc6386508
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem COPRIME_PRIME_PRIME : forall p q :e omega, prime_nat p /\ prime_nat q -> (gcd_int p q = 1 <-> ~ p = q).
Admitted.

// HOL Light: Library/prime.ml:807 / DIVIDES_PRIME_EXP_LE
// Source hash: md5:d0e94ed489cb72de39653e86bbf2f9e1
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, nat_le_SNoLe)
Theorem DIVIDES_PRIME_EXP_LE : forall p q m n :e omega, prime_nat p /\ prime_nat q -> (divides_nat (p ^ m) (q ^ n) <-> m = 0 \/ p = q /\ m <= n).
Admitted.

// HOL Light: Library/prime.ml:817 / EQ_PRIME_EXP
// Source hash: md5:04ef64bec2da8e6926ac3ea7555656cf
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega)
Theorem EQ_PRIME_EXP : forall p q m n :e omega, prime_nat p /\ prime_nat q -> (p ^ m = q ^ n <-> m = 0 /\ n = 0 \/ p = q /\ m = n).
Admitted.

// HOL Light: Library/prime.ml:823 / PRIME_ODD
// Source hash: md5:fbeac058998bbc5de0c472624383c6b2
// Status: transport_required (bridges: hol_num_omega)
Theorem PRIME_ODD : forall p :e omega, prime_nat p -> p = 2 \/ odd_nat p.
Admitted.

// HOL Light: Library/prime.ml:829 / ODD_PRIME
// Source hash: md5:923325454928574801c4441294f86e1c
// Status: transport_required (bridges: hol_num_omega, nat_le_SNoLe)
Theorem ODD_PRIME : forall p :e omega, prime_nat p -> (odd_nat p <-> 3 <= p).
Admitted.

// HOL Light: Library/prime.ml:837 / DIVIDES_FACT_PRIME
// Source hash: md5:4bdf40b10719b19873ea63db906bf728
// Status: transport_required (bridges: hol_fact_factorial, hol_num_omega, nat_le_SNoLe)
Theorem DIVIDES_FACT_PRIME : forall p :e omega, prime_nat p -> forall n :e omega, divides_nat p (factorial n) <-> p <= n.
Admitted.

// HOL Light: Library/prime.ml:844 / EQ_PRIMEPOW
// Source hash: md5:544e58468bafb8c2908c4842fc252572
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega)
Theorem EQ_PRIMEPOW : forall p m n :e omega, prime_nat p -> (p ^ m = p ^ n <-> m = n).
Admitted.

// HOL Light: Library/prime.ml:849 / COPRIME_2
// Source hash: md5:a1fcb5141a3653612dfc98636842b766
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem COPRIME_2 : (forall n :e omega, gcd_int 2 n = 1 <-> odd_nat n) /\ forall n :e omega, gcd_int n 2 = 1 <-> odd_nat n.
Admitted.

// HOL Light: Library/prime.ml:854 / DIVIDES_EXP_PLUS1
// Source hash: md5:c80c71cd8b3f6edc83896f85132e76c9
// Status: transport_required (bridges: add_nat_add_SNo, exp_nat_exp_SNo_nat, hol_num_omega)
Theorem DIVIDES_EXP_PLUS1 : forall n k :e omega, odd_nat k -> divides_nat (n + 1) (n ^ k + 1).
Admitted.

// HOL Light: Library/prime.ml:863 / DIVIDES_EXP_MINUS1
// Source hash: md5:3b68b256b9690a27a87a2209976d246b
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega)
Theorem DIVIDES_EXP_MINUS1 : forall k n :e omega, divides_nat (minus_nat n 1) (minus_nat (n ^ k) 1).
Admitted.

// HOL Light: Library/prime.ml:875 / PRIME_IRREDUCIBLE
// Source hash: md5:351807e05594c2f49f0014e09e42136c
// Status: transport_required (bridges: hol_num_omega, mul_nat_mul_SNo, nat_lt_SNoLt)
Theorem PRIME_IRREDUCIBLE : forall p :e omega, prime_nat p <-> 1 < p /\ forall a b :e omega, divides_nat p (a * b) -> divides_nat p a \/ divides_nat p b.
Admitted.

// HOL Light: Library/prime.ml:882 / COPRIME_EXP_DIVPROD
// Source hash: md5:ce365ec766414bc3da9e5feb024f4639
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem COPRIME_EXP_DIVPROD : forall d n a b :e omega, divides_nat (d ^ n) (a * b) /\ gcd_int d a = 1 -> divides_nat (d ^ n) b.
Admitted.

// HOL Light: Library/prime.ml:887 / PRIME_COPRIME_CASES
// Source hash: md5:3817f00bf7d09abe59fb9a73e4fd69a6
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem PRIME_COPRIME_CASES : forall p a b :e omega, prime_nat p /\ gcd_int a b = 1 -> gcd_int p a = 1 \/ gcd_int p b = 1.
Admitted.

// HOL Light: Library/prime.ml:891 / PRIME_DIVPROD_POW_GEN
// Source hash: md5:1177b79602f1c17a5727fc8f68403bb0
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem PRIME_DIVPROD_POW_GEN : forall n p a b :e omega, prime_nat p /\ (~ divides_nat p (gcd_int a b) /\ divides_nat (p ^ n) (a * b)) -> divides_nat (p ^ n) a \/ divides_nat (p ^ n) b.
Admitted.

// HOL Light: Library/prime.ml:900 / PRIME_DIVPROD_POW_GEN_EQ
// Source hash: md5:35cdc612c14a22f1119117365d24cb4b
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem PRIME_DIVPROD_POW_GEN_EQ : forall n p a b :e omega, prime_nat p /\ ~ divides_nat p (gcd_int a b) -> (divides_nat (p ^ n) (a * b) <-> divides_nat (p ^ n) a \/ divides_nat (p ^ n) b).
Admitted.

// HOL Light: Library/prime.ml:907 / PRIME_DIVPROD_POW
// Source hash: md5:cbd79372890b8c42aabea45a18a92226
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem PRIME_DIVPROD_POW : forall n p a b :e omega, prime_nat p /\ (gcd_int a b = 1 /\ divides_nat (p ^ n) (a * b)) -> divides_nat (p ^ n) a \/ divides_nat (p ^ n) b.
Admitted.

// HOL Light: Library/prime.ml:912 / PRIME_DIVPROD_POW_EQ
// Source hash: md5:0f9e499f18f000f6a9f3a1462b76f20c
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem PRIME_DIVPROD_POW_EQ : forall n p a b :e omega, prime_nat p /\ gcd_int a b = 1 -> (divides_nat (p ^ n) (a * b) <-> divides_nat (p ^ n) a \/ divides_nat (p ^ n) b).
Admitted.

// HOL Light: Library/prime.ml:919 / PRIME_FACTOR_INDUCT
// Source hash: md5:8564a3a1d4827241fbf9ed846c8c838f
// Status: transport_required (bridges: hol_num_omega, mul_nat_mul_SNo)
Theorem PRIME_FACTOR_INDUCT : forall P:set -> prop, P 0 /\ (P 1 /\ (forall p n :e omega, prime_nat p /\ (~ n = 0 /\ P n) -> P (p * n))) -> forall n :e omega, P n.
Admitted.

// HOL Light: Library/prime.ml:935 / COMPLETE_FACTOR_INDUCT
// Source hash: md5:3533b5b0b9c100116fd89eb8461f0600
// Status: transport_required (bridges: hol_num_omega, mul_nat_mul_SNo)
Theorem COMPLETE_FACTOR_INDUCT : forall P:set -> prop, P 0 /\ (P 1 /\ ((forall p :e omega, prime_nat p -> P p) /\ (forall m n :e omega, P m /\ P n -> P (m * n)))) -> forall n :e omega, P n.
Admitted.

// HOL Light: Library/prime.ml:943 / PRIME_FACTOR_PARTITION
// Source hash: md5:bc0937034bc8fd504af2074e877be1c8
// Status: transport_required (bridges: hol_num_omega, mul_nat_mul_SNo)
Theorem PRIME_FACTOR_PARTITION : forall Q:set -> prop, forall n :e omega, ~ n = 0 -> exists n1 n2 :e omega, n1 * n2 = n /\ ((forall p :e omega, prime_nat p /\ divides_nat p n1 -> Q p) /\ forall p :e omega, prime_nat p /\ divides_nat p n2 -> ~ Q p).
Admitted.

// HOL Light: Library/prime.ml:963 / COPRIME_PAIR_DECOMP
// Source hash: md5:24cbc04eae34891dc5710af735751cf7
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem COPRIME_PAIR_DECOMP : forall n1 n2 m :e omega, gcd_int n1 n2 = 1 /\ ~ m = 0 -> exists m1 m2 :e omega, gcd_int m1 n1 = 1 /\ (gcd_int m2 n2 = 1 /\ (gcd_int m1 m2 = 1 /\ m1 * m2 = m)).
Admitted.

// HOL Light: Library/prime.ml:976 / EXP_MULT_EXISTS
// Source hash: md5:b6cbc7ed9a427aa66e722c0748d3ebc4
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, mul_nat_mul_SNo)
Theorem EXP_MULT_EXISTS : forall m n p k :e omega, ~ m = 0 /\ m ^ k * n = p ^ k -> exists q :e omega, n = q ^ k.
Admitted.

// HOL Light: Library/prime.ml:988 / COPRIME_POW
// Source hash: md5:eb78e2cb7a13a59c42b07c355da1a131
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem COPRIME_POW : forall n a b c :e omega, gcd_int a b = 1 /\ a * b = c ^ n -> exists r s :e omega, a = r ^ n /\ b = s ^ n.
Admitted.

// HOL Light: Library/prime.ml:1015 / PRIME_EXP
// Source hash: md5:d690556779a9b70f807bf3fd5ecba1f9
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega)
Theorem PRIME_EXP : forall p n :e omega, prime_nat (p ^ n) <-> prime_nat p /\ n = 1.
Admitted.

// HOL Light: Library/prime.ml:1034 / PRIME_POWER_MULT
// Source hash: md5:d370255d466fe2d198b3a6233bef0d9a
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, mul_nat_mul_SNo)
Theorem PRIME_POWER_MULT : forall k x y p :e omega, prime_nat p /\ x * y = p ^ k -> exists i j :e omega, x = p ^ i /\ y = p ^ j.
Admitted.

// HOL Light: Library/prime.ml:1055 / PRIME_POWER_EXP
// Source hash: md5:54a3dc02e9faa11e11be6864609c8f7f
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega)
Theorem PRIME_POWER_EXP : forall n x p k :e omega, prime_nat p /\ (~ n = 0 /\ x ^ n = p ^ k) -> exists i :e omega, x = p ^ i.
Admitted.

// HOL Light: Library/prime.ml:1062 / DIVIDES_PRIMEPOW
// Source hash: md5:3118275ac9ca3cc505cf7e7364b37508
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, nat_le_SNoLe)
Theorem DIVIDES_PRIMEPOW : forall k p :e omega, prime_nat p -> forall d :e omega, divides_nat d (p ^ k) <-> exists i :e omega, i <= k /\ d = p ^ i.
Admitted.

// HOL Light: Library/prime.ml:1078 / PRIMEPOW_DIVIDES_PROD
// Source hash: md5:68758fec43c10dadcf062a01e60d9ae1
// Status: transport_required (bridges: add_nat_add_SNo, exp_nat_exp_SNo_nat, hol_num_omega, mul_nat_mul_SNo)
Theorem PRIMEPOW_DIVIDES_PROD : forall p k m n :e omega, prime_nat p /\ divides_nat (p ^ k) (m * n) -> exists i j :e omega, divides_nat (p ^ i) m /\ (divides_nat (p ^ j) n /\ k = i + j).
Admitted.

// HOL Light: Library/prime.ml:1087 / EUCLID_BOUND
// Source hash: md5:24e53645d0544839ba3a70c2820663f3
// Status: transport_required (bridges: hol_fact_factorial, hol_num_omega, nat_le_SNoLe, nat_lt_SNoLt)
Theorem EUCLID_BOUND : forall n :e omega, exists p :e omega, prime_nat p /\ (n < p /\ p <= ordsucc (factorial n)).
Admitted.

// HOL Light: Library/prime.ml:1096 / EUCLID
// Source hash: md5:acb495b3973c1fd9b53a43001231991b
// Status: transport_required (bridges: hol_num_omega, nat_lt_SNoLt)
Theorem EUCLID : forall n :e omega, exists p :e omega, prime_nat p /\ n < p.
Admitted.

// HOL Light: Library/prime.ml:1100 / PRIMES_INFINITE
// Source hash: md5:62436f57679277a848b43f1e1c614f68
// Status: transport_required (bridges: hol_finite_finite, hol_num_omega)
Theorem PRIMES_INFINITE : infinite {p :e omega | prime_nat p}.
Admitted.

// HOL Light: Library/prime.ml:1105 / FACTORIZATION_INDEX
// Source hash: md5:91fc3a3555e5fdee320d51e0944b4cb0
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, nat_le_SNoLe, nat_lt_SNoLt)
Theorem FACTORIZATION_INDEX : forall n p :e omega, ~ n = 0 /\ 2 <= p -> exists k :e omega, divides_nat (p ^ k) n /\ forall l :e omega, k < l -> ~ divides_nat (p ^ l) n.
Admitted.

// HOL Light: Library/prime.ml:1121 / PRIMEPOW_FACTOR
// Source hash: md5:af106550d372921680cb7f905ef966ae
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo, nat_le_SNoLe)
Theorem PRIMEPOW_FACTOR : forall n :e omega, 2 <= n -> exists p k m :e omega, prime_nat p /\ (1 <= k /\ (gcd_int p m = 1 /\ n = p ^ k * m)).
Admitted.

// HOL Light: Library/prime.ml:1140 / PRIMEPOW_DIVISORS_DIVIDES
// Source hash: md5:d5d1e1c7c3a5518d6f4ba8a3128356f2
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega)
Theorem PRIMEPOW_DIVISORS_DIVIDES : forall m n :e omega, divides_nat m n <-> forall p k :e omega, prime_nat p /\ divides_nat (p ^ k) m -> divides_nat (p ^ k) n.
Admitted.

// HOL Light: Library/prime.ml:1186 / PRIMEPOW_DIVISORS_EQ
// Source hash: md5:bb0fe866aef39cb8e7e1df534fb809a4
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega)
Theorem PRIMEPOW_DIVISORS_EQ : forall m n :e omega, m = n <-> forall p k :e omega, prime_nat p -> (divides_nat (p ^ k) m <-> divides_nat (p ^ k) n).
Admitted.

// HOL Light: Library/prime.ml:1195 / CHINESE_REMAINDER
// Source hash: md5:82ce6626221e40105ea29532d2bbb191
// Status: transport_required (bridges: add_nat_add_SNo, hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem CHINESE_REMAINDER : forall a b u v :e omega, gcd_int a b = 1 /\ (~ a = 0 /\ ~ b = 0) -> exists x q1 q2 :e omega, x = u + q1 * a /\ x = v + q2 * b.
Admitted.

// HOL Light: Library/prime.ml:1225 / FINITE_EXP_LE
// Source hash: md5:c963abb6414228adf3b89f2a2437ded8
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_finite_finite, hol_num_omega, nat_le_SNoLe)
Theorem FINITE_EXP_LE : forall P:set -> prop, forall p n :e omega, 2 <= p -> finite {j :e omega | P j /\ p ^ j <= n}.
Admitted.

// HOL Light: Library/prime.ml:1234 / FINITE_INDICES
// Source hash: md5:7b3d46d8986a0c4ea2040dcbd8f40072
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_finite_finite, hol_num_omega, nat_le_SNoLe)
Theorem FINITE_INDICES : forall P:set -> prop, forall p n :e omega, 2 <= p /\ ~ n = 0 -> finite {j :e omega | P j /\ divides_nat (p ^ j) n}.
Admitted.

// HOL Light: Library/prime.ml:1241 / index_def
// Source hash: md5:6bd37732135c5f62978cb78e7e809cbc
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_card_finite_cardinality, hol_num_omega, nat_le_SNoLe)
Theorem index_def : forall p n :e omega, prime_index p n = if p <= 1 \/ n = 0 then 0 else finite_cardinality {j :e omega | 1 <= j /\ divides_nat (p ^ j) n}.
Admitted.

// HOL Light: Library/prime.ml:1245 / INDEX_0
// Source hash: md5:8458285aff94b6e0856e5107e77c3670
// Status: transport_required (bridges: hol_num_omega)
Theorem INDEX_0 : forall p :e omega, prime_index p 0 = 0.
Admitted.

// HOL Light: Library/prime.ml:1249 / PRIMEPOW_DIVIDES_INDEX
// Source hash: md5:b2f1fed15cecc4d94b26449a07b55b8b
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, nat_le_SNoLe)
Theorem PRIMEPOW_DIVIDES_INDEX : forall n p k :e omega, divides_nat (p ^ k) n <-> n = 0 \/ (p = 1 \/ k <= prime_index p n).
Admitted.

// HOL Light: Library/prime.ml:1268 / LE_INDEX
// Source hash: md5:8c7b7c31c978f70110be3af719c88180
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, nat_le_SNoLe)
Theorem LE_INDEX : forall n p k :e omega, k <= prime_index p n <-> (n = 0 \/ p = 1 -> k = 0) /\ divides_nat (p ^ k) n.
Admitted.

// HOL Light: Library/prime.ml:1276 / EXP_INDEX_DIVIDES
// Source hash: md5:0a33898996306e5470b2f56545b07d90
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega)
Theorem EXP_INDEX_DIVIDES : forall p n :e omega, divides_nat (p ^ prime_index p n) n.
Admitted.

// HOL Light: Library/prime.ml:1280 / INDEX_LT
// Source hash: md5:c8c051505ae9313a7635d0c801daa7df
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, nat_lt_SNoLt)
Theorem INDEX_LT : forall n p k :e omega, (~ n = 0 \/ ~ k = 0) /\ n < p ^ k -> prime_index p n < k.
Admitted.

// HOL Light: Library/prime.ml:1288 / INDEX_1
// Source hash: md5:faeaeb09a2c5a17189d66e6478f80652
// Status: transport_required (bridges: hol_num_omega)
Theorem INDEX_1 : forall p :e omega, prime_index p 1 = 0.
Admitted.

// HOL Light: Library/prime.ml:1296 / INDEX_MUL
// Source hash: md5:4bbe0dd31124881e7be28e9ab12bdc51
// Status: transport_required (bridges: add_nat_add_SNo, hol_num_omega, mul_nat_mul_SNo)
Theorem INDEX_MUL : forall p m n :e omega, prime_nat p /\ (~ m = 0 /\ ~ n = 0) -> prime_index p (m * n) = prime_index p m + prime_index p n.
Admitted.

// HOL Light: Library/prime.ml:1310 / INDEX_EXP
// Source hash: md5:f486787020d51e9d2aea88817d484160
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, mul_nat_mul_SNo)
Theorem INDEX_EXP : forall p n k :e omega, prime_nat p -> prime_index p (n ^ k) = k * prime_index p n.
Admitted.

// HOL Light: Library/prime.ml:1320 / INDEX_FACT
// Source hash: md5:5e8edbddd8716ec29ece74fbc8c1775f
// Status: transport_required (bridges: hol_fact_factorial, hol_nsum_finsum, hol_num_omega)
Theorem INDEX_FACT : forall p n :e omega, prime_nat p -> prime_index p (factorial n) = finsum (idx_n n) (fun m:set => prime_index p m).
Admitted.

// HOL Light: Library/prime.ml:1326 / INDEX_FACT_ALT
// Source hash: md5:ace1de072996d32b56e26798ce997688
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_fact_factorial, hol_nsum_finsum, hol_num_omega, nat_le_SNoLe)
Theorem INDEX_FACT_ALT : forall p n :e omega, prime_nat p -> prime_index p (factorial n) = finsum {j :e omega | 1 <= j /\ p ^ j <= n} (fun j:set => div_nat n (p ^ j)).
Admitted.

// HOL Light: Library/prime.ml:1360 / INDEX_FACT_UNBOUNDED
// Source hash: md5:d2d98716c76d68411d78bd064821001e
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_fact_factorial, hol_nsum_finsum, hol_num_omega, nat_le_SNoLe)
Theorem INDEX_FACT_UNBOUNDED : forall p n :e omega, prime_nat p -> prime_index p (factorial n) = finsum {j :e omega | 1 <= j} (fun j:set => div_nat n (p ^ j)).
Admitted.

// HOL Light: Library/prime.ml:1368 / PRIMEPOW_DIVIDES_FACT
// Source hash: md5:8d3fe7c42f0b645b586e9d1a6fd11d42
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_fact_factorial, hol_nsum_finsum, hol_num_omega, nat_le_SNoLe)
Theorem PRIMEPOW_DIVIDES_FACT : forall p n k :e omega, prime_nat p -> (divides_nat (p ^ k) (factorial n) <-> k <= finsum {j :e omega | 1 <= j /\ p ^ j <= n} (fun j:set => div_nat n (p ^ j))).
Admitted.

// HOL Light: Library/prime.ml:1375 / INDEX_REFL
// Source hash: md5:2f33e484821c5520effbad9e52493e20
// Status: transport_required (bridges: hol_num_omega, nat_le_SNoLe)
Theorem INDEX_REFL : forall n :e omega, prime_index n n = if n <= 1 then 0 else 1.
Admitted.

// HOL Light: Library/prime.ml:1383 / INDEX_EQ_0
// Source hash: md5:0da1847923c47e95c7e4c5ea7be9b144
// Status: transport_required (bridges: hol_num_omega)
Theorem INDEX_EQ_0 : forall p n :e omega, prime_index p n = 0 <-> n = 0 \/ (p = 1 \/ ~ divides_nat p n).
Admitted.

// HOL Light: Library/prime.ml:1389 / INDEX_ZERO
// Source hash: md5:6a01886df791d47c0fc591d917ec2866
// Status: transport_required (bridges: hol_num_omega)
Theorem INDEX_ZERO : forall p n :e omega, ~ divides_nat p n -> prime_index p n = 0.
Admitted.

// HOL Light: Library/prime.ml:1393 / INDEX_POW
// Source hash: md5:9136795188a1f400201eaab1c084be4c
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega)
Theorem INDEX_POW : forall p n k :e omega, prime_index (p ^ k) n = div_nat (prime_index p n) k.
Admitted.

// HOL Light: Library/prime.ml:1402 / INDEX_PRIME
// Source hash: md5:3d22deec7d913f6fd3f7002274ba12b4
// Status: transport_required (bridges: hol_num_omega)
Theorem INDEX_PRIME : forall p a :e omega, prime_nat p -> prime_index a p = if p = a then 1 else 0.
Admitted.

// HOL Light: Library/prime.ml:1409 / INDEX_TRIVIAL_BOUND
// Source hash: md5:94c9517a9768c9f6f9ddc04e2a398c4a
// Status: transport_required (bridges: hol_num_omega, nat_le_SNoLe)
Theorem INDEX_TRIVIAL_BOUND : forall n p :e omega, prime_index p n <= n.
Admitted.

// HOL Light: Library/prime.ml:1424 / INDEX_DECOMPOSITION
// Source hash: md5:ad640e22a809fa1157f077084a10bec0
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, mul_nat_mul_SNo)
Theorem INDEX_DECOMPOSITION : forall n p :e omega, exists m :e omega, p ^ prime_index p n * m = n /\ (n = 0 \/ (p = 1 \/ ~ divides_nat p m)).
Admitted.

// HOL Light: Library/prime.ml:1440 / INDEX_DECOMPOSITION_PRIME
// Source hash: md5:cf72804d62dec999dd94335a79fa67ed
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem INDEX_DECOMPOSITION_PRIME : forall n p :e omega, prime_nat p -> exists m :e omega, p ^ prime_index p n * m = n /\ (n = 0 \/ gcd_int p m = 1).
Admitted.

// HOL Light: Library/prime.ml:1449 / INDEX_DECOMPOSITION_LE
// Source hash: md5:b40e388ec8b73ca2f669d8835e5a1da3
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, mul_nat_mul_SNo, nat_le_SNoLe)
Theorem INDEX_DECOMPOSITION_LE : forall p e1 m1 e2 m2 :e omega, p ^ e1 * m1 = p ^ e2 * m2 /\ (~ p = 0 /\ ~ divides_nat p m2) -> e1 <= e2.
Admitted.

// HOL Light: Library/prime.ml:1460 / INDEX_DECOMPOSITION_UNIQUE
// Source hash: md5:06d4cc1fb10ec7258e702e8b4b8aa872
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, mul_nat_mul_SNo)
Theorem INDEX_DECOMPOSITION_UNIQUE : forall p e1 m1 e2 m2 :e omega, p ^ e1 * m1 = p ^ e2 * m2 /\ (~ p = 0 /\ (~ divides_nat p m1 /\ ~ divides_nat p m2)) -> e1 = e2.
Admitted.

// HOL Light: Library/prime.ml:1468 / INDEX_UNIQUE
// Source hash: md5:36b170fef22d9b5277ebec90cefa78de
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, mul_nat_mul_SNo)
Theorem INDEX_UNIQUE : forall p m n e0 :e omega, p ^ e0 * m = n /\ ((p = 0 -> e0 = 0) /\ ~ divides_nat p m) -> prime_index p n = e0.
Admitted.

// HOL Light: Library/prime.ml:1485 / INDEX_UNIQUE_EQ
// Source hash: md5:a73443ec2f4834d9bce212af82430109
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, nat_le_SNoLe)
Theorem INDEX_UNIQUE_EQ : forall n p k :e omega, prime_index p n = k <-> (p = 1 \/ n = 0 -> k = 0) /\ (~ (p = 1 \/ n = 0) -> forall j :e omega, divides_nat (p ^ j) n <-> j <= k).
Admitted.

// HOL Light: Library/prime.ml:1495 / INDEX_UNIQUE_ALT
// Source hash: md5:10abf45142ea731b8a97fc7abcca17e8
// Status: transport_required (bridges: add_nat_add_SNo, exp_nat_exp_SNo_nat, hol_num_omega)
Theorem INDEX_UNIQUE_ALT : forall n p k :e omega, prime_index p n = k <-> (p = 1 \/ n = 0 -> k = 0) /\ (~ (p = 1 \/ n = 0) -> divides_nat (p ^ k) n /\ ~ divides_nat (p ^ (k + 1)) n).
Admitted.

// HOL Light: Library/prime.ml:1509 / INDEX_ADD_MIN
// Source hash: md5:b7c9b686332abad82b77ff1168451f0a
// Status: transport_required (bridges: add_nat_add_SNo, hol_num_omega, nat_le_SNoLe)
Theorem INDEX_ADD_MIN : forall p m n :e omega, (if prime_index p m <= prime_index p n then prime_index p m else prime_index p n) <= prime_index p (m + n).
Admitted.

// HOL Light: Library/prime.ml:1520 / INDEX_SUB_MIN
// Source hash: md5:d6509ede7edef102d57c3d7e05b84a5e
// Status: transport_required (bridges: hol_num_omega, nat_le_SNoLe, nat_lt_SNoLt)
Theorem INDEX_SUB_MIN : forall p m n :e omega, n < m -> (if prime_index p m <= prime_index p n then prime_index p m else prime_index p n) <= prime_index p (minus_nat m n).
Admitted.

// HOL Light: Library/prime.ml:1532 / INDEX_ADD
// Source hash: md5:56a1a5f9f4f72716998d0c64a5d18a68
// Status: transport_required (bridges: add_nat_add_SNo, hol_num_omega, nat_lt_SNoLt)
Theorem INDEX_ADD : forall p n m :e omega, ~ n = 0 /\ (~ m = 0 -> prime_index p n < prime_index p m) -> prime_index p (m + n) = prime_index p n.
Admitted.

// HOL Light: Library/prime.ml:1546 / INDEX_MULT_BASE
// Source hash: md5:7e19c9f793568875c41019982be1ebfc
// Status: transport_required (bridges: add_nat_add_SNo, hol_num_omega, mul_nat_mul_SNo, nat_le_SNoLe)
Theorem INDEX_MULT_BASE : (forall p n :e omega, prime_index p (p * n) = if p <= 1 \/ n = 0 then 0 else prime_index p n + 1) /\ forall p n :e omega, prime_index p (n * p) = if p <= 1 \/ n = 0 then 0 else prime_index p n + 1.
Admitted.

// HOL Light: Library/prime.ml:1560 / INDEX_MULT_EXP
// Source hash: md5:bcf89e56b1ed98336df217a8601a3a98
// Status: transport_required (bridges: add_nat_add_SNo, exp_nat_exp_SNo_nat, hol_num_omega, mul_nat_mul_SNo, nat_le_SNoLe)
Theorem INDEX_MULT_EXP : (forall p n k :e omega, prime_index p (p ^ k * n) = if p <= 1 \/ n = 0 then 0 else k + prime_index p n) /\ forall p n k :e omega, prime_index p (n * p ^ k) = if n = 0 \/ p <= 1 then 0 else prime_index p n + k.
Admitted.

// HOL Light: Library/prime.ml:1575 / INDEX_MULT_ADD
// Source hash: md5:f804a8a470e85a8d438c81706161a00d
// Status: transport_required (bridges: add_nat_add_SNo, exp_nat_exp_SNo_nat, hol_num_omega, mul_nat_mul_SNo, nat_lt_SNoLt)
Theorem INDEX_MULT_ADD : (forall p m n k :e omega, ~ n = 0 /\ prime_index p n < k -> prime_index p (p ^ k * m + n) = prime_index p n) /\ ((forall p m n k :e omega, ~ n = 0 /\ prime_index p n < k -> prime_index p (m * p ^ k + n) = prime_index p n) /\ ((forall p m n k :e omega, ~ n = 0 /\ prime_index p n < k -> prime_index p (n + m * p ^ k) = prime_index p n) /\ forall p m n k :e omega, ~ n = 0 /\ prime_index p n < k -> prime_index p (n + p ^ k * m) = prime_index p n)).
Admitted.

// HOL Light: Library/prime.ml:1591 / INDEX_NSUM_LE
// Source hash: md5:55346c8727457f2689e2b01ce4a849f4
// Status: generalization_required (bridges: empty_case:A, hol_finite_finite, hol_nsum_finsum, hol_num_omega, nat_le_SNoLe)
Theorem INDEX_NSUM_LE : forall A:set, forall f:set -> set, (forall x :e A, f x :e omega) -> forall p n :e omega, forall k c= A, finite k /\ (~ k = Empty /\ (forall a :e A, a :e k -> n <= prime_index p (f a))) -> n <= prime_index p (finsum k f).
Admitted.

// HOL Light: Library/prime.ml:1601 / DIVIDES_INDEX
// Source hash: md5:17cc3380d7badd8c7ac60df7cbfc709f
// Status: transport_required (bridges: hol_num_omega, nat_le_SNoLe)
Theorem DIVIDES_INDEX : forall m n :e omega, divides_nat m n <-> n = 0 \/ ~ m = 0 /\ forall p :e omega, prime_nat p -> prime_index p m <= prime_index p n.
Admitted.

// HOL Light: Library/prime.ml:1613 / EQ_INDEX
// Source hash: md5:8cc7668e40f4bb4c61c22bad324e30f6
// Status: transport_required (bridges: hol_num_omega)
Theorem EQ_INDEX : forall m n :e omega, m = n <-> (m = 0 <-> n = 0) /\ forall p :e omega, prime_nat p -> prime_index p m = prime_index p n.
Admitted.

// HOL Light: Library/prime.ml:1620 / COPRIME_INDEX
// Source hash: md5:a9a7342d19f2a207a74b3448c1905fd1
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem COPRIME_INDEX : forall m n :e omega, gcd_int m n = 1 <-> (m = 0 -> n = 1) /\ ((n = 0 -> m = 1) /\ forall p :e omega, prime_nat p -> prime_index p m = 0 \/ prime_index p n = 0).
Admitted.

// HOL Light: Library/prime.ml:1629 / INDEX_GCD
// Source hash: md5:8514386bb045c8e9a113f367cfc5baad
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem INDEX_GCD : forall m n p :e omega, prime_nat p -> prime_index p (gcd_int m n) = if m = 0 then prime_index p n else if n = 0 then prime_index p m else if prime_index p m <= prime_index p n then prime_index p m else prime_index p n.
Admitted.

// HOL Light: Library/prime.ml:1647 / FORALL_PRIME_INDEX
// Source hash: md5:c31b6b94bf13396a4c5c09f8a12b079a
// Status: transport_required (bridges: hol_num_omega)
Theorem FORALL_PRIME_INDEX : (forall p :e omega, prime_nat p -> forall P:set -> prop, (forall x :e omega, P (prime_index p x)) <-> forall k :e omega, P k) /\ forall p :e omega, prime_nat p -> forall P:set -> prop, (forall x :e omega, ~ x = 0 -> P (prime_index p x)) <-> forall k :e omega, P k.
Admitted.

// HOL Light: Library/prime.ml:1656 / INDEX_FACT_PRIME_MULT
// Source hash: md5:32dad8032ca835b4088003f0b36bdb63
// Status: transport_required (bridges: add_nat_add_SNo, hol_fact_factorial, hol_num_omega, mul_nat_mul_SNo)
Theorem INDEX_FACT_PRIME_MULT : forall p n :e omega, prime_nat p -> prime_index p (factorial (p * n)) = n + prime_index p (factorial n).
Admitted.

// HOL Light: Library/prime.ml:1678 / PRIME_FACTORIZATION_INDEX
// Source hash: md5:3ad8b2203a481b7c8d6769961f7b2498
// Status: transport_required (bridges: hol_finite_finite, hol_num_omega)
Theorem PRIME_FACTORIZATION_INDEX : forall k:set -> set, (forall x :e omega, k x :e omega) -> finite {p :e omega | prime_nat p /\ ~ k p = 0} -> exists n :e omega, ~ n = 0 /\ forall p :e omega, prime_nat p -> prime_index p n = k p.
Admitted.

// HOL Light: Library/prime.ml:1707 / PRIME_POWER_EXISTS
// Source hash: md5:d71248f382cd095abda4160594adc2c2
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega)
Theorem PRIME_POWER_EXISTS : forall n q :e omega, prime_nat q -> ((exists i :e omega, n = q ^ i) <-> forall p :e omega, prime_nat p /\ divides_nat p n -> p = q).
Admitted.

// HOL Light: Library/prime.ml:1732 / PRIME_POWER_EXISTS_ALT
// Source hash: md5:657a5d22d61e1485170198a4addde9d1
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega)
Theorem PRIME_POWER_EXISTS_ALT : forall n p :e omega, prime_nat p -> ((exists i :e omega, n = p ^ i) <-> forall d :e omega, divides_nat d n -> d = 1 \/ divides_nat p d).
Admitted.

// HOL Light: Library/prime.ml:1740 / PRIME_FACTORIZATION_ALT
// Source hash: md5:260a5413ab81b955ae45c5d0b201d311
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_nproduct_finprod, hol_num_omega)
Theorem PRIME_FACTORIZATION_ALT : forall n :e omega, ~ n = 0 -> finprod {p :e omega | prime_nat p} (fun p:set => p ^ prime_index p n) = n.
Admitted.

// HOL Light: Library/prime.ml:1767 / PRIME_FACTORIZATION
// Source hash: md5:62d3fbcc6fd5fbedeb96c767afcfa3ec
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_nproduct_finprod, hol_num_omega)
Theorem PRIME_FACTORIZATION : forall n :e omega, ~ n = 0 -> finprod {p :e omega | prime_nat p /\ divides_nat p n} (fun p:set => p ^ prime_index p n) = n.
Admitted.

// HOL Light: Library/prime.ml:1782 / lcm
// Source hash: md5:7e6d8867fca1c23a07f66302a830c04d
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem lcm : forall m n :e omega, lcm_int m n = if m * n = 0 then 0 else div_nat (m * n) (gcd_int m n).
Admitted.

// HOL Light: Library/prime.ml:1788 / LCM_DIVIDES
// Source hash: md5:f5d98ece37af4806a440a1e997591607
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem LCM_DIVIDES : forall m n d :e omega, divides_nat (lcm_int m n) d <-> divides_nat m d /\ divides_nat n d.
Admitted.

// HOL Light: Library/prime.ml:1792 / LCM
// Source hash: md5:d53fa331eabbf3d52d3ad3cce746ce5a
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem LCM : forall m n :e omega, divides_nat m (lcm_int m n) /\ (divides_nat n (lcm_int m n) /\ forall d :e omega, divides_nat m d /\ divides_nat n d -> divides_nat (lcm_int m n) d).
Admitted.

// HOL Light: Library/prime.ml:1798 / LCM_DIVIDES_MUL
// Source hash: md5:0c219ef9dd3ef15bc0408a6c2fafa500
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem LCM_DIVIDES_MUL : forall m n :e omega, divides_nat (lcm_int m n) (m * n).
Admitted.

// HOL Light: Library/prime.ml:1802 / DIVIDES_LCM
// Source hash: md5:5a66a4054856a2a72046ce243bdb773b
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem DIVIDES_LCM : forall m n r :e omega, divides_nat r m \/ divides_nat r n -> divides_nat r (lcm_int m n).
Admitted.

// HOL Light: Library/prime.ml:1809 / LCM_0
// Source hash: md5:71bfdbcd6492e1c9d49ae63fec77e4f6
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem LCM_0 : (forall n :e omega, lcm_int 0 n = 0) /\ forall n :e omega, lcm_int n 0 = 0.
Admitted.

// HOL Light: Library/prime.ml:1813 / LCM_1
// Source hash: md5:d57be2da21d706372db611b00060afda
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem LCM_1 : (forall n :e omega, lcm_int 1 n = n) /\ forall n :e omega, lcm_int n 1 = n.
Admitted.

// HOL Light: Library/prime.ml:1817 / LCM_SYM
// Source hash: md5:8841ae55dde92073ccd41cc412230507
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem LCM_SYM : forall m n :e omega, lcm_int m n = lcm_int n m.
Admitted.

// HOL Light: Library/prime.ml:1821 / DIVIDES_LCM_GCD
// Source hash: md5:009f2c22046f2f2c62635128e164aa95
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem DIVIDES_LCM_GCD : forall m n d :e omega, divides_nat d (lcm_int m n) <-> divides_nat (d * gcd_int m n) (m * n).
Admitted.

// HOL Light: Library/prime.ml:1825 / PRIMEPOW_DIVIDES_LCM
// Source hash: md5:1c615468192a92248abba0b990068dd2
// Status: transport_required (bridges: exp_nat_exp_SNo_nat, hol_num_omega, hol_prod_setprod)
Theorem PRIMEPOW_DIVIDES_LCM : forall m n p k :e omega, prime_nat p -> (divides_nat (p ^ k) (lcm_int m n) <-> divides_nat (p ^ k) m \/ divides_nat (p ^ k) n).
Admitted.

// HOL Light: Library/prime.ml:1873 / PRIME_DIVIDES_LCM
// Source hash: md5:e44046d526f62578dcd64680287246bf
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem PRIME_DIVIDES_LCM : forall m n p :e omega, prime_nat p -> (divides_nat p (lcm_int m n) <-> divides_nat p m \/ divides_nat p n).
Admitted.

// HOL Light: Library/prime.ml:1881 / LCM_ZERO
// Source hash: md5:7802be9e3604398e1570b5189f096552
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem LCM_ZERO : forall m n :e omega, lcm_int m n = 0 <-> m = 0 \/ n = 0.
Admitted.

// HOL Light: Library/prime.ml:1889 / INDEX_LCM
// Source hash: md5:e1e65522f4a45a1abbb7470606f02f9c
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem INDEX_LCM : forall m n p :e omega, prime_nat p -> prime_index p (lcm_int m n) = if m = 0 \/ n = 0 then 0 else if prime_index p m <= prime_index p n then prime_index p n else prime_index p m.
Admitted.

// HOL Light: Library/prime.ml:1905 / LCM_ASSOC
// Source hash: md5:16abb6a8b67ffd02324c3a906e403178
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem LCM_ASSOC : forall m n p :e omega, lcm_int m (lcm_int n p) = lcm_int (lcm_int m n) p.
Admitted.

// HOL Light: Library/prime.ml:1911 / LCM_REFL
// Source hash: md5:d31e92cb8b415428e0064194bef5ef94
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem LCM_REFL : forall n :e omega, lcm_int n n = n.
Admitted.

// HOL Light: Library/prime.ml:1916 / LCM_MULTIPLE
// Source hash: md5:7d60a6c6bd194322185b0ca656888050
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem LCM_MULTIPLE : forall a b :e omega, lcm_int b (a * b) = a * b.
Admitted.

// HOL Light: Library/prime.ml:1920 / LCM_GCD_DISTRIB
// Source hash: md5:88439aef1688656a2d68b425e4da74c4
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem LCM_GCD_DISTRIB : forall a b c :e omega, lcm_int a (gcd_int b c) = gcd_int (lcm_int a b) (lcm_int a c).
Admitted.

// HOL Light: Library/prime.ml:1925 / GCD_LCM_DISTRIB
// Source hash: md5:7adc6ef8339436f2b0e1f855bd370d77
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem GCD_LCM_DISTRIB : forall a b c :e omega, gcd_int a (lcm_int b c) = lcm_int (gcd_int a b) (gcd_int a c).
Admitted.

// HOL Light: Library/prime.ml:1930 / LCM_UNIQUE
// Source hash: md5:657f35e22c5afcf575bc26b4cbd43dca
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem LCM_UNIQUE : forall d m n :e omega, divides_nat m d /\ (divides_nat n d /\ (forall e0 :e omega, divides_nat m e0 /\ divides_nat n e0 -> divides_nat d e0)) <-> d = lcm_int m n.
Admitted.

// HOL Light: Library/prime.ml:1938 / LCM_EQ
// Source hash: md5:d70a2db3e126ae59bdc9150dff4c6a87
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem LCM_EQ : forall x y u v :e omega, (forall d :e omega, divides_nat x d /\ divides_nat y d <-> divides_nat u d /\ divides_nat v d) -> lcm_int x y = lcm_int u v.
Admitted.

// HOL Light: Library/prime.ml:1943 / LCM_EQ_1
// Source hash: md5:8fd711dfb464c16686ee764292af124a
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem LCM_EQ_1 : forall m n :e omega, lcm_int m n = 1 <-> m = 1 /\ n = 1.
Admitted.

