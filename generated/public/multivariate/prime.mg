// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem GCD_EQ : forall x y u v :e omega, (forall d :e omega, divides_nat d x /\ divides_nat d y <-> divides_nat d u /\ divides_nat d v) -> gcd_int x y = gcd_int u v.
Admitted.

// HOL Light: Library/prime.ml:307 / BEZOUT_GCD_STRONG
// Source hash: md5:fb852b5bf4c80123c4b7481927183f15
// Status: transport_required (bridges: add_nat_add_SNo, hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem BEZOUT_GCD_STRONG : forall a b :e omega, ~ a = 0 -> exists x y :e omega, a * x = b * y + gcd_int a b.
Admitted.

// HOL Light: Library/prime.ml:325 / BEZOUT_ADD_STRONG
// Source hash: md5:c3c0549a7f524300fe4d5d1c1ecb84d1
// Status: transport_required (bridges: add_nat_add_SNo, hol_num_omega, mul_nat_mul_SNo)
Theorem BEZOUT_ADD_STRONG : forall a b :e omega, ~ a = 0 -> exists d x y :e omega, divides_nat d a /\ (divides_nat d b /\ a * x = b * y + d).
Admitted.

// HOL Light: Library/prime.ml:330 / BEZOUT_GCD
// Source hash: md5:33965d7d8723028029396146d621bd6d
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem BEZOUT_GCD : forall a b :e omega, exists x y :e omega, minus_nat (a * x) (b * y) = gcd_int a b \/ minus_nat (b * x) (a * y) = gcd_int a b.
Admitted.

// HOL Light: Library/prime.ml:340 / BEZOUT_ADD
// Source hash: md5:947027bfc23f30677bb92dd615cdd8ad
// Status: transport_required (bridges: add_nat_add_SNo, hol_num_omega, mul_nat_mul_SNo)
Theorem BEZOUT_ADD : forall a b :e omega, exists d x y :e omega, divides_nat d a /\ divides_nat d b /\ (a * x = b * y + d \/ b * x = a * y + d).
Admitted.

// HOL Light: Library/prime.ml:347 / BEZOUT
// Source hash: md5:d37f8c6e08b23dedd3967e9944411a41
// Status: transport_required (bridges: hol_num_omega, mul_nat_mul_SNo)
Theorem BEZOUT : forall a b :e omega, exists d x y :e omega, divides_nat d a /\ divides_nat d b /\ (minus_nat (a * x) (b * y) = d \/ minus_nat (b * x) (a * y) = d).
Admitted.

// HOL Light: Library/prime.ml:352 / GCD_BEZOUT
// Source hash: md5:219a2d306b18f30646f4b24b6dea399e
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem GCD_BEZOUT : forall a b d :e omega, (exists x y :e omega, minus_nat (a * x) (b * y) = d \/ minus_nat (b * x) (a * y) = d) <-> divides_nat (gcd_int a b) d.
Admitted.

// HOL Light: Library/prime.ml:365 / GCD_LE
// Source hash: md5:a3c3f01310ddb33ee3b2625084be2618
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, nat_le_SNoLe)
Theorem GCD_LE : (forall m n :e omega, gcd_int m n <= m <-> m = 0 -> n = 0) /\ forall m n :e omega, gcd_int m n <= n <-> n = 0 -> m = 0.
Admitted.

// HOL Light: Library/prime.ml:374 / GCD_LE_MIN_EQ
// Source hash: md5:90e920e15e43429465f7d8e8b649e6c9
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, nat_le_SNoLe)
Theorem GCD_LE_MIN_EQ : forall m n :e omega, gcd_int m n <= (if m <= n then m else n) <-> (m = 0 <-> n = 0).
Admitted.

// HOL Light: Library/prime.ml:384 / GCD_LE_MIN
// Source hash: md5:82f11bd5b4415bfaac5eae4b9e3774b9
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, nat_le_SNoLe)
Theorem GCD_LE_MIN : forall m n :e omega, (m = 0 <-> n = 0) -> gcd_int m n <= if m <= n then m else n.
Admitted.

// HOL Light: Library/prime.ml:388 / GCD_LE_MAX
// Source hash: md5:1c776adbb6e130c576543c678d4ceea7
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, nat_le_SNoLe)
Theorem GCD_LE_MAX : forall m n :e omega, gcd_int m n <= if m <= n then n else m.
Admitted.

// HOL Light: Library/prime.ml:402 / COPRIME
// Source hash: md5:3132c70ab357e89df2d3f4ea8340d1ec
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem COPRIME : forall a b :e omega, gcd_int a b = 1 <-> forall d :e omega, divides_nat d a /\ divides_nat d b <-> d = 1.
Admitted.

