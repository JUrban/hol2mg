// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem COPRIME_DIVISORS : forall a b d e0 :e omega, divides_nat d a /\ (divides_nat e0 b /\ gcd_int a b = 1) -> gcd_int d e0 = 1.
Admitted.

