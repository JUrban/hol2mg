// Source hash: md5:9f49b538da2047d9e9fe4b1bd90704d3
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem LCM_COPRIME_DECOMP : forall m n :e omega, exists m' n' :e omega, divides_nat m' m /\ (divides_nat n' n /\ (gcd_int m' n' = 1 /\ m' * n' = lcm_int m n)).
Admitted.

