// Source hash: md5:390559e6ae10d0fa154b52d4f0e4a173
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem COPRIME_DIVPROD : forall d a b :e omega, divides_nat d (a * b) /\ gcd_int d a = 1 -> divides_nat d b.
Admitted.

// HOL Light: Library/prime.ml:430 / COPRIME_1
// Source hash: md5:f8dd5683481b462fcb65f5dd476a09b6
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem COPRIME_1 : (forall a :e omega, gcd_int a 1 = 1) /\ forall a :e omega, gcd_int 1 a = 1.
Admitted.

// HOL Light: Library/prime.ml:434 / GCD_COPRIME
// Source hash: md5:67ad95ed63085b90d9ec81d8a025d654
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem GCD_COPRIME : forall a b a' b' :e omega, ~ gcd_int a b = 0 /\ (a = a' * gcd_int a b /\ b = b' * gcd_int a b) -> gcd_int a' b' = 1.
Admitted.

// HOL Light: Library/prime.ml:439 / GCD_COPRIME_EXISTS
// Source hash: md5:01f02f1ddb116d0a9e91fe70d62428f3
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem GCD_COPRIME_EXISTS : forall a b :e omega, exists a' b' :e omega, a = a' * gcd_int a b /\ (b = b' * gcd_int a b /\ gcd_int a' b' = 1).
Admitted.

// HOL Light: Library/prime.ml:451 / COPRIME_DIVPROD_IFF
// Source hash: md5:97a0d2bb2b5df3bdebe7aeb4618e6afd
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem COPRIME_DIVPROD_IFF : forall d a :e omega, ~ d = 0 -> ((forall b :e omega, divides_nat d (a * b) -> divides_nat d b) <-> gcd_int d a = 1).
Admitted.

// HOL Light: Library/prime.ml:461 / CONG_MULT_LCANCEL_IFF
// Source hash: md5:b25325fb44117486cd393a396bd7123b
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem CONG_MULT_LCANCEL_IFF : forall a n :e omega, ~ n = 0 -> ((forall x y :e omega, (exists q1 q2 :e omega, a * x + n * q1 = a * y + n * q2) -> exists q1 q2 :e omega, x + n * q1 = y + n * q2) <-> gcd_int a n = 1).
Admitted.

