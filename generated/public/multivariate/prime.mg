// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod, mul_nat_mul_SNo)
Theorem DIVIDES_MUL : forall m n r :e omega, divides_nat m r /\ (divides_nat n r /\ gcd_int m n = 1) -> divides_nat (m * n) r.
