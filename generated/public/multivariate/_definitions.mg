// HOL Light: Multivariate/integration.ml:16611 / vector_variation   (hash md5:ee712d26d3c80c8f4afb9a297e9592bd)
Definition vector_variation : set -> set -> (set -> set) -> set :=
  fun N:set => fun s:set => fun f:set -> set => set_variation 1 N s (fun k:set => vector_sub N (f (interval_upperbound 1 k)) (f (interval_lowerbound 1 k))).

// HOL Light: Multivariate/integration.ml:22442 / absolutely_setcontinuous_on   (hash md5:a39d6b5bed61a9c494a9af9f86953762)
Definition absolutely_setcontinuous_on : set -> set -> (set -> set) -> set -> prop :=
  fun M:set => fun N:set => fun f:set -> set => fun s:set => forall e0 :e R, 0 < e0 -> exists r :e R, 0 < r /\ forall d c= Power (R :^: idx M), forall t c= R :^: idx M, division_of M d t /\ (t c= s /\ finsum d (fun x:set => content M x) < r) -> finsum d (fun k:set => vector_norm N (f k)) < e0.

// HOL Light: Multivariate/integration.ml:23057 / absolutely_continuous_on   (hash md5:26bf4ed6fc82dd264aeace3242008841)
Definition absolutely_continuous_on : set -> (set -> set) -> set -> prop :=
  fun N:set => fun f:set -> set => fun s:set => absolutely_setcontinuous_on 1 N (fun k:set => vector_sub N (f (interval_upperbound 1 k)) (f (interval_lowerbound 1 k))) s.

// HOL Light: Multivariate/integration.ml:23827 / rectifiable_path   (hash md5:3f2229441ecbc258b2c07bb43c50f3b7)
Definition rectifiable_path : set -> (set -> set) -> prop :=
  fun N:set => fun g:set -> set => path N g /\ has_bounded_variation_on N g (closed_interval 1 (seq_cons (vec 1 0,vec 1 1) seq_nil)).

// HOL Light: Multivariate/integration.ml:23831 / path_length   (hash md5:1774af1a64fe18a953e15e42928624de)
Definition path_length : set -> (set -> set) -> set :=
  fun N:set => fun g:set -> set => vector_variation N (closed_interval 1 (seq_cons (vec 1 0,vec 1 1) seq_nil)) g.

// HOL Light: Multivariate/measure.ml:21 / has_measure   (hash md5:c364ae9379361668988c5c8758b7ed12)
Definition has_measure : set -> set -> set -> prop :=
  fun A:set => fun s:set => fun m:set => has_integral A 1 (fun x:set => vec 1 1) (lift m) s.

// HOL Light: Multivariate/measure.ml:24 / measurable   (hash md5:79db4d48d11f8c713470f94c6dd8816d)
Definition measurable : set -> set -> prop :=
  fun A:set => fun s:set => exists m :e R, has_measure A s m.

// HOL Light: Multivariate/measure.ml:27 / measure   (hash md5:6c706c6ec16ea298004d092a2413c9f8)
Definition measure : set -> set -> set :=
  fun A:set => fun s:set => choose_in R (fun m:set => has_measure A s m).

// HOL Light: Multivariate/measure.ml:6959 / measurable_on   (hash md5:c441fa0b60ed53cb9ccb9b0aecce9ed4)
Definition measurable_on : set -> set -> (set -> set) -> set -> prop :=
  fun M:set => fun N:set => fun f:set -> set => fun s:set => exists k c= R :^: idx M, exists g:set -> set -> set, (forall x :e omega, forall y :e R :^: idx M, g x y :e R :^: idx N) /\ (negligible M k /\ ((forall n :e omega, continuous_on_hl M N (g n) (R :^: idx M)) /\ forall x :e R :^: idx M, ~ x :e k -> tendsto N omega (fun n:set => g n x) (if x :e s then f x else vec N 0) sequentially)).

// HOL Light: Multivariate/measure.ml:6976 / lebesgue_measurable   (hash md5:66f691227fe7372e73c47bfefc40c57e)
Definition lebesgue_measurable : set -> set -> prop :=
  fun N:set => fun s:set => measurable_on N 1 (fun x:set => indicator N s x) (R :^: idx N).

// HOL Light type definition topology (abs topology, rep open_in) as a subtype of (A->bool)->bool
Definition topology : set -> set :=
  fun A:set => {t :e Power (Power A) | istopology A t}.

// HOL Light type definition metric (abs metric, rep dest_metric) as a subtype of (A->bool)#(A#A->real)
Definition metric : set -> set :=
  fun A:set => {m :e Power A :*: R :^: (A :*: A) | is_metric_space A m}.

// HOL Light: Multivariate/metric.ml:88 / topspace   (hash md5:e5f8b8427dea5f68fce3ac42833aede8)
Definition topspace : set -> set -> set :=
  fun A:set => fun top:set => Union {s :e Power A | s :e top}.

// HOL Light: Multivariate/metric.ml:155 / closed_in   (hash md5:8177c01b5fc541f6dad571e78e45eefe)
Definition closed_in : set -> set -> set -> prop :=
  fun A:set => fun top:set => fun s:set => s c= topspace A top /\ topspace A top :\: s :e top.

// HOL Light: Multivariate/metric.ml:302 / discrete_topology   (hash md5:96e81fa0914d558d9bd285e17958763c)
Definition discrete_topology : set -> set -> set :=
  fun A:set => fun u:set => {s :e Power A | s c= u}.

// HOL Light: Multivariate/metric.ml:305 / discrete_space   (hash md5:b9d2309cbe06015659b6fe40cfb2401b)
Definition discrete_space : set -> set -> prop :=
  fun A:set => fun top:set => discrete_topology A (topspace A top) = top.

// HOL Light: Multivariate/metric.ml:432 / subtopology   (hash md5:0001d77348bf9fd6f7c39bc6fae1605a)
Definition subtopology : set -> set -> set -> set :=
  fun A:set => fun top:set => fun u:set => {s :/\: u | s :e Power A, s :e top}.

// HOL Light: Multivariate/metric.ml:906 / hereditarily   (hash md5:882121e5caef71cc4fb8dac11a40d2d8)
Definition hereditarily : set -> set -> set -> prop :=
  fun A:set => fun P:set => fun top:set => forall s c= A, s c= topspace A top -> subtopology A top s :e P.

// HOL Light: Multivariate/metric.ml:940 / derived_set_of   (hash md5:d40ceb66cb3417b72f82821203465369)
Definition derived_set_of : set -> set -> set -> set :=
  fun A:set => fun top:set => fun s:set => {x :e A | x :e topspace A top /\ forall t c= A, x :e t /\ t :e top -> exists y :e A, ~ y = x /\ (y :e s /\ y :e t)}.

// HOL Light: Multivariate/metric.ml:1086 / closure_of   (hash md5:25f0eb8de5282f3ccaba771058e4066c)
Definition closure_of : set -> set -> set -> set :=
  fun A:set => fun top:set => fun s:set => {x :e A | x :e topspace A top /\ forall t c= A, x :e t /\ t :e top -> exists y :e A, y :e s /\ y :e t}.

// HOL Light: Multivariate/metric.ml:1446 / interior_of   (hash md5:6b15b3eb815e4153e6823122e679c13b)
Definition interior_of : set -> set -> set -> set :=
  fun A:set => fun top:set => fun s:set => {x :e A | exists t c= A, t :e top /\ (x :e t /\ t c= s)}.

// HOL Light: Multivariate/metric.ml:1722 / frontier_of   (hash md5:f16ab7b89cee1e27989f12720b8f44b3)
Definition frontier_of : set -> set -> set -> set :=
  fun A:set => fun top:set => fun s:set => closure_of A top s :\: interior_of A top s.

// HOL Light: Multivariate/metric.ml:2105 / locally_finite_in   (hash md5:9aca81c0d65df9208fa46e30c640c4e3)
Definition locally_finite_in : set -> set -> set -> prop :=
  fun A:set => fun top:set => fun U:set => (forall u c= A, u :e U -> u c= topspace A top) /\ forall x :e A, x :e topspace A top -> exists v c= A, v :e top /\ (x :e v /\ finite {u :e Power A | u :e U /\ ~ u :/\: v = Empty}).

// HOL Light: Multivariate/metric.ml:2244 / continuous_map   (hash md5:32dc5dc5912d545cca86b557cab8b8eb)
Definition continuous_map : set -> set -> set -> (set -> set) -> prop :=
  fun A:set => fun B:set => fun f:set => fun y:set -> set => (forall x :e A, x :e topspace A (f 0) -> y x :e topspace B (f 1)) /\ forall u c= B, u :e f 1 -> {x :e A | x :e topspace A (f 0) /\ y x :e u} :e f 0.

// HOL Light: Multivariate/metric.ml:2836 / open_map   (hash md5:8158992ac415d68c300ba4b3cdb4cd71)
Definition open_map : set -> set -> set -> (set -> set) -> prop :=
  fun A:set => fun B:set => fun f:set => fun y:set -> set => forall u c= A, u :e f 0 -> {y x | x :e u} :e f 1.

// HOL Light: Multivariate/metric.ml:2840 / closed_map   (hash md5:b0acc5d1dd790513cbfefddf68a418a6)
Definition closed_map : set -> set -> set -> (set -> set) -> prop :=
  fun A:set => fun B:set => fun f:set => fun y:set -> set => forall u c= A, closed_in A (f 0) u -> closed_in B (f 1) {y x | x :e u}.

// HOL Light: Multivariate/metric.ml:3353 / quotient_map   (hash md5:d4181d5e24e3d708976facd39313262e)
Definition quotient_map : set -> set -> set -> (set -> set) -> prop :=
  fun A:set => fun B:set => fun f:set => fun y:set -> set => {y x | x :e topspace A (f 0)} = topspace B (f 1) /\ forall u c= B, u c= topspace B (f 1) -> ({x :e A | x :e topspace A (f 0) /\ y x :e u} :e f 0 <-> u :e f 1).

// HOL Light: Multivariate/metric.ml:3659 / prod_topology   (hash md5:ef2ba1042d37bb1a78100406e79fea0b)
Definition prod_topology : set -> set -> set -> set -> set :=
  fun A:set => fun B:set => fun top1:set => fun top2:set => {x :e Power (A :*: B) | exists u c= Power (A :*: B), True /\ (forall x0 :e u, x0 :e \/_ s :e Power A, {s :*: t | t :e Power B, s :e top1 /\ t :e top2}) /\ Union u = x}.

// HOL Light: Multivariate/metric.ml:4096 / product_topology   (hash md5:25214740aa13211e87151bd57fc9a748)
Definition product_topology : set -> set -> set -> (set -> set) -> set :=
  fun A:set => fun K:set => fun t:set => fun tops:set -> set => {x :e Power (A :^: K) | exists u c= Power (A :^: K), True /\ (forall x0 :e u, x0 :e relative_to (A :^: K) {x01 :e Power (A :^: K) | exists u c= Power (A :^: K), finite u /\ (forall x1 :e u, x1 :e \/_ k :e K, {{x11 :e A :^: K | x11 k :e u} | u :e Power A, k :e t /\ u :e tops k}) /\ {x :e A :^: K | forall Y :e u, x :e Y} = x01} {x01 :e A :^: K | (forall x :e K, ~ x :e t -> x01 x = choose_in A (fun y:set => True)) /\ forall k :e K, k :e t -> x01 k :e topspace A (tops k)}) /\ Union u = x}.

// HOL Light: Multivariate/metric.ml:4925 / sum_topology   (hash md5:a17960b3f759b90792140f14f7165142)
Definition sum_topology : set -> set -> set -> (set -> set) -> set :=
  fun A:set => fun K:set => fun k:set => fun top:set -> set => {u :e Power (K :*: A) | u c= {p :e K :*: A | p 0 :e k /\ p 1 :e {x0 :e A | x0 :e topspace A (top (p 0))}} /\ forall i :e K, i :e k -> {x :e A | (i,x) :e u} :e top i}.

// HOL Light: Multivariate/metric.ml:5101 / homeomorphic_map   (hash md5:32199ae3207dbd577c8ba23316a4d9ac)
Definition homeomorphic_map : set -> set -> set -> (set -> set) -> prop :=
  fun A:set => fun B:set => fun f:set => fun y:set -> set => quotient_map A B (f 0,f 1) y /\ forall x y0 :e A, x :e topspace A (f 0) /\ y0 :e topspace A (f 0) -> (y x = y y0 <-> x = y0).

// HOL Light: Multivariate/metric.ml:5107 / homeomorphic_maps   (hash md5:a72be1879b7a5f3863b172708116220f)
Definition homeomorphic_maps : set -> set -> set -> set -> prop :=
  fun A:set => fun B:set => fun x:set => fun y:set => continuous_map A B (x 0,x 1) (fun x0:set => y 0 x0) /\ (continuous_map B A (x 1,x 0) (fun x0:set => y 1 x0) /\ ((forall x0 :e A, x0 :e topspace A (x 0) -> y 1 (y 0 x0) = x0) /\ forall y0 :e B, y0 :e topspace B (x 1) -> y 0 (y 1 y0) = y0)).

// HOL Light: Multivariate/metric.ml:5567 / homeomorphic_space   (hash md5:9b130e966e607f7613c072619f5f5a34)
Definition homeomorphic_space : set -> set -> set -> set -> prop :=
  fun A:set => fun B:set => fun top:set => fun top':set => exists f :e B :^: A, exists g :e A :^: B, homeomorphic_maps A B (top,top') (f,g).

// HOL Light: Multivariate/metric.ml:5798 / embedding_map   (hash md5:f2952d151a9d3e7e0abb1b55d74a5f84)
Definition embedding_map : set -> set -> set -> (set -> set) -> prop :=
  fun A:set => fun B:set => fun f:set => fun y:set -> set => homeomorphic_map A B (f 0,subtopology B (f 1) {y x | x :e topspace A (f 0)}) y.

// HOL Light: Multivariate/metric.ml:5972 / retraction_maps   (hash md5:b958f07861f064a219f9b3420a4d12b3)
Definition retraction_maps : set -> set -> set -> set -> prop :=
  fun A:set => fun B:set => fun x:set => fun y:set => continuous_map A B (x 0,x 1) (fun x0:set => y 0 x0) /\ (continuous_map B A (x 1,x 0) (fun x0:set => y 1 x0) /\ forall x0 :e B, x0 :e topspace B (x 1) -> y 0 (y 1 x0) = x0).

// HOL Light: Multivariate/metric.ml:5978 / section_map   (hash md5:e03cd7cd5ad24c24aa963ee92a7eafcc)
Definition section_map : set -> set -> set -> (set -> set) -> prop :=
  fun A:set => fun B:set => fun f:set => fun y:set -> set => exists g :e A :^: B, retraction_maps B A (f 1,f 0) (g,fun x :e A => y x).

// HOL Light: Multivariate/metric.ml:5982 / retraction_map   (hash md5:538db67b49436e87ae60b040361e72ef)
Definition retraction_map : set -> set -> set -> (set -> set) -> prop :=
  fun A:set => fun B:set => fun f:set => fun y:set -> set => exists g :e A :^: B, retraction_maps A B (f 0,f 1) (fun x :e A => y x,g).

// HOL Light: Multivariate/metric.ml:6265 / retract_of_space   (hash md5:9fff6d6715446d692305ee76d002c1c1)
Definition retract_of_space : set -> set -> set -> prop :=
  fun A:set => fun s:set => fun top:set => s c= topspace A top /\ exists r:set -> set, (forall x :e A, r x :e A) /\ (continuous_map A A (top,subtopology A top s) r /\ forall x :e A, x :e s -> r x = x).

// HOL Light: Multivariate/metric.ml:6410 / compact_in   (hash md5:55f43823fa200a319a57a02e096419de)
Definition compact_in : set -> set -> set -> prop :=
  fun A:set => fun top:set => fun s:set => s c= topspace A top /\ forall U c= Power A, (forall u c= A, u :e U -> u :e top) /\ s c= Union U -> exists V c= Power A, finite V /\ (V c= U /\ s c= Union V).

// HOL Light: Multivariate/metric.ml:6417 / compact_space   (hash md5:6d35f6606dcb3f1351aff4e928825c07)
Definition compact_space : set -> set -> prop :=
  fun A:set => fun top:set => compact_in A top (topspace A top).

// HOL Light: Multivariate/metric.ml:7502 / separated_in   (hash md5:e8bd4f70eab16026f9e9198c7a683414)
Definition separated_in : set -> set -> set -> set -> prop :=
  fun A:set => fun top:set => fun s:set => fun t:set => s c= topspace A top /\ (t c= topspace A top /\ (s :/\: closure_of A top t = Empty /\ t :/\: closure_of A top s = Empty)).

// HOL Light: Multivariate/metric.ml:7705 / t1_space   (hash md5:d8d0f69caae71f80e571366203aa3457)
Definition t1_space : set -> set -> prop :=
  fun A:set => fun top:set => forall x y :e A, x :e topspace A top /\ (y :e topspace A top /\ ~ x = y) -> exists u c= A, u :e top /\ (x :e u /\ ~ y :e u).

// HOL Light: Multivariate/metric.ml:8018 / hausdorff_space   (hash md5:0295833a765e6efe4ead5a9cd398746c)
Definition hausdorff_space : set -> set -> prop :=
  fun A:set => fun top:set => forall x y :e A, x :e topspace A top /\ (y :e topspace A top /\ ~ x = y) -> exists u v c= A, u :e top /\ (v :e top /\ (x :e u /\ (y :e v /\ u :/\: v = Empty))).

// HOL Light: Multivariate/metric.ml:8741 / kc_space   (hash md5:0bdd3e7d7636987f99bc01f71b65f80e)
Definition kc_space : set -> set -> prop :=
  fun A:set => fun top:set => forall s c= A, compact_in A top s -> closed_in A top s.

// HOL Light: Multivariate/metric.ml:9089 / proper_map   (hash md5:aefdb0f0fa6f14c4f469eacc5234c0d4)
Definition proper_map : set -> set -> set -> (set -> set) -> prop :=
  fun A:set => fun B:set => fun f:set => fun y:set -> set => closed_map A B (f 0,f 1) y /\ forall y0 :e B, y0 :e topspace B (f 1) -> compact_in A (f 0) {x :e A | x :e topspace A (f 0) /\ y x = y0}.

// HOL Light: Multivariate/metric.ml:9679 / perfect_map   (hash md5:8aae830a29dc11bf410a1b2b31f6f2d2)
Definition perfect_map : set -> set -> set -> (set -> set) -> prop :=
  fun A:set => fun B:set => fun f:set => fun y:set -> set => continuous_map A B (f 0,f 1) y /\ (proper_map A B (f 0,f 1) y /\ {y x | x :e topspace A (f 0)} = topspace B (f 1)).

// HOL Light: Multivariate/metric.ml:9982 / lindelof_space   (hash md5:887ee3fb8c45f9adc5389c4b1839930f)
Definition lindelof_space : set -> set -> prop :=
  fun A:set => fun top:set => forall U c= Power A, (forall u c= A, u :e U -> u :e top) /\ Union U = topspace A top -> exists V c= Power A, countable V /\ (V c= U /\ Union V = topspace A top).

// HOL Light: Multivariate/metric.ml:10220 / second_countable   (hash md5:6b40967cf41bef5e0b268b7484693f3b)
Definition second_countable : set -> set -> prop :=
  fun A:set => fun top:set => exists b c= Power A, countable b /\ ((forall v c= A, v :e b -> v :e top) /\ forall u c= A, forall x :e A, u :e top /\ x :e u -> exists v c= A, v :e b /\ (x :e v /\ v c= u)).

// HOL Light: Multivariate/metric.ml:10227 / first_countable   (hash md5:dd8ac78fce82217407ab459cf1ca1e66)
Definition first_countable : set -> set -> prop :=
  fun A:set => fun top:set => forall x :e A, x :e topspace A top -> exists b c= Power A, countable b /\ ((forall v c= A, v :e b -> v :e top) /\ forall u c= A, u :e top /\ x :e u -> exists v c= A, v :e b /\ (x :e v /\ v c= u)).

// HOL Light: Multivariate/metric.ml:10235 / separable_space   (hash md5:31dd17b133392e822aa00cf40bff73e8)
Definition separable_space : set -> set -> prop :=
  fun A:set => fun top:set => exists c c= A, countable c /\ (c c= topspace A top /\ closure_of A top c = topspace A top).

// HOL Light: Multivariate/metric.ml:10902 / fsigma_in   (hash md5:54a7b9735ca5321b83920b1ee302ecc2)
Definition fsigma_in : set -> set -> set :=
  fun A:set => fun top:set => {x :e Power A | exists u c= Power A, countable u /\ (forall x0 :e u, closed_in A top x0) /\ Union u = x}.

// HOL Light: Multivariate/metric.ml:10905 / gdelta_in   (hash md5:e2949c8739652d67c8ef1fa6a33a2959)
Definition gdelta_in : set -> set -> set :=
  fun A:set => fun top:set => relative_to A {x :e Power A | exists u c= Power A, countable u /\ (forall x0 :e u, x0 :e top) /\ {x0 :e A | forall Y :e u, x0 :e Y} = x} (topspace A top).

// HOL Light:  / borel_in   (hash md5:2245bcf2443e6fdc263610775a0b8d3b)
Definition borel_in : set -> set -> set -> prop :=
  fun A:set => fun top:set => fun a:set => forall borel_in':set -> prop, (forall a0 c= A, a0 :e top \/ ((exists s c= A, a0 = topspace A top :\: s /\ borel_in' s) \/ (exists u c= Power A, a0 = Union u /\ (countable u /\ forall s c= A, s :e u -> borel_in' s))) -> borel_in' a0) -> borel_in' a.

// HOL Light: Multivariate/metric.ml:11424 / borel_measurable_map   (hash md5:880ae2fdc23f99e0b63edb4a1ebdcb3a)
Definition borel_measurable_map : set -> set -> set -> (set -> set) -> prop :=
  fun A:set => fun B:set => fun f:set => fun y:set -> set => (forall x :e A, x :e topspace A (f 0) -> y x :e topspace B (f 1)) /\ forall u c= B, borel_in B (f 1) u -> borel_in A (f 0) {x :e A | x :e topspace A (f 0) /\ y x :e u}.

// HOL Light: Multivariate/metric.ml:11608 / mspace   (hash md5:6cd7139736a775060cba3681d570b396)
Definition mspace : set -> set -> set :=
  fun A:set => fun m:set => m 0.

// HOL Light: Multivariate/metric.ml:11611 / mdist   (hash md5:40fbaab511e88a48b1010249ef3e2a17)
Definition mdist : set -> set -> set -> set :=
  fun A:set => fun m:set => fun x:set => m 1 x.

// HOL Light: Multivariate/metric.ml:11687 / mball   (hash md5:149924ce2ac67342a065c01cc3d57779)
Definition mball : set -> set -> set -> set :=
  fun A:set => fun m:set => fun y:set => {y0 :e A | y 0 :e mspace A m /\ (y0 :e mspace A m /\ mdist A m (y 0,y0) < y 1)}.

// HOL Light: Multivariate/metric.ml:11756 / submetric   (hash md5:6371ac182c6c64da2cffae0653f938d9)
Definition submetric : set -> set -> set -> set :=
  fun A:set => fun m:set => fun s:set => (s :/\: mspace A m,fun x :e A :*: A => mdist A m x).

// HOL Light: Multivariate/metric.ml:11806 / mtopology   (hash md5:300a16d7e3119cfbbd0ad92833440ab3)
Definition mtopology : set -> set -> set :=
  fun A:set => fun m:set => {u :e Power A | u c= mspace A m /\ forall x :e A, x :e u -> exists r :e R, 0 < r /\ mball A m (x,r) c= u}.

// HOL Light: Multivariate/metric.ml:11950 / mcball   (hash md5:2026b823ca0dffa13c324dac9ef82815)
Definition mcball : set -> set -> set -> set :=
  fun A:set => fun m:set => fun y:set => {y0 :e A | y 0 :e mspace A m /\ (y0 :e mspace A m /\ mdist A m (y 0,y0) <= y 1)}.

// HOL Light: Multivariate/metric.ml:12061 / msphere   (hash md5:754cdb1e7c57ce0a5b9fd2d2f9c98646)
Definition msphere : set -> set -> set -> set :=
  fun A:set => fun m:set => fun y:set => {y0 :e A | mdist A m (y 0,y0) = y 1}.

// HOL Light: Multivariate/metric.ml:12184 / mbounded   (hash md5:ccb459c417ef6c562ace05155d491efb)
Definition mbounded : set -> set -> set -> prop :=
  fun A:set => fun m:set => fun s:set => exists c :e A, exists b :e R, s c= mcball A m (c,b).

// HOL Light: Multivariate/metric.ml:12635 / discrete_metric   (hash md5:2cc14a29930406052b8796bcbb924106)
Definition discrete_metric : set -> set -> set :=
  fun A:set => fun s:set => (s,fun p :e A :*: A => if p 0 = p 1 then 0 else 1).

// HOL Light: Multivariate/metric.ml:12680 / metrizable_space   (hash md5:73cc9cd2ded696fc3923004bb5a87892)
Definition metrizable_space : set -> set -> prop :=
  fun A:set => fun top:set => exists m :e metric A, top = mtopology A m.

// HOL Light: Multivariate/metric.ml:13067 / connected_space   (hash md5:1f3298e83bd8334bff3ce4ad5a781e75)
Definition connected_space : set -> set -> prop :=
  fun A:set => fun top:set => ~ exists e1 e2 c= A, e1 :e top /\ (e2 :e top /\ (topspace A top c= e1 :\/: e2 /\ (e1 :/\: e2 = Empty /\ (~ e1 = Empty /\ ~ e2 = Empty)))).

// HOL Light: Multivariate/metric.ml:13073 / connected_in   (hash md5:5f5c9d473600b30783725387e7d3df8d)
Definition connected_in : set -> set -> set -> prop :=
  fun A:set => fun top:set => fun s:set => s c= topspace A top /\ connected_space A (subtopology A top s).

// HOL Light: Multivariate/metric.ml:14227 / separated_between   (hash md5:b701314caf9a846188f518883b2f7308)
Definition separated_between : set -> set -> set -> set -> prop :=
  fun A:set => fun top:set => fun s:set => fun t:set => exists u v c= A, u :e top /\ (v :e top /\ (u :\/: v = topspace A top /\ (u :/\: v = Empty /\ (s c= u /\ t c= v)))).

// HOL Light: Multivariate/metric.ml:14483 / connected_component_of   (hash md5:2048943aca3b07247109bce5c6ec9df4)
Definition connected_component_of : set -> set -> set -> set -> prop :=
  fun A:set => fun top:set => fun x:set => fun y:set => exists t c= A, connected_in A top t /\ (x :e t /\ y :e t).

// HOL Light: Multivariate/metric.ml:14487 / connected_components_of   (hash md5:a661a29b4137e95ceea0c09c36f93c13)
Definition connected_components_of : set -> set -> set :=
  fun A:set => fun top:set => {{x0 :e A | connected_component_of A top x x0} | x :e A, x :e topspace A top}.

// HOL Light: Multivariate/metric.ml:15201 / monotone_map   (hash md5:633a701ebcbd7ac0479c2340cbe8daa6)
Definition monotone_map : set -> set -> set -> (set -> set) -> prop :=
  fun A:set => fun B:set => fun f:set => fun y:set -> set => {y x | x :e topspace A (f 0)} c= topspace B (f 1) /\ forall y0 :e B, y0 :e topspace B (f 1) -> connected_in A (f 0) {x :e A | x :e topspace A (f 0) /\ y x = y0}.

// HOL Light: Multivariate/metric.ml:15384 / neighbourhood_base_at   (hash md5:c8eab943b6c556579d14c5547065f665)
Definition neighbourhood_base_at : set -> set -> set -> set -> prop :=
  fun A:set => fun x:set => fun P:set => fun top:set => forall w c= A, w :e top /\ x :e w -> exists u v c= A, u :e top /\ (v :e P /\ (x :e u /\ (u c= v /\ v c= w))).

// HOL Light: Multivariate/metric.ml:15390 / neighbourhood_base_of   (hash md5:5591a622b0f2d363db4b5a84dfbbf7de)
Definition neighbourhood_base_of : set -> set -> set -> prop :=
  fun A:set => fun P:set => fun top:set => forall x :e A, x :e topspace A top -> neighbourhood_base_at A x P top.

// HOL Light: Multivariate/metric.ml:15643 / t0_space   (hash md5:524b549c58d417e7ec85d1b75184fb62)
Definition t0_space : set -> set -> prop :=
  fun A:set => fun top:set => forall x y :e A, x :e topspace A top /\ (y :e topspace A top /\ ~ x = y) -> exists u c= A, u :e top /\ ~ (x :e u <-> y :e u).

// HOL Light: Multivariate/metric.ml:15802 / kolmogorov_quotient   (hash md5:f5ccfca2f74332593d08eb0ca114f68b)
Definition kolmogorov_quotient : set -> set -> set -> set :=
  fun A:set => fun top:set => fun x:set => choose_in A (fun y:set => forall u c= A, u :e top -> (y :e u <-> x :e u)).

// HOL Light: Multivariate/metric.ml:16049 / regular_space   (hash md5:441a6fa8538e6daf0d72ea72294ae5e2)
Definition regular_space : set -> set -> prop :=
  fun A:set => fun top:set => forall c c= A, forall a :e A, closed_in A top c /\ a :e topspace A top :\: c -> exists u v c= A, u :e top /\ (v :e top /\ (a :e u /\ (c c= v /\ u :/\: v = Empty))).

// HOL Light: Multivariate/metric.ml:16642 / locally_compact_space   (hash md5:c23094e91611d397e080824bcf4290e0)
Definition locally_compact_space : set -> set -> prop :=
  fun A:set => fun top:set => forall x :e A, x :e topspace A top -> exists u k c= A, u :e top /\ (compact_in A top k /\ (x :e u /\ u c= k)).

// HOL Light: Multivariate/metric.ml:17524 / euclideanreal   (hash md5:69b02222f8971c9448486df4384a318b)
Definition euclideanreal : set :=
  {x :e Power R | real_open x}.

// HOL Light: Multivariate/metric.ml:17672 / real_euclidean_metric   (hash md5:37f7e6ff89ff7a6be322ac473cc3e583)
Definition real_euclidean_metric : set :=
  (R,fun p :e R :*: R => abs_SNo (p 1 + - p 0)).

// HOL Light:  / real_compact   (hash md5:632f0e0045a1fa86add07e5096b3ce3a)
Definition real_compact : set -> prop :=
  fun x:set => compact_in R euclideanreal x.

// HOL Light: Multivariate/metric.ml:18468 / atpointof   (hash md5:a6975bc1057942775ef9f0646ab42e64)
Definition atpointof : set -> set -> set -> set :=
  fun A:set => fun top:set => fun a:set => ({u :e Power A | u :e top /\ a :e u},{a}).

// HOL Light: Multivariate/metric.ml:18579 / limit   (hash md5:cdc9340e30a6bcdefc6ee60f055b7255)
Definition limit : set -> set -> set -> (set -> set) -> set -> set -> prop :=
  fun A:set => fun B:set => fun top:set => fun f:set -> set => fun l:set => fun net0:set => l :e topspace B top /\ forall u c= B, u :e top /\ l :e u -> eventually A {x :e A | f x :e u} net0.

// HOL Light: Multivariate/metric.ml:19877 / cauchy_in   (hash md5:7180f6b0e6cb215c9488467ca2c2efec)
Definition cauchy_in : set -> set -> (set -> set) -> prop :=
  fun A:set => fun m:set => fun s:set -> set => (forall n :e omega, s n :e mspace A m) /\ forall e0 :e R, 0 < e0 -> exists N :e omega, forall n n' :e omega, N <= n /\ N <= n' -> mdist A m (s n,s n') < e0.

// HOL Light: Multivariate/metric.ml:19885 / mcomplete   (hash md5:beb5aadde5eb68d2aa68da75f9e43033)
Definition mcomplete : set -> set -> prop :=
  fun A:set => fun m:set => forall s:set -> set, (forall x :e omega, s x :e A) -> cauchy_in A m s -> exists x :e A, limit omega A (mtopology A m) s x sequentially.

// HOL Light: Multivariate/metric.ml:20422 / totally_bounded_in   (hash md5:ac9b8755d86df75b88ab0eec62cbdc8e)
Definition totally_bounded_in : set -> set -> set -> prop :=
  fun A:set => fun m:set => fun s:set => forall e0 :e R, 0 < e0 -> exists k c= A, finite k /\ (k c= s /\ s c= Union {mball A m (x,e0) | x :e A, x :e k}).

// HOL Light: Multivariate/metric.ml:21251 / topcontinuous_at   (hash md5:72946dd98e700e94b84717456de86612)
Definition topcontinuous_at : set -> set -> set -> set -> (set -> set) -> set -> prop :=
  fun A:set => fun B:set => fun top:set => fun top':set => fun f:set -> set => fun x:set => x :e topspace A top /\ ((forall x0 :e A, x0 :e topspace A top -> f x0 :e topspace B top') /\ forall v c= B, v :e top' /\ f x :e v -> exists u c= A, u :e top /\ (x :e u /\ forall y :e A, y :e u -> f y :e v)).

// HOL Light:  / --->   (hash md5:29cc8d66280b81b7b337f8eb92ee5e6e)
Definition tendsto_real : set -> (set -> set) -> set -> set -> prop :=
  fun A:set => fun x:set -> set => fun y:set => fun z:set => limit A R euclideanreal x y z.

// HOL Light: Multivariate/metric.ml:21869 / reallim   (hash md5:376c1bfe6399b9a149ee240a6fb62217)
Definition reallim : set -> set -> (set -> set) -> set :=
  fun A:set => fun net0:set => fun f:set -> set => choose_in R (fun l:set => tendsto_real A f l net0).

// HOL Light: Multivariate/metric.ml:21941 / real_sums   (hash md5:b2769cbdcffe988c71219cb34dd91cbd)
Definition real_sums : (set -> set) -> set -> set -> prop :=
  fun f:set -> set => fun l:set => fun s:set => tendsto_real omega (fun n:set => finsum (s :/\: {i :e omega | 0 <= i /\ i <= n}) f) l sequentially.

// HOL Light: Multivariate/metric.ml:21945 / real_infsum   (hash md5:b1e3d7b73dbb9753dad5f6834c482eec)
Definition real_infsum : set -> (set -> set) -> set :=
  fun s:set => fun f:set -> set => choose_in R (fun l:set => real_sums f l s).

// HOL Light: Multivariate/metric.ml:21948 / real_summable   (hash md5:3bf5d3f1dc38230b0cff327d01a5892f)
Definition real_summable : set -> (set -> set) -> prop :=
  fun s:set => fun f:set -> set => exists l :e R, real_sums f l s.

// HOL Light: Multivariate/metric.ml:22038 / path_in   (hash md5:34eb210e6e99abc1ae536dee194f0ffb)
Definition path_in : set -> set -> (set -> set) -> prop :=
  fun A:set => fun top:set => fun g:set -> set => continuous_map R A (subtopology R euclideanreal (closed_real_interval (seq_cons (0,1) seq_nil)),top) g.

// HOL Light: Multivariate/metric.ml:22061 / path_connected_space   (hash md5:9933b543937bc22671cded68328d051a)
Definition path_connected_space : set -> set -> prop :=
  fun A:set => fun top:set => forall x y :e A, x :e topspace A top /\ y :e topspace A top -> exists g:set -> set, (forall x0 :e R, g x0 :e A) /\ (path_in A top g /\ (g 0 = x /\ g 1 = y)).

// HOL Light: Multivariate/metric.ml:22066 / path_connected_in   (hash md5:0d8458dbcad86b8863028d4e1955cb3b)
Definition path_connected_in : set -> set -> set -> prop :=
  fun A:set => fun top:set => fun s:set => s c= topspace A top /\ path_connected_space A (subtopology A top s).

// HOL Light: Multivariate/metric.ml:22462 / path_component_of   (hash md5:416fbdb8feb20c3f9ef161cda228edc6)
Definition path_component_of : set -> set -> set -> set -> prop :=
  fun A:set => fun top:set => fun x:set => fun y:set => exists g:set -> set, (forall x0 :e R, g x0 :e A) /\ (path_in A top g /\ (g 0 = x /\ g 1 = y)).

// HOL Light: Multivariate/metric.ml:22466 / path_components_of   (hash md5:a8ef04c53c4ff90f85f1c4e24ae007d2)
Definition path_components_of : set -> set -> set :=
  fun A:set => fun top:set => {{x0 :e A | path_component_of A top x x0} | x :e A, x :e topspace A top}.

// HOL Light: Multivariate/metric.ml:23488 / normal_space   (hash md5:0764d86eb5504eeac0ebfcc22c8c2762)
Definition normal_space : set -> set -> prop :=
  fun A:set => fun top:set => forall s t c= A, closed_in A top s /\ (closed_in A top t /\ s :/\: t = Empty) -> exists u v c= A, u :e top /\ (v :e top /\ (s c= u /\ (t c= v /\ u :/\: v = Empty))).

// HOL Light: Multivariate/metric.ml:24785 / completely_regular_space   (hash md5:17133ec47e80944b830b1b71920b5d20)
Definition completely_regular_space : set -> set -> prop :=
  fun A:set => fun top:set => forall s c= A, forall x :e A, closed_in A top s /\ x :e topspace A top :\: s -> exists f:set -> set, (forall x0 :e A, f x0 :e R) /\ (continuous_map A R (top,subtopology R euclideanreal (closed_real_interval (seq_cons (0,1) seq_nil))) f /\ (f x = 0 /\ forall x0 :e A, x0 :e s -> f x0 = 1)).

// HOL Light: Multivariate/metric.ml:25161 / weakly_locally_path_connected_at   (hash md5:6b6bf052551a4273a07a66a77031e8d5)
Definition weakly_locally_path_connected_at : set -> set -> set -> prop :=
  fun A:set => fun x:set => fun top:set => neighbourhood_base_at A x {x0 :e Power A | path_connected_in A top x0} top.

// HOL Light: Multivariate/metric.ml:25165 / locally_path_connected_at   (hash md5:7264f301bf656d895bbab51b3defda1a)
Definition locally_path_connected_at : set -> set -> set -> prop :=
  fun A:set => fun x:set => fun top:set => neighbourhood_base_at A x {u :e Power A | u :e top /\ path_connected_in A top u} top.

// HOL Light: Multivariate/metric.ml:25170 / locally_path_connected_space   (hash md5:86fa8359f40c76ec11d960fe94306efe)
Definition locally_path_connected_space : set -> set -> prop :=
  fun A:set => fun top:set => neighbourhood_base_of A {x :e Power A | path_connected_in A top x} top.

// HOL Light: Multivariate/metric.ml:25693 / weakly_locally_connected_at   (hash md5:c5bc50f1142f3af290aba180b69e8488)
Definition weakly_locally_connected_at : set -> set -> set -> prop :=
  fun A:set => fun x:set => fun top:set => neighbourhood_base_at A x {x0 :e Power A | connected_in A top x0} top.

// HOL Light: Multivariate/metric.ml:25697 / locally_connected_at   (hash md5:dcc187a78d28dabaf53a39638b0f32c8)
Definition locally_connected_at : set -> set -> set -> prop :=
  fun A:set => fun x:set => fun top:set => neighbourhood_base_at A x {u :e Power A | u :e top /\ connected_in A top u} top.

// HOL Light: Multivariate/metric.ml:25702 / locally_connected_space   (hash md5:c6c5af59c93c5b4ad7abbd2b2f117e68)
Definition locally_connected_space : set -> set -> prop :=
  fun A:set => fun top:set => neighbourhood_base_of A {x :e Power A | connected_in A top x} top.

// HOL Light: Multivariate/metric.ml:26205 / quasi_component_of   (hash md5:ccf029c074f1488de0f5c049ef5f9b94)
Definition quasi_component_of : set -> set -> set -> set -> prop :=
  fun A:set => fun top:set => fun x:set => fun y:set => x :e topspace A top /\ (y :e topspace A top /\ forall t c= A, closed_in A top t /\ t :e top -> (x :e t <-> y :e t)).

// HOL Light: Multivariate/metric.ml:26210 / quasi_components_of   (hash md5:f2497b5ab0dc58a53bd6455fbc8dd49d)
Definition quasi_components_of : set -> set -> set :=
  fun A:set => fun top:set => {{x0 :e A | quasi_component_of A top x x0} | x :e A, x :e topspace A top}.

// HOL Light: Multivariate/metric.ml:27385 / k_space   (hash md5:d71e5e26e30eb45a8052cb6035e94044)
Definition k_space : set -> set -> prop :=
  fun A:set => fun top:set => forall s c= A, s c= topspace A top -> (closed_in A top s <-> forall k c= A, compact_in A top k -> closed_in A (subtopology A top k) (k :/\: s)).

// HOL Light: Multivariate/metric.ml:28002 / kification   (hash md5:2775aa73723b5bf3a1df11e4344ca10d)
Definition kification : set -> set :=
  fun A:set => choose_in (topology A :^: topology A) (fun c:set => forall top :e topology A, c top = {s :e Power A | s c= topspace A top /\ forall k c= A, compact_in A top k -> k :/\: s :e subtopology A top k}).

// HOL Light: Multivariate/metric.ml:28287 / alexandroff_compactification   (hash md5:9af12a7d53c46c9d8d10a24fecd57a6a)
Definition alexandroff_compactification : set -> set -> set :=
  fun A:set => fun top:set => {{Inj0 x | x :e u} | u :e Power A, u :e top} :\/: {SetAdjoin {Inj0 x | x :e topspace A top :\: c} (Inj1 0) | c :e Power A, compact_in A top c /\ closed_in A top c}.

// HOL Light: Multivariate/metric.ml:29053 / homotopic_with   (hash md5:d1aa36d0babcecb6394d6a6fc671a2b4)
Definition homotopic_with : set -> set -> set -> set -> (set -> set) -> (set -> set) -> prop :=
  fun A:set => fun B:set => fun P:set => fun p:set => fun q:set -> set => fun w:set -> set => exists h:set -> set, (forall x :e R :*: B, h x :e A) /\ (continuous_map (R :*: B) A (prod_topology R B (subtopology R euclideanreal (closed_real_interval (seq_cons (0,1) seq_nil))) (p 0),p 1) h /\ ((forall x :e B, h (0,x) = q x) /\ ((forall x :e B, h (1,x) = w x) /\ forall t :e R, t :e closed_real_interval (seq_cons (0,1) seq_nil) -> (fun x :e B => h (t,x)) :e P))).

// HOL Light: Multivariate/metric.ml:29405 / homotopy_equivalent_space   (hash md5:b68437b3125ae4a817b580a1ae735359)
Definition homotopy_equivalent_space : set -> set -> set -> set -> prop :=
  fun A:set => fun B:set => fun top:set => fun top':set => exists f:set -> set, (forall x :e A, f x :e B) /\ exists g:set -> set, (forall x :e B, g x :e A) /\ (continuous_map A B (top,top') f /\ (continuous_map B A (top',top) g /\ (homotopic_with A A {x :e A :^: A | True} (top,top) (fun x:set => g (f x)) (fun x:set => x) /\ homotopic_with B B {x :e B :^: B | True} (top',top') (fun x:set => f (g x)) (fun x:set => x)))).

// HOL Light: Multivariate/metric.ml:29523 / contractible_space   (hash md5:2e34086647beafb11a613257a7d4cd06)
Definition contractible_space : set -> set -> prop :=
  fun A:set => fun top:set => exists a :e A, homotopic_with A A {x :e A :^: A | True} (top,top) (fun x:set => x) (fun x:set => a).

// HOL Light: Multivariate/metric.ml:29888 / completely_metrizable_space   (hash md5:bac17e99fcd542fb9f811a0e1aba7c0a)
Definition completely_metrizable_space : set -> set -> prop :=
  fun A:set => fun top:set => exists m :e metric A, mcomplete A m /\ top = mtopology A m.

// HOL Light: Multivariate/metric.ml:30023 / prod_metric   (hash md5:eda1fdcc0a9e371483d561add59f7543)
Definition prod_metric : set -> set -> set -> set -> set :=
  fun A:set => fun B:set => fun m1:set => fun m2:set => (mspace A m1 :*: mspace B m2,fun p :e A :*: B :*: (A :*: B) => if 0 <= mdist A m1 (p 0 0,p 1 0) ^ 2 + mdist B m2 (p 0 1,p 1 1) ^ 2 then sqrt_SNo_nonneg (mdist A m1 (p 0 0,p 1 0) ^ 2 + mdist B m2 (p 0 1,p 1 1) ^ 2) else - sqrt_SNo_nonneg (- (mdist A m1 (p 0 0,p 1 0) ^ 2 + mdist B m2 (p 0 1,p 1 1) ^ 2))).

// HOL Light: Multivariate/metric.ml:30386 / lipschitz_continuous_map   (hash md5:6958c0a6628a56434c994d22baccd2e1)
Definition lipschitz_continuous_map : set -> set -> set -> (set -> set) -> prop :=
  fun A:set => fun B:set => fun f:set => fun y:set -> set => {y x | x :e mspace B (f 0)} c= mspace A (f 1) /\ exists B0 :e R, forall x y0 :e B, x :e mspace B (f 0) /\ y0 :e mspace B (f 0) -> mdist A (f 1) (y x,y y0) <= B0 * mdist B (f 0) (x,y0).

// HOL Light: Multivariate/metric.ml:30464 / uniformly_continuous_map   (hash md5:ac269c6360d8fdf8cc9bc3bf53537859)
Definition uniformly_continuous_map : set -> set -> set -> (set -> set) -> prop :=
  fun A:set => fun B:set => fun f:set => fun y:set -> set => {y x | x :e mspace B (f 0)} c= mspace A (f 1) /\ forall e0 :e R, 0 < e0 -> exists d :e R, 0 < d /\ forall x x' :e B, x :e mspace B (f 0) /\ (x' :e mspace B (f 0) /\ mdist B (f 0) (x',x) < d) -> mdist A (f 1) (y x',y x) < e0.

// HOL Light: Multivariate/metric.ml:30591 / cauchy_continuous_map   (hash md5:e7d22d594b87a4abce0a1aa2f6bf0d48)
Definition cauchy_continuous_map : set -> set -> set -> (set -> set) -> prop :=
  fun A:set => fun B:set => fun f:set => fun y:set -> set => forall x:set -> set, (forall x :e omega, x x :e A) -> cauchy_in A (f 0) x -> cauchy_in B (f 1) (fun x0:set => y (x x0)).

// HOL Light: Multivariate/metric.ml:32615 / mdiameter   (hash md5:dad51025b774a08bee56fac67aa85f78)
Definition mdiameter : set -> set -> set -> set :=
  fun A:set => fun m:set => fun s:set => if s = Empty then 0 else sup (\/_ x :e A, {mdist A m (x,y) | y :e A, x :e s /\ y :e s}).

// HOL Light: Multivariate/metric.ml:33626 / fccoverable_space   (hash md5:839b401109766349f7b7693350542d9e)
Definition fccoverable_space : set -> set -> prop :=
  fun A:set => fun m:set => forall e0 :e R, 0 < e0 -> exists c c= Power A, finite c /\ (Union c = mspace A m /\ forall t c= A, t :e c -> connected_in A (mtopology A m) t /\ (mbounded A m t /\ mdiameter A m t <= e0)).

// HOL Light: Multivariate/metric.ml:33639 / ulc_space   (hash md5:104945959ea6aa91a2fce658dfc87c37)
Definition ulc_space : set -> set -> prop :=
  fun A:set => fun m:set => forall e0 :e R, 0 < e0 -> exists d :e R, 0 < d /\ forall x y :e A, x :e mspace A m /\ (y :e mspace A m /\ mdist A m (x,y) < d) -> exists c c= A, x :e c /\ (y :e c /\ (c c= mspace A m /\ (connected_in A (mtopology A m) c /\ (mbounded A m c /\ mdiameter A m c <= e0)))).

// HOL Light: Multivariate/metric.ml:33651 / fccoverable_in   (hash md5:101b5397da3b3661df43de9bbadc26fc)
Definition fccoverable_in : set -> set -> set -> prop :=
  fun A:set => fun m:set => fun s:set => s c= mspace A m /\ forall e0 :e R, 0 < e0 -> exists c c= Power A, finite c /\ (Union c = s /\ forall t c= A, t :e c -> connected_in A (mtopology A m) t /\ (mbounded A m t /\ mdiameter A m t <= e0)).

// HOL Light: Multivariate/metric.ml:37490 / capped_metric   (hash md5:0903c377fd59b7fb3290c696e20c4e58)
Definition capped_metric : set -> set -> set -> set :=
  fun A:set => fun d:set => fun m:set => if d <= 0 then m else (mspace A m,fun p :e A :*: A => if d <= mdist A m (p 0,p 1) then d else mdist A m (p 0,p 1)).

// HOL Light: Multivariate/metric.ml:38674 / euclidean_space   (hash md5:bf71ee835301e98508072d6983406cbb)
Definition euclidean_space : set -> set :=
  fun n:set => subtopology (R :^: omega) (product_topology R omega omega (fun i:set => euclideanreal)) {x :e R :^: omega | forall i :e omega, ~ i :e idx_n n -> x i = 0}.

// HOL Light: Multivariate/metric.ml:38862 / nsphere   (hash md5:41599fb84cda47f8a6333c624c84e0b9)
Definition nsphere : set -> set :=
  fun n:set => subtopology (R :^: omega) (euclidean_space (n + 1)) {x :e R :^: omega | finsum (idx_n (n + 1)) (fun i:set => x i ^ 2) = 1}.

// HOL Light: Multivariate/metric.ml:39263 / funspace   (hash md5:b00f6851bad3d63cc7edd2a8bbb4fcce)
Definition funspace : set -> set -> set -> set -> set :=
