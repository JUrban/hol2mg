Definition borel_measurable_on : set -> set -> (set -> set) -> set -> prop :=
  fun M:set => fun N:set => fun a0:set -> set => fun a1:set => forall borel_measurable_on':set -> set -> prop, (forall a00 :e R :^: idx N :^: (R :^: idx M), forall a10 c= R :^: idx M, continuous_on_hl M N (fun x:set => a00 x) a10 \/ (exists f :e R :^: idx N :^: (R :^: idx M) :^: omega, (forall n :e omega, borel_measurable_on' (f n) a10) /\ forall x :e R :^: idx M, x :e a10 -> tendsto N omega (fun n:set => f n x) (a00 x) sequentially) -> borel_measurable_on' a00 a10) -> borel_measurable_on' (fun x :e R :^: idx M => a0 x) a1.

// HOL Light: Multivariate/topology.ml:35139 / analytic   (hash md5:d4a588ce6ebdcf5c9907738a6020627a)
Definition analytic : set -> set -> prop :=
  fun A:set => fun s:set => s :e suslin (R :^: idx A) {x :e Power (R :^: idx A) | compact A x}.

// HOL Light: Multivariate/convex.ml:42 / affine   (hash md5:8fac036a3301180e278b09aa3d4217bc)
Definition affine : set -> set -> prop :=
  fun A:set => fun s:set => forall x y :e R :^: idx A, forall u v :e R, x :e s /\ (y :e s /\ u + v = 1) -> vector_add A (vector_mul A u x) (vector_mul A v y) :e s.

// HOL Light: Multivariate/convex.ml:790 / convex   (hash md5:d52e8dd7245ada6252b93be060a7e8f2)
Definition convex : set -> set -> prop :=
  fun A:set => fun s:set => forall x y :e R :^: idx A, forall u v :e R, x :e s /\ (y :e s /\ (0 <= u /\ (0 <= v /\ u + v = 1))) -> vector_add A (vector_mul A u x) (vector_mul A v y) :e s.

// HOL Light: Multivariate/convex.ml:1246 / conic   (hash md5:9fdd8ac914d2f2e034ff696ba53a0cba)
Definition conic : set -> set -> prop :=
  fun A:set => fun s:set => forall x :e R :^: idx A, forall c :e R, x :e s /\ 0 <= c -> vector_mul A c x :e s.

// HOL Light: Multivariate/convex.ml:1616 / affine_dependent   (hash md5:4b2c2ecc84ff717793991ceff6d6fbde)
Definition affine_dependent : set -> set -> prop :=
  fun N:set => fun s:set => exists x :e R :^: idx N, x :e s /\ x :e hull (R :^: idx N) {x0 :e Power (R :^: idx N) | affine N x0} (s :\: {x}).

// HOL Light: Multivariate/convex.ml:1765 / coplanar   (hash md5:88a1297656df9ef9ccb9e62f94f4ef9c)
Definition coplanar : set -> set -> prop :=
  fun A:set => fun s:set => exists u v w :e R :^: idx A, s c= hull (R :^: idx A) {x :e Power (R :^: idx A) | affine A x} {u,v,w}.

// HOL Light: Multivariate/convex.ml:1985 / convex_on   (hash md5:e656721602f9011336fdb3e4a755edba)
Definition convex_on : set -> (set -> set) -> set -> prop :=
  fun A:set => fun f:set -> set => fun s:set => forall x y :e R :^: idx A, forall u v :e R, x :e s /\ (y :e s /\ (0 <= u /\ (0 <= v /\ u + v = 1))) -> f (vector_add A (vector_mul A u x) (vector_mul A v y)) <= u * f x + v * f y.

// HOL Light: Multivariate/convex.ml:4252 / aff_dim   (hash md5:3538922494bc6f33d22382047917429f)
Definition aff_dim : set -> set -> set :=
  fun A:set => fun s:set => choose_in int (fun d:set => exists b c= R :^: idx A, hull (R :^: idx A) {x :e Power (R :^: idx A) | affine A x} b = hull (R :^: idx A) {x :e Power (R :^: idx A) | affine A x} s /\ (~ affine_dependent A b /\ finite_cardinality b = d + 1)).

// HOL Light: Multivariate/convex.ml:7747 / polar_dual   (hash md5:8d57f50030fa050dc72e11253cd3bb8c)
Definition polar_dual : set -> set -> set :=
  fun N:set => fun s:set => {x :e R :^: idx N | forall u :e R :^: idx N, u :e s -> - 1 <= dot N u x}.

// HOL Light: Multivariate/convex.ml:9888 / convex_cone   (hash md5:d27c4e1947fc339bebe9270a2b6c7d9a)
Definition convex_cone : set -> set -> prop :=
  fun A:set => fun s:set => ~ s = Empty /\ (convex A s /\ conic A s).

// HOL Light: Multivariate/convex.ml:10150 / epigraph   (hash md5:a039fb6811e913352ca9196c63d48dcd)
Definition epigraph : set -> set -> (set -> set) -> set :=
  fun N:set => fun s:set => fun f:set -> set => {xy :e R :^: idx_n (dimindex N + 1) | fstcart N xy :e s /\ f (fstcart N xy) <= drop (sndcart N 1 xy)}.

// HOL Light: Multivariate/convex.ml:10705 / starlike   (hash md5:3a5f8bfcfcdf559cd081e8084d310c6f)
Definition starlike : set -> set -> prop :=
  fun A:set => fun s:set => exists a :e R :^: idx A, a :e s /\ forall x :e R :^: idx A, x :e s -> closed_segment A (seq_cons (a,x) seq_nil) c= s.

// HOL Light: Multivariate/convex.ml:17589 / barycentre   (hash md5:a165a65a059255c062adf9fae92ffafc)
Definition barycentre : set -> set -> set :=
  fun A:set => fun s:set => if finite s then vsum (R :^: idx A) A s (fun x:set => vector_mul A (recip_SNo (finite_cardinality s)) x) else vec A 0.

// HOL Light: Multivariate/paths.ml:15 / path   (hash md5:f99b701734efc54b491b5305755f5419)
Definition path : set -> (set -> set) -> prop :=
  fun N:set => fun g:set -> set => continuous_on_hl 1 N g (closed_interval 1 (seq_cons (vec 1 0,vec 1 1) seq_nil)).

// HOL Light: Multivariate/paths.ml:18 / pathstart   (hash md5:f467625bf93a9e91f444bb6c297ad24a)
Definition pathstart : set -> (set -> set) -> set :=
  fun N:set => fun g:set -> set => g (vec 1 0).

// HOL Light: Multivariate/paths.ml:21 / pathfinish   (hash md5:9924aa5fa7c689c241ff19b6c085a1a1)
Definition pathfinish : set -> (set -> set) -> set :=
  fun N:set => fun g:set -> set => g (vec 1 1).

// HOL Light: Multivariate/paths.ml:24 / path_image   (hash md5:c3a36362cd49e10e92e4281543ca9d96)
Definition path_image : set -> (set -> set) -> set :=
  fun N:set => fun g:set -> set => {g x | x :e closed_interval 1 (seq_cons (vec 1 0,vec 1 1) seq_nil)}.

// HOL Light: Multivariate/paths.ml:27 / reversepath   (hash md5:384553a3ecd00008a38f02ed4bed527d)
Definition reversepath : set -> (set -> set) -> set -> set :=
