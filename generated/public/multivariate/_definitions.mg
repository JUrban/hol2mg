// HOL Light: Multivariate/vectors.ml:1227 / vsum   (hash md5:9d61c430be498afea6e5105a277dde93)
Definition vsum : set -> set -> set -> (set -> set) -> set :=
  fun A:set => fun N:set => fun s:set => fun f:set -> set => fun i :e idx N => finsum s (fun x:set => f x i).

// HOL Light: Multivariate/vectors.ml:1837 / basis   (hash md5:5b7f24b8febc21710b168664824e94a8)
Definition basis : set -> set -> set :=
  fun A:set => fun k:set => fun i :e idx A => if i = k then 1 else 0.

// HOL Light: Multivariate/vectors.ml:1959 / orthogonal   (hash md5:ff3c0bda52c1e809f0071a6ded91f17f)
Definition orthogonal : set -> set -> set -> prop :=
  fun A:set => fun x:set => fun y:set => dot A x y = 0.

// HOL Light: Multivariate/vectors.ml:2154 / linear   (hash md5:2e85efe04f9a852343d4bb7f907eb420)
Definition linear : set -> set -> (set -> set) -> prop :=
  fun M:set => fun N:set => fun f:set -> set => (forall x y :e R :^: idx M, f (vector_add M x y) = vector_add N (f x) (f y)) /\ forall c :e R, forall x :e R :^: idx M, f (vector_mul M c x) = vector_mul N c (f x).

// HOL Light: Multivariate/vectors.ml:2291 / bilinear   (hash md5:6b8a88b77ca0b88b5da20ae1ac8988c3)
Definition bilinear : set -> set -> set -> (set -> set -> set) -> prop :=
  fun A:set => fun B:set => fun C:set => fun f:set -> set -> set => (forall x :e R :^: idx C, linear A B (fun y:set => f x y)) /\ forall y :e R :^: idx A, linear C B (fun x:set => f x y).

// HOL Light: Multivariate/vectors.ml:2478 / adjoint   (hash md5:8e09b3005a8982591162786f1b0e0803)
Definition adjoint : set -> set -> (set -> set) -> set -> set :=
  fun M:set => fun N:set => fun f:set -> set => fun x:set => choose_in (R :^: idx M :^: (R :^: idx N)) (fun f':set => forall x :e R :^: idx M, forall y :e R :^: idx N, dot N (f x) y = dot M x (f' y)) x.

// HOL Light:  / %%   (hash md5:c10d27ac687473db70099b2e8cae3e1b)
Definition matrix_cmul : set -> set -> set -> set -> set :=
  fun M:set => fun N:set => fun x:set => fun y:set => fun i :e idx M => fun j :e idx N => x * y i j.

// HOL Light: Multivariate/vectors.ml:2659 / matrix_neg   (hash md5:55d54796787167ae0fe89662d24cfd6e)
Definition matrix_neg : set -> set -> set -> set :=
  fun M:set => fun N:set => fun A:set => fun i :e idx M => fun j :e idx N => - A i j.

// HOL Light: Multivariate/vectors.ml:2662 / matrix_add   (hash md5:9fa1ebebc41e967d348a19ab88a8eb2a)
Definition matrix_add : set -> set -> set -> set -> set :=
  fun M:set => fun N:set => fun A:set => fun B:set => fun i :e idx M => fun j :e idx N => A i j + B i j.

// HOL Light: Multivariate/vectors.ml:2665 / matrix_sub   (hash md5:12a54fa71cdaaa8ac5980a2d27e892bb)
Definition matrix_sub : set -> set -> set -> set -> set :=
  fun M:set => fun N:set => fun A:set => fun B:set => fun i :e idx M => fun j :e idx N => A i j + - B i j.

// HOL Light: Multivariate/vectors.ml:2668 / matrix_mul   (hash md5:90f453a6a13494673d2c326c1658f8f6)
Definition matrix_mul : set -> set -> set -> set -> set -> set :=
  fun M:set => fun N:set => fun P:set => fun A:set => fun B:set => fun i :e idx M => fun j :e idx P => finsum (idx N) (fun k:set => A i k * B k j).

// HOL Light: Multivariate/vectors.ml:2673 / matrix_vector_mul   (hash md5:9fc46e8730dd135024acb018b6eb17dc)
Definition matrix_vector_mul : set -> set -> set -> set -> set :=
  fun M:set => fun N:set => fun A:set => fun x:set => fun i :e idx M => finsum (idx N) (fun j:set => A i j * x j).

// HOL Light: Multivariate/vectors.ml:2677 / vector_matrix_mul   (hash md5:b5518336c8aa7e04dbda85db1f3a14d3)
Definition vector_matrix_mul : set -> set -> set -> set -> set :=
  fun M:set => fun N:set => fun x:set => fun A:set => fun j :e idx N => finsum (idx M) (fun i:set => A i j * x i).

// HOL Light: Multivariate/vectors.ml:2681 / mat   (hash md5:afc0e123b7cd511102f788ee4e4c6247)
Definition mat : set -> set -> set -> set :=
  fun M:set => fun N:set => fun k:set => fun i :e idx M => fun j :e idx N => if i = j then k else 0.

// HOL Light: Multivariate/vectors.ml:2684 / transp   (hash md5:787607e9e64b6df22bb84c9127b9bebb)
Definition transp : set -> set -> set -> set :=
  fun M:set => fun N:set => fun A:set => fun i :e idx N => fun j :e idx M => A j i.

// HOL Light: Multivariate/vectors.ml:2687 / row   (hash md5:ec465935fb530939685baf3e2ba8551b)
Definition row : set -> set -> set -> set -> set :=
  fun M:set => fun N:set => fun i:set => fun A:set => fun j :e idx N => A i j.

// HOL Light: Multivariate/vectors.ml:2690 / column   (hash md5:e52e0da33a1b72c8dd710eb9d791b70a)
Definition column : set -> set -> set -> set -> set :=
  fun M:set => fun N:set => fun j:set => fun A:set => fun i :e idx M => A i j.

// HOL Light: Multivariate/vectors.ml:2693 / rows   (hash md5:0efdd5086bb2e04bb78d8610cce322bc)
Definition rows : set -> set -> set -> set :=
  fun M:set => fun N:set => fun A:set => {row M N i A | i :e omega, 1 <= i /\ i <= dimindex M}.

// HOL Light: Multivariate/vectors.ml:2696 / columns   (hash md5:65377821c983cfd6bff3d44bd6dc19d7)
Definition columns : set -> set -> set -> set :=
  fun M:set => fun N:set => fun A:set => {column M N i A | i :e omega, 1 <= i /\ i <= dimindex N}.

// HOL Light: Multivariate/vectors.ml:2786 / symmetric_matrix   (hash md5:22b3dd53188a3791ad8925cc6ab76558)
Definition symmetric_matrix_hl : set -> set -> prop :=
  fun N:set => fun A:set => transp N N A = A.

// HOL Light: Multivariate/vectors.ml:2789 / normal_matrix   (hash md5:a058745c58317048180841a12a2e5b68)
Definition normal_matrix_hl : set -> set -> prop :=
  fun N:set => fun A:set => matrix_mul N N N (transp N N A) A = matrix_mul N N N A (transp N N A).

// HOL Light: Multivariate/vectors.ml:3345 / invertible   (hash md5:ed8a58da72df06526f9f311677e0b080)
Definition invertible : set -> set -> set -> prop :=
  fun M:set => fun N:set => fun A:set => exists A' :e R :^: idx M :^: idx N, matrix_mul M N M A A' = mat M M 1 /\ matrix_mul N M N A' A = mat N N 1.

// HOL Light: Multivariate/vectors.ml:3393 / matrix   (hash md5:aeaf017738da0bb065beae4347402789)
Definition matrix : set -> set -> (set -> set) -> set :=
  fun M:set => fun N:set => fun f:set -> set => fun i :e idx N => fun j :e idx M => f (basis M j) i.

// HOL Light: Multivariate/vectors.ml:3569 / onorm   (hash md5:9d6d6fd83bfc0757c85265a6be6db75c)
Definition onorm : set -> set -> (set -> set) -> set :=
  fun M:set => fun N:set => fun f:set -> set => sup {vector_norm N (f x) | x :e R :^: idx M, vector_norm M x = 1}.

// HOL Light: Multivariate/vectors.ml:3819 / lift   (hash md5:aba6775dab18b3f5c55bad9b399e1421)
Definition lift : set -> set :=
  fun x:set => fun i :e idx 1 => x.

// HOL Light: Multivariate/vectors.ml:3822 / drop   (hash md5:1ea1957119cc342649a70bf72954250e)
Definition drop : set -> set :=
  fun x:set => x 1.

// HOL Light: Multivariate/vectors.ml:4133 / indicator   (hash md5:af20b2ac0d64967dc3c37c69217edde5)
Definition indicator : set -> set -> set -> set :=
  fun M:set => fun s:set => fun x:set => if x :e s then vec 1 1 else vec 1 0.

// HOL Light: Multivariate/vectors.ml:4451 / dropout   (hash md5:3712f1b677785a9dcfa1ed3365a18b59)
Definition dropout : set -> set -> set -> set -> set :=
  fun M:set => fun N:set => fun k:set => fun x:set => fun i :e idx N => if i < k /\ i <= dimindex M then x i else if i + 1 <= dimindex M then x (i + 1) else 0.

// HOL Light: Multivariate/vectors.ml:4457 / pushin   (hash md5:cbedf73830d7a82df19bdfd0d847d2a5)
Definition pushin : set -> set -> set -> set -> set -> set -> set :=
  fun A:set => fun B:set => fun C:set => fun k:set => fun t:set => fun x:set => fun i :e idx A => if i < k then x i else if i = k then t else x (minus_nat i 1).

// HOL Light: Multivariate/vectors.ml:4604 / subspace   (hash md5:c95f4c0c6cf91d74a0f0da445442f21b)
Definition subspace : set -> set -> prop :=
  fun A:set => fun s:set => vec A 0 :e s /\ ((forall x y :e R :^: idx A, x :e s /\ y :e s -> vector_add A x y :e s) /\ forall c :e R, forall x :e R :^: idx A, x :e s -> vector_mul A c x :e s).

// HOL Light: Multivariate/vectors.ml:4610 / span   (hash md5:ece67e3f65395c45a7deb8d76b33c1ff)
Definition span : set -> set -> set :=
  fun A:set => fun s:set => hull (R :^: idx A) {x :e Power (R :^: idx A) | subspace A x} s.

// HOL Light: Multivariate/vectors.ml:4613 / dependent   (hash md5:aab20b61e0f8c963dc017c0ef5b8456c)
Definition dependent : set -> set -> prop :=
  fun A:set => fun s:set => exists a :e R :^: idx A, a :e s /\ a :e span A (s :\: {a}).

// HOL Light: Multivariate/vectors.ml:4616 / independent   (hash md5:79d85f1f07aaf425ee30e5d16e28dca2)
Definition independent : set -> set -> prop :=
  fun A:set => fun s:set => ~ dependent A s.

// HOL Light: Multivariate/vectors.ml:5272 / dim   (hash md5:5df3046897c72df86cf19806fea61a05)
Definition dim : set -> set -> set :=
  fun N:set => fun v:set => choose_in omega (fun n:set => exists b c= R :^: idx N, b c= v /\ (independent N b /\ (v c= span N b /\ equip b n))).

// HOL Light: Multivariate/vectors.ml:5276 / euclidean_matroid   (hash md5:0845cea5e85036dca62094a7eee9b260)
Definition euclidean_matroid : set -> set :=
  fun N:set => (R :^: idx N,fun x :e Power (R :^: idx N) => span N x).

// HOL Light: Multivariate/vectors.ml:6703 / rowvector   (hash md5:5560568ce80f4e31da0d8abf8020f729)
Definition rowvector : set -> set -> set :=
  fun N:set => fun v:set => fun i :e idx 1 => fun j :e idx N => v j.

// HOL Light: Multivariate/vectors.ml:6706 / columnvector   (hash md5:5f00a67bb93ffe70fd96eebdad5fbb4b)
Definition columnvector : set -> set -> set :=
  fun N:set => fun v:set => fun i :e idx N => fun j :e idx 1 => v i.

// HOL Light: Multivariate/vectors.ml:6830 / rank   (hash md5:f762da11cb9c2525a509b9c000757f67)
Definition rank : set -> set -> set -> set :=
  fun M:set => fun N:set => fun A:set => dim N (columns N M A).

// HOL Light: Multivariate/vectors.ml:8898 / matrix_inv   (hash md5:0e884467d8632ba1d7f7e94a60dbc858)
Definition matrix_inv : set -> set -> set -> set :=
  fun M:set => fun N:set => fun A:set => matrix N M (fun y:set => choose_in (R :^: idx M) (fun x:set => (forall w :e R :^: idx M, matrix_vector_mul N M A w = vec N 0 -> orthogonal M x w) /\ forall z :e R :^: idx M, orthogonal N (vector_sub N y (matrix_vector_mul N M A x)) (matrix_vector_mul N M A z))).

// HOL Light: Multivariate/vectors.ml:9402 / infnorm   (hash md5:0ffa75ff9218402d414ac4d76d49f094)
Definition infnorm : set -> set :=
  fun N:set => choose_in (R :^: (R :^: idx N)) (fun c:set => forall x :e R :^: idx N, c x = sup {abs_SNo (x i) | i :e omega, 1 <= i /\ i <= dimindex N}).

// HOL Light: Multivariate/vectors.ml:9593 / collinear   (hash md5:c02d8afd3cb3eefbcae4be5ddb7c809d)
Definition collinear : set -> set -> prop :=
  fun A:set => fun s:set => exists u :e R :^: idx A, forall x y :e R :^: idx A, x :e s /\ y :e s -> exists c :e R, vector_sub A x y = vector_mul A c u.

// HOL Light: Multivariate/vectors.ml:9813 / between   (hash md5:ba8f5878df1e77f00dba5fee83c90cf6)
Definition between : set -> set -> set -> prop :=
  fun A:set => fun x:set => fun y:set => distance A (y 0,y 1) = distance A (y 0,x) + distance A (x,y 1).

// HOL Light: Multivariate/vectors.ml:9977 / midpoint   (hash md5:b35fcf52d7388472d397b9583dcffa5a)
Definition midpoint : set -> set -> set :=
  fun A:set => fun x:set => vector_mul A (recip_SNo 2) (vector_add A (x 0) (x 1)).

// HOL Light: Multivariate/vectors.ml:10048 / open_interval   (hash md5:55ca276ec910f4057ac885964f027029)
Definition open_interval : set -> set -> set :=
  fun N:set => fun x:set => {x0 :e R :^: idx N | forall i :e omega, 1 <= i /\ i <= dimindex N -> x 0 i < x0 i /\ x0 i < x 1 i}.

// HOL Light: Multivariate/vectors.ml:10053 / closed_interval   (hash md5:9f350720eb0fe6533ca76e14e992d13e)
Definition closed_interval : set -> set -> set :=
  fun N:set => fun l:set => {x :e R :^: idx N | forall i :e omega, 1 <= i /\ i <= dimindex N -> seq_hd l 0 i <= x i /\ x i <= seq_hd l 1 i}.

// HOL Light: Multivariate/determinants.ml:18 / trace   (hash md5:a43655c66fb3237ef4a42ab89f391e89)
Definition trace : set -> set -> set :=
  fun N:set => fun A:set => finsum (idx N) (fun i:set => A i i).

// HOL Light: Multivariate/determinants.ml:71 / det   (hash md5:d9e1197b94dda9c0f3d4b879c3e8ce78)
Definition det : set -> set -> set :=
  fun N:set => fun A:set => finsum {p :e omega :^: omega | permutes omega (fun x:set => p x) (idx N)} (fun p:set => sign omega (fun x:set => p x) * finprod (idx N) (fun i:set => A i (p i))).

// HOL Light: Multivariate/determinants.ml:922 / cofactor   (hash md5:e9ce7de2c368606e44709183bdeecd70)
Definition cofactor : set -> set -> set :=
  fun N:set => fun A:set => fun i :e idx N => fun j :e idx N => det N (fun k :e idx N => fun l :e idx N => if k = i /\ l = j then 1 else if k = i \/ l = j then 0 else A k l).

// HOL Light: Multivariate/determinants.ml:1703 / diagonal_matrix   (hash md5:007175d7fba888e85d16083d3e540867)
Definition diagonal_matrix_hl : set -> set -> set -> prop :=
  fun M:set => fun N:set => fun A:set => forall i j :e omega, 1 <= i /\ (i <= dimindex M /\ (1 <= j /\ (j <= dimindex N /\ ~ i = j))) -> A i j = 0.

// HOL Light: Multivariate/determinants.ml:1939 / positive_semidefinite   (hash md5:f8bfdd58d197773e67583f9e2e26cedf)
Definition positive_semidefinite : set -> set -> prop :=
  fun N:set => fun A:set => symmetric_matrix_hl N A /\ forall x :e R :^: idx N, 0 <= dot N x (matrix_vector_mul N N A x).

// HOL Light: Multivariate/determinants.ml:2279 / positive_definite   (hash md5:7c15ffb6785ef3929ccd40dd6a946a18)
Definition positive_definite : set -> set -> prop :=
  fun N:set => fun A:set => symmetric_matrix_hl N A /\ forall x :e R :^: idx N, ~ x = vec N 0 -> 0 < dot N x (matrix_vector_mul N N A x).

// HOL Light: Multivariate/determinants.ml:2646 / orthogonal_transformation   (hash md5:9de1a5141ba694ad71aea7f96c4dba0d)
Definition orthogonal_transformation : set -> (set -> set) -> prop :=
  fun N:set => fun f:set -> set => linear N N f /\ forall v w :e R :^: idx N, dot N (f v) (f w) = dot N v w.

// HOL Light: Multivariate/determinants.ml:2686 / orthogonal_matrix   (hash md5:c9bce6976cc3e9768e2c4ce74797b899)
Definition orthogonal_matrix_hl : set -> set -> prop :=
  fun N:set => fun Q:set => matrix_mul N N N (transp N N Q) Q = mat N N 1 /\ matrix_mul N N N Q (transp N N Q) = mat N N 1.

// HOL Light: Multivariate/determinants.ml:3623 / rotation_matrix   (hash md5:7095223c5dd419036b5c48e54f5beb42)
Definition rotation_matrix : set -> set -> prop :=
  fun A:set => fun Q:set => orthogonal_matrix_hl A Q /\ det A Q = 1.

// HOL Light: Multivariate/determinants.ml:3626 / rotoinversion_matrix   (hash md5:c25206672c0932b70aa3ad6240853f16)
Definition rotoinversion_matrix : set -> set -> prop :=
  fun A:set => fun Q:set => orthogonal_matrix_hl A Q /\ det A Q = - 1.

// HOL Light: Multivariate/determinants.ml:4039 / reflect_along   (hash md5:d180d8f34a94b204e6eb94737c7fd16b)
Definition reflect_along : set -> set -> set -> set :=
  fun N:set => fun v:set => fun x:set => vector_sub N x (vector_mul N (2 * dot N x v :/: dot N v v) v).

// HOL Light:  / open   (hash md5:af6ae6929cf8123c0212717e6656967c)
Definition open : set -> set -> prop :=
  fun A:set => fun x:set => forall x0 :e R :^: idx A, x0 :e x -> exists e0 :e R, 0 < e0 /\ forall x' :e R :^: idx A, distance A (x',x0) < e0 -> x' :e x.

// HOL Light: Multivariate/topology.ml:138 / closed   (hash md5:abed39584651ef2981a8ce90754f778d)
Definition closed : set -> set -> prop :=
  fun N:set => fun s:set => open N ((R :^: idx N) :\: s).

// HOL Light: Multivariate/topology.ml:425 / ball   (hash md5:120512a438f9157fa330e619b3560af3)
Definition ball : set -> set -> set :=
  fun A:set => fun x:set => {y :e R :^: idx A | distance A (x 0,y) < x 1}.

// HOL Light: Multivariate/topology.ml:436 / cball   (hash md5:613d58a96e3b1cb2ba5f80ec394adfaa)
Definition cball : set -> set -> set :=
  fun A:set => fun x:set => {y :e R :^: idx A | distance A (x 0,y) <= x 1}.

// HOL Light: Multivariate/topology.ml:447 / sphere   (hash md5:08c05832e757a3208ea194b3651f8b10)
Definition sphere : set -> set -> set :=
  fun A:set => fun x:set => {y :e R :^: idx A | distance A (x 0,y) = x 1}.

// HOL Light: Multivariate/topology.ml:1004 / closed_segment   (hash md5:5a0ed8cb8f804bedb7fdc17fcb1272b1)
Definition closed_segment : set -> set :=
  fun A:set => choose_in (Power (R :^: idx A) :^: finseq (R :^: idx A :*: R :^: idx A)) (fun c:set => forall a b :e R :^: idx A, c (seq_cons (a,b) seq_nil) = {vector_add A (vector_mul A (1 + - u) a) (vector_mul A u b) | u :e R, 0 <= u /\ u <= 1}).

// HOL Light: Multivariate/topology.ml:1007 / open_segment   (hash md5:644926c3eb565b2bb73d927ebd63cc3d)
Definition open_segment : set -> set -> set :=
  fun A:set => fun x:set => closed_segment A (seq_cons (x 0,x 1) seq_nil) :\: {x 0,x 1}.

// HOL Light: Multivariate/topology.ml:1244 / connected   (hash md5:be12eb8b801bc43fd1f47bf295560e1b)
Definition connected : set -> set -> prop :=
  fun A:set => fun s:set => ~ exists e1 e2 c= R :^: idx A, open A e1 /\ (open A e2 /\ (s c= e1 :\/: e2 /\ (e1 :/\: (e2 :/\: s) = Empty /\ (~ e1 :/\: s = Empty /\ ~ e2 :/\: s = Empty)))).

// HOL Light: Multivariate/topology.ml:1705 / limit_point_of   (hash md5:2c8a6892d1f624536cc2b4b60e1df896)
Definition limit_point_of : set -> set -> set -> prop :=
  fun A:set => fun x:set => fun s:set => forall t c= R :^: idx A, x :e t /\ open A t -> exists y :e R :^: idx A, ~ y = x /\ (y :e s /\ y :e t).

// HOL Light: Multivariate/topology.ml:1943 / interior   (hash md5:c6f400e063f247e7319df4da13580ab2)
Definition interior : set -> set -> set :=
  fun A:set => fun s:set => {x :e R :^: idx A | exists t c= R :^: idx A, open A t /\ (x :e t /\ t c= s)}.

// HOL Light: Multivariate/topology.ml:2093 / closure   (hash md5:85ebd67cab56776033a32ec4be375a67)
Definition closure : set -> set -> set :=
  fun A:set => fun s:set => s :\/: {x :e R :^: idx A | limit_point_of A x s}.

// HOL Light: Multivariate/topology.ml:2560 / frontier   (hash md5:d483286286a3e5ad5ede1be7e86b8832)
Definition frontier : set -> set -> set :=
  fun A:set => fun s:set => closure A s :\: interior A s.

// HOL Light: Multivariate/topology.ml:2936 / at_infinity   (hash md5:58bfc4359e441fe3cb2cd078ccd52bc1)
Definition at_infinity : set -> set :=
  fun A:set => ({{x :e R :^: idx A | b <= vector_norm A x} | b :e R, b :e R},Empty).

// HOL Light: Multivariate/topology.ml:2939 / at_posinfinity   (hash md5:2dd9f95370391934336e6e0fa52b5a69)
Definition at_posinfinity : set :=
  ({{x :e R | a <= x} | a :e R, a :e R},Empty).

// HOL Light: Multivariate/topology.ml:2942 / at_neginfinity   (hash md5:03432f45e8a2fc456f1dbd33c4a02874)
Definition at_neginfinity : set :=
  ({{x :e R | x <= a} | a :e R, a :e R},Empty).

// HOL Light:  / -->   (hash md5:b295da05cef9e959e333d222128ebeb6)
Definition tendsto : set -> set -> (set -> set) -> set -> set -> prop :=
  fun A:set => fun B:set => fun x:set -> set => fun y:set => fun z:set => forall e0 :e R, 0 < e0 -> eventually B {x0 :e B | distance A (x x0,y) < e0} z.

// HOL Light: Multivariate/topology.ml:3281 / lim   (hash md5:9031c45d6519f64427128e4d1c35fabf)
Definition lim : set -> set -> set -> (set -> set) -> set :=
  fun A:set => fun B:set => fun net0:set => fun f:set -> set => choose_in (R :^: idx A) (fun l:set => tendsto A B f l net0).

// HOL Light: Multivariate/topology.ml:3706 / condensation_point_of   (hash md5:3ff24dbf3bee21ffe57229e53ff8eea2)
Definition condensation_point_of : set -> set -> set -> prop :=
  fun A:set => fun x:set => fun s:set => forall t c= R :^: idx A, x :e t /\ open A t -> ~ countable (s :/\: t).

// HOL Light: Multivariate/topology.ml:4916 / bounded   (hash md5:ab6dbc0af7439517efc524ea509328cd)
Definition bounded_hl : set -> set -> prop :=
  fun N:set => fun s:set => exists a :e R, forall x :e R :^: idx N, x :e s -> vector_norm N x <= a.

// HOL Light: Multivariate/topology.ml:5396 / compact   (hash md5:3f0d2b625f538af9f7727faa962c08d5)
Definition compact : set -> set -> prop :=
  fun N:set => fun s:set => forall f:set -> set, (forall x :e omega, f x :e R :^: idx N) -> (forall n :e omega, f n :e s) -> exists l :e R :^: idx N, exists r:set -> set, (forall x :e omega, r x :e omega) /\ (l :e s /\ ((forall m n :e omega, m < n -> r m < r n) /\ tendsto N omega (fun x:set => f (r x)) l sequentially)).

// HOL Light: Multivariate/topology.ml:5669 / cauchy   (hash md5:76017df1367c92109a90f53af02e85e9)
Definition cauchy : set -> (set -> set) -> prop :=
  fun N:set => fun s:set -> set => forall e0 :e R, 0 < e0 -> exists N0 :e omega, forall m n :e omega, N0 <= m /\ N0 <= n -> distance N (s m,s n) < e0.

// HOL Light: Multivariate/topology.ml:5677 / complete   (hash md5:f60e0fcd8e5e68990d05961ba9192b48)
Definition complete : set -> set -> prop :=
  fun N:set => fun s:set => forall f:set -> set, (forall x :e omega, f x :e R :^: idx N) -> (forall n :e omega, f n :e s) /\ cauchy N f -> exists l :e R :^: idx N, l :e s /\ tendsto N omega f l sequentially.

// HOL Light: Multivariate/topology.ml:6470 / continuous   (hash md5:b9d5ac56f911ca5b05d9a94a324fa163)
Definition continuous : set -> set -> (set -> set) -> set -> prop :=
  fun A:set => fun B:set => fun f:set -> set => fun net0:set => tendsto A B f (f (netlimit B net0)) net0.

// HOL Light: Multivariate/topology.ml:6631 / continuous_on   (hash md5:562aa1df322f5b35854a9aab2842a1dd)
Definition continuous_on_hl : set -> set -> (set -> set) -> set -> prop :=
  fun A:set => fun B:set => fun f:set -> set => fun s:set => forall x :e R :^: idx A, x :e s -> forall e0 :e R, 0 < e0 -> exists d :e R, 0 < d /\ forall x' :e R :^: idx A, x' :e s /\ distance A (x',x) < d -> distance B (f x',f x) < e0.

// HOL Light: Multivariate/topology.ml:6638 / uniformly_continuous_on   (hash md5:22902617e02e8c5bcaef41d0164cb87b)
Definition uniformly_continuous_on_hl : set -> set -> (set -> set) -> set -> prop :=
  fun A:set => fun B:set => fun f:set -> set => fun s:set => forall e0 :e R, 0 < e0 -> exists d :e R, 0 < d /\ forall x x' :e R :^: idx A, x :e s /\ (x' :e s /\ distance A (x',x) < d) -> distance B (f x',f x) < e0.

// HOL Light: Multivariate/topology.ml:10858 / connected_component   (hash md5:b0fd63616fffa2ff55d541878786735f)
Definition connected_component : set -> set -> set -> set -> prop :=
  fun A:set => fun s:set => fun x:set => fun y:set => exists t c= R :^: idx A, connected A t /\ (t c= s /\ (x :e t /\ y :e t)).

// HOL Light: Multivariate/topology.ml:11341 / components   (hash md5:dc8d2dab1ee537b62eaa6184788a6fd7)
Definition components : set -> set -> set :=
  fun N:set => fun s:set => {{x0 :e R :^: idx N | connected_component N s x x0} | x :e R :^: idx N, x :e s}.

// HOL Light: Multivariate/topology.ml:12880 / diameter   (hash md5:eb752f538b7a7ffe29e0ce3c7b10d935)
Definition diameter : set -> set -> set :=
  fun A:set => fun s:set => if s = Empty then 0 else sup (\/_ x :e R :^: idx A, {vector_norm A (vector_sub A x y) | y :e R :^: idx A, x :e s /\ y :e s}).

// HOL Light: Multivariate/topology.ml:14558 / is_interval   (hash md5:dab66903cd514753766244c061ace45a)
Definition is_interval : set -> set -> prop :=
  fun N:set => fun s:set => forall a b x :e R :^: idx N, a :e s /\ (b :e s /\ (forall i :e omega, 1 <= i /\ i <= dimindex N -> a i <= x i /\ x i <= b i \/ b i <= x i /\ x i <= a i)) -> x :e s.

// HOL Light: Multivariate/topology.ml:15981 / homeomorphism   (hash md5:370394872ee6c09c8cf30913d29fa537)
Definition homeomorphism : set -> set -> set -> set -> prop :=
  fun A:set => fun B:set => fun x:set => fun y:set => (forall x0 :e R :^: idx A, x0 :e x 0 -> y 1 (y 0 x0) = x0) /\ ({y 0 x0 | x0 :e x 0} = x 1 /\ (continuous_on_hl A B (fun x0:set => y 0 x0) (x 0) /\ ((forall y0 :e R :^: idx B, y0 :e x 1 -> y 0 (y 1 y0) = y0) /\ ({y 1 x0 | x0 :e x 1} = x 0 /\ continuous_on_hl B A (fun x0:set => y 1 x0) (x 1))))).

// HOL Light: Multivariate/topology.ml:15988 / homeomorphic   (hash md5:545d47e4183630cd0cb0d93c361c7789)
Definition homeomorphic : set -> set -> set -> set -> prop :=
  fun A:set => fun B:set => fun s:set => fun t:set => exists f :e R :^: idx A :^: (R :^: idx B), exists g :e R :^: idx B :^: (R :^: idx A), homeomorphism B A (s,t) (f,g).

// HOL Light: Multivariate/topology.ml:21988 / sums   (hash md5:96349a08e80ff3dc60e953cd9335cd80)
Definition sums : set -> (set -> set) -> set -> set -> prop :=
  fun A:set => fun f:set -> set => fun l:set => fun s:set => tendsto A omega (fun n:set => vsum omega A (s :/\: {i :e omega | 0 <= i /\ i <= n}) f) l sequentially.

// HOL Light: Multivariate/topology.ml:21991 / infsum   (hash md5:75b628d549c3e14c5116587a72ba0719)
Definition infsum : set -> set -> (set -> set) -> set :=
  fun A:set => fun s:set => fun f:set -> set => choose_in (R :^: idx A) (fun l:set => sums A f l s).

// HOL Light: Multivariate/topology.ml:21994 / summable   (hash md5:00b557fb3529fc18850e799bc2ee3a0a)
Definition summable : set -> set -> (set -> set) -> prop :=
  fun A:set => fun s:set => fun f:set -> set => exists l :e R :^: idx A, sums A f l s.

// HOL Light: Multivariate/topology.ml:24081 / closest_point   (hash md5:d7eee6531793a3a39383e5e4a1227acc)
Definition closest_point : set -> set -> set -> set :=
  fun A:set => fun s:set => fun a:set => choose_in (R :^: idx A) (fun x:set => x :e s /\ forall y :e R :^: idx A, y :e s -> distance A (a,x) <= distance A (a,y)).

// HOL Light: Multivariate/topology.ml:24260 / setdist   (hash md5:c8f6cbfcd99df2c881f9a6c4f82ca1b4)
Definition setdist : set -> set -> set :=
  fun A:set => fun x:set => if x 0 = Empty \/ x 1 = Empty then 0 else inf (\/_ x0 :e R :^: idx A, {distance A (x0,y) | y :e R :^: idx A, x0 :e x 0 /\ y :e x 1}).

// HOL Light: Multivariate/topology.ml:25295 / hausdist   (hash md5:28800b53266d160b595160c1cc42e584)
Definition hausdist : set -> set -> set :=
  fun N:set => fun x:set => if ~ {setdist N ({x0},x 1) | x0 :e R :^: idx N, x0 :e x 0} :\/: {setdist N ({y},x 0) | y :e R :^: idx N, y :e x 1} = Empty /\ exists b :e R, forall d :e R, d :e {setdist N ({x0},x 1) | x0 :e R :^: idx N, x0 :e x 0} :\/: {setdist N ({y},x 0) | y :e R :^: idx N, y :e x 1} -> d <= b then sup ({setdist N ({x0},x 1) | x0 :e R :^: idx N, x0 :e x 0} :\/: {setdist N ({y},x 0) | y :e R :^: idx N, y :e x 1}) else 0.

// HOL Light: Multivariate/topology.ml:29963 / gdelta   (hash md5:10d13a73b8324c84b2f897f256c6fcba)
Definition gdelta : set -> set -> prop :=
  fun N:set => fun s:set => exists u c= Power (R :^: idx N), countable u /\ (forall x :e u, open N x) /\ {x :e R :^: idx N | forall Y :e u, x :e Y} = s.

// HOL Light: Multivariate/topology.ml:29966 / fsigma   (hash md5:d93788da940ac53dd2eb9d2a21d5b31e)
Definition fsigma : set -> set -> prop :=
  fun N:set => fun s:set => exists u c= Power (R :^: idx N), countable u /\ (forall x :e u, closed N x) /\ Union u = s.

// HOL Light:  / borel   (hash md5:d92c9dc580506d3b9a9ca34a9899c908)
Definition borel : set -> set -> prop :=
  fun N:set => fun a:set => forall borel':set -> prop, (forall a0 c= R :^: idx N, open N a0 \/ ((exists s c= R :^: idx N, a0 = (R :^: idx N) :\: s /\ borel' s) \/ (exists u c= Power (R :^: idx N), a0 = Union u /\ (countable u /\ forall s c= R :^: idx N, s :e u -> borel' s))) -> borel' a0) -> borel' a.

// HOL Light: Multivariate/topology.ml:31345 / baire   (hash md5:82cd49e5e05f055ddbe190c5821d9360)
Definition baire : set -> set -> set :=
  fun M:set => fun N:set => choose_in (Power (R :^: idx N :^: (R :^: idx M)) :^: Power (R :^: idx M) :^: omega) (fun c:set => (forall s c= R :^: idx M, forall f :e R :^: idx N :^: (R :^: idx M), f :e c 0 s <-> continuous_on_hl M N (fun x:set => f x) s) /\ forall n :e omega, forall s c= R :^: idx M, forall f :e R :^: idx N :^: (R :^: idx M), f :e c (ordsucc n) s <-> exists g :e R :^: idx N :^: (R :^: idx M) :^: omega, (forall k :e omega, g k :e c n s) /\ forall x :e R :^: idx M, x :e s -> tendsto N omega (fun k:set => g k x) (f x) sequentially).

