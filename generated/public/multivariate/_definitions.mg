// HOL Light: Multivariate/paths.ml:1047 / shiftpath   (hash md5:d30ef5cf82acb34b2a326c519b6797a8)
Definition shiftpath : set -> set -> (set -> set) -> set -> set :=
  fun N:set => fun a:set => fun f:set -> set => fun x:set => if drop (vector_add 1 a x) <= 1 then f (vector_add 1 a x) else f (vector_add 1 a (vector_sub 1 x (vec 1 1))).

// HOL Light: Multivariate/paths.ml:1198 / subpath   (hash md5:fa2f0d7be813280821fc390e5a207efe)
Definition subpath : set -> set -> set -> (set -> set) -> set -> set :=
  fun A:set => fun u:set => fun v:set => fun g:set -> set => fun x:set => g (vector_add 1 u (vector_mul 1 (drop (vector_sub 1 v u)) x)).

// HOL Light: Multivariate/paths.ml:2000 / linepath   (hash md5:f8d3ee5cee21adae8fb6c73fe1676f67)
Definition linepath : set -> set -> set -> set :=
  fun A:set => fun x:set => fun x0:set => vector_add A (vector_mul A (1 + - drop x0) (x 0)) (vector_mul A (drop x0) (x 1)).

// HOL Light: Multivariate/paths.ml:2498 / path_component   (hash md5:269861b46105c7c4683040253c3deb4a)
Definition path_component : set -> set -> set -> set -> prop :=
  fun A:set => fun s:set => fun x:set => fun y:set => exists g:set -> set, (forall x0 :e R :^: idx 1, g x0 :e R :^: idx A) /\ (path A g /\ (path_image A g c= s /\ (pathstart A g = x /\ pathfinish A g = y))).

// HOL Light: Multivariate/paths.ml:2503 / path_components   (hash md5:e1956f410367c2c366622ba75cc96bb2)
Definition path_components : set -> set -> set :=
  fun A:set => fun s:set => {{x0 :e R :^: idx A | path_component A s x x0} | x :e R :^: idx A, x :e s}.

// HOL Light: Multivariate/paths.ml:2606 / path_connected   (hash md5:f121bc6af86e89617250e0ba87b2057e)
Definition path_connected : set -> set -> prop :=
  fun A:set => fun s:set => forall x y :e R :^: idx A, x :e s /\ y :e s -> exists g:set -> set, (forall x0 :e R :^: idx 1, g x0 :e R :^: idx A) /\ (path A g /\ (path_image A g c= s /\ (pathstart A g = x /\ pathfinish A g = y))).

// HOL Light: Multivariate/paths.ml:15267 / inside   (hash md5:cd3784e5da3b613885234e784c8e74eb)
Definition inside : set -> set -> set :=
  fun N:set => fun s:set => {x :e R :^: idx N | ~ x :e s /\ bounded_hl N {x0 :e R :^: idx N | connected_component N ((R :^: idx N) :\: s) x x0}}.

// HOL Light: Multivariate/paths.ml:15271 / outside   (hash md5:ef9cdb0f85161bbee055b9825fdec73d)
Definition outside : set -> set -> set :=
  fun N:set => fun s:set => {x :e R :^: idx N | ~ x :e s /\ ~ bounded_hl N {x0 :e R :^: idx N | connected_component N ((R :^: idx N) :\: s) x x0}}.

// HOL Light: Multivariate/polytope.ml:13 / face_of   (hash md5:f3c1b96b8c67ec53018e44b83a716c72)
Definition face_of : set -> set -> set -> prop :=
  fun A:set => fun t:set => fun s:set => t c= s /\ (convex A t /\ forall a b x :e R :^: idx A, a :e s /\ (b :e s /\ (x :e t /\ x :e open_segment A (a,b))) -> a :e t /\ b :e t).

// HOL Light: Multivariate/polytope.ml:1189 / exposed_face_of   (hash md5:7d8785cf09d27ffcacb31dbd272b47ce)
Definition exposed_face_of : set -> set -> set -> prop :=
  fun A:set => fun t:set => fun s:set => face_of A t s /\ exists a :e R :^: idx A, exists b :e R, s c= {x :e R :^: idx A | dot A a x <= b} /\ t = s :/\: {x :e R :^: idx A | dot A a x = b}.

// HOL Light: Multivariate/polytope.ml:1488 / extreme_point_of   (hash md5:a0a47d35ea955dbac97281ab26ca9a8c)
Definition extreme_point_of : set -> set -> set -> prop :=
  fun A:set => fun x:set => fun s:set => x :e s /\ forall a b :e R :^: idx A, a :e s /\ b :e s -> ~ x :e open_segment A (a,b).

// HOL Light: Multivariate/polytope.ml:2620 / facet_of   (hash md5:e16c61c4e85c1e24ffd88143f5af511b)
Definition facet_of : set -> set -> set -> prop :=
  fun A:set => fun f:set => fun s:set => face_of A f s /\ (~ f = Empty /\ aff_dim A f = aff_dim A s + - 1).

// HOL Light: Multivariate/polytope.ml:2847 / edge_of   (hash md5:703d118dcb4272a293b3d0384900955b)
Definition edge_of : set -> set -> set -> prop :=
  fun A:set => fun e0:set => fun s:set => face_of A e0 s /\ aff_dim A e0 = 1.

// HOL Light: Multivariate/polytope.ml:4037 / polytope   (hash md5:034683c5f3b9f0472b9ca8beee0c546c)
Definition polytope : set -> set -> prop :=
  fun A:set => fun s:set => exists v c= R :^: idx A, finite v /\ s = hull (R :^: idx A) {x :e Power (R :^: idx A) | convex A x} v.

