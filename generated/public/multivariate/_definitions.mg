// HOL Light: Multivariate/paths.ml:34 / simple_path   (hash md5:39f5e63d0b9d8f64f0d391d299c0c723)
Definition simple_path : set -> (set -> set) -> prop :=
  fun N:set => fun g:set -> set => path N g /\ forall x y :e R :^: idx 1, x :e closed_interval 1 (seq_cons (vec 1 0,vec 1 1) seq_nil) /\ (y :e closed_interval 1 (seq_cons (vec 1 0,vec 1 1) seq_nil) /\ g x = g y) -> x = y \/ (x = vec 1 0 /\ y = vec 1 1 \/ x = vec 1 1 /\ y = vec 1 0).

// HOL Light: Multivariate/paths.ml:42 / arc   (hash md5:977740cbf90e59c2db4e984b95bf4ddb)
Definition arc : set -> (set -> set) -> prop :=
