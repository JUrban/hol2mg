Theorem QUASICOMPACT_OPEN_CLOSED : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, forall t c= R :^: idx N, {f x | x :e s} c= t -> ((forall u c= R :^: idx N, u c= t -> {x :e R :^: idx M | x :e s /\ f x :e u} :e subtopology (R :^: idx M) (euclidean M) s -> u :e subtopology (R :^: idx N) (euclidean N) t) <-> forall u c= R :^: idx N, u c= t -> closed_in (R :^: idx M) (subtopology (R :^: idx M) (euclidean M) s) {x :e R :^: idx M | x :e s /\ f x :e u} -> closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) t) u).
Admitted.

