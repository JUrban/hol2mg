Theorem CLOSED_SUBSTANDARD : forall N:set, N <> Empty -> forall d :e omega, closed N {x :e R :^: idx N | forall i :e omega, d < i /\ i <= dimindex N -> x i = 0}.
Admitted.

// HOL Light: Multivariate/topology.ml:18554 / DIM_SUBSTANDARD
// Source hash: md5:42a95ce9369e8dd874b99844b5e043cc
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_real_R, nat_le_SNoLe, nat_lt_SNoLt, omega_Subq_R)
Theorem DIM_SUBSTANDARD : forall N:set, N <> Empty -> forall d :e omega, d <= dimindex N -> dim N {x :e R :^: idx N | forall i :e omega, d < i /\ i <= dimindex N -> x i = 0} = d.
Admitted.

// HOL Light: Multivariate/topology.ml:18607 / CLOSED_SUBSPACE
// Source hash: md5:20f2db6ef1cb65d03f9a88c18aadf246
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSED_SUBSPACE : forall N:set, N <> Empty -> forall s c= R :^: idx N, subspace N s -> closed N s.
Admitted.

// HOL Light: Multivariate/topology.ml:18633 / CLOSED_SPAN
// Source hash: md5:0947371c50d3ccef17fab00e819c4877
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSED_SPAN : forall A:set, A <> Empty -> forall s c= R :^: idx A, closed A (span A s).
Admitted.

// HOL Light: Multivariate/topology.ml:18637 / CLOSURE_SUBSET_SPAN
// Source hash: md5:5b8ee602d79d26d1f29a1519b9bbd739
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSURE_SUBSET_SPAN : forall N:set, N <> Empty -> forall s c= R :^: idx N, closure N s c= span N s.
Admitted.

// HOL Light: Multivariate/topology.ml:18642 / DIM_CLOSURE
// Source hash: md5:858b1d20e3de03013759256397e63c10
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R)
Theorem DIM_CLOSURE : forall N:set, N <> Empty -> forall s c= R :^: idx N, dim N (closure N s) = dim N s.
Admitted.

// HOL Light: Multivariate/topology.ml:18650 / CLOSED_BOUNDEDPREIM_CONTINUOUS_IMAGE
// Source hash: md5:62cc7f2a0babe38c40eeb94a9c241d27
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSED_BOUNDEDPREIM_CONTINUOUS_IMAGE : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, closed M s /\ (continuous_on_hl M N f s /\ (forall e0 :e R, bounded_hl M {x :e R :^: idx M | x :e s /\ sqrt_SNo_nonneg (dot N (f x) (f x)) <= e0})) -> closed N {f x | x :e s}.
Admitted.

// HOL Light: Multivariate/topology.ml:18668 / CLOSED_INJECTIVE_IMAGE_SUBSET_SUBSPACE
// Source hash: md5:f5f89a86e7280c65bbea2831b0347399
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R)
Theorem CLOSED_INJECTIVE_IMAGE_SUBSET_SUBSPACE : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s t c= R :^: idx M, closed M s /\ (s c= t /\ (subspace M t /\ (linear M N f /\ (forall x :e R :^: idx M, x :e t /\ f x = vec N 0 -> x = vec M 0)))) -> closed N {f x | x :e s}.
Admitted.

// HOL Light: Multivariate/topology.ml:18687 / BASIS_COORDINATES_LIPSCHITZ
// Source hash: md5:6d613a0841070dd9878c63794a3c286c
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem BASIS_COORDINATES_LIPSCHITZ : forall N:set, N <> Empty -> forall b c= R :^: idx N, independent N b -> exists B :e R, 0 < B /\ forall c:set -> set, (forall x :e R :^: idx N, c x :e R) -> forall v :e R :^: idx N, v :e b -> abs_SNo (c v) <= B * sqrt_SNo_nonneg (dot N (vsum (R :^: idx N) N b (fun v0:set => vector_mul N (c v0) v0)) (vsum (R :^: idx N) N b (fun v0:set => vector_mul N (c v0) v0))).
Admitted.

// HOL Light: Multivariate/topology.ml:18756 / COMPLEMENTARY_SUM_COMPONENTS_LIPSCHITZ
// Source hash: md5:47eeb178910a18c94e4ea0b2d09c2b9d
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem COMPLEMENTARY_SUM_COMPONENTS_LIPSCHITZ : forall N:set, N <> Empty -> forall s t c= R :^: idx N, subspace N s /\ (subspace N t /\ s :/\: t c= {vec N 0}) -> exists B :e R, 0 < B /\ forall x y :e R :^: idx N, x :e s /\ y :e t -> sqrt_SNo_nonneg (dot N x x) <= B * sqrt_SNo_nonneg (dot N (vector_add N x y) (vector_add N x y)).
Admitted.

// HOL Light: Multivariate/topology.ml:18801 / BASIS_COORDINATES_CONTINUOUS
// Source hash: md5:214b06a22fd2a88191fc9c1fa4182d2f
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem BASIS_COORDINATES_CONTINUOUS : forall N:set, N <> Empty -> forall b c= R :^: idx N, forall e0 :e R, independent N b /\ 0 < e0 -> exists d :e R, 0 < d /\ forall c:set -> set, (forall x :e R :^: idx N, c x :e R) -> sqrt_SNo_nonneg (dot N (vsum (R :^: idx N) N b (fun v:set => vector_mul N (c v) v)) (vsum (R :^: idx N) N b (fun v:set => vector_mul N (c v) v))) < d -> forall v :e R :^: idx N, v :e b -> abs_SNo (c v) < e0.
Admitted.

// HOL Light: Multivariate/topology.ml:18818 / COMPLEMENTARY_SUM_HOMEOMORPHIC_PCROSS
// Source hash: md5:3f91a91ecc592019a3a90809f1598c73
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_sum_idx, hol_num_omega, hol_real_R)
Theorem COMPLEMENTARY_SUM_HOMEOMORPHIC_PCROSS : forall N:set, N <> Empty -> forall s t c= R :^: idx N, span N s :/\: span N t c= {vec N 0} -> homeomorphic (idx_n (dimindex N + dimindex N)) N (\/_ x :e R :^: idx N, {vector_add N x y | y :e R :^: idx N, x :e s /\ y :e t}) (\/_ x :e s, {pastecart N N x y | y :e t}).
Admitted.

// HOL Light: Multivariate/topology.ml:18889 / AFFINITY_INVERSES
// Source hash: md5:2e7cef67481f0985d6afceba2a649566
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem AFFINITY_INVERSES : forall A:set, A <> Empty -> forall m :e R, forall c :e R :^: idx A, ~ m = 0 -> (forall x :e R :^: idx A, vector_add A (vector_mul A m (vector_add A (vector_mul A (recip_SNo m) x) (vector_neg A (vector_mul A (recip_SNo m) c)))) c = x) /\ forall x :e R :^: idx A, vector_add A (vector_mul A (recip_SNo m) (vector_add A (vector_mul A m x) c)) (vector_neg A (vector_mul A (recip_SNo m) c)) = x.
Admitted.

// HOL Light: Multivariate/topology.ml:18898 / REAL_AFFINITY_LE
// Source hash: md5:a92aa4995bfdf6391771213b242889ed
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem REAL_AFFINITY_LE : forall m c x y :e R, 0 < m -> (m * x + c <= y <-> x <= recip_SNo m * y + - c :/: m).
Admitted.

// HOL Light: Multivariate/topology.ml:18903 / REAL_LE_AFFINITY
// Source hash: md5:416bfb53ec6a45987f308c8f36dc5cea
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem REAL_LE_AFFINITY : forall m c x y :e R, 0 < m -> (y <= m * x + c <-> recip_SNo m * y + - c :/: m <= x).
Admitted.

// HOL Light: Multivariate/topology.ml:18908 / REAL_AFFINITY_LT
// Source hash: md5:4c3d55e81b43cd604a3f253949529637
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem REAL_AFFINITY_LT : forall m c x y :e R, 0 < m -> (m * x + c < y <-> x < recip_SNo m * y + - c :/: m).
Admitted.

// HOL Light: Multivariate/topology.ml:18912 / REAL_LT_AFFINITY
// Source hash: md5:685ae40d9d0d466797811812adc30b40
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem REAL_LT_AFFINITY : forall m c x y :e R, 0 < m -> (y < m * x + c <-> recip_SNo m * y + - c :/: m < x).
Admitted.

// HOL Light: Multivariate/topology.ml:18916 / REAL_AFFINITY_EQ
// Source hash: md5:c8f564e2e36fbb091211899114ee74d7
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem REAL_AFFINITY_EQ : forall m c x y :e R, ~ m = 0 -> (m * x + c = y <-> x = recip_SNo m * y + - c :/: m).
Admitted.

// HOL Light: Multivariate/topology.ml:18920 / REAL_EQ_AFFINITY
// Source hash: md5:84417bcb593b6bb2931f4b42d95b4124
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem REAL_EQ_AFFINITY : forall m c x y :e R, ~ m = 0 -> (y = m * x + c <-> recip_SNo m * y + - c :/: m = x).
Admitted.

// HOL Light: Multivariate/topology.ml:18924 / VECTOR_AFFINITY_EQ
// Source hash: md5:f88e37ae900231f854258151a40bbbff
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem VECTOR_AFFINITY_EQ : forall A:set, A <> Empty -> forall m :e R, forall c x y :e R :^: idx A, ~ m = 0 -> (vector_add A (vector_mul A m x) c = y <-> x = vector_add A (vector_mul A (recip_SNo m) y) (vector_neg A (vector_mul A (recip_SNo m) c))).
Admitted.

// HOL Light: Multivariate/topology.ml:18931 / VECTOR_EQ_AFFINITY
// Source hash: md5:5b83221581a7ff4ed94cce62eb4ef9e1
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem VECTOR_EQ_AFFINITY : forall A:set, A <> Empty -> forall m :e R, forall c x y :e R :^: idx A, ~ m = 0 -> (y = vector_add A (vector_mul A m x) c <-> vector_add A (vector_mul A (recip_SNo m) y) (vector_neg A (vector_mul A (recip_SNo m) c)) = x).
Admitted.

// HOL Light: Multivariate/topology.ml:18938 / IMAGE_AFFINITY_INTERVAL
// Source hash: md5:d9935453f23c4d8a2d5d5cd50bb67957
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem IMAGE_AFFINITY_INTERVAL : forall N:set, N <> Empty -> forall a b :e R :^: idx N, forall m :e R, forall c :e R :^: idx N, {vector_add N (vector_mul N m x) c | x :e closed_interval N (seq_cons (a,b) seq_nil)} = if closed_interval N (seq_cons (a,b) seq_nil) = Empty then Empty else if 0 <= m then closed_interval N (seq_cons (vector_add N (vector_mul N m a) c,vector_add N (vector_mul N m b) c) seq_nil) else closed_interval N (seq_cons (vector_add N (vector_mul N m b) c,vector_add N (vector_mul N m a) c) seq_nil).
Admitted.

// HOL Light: Multivariate/topology.ml:19054 / CONTINUOUS_ON_LIFT_DET
// Source hash: md5:1f92508aba84e1a996464dd267c97ad3
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_one_1, hol_real_R, nat_le_SNoLe)
Theorem CONTINUOUS_ON_LIFT_DET : forall M N:set, M <> Empty -> N <> Empty -> forall A:set -> set, (forall x :e R :^: idx M, A x :e R :^: idx N :^: idx N) -> forall s c= R :^: idx M, (forall i j :e omega, 1 <= i /\ (i <= dimindex N /\ (1 <= j /\ j <= dimindex N)) -> continuous_on_hl M 1 (fun x:set => lift (A x i j)) s) -> continuous_on_hl M 1 (fun x:set => lift (det N (A x))) s.
Admitted.

// HOL Light: Multivariate/topology.ml:19069 / CONTINUOUS_ON_DET_VECTORIZE
// Source hash: md5:5b0ecc16fd24eaf1ae9547f7534e90e1
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_prod_idx, hol_one_1, hol_real_R)
Theorem CONTINUOUS_ON_DET_VECTORIZE : forall M N:set, M <> Empty -> N <> Empty -> forall s c= R :^: idx M, forall A:set -> set, (forall x :e R :^: idx M, A x :e R :^: idx N :^: idx N) -> continuous_on_hl M (idx_n (dimindex N * dimindex N)) (fun a:set => vectorize R N N (A a)) s -> continuous_on_hl M 1 (fun a:set => lift (det N (A a))) s.
Admitted.

// HOL Light: Multivariate/topology.ml:19076 / CONTINUOUS_DET_EXPLICIT
// Source hash: md5:5e34b4fd16d676440ecb8a529b3309fa
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_real_R, nat_le_SNoLe, omega_Subq_R)
Theorem CONTINUOUS_DET_EXPLICIT : forall N:set, N <> Empty -> forall A :e R :^: idx N :^: idx N, forall e0 :e R, 0 < e0 -> exists d :e R, 0 < d /\ forall A' :e R :^: idx N :^: idx N, (forall i j :e omega, 1 <= i /\ (i <= dimindex N /\ (1 <= j /\ j <= dimindex N)) -> abs_SNo (A' i j + - A i j) < d) -> abs_SNo (det N A' + - det N A) < e0.
Admitted.

// HOL Light: Multivariate/topology.ml:19105 / NEARBY_INVERTIBLE_MATRIX
// Source hash: md5:13e49fcff69c13db962d4e5064eed7a5
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem NEARBY_INVERTIBLE_MATRIX : forall N:set, N <> Empty -> forall A :e R :^: idx N :^: idx N, exists e0 :e R, 0 < e0 /\ forall x :e R, ~ x = 0 /\ abs_SNo x < e0 -> invertible N N (matrix_add N N A (matrix_cmul N N x (mat N N 1))).
Admitted.

// HOL Light: Multivariate/topology.ml:19132 / NEARBY_INVERTIBLE_MATRIX_GEN
// Source hash: md5:06e43a33c5ab3e698dc074431abd893a
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem NEARBY_INVERTIBLE_MATRIX_GEN : forall N:set, N <> Empty -> forall A B :e R :^: idx N :^: idx N, invertible N N B -> exists e0 :e R, 0 < e0 /\ forall x :e R, ~ x = 0 /\ abs_SNo x < e0 -> invertible N N (matrix_add N N A (matrix_cmul N N x B)).
Admitted.

// HOL Light: Multivariate/topology.ml:19150 / MATRIX_WLOG_INVERTIBLE
// Source hash: md5:4ff0b9e8454a4d134ec3654f35a2cd16
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_one_1, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem MATRIX_WLOG_INVERTIBLE : forall N:set, N <> Empty -> forall P:set -> prop, (forall A :e R :^: idx N :^: idx N, invertible N N A -> P A) /\ (forall A :e R :^: idx N :^: idx N, exists d :e R, 0 < d /\ closed 1 {x :e R :^: idx 1 | x :e cball 1 (vec 1 0,d) /\ P (matrix_add N N A (matrix_cmul N N (drop x) (mat N N 1)))}) -> forall A :e R :^: idx N :^: idx N, P A.
Admitted.

// HOL Light: Multivariate/topology.ml:19175 / SYLVESTER_DETERMINANT_IDENTITY
// Source hash: md5:029767d76e9bb69102c7a304749ab17b
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R)
Theorem SYLVESTER_DETERMINANT_IDENTITY : forall M N:set, M <> Empty -> N <> Empty -> forall A :e R :^: idx N :^: idx M, forall B :e R :^: idx M :^: idx N, det M (matrix_add M M (mat M M 1) (matrix_mul M N M A B)) = det N (matrix_add N N (mat N N 1) (matrix_mul N M N B A)).
Admitted.

// HOL Light: Multivariate/topology.ml:19315 / COFACTOR_MATRIX_MUL
// Source hash: md5:59fa4fa9139fc3fabb7373a167433bcd
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem COFACTOR_MATRIX_MUL : forall N:set, N <> Empty -> forall A B :e R :^: idx N :^: idx N, cofactor N (matrix_mul N N N A B) = matrix_mul N N N (cofactor N A) (cofactor N B).
Admitted.

// HOL Light: Multivariate/topology.ml:19368 / DET_COFACTOR
// Source hash: md5:d661e98d4ff0f46ede57299b1a31c48d
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_real_R)
Theorem DET_COFACTOR : forall N:set, N <> Empty -> forall A :e R :^: idx N :^: idx N, det N (cofactor N A) = det N A ^ minus_nat (dimindex N) 1.
Admitted.

// HOL Light: Multivariate/topology.ml:19407 / INVERTIBLE_COFACTOR
// Source hash: md5:b63ee33a56d5ffe452b611bd6c1967be
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_real_R)
Theorem INVERTIBLE_COFACTOR : forall N:set, N <> Empty -> forall A :e R :^: idx N :^: idx N, invertible N N (cofactor N A) <-> dimindex N = 1 \/ invertible N N A.
Admitted.

// HOL Light: Multivariate/topology.ml:19413 / COFACTOR_COFACTOR
// Source hash: md5:618f7851059336e9a1950f836c0a77a3
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_real_R, nat_le_SNoLe)
Theorem COFACTOR_COFACTOR : forall N:set, N <> Empty -> forall A :e R :^: idx N :^: idx N, 2 <= dimindex N -> cofactor N (cofactor N A) = matrix_cmul N N (det N A ^ minus_nat (dimindex N) 2) A.
Admitted.

// HOL Light: Multivariate/topology.ml:19470 / RANK_COFACTOR_EQ_FULL
// Source hash: md5:314dc6ac1a8b5e65b4cf270cc165f24a
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_real_R)
Theorem RANK_COFACTOR_EQ_FULL : forall N:set, N <> Empty -> forall A :e R :^: idx N :^: idx N, rank N N (cofactor N A) = dimindex N <-> dimindex N = 1 \/ rank N N A = dimindex N.
Admitted.

// HOL Light: Multivariate/topology.ml:19477 / COFACTOR_EQ_0
// Source hash: md5:359fca4f5742440de76a50bdb65c34ac
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_real_R, nat_lt_SNoLt)
Theorem COFACTOR_EQ_0 : forall N:set, N <> Empty -> forall A :e R :^: idx N :^: idx N, cofactor N A = mat N N 0 <-> rank N N A < minus_nat (dimindex N) 1.
Admitted.

// HOL Light: Multivariate/topology.ml:19619 / RANK_COFACTOR_EQ_1
// Source hash: md5:b72d25011c8c55ce047de9087327bf8b
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_real_R)
Theorem RANK_COFACTOR_EQ_1 : forall N:set, N <> Empty -> forall A :e R :^: idx N :^: idx N, rank N N (cofactor N A) = 1 <-> dimindex N = 1 \/ rank N N A = minus_nat (dimindex N) 1.
Admitted.

// HOL Light: Multivariate/topology.ml:19643 / RANK_COFACTOR
// Source hash: md5:38ef2a5eeae2b78cddae0a0fb4bc27ad
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_real_R)
Theorem RANK_COFACTOR : forall N:set, N <> Empty -> forall A :e R :^: idx N :^: idx N, rank N N (cofactor N A) = if rank N N A = dimindex N then dimindex N else if rank N N A = minus_nat (dimindex N) 1 then 1 else 0.
Admitted.

// HOL Light: Multivariate/topology.ml:19655 / SAME_EIGENVALUES_TRANSP
// Source hash: md5:4e400b36e55435f9662489317d435af0
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R)
Theorem SAME_EIGENVALUES_TRANSP : forall N:set, N <> Empty -> forall A :e R :^: idx N :^: idx N, forall c :e R, (exists v :e R :^: idx N, ~ v = vec N 0 /\ matrix_vector_mul N N (transp N N A) v = vector_mul N c v) <-> exists v :e R :^: idx N, ~ v = vec N 0 /\ matrix_vector_mul N N A v = vector_mul N c v.
Admitted.

// HOL Light: Multivariate/topology.ml:19664 / SAME_EIGENVALUES_SIMILAR
// Source hash: md5:b1a775eee7f5e5278f16e1f559316fd5
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R)
Theorem SAME_EIGENVALUES_SIMILAR : forall N:set, N <> Empty -> forall S A :e R :^: idx N :^: idx N, forall c :e R, invertible N N S -> ((exists v :e R :^: idx N, ~ v = vec N 0 /\ matrix_vector_mul N N (matrix_mul N N N (matrix_inv N N S) (matrix_mul N N N A S)) v = vector_mul N c v) <-> exists v :e R :^: idx N, ~ v = vec N 0 /\ matrix_vector_mul N N A v = vector_mul N c v).
Admitted.

// HOL Light: Multivariate/topology.ml:19677 / SAME_EIGENVALUES_MATRIX_MUL
// Source hash: md5:c1a63a4ffa1e9bbdfa028b446a8ae0f7
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R)
Theorem SAME_EIGENVALUES_MATRIX_MUL : forall N:set, N <> Empty -> forall A B :e R :^: idx N :^: idx N, forall c :e R, (exists v :e R :^: idx N, ~ v = vec N 0 /\ matrix_vector_mul N N (matrix_mul N N N A B) v = vector_mul N c v) <-> exists v :e R :^: idx N, ~ v = vec N 0 /\ matrix_vector_mul N N (matrix_mul N N N B A) v = vector_mul N c v.
Admitted.

// HOL Light: Multivariate/topology.ml:19695 / SAME_EIGENVECTORS_MATRIX_INV
// Source hash: md5:a398086d8cb4cacb8b171fe835459b6f
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem SAME_EIGENVECTORS_MATRIX_INV : forall N:set, N <> Empty -> forall A :e R :^: idx N :^: idx N, forall c :e R, forall v :e R :^: idx N, symmetric_matrix_hl N A -> (matrix_vector_mul N N (matrix_inv N N A) v = vector_mul N c v <-> matrix_vector_mul N N A v = vector_mul N (recip_SNo c) v).
Admitted.

// HOL Light: Multivariate/topology.ml:19721 / NORMAL_MATRIX_SAME_EIGENPAIRS_TRANSP
// Source hash: md5:da6723037fe60a99c906f8ad8c0f8d62
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem NORMAL_MATRIX_SAME_EIGENPAIRS_TRANSP : forall N:set, N <> Empty -> forall A :e R :^: idx N :^: idx N, normal_matrix_hl N A -> forall c :e R, forall v :e R :^: idx N, matrix_vector_mul N N (transp N N A) v = vector_mul N c v <-> matrix_vector_mul N N A v = vector_mul N c v.
Admitted.

// HOL Light: Multivariate/topology.ml:19742 / NORMAL_MATRIX_SAME_EIGENVECTORS_TRANSP
// Source hash: md5:dfdb8ce10511c3cfa13fca307b50d3ef
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem NORMAL_MATRIX_SAME_EIGENVECTORS_TRANSP : forall N:set, N <> Empty -> forall A :e R :^: idx N :^: idx N, normal_matrix_hl N A -> forall v :e R :^: idx N, (exists c :e R, matrix_vector_mul N N (transp N N A) v = vector_mul N c v) <-> exists c :e R, matrix_vector_mul N N A v = vector_mul N c v.
Admitted.

// HOL Light: Multivariate/topology.ml:19753 / DET_OPEN_MAP
// Source hash: md5:bb75ed06a3ecac5e72a27f747566ddd5
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem DET_OPEN_MAP : forall N:set, N <> Empty -> forall A :e R :^: idx N :^: idx N, forall e0 :e R, 0 < e0 -> (exists B :e R :^: idx N :^: idx N, (forall i j :e omega, abs_SNo (B i j + - A i j) < e0) /\ det N B < det N A) /\ exists C :e R :^: idx N :^: idx N, (forall i j :e omega, abs_SNo (C i j + - A i j) < e0) /\ det N A < det N C.
Admitted.

// HOL Light: Multivariate/topology.ml:19975 / SELF_ADJOINT_HAS_EIGENVECTOR_IN_SUBSPACE
// Source hash: md5:b4d6f3b9fc55f9ceaab3f65a07433584
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem SELF_ADJOINT_HAS_EIGENVECTOR_IN_SUBSPACE : forall N:set, N <> Empty -> forall f:set -> set, (forall x :e R :^: idx N, f x :e R :^: idx N) -> forall s c= R :^: idx N, linear N N f /\ ((forall x :e R :^: idx N, adjoint N N f x = f x) /\ (subspace N s /\ (~ s = {vec N 0} /\ (forall x :e R :^: idx N, x :e s -> f x :e s)))) -> exists v :e R :^: idx N, exists c :e R, v :e s /\ (sqrt_SNo_nonneg (dot N v v) = 1 /\ f v = vector_mul N c v).
Admitted.

// HOL Light: Multivariate/topology.ml:20046 / SELF_ADJOINT_HAS_EIGENVECTOR
// Source hash: md5:8392c648f8feb58af6bd655541fad40b
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem SELF_ADJOINT_HAS_EIGENVECTOR : forall N:set, N <> Empty -> forall f:set -> set, (forall x :e R :^: idx N, f x :e R :^: idx N) -> linear N N f /\ (forall x :e R :^: idx N, adjoint N N f x = f x) -> exists v :e R :^: idx N, exists c :e R, sqrt_SNo_nonneg (dot N v v) = 1 /\ f v = vector_mul N c v.
Admitted.

// HOL Light: Multivariate/topology.ml:20057 / SELF_ADJOINT_HAS_EIGENVECTOR_BASIS_OF_SUBSPACE
// Source hash: md5:f4d70f97251b3aa24b0635f97164c493
// Status: transport_required (bridges: hol_cart_setexp, hol_has_size_equip, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem SELF_ADJOINT_HAS_EIGENVECTOR_BASIS_OF_SUBSPACE : forall N:set, N <> Empty -> forall f:set -> set, (forall x :e R :^: idx N, f x :e R :^: idx N) -> forall s c= R :^: idx N, linear N N f /\ ((forall x :e R :^: idx N, adjoint N N f x = f x) /\ (subspace N s /\ (forall x :e R :^: idx N, x :e s -> f x :e s))) -> exists b c= R :^: idx N, b c= s /\ ((forall x y :e b, x <> y -> orthogonal N x y) /\ ((forall x :e R :^: idx N, x :e b -> sqrt_SNo_nonneg (dot N x x) = 1 /\ exists c :e R, f x = vector_mul N c x) /\ (independent N b /\ (span N b = s /\ equip b (dim N s))))).
Admitted.

// HOL Light: Multivariate/topology.ml:20135 / SELF_ADJOINT_HAS_EIGENVECTOR_BASIS
// Source hash: md5:ac6a2415951339e019a03e3fdac1093d
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_has_size_equip, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem SELF_ADJOINT_HAS_EIGENVECTOR_BASIS : forall N:set, N <> Empty -> forall f:set -> set, (forall x :e R :^: idx N, f x :e R :^: idx N) -> linear N N f /\ (forall x :e R :^: idx N, adjoint N N f x = f x) -> exists b c= R :^: idx N, (forall x y :e b, x <> y -> orthogonal N x y) /\ ((forall x :e R :^: idx N, x :e b -> sqrt_SNo_nonneg (dot N x x) = 1 /\ exists c :e R, f x = vector_mul N c x) /\ (independent N b /\ (span N b = R :^: idx N /\ equip b (dimindex N)))).
Admitted.

// HOL Light: Multivariate/topology.ml:20148 / EIGENVALUE_LOWERBOUND_DOT
// Source hash: md5:7d4b3d8ef2f6ffd82b2840cfc7142b65
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R)
Theorem EIGENVALUE_LOWERBOUND_DOT : forall N:set, N <> Empty -> forall A :e R :^: idx N :^: idx N, forall a :e R, symmetric_matrix_hl N A /\ (forall c :e R, forall v :e R :^: idx N, matrix_vector_mul N N A v = vector_mul N c v /\ ~ v = vec N 0 -> a <= c) -> forall x :e R :^: idx N, a * sqrt_SNo_nonneg (dot N x x) ^ 2 <= dot N x (matrix_vector_mul N N A x).
Admitted.

// HOL Light: Multivariate/topology.ml:20173 / EIGENVALUE_LOWERBOUND_DOT_EQ
// Source hash: md5:5a62b672bb41d974a77fdaccfcc8ebda
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R)
Theorem EIGENVALUE_LOWERBOUND_DOT_EQ : forall N:set, N <> Empty -> forall A :e R :^: idx N :^: idx N, forall a :e R, symmetric_matrix_hl N A -> ((forall c :e R, forall v :e R :^: idx N, matrix_vector_mul N N A v = vector_mul N c v /\ ~ v = vec N 0 -> a <= c) <-> forall x :e R :^: idx N, a * sqrt_SNo_nonneg (dot N x x) ^ 2 <= dot N x (matrix_vector_mul N N A x)).
Admitted.

// HOL Light: Multivariate/topology.ml:20189 / SYMMETRIC_MATRIX_DIAGONALIZABLE_EXPLICIT
// Source hash: md5:2446a70cc571581be1a78c6b364a4f51
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem SYMMETRIC_MATRIX_DIAGONALIZABLE_EXPLICIT : forall N:set, N <> Empty -> forall A :e R :^: idx N :^: idx N, symmetric_matrix_hl N A -> exists P :e R :^: idx N :^: idx N, exists d:set -> set, (forall x :e omega, d x :e R) /\ (orthogonal_matrix_hl N P /\ matrix_mul N N N (transp N N P) (matrix_mul N N N A P) = fun i :e idx N => fun j :e idx N => if i = j then d i else 0).
Admitted.

// HOL Light: Multivariate/topology.ml:20237 / SYMMETRIC_MATRIX_IMP_DIAGONALIZABLE
// Source hash: md5:c48ea3a1b5a1320c51b43726ad8fea92
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem SYMMETRIC_MATRIX_IMP_DIAGONALIZABLE : forall N:set, N <> Empty -> forall A :e R :^: idx N :^: idx N, symmetric_matrix_hl N A -> exists P :e R :^: idx N :^: idx N, orthogonal_matrix_hl N P /\ diagonal_matrix_hl N N (matrix_mul N N N (transp N N P) (matrix_mul N N N A P)).
Admitted.

// HOL Light: Multivariate/topology.ml:20246 / SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE
// Source hash: md5:56f38ae555b7e9d1adb372f448e9c45a
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE : forall N:set, N <> Empty -> forall A :e R :^: idx N :^: idx N, symmetric_matrix_hl N A <-> exists P :e R :^: idx N :^: idx N, orthogonal_matrix_hl N P /\ diagonal_matrix_hl N N (matrix_mul N N N (transp N N P) (matrix_mul N N N A P)).
Admitted.

// HOL Light: Multivariate/topology.ml:20262 / SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE_ALT
// Source hash: md5:0f0666d01dc7b3653525813f62af4132
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem SYMMETRIC_MATRIX_EQ_DIAGONALIZABLE_ALT : forall N:set, N <> Empty -> forall A :e R :^: idx N :^: idx N, symmetric_matrix_hl N A <-> exists P D :e R :^: idx N :^: idx N, orthogonal_matrix_hl N P /\ (diagonal_matrix_hl N N D /\ A = matrix_mul N N N (transp N N P) (matrix_mul N N N D P)).
Admitted.

// HOL Light: Multivariate/topology.ml:20288 / TRACE_MATRIX_INV_LMUL
// Source hash: md5:a27d1ebc06bf1e39a278ec3cf4e2e89d
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem TRACE_MATRIX_INV_LMUL : forall M N:set, M <> Empty -> N <> Empty -> forall A :e R :^: idx N :^: idx M, trace N (matrix_mul N M N (matrix_inv N M A) A) = rank N M A.
Admitted.

// HOL Light: Multivariate/topology.ml:20316 / TRACE_MATRIX_INV_RMUL
