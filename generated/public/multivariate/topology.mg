// Source hash: md5:a2962b5c72d0ff253715911d651e6a69
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem COMPONENTS_EQ_SING : forall N:set, N <> Empty -> forall s c= R :^: idx N, components N s = {s} <-> connected N s /\ ~ s = Empty.
Admitted.

