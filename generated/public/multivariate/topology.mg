// Source hash: md5:04a998811b9bc70be51392248b4862f6
// Status: transport_required (bridges: hol_cart_setexp, hol_le_c_atleastp, hol_real_R, hol_sum_setsum)
Theorem CARD_LE_COMPONENTS_UNION : forall N:set, N <> Empty -> forall s t c= R :^: idx N, atleastp (components N (s :\/: t)) (components N s :+: components N t).
Admitted.

// HOL Light: Multivariate/topology.ml:11921 / FINITE_COMPONENTS_UNION
// Source hash: md5:d06b38d02259396dfbde98a8a6a7afa1
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_finite, hol_real_R)
Theorem FINITE_COMPONENTS_UNION : forall N:set, N <> Empty -> forall s t c= R :^: idx N, finite (components N s) /\ finite (components N t) -> finite (components N (s :\/: t)).
Admitted.

// HOL Light: Multivariate/topology.ml:11929 / COUNTABLE_COMPONENTS_UNION
// Source hash: md5:7ae5379874377c2a9fb67e39dc1b862a
// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_real_R)
Theorem COUNTABLE_COMPONENTS_UNION : forall N:set, N <> Empty -> forall s t c= R :^: idx N, countable (components N s) /\ countable (components N t) -> countable (components N (s :\/: t)).
Admitted.

// HOL Light: Multivariate/topology.ml:11937 / MINIMAL_SEPARATING_COMMON_COMPONENT_FRONTIER_ELEMENTWISE
// Source hash: md5:496975d6618420a40b3164827e0060e6
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem MINIMAL_SEPARATING_COMMON_COMPONENT_FRONTIER_ELEMENTWISE : forall N:set, N <> Empty -> forall s c1 c2 c= R :^: idx N, forall a b :e R :^: idx N, forall t c= R :^: idx N, c1 :e components N ((R :^: idx N) :\: s) /\ (c2 :e components N ((R :^: idx N) :\: s) /\ (a :e c1 /\ (b :e c2 /\ (frontier N c1 = s /\ (frontier N c2 = s /\ (t c= s /\ t <> s)))))) -> connected_component N ((R :^: idx N) :\: t) a b.
Admitted.

// HOL Light: Multivariate/topology.ml:11961 / MINIMAL_SEPARATING_COMMON_COMPONENT_FRONTIER
// Source hash: md5:4105dfcb59fefd1c9b762b6d21b27e06
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem MINIMAL_SEPARATING_COMMON_COMPONENT_FRONTIER : forall N:set, N <> Empty -> forall s t c= R :^: idx N, t c= s /\ t <> s /\ (~ s = R :^: idx N /\ (forall c c= R :^: idx N, c :e components N ((R :^: idx N) :\: s) -> frontier N c = s)) -> connected N ((R :^: idx N) :\: t).
Admitted.

// HOL Light: Multivariate/topology.ml:12048 / CONTINUOUS_EQ_CAUCHY_CONTINUOUS_CLOSED
// Source hash: md5:983f243d5bf636f0bf5b580ad9cc5f7e
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R)
Theorem CONTINUOUS_EQ_CAUCHY_CONTINUOUS_CLOSED : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, closed M s -> (continuous_on_hl M N f s <-> forall x:set -> set, (forall x :e omega, x x :e R :^: idx M) -> cauchy M x /\ (forall n :e omega, x n :e s) -> cauchy N (fun x0:set => f (x x0))).
Admitted.

// HOL Light: Multivariate/topology.ml:12056 / UNIFORMLY_CONTINUOUS_EQ_CAUCHY_CONTINUOUS_BOUNDED
// Source hash: md5:c54462a99851fdf4bfe4977f387fc610
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R)
Theorem UNIFORMLY_CONTINUOUS_EQ_CAUCHY_CONTINUOUS_BOUNDED : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, bounded_hl M s -> (uniformly_continuous_on_hl M N f s <-> forall x:set -> set, (forall x :e omega, x x :e R :^: idx M) -> cauchy M x /\ (forall n :e omega, x n :e s) -> cauchy N (fun x0:set => f (x x0))).
Admitted.

// HOL Light: Multivariate/topology.ml:12072 / CAUCHY_CONTINUOUS_EXTENDS_TO_CAUCHY_CONTINUOUS_CLOSURE
// Source hash: md5:aa695d17910a2ddcded7c3e3798bd5a3
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R)
Theorem CAUCHY_CONTINUOUS_EXTENDS_TO_CAUCHY_CONTINUOUS_CLOSURE : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, (forall x:set -> set, (forall x :e omega, x x :e R :^: idx M) -> cauchy M x /\ (forall n :e omega, x n :e s) -> cauchy N (fun x0:set => f (x x0))) -> exists g:set -> set, (forall x :e R :^: idx M, g x :e R :^: idx N) /\ ((forall x:set -> set, (forall x :e omega, x x :e R :^: idx M) -> cauchy M x /\ (forall n :e omega, x n :e closure M s) -> cauchy N (fun x0:set => g (x x0))) /\ forall x :e R :^: idx M, x :e s -> g x = f x).
Admitted.

