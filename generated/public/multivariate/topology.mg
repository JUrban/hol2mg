// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem CLOSED_APPROACHABLE : forall A:set, A <> Empty -> forall x :e R :^: idx A, forall s c= R :^: idx A, closed A s -> ((forall e0 :e R, 0 < e0 -> exists y :e R :^: idx A, y :e s /\ distance A (y,x) < e0) <-> x :e s).
Admitted.

