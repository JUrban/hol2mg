Theorem CONTINUOUS_ON_LIFT_SQRT : forall s c= R :^: idx 1, continuous_on_hl 1 1 (fun x:set => lift (if 0 <= drop x then sqrt_SNo_nonneg (drop x) else - sqrt_SNo_nonneg (- drop x))) s.
Admitted.

