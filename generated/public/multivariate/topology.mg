// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem BOUNDED_AFFINITY : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall m :e R, forall c :e R :^: idx N, bounded_hl N s -> bounded_hl N {vector_add N (vector_mul N m x) c | x :e s}.
Admitted.

