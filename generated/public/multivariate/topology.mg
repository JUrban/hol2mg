// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_real_R)
Theorem UNCOUNTABLE_OPEN : forall N:set, N <> Empty -> forall s c= R :^: idx N, open N s /\ ~ s = Empty -> ~ countable s.
Admitted.

