// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem BOUNDED_TRANSLATION : forall N:set, N <> Empty -> forall a :e R :^: idx N, forall s c= R :^: idx N, bounded_hl N s -> bounded_hl N {vector_add N a x | x :e s}.
Admitted.

// HOL Light: Multivariate/topology.ml:5120 / BOUNDED_TRANSLATION_EQ
// Source hash: md5:e85b570f2d1d2acf4a48333578423f33
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem BOUNDED_TRANSLATION_EQ : forall N:set, N <> Empty -> forall a :e R :^: idx N, forall s c= R :^: idx N, bounded_hl N {vector_add N a x | x :e s} <-> bounded_hl N s.
Admitted.

// HOL Light: Multivariate/topology.ml:5129 / BOUNDED_SCALING_EQ
// Source hash: md5:23e71579e8e0d08e774d190f797a3f87
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem BOUNDED_SCALING_EQ : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall c :e R, bounded_hl N {vector_mul N c x | x :e s} <-> c = 0 \/ bounded_hl N s.
