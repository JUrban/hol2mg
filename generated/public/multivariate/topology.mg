Theorem PASTECART_IN_INTERIOR_SUBTOPOLOGY : forall M N:set, M <> Empty -> N <> Empty -> forall s c= R :^: idx M, forall t c= R :^: idx N, forall u c= R :^: idx_n (dimindex M + dimindex N), forall x :e R :^: idx M, forall y :e R :^: idx N, pastecart M N x y :e u /\ u :e subtopology (R :^: idx_n (dimindex M + dimindex N)) (euclidean (idx_n (dimindex M + dimindex N))) (\/_ x :e s, {pastecart M N x y | y :e t}) -> exists v c= R :^: idx M, exists w c= R :^: idx N, v :e subtopology (R :^: idx M) (euclidean M) s /\ (x :e v /\ (w :e subtopology (R :^: idx N) (euclidean N) t /\ (y :e w /\ (\/_ x :e v, {pastecart M N x y | y :e w}) c= u))).
