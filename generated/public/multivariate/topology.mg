// HOL Light: Multivariate/topology.ml:4795 / IMAGE_AFFINITY_CBALL
// Source hash: md5:96bb2e3fff65fa5bd89ad3990bdf1957
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem IMAGE_AFFINITY_CBALL : forall N:set, N <> Empty -> forall m :e R, forall c a :e R :^: idx N, forall r :e R, {vector_add N (vector_mul N m x) c | x :e cball N (a,r)} = if 0 <= r \/ ~ m = 0 then cball N (vector_add N (vector_mul N m a) c,abs_SNo m * r) else Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:4813 / IMAGE_AFFINITY_BALL
// Source hash: md5:623dc09bb0bdc7ece4279e60140d01f1
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem IMAGE_AFFINITY_BALL : forall N:set, N <> Empty -> forall m :e R, forall c a :e R :^: idx N, forall r :e R, {vector_add N (vector_mul N m x) c | x :e ball N (a,r)} = if ~ m = 0 then ball N (vector_add N (vector_mul N m a) c,abs_SNo m * r) else if r <= 0 then Empty else {c}.
Admitted.

// HOL Light: Multivariate/topology.ml:4832 / IMAGE_AFFINITY_SPHERE
// Source hash: md5:76ee96ff2ad106d8e1d4e5632f7037b2
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem IMAGE_AFFINITY_SPHERE : forall N:set, N <> Empty -> forall m :e R, forall c a :e R :^: idx N, forall r :e R, {vector_add N (vector_mul N m x) c | x :e sphere N (a,r)} = if 0 <= r \/ ~ m = 0 then sphere N (vector_add N (vector_mul N m a) c,abs_SNo m * r) else Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:4854 / EVENTUALLY_WITHIN_INTERIOR_INTER
// Source hash: md5:7b899f6b265ee6ba58d0c46b638adeaf
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_net)
Theorem EVENTUALLY_WITHIN_INTERIOR_INTER : forall A:set, A <> Empty -> forall p s t c= R :^: idx A, forall x :e R :^: idx A, x :e interior A s -> (eventually (R :^: idx A) p (within (R :^: idx A) (at A x) (s :/\: t)) <-> eventually (R :^: idx A) p (within (R :^: idx A) (at A x) t)).
Admitted.

// HOL Light: Multivariate/topology.ml:4882 / CONNECTED_IMP_PERFECT
// Source hash: md5:5f5dad2064f3a19768ec30046f0becbe
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_IMP_PERFECT : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x :e R :^: idx N, connected N s /\ (~ (exists a :e R :^: idx N, s = {a}) /\ x :e s) -> limit_point_of N x s.
Admitted.

// HOL Light: Multivariate/topology.ml:4891 / CONNECTED_IMP_PERFECT_CLOSED
// Source hash: md5:586bf19fe8f895a21a28e31a001d9ea8
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_IMP_PERFECT_CLOSED : forall A:set, A <> Empty -> forall s c= R :^: idx A, forall x :e R :^: idx A, connected A s /\ (closed A s /\ ~ (exists a :e R :^: idx A, s = {a})) -> (limit_point_of A x s <-> x :e s).
Admitted.

// HOL Light: Multivariate/topology.ml:4896 / CONNECTED_LIMIT_POINTS_EQ_CLOSURE
// Source hash: md5:7ad08e7ceb704e7b49fa866d5a0cadf4
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_LIMIT_POINTS_EQ_CLOSURE : forall N:set, N <> Empty -> forall s c= R :^: idx N, connected N s /\ ~ (exists a :e R :^: idx N, s = {a}) -> {x :e R :^: idx N | limit_point_of N x s} = closure N s.
Admitted.

