Admitted.

// HOL Light: Multivariate/topology.ml:10670 / UPPER_HEMICONTINUOUS
// Source hash: md5:6f2e72c1fed7682947f082217005af62
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem UPPER_HEMICONTINUOUS : forall M N:set, M <> Empty -> N <> Empty -> forall f :e Power (R :^: idx N) :^: (R :^: idx M), forall t c= R :^: idx N, forall s c= R :^: idx M, (forall x :e R :^: idx M, x :e s -> f x c= t) -> ((forall u c= R :^: idx N, u :e subtopology (R :^: idx N) (euclidean N) t -> {x :e R :^: idx M | x :e s /\ f x c= u} :e subtopology (R :^: idx M) (euclidean M) s) <-> forall u c= R :^: idx N, closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) t) u -> closed_in (R :^: idx M) (subtopology (R :^: idx M) (euclidean M) s) {x :e R :^: idx M | x :e s /\ ~ f x :/\: u = Empty}).
Admitted.

// HOL Light: Multivariate/topology.ml:10687 / LOWER_HEMICONTINUOUS
// Source hash: md5:7aaf6610f7a0179d9d11cf750bdb5d9b
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem LOWER_HEMICONTINUOUS : forall M N:set, M <> Empty -> N <> Empty -> forall f :e Power (R :^: idx N) :^: (R :^: idx M), forall t c= R :^: idx N, forall s c= R :^: idx M, (forall x :e R :^: idx M, x :e s -> f x c= t) -> ((forall u c= R :^: idx N, closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) t) u -> closed_in (R :^: idx M) (subtopology (R :^: idx M) (euclidean M) s) {x :e R :^: idx M | x :e s /\ f x c= u}) <-> forall u c= R :^: idx N, u :e subtopology (R :^: idx N) (euclidean N) t -> {x :e R :^: idx M | x :e s /\ ~ f x :/\: u = Empty} :e subtopology (R :^: idx M) (euclidean M) s).
Admitted.

// HOL Light: Multivariate/topology.ml:10704 / OPEN_MAP_IFF_LOWER_HEMICONTINUOUS_PREIMAGE
// Source hash: md5:5d76c91e74bead870eb444e265b257fc
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem OPEN_MAP_IFF_LOWER_HEMICONTINUOUS_PREIMAGE : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, forall t c= R :^: idx N, {f x | x :e s} c= t -> ((forall u c= R :^: idx M, u :e subtopology (R :^: idx M) (euclidean M) s -> {f x | x :e u} :e subtopology (R :^: idx N) (euclidean N) t) <-> forall u c= R :^: idx M, closed_in (R :^: idx M) (subtopology (R :^: idx M) (euclidean M) s) u -> closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) t) {y :e R :^: idx N | y :e t /\ {x :e R :^: idx M | x :e s /\ f x = y} c= u}).
Admitted.

// HOL Light: Multivariate/topology.ml:10729 / CLOSED_MAP_IFF_UPPER_HEMICONTINUOUS_PREIMAGE
// Source hash: md5:d50e5164d9691ea9a558165f73600edd
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CLOSED_MAP_IFF_UPPER_HEMICONTINUOUS_PREIMAGE : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, forall t c= R :^: idx N, {f x | x :e s} c= t -> ((forall u c= R :^: idx M, closed_in (R :^: idx M) (subtopology (R :^: idx M) (euclidean M) s) u -> closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) t) {f x | x :e u}) <-> forall u c= R :^: idx M, u :e subtopology (R :^: idx M) (euclidean M) s -> {y :e R :^: idx N | y :e t /\ {x :e R :^: idx M | x :e s /\ f x = y} c= u} :e subtopology (R :^: idx N) (euclidean N) t).
Admitted.

// HOL Light: Multivariate/topology.ml:10754 / UPPER_LOWER_HEMICONTINUOUS_EXPLICIT
// Source hash: md5:0df6c2f6d8bd8aec5993abccc24c6421
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_topology, omega_Subq_R)
Theorem UPPER_LOWER_HEMICONTINUOUS_EXPLICIT : forall M N:set, M <> Empty -> N <> Empty -> forall f :e Power (R :^: idx N) :^: (R :^: idx M), forall t c= R :^: idx N, forall s c= R :^: idx M, (forall x :e R :^: idx M, x :e s -> f x c= t) /\ ((forall u c= R :^: idx N, u :e subtopology (R :^: idx N) (euclidean N) t -> {x :e R :^: idx M | x :e s /\ f x c= u} :e subtopology (R :^: idx M) (euclidean M) s) /\ (forall u c= R :^: idx N, closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) t) u -> closed_in (R :^: idx M) (subtopology (R :^: idx M) (euclidean M) s) {x :e R :^: idx M | x :e s /\ f x c= u})) -> forall x :e R :^: idx M, forall e0 :e R, x :e s /\ (0 < e0 /\ (bounded_hl N (f x) /\ ~ f x = Empty)) -> exists d :e R, 0 < d /\ forall x' :e R :^: idx M, x' :e s /\ distance M (x,x') < d -> (forall y :e R :^: idx N, y :e f x -> exists y' :e R :^: idx N, y' :e f x' /\ distance N (y,y') < e0) /\ forall y' :e R :^: idx N, y' :e f x' -> exists y :e R :^: idx N, y :e f x /\ distance N (y',y) < e0.
Admitted.

// HOL Light: Multivariate/topology.ml:10858 / connected_component
// Source hash: md5:f8a0742bd2f29e507b230f09ee059019
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem connected_component_thm : forall A:set, A <> Empty -> forall s c= R :^: idx A, forall x y :e R :^: idx A, connected_component A s x y <-> exists t c= R :^: idx A, connected A t /\ (t c= s /\ (x :e t /\ y :e t)).
Admitted.

// HOL Light: Multivariate/topology.ml:10862 / CONNECTED_COMPONENT_OF_EUCLIDEAN
// Source hash: md5:4e21cc869ccae9e2cbdd27787c61caf5
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CONNECTED_COMPONENT_OF_EUCLIDEAN : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x x0 :e R :^: idx N, connected_component_of (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) s) x x0 <-> connected_component N s x x0.
Admitted.

// HOL Light: Multivariate/topology.ml:10870 / CONNECTED_COMPONENT_IN
// Source hash: md5:804cad9235875d0311ccc7a070d666d7
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENT_IN : forall A:set, A <> Empty -> forall s c= R :^: idx A, forall x y :e R :^: idx A, connected_component A s x y -> x :e s /\ y :e s.
Admitted.

// HOL Light: Multivariate/topology.ml:10874 / CONNECTED_COMPONENT_REFL
// Source hash: md5:fd7048add090809a10aca6a8492ee0f2
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENT_REFL : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x :e R :^: idx N, x :e s -> connected_component N s x x.
Admitted.

// HOL Light: Multivariate/topology.ml:10880 / CONNECTED_COMPONENT_REFL_EQ
// Source hash: md5:cd2f23724eb8f85f97f83fa86dd1e9e4
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENT_REFL_EQ : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x :e R :^: idx N, connected_component N s x x <-> x :e s.
Admitted.

// HOL Light: Multivariate/topology.ml:10885 / CONNECTED_COMPONENT_SYM
// Source hash: md5:3ea2c5fb0be7d27e75543c41b7714f98
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENT_SYM : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x y :e R :^: idx N, connected_component N s x y -> connected_component N s y x.
Admitted.

// HOL Light: Multivariate/topology.ml:10889 / CONNECTED_COMPONENT_TRANS
// Source hash: md5:1306f05b6a55d7cb6bf0907776d728d0
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENT_TRANS : forall N:set, N <> Empty -> forall z :e R :^: idx N, forall s c= R :^: idx N, forall x y :e R :^: idx N, connected_component N s x y /\ connected_component N s y z -> connected_component N s x z.
Admitted.

// HOL Light: Multivariate/topology.ml:10900 / CONNECTED_COMPONENT_OF_SUBSET
// Source hash: md5:5e07923c28dad532504bdb2886852368
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENT_OF_SUBSET : forall A:set, A <> Empty -> forall y :e R :^: idx A, forall s t c= R :^: idx A, forall x :e R :^: idx A, s c= t /\ connected_component A s x y -> connected_component A t x y.
Admitted.

// HOL Light: Multivariate/topology.ml:10905 / CONNECTED_COMPONENT_SET
// Source hash: md5:4298bd2ef71b7dee6b944f21ca39c9cc
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENT_SET : forall A:set, A <> Empty -> forall s c= R :^: idx A, forall x x0 :e R :^: idx A, connected_component A s x x0 <-> x0 :e {y :e R :^: idx A | exists t c= R :^: idx A, connected A t /\ (t c= s /\ (x :e t /\ y :e t))}.
Admitted.

// HOL Light: Multivariate/topology.ml:10911 / CONNECTED_COMPONENT_UNIONS
// Source hash: md5:0d9b319a5bf328534724eb4bb5b72cee
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENT_UNIONS : forall A:set, A <> Empty -> forall s c= R :^: idx A, forall x x0 :e R :^: idx A, connected_component A s x x0 <-> x0 :e Union {t :e Power (R :^: idx A) | connected A t /\ (x :e t /\ t c= s)}.
Admitted.

// HOL Light: Multivariate/topology.ml:10916 / CONNECTED_COMPONENT_SUBSET
// Source hash: md5:828ac0bcf4b61022a516ec034f9f53ad
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENT_SUBSET : forall A:set, A <> Empty -> forall s c= R :^: idx A, forall x :e R :^: idx A, {x0 :e R :^: idx A | connected_component A s x x0} c= s.
Admitted.

// HOL Light: Multivariate/topology.ml:10920 / CONNECTED_CONNECTED_COMPONENT_SET
// Source hash: md5:1d4e8ebec1d5ac5749e74fc812591823
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_CONNECTED_COMPONENT_SET : forall N:set, N <> Empty -> forall s c= R :^: idx N, connected N s <-> forall x :e R :^: idx N, x :e s -> forall x0 :e R :^: idx N, connected_component N s x x0 <-> x0 :e s.
Admitted.

// HOL Light: Multivariate/topology.ml:10932 / CONNECTED_COMPONENT_UNIV
// Source hash: md5:f218a35e558ab9e175cc26ed33aa2787
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENT_UNIV : forall N:set, N <> Empty -> forall x x0 :e R :^: idx N, connected_component N (R :^: idx N) x x0 <-> x0 :e R :^: idx N.
Admitted.

// HOL Light: Multivariate/topology.ml:10936 / CONNECTED_COMPONENT_EQ_UNIV
// Source hash: md5:15413ad55f1420f0edb7bd0b3003c45e
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENT_EQ_UNIV : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x :e R :^: idx N, (forall x0 :e R :^: idx N, connected_component N s x x0 <-> x0 :e R :^: idx N) <-> s = R :^: idx N.
Admitted.

// HOL Light: Multivariate/topology.ml:10942 / CONNECTED_COMPONENT_EQ_SELF
// Source hash: md5:9ab13861a352e88a20e82a40c54b5d98
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENT_EQ_SELF : forall A:set, A <> Empty -> forall s c= R :^: idx A, forall x :e R :^: idx A, connected A s /\ x :e s -> forall x0 :e R :^: idx A, connected_component A s x x0 <-> x0 :e s.
Admitted.

// HOL Light: Multivariate/topology.ml:10946 / CONNECTED_IFF_CONNECTED_COMPONENT
// Source hash: md5:e391fe994276e3491155225b46f98a18
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_IFF_CONNECTED_COMPONENT : forall A:set, A <> Empty -> forall s c= R :^: idx A, connected A s <-> forall x y :e R :^: idx A, x :e s /\ y :e s -> connected_component A s x y.
Admitted.

// HOL Light: Multivariate/topology.ml:10952 / CONNECTED_IMP_CONNECTED_COMPONENT
// Source hash: md5:d5fb9314e6208fffe13ec6e48ad3ae18
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_IMP_CONNECTED_COMPONENT : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall a b :e R :^: idx N, connected N s /\ (a :e s /\ b :e s) -> connected_component N s a b.
Admitted.

// HOL Light: Multivariate/topology.ml:10957 / CONNECTED_COMPONENT_MAXIMAL
// Source hash: md5:cc582d8d9db503c66f2ffecbd61dd55f
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENT_MAXIMAL : forall N:set, N <> Empty -> forall s t c= R :^: idx N, forall x :e R :^: idx N, x :e t /\ (connected N t /\ t c= s) -> t c= {x0 :e R :^: idx N | connected_component N s x x0}.
Admitted.

// HOL Light: Multivariate/topology.ml:10963 / CONNECTED_COMPONENT_MONO
// Source hash: md5:2392c3ccd9ecd5b17bda9e4dc5ba4c1a
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENT_MONO : forall A:set, A <> Empty -> forall s t c= R :^: idx A, forall x :e R :^: idx A, s c= t -> {x0 :e R :^: idx A | connected_component A s x x0} c= {x0 :e R :^: idx A | connected_component A t x x0}.
Admitted.

// HOL Light: Multivariate/topology.ml:10968 / CONNECTED_CONNECTED_COMPONENT
// Source hash: md5:55b38f3be2671b9552a830ecccc11b5d
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_CONNECTED_COMPONENT : forall A:set, A <> Empty -> forall s c= R :^: idx A, forall x :e R :^: idx A, connected A {x0 :e R :^: idx A | connected_component A s x x0}.
Admitted.

// HOL Light: Multivariate/topology.ml:10973 / CONNECTED_COMPONENT_EQ_EMPTY
// Source hash: md5:623275648d7e8fa4d3a4103611dbd710
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENT_EQ_EMPTY : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x :e R :^: idx N, (forall x0 :e R :^: idx N, connected_component N s x x0 <-> x0 :e Empty) <-> ~ x :e s.
Admitted.

// HOL Light: Multivariate/topology.ml:10981 / CONNECTED_COMPONENT_EMPTY
// Source hash: md5:7006e0008e107b3f7c272371082afea2
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENT_EMPTY : forall A:set, A <> Empty -> forall x x0 :e R :^: idx A, connected_component A Empty x x0 <-> x0 :e Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:10985 / CONNECTED_COMPONENT_EQ
// Source hash: md5:d0fc9706b68f86456b145df4f91ce981
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENT_EQ : forall A:set, A <> Empty -> forall s c= R :^: idx A, forall x y :e R :^: idx A, y :e {x0 :e R :^: idx A | connected_component A s x x0} -> forall x0 :e R :^: idx A, connected_component A s y x0 <-> connected_component A s x x0.
Admitted.

// HOL Light: Multivariate/topology.ml:10991 / CLOSED_CONNECTED_COMPONENT
// Source hash: md5:c2550a126b2b4ed16df932d604d8bd9a
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSED_CONNECTED_COMPONENT : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x :e R :^: idx N, closed N s -> closed N {x0 :e R :^: idx N | connected_component N s x x0}.
Admitted.

// HOL Light: Multivariate/topology.ml:11006 / CONNECTED_COMPONENT_DISJOINT
// Source hash: md5:8c0378c3b3691c11bcb62442ef37e37e
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENT_DISJOINT : forall A:set, A <> Empty -> forall s c= R :^: idx A, forall a b :e R :^: idx A, {x :e R :^: idx A | connected_component A s a x} :/\: {x :e R :^: idx A | connected_component A s b x} = Empty <-> ~ a :e {x :e R :^: idx A | connected_component A s b x}.
Admitted.

// HOL Light: Multivariate/topology.ml:11013 / CONNECTED_COMPONENT_NONOVERLAP
// Source hash: md5:ce15d5473a83ca94ed9ddae26f862e69
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENT_NONOVERLAP : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall a b :e R :^: idx N, {x :e R :^: idx N | connected_component N s a x} :/\: {x :e R :^: idx N | connected_component N s b x} = Empty <-> ~ a :e s \/ (~ b :e s \/ ~ forall x :e R :^: idx N, connected_component N s a x <-> connected_component N s b x).
Admitted.

// HOL Light: Multivariate/topology.ml:11033 / CONNECTED_COMPONENT_OVERLAP
// Source hash: md5:49515e68085f02a80e77bcafb5678560
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENT_OVERLAP : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall a b :e R :^: idx N, ~ {x :e R :^: idx N | connected_component N s a x} :/\: {x :e R :^: idx N | connected_component N s b x} = Empty <-> a :e s /\ (b :e s /\ forall x :e R :^: idx N, connected_component N s a x <-> connected_component N s b x).
Admitted.

// HOL Light: Multivariate/topology.ml:11040 / CONNECTED_COMPONENT_SYM_EQ
// Source hash: md5:4664780a7c3cdd888ccee546f3f03a4f
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENT_SYM_EQ : forall A:set, A <> Empty -> forall s c= R :^: idx A, forall x y :e R :^: idx A, connected_component A s x y <-> connected_component A s y x.
Admitted.

// HOL Light: Multivariate/topology.ml:11044 / CONNECTED_COMPONENT_EQ_EQ
// Source hash: md5:da0da607e502f4fe92a830a3c8bbc92d
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENT_EQ_EQ : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x y :e R :^: idx N, (forall x0 :e R :^: idx N, connected_component N s x x0 <-> connected_component N s y x0) <-> ~ x :e s /\ ~ y :e s \/ x :e s /\ (y :e s /\ connected_component N s x y).
Admitted.

// HOL Light: Multivariate/topology.ml:11060 / CONNECTED_EQ_CONNECTED_COMPONENT_EQ
// Source hash: md5:59153bf023b69bda578892b1c59e77c2
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_EQ_CONNECTED_COMPONENT_EQ : forall A:set, A <> Empty -> forall s c= R :^: idx A, connected A s <-> forall x y :e R :^: idx A, x :e s /\ y :e s -> forall x0 :e R :^: idx A, connected_component A s x x0 <-> connected_component A s y x0.
Admitted.

// HOL Light: Multivariate/topology.ml:11067 / CONNECTED_COMPONENT_IDEMP
// Source hash: md5:9b1863848fd91746a9d42156090b4510
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENT_IDEMP : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x x0 :e R :^: idx N, connected_component N {x1 :e R :^: idx N | connected_component N s x x1} x x0 <-> connected_component N s x x0.
Admitted.

// HOL Light: Multivariate/topology.ml:11076 / CONNECTED_COMPONENT_UNIQUE
// Source hash: md5:157079b88b87700be03162561d25b949
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENT_UNIQUE : forall N:set, N <> Empty -> forall s c c= R :^: idx N, forall x :e R :^: idx N, x :e c /\ (c c= s /\ (connected N c /\ (forall c' c= R :^: idx N, x :e c' /\ (c' c= s /\ connected N c') -> c' c= c))) -> forall x0 :e R :^: idx N, connected_component N s x x0 <-> x0 :e c.
Admitted.

// HOL Light: Multivariate/topology.ml:11089 / JOINABLE_CONNECTED_COMPONENT_EQ
// Source hash: md5:ea1eb347a08c44596425d7235e12bd26
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem JOINABLE_CONNECTED_COMPONENT_EQ : forall N:set, N <> Empty -> forall s t c= R :^: idx N, forall x y :e R :^: idx N, connected N t /\ (t c= s /\ (~ {x0 :e R :^: idx N | connected_component N s x x0} :/\: t = Empty /\ ~ {x0 :e R :^: idx N | connected_component N s y x0} :/\: t = Empty)) -> forall x0 :e R :^: idx N, connected_component N s x x0 <-> connected_component N s y x0.
Admitted.

// HOL Light: Multivariate/topology.ml:11110 / CONNECTED_COMPONENT_TRANSLATION
// Source hash: md5:86290f45589a592f3058a5481ad1bfaf
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENT_TRANSLATION : forall A:set, A <> Empty -> forall a :e R :^: idx A, forall s c= R :^: idx A, forall x x0 :e R :^: idx A, connected_component A {vector_add A a x1 | x1 :e s} (vector_add A a x) x0 <-> x0 :e {vector_add A a x1 | x1 :e {x1 :e R :^: idx A | connected_component A s x x1}}.
Admitted.

// HOL Light: Multivariate/topology.ml:11117 / CONNECTED_COMPONENT_LINEAR_IMAGE
// Source hash: md5:2d9d1c8a45ff214bee0aa636b0394b1d
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENT_LINEAR_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e R :^: idx B, f x :e R :^: idx A) -> forall s c= R :^: idx B, forall x :e R :^: idx B, linear B A f /\ ((forall x0 y :e R :^: idx B, f x0 = f y -> x0 = y) /\ (forall y :e R :^: idx A, exists x0 :e R :^: idx B, f x0 = y)) -> forall x0 :e R :^: idx A, connected_component A {f x | x :e s} (f x) x0 <-> x0 :e {f x0 | x0 :e {x1 :e R :^: idx B | connected_component B s x x1}}.
Admitted.

// HOL Light: Multivariate/topology.ml:11126 / UNIONS_CONNECTED_COMPONENT
// Source hash: md5:735adc99187704085700c3da8bda099f
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem UNIONS_CONNECTED_COMPONENT : forall N:set, N <> Empty -> forall s c= R :^: idx N, Union {{x0 :e R :^: idx N | connected_component N s x x0} | x :e R :^: idx N, x :e s} = s.
Admitted.

// HOL Light: Multivariate/topology.ml:11135 / COMPLEMENT_CONNECTED_COMPONENT_UNIONS
// Source hash: md5:cafeacca82d5f211cc06159bccbb5c59
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem COMPLEMENT_CONNECTED_COMPONENT_UNIONS : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x :e R :^: idx N, s :\: {x0 :e R :^: idx N | connected_component N s x x0} = Union ({{x0 :e R :^: idx N | connected_component N s y x0} | y :e R :^: idx N, y :e s} :\: {{x0 :e R :^: idx N | connected_component N s x x0}}).
Admitted.

// HOL Light: Multivariate/topology.ml:11150 / CLOSED_IN_CONNECTED_COMPONENT
// Source hash: md5:6c4eddd6c2560565ecf84a200c7dcc22
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CLOSED_IN_CONNECTED_COMPONENT : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x :e R :^: idx N, closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) s) {x0 :e R :^: idx N | connected_component N s x x0}.
Admitted.

// HOL Light: Multivariate/topology.ml:11170 / OPEN_IN_CONNECTED_COMPONENT
// Source hash: md5:b412c472b5c6759486d209bee1ccf1b7
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_finite, hol_real_R, hol_typedef_topology)
Theorem OPEN_IN_CONNECTED_COMPONENT : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x :e R :^: idx N, finite {{x1 :e R :^: idx N | connected_component N s x0 x1} | x0 :e R :^: idx N, x0 :e s} -> {x0 :e R :^: idx N | connected_component N s x x0} :e subtopology (R :^: idx N) (euclidean N) s.
Admitted.

// HOL Light: Multivariate/topology.ml:11201 / CONNECTED_COMPONENT_EQUIVALENCE_RELATION
// Source hash: md5:deae28bd4f0a9617e49eacef2bb935ea
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CONNECTED_COMPONENT_EQUIVALENCE_RELATION : forall N:set, N <> Empty -> forall R0:set -> set -> prop, forall s c= R :^: idx N, (forall x y :e R :^: idx N, R0 x y -> R0 y x) /\ ((forall x y z :e R :^: idx N, R0 x y /\ R0 y z -> R0 x z) /\ (forall a :e R :^: idx N, a :e s -> exists t c= R :^: idx N, t :e subtopology (R :^: idx N) (euclidean N) s /\ (a :e t /\ forall x :e R :^: idx N, x :e t -> R0 a x))) -> forall a b :e R :^: idx N, connected_component N s a b -> R0 a b.
Admitted.

// HOL Light: Multivariate/topology.ml:11228 / CONNECTED_COMPONENT_INTERMEDIATE_SUBSET
// Source hash: md5:4a39bb6ff9c44b44aeddf3e7c473d0a6
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENT_INTERMEDIATE_SUBSET : forall N:set, N <> Empty -> forall t u c= R :^: idx N, forall a :e R :^: idx N, {x :e R :^: idx N | connected_component N u a x} c= t /\ t c= u -> forall x :e R :^: idx N, connected_component N t a x <-> connected_component N u a x.
Admitted.

// HOL Light: Multivariate/topology.ml:11240 / CONNECTED_UNIONS_STRONG
// Source hash: md5:cde486b3bf771802d42a23ee9eb60116
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_UNIONS_STRONG : forall N:set, N <> Empty -> forall f c= Power (R :^: idx N), (forall s c= R :^: idx N, s :e f -> connected N s) /\ ~ Union f :/\: {x :e R :^: idx N | forall Y :e {closure N s | s :e Power (R :^: idx N), s :e f}, x :e Y} = Empty -> connected N (Union f).
Admitted.

// HOL Light: Multivariate/topology.ml:11263 / NOT_CONNECTED_COMPONENT_SEPARATED_UNION
// Source hash: md5:46cb688b830488670eac8a135010d9f9
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem NOT_CONNECTED_COMPONENT_SEPARATED_UNION : forall N:set, N <> Empty -> forall s t c= R :^: idx N, forall x y :e R :^: idx N, s :/\: closure N t = Empty /\ (t :/\: closure N s = Empty /\ (x :e s /\ y :e t)) -> ~ connected_component N (s :\/: t) x y.
Admitted.

// HOL Light: Multivariate/topology.ml:11297 / CONNECTED_CONNECTED_DIFF
// Source hash: md5:7155fa9bc6a0529bbb264c314456cb65
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CONNECTED_CONNECTED_DIFF : forall N:set, N <> Empty -> forall s t c= R :^: idx N, connected N s /\ (s c= closure N (s :\: t) /\ (forall x :e R :^: idx N, x :e s -> exists u c= R :^: idx N, x :e u /\ (u :e subtopology (R :^: idx N) (euclidean N) s /\ connected N (u :\: t)))) -> connected N (s :\: t).
Admitted.

// HOL Light: Multivariate/topology.ml:11341 / components
// Source hash: md5:0b50875c6aa53032136537c9064ad469
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem components_thm : forall N:set, N <> Empty -> forall s c= R :^: idx N, components N s = {{x0 :e R :^: idx N | connected_component N s x x0} | x :e R :^: idx N, x :e s}.
Admitted.

// HOL Light: Multivariate/topology.ml:11344 / EUCLIDEAN_CONNECTED_COMPONENTS_OF
// Source hash: md5:8b7cbcd1c90f21e6cf390f97c823701c
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem EUCLIDEAN_CONNECTED_COMPONENTS_OF : forall N:set, N <> Empty -> forall s c= R :^: idx N, connected_components_of (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) s) = components N s.
Admitted.

// HOL Light: Multivariate/topology.ml:11351 / PAIRWISE_SEPARATED_COMPONENTS
// Source hash: md5:6b75e6716c5f58eebd0467fd7e7791b7
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem PAIRWISE_SEPARATED_COMPONENTS : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x y :e components N s, x <> y -> separated_in (R :^: idx N) (euclidean N) x y.
Admitted.

// HOL Light: Multivariate/topology.ml:11360 / COMPONENTS_TRANSLATION
// Source hash: md5:2ca7b183c984ab89cb75cf4fd53cd971
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem COMPONENTS_TRANSLATION : forall A:set, A <> Empty -> forall a :e R :^: idx A, forall s c= R :^: idx A, components A {vector_add A a x | x :e s} = {{x0 :e R :^: idx A | x0 :e {vector_add A a x0 | x0 :e x}} | x :e components A s}.
Admitted.

// HOL Light: Multivariate/topology.ml:11367 / COMPONENTS_LINEAR_IMAGE
// Source hash: md5:ac5cfdbc30df9a0f1331503092804c96
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem COMPONENTS_LINEAR_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e R :^: idx B, f x :e R :^: idx A) -> forall s c= R :^: idx B, linear B A f /\ ((forall x y :e R :^: idx B, f x = f y -> x = y) /\ (forall y :e R :^: idx A, exists x :e R :^: idx B, f x = y)) -> components A {f x | x :e s} = {{x0 :e R :^: idx A | x0 :e {f x0 | x0 :e x}} | x :e components B s}.
Admitted.

// HOL Light: Multivariate/topology.ml:11374 / IN_COMPONENTS
// Source hash: md5:c0cc1fae11d0a1e25c363853157cef28
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem IN_COMPONENTS : forall N:set, N <> Empty -> forall u s c= R :^: idx N, s :e components N u <-> exists x :e R :^: idx N, x :e u /\ forall x0 :e R :^: idx N, x0 :e s <-> connected_component N u x x0.
Admitted.

// HOL Light: Multivariate/topology.ml:11381 / CONNECTED_COMPONENTS
// Source hash: md5:7ae68e8179a9260f53d0f746a36c7217
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENTS : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall a b :e R :^: idx N, connected_component N s a b <-> exists c c= R :^: idx N, c :e components N s /\ (a :e c /\ b :e c).
Admitted.

// HOL Light: Multivariate/topology.ml:11390 / UNIONS_COMPONENTS
// Source hash: md5:6685c6daf5aef0378fe9490e2351889f
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem UNIONS_COMPONENTS : forall N:set, N <> Empty -> forall u c= R :^: idx N, u = Union (components N u).
Admitted.

// HOL Light: Multivariate/topology.ml:11407 / PAIRWISE_DISJOINT_COMPONENTS
// Source hash: md5:f648f6ed37a25d2b87b3ea38155d2000
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem PAIRWISE_DISJOINT_COMPONENTS : forall N:set, N <> Empty -> forall u c= R :^: idx N, forall x y :e components N u, x <> y -> x :/\: y = Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:11416 / IN_COMPONENTS_NONEMPTY
// Source hash: md5:72f24cd063efbfa1db36a60437befbcd
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem IN_COMPONENTS_NONEMPTY : forall A:set, A <> Empty -> forall s c c= R :^: idx A, c :e components A s -> ~ c = Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:11421 / IN_COMPONENTS_SUBSET
// Source hash: md5:552fff5edf4717ff94a10474ab658981
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem IN_COMPONENTS_SUBSET : forall A:set, A <> Empty -> forall s c c= R :^: idx A, c :e components A s -> c c= s.
Admitted.

// HOL Light: Multivariate/topology.ml:11426 / IN_COMPONENTS_CONNECTED
// Source hash: md5:421ba90d7f35a3a893d5802572099ade
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem IN_COMPONENTS_CONNECTED : forall A:set, A <> Empty -> forall s c c= R :^: idx A, c :e components A s -> connected A c.
Admitted.

// HOL Light: Multivariate/topology.ml:11431 / CONNECTED_COMPONENT_IN_COMPONENTS
// Source hash: md5:57737348e88259cfdcfc52ecb0fedd46
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_COMPONENT_IN_COMPONENTS : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x :e R :^: idx N, {x0 :e R :^: idx N | connected_component N s x x0} :e components N s <-> x :e s.
Admitted.

// HOL Light: Multivariate/topology.ml:11439 / IN_COMPONENTS_MAXIMAL
// Source hash: md5:207609f140ee052552baaa2ca7b963e5
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem IN_COMPONENTS_MAXIMAL : forall N:set, N <> Empty -> forall s c c= R :^: idx N, c :e components N s <-> ~ c = Empty /\ (c c= s /\ (connected N c /\ forall c' c= R :^: idx N, ~ c' = Empty /\ (c c= c' /\ (c' c= s /\ connected N c')) -> c' = c)).
Admitted.

// HOL Light: Multivariate/topology.ml:11463 / JOINABLE_COMPONENTS_EQ
// Source hash: md5:dfb5df42a45e0e6ec5975018c7ab10c7
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem JOINABLE_COMPONENTS_EQ : forall A:set, A <> Empty -> forall s t c1 c2 c= R :^: idx A, connected A t /\ (t c= s /\ (c1 :e components A s /\ (c2 :e components A s /\ (~ c1 :/\: t = Empty /\ ~ c2 :/\: t = Empty)))) -> c1 = c2.
Admitted.

