// Source hash: md5:a1add8568548eeeec857d85c94c755dd
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem BOUNDED_DIFFS : forall N:set, N <> Empty -> forall s t c= R :^: idx N, bounded_hl N s /\ bounded_hl N t -> bounded_hl N (\/_ x :e R :^: idx N, {vector_sub N x y | y :e R :^: idx N, x :e s /\ y :e t}).
Admitted.

