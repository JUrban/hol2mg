// Source hash: md5:65fd4075e55aa0cf56f4799a4108a952
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem CONNECTED_AFFINITY_EQ : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall m :e R, forall c :e R :^: idx N, connected N {vector_add N (vector_mul N m x) c | x :e s} <-> m = 0 \/ connected N s.
Admitted.

// HOL Light: Multivariate/topology.ml:12771 / CONNECTED_AFFINITY
// Source hash: md5:dfed55a4b42d3042a2c73ce8ed8188f0
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_AFFINITY : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall m :e R, forall c :e R :^: idx N, connected N s -> connected N {vector_add N (vector_mul N m x) c | x :e s}.
Admitted.

// HOL Light: Multivariate/topology.ml:12775 / CONNECTED_SUMS
// Source hash: md5:1c823528e629d965471a04112d47c551
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_SUMS : forall N:set, N <> Empty -> forall s t c= R :^: idx N, connected N s /\ connected N t -> connected N (\/_ x :e R :^: idx N, {vector_add N x y | y :e R :^: idx N, x :e s /\ y :e t}).
Admitted.

// HOL Light: Multivariate/topology.ml:12880 / diameter
// Source hash: md5:58a6915c8cddb1d514faf4aba0af1190
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem diameter_thm : forall A:set, A <> Empty -> forall s c= R :^: idx A, diameter A s = if s = Empty then 0 else sup (\/_ x :e R :^: idx A, {sqrt_SNo_nonneg (dot A (vector_sub A x y) (vector_sub A x y)) | y :e R :^: idx A, x :e s /\ y :e s}).
Admitted.

// HOL Light: Multivariate/topology.ml:12885 / MDIAMETER_EUCLIDEAN
// Source hash: md5:dc4f477565178d725239944fe9f083e3
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_metric)
Theorem MDIAMETER_EUCLIDEAN : forall N:set, N <> Empty -> forall x c= R :^: idx N, mdiameter (R :^: idx N) (euclidean_metric N) x = diameter N x.
Admitted.

// HOL Light: Multivariate/topology.ml:12889 / DIAMETER_BOUNDED
// Source hash: md5:9c8c4feef3faa30c9cbb41886173669e
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem DIAMETER_BOUNDED : forall N:set, N <> Empty -> forall s c= R :^: idx N, bounded_hl N s -> (forall x y :e R :^: idx N, x :e s /\ y :e s -> sqrt_SNo_nonneg (dot N (vector_sub N x y) (vector_sub N x y)) <= diameter N s) /\ forall d :e R, 0 <= d /\ d < diameter N s -> exists x y :e R :^: idx N, x :e s /\ (y :e s /\ d < sqrt_SNo_nonneg (dot N (vector_sub N x y) (vector_sub N x y))).
Admitted.

// HOL Light: Multivariate/topology.ml:12897 / DIAMETER_BOUNDED_BOUND
// Source hash: md5:ae848146e03906c05965fd8cb3afb4f0
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem DIAMETER_BOUNDED_BOUND : forall A:set, A <> Empty -> forall s c= R :^: idx A, forall x y :e R :^: idx A, bounded_hl A s /\ (x :e s /\ y :e s) -> sqrt_SNo_nonneg (dot A (vector_sub A x y) (vector_sub A x y)) <= diameter A s.
Admitted.

// HOL Light: Multivariate/topology.ml:12909 / DIAMETER_TRANSLATION
// Source hash: md5:bee86480b8fd8c059ccd6ecfb1701e13
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem DIAMETER_TRANSLATION : forall A:set, A <> Empty -> forall a :e R :^: idx A, forall s c= R :^: idx A, diameter A {vector_add A a x | x :e s} = diameter A s.
Admitted.

// HOL Light: Multivariate/topology.ml:12915 / DIAMETER_LINEAR_IMAGE
// Source hash: md5:02579a593b8abf5dc2f97103cd979934
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem DIAMETER_LINEAR_IMAGE : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, linear M N f /\ (forall x :e R :^: idx M, sqrt_SNo_nonneg (dot N (f x) (f x)) = sqrt_SNo_nonneg (dot M x x)) -> diameter N {f x | x :e s} = diameter M s.
Admitted.

// HOL Light: Multivariate/topology.ml:12928 / DIAMETER_EMPTY
// Source hash: md5:caf7f2e989fbb73a7eef14eae157bf4d
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem DIAMETER_EMPTY : forall A:set, A <> Empty -> diameter A Empty = 0.
Admitted.

// HOL Light: Multivariate/topology.ml:12932 / DIAMETER_SING
// Source hash: md5:e629ae7ab280b16635f08eadedd657c7
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem DIAMETER_SING : forall N:set, N <> Empty -> forall a :e R :^: idx N, diameter N {a} = 0.
Admitted.

// HOL Light: Multivariate/topology.ml:12937 / DIAMETER_POS_LE
// Source hash: md5:e9b365b1110e468da755e2550b9fb646
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem DIAMETER_POS_LE : forall N:set, N <> Empty -> forall s c= R :^: idx N, bounded_hl N s -> 0 <= diameter N s.
Admitted.

// HOL Light: Multivariate/topology.ml:12942 / DIAMETER_SUBSET
// Source hash: md5:6bf0de71b4a915f7a9a770d62c79af26
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem DIAMETER_SUBSET : forall N:set, N <> Empty -> forall s t c= R :^: idx N, s c= t /\ bounded_hl N t -> diameter N s <= diameter N t.
Admitted.

// HOL Light: Multivariate/topology.ml:12947 / DIAMETER_CLOSURE
// Source hash: md5:920793931366ea2715d739da53a57939
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem DIAMETER_CLOSURE : forall N:set, N <> Empty -> forall s c= R :^: idx N, diameter N (closure N s) = diameter N s.
Admitted.

// HOL Light: Multivariate/topology.ml:12970 / DIAMETER_SUBSET_CBALL_NONEMPTY
// Source hash: md5:eb2eef05a9ceb993bfaab0f79271d19f
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem DIAMETER_SUBSET_CBALL_NONEMPTY : forall N:set, N <> Empty -> forall s c= R :^: idx N, bounded_hl N s /\ ~ s = Empty -> exists z :e R :^: idx N, z :e s /\ s c= cball N (z,diameter N s).
Admitted.

// HOL Light: Multivariate/topology.ml:12976 / DIAMETER_SUBSET_CBALL
// Source hash: md5:2814a465d96674fcbd3ccf15c03f92de
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem DIAMETER_SUBSET_CBALL : forall N:set, N <> Empty -> forall s c= R :^: idx N, bounded_hl N s -> exists z :e R :^: idx N, s c= cball N (z,diameter N s).
Admitted.

// HOL Light: Multivariate/topology.ml:12981 / DIAMETER_EQ_0
// Source hash: md5:ce6b26bb0ba6d12c72d160b79fd9d47b
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem DIAMETER_EQ_0 : forall N:set, N <> Empty -> forall s c= R :^: idx N, bounded_hl N s -> (diameter N s = 0 <-> s = Empty \/ exists a :e R :^: idx N, s = {a}).
Admitted.

// HOL Light: Multivariate/topology.ml:12987 / DIAMETER_LE
// Source hash: md5:9bf3d106710df9e03c4c6f9cce45381f
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem DIAMETER_LE : forall N:set, N <> Empty -> forall d :e R, forall s c= R :^: idx N, (~ s = Empty \/ 0 <= d) /\ (forall x y :e R :^: idx N, x :e s /\ y :e s -> sqrt_SNo_nonneg (dot N (vector_sub N x y) (vector_sub N x y)) <= d) -> diameter N s <= d.
Admitted.

// HOL Light: Multivariate/topology.ml:12994 / BOUNDED_AND_DIAMETER_LE
// Source hash: md5:27e0c5f3a8ffad51b4d0dd9a34d45eb1
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem BOUNDED_AND_DIAMETER_LE : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall r :e R, bounded_hl N s /\ diameter N s <= r <-> 0 <= r /\ forall x y :e R :^: idx N, x :e s /\ y :e s -> distance N (x,y) <= r.
Admitted.

// HOL Light: Multivariate/topology.ml:13004 / DIST_LE_DIAMETER
// Source hash: md5:2bff1ceb2f8c795fbce38689aa6d35c4
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem DIST_LE_DIAMETER : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall a b :e R :^: idx N, bounded_hl N s /\ (a :e s /\ b :e s) -> distance N (a,b) <= diameter N s.
Admitted.

// HOL Light: Multivariate/topology.ml:13008 / DIAMETER_CBALL
// Source hash: md5:ab6809d4c0b18f91b4f632e4e9c3198c
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem DIAMETER_CBALL : forall N:set, N <> Empty -> forall a :e R :^: idx N, forall r :e R, diameter N (cball N (a,r)) = if r < 0 then 0 else 2 * r.
Admitted.

// HOL Light: Multivariate/topology.ml:13031 / DIAMETER_BALL
// Source hash: md5:b7e6ac96d7248a86f161a71218518c86
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem DIAMETER_BALL : forall N:set, N <> Empty -> forall a :e R :^: idx N, forall r :e R, diameter N (ball N (a,r)) = if r < 0 then 0 else 2 * r.
Admitted.

// HOL Light: Multivariate/topology.ml:13043 / DIAMETER_SCALING
// Source hash: md5:91431076bf6ffc1690d471ef63f0c3e5
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem DIAMETER_SCALING : forall N:set, N <> Empty -> forall a :e R, forall s c= R :^: idx N, bounded_hl N s -> diameter N {vector_mul N a x | x :e s} = abs_SNo a * diameter N s.
Admitted.

// HOL Light: Multivariate/topology.ml:13069 / DIAMETER_AFFINITY
// Source hash: md5:07b7888b329ba829cde37cca6cfcdfa8
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem DIAMETER_AFFINITY : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall m :e R, forall c :e R :^: idx N, bounded_hl N s -> diameter N {vector_add N (vector_mul N m x) c | x :e s} = abs_SNo m * diameter N s.
Admitted.

// HOL Light: Multivariate/topology.ml:13076 / DIAMETER_SUMS
// Source hash: md5:c22dddb9623f6b07d0baac07e0be54be
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem DIAMETER_SUMS : forall N:set, N <> Empty -> forall s t c= R :^: idx N, bounded_hl N s /\ bounded_hl N t -> diameter N (\/_ x :e R :^: idx N, {vector_add N x y | y :e R :^: idx N, x :e s /\ y :e t}) <= diameter N s + diameter N t.
Admitted.

// HOL Light: Multivariate/topology.ml:13094 / DIAMETER_LE_SUMS_RIGHT
// Source hash: md5:929fce4d8892df7194a640d283a2ef64
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem DIAMETER_LE_SUMS_RIGHT : forall N:set, N <> Empty -> forall s t c= R :^: idx N, ~ t = Empty /\ (bounded_hl N s /\ bounded_hl N t) -> diameter N s <= diameter N (\/_ x :e R :^: idx N, {vector_add N x y | y :e R :^: idx N, x :e s /\ y :e t}).
Admitted.

// HOL Light: Multivariate/topology.ml:13107 / DIAMETER_LE_SUMS_LEFT
// Source hash: md5:8acf487270a883b6a886bc6c9e39d329
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem DIAMETER_LE_SUMS_LEFT : forall N:set, N <> Empty -> forall s t c= R :^: idx N, ~ s = Empty /\ (bounded_hl N s /\ bounded_hl N t) -> diameter N t <= diameter N (\/_ x :e R :^: idx N, {vector_add N x y | y :e R :^: idx N, x :e s /\ y :e t}).
Admitted.

// HOL Light: Multivariate/topology.ml:13113 / DIAMETER_UNION_LE
// Source hash: md5:6bee63d24eebb87d0639609dc212b30c
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem DIAMETER_UNION_LE : forall N:set, N <> Empty -> forall s t c= R :^: idx N, bounded_hl N s /\ (bounded_hl N t /\ ~ s :/\: t = Empty) -> diameter N (s :\/: t) <= diameter N s + diameter N t.
Admitted.

// HOL Light: Multivariate/topology.ml:13124 / CLOSED_SCALING
// Source hash: md5:0ca95ae840bf879e9a6dcdfe7811c26b
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSED_SCALING : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall c :e R, closed N s -> closed N {vector_mul N c x | x :e s}.
Admitted.

// HOL Light: Multivariate/topology.ml:13149 / CLOSED_NEGATIONS
// Source hash: md5:afe5b55ee901682d6879c0c03fdc7738
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSED_NEGATIONS : forall N:set, N <> Empty -> forall s c= R :^: idx N, closed N s -> closed N {vector_neg N x | x :e s}.
Admitted.

// HOL Light: Multivariate/topology.ml:13185 / CLOSURE_SUMS
// Source hash: md5:e53ca7361bf71be8f2a6ea3eaa6d7307
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSURE_SUMS : forall N:set, N <> Empty -> forall s t c= R :^: idx N, bounded_hl N s \/ bounded_hl N t -> closure N (\/_ x :e R :^: idx N, {vector_add N x y | y :e R :^: idx N, x :e s /\ y :e t}) = \/_ x :e R :^: idx N, {vector_add N x y | y :e R :^: idx N, x :e closure N s /\ y :e closure N t}.
Admitted.

// HOL Light: Multivariate/topology.ml:13253 / CLOSED_TRANSLATION_EQ
// Source hash: md5:51df2a48568f36bae5d3a9d5b5d91369
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSED_TRANSLATION_EQ : forall N:set, N <> Empty -> forall a :e R :^: idx N, forall s c= R :^: idx N, closed N {vector_add N a x | x :e s} <-> closed N s.
Admitted.

// HOL Light: Multivariate/topology.ml:13257 / CLOSED_TRANSLATION
// Source hash: md5:22cfa7d41337bada81c2c2c9a853e6a4
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSED_TRANSLATION : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall a :e R :^: idx N, closed N s -> closed N {vector_add N a x | x :e s}.
Admitted.

// HOL Light: Multivariate/topology.ml:13269 / CLOSED_SCALING_EQ
// Source hash: md5:6b13c5ec342d6b4d006e0e957f833995
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem CLOSED_SCALING_EQ : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall c :e R, closed N {vector_mul N c x | x :e s} <-> c = 0 \/ closed N s.
Admitted.

// HOL Light: Multivariate/topology.ml:13279 / CLOSED_AFFINITY_EQ
// Source hash: md5:f9696bc3475207939656b7576c3076ff
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem CLOSED_AFFINITY_EQ : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall m :e R, forall c :e R :^: idx N, closed N {vector_add N (vector_mul N m x) c | x :e s} <-> m = 0 \/ closed N s.
Admitted.

// HOL Light: Multivariate/topology.ml:13285 / CLOSED_AFFINITY
// Source hash: md5:b26e737b63c9ec674f8e0afcbc3b7011
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSED_AFFINITY : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall m :e R, forall c :e R :^: idx N, closed N s -> closed N {vector_add N (vector_mul N m x) c | x :e s}.
Admitted.

// HOL Light: Multivariate/topology.ml:13289 / TRANSLATION_DIFF
// Source hash: md5:1e08684900c73f1d773afa32f9dbb38b
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem TRANSLATION_DIFF : forall N:set, N <> Empty -> forall a :e R :^: idx N, forall s t c= R :^: idx N, {vector_add N a x | x :e s :\: t} = {vector_add N a x | x :e s} :\: {vector_add N a x | x :e t}.
Admitted.

// HOL Light: Multivariate/topology.ml:13297 / CLOSURE_TRANSLATION
// Source hash: md5:1bf038356dc1e599afbe00cd8926673e
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSURE_TRANSLATION : forall N:set, N <> Empty -> forall a :e R :^: idx N, forall s c= R :^: idx N, closure N {vector_add N a x | x :e s} = {vector_add N a x | x :e closure N s}.
Admitted.

// HOL Light: Multivariate/topology.ml:13303 / FRONTIER_TRANSLATION
// Source hash: md5:2967fa8bae4b3529d422bf5e590cc6bf
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FRONTIER_TRANSLATION : forall N:set, N <> Empty -> forall a :e R :^: idx N, forall s c= R :^: idx N, frontier N {vector_add N a x | x :e s} = {vector_add N a x | x :e frontier N s}.
Admitted.

// HOL Light: Multivariate/topology.ml:13309 / DIAMETER_LT_SUMS_RIGHT
// Source hash: md5:04814233298d1ba081e0350510f5dc97
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem DIAMETER_LT_SUMS_RIGHT : forall N:set, N <> Empty -> forall s t c= R :^: idx N, ~ s = Empty /\ (~ (exists a :e R :^: idx N, t c= {a}) /\ (bounded_hl N s /\ bounded_hl N t)) -> diameter N s < diameter N (\/_ x :e R :^: idx N, {vector_add N x y | y :e R :^: idx N, x :e s /\ y :e t}).
Admitted.

// HOL Light: Multivariate/topology.ml:13348 / DIAMETER_LT_SUMS_LEFT
// Source hash: md5:9288ab0e01dc72f76405250ead0ddaec
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem DIAMETER_LT_SUMS_LEFT : forall N:set, N <> Empty -> forall s t c= R :^: idx N, ~ (exists a :e R :^: idx N, s c= {a}) /\ (~ t = Empty /\ (bounded_hl N s /\ bounded_hl N t)) -> diameter N t < diameter N (\/_ x :e R :^: idx N, {vector_add N x y | y :e R :^: idx N, x :e s /\ y :e t}).
Admitted.

// HOL Light: Multivariate/topology.ml:13407 / SEPARATE_POINT_CLOSED
// Source hash: md5:66d54f041cf8377a3440a3e8bbbcab35
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem SEPARATE_POINT_CLOSED : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall a :e R :^: idx N, closed N s /\ ~ a :e s -> exists d :e R, 0 < d /\ forall x :e R :^: idx N, x :e s -> d <= distance N (a,x).
Admitted.

// HOL Light: Multivariate/topology.ml:13594 / CONTINUOUS_CLOSED_GRAPH_GEN
// Source hash: md5:ff7060b3d6a160e11bf36b68d0c4ef6b
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_sum_idx, hol_real_R, hol_typedef_topology)
Theorem CONTINUOUS_CLOSED_GRAPH_GEN : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, forall t c= R :^: idx N, continuous_on_hl M N f s /\ {f x | x :e s} c= t -> closed_in (R :^: idx_n (dimindex M + dimindex N)) (subtopology (R :^: idx_n (dimindex M + dimindex N)) (euclidean (idx_n (dimindex M + dimindex N))) (\/_ x :e s, {pastecart M N x y | y :e t})) {pastecart M N x (f x) | x :e R :^: idx M, x :e s}.
Admitted.

// HOL Light: Multivariate/topology.ml:13640 / CONTINUOUS_CLOSED_GRAPH
// Source hash: md5:3d887e231ab3a3a70d72dbcd891872b8
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_sum_idx, hol_real_R)
Theorem CONTINUOUS_CLOSED_GRAPH : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, closed M s /\ continuous_on_hl M N f s -> closed (idx_n (dimindex M + dimindex N)) {pastecart M N x (f x) | x :e R :^: idx M, x :e s}.
Admitted.

// HOL Light: Multivariate/topology.ml:13665 / OPEN_INTERVAL_LEMMA
// Source hash: md5:6c077bfc9ebc02a24037dd1294bd84ee
// Status: transport_required (bridges: hol_num_omega, hol_real_R, omega_Subq_R)
Theorem OPEN_INTERVAL_LEMMA : forall a b x :e R, a < x /\ x < b -> exists d :e R, 0 < d /\ forall x' :e R, abs_SNo (x' + - x) < d -> a < x' /\ x' < b.
Admitted.

// HOL Light: Multivariate/topology.ml:13672 / OPEN_INTERVAL
// Source hash: md5:0ac6f4f440bd18cfc4202abb54d6688b
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem OPEN_INTERVAL : forall N:set, N <> Empty -> forall a b :e R :^: idx N, open N (open_interval N (a,b)).
Admitted.

// HOL Light: Multivariate/topology.ml:13691 / CLOSED_INTERVAL
// Source hash: md5:73a0a7ab79348f5c92f26659c9cb6f6c
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem CLOSED_INTERVAL : forall N:set, N <> Empty -> forall a b :e R :^: idx N, closed N (closed_interval N (seq_cons (a,b) seq_nil)).
Admitted.

// HOL Light: Multivariate/topology.ml:13707 / INTERIOR_CLOSED_INTERVAL
// Source hash: md5:138dcd67547f6ac8235fd0a30853cd99
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem INTERIOR_CLOSED_INTERVAL : forall N:set, N <> Empty -> forall a b :e R :^: idx N, interior N (closed_interval N (seq_cons (a,b) seq_nil)) = open_interval N (a,b).
Admitted.

// HOL Light: Multivariate/topology.ml:13736 / INTERIOR_INTERVAL
// Source hash: md5:b065c694603440795f79fc65731512d7
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem INTERIOR_INTERVAL : forall A B:set, A <> Empty -> B <> Empty -> (forall a b :e R :^: idx A, interior A (closed_interval A (seq_cons (a,b) seq_nil)) = open_interval A (a,b)) /\ forall a b :e R :^: idx B, interior B (open_interval B (a,b)) = open_interval B (a,b).
Admitted.

// HOL Light: Multivariate/topology.ml:13741 / BOUNDED_CLOSED_INTERVAL
// Source hash: md5:7717144fb88356e3cb25c6d6f8cde8c6
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem BOUNDED_CLOSED_INTERVAL : forall N:set, N <> Empty -> forall a b :e R :^: idx N, bounded_hl N (closed_interval N (seq_cons (a,b) seq_nil)).
Admitted.

// HOL Light: Multivariate/topology.ml:13753 / BOUNDED_INTERVAL
// Source hash: md5:51052d07be4b82a069f4b2828c4366e2
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem BOUNDED_INTERVAL : forall A B:set, A <> Empty -> B <> Empty -> (forall a b :e R :^: idx A, bounded_hl A (closed_interval A (seq_cons (a,b) seq_nil))) /\ forall a b :e R :^: idx B, bounded_hl B (open_interval B (a,b)).
Admitted.

// HOL Light: Multivariate/topology.ml:13758 / NOT_INTERVAL_UNIV
// Source hash: md5:a823c7f22566782778bed079903a3107
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem NOT_INTERVAL_UNIV : forall N:set, N <> Empty -> (forall a b :e R :^: idx N, ~ closed_interval N (seq_cons (a,b) seq_nil) = R :^: idx N) /\ forall a b :e R :^: idx N, ~ open_interval N (a,b) = R :^: idx N.
Admitted.

// HOL Light: Multivariate/topology.ml:13763 / OPEN_INTERVAL_MIDPOINT
// Source hash: md5:4695197f8b7548509fed6b780a09d768
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem OPEN_INTERVAL_MIDPOINT : forall N:set, N <> Empty -> forall a b :e R :^: idx N, ~ open_interval N (a,b) = Empty -> vector_mul N (recip_SNo 2) (vector_add N a b) :e open_interval N (a,b).
Admitted.

// HOL Light: Multivariate/topology.ml:13771 / OPEN_CLOSED_INTERVAL_CONVEX
// Source hash: md5:eb6e01d5c71e68e6e72336a3a06cb99b
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem OPEN_CLOSED_INTERVAL_CONVEX : forall N:set, N <> Empty -> forall a b x y :e R :^: idx N, forall e0 :e R, x :e open_interval N (a,b) /\ (y :e closed_interval N (seq_cons (a,b) seq_nil) /\ (0 < e0 /\ e0 <= 1)) -> vector_add N (vector_mul N e0 x) (vector_mul N (1 + - e0) y) :e open_interval N (a,b).
Admitted.

// HOL Light: Multivariate/topology.ml:13787 / CLOSURE_OPEN_INTERVAL
// Source hash: md5:71f2b164830691dfccc8a2509aab2147
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem CLOSURE_OPEN_INTERVAL : forall N:set, N <> Empty -> forall a b :e R :^: idx N, ~ open_interval N (a,b) = Empty -> closure N (open_interval N (a,b)) = closed_interval N (seq_cons (a,b) seq_nil).
Admitted.

// HOL Light: Multivariate/topology.ml:13824 / CLOSURE_INTERVAL
// Source hash: md5:3cbb174ec17092e52bebc7a1ea3dd6f2
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem CLOSURE_INTERVAL : forall A B:set, A <> Empty -> B <> Empty -> (forall a b :e R :^: idx A, closure A (closed_interval A (seq_cons (a,b) seq_nil)) = closed_interval A (seq_cons (a,b) seq_nil)) /\ forall a b :e R :^: idx B, closure B (open_interval B (a,b)) = if open_interval B (a,b) = Empty then Empty else closed_interval B (seq_cons (a,b) seq_nil).
Admitted.

// HOL Light: Multivariate/topology.ml:13831 / FRONTIER_CLOSED_INTERVAL
// Source hash: md5:24f3a8a65fcd442db17d3d7621443118
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem FRONTIER_CLOSED_INTERVAL : forall A:set, A <> Empty -> forall a b :e R :^: idx A, frontier A (closed_interval A (seq_cons (a,b) seq_nil)) = closed_interval A (seq_cons (a,b) seq_nil) :\: open_interval A (a,b).
Admitted.

// HOL Light: Multivariate/topology.ml:13836 / FRONTIER_OPEN_INTERVAL
// Source hash: md5:e4e4b761496c922cf0afb61801522d24
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem FRONTIER_OPEN_INTERVAL : forall A:set, A <> Empty -> forall a b :e R :^: idx A, frontier A (open_interval A (a,b)) = if open_interval A (a,b) = Empty then Empty else closed_interval A (seq_cons (a,b) seq_nil) :\: open_interval A (a,b).
Admitted.

// HOL Light: Multivariate/topology.ml:13844 / INTER_INTERVAL_MIXED_EQ_EMPTY
// Source hash: md5:c0cd5a1d34379d0e51bdb920a90fb385
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem INTER_INTERVAL_MIXED_EQ_EMPTY : forall N:set, N <> Empty -> forall a b c d :e R :^: idx N, ~ open_interval N (c,d) = Empty -> (open_interval N (a,b) :/\: closed_interval N (seq_cons (c,d) seq_nil) = Empty <-> open_interval N (a,b) :/\: open_interval N (c,d) = Empty).
Admitted.

// HOL Light: Multivariate/topology.ml:13852 / INTERVAL_TRANSLATION
// Source hash: md5:5662c34c864f4212c8e0d6dd496dbc27
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem INTERVAL_TRANSLATION : forall A B:set, A <> Empty -> B <> Empty -> (forall c a b :e R :^: idx A, closed_interval A (seq_cons (vector_add A c a,vector_add A c b) seq_nil) = {vector_add A c x | x :e closed_interval A (seq_cons (a,b) seq_nil)}) /\ forall c a b :e R :^: idx B, open_interval B (vector_add B c a,vector_add B c b) = {vector_add B c x | x :e open_interval B (a,b)}.
Admitted.

// HOL Light: Multivariate/topology.ml:13861 / EMPTY_AS_INTERVAL
// Source hash: md5:b60c0cf18d9d30c2230d9ab31f79a1d0
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_num_omega, hol_prod_setprod, hol_real_R)
Theorem EMPTY_AS_INTERVAL : forall A:set, A <> Empty -> Empty = closed_interval A (seq_cons (vec A 1,vec A 0) seq_nil).
Admitted.

// HOL Light: Multivariate/topology.ml:13867 / UNIT_INTERVAL_NONEMPTY
// Source hash: md5:cb112ec1addbd4f9142ebf3f72d93cd4
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_num_omega, hol_prod_setprod, hol_real_R)
Theorem UNIT_INTERVAL_NONEMPTY : forall N:set, N <> Empty -> ~ closed_interval N (seq_cons (vec N 0,vec N 1) seq_nil) = Empty /\ ~ open_interval N (vec N 0,vec N 1) = Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:13872 / IMAGE_STRETCH_INTERVAL
// Source hash: md5:af0538401c5dcf09b6b8586387b6d5fd
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_num_omega, hol_prod_setprod, hol_real_R)
Theorem IMAGE_STRETCH_INTERVAL : forall N:set, N <> Empty -> forall a b :e R :^: idx N, forall m:set -> set, (forall x :e omega, m x :e R) -> {(fun k :e idx N => m k * x k) | x :e closed_interval N (seq_cons (a,b) seq_nil)} = if closed_interval N (seq_cons (a,b) seq_nil) = Empty then Empty else closed_interval N (seq_cons (fun k :e idx N => if m k * a k <= m k * b k then m k * a k else m k * b k,fun k :e idx N => if m k * a k <= m k * b k then m k * b k else m k * a k) seq_nil).
Admitted.

// HOL Light: Multivariate/topology.ml:13907 / INTERVAL_IMAGE_STRETCH_INTERVAL
// Source hash: md5:dbce43a0bd4209b0d644ae075f4db19d
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_num_omega, hol_prod_setprod, hol_real_R)
Theorem INTERVAL_IMAGE_STRETCH_INTERVAL : forall N:set, N <> Empty -> forall a b :e R :^: idx N, forall m:set -> set, (forall x :e omega, m x :e R) -> exists u v :e R :^: idx N, {(fun k :e idx N => m k * x k) | x :e closed_interval N (seq_cons (a,b) seq_nil)} = closed_interval N (seq_cons (u,v) seq_nil).
Admitted.

// HOL Light: Multivariate/topology.ml:13912 / CLOSED_INTERVAL_IMAGE_UNIT_INTERVAL
// Source hash: md5:8293c39cdf2a147f7cbcd1cd472c567a
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_num_omega, hol_prod_setprod, hol_real_R)
Theorem CLOSED_INTERVAL_IMAGE_UNIT_INTERVAL : forall N:set, N <> Empty -> forall a b :e R :^: idx N, ~ closed_interval N (seq_cons (a,b) seq_nil) = Empty -> closed_interval N (seq_cons (a,b) seq_nil) = {vector_add N a x | x :e {(fun i :e idx N => (b i + - a i) * x i) | x :e closed_interval N (seq_cons (vec N 0,vec N 1) seq_nil)}}.
Admitted.

// HOL Light: Multivariate/topology.ml:13929 / SUMS_INTERVALS
// Source hash: md5:e23a291991309fbdf4fc4fb5a1624860
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem SUMS_INTERVALS : forall N:set, N <> Empty -> (forall a b c d :e R :^: idx N, ~ closed_interval N (seq_cons (a,b) seq_nil) = Empty /\ ~ closed_interval N (seq_cons (c,d) seq_nil) = Empty -> (\/_ x :e R :^: idx N, {vector_add N x y | y :e R :^: idx N, x :e closed_interval N (seq_cons (a,b) seq_nil) /\ y :e closed_interval N (seq_cons (c,d) seq_nil)}) = closed_interval N (seq_cons (vector_add N a c,vector_add N b d) seq_nil)) /\ forall a b c d :e R :^: idx N, ~ open_interval N (a,b) = Empty /\ ~ open_interval N (c,d) = Empty -> (\/_ x :e R :^: idx N, {vector_add N x y | y :e R :^: idx N, x :e open_interval N (a,b) /\ y :e open_interval N (c,d)}) = open_interval N (vector_add N a c,vector_add N b d).
Admitted.

// HOL Light: Multivariate/topology.ml:13958 / PCROSS_INTERVAL
// Source hash: md5:1a2774d2e8c73bc7035b39a1c47c7a00
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_sum_idx, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem PCROSS_INTERVAL : forall M N:set, M <> Empty -> N <> Empty -> forall a b :e R :^: idx M, forall c d :e R :^: idx N, (\/_ x :e closed_interval M (seq_cons (a,b) seq_nil), {pastecart M N x y | y :e closed_interval N (seq_cons (c,d) seq_nil)}) = closed_interval (idx_n (dimindex M + dimindex N)) (seq_cons (pastecart M N a c,pastecart M N b d) seq_nil).
Admitted.

// HOL Light: Multivariate/topology.ml:13977 / OPEN_CONTAINS_INTERVAL
// Source hash: md5:690a61f2c892832f498885869df1e7b4
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem OPEN_CONTAINS_INTERVAL : forall N:set, N <> Empty -> forall s c= R :^: idx N, open N s <-> forall x :e R :^: idx N, x :e s -> exists a b :e R :^: idx N, x :e open_interval N (a,b) /\ closed_interval N (seq_cons (a,b) seq_nil) c= s.
Admitted.

// HOL Light: Multivariate/topology.ml:13977 / OPEN_CONTAINS_OPEN_INTERVAL
// Source hash: md5:b237a5e21ad6385c8771a5fe083581c9
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem OPEN_CONTAINS_OPEN_INTERVAL : forall N:set, N <> Empty -> forall s c= R :^: idx N, open N s <-> forall x :e R :^: idx N, x :e s -> exists a b :e R :^: idx N, x :e open_interval N (a,b) /\ open_interval N (a,b) c= s.
Admitted.

// HOL Light: Multivariate/topology.ml:14022 / DIAMETER_INTERVAL
// Source hash: md5:096e1394c687e2595a1fa74076304583
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem DIAMETER_INTERVAL : forall N:set, N <> Empty -> (forall a b :e R :^: idx N, diameter N (closed_interval N (seq_cons (a,b) seq_nil)) = if closed_interval N (seq_cons (a,b) seq_nil) = Empty then 0 else sqrt_SNo_nonneg (dot N (vector_sub N b a) (vector_sub N b a))) /\ forall a b :e R :^: idx N, diameter N (open_interval N (a,b)) = if open_interval N (a,b) = Empty then 0 else sqrt_SNo_nonneg (dot N (vector_sub N b a) (vector_sub N b a)).
Admitted.

// HOL Light: Multivariate/topology.ml:14056 / IMAGE_TWIZZLE_INTERVAL
// Source hash: md5:d6695ddfaeb5de9ab74dfa751b1350ea
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_list_finseq, hol_num_omega, hol_prod_setprod, hol_real_R)
Theorem IMAGE_TWIZZLE_INTERVAL : forall M N:set, M <> Empty -> N <> Empty -> forall p:set -> set, (forall x :e omega, p x :e omega) -> forall a b :e R :^: idx M, dimindex M = dimindex N /\ permutes omega p (idx N) -> {(fun i :e idx N => x (p i)) | x :e closed_interval M (seq_cons (a,b) seq_nil)} = closed_interval N (seq_cons (fun i :e idx N => a (p i),fun i :e idx N => b (p i)) seq_nil).
Admitted.

// HOL Light: Multivariate/topology.ml:14071 / EQ_INTERVAL
// Source hash: md5:5997d01c9e85a8d43d8178c00858a1fa
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem EQ_INTERVAL : forall N:set, N <> Empty -> (forall a b c d :e R :^: idx N, closed_interval N (seq_cons (a,b) seq_nil) = closed_interval N (seq_cons (c,d) seq_nil) <-> closed_interval N (seq_cons (a,b) seq_nil) = Empty /\ closed_interval N (seq_cons (c,d) seq_nil) = Empty \/ a = c /\ b = d) /\ ((forall a b c d :e R :^: idx N, closed_interval N (seq_cons (a,b) seq_nil) = open_interval N (c,d) <-> closed_interval N (seq_cons (a,b) seq_nil) = Empty /\ open_interval N (c,d) = Empty) /\ ((forall a b c d :e R :^: idx N, open_interval N (a,b) = closed_interval N (seq_cons (c,d) seq_nil) <-> open_interval N (a,b) = Empty /\ closed_interval N (seq_cons (c,d) seq_nil) = Empty) /\ forall a b c d :e R :^: idx N, open_interval N (a,b) = open_interval N (c,d) <-> open_interval N (a,b) = Empty /\ open_interval N (c,d) = Empty \/ a = c /\ b = d)).
Admitted.

// HOL Light: Multivariate/topology.ml:14103 / CLOSED_INTERVAL_EQ
// Source hash: md5:9123332795ddd483ef3f3a8afecc10ff
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem CLOSED_INTERVAL_EQ : forall N:set, N <> Empty -> (forall a b :e R :^: idx N, closed N (closed_interval N (seq_cons (a,b) seq_nil))) /\ forall a b :e R :^: idx N, closed N (open_interval N (a,b)) <-> open_interval N (a,b) = Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:14113 / OPEN_INTERVAL_EQ
// Source hash: md5:f5cabaa3c466745064a6fce58401de51
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem OPEN_INTERVAL_EQ : forall N:set, N <> Empty -> (forall a b :e R :^: idx N, open N (closed_interval N (seq_cons (a,b) seq_nil)) <-> closed_interval N (seq_cons (a,b) seq_nil) = Empty) /\ forall a b :e R :^: idx N, open N (open_interval N (a,b)).
Admitted.

// HOL Light: Multivariate/topology.ml:14129 / CLOSED_INTERVAL_DROPOUT
// Source hash: md5:ece327ce6847ce1909a4d0c1e634a835
// Status: transport_required (bridges: add_nat_add_SNo, hol_cart_setexp, hol_dimindex, hol_list_finseq, hol_num_omega, hol_prod_setprod, hol_real_R, nat_le_SNoLe)
Theorem CLOSED_INTERVAL_DROPOUT : forall M N:set, M <> Empty -> N <> Empty -> forall k :e omega, forall a b :e R :^: idx N, dimindex M + 1 = dimindex N /\ (1 <= k /\ (k <= dimindex N /\ a k <= b k)) -> closed_interval M (seq_cons (dropout N M k a,dropout N M k b) seq_nil) = {dropout N M k x | x :e closed_interval N (seq_cons (a,b) seq_nil)}.
Admitted.

// HOL Light: Multivariate/topology.ml:14157 / IMAGE_DROPOUT_CLOSED_INTERVAL
// Source hash: md5:82c312ff00d3839770febbaf3d903d10
// Status: transport_required (bridges: add_nat_add_SNo, hol_cart_setexp, hol_dimindex, hol_list_finseq, hol_num_omega, hol_prod_setprod, hol_real_R, nat_le_SNoLe)
Theorem IMAGE_DROPOUT_CLOSED_INTERVAL : forall M N:set, M <> Empty -> N <> Empty -> forall k :e omega, forall a b :e R :^: idx N, dimindex M + 1 = dimindex N /\ (1 <= k /\ k <= dimindex N) -> {dropout N M k x | x :e closed_interval N (seq_cons (a,b) seq_nil)} = if a k <= b k then closed_interval M (seq_cons (dropout N M k a,dropout N M k b) seq_nil) else Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:14167 / EQ_BALLS
// Source hash: md5:afe0c1d76b3a7ddae18aa3a4fa1253af
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem EQ_BALLS : forall N:set, N <> Empty -> (forall a a' :e R :^: idx N, forall r r' :e R, ball N (a,r) = ball N (a',r') <-> a = a' /\ r = r' \/ r <= 0 /\ r' <= 0) /\ ((forall a a' :e R :^: idx N, forall r r' :e R, ball N (a,r) = cball N (a',r') <-> r <= 0 /\ r' < 0) /\ ((forall a a' :e R :^: idx N, forall r r' :e R, cball N (a,r) = ball N (a',r') <-> r < 0 /\ r' <= 0) /\ forall a a' :e R :^: idx N, forall r r' :e R, cball N (a,r) = cball N (a',r') <-> a = a' /\ r = r' \/ r < 0 /\ r' < 0)).
Admitted.

// HOL Light: Multivariate/topology.ml:14194 / IN_INTERVAL_1
// Source hash: md5:6f00b492252fb4bba1ab912f265caf6e
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem IN_INTERVAL_1 : forall a b x :e R :^: idx 1, (x :e closed_interval 1 (seq_cons (a,b) seq_nil) <-> drop a <= drop x /\ drop x <= drop b) /\ (x :e open_interval 1 (a,b) <-> drop a < drop x /\ drop x < drop b).
Admitted.

// HOL Light: Multivariate/topology.ml:14201 / REAL_INTERVAL_INTERVAL
// Source hash: md5:ca713e98a8bf3dea7097f71380d57559
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem REAL_INTERVAL_INTERVAL : forall a b :e R, closed_real_interval (seq_cons (a,b) seq_nil) = {drop x | x :e closed_interval 1 (seq_cons (lift a,lift b) seq_nil)} /\ open_real_interval (a,b) = {drop x | x :e open_interval 1 (lift a,lift b)}.
Admitted.

// HOL Light: Multivariate/topology.ml:14207 / INTERVAL_REAL_INTERVAL
// Source hash: md5:f1de320c56988fef5c89816a0f22534e
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem INTERVAL_REAL_INTERVAL : forall a b :e R :^: idx 1, closed_interval 1 (seq_cons (a,b) seq_nil) = {lift x | x :e closed_real_interval (seq_cons (drop a,drop b) seq_nil)} /\ open_interval 1 (a,b) = {lift x | x :e open_real_interval (drop a,drop b)}.
Admitted.

// HOL Light: Multivariate/topology.ml:14213 / DROP_IN_REAL_INTERVAL
// Source hash: md5:ce1374c18251a6c592acec2571b2436d
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem DROP_IN_REAL_INTERVAL : (forall a b :e R, forall x :e R :^: idx 1, drop x :e closed_real_interval (seq_cons (a,b) seq_nil) <-> x :e closed_interval 1 (seq_cons (lift a,lift b) seq_nil)) /\ forall a b :e R, forall x :e R :^: idx 1, drop x :e open_real_interval (a,b) <-> x :e open_interval 1 (lift a,lift b).
Admitted.

// HOL Light: Multivariate/topology.ml:14218 / LIFT_IN_INTERVAL
// Source hash: md5:fabbfffafd4f51346fcff8cda041748e
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem LIFT_IN_INTERVAL : (forall a b :e R :^: idx 1, forall x :e R, lift x :e closed_interval 1 (seq_cons (a,b) seq_nil) <-> x :e closed_real_interval (seq_cons (drop a,drop b) seq_nil)) /\ forall a b :e R :^: idx 1, forall x :e R, lift x :e open_interval 1 (a,b) <-> x :e open_real_interval (drop a,drop b).
Admitted.

// HOL Light: Multivariate/topology.ml:14223 / IMAGE_LIFT_REAL_INTERVAL
// Source hash: md5:6e778862e09fa0032b8b7511904ca72b
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem IMAGE_LIFT_REAL_INTERVAL : forall a b :e R, {lift x | x :e closed_real_interval (seq_cons (a,b) seq_nil)} = closed_interval 1 (seq_cons (lift a,lift b) seq_nil) /\ {lift x | x :e open_real_interval (a,b)} = open_interval 1 (lift a,lift b).
Admitted.

// HOL Light: Multivariate/topology.ml:14229 / IMAGE_DROP_INTERVAL
// Source hash: md5:eb02ebce5b94addf54dae11435dd38f7
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem IMAGE_DROP_INTERVAL : forall a b :e R :^: idx 1, {drop x | x :e closed_interval 1 (seq_cons (a,b) seq_nil)} = closed_real_interval (seq_cons (drop a,drop b) seq_nil) /\ {drop x | x :e open_interval 1 (a,b)} = open_real_interval (drop a,drop b).
Admitted.

// HOL Light: Multivariate/topology.ml:14235 / INTERVAL_CASES_1
// Source hash: md5:3f58c540a7e95ebcd9bfd32b4963c5e5
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem INTERVAL_CASES_1 : forall a b x :e R :^: idx 1, x :e closed_interval 1 (seq_cons (a,b) seq_nil) -> x :e open_interval 1 (a,b) \/ (x = a \/ x = b).
Admitted.

// HOL Light: Multivariate/topology.ml:14239 / INTERVAL_EQ_EMPTY_1
// Source hash: md5:2f866c4f8a795604e56bdec965d9db34
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem INTERVAL_EQ_EMPTY_1 : forall a b :e R :^: idx 1, (closed_interval 1 (seq_cons (a,b) seq_nil) = Empty <-> drop b < drop a) /\ (open_interval 1 (a,b) = Empty <-> drop b <= drop a).
Admitted.

// HOL Light: Multivariate/topology.ml:14246 / INTERVAL_NE_EMPTY_1
// Source hash: md5:8a8556575587b8c24abef49b355c9c83
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem INTERVAL_NE_EMPTY_1 : (forall a b :e R :^: idx 1, ~ closed_interval 1 (seq_cons (a,b) seq_nil) = Empty <-> drop a <= drop b) /\ forall a b :e R :^: idx 1, ~ open_interval 1 (a,b) = Empty <-> drop a < drop b.
Admitted.

// HOL Light: Multivariate/topology.ml:14251 / UNION_INTERVAL_1
// Source hash: md5:dec24e77bd4a2d54da4bdf0ea60ecd1e
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem UNION_INTERVAL_1 : forall a b c :e R :^: idx 1, c :e closed_interval 1 (seq_cons (a,b) seq_nil) -> closed_interval 1 (seq_cons (a,c) seq_nil) :\/: closed_interval 1 (seq_cons (c,b) seq_nil) = closed_interval 1 (seq_cons (a,b) seq_nil).
Admitted.

// HOL Light: Multivariate/topology.ml:14256 / SUBSET_INTERVAL_1
// Source hash: md5:3cb58e53bdd32e357472e19582e59280
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem SUBSET_INTERVAL_1 : forall a b c d :e R :^: idx 1, (closed_interval 1 (seq_cons (a,b) seq_nil) c= closed_interval 1 (seq_cons (c,d) seq_nil) <-> drop b < drop a \/ drop c <= drop a /\ (drop a <= drop b /\ drop b <= drop d)) /\ ((closed_interval 1 (seq_cons (a,b) seq_nil) c= open_interval 1 (c,d) <-> drop b < drop a \/ drop c < drop a /\ (drop a <= drop b /\ drop b < drop d)) /\ ((open_interval 1 (a,b) c= closed_interval 1 (seq_cons (c,d) seq_nil) <-> drop b <= drop a \/ drop c <= drop a /\ (drop a < drop b /\ drop b <= drop d)) /\ (open_interval 1 (a,b) c= open_interval 1 (c,d) <-> drop b <= drop a \/ drop c <= drop a /\ (drop a < drop b /\ drop b <= drop d)))).
Admitted.

// HOL Light: Multivariate/topology.ml:14273 / EQ_INTERVAL_1
// Source hash: md5:1dc941f3c84b5d8abb505a550a1efc64
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem EQ_INTERVAL_1 : forall a b c d :e R :^: idx 1, closed_interval 1 (seq_cons (a,b) seq_nil) = closed_interval 1 (seq_cons (c,d) seq_nil) <-> drop b < drop a /\ drop d < drop c \/ drop a = drop c /\ drop b = drop d.
Admitted.

// HOL Light: Multivariate/topology.ml:14281 / DISJOINT_INTERVAL_1
// Source hash: md5:50ce35e773a232a15f5ab824c6b9a617
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem DISJOINT_INTERVAL_1 : forall a b c d :e R :^: idx 1, (closed_interval 1 (seq_cons (a,b) seq_nil) :/\: closed_interval 1 (seq_cons (c,d) seq_nil) = Empty <-> drop b < drop a \/ (drop d < drop c \/ (drop b < drop c \/ drop d < drop a))) /\ ((closed_interval 1 (seq_cons (a,b) seq_nil) :/\: open_interval 1 (c,d) = Empty <-> drop b < drop a \/ (drop d <= drop c \/ (drop b <= drop c \/ drop d <= drop a))) /\ ((open_interval 1 (a,b) :/\: closed_interval 1 (seq_cons (c,d) seq_nil) = Empty <-> drop b <= drop a \/ (drop d < drop c \/ (drop b <= drop c \/ drop d <= drop a))) /\ (open_interval 1 (a,b) :/\: open_interval 1 (c,d) = Empty <-> drop b <= drop a \/ (drop d <= drop c \/ (drop b <= drop c \/ drop d <= drop a))))).
Admitted.

// HOL Light: Multivariate/topology.ml:14298 / OPEN_CLOSED_INTERVAL_1
// Source hash: md5:f3ef2f116f269b60efff2e1c9b98ba69
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem OPEN_CLOSED_INTERVAL_1 : forall a b :e R :^: idx 1, open_interval 1 (a,b) = closed_interval 1 (seq_cons (a,b) seq_nil) :\: {a,b}.
Admitted.

// HOL Light: Multivariate/topology.ml:14303 / CLOSED_OPEN_INTERVAL_1
// Source hash: md5:ba342caa600e3e756fc7f4d89ef4121d
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem CLOSED_OPEN_INTERVAL_1 : forall a b :e R :^: idx 1, drop a <= drop b -> closed_interval 1 (seq_cons (a,b) seq_nil) = open_interval 1 (a,b) :\/: {a,b}.
Admitted.

// HOL Light: Multivariate/topology.ml:14308 / BALL_1
// Source hash: md5:2f185baa0ae115c5a22fa954811f3bd9
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem BALL_1 : forall x :e R :^: idx 1, forall r :e R, cball 1 (x,r) = closed_interval 1 (seq_cons (vector_sub 1 x (lift r),vector_add 1 x (lift r)) seq_nil) /\ ball 1 (x,r) = open_interval 1 (vector_sub 1 x (lift r),vector_add 1 x (lift r)).
Admitted.

// HOL Light: Multivariate/topology.ml:14315 / SPHERE_1
// Source hash: md5:eaad937037f0d86fe4d88d6940691891
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_one_1, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem SPHERE_1 : forall a :e R :^: idx 1, forall r :e R, sphere 1 (a,r) = if r < 0 then Empty else {vector_sub 1 a (lift r),vector_add 1 a (lift r)}.
Admitted.

// HOL Light: Multivariate/topology.ml:14323 / FINITE_SPHERE_1
// Source hash: md5:a614056c447452132d4d5b0676383192
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_finite, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem FINITE_SPHERE_1 : forall a :e R :^: idx 1, forall r :e R, finite (sphere 1 (a,r)).
Admitted.

// HOL Light: Multivariate/topology.ml:14328 / FINITE_INTERVAL_1
// Source hash: md5:a82a63fb9867641809526f51dff72fa1
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_finite, hol_list_finseq, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem FINITE_INTERVAL_1 : (forall a b :e R :^: idx 1, finite (closed_interval 1 (seq_cons (a,b) seq_nil)) <-> drop b <= drop a) /\ forall a b :e R :^: idx 1, finite (open_interval 1 (a,b)) <-> drop b <= drop a.
Admitted.

// HOL Light: Multivariate/topology.ml:14341 / BALL_INTERVAL
// Source hash: md5:41b3fed045f8c03434bd4a6d76150c12
// Status: transport_required (bridges: hol_cart_setexp, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem BALL_INTERVAL : forall x :e R :^: idx 1, forall e0 :e R, ball 1 (x,e0) = open_interval 1 (vector_sub 1 x (lift e0),vector_add 1 x (lift e0)).
Admitted.

// HOL Light: Multivariate/topology.ml:14346 / CBALL_INTERVAL
// Source hash: md5:405edb18d14405d776ee43e5671ccfa3
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem CBALL_INTERVAL : forall x :e R :^: idx 1, forall e0 :e R, cball 1 (x,e0) = closed_interval 1 (seq_cons (vector_sub 1 x (lift e0),vector_add 1 x (lift e0)) seq_nil).
Admitted.

// HOL Light: Multivariate/topology.ml:14351 / BALL_INTERVAL_0
// Source hash: md5:549ae03b3aafa693c197245d829e20bf
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem BALL_INTERVAL_0 : forall e0 :e R, ball 1 (vec 1 0,e0) = open_interval 1 (vector_neg 1 (lift e0),lift e0).
Admitted.

// HOL Light: Multivariate/topology.ml:14356 / CBALL_INTERVAL_0
// Source hash: md5:b7c160bd7f9c775d9f9af29d0ac2146b
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_num_omega, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem CBALL_INTERVAL_0 : forall e0 :e R, cball 1 (vec 1 0,e0) = closed_interval 1 (seq_cons (vector_neg 1 (lift e0),lift e0) seq_nil).
Admitted.

// HOL Light: Multivariate/topology.ml:14361 / INTER_INTERVAL_1
// Source hash: md5:062a886b4f9c421dedc0dc2ca4fe0dc5
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem INTER_INTERVAL_1 : forall a b c d :e R :^: idx 1, closed_interval 1 (seq_cons (a,b) seq_nil) :/\: closed_interval 1 (seq_cons (c,d) seq_nil) = closed_interval 1 (seq_cons (lift (if drop a <= drop c then drop c else drop a),lift (if drop b <= drop d then drop b else drop d)) seq_nil).
Admitted.

// HOL Light: Multivariate/topology.ml:14370 / CLOSED_DIFF_OPEN_INTERVAL_1
// Source hash: md5:f60021f766a57f11c59ea728ca01430f
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem CLOSED_DIFF_OPEN_INTERVAL_1 : forall a b :e R :^: idx 1, closed_interval 1 (seq_cons (a,b) seq_nil) :\: open_interval 1 (a,b) = if closed_interval 1 (seq_cons (a,b) seq_nil) = Empty then Empty else {a,b}.
Admitted.

// HOL Light: Multivariate/topology.ml:14379 / INTERVAL_1
// Source hash: md5:097efd85ac52b74476ea495ca46d51d7
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_num_omega, hol_one_1, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem INTERVAL_1 : (forall a b :e R :^: idx 1, closed_interval 1 (seq_cons (a,b) seq_nil) = if drop a <= drop b then cball 1 (midpoint 1 (a,b),distance 1 (a,b) :/: 2) else Empty) /\ forall a b :e R :^: idx 1, open_interval 1 (a,b) = if drop a < drop b then ball 1 (midpoint 1 (a,b),distance 1 (a,b) :/: 2) else Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:14396 / SEGMENT_1
// Source hash: md5:05f5f8a3c76db8a5ad2a428de85d087e
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem SEGMENT_1 : (forall a b :e R :^: idx 1, closed_segment 1 (seq_cons (a,b) seq_nil) = if drop a <= drop b then closed_interval 1 (seq_cons (a,b) seq_nil) else closed_interval 1 (seq_cons (b,a) seq_nil)) /\ forall a b :e R :^: idx 1, open_segment 1 (a,b) = if drop a <= drop b then open_interval 1 (a,b) else open_interval 1 (b,a).
Admitted.

// HOL Light: Multivariate/topology.ml:14407 / OPEN_SEGMENT_1
// Source hash: md5:13d2e45f8b155a0a2393d296ea9d433b
// Status: transport_required (bridges: hol_cart_setexp, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem OPEN_SEGMENT_1 : forall a b :e R :^: idx 1, open 1 (open_segment 1 (a,b)).
Admitted.

// HOL Light: Multivariate/topology.ml:14412 / INTERVAL_SUBSET_SEGMENT_1
// Source hash: md5:3d341b51a7595227d415bf7248f045ed
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem INTERVAL_SUBSET_SEGMENT_1 : (forall a b :e R :^: idx 1, closed_interval 1 (seq_cons (a,b) seq_nil) c= closed_segment 1 (seq_cons (a,b) seq_nil)) /\ forall a b :e R :^: idx 1, open_interval 1 (a,b) c= open_segment 1 (a,b).
Admitted.

// HOL Light: Multivariate/topology.ml:14420 / SEGMENT_SCALAR_MULTIPLE
// Source hash: md5:438278db40c9046dfb0c96e6b38dbe5c
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_num_omega, hol_prod_setprod, hol_real_R)
Theorem SEGMENT_SCALAR_MULTIPLE : forall N:set, N <> Empty -> (forall a b :e R, forall v :e R :^: idx N, closed_segment N (seq_cons (vector_mul N a v,vector_mul N b v) seq_nil) = {vector_mul N x v | x :e R, a <= x /\ x <= b \/ b <= x /\ x <= a}) /\ forall a b :e R, forall v :e R :^: idx N, ~ v = vec N 0 -> open_segment N (vector_mul N a v,vector_mul N b v) = {vector_mul N x v | x :e R, a < x /\ x < b \/ b < x /\ x < a}.
Admitted.

// HOL Light: Multivariate/topology.ml:14451 / FINITE_INTER_COLLINEAR_OPEN_SEGMENTS
// Source hash: md5:d6682bae708ed24e537f92aacfd33e3e
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_finite, hol_prod_setprod, hol_real_R)
Theorem FINITE_INTER_COLLINEAR_OPEN_SEGMENTS : forall N:set, N <> Empty -> forall a b c d :e R :^: idx N, collinear N {a,b,c} -> (finite (open_segment N (a,b) :/\: open_segment N (c,d)) <-> open_segment N (a,b) :/\: open_segment N (c,d) = Empty).
Admitted.

// HOL Light: Multivariate/topology.ml:14517 / BOUNDED_SEPARATION_1D
// Source hash: md5:43c4c22b4dbd7dd147a28fa30a66ea85
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_real_R)
Theorem BOUNDED_SEPARATION_1D : forall N:set, N <> Empty -> forall s c= R :^: idx N, dimindex N = 1 /\ bounded_hl N s -> (connected N ((R :^: idx N) :\: s) <-> s = Empty).
Admitted.

// HOL Light: Multivariate/topology.ml:14558 / is_interval
// Source hash: md5:ecb721fca8f3e744319c17d4774c5433
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_real_R, nat_le_SNoLe)
Theorem is_interval_thm : forall N:set, N <> Empty -> forall s c= R :^: idx N, is_interval N s <-> forall a b x :e R :^: idx N, a :e s /\ (b :e s /\ (forall i :e omega, 1 <= i /\ i <= dimindex N -> a i <= x i /\ x i <= b i \/ b i <= x i /\ x i <= a i)) -> x :e s.
Admitted.

// HOL Light: Multivariate/topology.ml:14566 / IS_INTERVAL_INTERVAL
// Source hash: md5:1b6fb5a32e9076397167ae0724a2dd31
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem IS_INTERVAL_INTERVAL : forall N:set, N <> Empty -> forall a b :e R :^: idx N, is_interval N (open_interval N (a,b)) /\ is_interval N (closed_interval N (seq_cons (a,b) seq_nil)).
Admitted.

// HOL Light: Multivariate/topology.ml:14571 / IS_INTERVAL_EMPTY
// Source hash: md5:ea9c373d155d6ec9b8dc6ea0afc319a2
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem IS_INTERVAL_EMPTY : forall A:set, A <> Empty -> is_interval A Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:14575 / IS_INTERVAL_UNIV
// Source hash: md5:ae55c0354cc228942f308a4eaee3065d
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem IS_INTERVAL_UNIV : forall N:set, N <> Empty -> is_interval N (R :^: idx N).
Admitted.

// HOL Light: Multivariate/topology.ml:14579 / IS_INTERVAL_TRANSLATION_EQ
// Source hash: md5:f1dc9124ffc7af0da9f889ea00598728
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem IS_INTERVAL_TRANSLATION_EQ : forall N:set, N <> Empty -> forall a :e R :^: idx N, forall s c= R :^: idx N, is_interval N {vector_add N a x | x :e s} <-> is_interval N s.
Admitted.

// HOL Light: Multivariate/topology.ml:14586 / IS_INTERVAL_TRANSLATION
// Source hash: md5:57d7909e4c74cc18104504514ff07156
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem IS_INTERVAL_TRANSLATION : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall a :e R :^: idx N, is_interval N s -> is_interval N {vector_add N a x | x :e s}.
Admitted.

// HOL Light: Multivariate/topology.ml:14590 / IS_INTERVAL_POINTWISE
// Source hash: md5:3271ecb4653a94fee2eee6f159f3374c
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_real_R, nat_le_SNoLe)
Theorem IS_INTERVAL_POINTWISE : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x :e R :^: idx N, is_interval N s /\ (forall i :e omega, 1 <= i /\ i <= dimindex N -> exists a :e R :^: idx N, a :e s /\ a i = x i) -> x :e s.
Admitted.

// HOL Light: Multivariate/topology.ml:14678 / IS_INTERVAL_1
// Source hash: md5:83c38ae88f3e9d77ef89d6ce5d8ae26e
// Status: transport_required (bridges: hol_cart_setexp, hol_one_1, hol_real_R)
Theorem IS_INTERVAL_1 : forall s c= R :^: idx 1, is_interval 1 s <-> forall a b x :e R :^: idx 1, a :e s /\ (b :e s /\ (drop a <= drop x /\ drop x <= drop b)) -> x :e s.
Admitted.

// HOL Light: Multivariate/topology.ml:14686 / IS_INTERVAL_1_CASES
// Source hash: md5:1b92a48dfe7a0af95138312d102dbc19
// Status: transport_required (bridges: hol_cart_setexp, hol_one_1, hol_real_R)
Theorem IS_INTERVAL_1_CASES : forall s c= R :^: idx 1, is_interval 1 s <-> s = Empty \/ (s = R :^: idx 1 \/ ((exists a :e R, s = {x :e R :^: idx 1 | a < drop x}) \/ ((exists a :e R, s = {x :e R :^: idx 1 | a <= drop x}) \/ ((exists b :e R, s = {x :e R :^: idx 1 | drop x <= b}) \/ ((exists b :e R, s = {x :e R :^: idx 1 | drop x < b}) \/ ((exists a b :e R, s = {x :e R :^: idx 1 | a < drop x /\ drop x < b}) \/ ((exists a b :e R, s = {x :e R :^: idx 1 | a < drop x /\ drop x <= b}) \/ ((exists a b :e R, s = {x :e R :^: idx 1 | a <= drop x /\ drop x < b}) \/ exists a b :e R, s = {x :e R :^: idx 1 | a <= drop x /\ drop x <= b})))))))).
Admitted.

// HOL Light: Multivariate/topology.ml:14733 / IS_INTERVAL_1_CLAUSES
// Source hash: md5:e4f6d577ca2e8d63ddacdda3bae08703
// Status: transport_required (bridges: hol_cart_setexp, hol_one_1, hol_real_R)
Theorem IS_INTERVAL_1_CLAUSES : is_interval 1 Empty /\ (is_interval 1 (R :^: idx 1) /\ ((forall a :e R, is_interval 1 {x :e R :^: idx 1 | a < drop x}) /\ ((forall a :e R, is_interval 1 {x :e R :^: idx 1 | a <= drop x}) /\ ((forall b :e R, is_interval 1 {x :e R :^: idx 1 | drop x < b}) /\ ((forall b :e R, is_interval 1 {x :e R :^: idx 1 | drop x <= b}) /\ ((forall a b :e R, is_interval 1 {x :e R :^: idx 1 | a < drop x /\ drop x < b}) /\ ((forall a b :e R, is_interval 1 {x :e R :^: idx 1 | a < drop x /\ drop x <= b}) /\ ((forall a b :e R, is_interval 1 {x :e R :^: idx 1 | a <= drop x /\ drop x < b}) /\ forall a b :e R, is_interval 1 {x :e R :^: idx 1 | a <= drop x /\ drop x <= b})))))))).
Admitted.

// HOL Light: Multivariate/topology.ml:14747 / IS_REALINTERVAL_IS_INTERVAL
// Source hash: md5:de5237e5c9b7c9551913dea99a294657
// Status: transport_required (bridges: hol_cart_setexp, hol_one_1, hol_real_R)
Theorem IS_REALINTERVAL_IS_INTERVAL : forall s c= R, is_realinterval s <-> is_interval 1 {lift x | x :e s}.
Admitted.

// HOL Light: Multivariate/topology.ml:14754 / IS_INTERVAL_PCROSS
// Source hash: md5:d3f42eaeaf12dc82ba4c2c7042c474bc
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_sum_idx, hol_real_R)
Theorem IS_INTERVAL_PCROSS : forall M N:set, M <> Empty -> N <> Empty -> forall s c= R :^: idx M, forall t c= R :^: idx N, is_interval M s /\ is_interval N t -> is_interval (idx_n (dimindex M + dimindex N)) (\/_ x :e s, {pastecart M N x y | y :e t}).
Admitted.

// HOL Light: Multivariate/topology.ml:14775 / IS_INTERVAL_PCROSS_EQ
// Source hash: md5:52c39b7aa9f9030392584c12de90c836
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_sum_idx, hol_real_R)
Theorem IS_INTERVAL_PCROSS_EQ : forall M N:set, M <> Empty -> N <> Empty -> forall s c= R :^: idx M, forall t c= R :^: idx N, is_interval (idx_n (dimindex M + dimindex N)) (\/_ x :e s, {pastecart M N x y | y :e t}) <-> s = Empty \/ (t = Empty \/ is_interval M s /\ is_interval N t).
Admitted.

// HOL Light: Multivariate/topology.ml:14808 / IS_INTERVAL_INTER
// Source hash: md5:42e82dd68e74cdfaf751f9e3652ffa68
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem IS_INTERVAL_INTER : forall N:set, N <> Empty -> forall s t c= R :^: idx N, is_interval N s /\ is_interval N t -> is_interval N (s :/\: t).
Admitted.

// HOL Light: Multivariate/topology.ml:14816 / INTERVAL_SUBSET_IS_INTERVAL
// Source hash: md5:733fa37b9c865692285981fc686f3896
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem INTERVAL_SUBSET_IS_INTERVAL : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall a b :e R :^: idx N, is_interval N s -> (closed_interval N (seq_cons (a,b) seq_nil) c= s <-> closed_interval N (seq_cons (a,b) seq_nil) = Empty \/ a :e s /\ b :e s).
Admitted.

// HOL Light: Multivariate/topology.ml:14826 / INTERVAL_CONTAINS_COMPACT_NEIGHBOURHOOD
// Source hash: md5:71eacb16373aac6235c1bc45fdbe345c
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem INTERVAL_CONTAINS_COMPACT_NEIGHBOURHOOD : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x :e R :^: idx N, is_interval N s /\ x :e s -> exists a b :e R :^: idx N, exists d :e R, 0 < d /\ (x :e closed_interval N (seq_cons (a,b) seq_nil) /\ (closed_interval N (seq_cons (a,b) seq_nil) c= s /\ ball N (x,d) :/\: s c= closed_interval N (seq_cons (a,b) seq_nil))).
Admitted.

// HOL Light: Multivariate/topology.ml:14872 / IS_INTERVAL_SUMS
// Source hash: md5:48d24e6123f0a8b8f863d02a76542768
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem IS_INTERVAL_SUMS : forall N:set, N <> Empty -> forall s t c= R :^: idx N, is_interval N s /\ is_interval N t -> is_interval N (\/_ x :e R :^: idx N, {vector_add N x y | y :e R :^: idx N, x :e s /\ y :e t}).
Admitted.

// HOL Light: Multivariate/topology.ml:14907 / IS_INTERVAL_SING
// Source hash: md5:707339f599fbb12a7dae13aa1f1f4c39
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem IS_INTERVAL_SING : forall N:set, N <> Empty -> forall a :e R :^: idx N, is_interval N {a}.
Admitted.

// HOL Light: Multivariate/topology.ml:14911 / INTERVAL_EQ_SING
// Source hash: md5:63fb57229012b4a3e92bab5f55ca6b91
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem INTERVAL_EQ_SING : forall N:set, N <> Empty -> (forall a b x :e R :^: idx N, closed_interval N (seq_cons (a,b) seq_nil) = {x} <-> a = x /\ b = x) /\ forall a b x :e R :^: idx N, ~ open_interval N (a,b) = {x}.
Admitted.

// HOL Light: Multivariate/topology.ml:14917 / IS_INTERVAL_SCALING
// Source hash: md5:0f2752650dba3eaedb76255b5c9f6d50
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem IS_INTERVAL_SCALING : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall c :e R, is_interval N s -> is_interval N {vector_mul N c x | x :e s}.
Admitted.

// HOL Light: Multivariate/topology.ml:14949 / IS_INTERVAL_SCALING_EQ
// Source hash: md5:d68a12af4048b722f31a937df15f2e8c
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem IS_INTERVAL_SCALING_EQ : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall c :e R, is_interval N {vector_mul N c x | x :e s} <-> c = 0 \/ is_interval N s.
Admitted.

// HOL Light: Multivariate/topology.ml:14965 / IS_INTERVAL_REFLECT
// Source hash: md5:56f7597ea290023e9136ee18dabfc192
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem IS_INTERVAL_REFLECT : forall N:set, N <> Empty -> forall s c= R :^: idx N, is_interval N {vector_neg N x | x :e s} <-> is_interval N s.
Admitted.

// HOL Light: Multivariate/topology.ml:14980 / CARD_FRONTIER_INTERVAL_1
// Source hash: md5:08c6347d4e117ba56afdc2ed3eec7a05
// Status: transport_required (bridges: hol_card_finite_cardinality, hol_cart_setexp, hol_finite_finite, hol_num_omega, hol_one_1, hol_real_R, nat_le_SNoLe)
Theorem CARD_FRONTIER_INTERVAL_1 : forall s c= R :^: idx 1, is_interval 1 s -> finite (frontier 1 s) /\ finite_cardinality (frontier 1 s) <= 2.
Admitted.

// HOL Light: Multivariate/topology.ml:15025 / UNION_INTERVAL_SUBSET_INTERVAL
// Source hash: md5:d789efc2234bd757b253688838b0a708
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem UNION_INTERVAL_SUBSET_INTERVAL : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall a b c d :e R :^: idx N, is_interval N s /\ (closed_interval N (seq_cons (a,b) seq_nil) c= s /\ closed_interval N (seq_cons (c,d) seq_nil) c= s) -> exists u v :e R :^: idx N, closed_interval N (seq_cons (a,b) seq_nil) :\/: closed_interval N (seq_cons (c,d) seq_nil) c= closed_interval N (seq_cons (u,v) seq_nil) /\ closed_interval N (seq_cons (u,v) seq_nil) c= s.
Admitted.

// HOL Light: Multivariate/topology.ml:15160 / IMAGE_CLOSURE_SUBSET
// Source hash: md5:9dcca110bbf669ca44970520c1f5df55
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem IMAGE_CLOSURE_SUBSET : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx N, f x :e R :^: idx M) -> forall s c= R :^: idx N, forall t c= R :^: idx M, continuous_on_hl N M f (closure N s) /\ (closed M t /\ {f x | x :e s} c= t) -> {f x | x :e closure N s} c= t.
Admitted.

// HOL Light: Multivariate/topology.ml:15173 / CLOSURE_IMAGE_CLOSURE
// Source hash: md5:8d9ea1e60df3e7a7d828cca5991e0273
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSURE_IMAGE_CLOSURE : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, continuous_on_hl M N f (closure M s) -> closure N {f x | x :e closure M s} = closure N {f x | x :e s}.
Admitted.

// HOL Light: Multivariate/topology.ml:15183 / CLOSURE_IMAGE_BOUNDED
// Source hash: md5:aacf6cad4c6d31ea15618b034b2f3bf5
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSURE_IMAGE_BOUNDED : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, continuous_on_hl M N f (closure M s) /\ bounded_hl M s -> closure N {f x | x :e s} = {f x | x :e closure M s}.
Admitted.

// HOL Light: Multivariate/topology.ml:15194 / CONTINUOUS_ON_CLOSURE_NORM_LE
// Source hash: md5:e730224657a7164633cb27287d4d8284
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONTINUOUS_ON_CLOSURE_NORM_LE : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx N, f x :e R :^: idx M) -> forall s c= R :^: idx N, forall x :e R :^: idx N, forall b :e R, continuous_on_hl N M f (closure N s) /\ ((forall y :e R :^: idx N, y :e s -> sqrt_SNo_nonneg (dot M (f y) (f y)) <= b) /\ x :e closure N s) -> sqrt_SNo_nonneg (dot M (f x) (f x)) <= b.
Admitted.

// HOL Light: Multivariate/topology.ml:15206 / CONTINUOUS_ON_CLOSURE_COMPONENT_LE
// Source hash: md5:1be3fb07b82685260dd185d619cb6493
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R)
Theorem CONTINUOUS_ON_CLOSURE_COMPONENT_LE : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx N, f x :e R :^: idx M) -> forall s c= R :^: idx N, forall x :e R :^: idx N, forall b :e R, forall k :e omega, continuous_on_hl N M f (closure N s) /\ ((forall y :e R :^: idx N, y :e s -> f y k <= b) /\ x :e closure N s) -> f x k <= b.
Admitted.

// HOL Light: Multivariate/topology.ml:15218 / CONTINUOUS_ON_CLOSURE_COMPONENT_GE
// Source hash: md5:39b05633e311467dfc34b0984aade177
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R)
Theorem CONTINUOUS_ON_CLOSURE_COMPONENT_GE : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx N, f x :e R :^: idx M) -> forall s c= R :^: idx N, forall x :e R :^: idx N, forall b :e R, forall k :e omega, continuous_on_hl N M f (closure N s) /\ ((forall y :e R :^: idx N, y :e s -> b <= f y k) /\ x :e closure N s) -> b <= f x k.
Admitted.

// HOL Light: Multivariate/topology.ml:15230 / CONTINUOUS_MAP_CLOSURES_GEN
// Source hash: md5:397adfb3df8ebe2bf9cbe50a11554241
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONTINUOUS_MAP_CLOSURES_GEN : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, continuous_on_hl M N f s <-> forall t c= R :^: idx M, t c= s -> {f x | x :e s :/\: closure M t} c= closure N {f x | x :e t}.
Admitted.

// HOL Light: Multivariate/topology.ml:15260 / CONTINUOUS_MAP_CLOSURES
// Source hash: md5:ade2766f9a8f7960aa3fd8c55be94fed
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONTINUOUS_MAP_CLOSURES : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> (continuous_on_hl M N f (R :^: idx M) <-> forall s c= R :^: idx M, {f x | x :e closure M s} c= closure N {f x | x :e s}).
Admitted.

// HOL Light: Multivariate/topology.ml:15333 / FRONTIER_CLOPEN_MAP_IMAGE_SUBSET
// Source hash: md5:4f92b9d982344954b16043356e5ac691
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FRONTIER_CLOPEN_MAP_IMAGE_SUBSET : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, closed N {f x | x :e closure M s} /\ open N {f x | x :e interior M s} -> frontier N {f x | x :e s} c= {f x | x :e frontier M s}.
Admitted.

// HOL Light: Multivariate/topology.ml:15346 / FRONTIER_OPEN_MAP_IMAGE_SUBSET
// Source hash: md5:485516f6697b37576d82ccfa3f581790
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FRONTIER_OPEN_MAP_IMAGE_SUBSET : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, bounded_hl M s /\ (continuous_on_hl M N f (closure M s) /\ open N {f x | x :e interior M s}) -> frontier N {f x | x :e s} c= {f x | x :e frontier M s}.
Admitted.

// HOL Light: Multivariate/topology.ml:15404 / CONTINUOUS_ON_UNION
// Source hash: md5:143def929bae92844e8d51fa77590464
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONTINUOUS_ON_UNION : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e R :^: idx A, f x :e R :^: idx B) -> forall s t c= R :^: idx A, closed A s /\ (closed A t /\ (continuous_on_hl A B f s /\ continuous_on_hl A B f t)) -> continuous_on_hl A B f (s :\/: t).
Admitted.

// HOL Light: Multivariate/topology.ml:15410 / CONTINUOUS_ON_CASES
// Source hash: md5:9d7d3746caf8c8f1693496509a1dac57
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONTINUOUS_ON_CASES : forall M N:set, M <> Empty -> N <> Empty -> forall P:set -> prop, forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall g:set -> set, (forall x :e R :^: idx M, g x :e R :^: idx N) -> forall s t c= R :^: idx M, closed M s /\ (closed M t /\ (continuous_on_hl M N f s /\ (continuous_on_hl M N g t /\ (forall x :e R :^: idx M, x :e s /\ ~ P x \/ x :e t /\ P x -> f x = g x)))) -> continuous_on_hl M N (fun x:set => if P x then f x else g x) (s :\/: t).
Admitted.

// HOL Light: Multivariate/topology.ml:15420 / CONTINUOUS_ON_UNION_LOCAL
// Source hash: md5:689b8ad9a330f6e2592b2786f9a55e20
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CONTINUOUS_ON_UNION_LOCAL : forall M N:set, M <> Empty -> N <> Empty -> forall t c= R :^: idx M, forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, closed_in (R :^: idx M) (subtopology (R :^: idx M) (euclidean M) (s :\/: t)) s /\ (closed_in (R :^: idx M) (subtopology (R :^: idx M) (euclidean M) (s :\/: t)) t /\ (continuous_on_hl M N f s /\ continuous_on_hl M N f t)) -> continuous_on_hl M N f (s :\/: t).
Admitted.

// HOL Light: Multivariate/topology.ml:15429 / CONTINUOUS_ON_CASES_LOCAL
// Source hash: md5:5bef6d93b23b0cd7dec29f253ad354b1
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CONTINUOUS_ON_CASES_LOCAL : forall M N:set, M <> Empty -> N <> Empty -> forall P:set -> prop, forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall g:set -> set, (forall x :e R :^: idx M, g x :e R :^: idx N) -> forall s t c= R :^: idx M, closed_in (R :^: idx M) (subtopology (R :^: idx M) (euclidean M) (s :\/: t)) s /\ (closed_in (R :^: idx M) (subtopology (R :^: idx M) (euclidean M) (s :\/: t)) t /\ (continuous_on_hl M N f s /\ (continuous_on_hl M N g t /\ (forall x :e R :^: idx M, x :e s /\ ~ P x \/ x :e t /\ P x -> f x = g x)))) -> continuous_on_hl M N (fun x:set => if P x then f x else g x) (s :\/: t).
Admitted.

// HOL Light: Multivariate/topology.ml:15441 / CONTINUOUS_ON_CASES_LE
// Source hash: md5:0bbf88dd818028e8c7edf4f68a37a527
// Status: transport_required (bridges: hol_cart_setexp, hol_one_1, hol_real_R)
Theorem CONTINUOUS_ON_CASES_LE : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall g:set -> set, (forall x :e R :^: idx M, g x :e R :^: idx N) -> forall h:set -> set, (forall x :e R :^: idx M, h x :e R) -> forall s c= R :^: idx M, forall a :e R, continuous_on_hl M N f {t :e R :^: idx M | t :e s /\ h t <= a} /\ (continuous_on_hl M N g {t :e R :^: idx M | t :e s /\ a <= h t} /\ (continuous_on_hl M 1 (fun x:set => lift (h x)) s /\ (forall t :e R :^: idx M, t :e s /\ h t = a -> f t = g t))) -> continuous_on_hl M N (fun t:set => if h t <= a then f t else g t) s.
Admitted.

// HOL Light: Multivariate/topology.ml:15489 / CONTINUOUS_ON_CASES_1
// Source hash: md5:132b828eee37a68cc5229e2cbc965a16
// Status: transport_required (bridges: hol_cart_setexp, hol_one_1, hol_real_R)
Theorem CONTINUOUS_ON_CASES_1 : forall N:set, N <> Empty -> forall f:set -> set, (forall x :e R :^: idx 1, f x :e R :^: idx N) -> forall g:set -> set, (forall x :e R :^: idx 1, g x :e R :^: idx N) -> forall s c= R :^: idx 1, forall a :e R, continuous_on_hl 1 N f {t :e R :^: idx 1 | t :e s /\ drop t <= a} /\ (continuous_on_hl 1 N g {t :e R :^: idx 1 | t :e s /\ a <= drop t} /\ (lift a :e s -> f (lift a) = g (lift a))) -> continuous_on_hl 1 N (fun t:set => if drop t <= a then f t else g t) s.
Admitted.

// HOL Light: Multivariate/topology.ml:15499 / EXTENSION_FROM_CLOPEN
// Source hash: md5:e4f48b34731538505771571715adbd62
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem EXTENSION_FROM_CLOPEN : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s t c= R :^: idx M, forall u c= R :^: idx N, t :e subtopology (R :^: idx M) (euclidean M) s /\ (closed_in (R :^: idx M) (subtopology (R :^: idx M) (euclidean M) s) t /\ (continuous_on_hl M N f t /\ ({f x | x :e t} c= u /\ (u = Empty -> s = Empty)))) -> exists g:set -> set, (forall x :e R :^: idx M, g x :e R :^: idx N) /\ (continuous_on_hl M N g s /\ ({g x | x :e s} c= u /\ forall x :e R :^: idx M, x :e t -> g x = f x)).
Admitted.

// HOL Light: Multivariate/topology.ml:15523 / CONTINUOUS_ON_CLOPEN_INDICATOR
// Source hash: md5:1d6b176b53d1b12362f0eb20d6378a8f
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CONTINUOUS_ON_CLOPEN_INDICATOR : forall M N:set, M <> Empty -> N <> Empty -> forall s t c= R :^: idx M, forall a b :e R :^: idx N, continuous_on_hl M N (fun x:set => if x :e t then a else b) s <-> a = b \/ s :/\: t :e subtopology (R :^: idx M) (euclidean M) s /\ closed_in (R :^: idx M) (subtopology (R :^: idx M) (euclidean M) s) (s :/\: t).
Admitted.

// HOL Light: Multivariate/topology.ml:15660 / CONTINUOUS_ON_MATRIX_COMPONENTWISE
// Source hash: md5:7e48236757e2ecb1e1eb30db7d984106
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_one_1, hol_real_R, nat_le_SNoLe)
Theorem CONTINUOUS_ON_MATRIX_COMPONENTWISE : forall M N P:set, M <> Empty -> N <> Empty -> P <> Empty -> forall A:set -> set, (forall x :e R :^: idx P, A x :e R :^: idx M :^: idx N) -> forall s c= R :^: idx P, (forall x :e R :^: idx M, continuous_on_hl P N (fun a:set => matrix_vector_mul N M (A a) x) s) <-> forall i j :e omega, 1 <= i /\ (i <= dimindex N /\ (1 <= j /\ j <= dimindex M)) -> continuous_on_hl P 1 (fun a:set => lift (A a i j)) s.
Admitted.

// HOL Light: Multivariate/topology.ml:15686 / CONTINUOUS_ON_MATRIX_VECTOR_MUL
// Source hash: md5:7c0f430e3518a91cddd811ffe33b617d
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_prod_idx, hol_real_R)
Theorem CONTINUOUS_ON_MATRIX_VECTOR_MUL : forall M N P:set, M <> Empty -> N <> Empty -> P <> Empty -> forall A:set -> set, (forall x :e R :^: idx P, A x :e R :^: idx N :^: idx M) -> forall v:set -> set, (forall x :e R :^: idx P, v x :e R :^: idx N) -> forall s c= R :^: idx P, continuous_on_hl P (idx_n (dimindex M * dimindex N)) (fun x:set => vectorize R M N (A x)) s /\ continuous_on_hl P N v s -> continuous_on_hl P M (fun x:set => matrix_vector_mul M N (A x) (v x)) s.
Admitted.

// HOL Light: Multivariate/topology.ml:15704 / CONTINUOUS_ON_MATRIX_MUL
// Source hash: md5:2a63745952de376639580e06abe0eafc
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_prod_idx, hol_real_R)
Theorem CONTINUOUS_ON_MATRIX_MUL : forall M N P Q:set, M <> Empty -> N <> Empty -> P <> Empty -> Q <> Empty -> forall A:set -> set, (forall x :e R :^: idx Q, A x :e R :^: idx N :^: idx M) -> forall B:set -> set, (forall x :e R :^: idx Q, B x :e R :^: idx P :^: idx N) -> forall s c= R :^: idx Q, continuous_on_hl Q (idx_n (dimindex M * dimindex N)) (fun x:set => vectorize R M N (A x)) s /\ continuous_on_hl Q (idx_n (dimindex N * dimindex P)) (fun x:set => vectorize R N P (B x)) s -> continuous_on_hl Q (idx_n (dimindex M * dimindex P)) (fun x:set => vectorize R M P (matrix_mul M N P (A x) (B x))) s.
Admitted.

// HOL Light: Multivariate/topology.ml:15744 / CONTINUOUS_ON_VECTORIZE_COMPONENTWISE
// Source hash: md5:eaffc1f166f3eb0ae673cf81acf799de
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_finite_prod_idx, hol_num_omega, hol_one_1, hol_real_R, nat_le_SNoLe)
Theorem CONTINUOUS_ON_VECTORIZE_COMPONENTWISE : forall M N P:set, M <> Empty -> N <> Empty -> P <> Empty -> forall A:set -> set, (forall x :e R :^: idx P, A x :e R :^: idx N :^: idx M) -> forall s c= R :^: idx P, continuous_on_hl P (idx_n (dimindex M * dimindex N)) (fun a:set => vectorize R M N (A a)) s <-> forall i j :e omega, 1 <= i /\ (i <= dimindex M /\ (1 <= j /\ j <= dimindex N)) -> continuous_on_hl P 1 (fun a:set => lift (A a i j)) s.
Admitted.

