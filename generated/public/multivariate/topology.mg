// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem BOUNDED_INSERT : forall A:set, A <> Empty -> forall x :e R :^: idx A, forall s c= R :^: idx A, bounded_hl A (SetAdjoin s x) <-> bounded_hl A s.
