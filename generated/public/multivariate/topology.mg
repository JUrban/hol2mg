// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_real_R, nat_le_SNoLe, omega_Subq_R)
Theorem MATRIX_DIAGONALIZABLE : forall N:set, N <> Empty -> forall A :e R :^: idx N :^: idx N, exists P D Q :e R :^: idx N :^: idx N, orthogonal_matrix_hl N P /\ (diagonal_matrix_hl N N D /\ (orthogonal_matrix_hl N Q /\ ((forall i :e omega, 1 <= i /\ i <= dimindex N -> 0 <= D i i) /\ A = matrix_mul N N N P (matrix_mul N N N D Q)))).
Admitted.

// HOL Light: Multivariate/topology.ml:22554 / SEQUENCE_CAUCHY_WLOG
// Source hash: md5:4745765a56ebbc6b30318d66d5af93c0
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, nat_le_SNoLe)
Theorem SEQUENCE_CAUCHY_WLOG : forall A:set, A <> Empty -> forall e0 :e R, forall P:set -> prop, forall s:set -> set, (forall x :e omega, s x :e R :^: idx A) -> ((forall m n :e omega, P m /\ P n -> distance A (s m,s n) < e0) <-> forall m n :e omega, P m /\ (P n /\ m <= n) -> distance A (s m,s n) < e0).
Admitted.

// HOL Light: Multivariate/topology.ml:22559 / VSUM_DIFF_LEMMA
// Source hash: md5:ccf0845114da723bb8a4e895a0e6a240
// Status: transport_required (bridges: add_nat_add_SNo, hol_cart_setexp, hol_num_omega, hol_real_R, nat_le_SNoLe)
Theorem VSUM_DIFF_LEMMA : forall N:set, N <> Empty -> forall f:set -> set, (forall x :e omega, f x :e R :^: idx N) -> forall k c= omega, forall m n :e omega, m <= n -> vector_sub N (vsum omega N (k :/\: {i :e omega | 0 <= i /\ i <= n}) f) (vsum omega N (k :/\: {i :e omega | 0 <= i /\ i <= m}) f) = vsum omega N (k :/\: {i :e omega | m + 1 <= i /\ i <= n}) f.
Admitted.

// HOL Light: Multivariate/topology.ml:22577 / NORM_VSUM_TRIVIAL_LEMMA
// Source hash: md5:f3f729c5f1d14459ad5920841520816d
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, nat_lt_SNoLt, omega_Subq_R)
Theorem NORM_VSUM_TRIVIAL_LEMMA : forall A:set, A <> Empty -> forall P:prop, forall s c= omega, forall m n :e omega, forall f:set -> set, (forall x :e omega, f x :e R :^: idx A) -> forall e0 :e R, 0 < e0 -> (P -> sqrt_SNo_nonneg (dot A (vsum omega A (s :/\: {i :e omega | m <= i /\ i <= n}) f) (vsum omega A (s :/\: {i :e omega | m <= i /\ i <= n}) f)) < e0 <-> P -> n < m \/ sqrt_SNo_nonneg (dot A (vsum omega A (s :/\: {i :e omega | m <= i /\ i <= n}) f) (vsum omega A (s :/\: {i :e omega | m <= i /\ i <= n}) f)) < e0).
Admitted.

// HOL Light: Multivariate/topology.ml:22667 / SERIES_CAUCHY_UNIFORM
// Source hash: md5:69b62f3f54e63594679f0a0dece5808d
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, nat_le_SNoLe, omega_Subq_R)
Theorem SERIES_CAUCHY_UNIFORM : forall A N:set, A <> Empty -> N <> Empty -> forall P:set -> prop, forall f:set -> set -> set, (forall x :e A, forall y :e omega, f x y :e R :^: idx N) -> forall k c= omega, (exists l:set -> set, (forall x :e A, l x :e R :^: idx N) /\ forall e0 :e R, 0 < e0 -> exists N0 :e omega, forall n :e omega, forall x :e A, N0 <= n /\ P x -> distance N (vsum omega N (k :/\: {i :e omega | 0 <= i /\ i <= n}) (f x),l x) < e0) <-> forall e0 :e R, 0 < e0 -> exists N0 :e omega, forall m n :e omega, forall x :e A, N0 <= m /\ P x -> sqrt_SNo_nonneg (dot N (vsum omega N (k :/\: {i :e omega | m <= i /\ i <= n}) (f x)) (vsum omega N (k :/\: {i :e omega | m <= i /\ i <= n}) (f x))) < e0.
Admitted.

// HOL Light: Multivariate/topology.ml:22948 / BOUNDED_PARTIAL_SUMS
// Source hash: md5:d9135f3005128c4e4ad64f807e68b405
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R)
Theorem BOUNDED_PARTIAL_SUMS : forall N:set, N <> Empty -> forall f:set -> set, (forall x :e omega, f x :e R :^: idx N) -> forall k :e omega, bounded_hl N {vsum omega N {i :e omega | k <= i /\ i <= n} f | n :e omega, n :e omega} -> bounded_hl N (\/_ m :e omega, {vsum omega N {i :e omega | m <= i /\ i <= n} f | n :e omega, m :e omega /\ n :e omega}).
Admitted.

// HOL Light: Multivariate/topology.ml:24081 / closest_point
// Source hash: md5:4d4e84303505781ca4bde03260e4f6fb
// Status: transport_required (bridges: choose_in_spec, hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem closest_point_thm : forall A:set, A <> Empty -> forall s c= R :^: idx A, forall a :e R :^: idx A, closest_point A s a = choose_in (R :^: idx A) (fun x:set => x :e s /\ forall y :e R :^: idx A, y :e s -> distance A (a,x) <= distance A (a,y)).
Admitted.

// HOL Light: Multivariate/topology.ml:24084 / CLOSEST_POINT_EXISTS
// Source hash: md5:4eb4ef040f9f388aef54eb37a1121edd
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem CLOSEST_POINT_EXISTS : forall A:set, A <> Empty -> forall s c= R :^: idx A, forall a :e R :^: idx A, closed A s /\ ~ s = Empty -> closest_point A s a :e s /\ forall y :e R :^: idx A, y :e s -> distance A (a,closest_point A s a) <= distance A (a,y).
Admitted.

// HOL Light: Multivariate/topology.ml:24091 / CLOSEST_POINT_IN_SET
// Source hash: md5:7cd6f9c84ec407cf6df8d69cb3796df9
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSEST_POINT_IN_SET : forall A:set, A <> Empty -> forall s c= R :^: idx A, forall a :e R :^: idx A, closed A s /\ ~ s = Empty -> closest_point A s a :e s.
Admitted.

// HOL Light: Multivariate/topology.ml:24095 / CLOSEST_POINT_LE
// Source hash: md5:0ecbbc2ac6a5ef3cf982e2c2a79d7de3
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem CLOSEST_POINT_LE : forall A:set, A <> Empty -> forall s c= R :^: idx A, forall a x :e R :^: idx A, closed A s /\ x :e s -> distance A (a,closest_point A s a) <= distance A (a,x).
Admitted.

// HOL Light: Multivariate/topology.ml:24099 / CLOSEST_POINT_SELF
// Source hash: md5:3d30808fdcad2b4932f6652913f356b3
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSEST_POINT_SELF : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x :e R :^: idx N, x :e s -> closest_point N s x = x.
Admitted.

// HOL Light: Multivariate/topology.ml:24107 / CLOSEST_POINT_REFL
// Source hash: md5:14c9b24f910ac0bd8828a60d39d48998
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSEST_POINT_REFL : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x :e R :^: idx N, closed N s /\ ~ s = Empty -> (closest_point N s x = x <-> x :e s).
Admitted.

// HOL Light: Multivariate/topology.ml:24111 / DIST_CLOSEST_POINT_LIPSCHITZ
// Source hash: md5:a116580609ba46f580899e6f466c3495
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem DIST_CLOSEST_POINT_LIPSCHITZ : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x y :e R :^: idx N, closed N s /\ ~ s = Empty -> abs_SNo (distance N (x,closest_point N s x) + - distance N (y,closest_point N s y)) <= distance N (x,y).
Admitted.

// HOL Light: Multivariate/topology.ml:24132 / CONTINUOUS_ON_DIST_CLOSEST_POINT
// Source hash: md5:0b49ff039959f761e4be4ba8c753b4c1
// Status: transport_required (bridges: hol_cart_setexp, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem CONTINUOUS_ON_DIST_CLOSEST_POINT : forall A:set, A <> Empty -> forall s t c= R :^: idx A, closed A s /\ ~ s = Empty -> continuous_on_hl A 1 (fun x:set => lift (distance A (x,closest_point A s x))) t.
Admitted.

// HOL Light: Multivariate/topology.ml:24138 / UNIFORMLY_CONTINUOUS_ON_DIST_CLOSEST_POINT
// Source hash: md5:34d9881a867641e637444d0f4b0043cc
// Status: transport_required (bridges: hol_cart_setexp, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem UNIFORMLY_CONTINUOUS_ON_DIST_CLOSEST_POINT : forall N:set, N <> Empty -> forall s t c= R :^: idx N, closed N s /\ ~ s = Empty -> uniformly_continuous_on_hl N 1 (fun x:set => lift (distance N (x,closest_point N s x))) t.
Admitted.

// HOL Light: Multivariate/topology.ml:24145 / SEGMENT_TO_CLOSEST_POINT
// Source hash: md5:83e85f7524682498f34f39640d31b333
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem SEGMENT_TO_CLOSEST_POINT : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall a :e R :^: idx N, closed N s /\ ~ s = Empty -> open_segment N (a,closest_point N s a) :/\: s = Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:24155 / SEGMENT_TO_POINT_EXISTS
// Source hash: md5:aaa8d053b9f6f1dde17ed6e895b73ad3
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem SEGMENT_TO_POINT_EXISTS : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall a :e R :^: idx N, closed N s /\ ~ s = Empty -> exists b :e R :^: idx N, b :e s /\ open_segment N (a,b) :/\: s = Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:24160 / CLOSEST_POINT_IN_INTERIOR
// Source hash: md5:419530cb2ecc9518bcdcc5faf93cfd4e
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSEST_POINT_IN_INTERIOR : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x :e R :^: idx N, closed N s /\ ~ s = Empty -> (closest_point N s x :e interior N s <-> x :e interior N s).
Admitted.

// HOL Light: Multivariate/topology.ml:24197 / CLOSEST_POINT_IN_FRONTIER
// Source hash: md5:5af41ff458d7a75f719d488df38813a9
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSEST_POINT_IN_FRONTIER : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x :e R :^: idx N, closed N s /\ (~ s = Empty /\ ~ x :e interior N s) -> closest_point N s x :e frontier N s.
Admitted.

// HOL Light: Multivariate/topology.ml:24204 / CLOSEST_POINT_FRONTIER
// Source hash: md5:be554aa25cfea117c6473d812893bf40
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSEST_POINT_FRONTIER : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x :e R :^: idx N, ~ x :e interior N s -> closest_point N (frontier N s) x = closest_point N (closure N s) x.
Admitted.

// HOL Light: Multivariate/topology.ml:24260 / setdist
// Source hash: md5:3301a3f7cf6f508bc69b9aa0bf4c0b04
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem setdist_thm : forall A:set, A <> Empty -> forall s t c= R :^: idx A, setdist A (s,t) = if s = Empty \/ t = Empty then 0 else inf (\/_ x :e R :^: idx A, {distance A (x,y) | y :e R :^: idx A, x :e s /\ y :e t}).
Admitted.

// HOL Light: Multivariate/topology.ml:24265 / SETDIST_EMPTY
// Source hash: md5:130f623a279846abdb30b14f0d8a8f81
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem SETDIST_EMPTY : forall A B:set, A <> Empty -> B <> Empty -> (forall t c= R :^: idx A, setdist A (Empty,t) = 0) /\ forall s c= R :^: idx B, setdist B (s,Empty) = 0.
Admitted.

// HOL Light: Multivariate/topology.ml:24269 / SETDIST_POS_LE
// Source hash: md5:388070c1de34df37bf6881ca86669371
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem SETDIST_POS_LE : forall A:set, A <> Empty -> forall s t c= R :^: idx A, 0 <= setdist A (s,t).
Admitted.

// HOL Light: Multivariate/topology.ml:24276 / SETDIST_POS_LT
// Source hash: md5:ed5bd66708ffafd24c900964196ff000
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem SETDIST_POS_LT : forall N:set, N <> Empty -> forall s t c= R :^: idx N, 0 < setdist N (s,t) <-> ~ setdist N (s,t) = 0.
Admitted.

// HOL Light: Multivariate/topology.ml:24280 / SETDIST_SUBSETS_EQ
// Source hash: md5:69356b092b52ba2285c855711a679298
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem SETDIST_SUBSETS_EQ : forall N:set, N <> Empty -> forall s t s' t' c= R :^: idx N, s' c= s /\ (t' c= t /\ (forall x y :e R :^: idx N, x :e s /\ y :e t -> exists x' y' :e R :^: idx N, x' :e s' /\ (y' :e t' /\ distance N (x',y') <= distance N (x,y)))) -> setdist N (s',t') = setdist N (s,t).
Admitted.

// HOL Light: Multivariate/topology.ml:24300 / REAL_LE_SETDIST
// Source hash: md5:72e5ee780a45536897350bed5bb3a3b2
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem REAL_LE_SETDIST : forall N:set, N <> Empty -> forall s t c= R :^: idx N, forall d :e R, ~ s = Empty /\ (~ t = Empty /\ (forall x y :e R :^: idx N, x :e s /\ y :e t -> d <= distance N (x,y))) -> d <= setdist N (s,t).
Admitted.

// HOL Light: Multivariate/topology.ml:24311 / SETDIST_LE_DIST
// Source hash: md5:6ad3a0e53e88bfca5127ca3a8be1a9a3
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem SETDIST_LE_DIST : forall N:set, N <> Empty -> forall s t c= R :^: idx N, forall x y :e R :^: idx N, x :e s /\ y :e t -> setdist N (s,t) <= distance N (x,y).
Admitted.

// HOL Light: Multivariate/topology.ml:24320 / REAL_LE_SETDIST_EQ
// Source hash: md5:588e929a1ec734b280e98faed6cbd5aa
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem REAL_LE_SETDIST_EQ : forall N:set, N <> Empty -> forall d :e R, forall s t c= R :^: idx N, d <= setdist N (s,t) <-> (forall x y :e R :^: idx N, x :e s /\ y :e t -> d <= distance N (x,y)) /\ (s = Empty \/ t = Empty -> d <= 0).
Admitted.

// HOL Light: Multivariate/topology.ml:24330 / REAL_SETDIST_LT_EXISTS
// Source hash: md5:67d1aed8b3355d3c9d7ff2ab9afba127
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem REAL_SETDIST_LT_EXISTS : forall N:set, N <> Empty -> forall s t c= R :^: idx N, forall b :e R, ~ s = Empty /\ (~ t = Empty /\ setdist N (s,t) < b) -> exists x y :e R :^: idx N, x :e s /\ (y :e t /\ distance N (x,y) < b).
Admitted.

// HOL Light: Multivariate/topology.ml:24336 / SETDIST_REFL
// Source hash: md5:f46379a51265e27e566e314236f4c49b
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem SETDIST_REFL : forall N:set, N <> Empty -> forall s c= R :^: idx N, setdist N (s,s) = 0.
Admitted.

// HOL Light: Multivariate/topology.ml:24343 / SETDIST_SYM
// Source hash: md5:171cc21352bc6918000be2e6289c7a91
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem SETDIST_SYM : forall A:set, A <> Empty -> forall s t c= R :^: idx A, setdist A (s,t) = setdist A (t,s).
Admitted.

// HOL Light: Multivariate/topology.ml:24350 / SETDIST_TRIANGLE
// Source hash: md5:c4949c1cf43f66b6b36a74f59b634d3f
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem SETDIST_TRIANGLE : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall a :e R :^: idx N, forall t c= R :^: idx N, setdist N (s,t) <= setdist N (s,{a}) + setdist N ({a},t).
Admitted.

// HOL Light: Multivariate/topology.ml:24371 / SETDIST_SINGS
// Source hash: md5:9612b61a55ee22e9a07a40128cd002d8
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem SETDIST_SINGS : forall A:set, A <> Empty -> forall x y :e R :^: idx A, setdist A ({x},{y}) = distance A (x,y).
Admitted.

// HOL Light: Multivariate/topology.ml:24377 / SETDIST_SCALING
// Source hash: md5:83e7d92f734f46e09931ea16da4eff06
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem SETDIST_SCALING : forall N:set, N <> Empty -> forall a :e R, forall s t c= R :^: idx N, setdist N ({vector_mul N a x | x :e s},{vector_mul N a x | x :e t}) = abs_SNo a * setdist N (s,t).
Admitted.

// HOL Light: Multivariate/topology.ml:24398 / SETDIST_UNIFORMLY_CONTINUOUS_ON
// Source hash: md5:f6074025c73d5747480a06ddf8f0f406
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem SETDIST_UNIFORMLY_CONTINUOUS_ON : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, uniformly_continuous_on_hl M N f s <-> forall e0 :e R, 0 < e0 -> exists d :e R, 0 < d /\ forall t t' c= R :^: idx M, t c= s /\ (t' c= s /\ setdist M (t',t) < d) -> setdist N ({f x | x :e t'},{f x | x :e t}) < e0.
Admitted.

// HOL Light: Multivariate/topology.ml:24398 / SETDIST_UNIFORMLY_CONTINUOUS_ON_ALT
// Source hash: md5:23c1d05d2af004bfc43b17ea62488d1e
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem SETDIST_UNIFORMLY_CONTINUOUS_ON_ALT : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, uniformly_continuous_on_hl M N f s <-> forall e0 :e R, 0 < e0 -> exists d :e R, 0 < d /\ forall t t' c= R :^: idx M, t c= s /\ (t' c= s /\ (bounded_hl M t /\ (bounded_hl M t' /\ setdist M (t',t) < d))) -> setdist N ({f x | x :e t'},{f x | x :e t}) < e0.
Admitted.

// HOL Light: Multivariate/topology.ml:24452 / SETDIST_SING_TRIANGLE
// Source hash: md5:ada430dec98830aaa45114da2da512d5
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem SETDIST_SING_TRIANGLE : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x y :e R :^: idx N, abs_SNo (setdist N ({x},s) + - setdist N ({y},s)) <= distance N (x,y).
Admitted.

// HOL Light: Multivariate/topology.ml:24464 / CONTINUOUS_ON_LIFT_SETDIST
// Source hash: md5:2fd0de82226dcda8d4b96d05d9eb3e63
// Status: transport_required (bridges: hol_cart_setexp, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem CONTINUOUS_ON_LIFT_SETDIST : forall N:set, N <> Empty -> forall s t c= R :^: idx N, continuous_on_hl N 1 (fun y:set => lift (setdist N ({y},s))) t.
Admitted.

// HOL Light: Multivariate/topology.ml:24469 / UNIFORMLY_CONTINUOUS_ON_LIFT_SETDIST
// Source hash: md5:aeb22370ee502ce81911595d768863f9
// Status: transport_required (bridges: hol_cart_setexp, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem UNIFORMLY_CONTINUOUS_ON_LIFT_SETDIST : forall N:set, N <> Empty -> forall s t c= R :^: idx N, uniformly_continuous_on_hl N 1 (fun y:set => lift (setdist N ({y},s))) t.
Admitted.

// HOL Light: Multivariate/topology.ml:24475 / SETDIST_DIFFERENCES
// Source hash: md5:fc0f8b08cd301275006b45216ecaccc6
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R)
Theorem SETDIST_DIFFERENCES : forall N:set, N <> Empty -> forall s t c= R :^: idx N, setdist N (s,t) = setdist N ({vec N 0},\/_ x :e R :^: idx N, {vector_sub N x y | y :e R :^: idx N, x :e s /\ y :e t}).
Admitted.

// HOL Light: Multivariate/topology.ml:24484 / SETDIST_SUBSET_RIGHT
// Source hash: md5:d39d8b62396f0c05a9667411fa7407ad
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem SETDIST_SUBSET_RIGHT : forall N:set, N <> Empty -> forall s t u c= R :^: idx N, ~ t = Empty /\ t c= u -> setdist N (s,u) <= setdist N (s,t).
Admitted.

// HOL Light: Multivariate/topology.ml:24495 / SETDIST_SUBSET_LEFT
// Source hash: md5:c037d67009fb3c567051b25357139f10
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem SETDIST_SUBSET_LEFT : forall N:set, N <> Empty -> forall s t u c= R :^: idx N, ~ s = Empty /\ s c= t -> setdist N (t,u) <= setdist N (s,u).
Admitted.

// HOL Light: Multivariate/topology.ml:24500 / SETDIST_CLOSURE
// Source hash: md5:210ec0ce4c36815672708948a2ddb417
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem SETDIST_CLOSURE : forall N:set, N <> Empty -> (forall s t c= R :^: idx N, setdist N (closure N s,t) = setdist N (s,t)) /\ forall s t c= R :^: idx N, setdist N (s,closure N t) = setdist N (s,t).
Admitted.

// HOL Light: Multivariate/topology.ml:24522 / SETDIST_FRONTIER
// Source hash: md5:9cec6db756ce74cb9212a5d213d51f4e
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem SETDIST_FRONTIER : forall N:set, N <> Empty -> (forall s t c= R :^: idx N, s :/\: t = Empty -> setdist N (frontier N s,t) = setdist N (s,t)) /\ forall s t c= R :^: idx N, s :/\: t = Empty -> setdist N (s,frontier N t) = setdist N (s,t).
Admitted.

// HOL Light: Multivariate/topology.ml:24601 / SETDIST_EQ_0_BOUNDED
// Source hash: md5:bf377c30c10ded01d4c18106e9b4d970
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem SETDIST_EQ_0_BOUNDED : forall N:set, N <> Empty -> forall s t c= R :^: idx N, bounded_hl N s \/ bounded_hl N t -> (setdist N (s,t) = 0 <-> s = Empty \/ (t = Empty \/ ~ closure N s :/\: closure N t = Empty)).
Admitted.

// HOL Light: Multivariate/topology.ml:24614 / SETDIST_TRANSLATION
// Source hash: md5:1ae395627116df7d4506681102c579c9
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem SETDIST_TRANSLATION : forall N:set, N <> Empty -> forall a :e R :^: idx N, forall s t c= R :^: idx N, setdist N ({vector_add N a x | x :e s},{vector_add N a x | x :e t}) = setdist N (s,t).
Admitted.

// HOL Light: Multivariate/topology.ml:24626 / SETDIST_LINEAR_IMAGE
// Source hash: md5:19e3a206ad6be1ef5a8fc7e46430395a
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem SETDIST_LINEAR_IMAGE : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s t c= R :^: idx M, linear M N f /\ (forall x :e R :^: idx M, sqrt_SNo_nonneg (dot N (f x) (f x)) = sqrt_SNo_nonneg (dot M x x)) -> setdist N ({f x | x :e s},{f x | x :e t}) = setdist M (s,t).
Admitted.

// HOL Light: Multivariate/topology.ml:24640 / SETDIST_UNIQUE
// Source hash: md5:4346e5756efd945e0432ea06662ba495
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem SETDIST_UNIQUE : forall N:set, N <> Empty -> forall s t c= R :^: idx N, forall a b :e R :^: idx N, forall d :e R, a :e s /\ (b :e t /\ (distance N (a,b) = d /\ (forall x y :e R :^: idx N, x :e s /\ y :e t -> distance N (a,b) <= distance N (x,y)))) -> setdist N (s,t) = d.
Admitted.

// HOL Light: Multivariate/topology.ml:24649 / SETDIST_UNIV
// Source hash: md5:4c254a575f978174b7a3bdb996f4b4fc
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem SETDIST_UNIV : forall N:set, N <> Empty -> (forall s c= R :^: idx N, setdist N (s,R :^: idx N) = 0) /\ forall t c= R :^: idx N, setdist N (R :^: idx N,t) = 0.
Admitted.

// HOL Light: Multivariate/topology.ml:24659 / SETDIST_ZERO
// Source hash: md5:b2eb74f5ab1100c9de45c495a44c7ffa
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem SETDIST_ZERO : forall N:set, N <> Empty -> forall s t c= R :^: idx N, ~ s :/\: t = Empty -> setdist N (s,t) = 0.
Admitted.

// HOL Light: Multivariate/topology.ml:24667 / SETDIST_ZERO_STRONG
// Source hash: md5:5f2f1bbeb2cb4ebb2188f06a8a9af6cc
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem SETDIST_ZERO_STRONG : forall N:set, N <> Empty -> forall s t c= R :^: idx N, ~ closure N s :/\: closure N t = Empty -> setdist N (s,t) = 0.
Admitted.

// HOL Light: Multivariate/topology.ml:24672 / SETDIST_FRONTIERS
// Source hash: md5:2377d70a44e4d411d6868dd50f50d64f
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem SETDIST_FRONTIERS : forall N:set, N <> Empty -> forall s t c= R :^: idx N, setdist N (s,t) = if s :/\: t = Empty then setdist N (frontier N s,frontier N t) else 0.
Admitted.

// HOL Light: Multivariate/topology.ml:24703 / SETDIST_SING_FRONTIER
// Source hash: md5:3ea5dbee206eb60418a3f15f52fb05e1
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem SETDIST_SING_FRONTIER : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x :e R :^: idx N, ~ x :e s -> setdist N ({x},frontier N s) = setdist N ({x},s).
Admitted.

// HOL Light: Multivariate/topology.ml:24707 / SETDIST_CLOSEST_POINT
// Source hash: md5:c294779573cb5a729b7ff45ed6def4f7
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem SETDIST_CLOSEST_POINT : forall N:set, N <> Empty -> forall a :e R :^: idx N, forall s c= R :^: idx N, closed N s /\ ~ s = Empty -> setdist N ({a},s) = distance N (a,closest_point N s a).
Admitted.

// HOL Light: Multivariate/topology.ml:24715 / SETDIST_EQ_0_SING
// Source hash: md5:176873deffc9f20a89ab90a984949acf
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem SETDIST_EQ_0_SING : forall N:set, N <> Empty -> (forall s c= R :^: idx N, forall x :e R :^: idx N, setdist N ({x},s) = 0 <-> s = Empty \/ x :e closure N s) /\ forall s c= R :^: idx N, forall x :e R :^: idx N, setdist N (s,{x}) = 0 <-> s = Empty \/ x :e closure N s.
Admitted.

// HOL Light: Multivariate/topology.ml:24720 / SETDIST_EQ_0_CLOSED
// Source hash: md5:c8d301373793bd3f1bb9847928581be7
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem SETDIST_EQ_0_CLOSED : forall A:set, A <> Empty -> forall s c= R :^: idx A, forall x :e R :^: idx A, closed A s -> (setdist A ({x},s) = 0 <-> s = Empty \/ x :e s).
Admitted.

// HOL Light: Multivariate/topology.ml:24724 / SETDIST_EQ_0_CLOSED_IN
// Source hash: md5:8255d94e4d043f2fc900344d94e77817
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_topology, omega_Subq_R)
Theorem SETDIST_EQ_0_CLOSED_IN : forall A:set, A <> Empty -> forall u s c= R :^: idx A, forall x :e R :^: idx A, closed_in (R :^: idx A) (subtopology (R :^: idx A) (euclidean A) u) s /\ x :e u -> (setdist A ({x},s) = 0 <-> s = Empty \/ x :e s).
Admitted.

// HOL Light: Multivariate/topology.ml:24729 / SETDIST_SING_IN_SET
// Source hash: md5:c5c4781ba4e0f14b87ec84bae0256219
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem SETDIST_SING_IN_SET : forall A:set, A <> Empty -> forall x :e R :^: idx A, forall s c= R :^: idx A, x :e s -> setdist A ({x},s) = 0.
Admitted.

// HOL Light: Multivariate/topology.ml:24733 / SETDIST_SING_FRONTIER_CASES
// Source hash: md5:6981a23085069f048ba6b25a2e650923
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem SETDIST_SING_FRONTIER_CASES : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x :e R :^: idx N, setdist N ({x},s) = if x :e s then 0 else setdist N ({x},frontier N s).
Admitted.

// HOL Light: Multivariate/topology.ml:24739 / SETDIST_LE_SING
// Source hash: md5:f3b766005923f0478cf3f1a744d2b428
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem SETDIST_LE_SING : forall N:set, N <> Empty -> forall s t c= R :^: idx N, forall x :e R :^: idx N, x :e s -> setdist N (s,t) <= setdist N ({x},t).
Admitted.

// HOL Light: Multivariate/topology.ml:24743 / SETDIST_BALLS
// Source hash: md5:c0500b277444bb241d5931672acb6ea6
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem SETDIST_BALLS : forall N:set, N <> Empty -> (forall a b :e R :^: idx N, forall r s :e R, setdist N (ball N (a,r),ball N (b,s)) = if r <= 0 \/ s <= 0 then 0 else if 0 <= distance N (a,b) + - (r + s) then distance N (a,b) + - (r + s) else 0) /\ ((forall a b :e R :^: idx N, forall r s :e R, setdist N (ball N (a,r),cball N (b,s)) = if r <= 0 \/ s < 0 then 0 else if 0 <= distance N (a,b) + - (r + s) then distance N (a,b) + - (r + s) else 0) /\ ((forall a b :e R :^: idx N, forall r s :e R, setdist N (cball N (a,r),ball N (b,s)) = if r < 0 \/ s <= 0 then 0 else if 0 <= distance N (a,b) + - (r + s) then distance N (a,b) + - (r + s) else 0) /\ forall a b :e R :^: idx N, forall r s :e R, setdist N (cball N (a,r),cball N (b,s)) = if r < 0 \/ s < 0 then 0 else if 0 <= distance N (a,b) + - (r + s) then distance N (a,b) + - (r + s) else 0)).
Admitted.

// HOL Light: Multivariate/topology.ml:24831 / UNIFORMLY_CONTINUOUS_ON_SETDIST
// Source hash: md5:734fb0b64da6859c6b21b4ac5b3b804f
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem UNIFORMLY_CONTINUOUS_ON_SETDIST : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s t t' c= R :^: idx M, uniformly_continuous_on_hl M N f s /\ (t c= s /\ (t' c= s /\ setdist M (t,t') = 0)) -> setdist N ({f x | x :e t},{f x | x :e t'}) = 0.
Admitted.

// HOL Light: Multivariate/topology.ml:24858 / UNIFORMLY_CONTINUOUS_ON_SETDIST_EQ
// Source hash: md5:6c6e147c4508d6598524fed03e485a56
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem UNIFORMLY_CONTINUOUS_ON_SETDIST_EQ : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, uniformly_continuous_on_hl M N f s <-> forall t t' c= R :^: idx M, t c= s /\ (t' c= s /\ setdist M (t,t') = 0) -> setdist N ({f x | x :e t},{f x | x :e t'}) = 0.
Admitted.

// HOL Light: Multivariate/topology.ml:25015 / OPEN_IN_SEPARATED_UNION
// Source hash: md5:7c893b22ab9e7a5f1c630a953b7319f2
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_topology, omega_Subq_R)
Theorem OPEN_IN_SEPARATED_UNION : forall N:set, N <> Empty -> forall s t c= R :^: idx N, 0 < setdist N (s,t) -> s :e subtopology (R :^: idx N) (euclidean N) (s :\/: t) /\ t :e subtopology (R :^: idx N) (euclidean N) (s :\/: t).
Admitted.

// HOL Light: Multivariate/topology.ml:25043 / CLOSED_IN_SEPARATED_UNION
// Source hash: md5:cb0b6fd26dcef83da1a6c9e3d9983d8c
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_topology, omega_Subq_R)
Theorem CLOSED_IN_SEPARATED_UNION : forall N:set, N <> Empty -> forall s t c= R :^: idx N, 0 < setdist N (s,t) -> closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) (s :\/: t)) s /\ closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) (s :\/: t)) t.
Admitted.

// HOL Light: Multivariate/topology.ml:25064 / CONNECTED_IMP_NONSEPARATED_UNION
// Source hash: md5:49d74dd2ceafe96dc4ddcbdeac138002
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem CONNECTED_IMP_NONSEPARATED_UNION : forall N:set, N <> Empty -> forall s t c= R :^: idx N, connected N (s :\/: t) -> setdist N (s,t) = 0.
Admitted.

// HOL Light: Multivariate/topology.ml:25078 / SEPARATION_CLOSURES
// Source hash: md5:d26784c3b322952f2792324248465cef
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem SEPARATION_CLOSURES : forall N:set, N <> Empty -> forall s t c= R :^: idx N, s :/\: closure N t = Empty /\ t :/\: closure N s = Empty -> exists u v c= R :^: idx N, u :/\: v = Empty /\ (open N u /\ (open N v /\ (s c= u /\ t c= v))).
Admitted.

// HOL Light: Multivariate/topology.ml:25089 / SEPARATION_NORMAL
// Source hash: md5:7a60852b7a4122acce1ad197064f3f27
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem SEPARATION_NORMAL : forall N:set, N <> Empty -> forall s t c= R :^: idx N, closed N s /\ (closed N t /\ s :/\: t = Empty) -> exists u v c= R :^: idx N, open N u /\ (open N v /\ (s c= u /\ (t c= v /\ u :/\: v = Empty))).
Admitted.

// HOL Light: Multivariate/topology.ml:25100 / SEPARATION_NORMAL_LOCAL_CLOSURES
// Source hash: md5:11d0f77b159a424540029c94bad5ba19
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem SEPARATION_NORMAL_LOCAL_CLOSURES : forall N:set, N <> Empty -> forall s t u c= R :^: idx N, closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) u) s /\ (closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) u) t /\ s :/\: t = Empty) -> exists s' t' c= R :^: idx N, s' :e subtopology (R :^: idx N) (euclidean N) u /\ (t' :e subtopology (R :^: idx N) (euclidean N) u /\ (s c= s' /\ (t c= t' /\ (s' :/\: t' = Empty /\ closure_of (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) u) s' :/\: closure_of (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) u) t' = Empty)))).
Admitted.

// HOL Light: Multivariate/topology.ml:25128 / SEPARATION_NORMAL_LOCAL
// Source hash: md5:0518332c9274051e353e7374a4b4e054
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem SEPARATION_NORMAL_LOCAL : forall N:set, N <> Empty -> forall s t u c= R :^: idx N, closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) u) s /\ (closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) u) t /\ s :/\: t = Empty) -> exists s' t' c= R :^: idx N, s' :e subtopology (R :^: idx N) (euclidean N) u /\ (t' :e subtopology (R :^: idx N) (euclidean N) u /\ (s c= s' /\ (t c= t' /\ s' :/\: t' = Empty))).
Admitted.

// HOL Light: Multivariate/topology.ml:25140 / SEPARATION_NORMAL_CLOSURES
// Source hash: md5:20380a441f3b789e82d9bbf4a6eb21aa
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem SEPARATION_NORMAL_CLOSURES : forall N:set, N <> Empty -> forall s t c= R :^: idx N, closed N s /\ (closed N t /\ s :/\: t = Empty) -> exists s' t' c= R :^: idx N, open N s' /\ (open N t' /\ (s c= s' /\ (t c= t' /\ (s' :/\: t' = Empty /\ closure N s' :/\: closure N t' = Empty)))).
Admitted.

// HOL Light: Multivariate/topology.ml:25169 / SEPARATION_HAUSDORFF
// Source hash: md5:00847aaaedc9c67e56f39e79b94c0126
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem SEPARATION_HAUSDORFF : forall N:set, N <> Empty -> forall x y :e R :^: idx N, ~ x = y -> exists u v c= R :^: idx N, open N u /\ (open N v /\ (x :e u /\ (y :e v /\ u :/\: v = Empty))).
Admitted.

// HOL Light: Multivariate/topology.ml:25177 / SEPARATION_T2
// Source hash: md5:12d34704d5e37c0918bc271b76a64452
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem SEPARATION_T2 : forall N:set, N <> Empty -> forall x y :e R :^: idx N, ~ x = y <-> exists u v c= R :^: idx N, open N u /\ (open N v /\ (x :e u /\ (y :e v /\ u :/\: v = Empty))).
Admitted.

// HOL Light: Multivariate/topology.ml:25184 / SEPARATION_T1
// Source hash: md5:b3bf35f900a1d8397475d44c5e236f89
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem SEPARATION_T1 : forall N:set, N <> Empty -> forall x y :e R :^: idx N, ~ x = y <-> exists u v c= R :^: idx N, open N u /\ (open N v /\ (x :e u /\ (~ y :e u /\ (~ x :e v /\ y :e v)))).
Admitted.

// HOL Light: Multivariate/topology.ml:25192 / SEPARATION_T0
// Source hash: md5:90d8a358f20c8289413343d2f2f61fba
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem SEPARATION_T0 : forall N:set, N <> Empty -> forall x y :e R :^: idx N, ~ x = y <-> exists u c= R :^: idx N, open N u /\ ~ (x :e u <-> y :e u).
Admitted.

// HOL Light: Multivariate/topology.ml:25196 / CLOSED_IN_EQ_CONTINUOUS_LEVELSET
// Source hash: md5:8ca82453730205599b9da8296c029450
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CLOSED_IN_EQ_CONTINUOUS_LEVELSET : forall M N:set, M <> Empty -> N <> Empty -> forall u s c= R :^: idx M, forall a :e R :^: idx N, closed_in (R :^: idx M) (subtopology (R :^: idx M) (euclidean M) u) s <-> exists f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) /\ (continuous_on_hl M N f u /\ {x :e R :^: idx M | x :e u /\ f x = a} = s).
Admitted.

// HOL Light: Multivariate/topology.ml:25223 / CLOSED_EQ_CONTINUOUS_LEVELSET
// Source hash: md5:65ce41cd3a9be052411e7227a6f76c61
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSED_EQ_CONTINUOUS_LEVELSET : forall M N:set, M <> Empty -> N <> Empty -> forall s c= R :^: idx M, forall a :e R :^: idx N, closed M s <-> exists f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) /\ (continuous_on_hl M N f (R :^: idx M) /\ {x :e R :^: idx M | f x = a} = s).
Admitted.

// HOL Light: Multivariate/topology.ml:25231 / CONNECTED
// Source hash: md5:b42cae550ee38d5d3852bcd363c90e07
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED : forall N:set, N <> Empty -> forall s c= R :^: idx N, connected N s <-> ~ exists e1 e2 c= R :^: idx N, open N e1 /\ (open N e2 /\ (s c= e1 :\/: e2 /\ (e1 :/\: e2 = Empty /\ (~ e1 :/\: s = Empty /\ ~ e2 :/\: s = Empty)))).
Admitted.

// HOL Light: Multivariate/topology.ml:25295 / hausdist
// Source hash: md5:26e3d8373a2f3045791f11e2060cc5ef
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem hausdist_thm : forall N:set, N <> Empty -> forall t s c= R :^: idx N, hausdist N (s,t) = if ~ {setdist N ({x},t) | x :e R :^: idx N, x :e s} :\/: {setdist N ({y},s) | y :e R :^: idx N, y :e t} = Empty /\ exists b :e R, forall d :e R, d :e {setdist N ({x},t) | x :e R :^: idx N, x :e s} :\/: {setdist N ({y},s) | y :e R :^: idx N, y :e t} -> d <= b then sup ({setdist N ({x},t) | x :e R :^: idx N, x :e s} :\/: {setdist N ({y},s) | y :e R :^: idx N, y :e t}) else 0.
Admitted.

// HOL Light: Multivariate/topology.ml:25301 / HAUSDIST_POS_LE
// Source hash: md5:c4fe499118f4a23b9de4e2ac1b48c75f
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem HAUSDIST_POS_LE : forall N:set, N <> Empty -> forall s t c= R :^: idx N, 0 <= hausdist N (s,t).
Admitted.

// HOL Light: Multivariate/topology.ml:25314 / HAUSDIST_POS_LT
// Source hash: md5:122536f5bd3e6e945d38acaacd0eb36e
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem HAUSDIST_POS_LT : forall N:set, N <> Empty -> forall s t c= R :^: idx N, 0 < hausdist N (s,t) <-> ~ hausdist N (s,t) = 0.
Admitted.

// HOL Light: Multivariate/topology.ml:25318 / REAL_ABS_HAUSDIST
// Source hash: md5:0805f089f8dc32bdfc5c797d4318ce4d
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem REAL_ABS_HAUSDIST : forall N:set, N <> Empty -> forall s t c= R :^: idx N, abs_SNo (hausdist N (s,t)) = hausdist N (s,t).
Admitted.

// HOL Light: Multivariate/topology.ml:25322 / HAUSDIST_REFL
// Source hash: md5:493dde1d48b09de0e3d81e99606596d8
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem HAUSDIST_REFL : forall N:set, N <> Empty -> forall s c= R :^: idx N, hausdist N (s,s) = 0.
Admitted.

// HOL Light: Multivariate/topology.ml:25331 / HAUSDIST_SYM
// Source hash: md5:d8f6f761d4f77e64703d2b621d426d2b
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem HAUSDIST_SYM : forall N:set, N <> Empty -> forall s t c= R :^: idx N, hausdist N (s,t) = hausdist N (t,s).
Admitted.

// HOL Light: Multivariate/topology.ml:25337 / HAUSDIST_EMPTY
// Source hash: md5:8a92609bbad703816dd77258e9c9af5b
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem HAUSDIST_EMPTY : forall N:set, N <> Empty -> (forall t c= R :^: idx N, hausdist N (Empty,t) = 0) /\ forall s c= R :^: idx N, hausdist N (s,Empty) = 0.
Admitted.

// HOL Light: Multivariate/topology.ml:25348 / HAUSDIST_SINGS
// Source hash: md5:d884396b4ed4f50b068abb9e7bd2f9b6
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem HAUSDIST_SINGS : forall N:set, N <> Empty -> forall x y :e R :^: idx N, hausdist N ({x},{y}) = distance N (x,y).
Admitted.

// HOL Light: Multivariate/topology.ml:25356 / HAUSDIST_SCALING
// Source hash: md5:2b46286ab7726e4ecf2df43271d476d4
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem HAUSDIST_SCALING : forall N:set, N <> Empty -> forall a :e R, forall s t c= R :^: idx N, hausdist N ({vector_mul N a x | x :e s},{vector_mul N a x | x :e t}) = abs_SNo a * hausdist N (s,t).
Admitted.

// HOL Light: Multivariate/topology.ml:25402 / HAUSDIST_EQ
// Source hash: md5:b583af08d925c264508c390e8d552027
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem HAUSDIST_EQ : forall M N:set, M <> Empty -> N <> Empty -> forall s t c= R :^: idx M, forall s' t' c= R :^: idx N, (forall b :e R, (forall x :e R :^: idx M, x :e s -> setdist M ({x},t) <= b) /\ (forall y :e R :^: idx M, y :e t -> setdist M ({y},s) <= b) <-> (forall x :e R :^: idx N, x :e s' -> setdist N ({x},t') <= b) /\ forall y :e R :^: idx N, y :e t' -> setdist N ({y},s') <= b) -> hausdist M (s,t) = hausdist N (s',t').
Admitted.

// HOL Light: Multivariate/topology.ml:25428 / HAUSDIST_TRANSLATION
// Source hash: md5:4625cd8a809c9006ca121053d025134a
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem HAUSDIST_TRANSLATION : forall N:set, N <> Empty -> forall a :e R :^: idx N, forall s t c= R :^: idx N, hausdist N ({vector_add N a x | x :e s},{vector_add N a x | x :e t}) = hausdist N (s,t).
Admitted.

// HOL Light: Multivariate/topology.ml:25438 / HAUSDIST_LINEAR_IMAGE
// Source hash: md5:bbcdfe6d88c36232c2c3c7faa7840ca8
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem HAUSDIST_LINEAR_IMAGE : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s t c= R :^: idx M, linear M N f /\ (forall x :e R :^: idx M, sqrt_SNo_nonneg (dot N (f x) (f x)) = sqrt_SNo_nonneg (dot M x x)) -> hausdist N ({f x | x :e s},{f x | x :e t}) = hausdist M (s,t).
Admitted.

// HOL Light: Multivariate/topology.ml:25450 / HAUSDIST_CLOSURE
// Source hash: md5:1fc9bbe54d395c6f44c80b5af91b91a8
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem HAUSDIST_CLOSURE : forall N:set, N <> Empty -> (forall s t c= R :^: idx N, hausdist N (closure N s,t) = hausdist N (s,t)) /\ forall s t c= R :^: idx N, hausdist N (s,closure N t) = hausdist N (s,t).
Admitted.

// HOL Light: Multivariate/topology.ml:25467 / REAL_HAUSDIST_LE
// Source hash: md5:6ab35fdcd508314bb17abaadec93b1fc
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem REAL_HAUSDIST_LE : forall N:set, N <> Empty -> forall s t c= R :^: idx N, forall b :e R, ~ s = Empty /\ (~ t = Empty /\ ((forall x :e R :^: idx N, x :e s -> setdist N ({x},t) <= b) /\ (forall y :e R :^: idx N, y :e t -> setdist N ({y},s) <= b))) -> hausdist N (s,t) <= b.
Admitted.

// HOL Light: Multivariate/topology.ml:25482 / REAL_HAUSDIST_LE_SUMS
// Source hash: md5:63f38a916e88fb071dff84c535121869
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R)
Theorem REAL_HAUSDIST_LE_SUMS : forall N:set, N <> Empty -> forall s t c= R :^: idx N, forall b :e R, ~ s = Empty /\ (~ t = Empty /\ (s c= (\/_ y :e R :^: idx N, {vector_add N y z | z :e R :^: idx N, y :e t /\ z :e cball N (vec N 0,b)}) /\ t c= (\/_ y :e R :^: idx N, {vector_add N y z | z :e R :^: idx N, y :e s /\ z :e cball N (vec N 0,b)}))) -> hausdist N (s,t) <= b.
Admitted.

// HOL Light: Multivariate/topology.ml:25495 / REAL_LE_HAUSDIST
// Source hash: md5:ebe858cfa54aede7cb55543634718150
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem REAL_LE_HAUSDIST : forall N:set, N <> Empty -> forall s t c= R :^: idx N, forall a b c :e R, forall z :e R :^: idx N, ~ s = Empty /\ (~ t = Empty /\ ((forall x :e R :^: idx N, x :e s -> setdist N ({x},t) <= b) /\ ((forall y :e R :^: idx N, y :e t -> setdist N ({y},s) <= c) /\ (z :e s /\ a <= setdist N ({z},t) \/ z :e t /\ a <= setdist N ({z},s))))) -> a <= hausdist N (s,t).
Admitted.

// HOL Light: Multivariate/topology.ml:25515 / SETDIST_LE_HAUSDIST
// Source hash: md5:f294b26ec2450c56559ddc58a20f3001
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem SETDIST_LE_HAUSDIST : forall N:set, N <> Empty -> forall s t c= R :^: idx N, bounded_hl N s /\ bounded_hl N t -> setdist N (s,t) <= hausdist N (s,t).
Admitted.

// HOL Light: Multivariate/topology.ml:25534 / SETDIST_SING_LE_HAUSDIST
// Source hash: md5:f15b3375ba7639c03ef190c0e50a7726
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem SETDIST_SING_LE_HAUSDIST : forall N:set, N <> Empty -> forall s t c= R :^: idx N, forall x :e R :^: idx N, bounded_hl N s /\ (bounded_hl N t /\ x :e s) -> setdist N ({x},t) <= hausdist N (s,t).
Admitted.

// HOL Light: Multivariate/topology.ml:25560 / SETDIST_HAUSDIST_TRIANGLE
// Source hash: md5:756ac48d1dac59f3a9bd1a6fd034e5d9
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem SETDIST_HAUSDIST_TRIANGLE : forall N:set, N <> Empty -> forall s t u c= R :^: idx N, ~ t = Empty /\ (bounded_hl N t /\ bounded_hl N u) -> setdist N (s,u) <= setdist N (s,t) + hausdist N (t,u).
Admitted.

// HOL Light: Multivariate/topology.ml:25580 / HAUSDIST_SETDIST_TRIANGLE
// Source hash: md5:6c3ce3fad3fd7fd6c689ba9a83f4e079
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem HAUSDIST_SETDIST_TRIANGLE : forall N:set, N <> Empty -> forall s t u c= R :^: idx N, ~ t = Empty /\ (bounded_hl N s /\ bounded_hl N t) -> setdist N (s,u) <= hausdist N (s,t) + setdist N (t,u).
Admitted.

// HOL Light: Multivariate/topology.ml:25588 / REAL_LT_HAUSDIST_POINT_EXISTS
// Source hash: md5:9efbc8e26dd5745acd5fa0c91535ab96
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem REAL_LT_HAUSDIST_POINT_EXISTS : forall N:set, N <> Empty -> forall s t c= R :^: idx N, forall x :e R :^: idx N, forall d :e R, bounded_hl N s /\ (bounded_hl N t /\ (~ t = Empty /\ (hausdist N (s,t) < d /\ x :e s))) -> exists y :e R :^: idx N, y :e t /\ distance N (x,y) < d.
Admitted.

// HOL Light: Multivariate/topology.ml:25602 / HAUSDIST_UNIFORMLY_CONTINUOUS_ON
// Source hash: md5:f3bfc385a461c4d46258846b39f90557
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem HAUSDIST_UNIFORMLY_CONTINUOUS_ON : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, uniformly_continuous_on_hl M N f s <-> forall e0 :e R, 0 < e0 -> exists d :e R, 0 < d /\ forall t t' c= R :^: idx M, t c= s /\ (t' c= s /\ (bounded_hl M t /\ (bounded_hl M t' /\ hausdist M (t',t) < d))) -> hausdist N ({f x | x :e t'},{f x | x :e t}) < e0.
Admitted.

// HOL Light: Multivariate/topology.ml:25667 / UPPER_LOWER_HEMICONTINUOUS
// Source hash: md5:071e3325f7b3aab4f3aa9487757107e7
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_topology, omega_Subq_R)
Theorem UPPER_LOWER_HEMICONTINUOUS : forall M N:set, M <> Empty -> N <> Empty -> forall f :e Power (R :^: idx N) :^: (R :^: idx M), forall t c= R :^: idx N, forall s c= R :^: idx M, (forall x :e R :^: idx M, x :e s -> f x c= t) /\ ((forall u c= R :^: idx N, u :e subtopology (R :^: idx N) (euclidean N) t -> {x :e R :^: idx M | x :e s /\ f x c= u} :e subtopology (R :^: idx M) (euclidean M) s) /\ (forall u c= R :^: idx N, closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) t) u -> closed_in (R :^: idx M) (subtopology (R :^: idx M) (euclidean M) s) {x :e R :^: idx M | x :e s /\ f x c= u})) -> forall x :e R :^: idx M, forall e0 :e R, x :e s /\ (0 < e0 /\ bounded_hl N (f x)) -> exists d :e R, 0 < d /\ forall x' :e R :^: idx M, x' :e s /\ distance M (x,x') < d -> hausdist N (f x,f x') < e0.
Admitted.

// HOL Light: Multivariate/topology.ml:25707 / HAUSDIST_NONTRIVIAL
// Source hash: md5:498161359afda6015b8a0075a5468f9d
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem HAUSDIST_NONTRIVIAL : forall N:set, N <> Empty -> forall s t c= R :^: idx N, bounded_hl N s /\ (bounded_hl N t /\ (~ s = Empty /\ ~ t = Empty)) -> hausdist N (s,t) = sup ({setdist N ({x},t) | x :e R :^: idx N, x :e s} :\/: {setdist N ({y},s) | y :e R :^: idx N, y :e t}).
Admitted.

// HOL Light: Multivariate/topology.ml:25723 / HAUSDIST_NONTRIVIAL_ALT
// Source hash: md5:2f5188781009abf48eeb9d7f5d59287c
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem HAUSDIST_NONTRIVIAL_ALT : forall N:set, N <> Empty -> forall s t c= R :^: idx N, bounded_hl N s /\ (bounded_hl N t /\ (~ s = Empty /\ ~ t = Empty)) -> hausdist N (s,t) = if sup {setdist N ({x},t) | x :e R :^: idx N, x :e s} <= sup {setdist N ({y},s) | y :e R :^: idx N, y :e t} then sup {setdist N ({y},s) | y :e R :^: idx N, y :e t} else sup {setdist N ({x},t) | x :e R :^: idx N, x :e s}.
Admitted.

// HOL Light: Multivariate/topology.ml:25738 / REAL_HAUSDIST_LE_EQ
// Source hash: md5:2b1e22ea0076131f96af9588a2472134
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem REAL_HAUSDIST_LE_EQ : forall N:set, N <> Empty -> forall s t c= R :^: idx N, forall b :e R, ~ s = Empty /\ (~ t = Empty /\ (bounded_hl N s /\ bounded_hl N t)) -> (hausdist N (s,t) <= b <-> (forall x :e R :^: idx N, x :e s -> setdist N ({x},t) <= b) /\ forall y :e R :^: idx N, y :e t -> setdist N ({y},s) <= b).
Admitted.

// HOL Light: Multivariate/topology.ml:25757 / HAUSDIST_UNION_LE
// Source hash: md5:6d7f447f486d14f5947557aa94fa44eb
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem HAUSDIST_UNION_LE : forall N:set, N <> Empty -> forall s t u c= R :^: idx N, bounded_hl N s /\ (bounded_hl N t /\ (bounded_hl N u /\ (~ t = Empty /\ ~ u = Empty))) -> hausdist N (s :\/: t,s :\/: u) <= hausdist N (t,u).
Admitted.

// HOL Light: Multivariate/topology.ml:25773 / HAUSDIST_INSERT_LE
// Source hash: md5:fdd1da3f305a0108a3d2043d6a4bafb3
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem HAUSDIST_INSERT_LE : forall N:set, N <> Empty -> forall s t c= R :^: idx N, forall a :e R :^: idx N, bounded_hl N s /\ (bounded_hl N t /\ (~ s = Empty /\ ~ t = Empty)) -> hausdist N (SetAdjoin s a,SetAdjoin t a) <= hausdist N (s,t).
Admitted.

// HOL Light: Multivariate/topology.ml:25803 / HAUSDIST_TRIANGLE
// Source hash: md5:96a20d5f59f2ebd776fb9901da2cf8ca
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem HAUSDIST_TRIANGLE : forall N:set, N <> Empty -> forall s t u c= R :^: idx N, bounded_hl N s /\ (bounded_hl N t /\ (bounded_hl N u /\ ~ t = Empty)) -> hausdist N (s,u) <= hausdist N (s,t) + hausdist N (t,u).
Admitted.

// HOL Light: Multivariate/topology.ml:25849 / HAUSDIST_SUMS_LE
// Source hash: md5:007e4086c82b16019408955e3f31f33c
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem HAUSDIST_SUMS_LE : forall N:set, N <> Empty -> forall s t u v c= R :^: idx N, bounded_hl N s /\ (bounded_hl N t /\ (bounded_hl N u /\ bounded_hl N v)) -> hausdist N (\/_ x :e R :^: idx N, {vector_add N x y | y :e R :^: idx N, x :e s /\ y :e t},\/_ x :e R :^: idx N, {vector_add N x y | y :e R :^: idx N, x :e u /\ y :e v}) <= hausdist N (s,u) + hausdist N (t,v).
Admitted.

// HOL Light: Multivariate/topology.ml:25892 / HAUSDIST_SUMS_LE_LCANCEL
// Source hash: md5:68668d7306dacb048ade6d09e7169373
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem HAUSDIST_SUMS_LE_LCANCEL : forall N:set, N <> Empty -> forall s t u c= R :^: idx N, bounded_hl N s /\ (bounded_hl N t /\ bounded_hl N u) -> hausdist N (\/_ x :e R :^: idx N, {vector_add N x y | y :e R :^: idx N, x :e s /\ y :e t},\/_ x :e R :^: idx N, {vector_add N x y | y :e R :^: idx N, x :e s /\ y :e u}) <= hausdist N (t,u).
Admitted.

// HOL Light: Multivariate/topology.ml:25901 / HAUSDIST_SUMS_LE_RCANCEL
// Source hash: md5:ba34ea84f6281fd23ab9dc1b35857207
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem HAUSDIST_SUMS_LE_RCANCEL : forall N:set, N <> Empty -> forall s t u c= R :^: idx N, bounded_hl N s /\ (bounded_hl N t /\ bounded_hl N u) -> hausdist N (\/_ x :e R :^: idx N, {vector_add N x y | y :e R :^: idx N, x :e s /\ y :e u},\/_ x :e R :^: idx N, {vector_add N x y | y :e R :^: idx N, x :e t /\ y :e u}) <= hausdist N (s,t).
Admitted.

// HOL Light: Multivariate/topology.ml:25910 / HAUSDIST_EQ_0
// Source hash: md5:afd98aae5afa5f4b06f48610ddad82c4
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem HAUSDIST_EQ_0 : forall N:set, N <> Empty -> forall s t c= R :^: idx N, bounded_hl N s /\ bounded_hl N t -> (hausdist N (s,t) = 0 <-> s = Empty \/ (t = Empty \/ closure N s = closure N t)).
Admitted.

// HOL Light: Multivariate/topology.ml:25945 / HAUSDIST_BALLS
// Source hash: md5:10d3a81346ec4ad44fd7c610eb73d3b3
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem HAUSDIST_BALLS : forall N:set, N <> Empty -> (forall a b :e R :^: idx N, forall r s :e R, hausdist N (ball N (a,r),ball N (b,s)) = if r <= 0 \/ s <= 0 then 0 else distance N (a,b) + abs_SNo (r + - s)) /\ ((forall a b :e R :^: idx N, forall r s :e R, hausdist N (ball N (a,r),cball N (b,s)) = if r <= 0 \/ s < 0 then 0 else distance N (a,b) + abs_SNo (r + - s)) /\ ((forall a b :e R :^: idx N, forall r s :e R, hausdist N (cball N (a,r),ball N (b,s)) = if r < 0 \/ s <= 0 then 0 else distance N (a,b) + abs_SNo (r + - s)) /\ forall a b :e R :^: idx N, forall r s :e R, hausdist N (cball N (a,r),cball N (b,s)) = if r < 0 \/ s < 0 then 0 else distance N (a,b) + abs_SNo (r + - s))).
Admitted.

// HOL Light: Multivariate/topology.ml:25996 / HAUSDIST_ALT
// Source hash: md5:8724a66273e54b53bcff0ff62e0a2026
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem HAUSDIST_ALT : forall N:set, N <> Empty -> forall s t c= R :^: idx N, bounded_hl N s /\ (bounded_hl N t /\ (~ s = Empty /\ ~ t = Empty)) -> hausdist N (s,t) = sup {abs_SNo (setdist N ({x},s) + - setdist N ({x},t)) | x :e R :^: idx N, x :e R :^: idx N}.
Admitted.

// HOL Light: Multivariate/topology.ml:26031 / DIAMETERS_HAUSDIST_BOUND
// Source hash: md5:978239e3ae12a1b11d4ccd4834f9e8bb
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem DIAMETERS_HAUSDIST_BOUND : forall N:set, N <> Empty -> forall s t c= R :^: idx N, bounded_hl N s /\ (~ s = Empty /\ (bounded_hl N t /\ ~ t = Empty)) -> abs_SNo (diameter N s + - diameter N t) <= 2 * hausdist N (s,t).
Admitted.

// HOL Light: Multivariate/topology.ml:26053 / CONTINUOUS_DIAMETER
// Source hash: md5:a53c23368f410efe8ddad7d3233c515e
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem CONTINUOUS_DIAMETER : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall e0 :e R, bounded_hl N s /\ (~ s = Empty /\ 0 < e0) -> exists d :e R, 0 < d /\ forall t c= R :^: idx N, bounded_hl N t /\ (~ t = Empty /\ hausdist N (s,t) < d) -> abs_SNo (diameter N s + - diameter N t) < e0.
Admitted.

// HOL Light: Multivariate/topology.ml:26491 / TOTALLY_BOUNDED_HAUSDIST
// Source hash: md5:a252202faf90d329d5b30e494c377df1
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_finite, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem TOTALLY_BOUNDED_HAUSDIST : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall e0 :e R, bounded_hl N s /\ 0 < e0 -> exists k c= Power (R :^: idx N), finite k /\ ((forall u c= R :^: idx N, u :e k -> ~ u = Empty /\ u c= s) /\ forall t c= R :^: idx N, t c= s /\ ~ t = Empty -> exists u c= R :^: idx N, u :e k /\ hausdist N (t,u) < e0).
Admitted.

// HOL Light: Multivariate/topology.ml:26717 / ISOMETRY_IMP_OPEN_MAP
// Source hash: md5:d3dd76aa6c1593546af3a07eaeb07d22
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R, hol_typedef_topology)
Theorem ISOMETRY_IMP_OPEN_MAP : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, forall t c= R :^: idx N, forall u c= R :^: idx M, {f x | x :e s} = t /\ ((forall x y :e R :^: idx M, x :e s /\ y :e s -> distance N (f x,f y) = distance M (x,y)) /\ u :e subtopology (R :^: idx M) (euclidean M) s) -> {f x | x :e u} :e subtopology (R :^: idx N) (euclidean N) t.
Admitted.

// HOL Light: Multivariate/topology.ml:26732 / ISOMETRY_IMP_EMBEDDING
// Source hash: md5:781d84a751bde13961e6aac593061e6f
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem ISOMETRY_IMP_EMBEDDING : forall M N:set, M <> Empty -> N <> Empty -> forall f :e R :^: idx N :^: (R :^: idx M), forall s c= R :^: idx M, forall t c= R :^: idx N, {f x | x :e s} = t /\ (forall x y :e R :^: idx M, x :e s /\ y :e s -> distance N (f x,f y) = distance M (x,y)) -> exists g :e R :^: idx M :^: (R :^: idx N), homeomorphism M N (s,t) (f,g).
Admitted.

// HOL Light: Multivariate/topology.ml:26787 / URYSOHN_LOCAL_STRONG
// Source hash: md5:75794acddb75ad3e930289942a1b9bce
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R, hol_typedef_topology)
Theorem URYSOHN_LOCAL_STRONG : forall M N:set, M <> Empty -> N <> Empty -> forall s t u c= R :^: idx N, forall a b :e R :^: idx M, closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) u) s /\ (closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) u) t /\ (s :/\: t = Empty /\ ~ a = b)) -> exists f:set -> set, (forall x :e R :^: idx N, f x :e R :^: idx M) /\ (continuous_on_hl N M f u /\ ((forall x :e R :^: idx N, x :e u -> f x :e closed_segment M (seq_cons (a,b) seq_nil)) /\ ((forall x :e R :^: idx N, x :e u -> (f x = a <-> x :e s)) /\ forall x :e R :^: idx N, x :e u -> (f x = b <-> x :e t)))).
Admitted.

// HOL Light: Multivariate/topology.ml:26902 / URYSOHN_LOCAL
// Source hash: md5:903c56b2e0d5e5b7edd9d49e026844fd
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R, hol_typedef_topology)
Theorem URYSOHN_LOCAL : forall M N:set, M <> Empty -> N <> Empty -> forall s t u c= R :^: idx N, forall a b :e R :^: idx M, closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) u) s /\ (closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) u) t /\ s :/\: t = Empty) -> exists f:set -> set, (forall x :e R :^: idx N, f x :e R :^: idx M) /\ (continuous_on_hl N M f u /\ ((forall x :e R :^: idx N, x :e u -> f x :e closed_segment M (seq_cons (a,b) seq_nil)) /\ ((forall x :e R :^: idx N, x :e s -> f x = a) /\ forall x :e R :^: idx N, x :e t -> f x = b))).
Admitted.

// HOL Light: Multivariate/topology.ml:26921 / URYSOHN_STRONG
// Source hash: md5:8553b6a17dc36edcd4bc0c5c82dde97e
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem URYSOHN_STRONG : forall M N:set, M <> Empty -> N <> Empty -> forall s t c= R :^: idx N, forall a b :e R :^: idx M, closed N s /\ (closed N t /\ (s :/\: t = Empty /\ ~ a = b)) -> exists f:set -> set, (forall x :e R :^: idx N, f x :e R :^: idx M) /\ (continuous_on_hl N M f (R :^: idx N) /\ ((forall x :e R :^: idx N, f x :e closed_segment M (seq_cons (a,b) seq_nil)) /\ ((forall x :e R :^: idx N, f x = a <-> x :e s) /\ forall x :e R :^: idx N, f x = b <-> x :e t))).
Admitted.

// HOL Light: Multivariate/topology.ml:26932 / URYSOHN
// Source hash: md5:50b4814be50806bc575757aa96363c4a
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem URYSOHN : forall M N:set, M <> Empty -> N <> Empty -> forall s t c= R :^: idx N, forall a b :e R :^: idx M, closed N s /\ (closed N t /\ s :/\: t = Empty) -> exists f:set -> set, (forall x :e R :^: idx N, f x :e R :^: idx M) /\ (continuous_on_hl N M f (R :^: idx N) /\ ((forall x :e R :^: idx N, f x :e closed_segment M (seq_cons (a,b) seq_nil)) /\ ((forall x :e R :^: idx N, x :e s -> f x = a) /\ forall x :e R :^: idx N, x :e t -> f x = b))).
Admitted.

// HOL Light: Multivariate/topology.ml:26947 / CLOSURE_DYADIC_RATIONALS
// Source hash: md5:23427f432c98f3f52c46cbe9ec91d74f
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_real_R, int_Subq_R, nat_le_SNoLe, omega_Subq_R)
Theorem CLOSURE_DYADIC_RATIONALS : forall N:set, N <> Empty -> closure N (\/_ n :e omega, {vector_mul N (recip_SNo (2 ^ n)) x | x :e R :^: idx N, forall i :e omega, 1 <= i /\ i <= dimindex N -> x i :e int}) = R :^: idx N.
Admitted.

// HOL Light: Multivariate/topology.ml:26974 / CLOSURE_RATIONAL_COORDINATES
// Source hash: md5:a738f26cf8aab0ea88ce39f0a620402a
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_real_R, nat_le_SNoLe)
Theorem CLOSURE_RATIONAL_COORDINATES : forall N:set, N <> Empty -> closure N {x :e R :^: idx N | forall i :e omega, 1 <= i /\ i <= dimindex N -> x i :e rational} = R :^: idx N.
Admitted.

// HOL Light: Multivariate/topology.ml:26987 / CLOSURE_DYADIC_RATIONALS_IN_OPEN_SET
// Source hash: md5:9faa0ba20687c7130d810d85b59ad647
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_real_R, int_Subq_R, nat_le_SNoLe, omega_Subq_R)
Theorem CLOSURE_DYADIC_RATIONALS_IN_OPEN_SET : forall N:set, N <> Empty -> forall s c= R :^: idx N, open N s -> closure N (s :/\: \/_ n :e omega, {vector_mul N (recip_SNo (2 ^ n)) x | x :e R :^: idx N, forall i :e omega, 1 <= i /\ i <= dimindex N -> x i :e int}) = closure N s.
Admitted.

// HOL Light: Multivariate/topology.ml:26997 / CLOSURE_RATIONALS_IN_OPEN_SET
// Source hash: md5:699e344404b2a34ce8f71eac47c87ea4
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_real_R, nat_le_SNoLe)
Theorem CLOSURE_RATIONALS_IN_OPEN_SET : forall N:set, N <> Empty -> forall s c= R :^: idx N, open N s -> closure N (s :/\: {x :e R :^: idx N | forall i :e omega, 1 <= i /\ i <= dimindex N -> x i :e rational}) = closure N s.
Admitted.

// HOL Light: Multivariate/topology.ml:27010 / UNIV_SECOND_COUNTABLE
// Source hash: md5:27203014114b49e7688558cf2ac6a0da
// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_real_R)
Theorem UNIV_SECOND_COUNTABLE : forall N:set, N <> Empty -> exists b c= Power (R :^: idx N), countable b /\ ((forall c c= R :^: idx N, c :e b -> open N c) /\ forall s c= R :^: idx N, open N s -> exists u c= Power (R :^: idx N), u c= b /\ s = Union u).
Admitted.

// HOL Light: Multivariate/topology.ml:27057 / UNIV_SECOND_COUNTABLE_SEQUENCE
// Source hash: md5:393c90215d41d281dd49761367378522
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R)
Theorem UNIV_SECOND_COUNTABLE_SEQUENCE : forall N:set, N <> Empty -> exists b :e Power (R :^: idx N) :^: omega, (forall m n :e omega, b m = b n <-> m = n) /\ ((forall n :e omega, open N (b n)) /\ forall s c= R :^: idx N, open N s -> exists k c= omega, s = Union {b n | n :e omega, n :e k}).
Admitted.

// HOL Light: Multivariate/topology.ml:27100 / SUBSET_SECOND_COUNTABLE
// Source hash: md5:5620914023a82c93fca47c67ac947c02
// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_real_R, hol_typedef_topology)
Theorem SUBSET_SECOND_COUNTABLE : forall N:set, N <> Empty -> forall s c= R :^: idx N, exists b c= Power (R :^: idx N), countable b /\ ((forall c c= R :^: idx N, c :e b -> ~ c = Empty /\ c :e subtopology (R :^: idx N) (euclidean N) s) /\ forall t c= R :^: idx N, t :e subtopology (R :^: idx N) (euclidean N) s -> exists u c= Power (R :^: idx N), u c= b /\ t = Union u).
Admitted.

// HOL Light: Multivariate/topology.ml:27138 / SEPARABLE
// Source hash: md5:2bbf9a3d31782ce6efb4d0043efd2aac
// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_real_R)
Theorem SEPARABLE : forall N:set, N <> Empty -> forall s c= R :^: idx N, exists t c= R :^: idx N, countable t /\ (t c= s /\ s c= closure N t).
Admitted.

// HOL Light: Multivariate/topology.ml:27186 / OPEN_SET_RATIONAL_COORDINATES
// Source hash: md5:5acdbb0650ead3eafa247043e4a0c8b0
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_real_R, nat_le_SNoLe)
Theorem OPEN_SET_RATIONAL_COORDINATES : forall N:set, N <> Empty -> forall s c= R :^: idx N, open N s /\ ~ s = Empty -> exists x :e R :^: idx N, x :e s /\ forall i :e omega, 1 <= i /\ i <= dimindex N -> x i :e rational.
Admitted.

// HOL Light: Multivariate/topology.ml:27258 / LINDELOF
// Source hash: md5:cca2873dc9063e7a31ade7cf9512fcdd
// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_real_R)
Theorem LINDELOF : forall N:set, N <> Empty -> forall f c= Power (R :^: idx N), (forall s c= R :^: idx N, s :e f -> open N s) -> exists f' c= Power (R :^: idx N), f' c= f /\ (countable f' /\ Union f' = Union f).
Admitted.

// HOL Light: Multivariate/topology.ml:27284 / LINDELOF_OPEN_IN
// Source hash: md5:279b5fa7aae46ba8aada5a64da76c254
// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_real_R, hol_typedef_topology)
Theorem LINDELOF_OPEN_IN : forall N:set, N <> Empty -> forall f c= Power (R :^: idx N), forall u c= R :^: idx N, (forall s c= R :^: idx N, s :e f -> s :e subtopology (R :^: idx N) (euclidean N) u) -> exists f' c= Power (R :^: idx N), f' c= f /\ (countable f' /\ Union f' = Union f).
Admitted.

// HOL Light: Multivariate/topology.ml:27302 / COUNTABLE_DISJOINT_OPEN_IN_SUBSETS
// Source hash: md5:d9fe472e2ad29e38eb9b4859cf0a5509
// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_real_R, hol_typedef_topology)
Theorem COUNTABLE_DISJOINT_OPEN_IN_SUBSETS : forall N:set, N <> Empty -> forall f c= Power (R :^: idx N), forall u c= R :^: idx N, (forall s c= R :^: idx N, s :e f -> s :e subtopology (R :^: idx N) (euclidean N) u) /\ (forall x y :e f, x <> y -> x :/\: y = Empty) -> countable f.
Admitted.

// HOL Light: Multivariate/topology.ml:27319 / COUNTABLE_DISJOINT_OPEN_SUBSETS
// Source hash: md5:81efd53ee99676dc06a9e5e862ac7996
// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_real_R)
Theorem COUNTABLE_DISJOINT_OPEN_SUBSETS : forall N:set, N <> Empty -> forall f c= Power (R :^: idx N), (forall s c= R :^: idx N, s :e f -> open N s) /\ (forall x y :e f, x <> y -> x :/\: y = Empty) -> countable f.
Admitted.

// HOL Light: Multivariate/topology.ml:27327 / COUNTABLE_DISJOINT_NONEMPTY_INTERIOR_SUBSETS
// Source hash: md5:6fe9dd3379f5032c4af1051ec4e37cf3
// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_real_R)
Theorem COUNTABLE_DISJOINT_NONEMPTY_INTERIOR_SUBSETS : forall N:set, N <> Empty -> forall f c= Power (R :^: idx N), (forall s c= R :^: idx N, s :e f /\ interior N s = Empty -> s = Empty) /\ (forall x y :e f, x <> y -> x :/\: y = Empty) -> countable f.
Admitted.

