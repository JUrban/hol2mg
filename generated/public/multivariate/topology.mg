Theorem LINEAR_IMP_HOMEOMORPHISM : forall M N:set, M <> Empty -> N <> Empty -> forall f :e R :^: idx N :^: (R :^: idx M), forall g :e R :^: idx M :^: (R :^: idx N), forall s c= R :^: idx M, forall t c= R :^: idx N, linear M N (fun x:set => f x) /\ (linear N M (fun x:set => g x) /\ ((forall x :e R :^: idx M, g (f x) = x) /\ {f x | x :e s} = t)) -> homeomorphism M N (s,t) (f,g).
Admitted.

