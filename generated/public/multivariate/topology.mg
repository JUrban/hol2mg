// HOL Light: Multivariate/topology.ml:9909 / FORALL_IN_INTERMEDIATE_CLOSURE
// Source hash: md5:6eccc63fd469f285886fd331d2434d86
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FORALL_IN_INTERMEDIATE_CLOSURE : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s s' c= R :^: idx M, forall t c= R :^: idx N, closed N t /\ (continuous_on_hl M N f s' /\ (s c= s' /\ (s' c= closure M s /\ (forall x :e R :^: idx M, x :e s -> f x :e t)))) -> forall x :e R :^: idx M, x :e s' -> f x :e t.
Admitted.

