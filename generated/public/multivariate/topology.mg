// HOL Light: Multivariate/topology.ml:27543 / CANTOR_BENDIXSON_GEN
// Source hash: md5:52c685b04b3eaf6dc4910dfb76ef2eba
// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_real_R, hol_typedef_topology)
Theorem CANTOR_BENDIXSON_GEN : forall N:set, N <> Empty -> forall s c= R :^: idx N, exists t u c= R :^: idx N, closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) s) t /\ ((forall x :e R :^: idx N, x :e t -> condensation_point_of N x t) /\ (countable u /\ (t :/\: u = Empty /\ s = t :\/: u))).
Admitted.

// HOL Light: Multivariate/topology.ml:27565 / CANTOR_BENDIXSON
// Source hash: md5:16f69521225e9620e35d92557f0855fa
// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_real_R)
Theorem CANTOR_BENDIXSON : forall N:set, N <> Empty -> forall s c= R :^: idx N, closed N s -> exists t u c= R :^: idx N, closed N t /\ ((forall x :e R :^: idx N, x :e t -> limit_point_of N x t) /\ (countable u /\ (t :/\: u = Empty /\ s = t :\/: u))).
Admitted.

// HOL Light: Multivariate/topology.ml:27577 / DISCRETE_IMP_COUNTABLE
// Source hash: md5:6d4de2f09d853871d8691f8ac836d834
// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem DISCRETE_IMP_COUNTABLE : forall N:set, N <> Empty -> forall s c= R :^: idx N, (forall x :e R :^: idx N, x :e s -> exists e0 :e R, 0 < e0 /\ forall y :e R :^: idx N, y :e s /\ ~ y = x -> e0 <= sqrt_SNo_nonneg (dot N (vector_sub N y x) (vector_sub N y x))) -> countable s.
Admitted.

// HOL Light: Multivariate/topology.ml:27612 / UNCOUNTABLE_CONTAINS_LIMIT_POINT
// Source hash: md5:d800bad1f60b3a6365906938006a0021
// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_real_R)
Theorem UNCOUNTABLE_CONTAINS_LIMIT_POINT : forall A:set, A <> Empty -> forall s c= R :^: idx A, ~ countable s -> exists x :e R :^: idx A, x :e s /\ limit_point_of A x s.
Admitted.

// HOL Light: Multivariate/topology.ml:27623 / EVENTUALLY_WITHIN_RIGHT_ALT_GEN
