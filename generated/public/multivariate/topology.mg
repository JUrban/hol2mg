// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_EQ_COMPONENTS_SING_EXISTS : forall N:set, N <> Empty -> forall s c= R :^: idx N, connected N s <-> s = Empty \/ exists a c= R :^: idx N, components N s = {a}.
Admitted.

