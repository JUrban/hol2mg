// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem BOUNDED_PAIRS_POS : forall N:set, N <> Empty -> forall s c= R :^: idx N, bounded_hl N s <-> exists B :e R, 0 < B /\ forall x y :e R :^: idx N, x :e s /\ y :e s -> distance N (x,y) <= B.
Admitted.

