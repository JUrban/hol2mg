// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem BOUNDED_NEGATIONS : forall A:set, A <> Empty -> forall s c= R :^: idx A, bounded_hl A s -> bounded_hl A {vector_neg A x | x :e s}.
