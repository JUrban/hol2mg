// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_real_R, hol_typedef_topology)
Theorem LOCALLY_OPEN_BASIS : forall N:set, N <> Empty -> forall P:set -> prop, forall s c= R :^: idx N, locally N {u :e Power (R :^: idx N) | u :e subtopology (R :^: idx N) (euclidean N) s /\ P u} s <-> exists b c= Power (R :^: idx N), countable b /\ ((forall c c= R :^: idx N, c :e b -> ~ c = Empty /\ (c :e subtopology (R :^: idx N) (euclidean N) s /\ P c)) /\ forall t c= R :^: idx N, t :e subtopology (R :^: idx N) (euclidean N) s -> exists u c= Power (R :^: idx N), u c= b /\ t = Union u).
Admitted.

