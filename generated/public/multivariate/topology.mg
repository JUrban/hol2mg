Theorem CBALL_SCALING : forall A:set, A <> Empty -> forall c :e R, 0 < c -> forall x :e R :^: idx A, forall r :e R, cball A (vector_mul A c x,c * r) = {vector_mul A c x0 | x0 :e cball A (x,r)}.
