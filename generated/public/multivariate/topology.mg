// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_EQ_COMPONENTS_SUBSET_SING : forall N:set, N <> Empty -> forall s c= R :^: idx N, connected N s <-> components N s c= {s}.
