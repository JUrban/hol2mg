// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_real_R)
Theorem NOWHERE_DENSE_COUNTABLE_UNIONS_CLOSED : forall N:set, N <> Empty -> forall g c= Power (R :^: idx N), countable g /\ (forall s c= R :^: idx N, s :e g -> closed N s /\ interior N s = Empty) -> interior N (Union g) = Empty.
