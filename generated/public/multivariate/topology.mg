// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem BOUNDED_DELETE : forall N:set, N <> Empty -> forall x :e R :^: idx N, forall s c= R :^: idx N, bounded_hl N (s :\: {x}) <-> bounded_hl N s.
