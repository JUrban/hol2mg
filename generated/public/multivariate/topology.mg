// Status: transport_required (bridges: hol_cart_setexp, hol_finite_finite, hol_real_R)
Theorem INTERIOR_FINITE_INTERS : forall N:set, N <> Empty -> forall s c= Power (R :^: idx N), finite s -> interior N {x :e R :^: idx N | forall Y :e s, x :e Y} = {x :e R :^: idx N | forall Y :e {{x0 :e R :^: idx N | x0 :e interior N x} | x :e s}, x :e Y}.
