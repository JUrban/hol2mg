// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, nat_le_SNoLe, omega_Subq_R)
Theorem cauchy_thm : forall N:set, N <> Empty -> forall s:set -> set, (forall x :e omega, s x :e R :^: idx N) -> (cauchy N s <-> forall e0 :e R, 0 < e0 -> exists N0 :e omega, forall m n :e omega, N0 <= m /\ N0 <= n -> distance N (s m,s n) < e0).
Admitted.

