// Status: transport_required (bridges: hol_cart_setexp, hol_finite_finite, hol_real_R)
Theorem FINITE_IMP_NOT_OPEN : forall N:set, N <> Empty -> forall s c= R :^: idx N, finite s /\ ~ s = Empty -> ~ open N s.
Admitted.

