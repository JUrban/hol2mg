// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_real_R)
Theorem EFFECTIVELY_COUNTABLE_CLOPEN_CHAIN_INTERS : forall N:set, N <> Empty -> forall f c= Power (R :^: idx N), (forall s c= R :^: idx N, s :e f -> closed N s \/ open N s) /\ (forall s t c= R :^: idx N, s :e f /\ t :e f -> s c= t \/ t c= s) -> exists f' c= Power (R :^: idx N), countable f' /\ (f' c= f /\ {x :e R :^: idx N | forall Y :e f', x :e Y} = {x :e R :^: idx N | forall Y :e f, x :e Y}).
Admitted.

// HOL Light: Multivariate/topology.ml:30896 / COUNTABLE_DESCENDING_CLOPEN_CHAIN
// Source hash: md5:37fd84ff6e7915be1b33d5ee6bfc3645
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R)
Theorem COUNTABLE_DESCENDING_CLOPEN_CHAIN : forall N:set, N <> Empty -> forall f c= Power (R :^: idx N), ~ f = Empty /\ ((forall s c= R :^: idx N, s :e f -> closed N s \/ open N s) /\ (forall s t c= R :^: idx N, s :e f /\ t :e f -> s c= t \/ t c= s)) -> exists u :e Power (R :^: idx N) :^: omega, (forall n :e omega, u n :e f) /\ ((forall n :e omega, u (ordsucc n) c= u n) /\ {x :e R :^: idx N | forall Y :e {u n | n :e omega, n :e omega}, x :e Y} = {x :e R :^: idx N | forall Y :e f, x :e Y}).
Admitted.

// HOL Light: Multivariate/topology.ml:30907 / FSIGMA_UNIONS_CLOPEN_CHAIN
// Source hash: md5:976e84016efc58d7d7d8f1af52354759
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FSIGMA_UNIONS_CLOPEN_CHAIN : forall N:set, N <> Empty -> forall f c= Power (R :^: idx N), (forall s c= R :^: idx N, s :e f -> closed N s \/ open N s) /\ (forall s t c= R :^: idx N, s :e f /\ t :e f -> s c= t \/ t c= s) -> fsigma N (Union f).
Admitted.

