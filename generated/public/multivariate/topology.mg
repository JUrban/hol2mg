// HOL Light: Multivariate/topology.ml:20805 / POSITIVE_SEMIDEFINITE_COVARIANCE_UNIQUE
// Source hash: md5:ad6808ef762ee100d2a5442efce3d009
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem POSITIVE_SEMIDEFINITE_COVARIANCE_UNIQUE : forall N:set, N <> Empty -> forall A :e R :^: idx N :^: idx N, positive_semidefinite N A <-> exists S :e R :^: idx N :^: idx N, positive_semidefinite N S /\ A = matrix_mul N N N (transp N N S) S /\ forall y :e R :^: idx N :^: idx N, positive_semidefinite N y /\ A = matrix_mul N N N (transp N N y) y -> y = S.
Admitted.

