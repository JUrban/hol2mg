// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, nat_le_SNoLe)
Theorem BOUNDED_CLOSED_NEST : forall N:set, N <> Empty -> forall s :e Power (R :^: idx N) :^: omega, (forall n :e omega, closed N (s n)) /\ ((forall n :e omega, ~ s n = Empty) /\ ((forall m n :e omega, m <= n -> s n c= s m) /\ bounded_hl N (s 0))) -> exists a :e R :^: idx N, forall n :e omega, a :e s n.
Admitted.

