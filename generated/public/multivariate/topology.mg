// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem POSITIVE_DEFINITE_MUL : forall N:set, N <> Empty -> forall A B :e R :^: idx N :^: idx N, positive_definite N A /\ (positive_definite N B /\ matrix_mul N N N A B = matrix_mul N N N B A) -> positive_definite N (matrix_mul N N N A B).
Admitted.

// HOL Light: Multivariate/topology.ml:20950 / COMMUTING_WITH_SQUARE_ROOT_MATRIX
// Source hash: md5:d37ddc058597416db8701733985c754d
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem COMMUTING_WITH_SQUARE_ROOT_MATRIX : forall N:set, N <> Empty -> forall A S B :e R :^: idx N :^: idx N, positive_semidefinite N S /\ (matrix_mul N N N S S = A /\ matrix_mul N N N A B = matrix_mul N N N B A) -> matrix_mul N N N S B = matrix_mul N N N B S.
Admitted.

// HOL Light: Multivariate/topology.ml:21006 / POSITIVE_SEMIDEFINITE_MUL_EIGENVALUES
// Source hash: md5:deedbecb791c8c73f0bf677681b468cb
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem POSITIVE_SEMIDEFINITE_MUL_EIGENVALUES : forall N:set, N <> Empty -> forall A B :e R :^: idx N :^: idx N, positive_semidefinite N A /\ positive_semidefinite N B -> forall c :e R, forall v :e R :^: idx N, matrix_vector_mul N N (matrix_mul N N N A B) v = vector_mul N c v /\ ~ v = vec N 0 -> 0 <= c.
Admitted.

// HOL Light: Multivariate/topology.ml:21024 / POSITIVE_SEMIDEFINITE_2_DET
