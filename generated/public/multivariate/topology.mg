Theorem CLOSURE_UNIONS_SUBSET : forall N:set, N <> Empty -> forall f c= Power (R :^: idx N), Union {closure N s | s :e Power (R :^: idx N), s :e f} c= closure N (Union f).
Admitted.

// HOL Light: Multivariate/topology.ml:2167 / CLOSURE_INTER_SUBSET
// Source hash: md5:46afc0ff23acfaf18d41fd00f655bcda
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSURE_INTER_SUBSET : forall A:set, A <> Empty -> forall s t c= R :^: idx A, closure A (s :/\: t) c= closure A s :/\: closure A t.
Admitted.

// HOL Light: Multivariate/topology.ml:2172 / CLOSURE_INTERS_SUBSET
// Source hash: md5:11097a00e2f80fbe4f40d860bf1facc2
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSURE_INTERS_SUBSET : forall A:set, A <> Empty -> forall f c= Power (R :^: idx A), closure A {x :e R :^: idx A | forall Y :e f, x :e Y} c= {x :e R :^: idx A | forall Y :e {{x0 :e R :^: idx A | x0 :e closure A x} | x :e f}, x :e Y}.
Admitted.

// HOL Light: Multivariate/topology.ml:2178 / CLOSURE_MINIMAL
// Source hash: md5:eb6bbadb157107f83d2402a113ae8357
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSURE_MINIMAL : forall A:set, A <> Empty -> forall s t c= R :^: idx A, s c= t /\ closed A t -> closure A s c= t.
Admitted.

// HOL Light: Multivariate/topology.ml:2182 / CLOSURE_MINIMAL_EQ
// Source hash: md5:9bf2bc631f103ef4c9a42fcf30943a6d
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSURE_MINIMAL_EQ : forall N:set, N <> Empty -> forall s t c= R :^: idx N, closed N t -> (closure N s c= t <-> s c= t).
Admitted.

// HOL Light: Multivariate/topology.ml:2186 / CLOSURE_UNIQUE
// Source hash: md5:c8973c61da8ba7faddd8d1223575aff2
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSURE_UNIQUE : forall A:set, A <> Empty -> forall s t c= R :^: idx A, s c= t /\ (closed A t /\ (forall t' c= R :^: idx A, s c= t' /\ closed A t' -> t c= t')) -> closure A s = t.
Admitted.

// HOL Light: Multivariate/topology.ml:2192 / CLOSURE_EMPTY
// Source hash: md5:f24b9a0543c3e94d337ba1c4a08e1e21
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSURE_EMPTY : forall A:set, A <> Empty -> closure A Empty = Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:2196 / CLOSURE_UNIV
// Source hash: md5:d106cb3e4f9919c06c4985f1efe9aed4
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSURE_UNIV : forall N:set, N <> Empty -> closure N (R :^: idx N) = R :^: idx N.
Admitted.

// HOL Light: Multivariate/topology.ml:2200 / LIMPT_OF_OPEN_CLOSURE
// Source hash: md5:f9b2e1f89262fd82c36a3d047023c799
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem LIMPT_OF_OPEN_CLOSURE : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x :e R :^: idx N, open N s /\ x :e closure N s -> limit_point_of N x s.
Admitted.

// HOL Light: Multivariate/topology.ml:2204 / CLOSURE_UNIONS
// Source hash: md5:21704a30be9dfb00617a7f72cf883dd2
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_finite, hol_real_R)
Theorem CLOSURE_UNIONS : forall A:set, A <> Empty -> forall f c= Power (R :^: idx A), finite f -> closure A (Union f) = Union {closure A s | s :e Power (R :^: idx A), s :e f}.
Admitted.

// HOL Light: Multivariate/topology.ml:2211 / CLOSURE_EQ_EMPTY
// Source hash: md5:a68a9f1a29863d7c1905462a1adf609d
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSURE_EQ_EMPTY : forall A:set, A <> Empty -> forall s c= R :^: idx A, closure A s = Empty <-> s = Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:2217 / CLOSURE_SUBSET_EQ
// Source hash: md5:ba7f84a34c0eaa441baceb694945aef5
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSURE_SUBSET_EQ : forall N:set, N <> Empty -> forall s c= R :^: idx N, closure N s c= s <-> closed N s.
Admitted.

// HOL Light: Multivariate/topology.ml:2222 / OPEN_INTER_CLOSURE_EQ_EMPTY
// Source hash: md5:3f8383c584f34ef7730413b18f35a84e
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem OPEN_INTER_CLOSURE_EQ_EMPTY : forall N:set, N <> Empty -> forall s t c= R :^: idx N, open N s -> (s :/\: closure N t = Empty <-> s :/\: t = Empty).
Admitted.

// HOL Light: Multivariate/topology.ml:2228 / CLOSURE_MINIMAL_LOCAL
// Source hash: md5:2eb2ce352af703d6ef62ca28135bf5a1
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CLOSURE_MINIMAL_LOCAL : forall N:set, N <> Empty -> forall s t u c= R :^: idx N, closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) s) u /\ t c= u -> s :/\: closure N t c= u.
Admitted.

// HOL Light: Multivariate/topology.ml:2238 / CLOSURE_OPEN_IN_INTER_CLOSURE
// Source hash: md5:e0b1840623afc0801602dffda922b43d
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CLOSURE_OPEN_IN_INTER_CLOSURE : forall N:set, N <> Empty -> forall s t u c= R :^: idx N, s :e subtopology (R :^: idx N) (euclidean N) u /\ t c= u -> closure N (s :/\: closure N t) = closure N (s :/\: t).
Admitted.

// HOL Light: Multivariate/topology.ml:2245 / OPEN_IN_INTER_CLOSURE_EQ_EMPTY
// Source hash: md5:b0e9bcf2b3eb03a8c2f33154a797256d
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem OPEN_IN_INTER_CLOSURE_EQ_EMPTY : forall N:set, N <> Empty -> forall u s t c= R :^: idx N, s :e subtopology (R :^: idx N) (euclidean N) u /\ t c= u -> (s :/\: closure N t = Empty <-> s :/\: t = Empty).
Admitted.

// HOL Light: Multivariate/topology.ml:2251 / CLOSURE_OPEN_INTER_CLOSURE
// Source hash: md5:3d4da63bfd21bc706962b7a6c962d6c1
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSURE_OPEN_INTER_CLOSURE : forall N:set, N <> Empty -> forall s t c= R :^: idx N, open N s -> closure N (s :/\: closure N t) = closure N (s :/\: t).
Admitted.

// HOL Light: Multivariate/topology.ml:2258 / OPEN_INTER_CLOSURE_SUBSET
// Source hash: md5:e2685a047e1842761a828571bd678583
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem OPEN_INTER_CLOSURE_SUBSET : forall N:set, N <> Empty -> forall s t c= R :^: idx N, open N s -> s :/\: closure N t c= closure N (s :/\: t).
Admitted.

// HOL Light: Multivariate/topology.ml:2263 / OPEN_INTER_CLOSURE_EQ
// Source hash: md5:0ed7207b3c292af6abc167ae43c43087
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem OPEN_INTER_CLOSURE_EQ : forall N:set, N <> Empty -> forall s t c= R :^: idx N, open N s -> s :/\: closure N t = s :/\: closure N (s :/\: t).
Admitted.

// HOL Light: Multivariate/topology.ml:2269 / CLOSURE_OPEN_INTER_SUPERSET
// Source hash: md5:8eaf5d4d28d4d1da56b7b0b3a444c907
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSURE_OPEN_INTER_SUPERSET : forall N:set, N <> Empty -> forall s t c= R :^: idx N, open N s /\ s c= closure N t -> closure N (s :/\: t) = closure N s.
Admitted.

// HOL Light: Multivariate/topology.ml:2275 / CLOSURE_COMPLEMENT
// Source hash: md5:7eecb9d850ab972a1858149191603de4
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSURE_COMPLEMENT : forall N:set, N <> Empty -> forall s c= R :^: idx N, closure N ((R :^: idx N) :\: s) = (R :^: idx N) :\: interior N s.
Admitted.

// HOL Light: Multivariate/topology.ml:2280 / INTERIOR_COMPLEMENT
// Source hash: md5:89085e3bd166182cf9ab138107a46c5c
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem INTERIOR_COMPLEMENT : forall N:set, N <> Empty -> forall s c= R :^: idx N, interior N ((R :^: idx N) :\: s) = (R :^: idx N) :\: closure N s.
Admitted.

// HOL Light: Multivariate/topology.ml:2285 / CLOSURE_LOCALLY_FINITE_UNIONS
// Source hash: md5:526d5625b51941e2c247a5e0ebb6e79f
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CLOSURE_LOCALLY_FINITE_UNIONS : forall N:set, N <> Empty -> forall f c= Power (R :^: idx N), locally_finite_in (R :^: idx N) (euclidean N) f -> closure N (Union f) = Union {closure N s | s :e Power (R :^: idx N), s :e f}.
Admitted.

// HOL Light: Multivariate/topology.ml:2291 / CONNECTED_INTERMEDIATE_CLOSURE
// Source hash: md5:75c8ee684a8f177e54fa203be614a697
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_INTERMEDIATE_CLOSURE : forall N:set, N <> Empty -> forall s t c= R :^: idx N, connected N s /\ (s c= t /\ t c= closure N s) -> connected N t.
Admitted.

// HOL Light: Multivariate/topology.ml:2297 / CONNECTED_CLOSURE
// Source hash: md5:4a278e176d753ab6179d8805154b1035
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_CLOSURE : forall N:set, N <> Empty -> forall s c= R :^: idx N, connected N s -> connected N (closure N s).
Admitted.

// HOL Light: Multivariate/topology.ml:2301 / CONNECTED_UNION_STRONG
// Source hash: md5:291f65dd305f04e46bf277dce1dc9ce9
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_UNION_STRONG : forall N:set, N <> Empty -> forall s t c= R :^: idx N, connected N s /\ (connected N t /\ ~ closure N s :/\: t = Empty) -> connected N (s :\/: t).
Admitted.

// HOL Light: Multivariate/topology.ml:2309 / CONNECTED_INSERT
// Source hash: md5:6c9fc0489b0c6565e8a8b6c699cc6138
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_INSERT : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall a :e R :^: idx N, connected N s -> (connected N (SetAdjoin s a) <-> s = Empty \/ a :e closure N s).
Admitted.

// HOL Light: Multivariate/topology.ml:2324 / CONNECTED_INSERT_LIMPT
// Source hash: md5:368b197c7a95351d63ea5e392840e648
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_INSERT_LIMPT : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall a :e R :^: idx N, connected N s /\ limit_point_of N a s -> connected N (SetAdjoin s a).
Admitted.

// HOL Light: Multivariate/topology.ml:2328 / INTERIOR_DIFF
// Source hash: md5:a52539ba3b7489dc4e1f527fee747d48
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem INTERIOR_DIFF : forall A:set, A <> Empty -> forall s t c= R :^: idx A, interior A (s :\: t) = interior A s :\: closure A t.
Admitted.

// HOL Light: Multivariate/topology.ml:2333 / LIMPT_OF_CLOSURE
// Source hash: md5:c41438a35ba62235175530e27614c4e6
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem LIMPT_OF_CLOSURE : forall N:set, N <> Empty -> forall x :e R :^: idx N, forall s c= R :^: idx N, limit_point_of N x (closure N s) <-> limit_point_of N x s.
Admitted.

// HOL Light: Multivariate/topology.ml:2339 / PERFECT_FROM_CLOSURE
// Source hash: md5:1ee949c199aa168e755729eac0874c0a
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem PERFECT_FROM_CLOSURE : forall N:set, N <> Empty -> forall s c= R :^: idx N, (forall x :e R :^: idx N, x :e closure N s -> limit_point_of N x (closure N s)) -> forall x :e R :^: idx N, x :e s -> limit_point_of N x s.
Admitted.

// HOL Light: Multivariate/topology.ml:2346 / DENSE_IMP_PERFECT
// Source hash: md5:d19fde89e21c9a8bcf2a4817bfc34fe0
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem DENSE_IMP_PERFECT : forall N:set, N <> Empty -> forall s c= R :^: idx N, closure N s = R :^: idx N -> forall x :e R :^: idx N, x :e s -> limit_point_of N x s.
Admitted.

// HOL Light: Multivariate/topology.ml:2351 / CLOSED_IN_LIMPT
// Source hash: md5:b873598c3d54fdd5e97e6f70fbf0aa89
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CLOSED_IN_LIMPT : forall N:set, N <> Empty -> forall s t c= R :^: idx N, closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) t) s <-> s c= t /\ forall x :e R :^: idx N, limit_point_of N x s /\ x :e t -> x :e s.
Admitted.

// HOL Light: Multivariate/topology.ml:2357 / CLOSED_IN_INTER_CLOSURE
// Source hash: md5:f9216ee4745c00922a8e9f02fbe05f6b
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CLOSED_IN_INTER_CLOSURE : forall N:set, N <> Empty -> forall s t c= R :^: idx N, closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) s) t <-> s :/\: closure N t = t.
Admitted.

// HOL Light: Multivariate/topology.ml:2362 / INTERIOR_CLOSURE_IDEMP
// Source hash: md5:e19bdbfac820204a027c968b1c235aec
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem INTERIOR_CLOSURE_IDEMP : forall N:set, N <> Empty -> forall s c= R :^: idx N, interior N (closure N (interior N (closure N s))) = interior N (closure N s).
Admitted.

// HOL Light: Multivariate/topology.ml:2368 / CLOSURE_INTERIOR_IDEMP
// Source hash: md5:0c670617007b785030ebbca5066944dd
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSURE_INTERIOR_IDEMP : forall N:set, N <> Empty -> forall s c= R :^: idx N, closure N (interior N (closure N (interior N s))) = closure N (interior N s).
Admitted.

// HOL Light: Multivariate/topology.ml:2374 / NOWHERE_DENSE_UNION
// Source hash: md5:234fcf5f63690a3b4a3bf09ebf6616de
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem NOWHERE_DENSE_UNION : forall N:set, N <> Empty -> forall s t c= R :^: idx N, interior N (closure N (s :\/: t)) = Empty <-> interior N (closure N s) = Empty /\ interior N (closure N t) = Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:2380 / NOWHERE_DENSE
// Source hash: md5:e3c89b9eb6aaf2118365523e7c519b1d
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem NOWHERE_DENSE : forall N:set, N <> Empty -> forall s c= R :^: idx N, interior N (closure N s) = Empty <-> forall t c= R :^: idx N, open N t /\ ~ t = Empty -> exists u c= R :^: idx N, open N u /\ (~ u = Empty /\ (u c= t /\ u :/\: s = Empty)).
Admitted.

// HOL Light: Multivariate/topology.ml:2396 / INTERIOR_CLOSURE_INTER_OPEN
// Source hash: md5:fe9c13b86debbdadf3f2db8c67895538
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem INTERIOR_CLOSURE_INTER_OPEN : forall N:set, N <> Empty -> forall s t c= R :^: idx N, open N s /\ open N t -> interior N (closure N (s :/\: t)) = interior N (closure N s) :/\: interior N (closure N t).
Admitted.

// HOL Light: Multivariate/topology.ml:2416 / CLOSURE_INTERIOR_UNION_CLOSED
// Source hash: md5:daf39594a37960384b97ba372e2ba02f
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSURE_INTERIOR_UNION_CLOSED : forall N:set, N <> Empty -> forall s t c= R :^: idx N, closed N s /\ closed N t -> closure N (interior N (s :\/: t)) = closure N (interior N s) :\/: closure N (interior N t).
Admitted.

// HOL Light: Multivariate/topology.ml:2428 / REGULAR_OPEN_INTER
// Source hash: md5:61ca464158f23b2086bdef1898afae3c
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem REGULAR_OPEN_INTER : forall N:set, N <> Empty -> forall s t c= R :^: idx N, interior N (closure N s) = s /\ interior N (closure N t) = t -> interior N (closure N (s :/\: t)) = s :/\: t.
Admitted.

// HOL Light: Multivariate/topology.ml:2434 / REGULAR_CLOSED_UNION
// Source hash: md5:135fcd23eb5bc170a08f17f7f33a9033
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem REGULAR_CLOSED_UNION : forall N:set, N <> Empty -> forall s t c= R :^: idx N, closure N (interior N s) = s /\ closure N (interior N t) = t -> closure N (interior N (s :\/: t)) = s :\/: t.
Admitted.

// HOL Light: Multivariate/topology.ml:2440 / REGULAR_CLOSED_UNIONS
// Source hash: md5:d8d68c995f880d3ceec25bc52fab4b00
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_finite, hol_real_R)
Theorem REGULAR_CLOSED_UNIONS : forall N:set, N <> Empty -> forall f c= Power (R :^: idx N), finite f /\ (forall t c= R :^: idx N, t :e f -> closure N (interior N t) = t) -> closure N (interior N (Union f)) = Union f.
Admitted.

// HOL Light: Multivariate/topology.ml:2449 / DIFF_CLOSURE_SUBSET
// Source hash: md5:f9db9d4d0d665ff071c897dafa73685a
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem DIFF_CLOSURE_SUBSET : forall N:set, N <> Empty -> forall s t c= R :^: idx N, closure N s :\: closure N t c= closure N (s :\: t).
Admitted.

// HOL Light: Multivariate/topology.ml:2461 / DENSE_OPEN_INTER
// Source hash: md5:2fdf64d087562c17415a7c8a3881e82a
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem DENSE_OPEN_INTER : forall N:set, N <> Empty -> forall s t u c= R :^: idx N, s :e subtopology (R :^: idx N) (euclidean N) u /\ t c= u \/ t :e subtopology (R :^: idx N) (euclidean N) u /\ s c= u -> (u c= closure N (s :/\: t) <-> u c= closure N s /\ u c= closure N t).
Admitted.

// HOL Light: Multivariate/topology.ml:2494 / DENSE_OPEN_INTERS
// Source hash: md5:9981d0b8801132f766f5eac2f4477fce
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_finite, hol_real_R, hol_typedef_topology)
Theorem DENSE_OPEN_INTERS : forall N:set, N <> Empty -> forall g c= Power (R :^: idx N), forall s c= R :^: idx N, finite g /\ (forall t c= R :^: idx N, t :e g -> t :e subtopology (R :^: idx N) (euclidean N) s /\ s c= closure N t) -> s c= closure N {x :e R :^: idx N | forall Y :e g, x :e Y}.
Admitted.

// HOL Light: Multivariate/topology.ml:2517 / SEPARATION_CLOSED_IN_UNION
// Source hash: md5:17ae725eb8455437d992e92da4512d3b
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem SEPARATION_CLOSED_IN_UNION : forall N:set, N <> Empty -> forall s t c= R :^: idx N, s :/\: closure N t = Empty /\ t :/\: closure N s = Empty <-> s :/\: t = Empty /\ (closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) (s :\/: t)) s /\ closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) (s :\/: t)) t).
Admitted.

// HOL Light: Multivariate/topology.ml:2529 / SEPARATION_OPEN_IN_UNION
// Source hash: md5:2f538cfab24f818db8b12824b01b4539
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem SEPARATION_OPEN_IN_UNION : forall N:set, N <> Empty -> forall s t c= R :^: idx N, s :/\: closure N t = Empty /\ t :/\: closure N s = Empty <-> s :/\: t = Empty /\ (s :e subtopology (R :^: idx N) (euclidean N) (s :\/: t) /\ t :e subtopology (R :^: idx N) (euclidean N) (s :\/: t)).
Admitted.

// HOL Light: Multivariate/topology.ml:2541 / CONNECTED_SEPARATION
// Source hash: md5:52b9612807512cd03cd96f295036f123
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_SEPARATION : forall N:set, N <> Empty -> forall s c= R :^: idx N, connected N s <-> ~ exists c1 c2 c= R :^: idx N, c1 :\/: c2 = s /\ (~ c1 = Empty /\ (~ c2 = Empty /\ (c1 :/\: closure N c2 = Empty /\ c2 :/\: closure N c1 = Empty))).
Admitted.

// HOL Light: Multivariate/topology.ml:2541 / CONNECTED_SEPARATION_ALT
// Source hash: md5:9070d3b5c190ab0cb82322f5de0031df
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_SEPARATION_ALT : forall N:set, N <> Empty -> forall s c= R :^: idx N, connected N s <-> ~ exists c1 c2 c= R :^: idx N, s c= c1 :\/: c2 /\ (~ c1 :/\: s = Empty /\ (~ c2 :/\: s = Empty /\ (c1 :/\: closure N c2 = Empty /\ c2 :/\: closure N c1 = Empty))).
Admitted.

// HOL Light: Multivariate/topology.ml:2560 / frontier
// Source hash: md5:c51afb5a36eb29e8e8d8f93d029710c9
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem frontier_thm : forall A:set, A <> Empty -> forall s c= R :^: idx A, frontier A s = closure A s :\: interior A s.
Admitted.

// HOL Light: Multivariate/topology.ml:2563 / EUCLIDEAN_FRONTIER_OF
// Source hash: md5:5b5be2c1ac372e8e068558726d945dea
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem EUCLIDEAN_FRONTIER_OF : forall N:set, N <> Empty -> forall s c= R :^: idx N, frontier_of (R :^: idx N) (euclidean N) s = frontier N s.
Admitted.

// HOL Light: Multivariate/topology.ml:2568 / FRONTIER_CLOSED
// Source hash: md5:7313f5ba69fcddd2e7e30f889b1d25e0
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FRONTIER_CLOSED : forall A:set, A <> Empty -> forall s c= R :^: idx A, closed A (frontier A s).
Admitted.

// HOL Light: Multivariate/topology.ml:2572 / FRONTIER_CLOSURES
// Source hash: md5:221b08d16c62906b6e52819e61750d75
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FRONTIER_CLOSURES : forall N:set, N <> Empty -> forall s c= R :^: idx N, frontier N s = closure N s :/\: closure N ((R :^: idx N) :\: s).
Admitted.

// HOL Light: Multivariate/topology.ml:2577 / FRONTIER_OPEN_STRADDLE_INTER
// Source hash: md5:2215e3e55604fea961cd20f637afd620
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FRONTIER_OPEN_STRADDLE_INTER : forall N:set, N <> Empty -> forall s u c= R :^: idx N, open N u /\ ~ u :/\: frontier N s = Empty -> ~ u :/\: s = Empty /\ ~ u :\: s = Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:2588 / FRONTIER_UNION_INTERIOR
// Source hash: md5:cbddfc443324bc09bd1ad1154a6046cf
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FRONTIER_UNION_INTERIOR : forall N:set, N <> Empty -> forall s c= R :^: idx N, frontier N s :\/: interior N s = closure N s.
Admitted.

// HOL Light: Multivariate/topology.ml:2595 / FRONTIER_STRADDLE
// Source hash: md5:a31a4d5509267f81bc90e8597d66cf84
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem FRONTIER_STRADDLE : forall N:set, N <> Empty -> forall a :e R :^: idx N, forall s c= R :^: idx N, a :e frontier N s <-> forall e0 :e R, 0 < e0 -> (exists x :e R :^: idx N, x :e s /\ distance N (a,x) < e0) /\ exists x :e R :^: idx N, ~ x :e s /\ distance N (a,x) < e0.
Admitted.

// HOL Light: Multivariate/topology.ml:2606 / FRONTIER_SUBSET_CLOSED
// Source hash: md5:eb7dc83be4efee910c5ebe79f2d78c26
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FRONTIER_SUBSET_CLOSED : forall A:set, A <> Empty -> forall s c= R :^: idx A, closed A s -> frontier A s c= s.
Admitted.

// HOL Light: Multivariate/topology.ml:2610 / FRONTIER_EMPTY
// Source hash: md5:c430484cd8221b7b3b720d409eac5597
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FRONTIER_EMPTY : forall A:set, A <> Empty -> frontier A Empty = Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:2614 / FRONTIER_UNIV
// Source hash: md5:ef31c46dce34c7bc427960e7c99762a5
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FRONTIER_UNIV : forall N:set, N <> Empty -> frontier N (R :^: idx N) = Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:2618 / FRONTIER_SUBSET_EQ
// Source hash: md5:090db555f37fb2148b9805ae412a9e14
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FRONTIER_SUBSET_EQ : forall N:set, N <> Empty -> forall s c= R :^: idx N, frontier N s c= s <-> closed N s.
Admitted.

// HOL Light: Multivariate/topology.ml:2626 / FRONTIER_COMPLEMENT
// Source hash: md5:dd1f91d1c52d55d4102a2f7e750d23a2
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FRONTIER_COMPLEMENT : forall N:set, N <> Empty -> forall s c= R :^: idx N, frontier N ((R :^: idx N) :\: s) = frontier N s.
Admitted.

// HOL Light: Multivariate/topology.ml:2631 / FRONTIER_DISJOINT_EQ
// Source hash: md5:59d9f2feac6c26f046f4f63997912b84
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FRONTIER_DISJOINT_EQ : forall A:set, A <> Empty -> forall s c= R :^: idx A, frontier A s :/\: s = Empty <-> open A s.
Admitted.

// HOL Light: Multivariate/topology.ml:2636 / FRONTIER_INTER
// Source hash: md5:9a1a1406389168086d010101245e125e
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FRONTIER_INTER : forall N:set, N <> Empty -> forall s t c= R :^: idx N, frontier N (s :/\: t) = closure N (s :/\: t) :/\: (frontier N s :\/: frontier N t).
Admitted.

// HOL Light: Multivariate/topology.ml:2646 / FRONTIER_INTER_SUBSET
// Source hash: md5:1ff3cb561428a91405e39087eda930fa
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FRONTIER_INTER_SUBSET : forall A:set, A <> Empty -> forall s t c= R :^: idx A, frontier A (s :/\: t) c= frontier A s :\/: frontier A t.
Admitted.

// HOL Light: Multivariate/topology.ml:2650 / FRONTIER_INTER_CLOSED
// Source hash: md5:0965808a769818fdd2cd19a8aba2dd24
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FRONTIER_INTER_CLOSED : forall N:set, N <> Empty -> forall s t c= R :^: idx N, closed N s /\ closed N t -> frontier N (s :/\: t) = frontier N s :/\: t :\/: s :/\: frontier N t.
Admitted.

// HOL Light: Multivariate/topology.ml:2657 / FRONTIER_UNION_SUBSET
// Source hash: md5:cae61dea1398b998245731202cc74a3c
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FRONTIER_UNION_SUBSET : forall N:set, N <> Empty -> forall s t c= R :^: idx N, frontier N (s :\/: t) c= frontier N s :\/: frontier N t.
Admitted.

// HOL Light: Multivariate/topology.ml:2663 / FRONTIER_INTERIORS
// Source hash: md5:6711585fee7bccd86fa2758f8482c02a
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FRONTIER_INTERIORS : forall N:set, N <> Empty -> forall s c= R :^: idx N, frontier N s = ((R :^: idx N) :\: interior N s) :\: interior N ((R :^: idx N) :\: s).
Admitted.

// HOL Light: Multivariate/topology.ml:2667 / FRONTIER_FRONTIER_SUBSET
// Source hash: md5:4dd431186e88878956939ca93b71560a
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FRONTIER_FRONTIER_SUBSET : forall N:set, N <> Empty -> forall s c= R :^: idx N, frontier N (frontier N s) c= frontier N s.
Admitted.

// HOL Light: Multivariate/topology.ml:2672 / INTERIOR_FRONTIER
// Source hash: md5:8d9e7ca89e3e33bcf35bd71ef3a0b5f6
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem INTERIOR_FRONTIER : forall N:set, N <> Empty -> forall s c= R :^: idx N, interior N (frontier N s) = interior N (closure N s) :\: closure N (interior N s).
Admitted.

// HOL Light: Multivariate/topology.ml:2678 / THIN_FRONTIER_SUBSET
// Source hash: md5:83d5b9bef4fe99319cc57b17883597f7
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem THIN_FRONTIER_SUBSET : forall N:set, N <> Empty -> forall s c= R :^: idx N, interior N (frontier N s) = Empty <-> interior N (closure N s) c= closure N (interior N s).
Admitted.

// HOL Light: Multivariate/topology.ml:2684 / THIN_FRONTIER_CIC
// Source hash: md5:fcd09ca608f870496bf60584361bf383
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem THIN_FRONTIER_CIC : forall N:set, N <> Empty -> forall s c= R :^: idx N, interior N (frontier N s) = Empty <-> closure N (interior N (closure N s)) = closure N (interior N s).
Admitted.

// HOL Light: Multivariate/topology.ml:2691 / THIN_FRONTIER_ICI
// Source hash: md5:8437ae81c2771c531d8d895f937de22f
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem THIN_FRONTIER_ICI : forall N:set, N <> Empty -> forall s c= R :^: idx N, interior N (frontier N s) = Empty <-> interior N (closure N (interior N s)) = interior N (closure N s).
Admitted.

// HOL Light: Multivariate/topology.ml:2698 / INTERIOR_FRONTIER_EMPTY
// Source hash: md5:d36719f02903ad15832ca50e95b549af
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem INTERIOR_FRONTIER_EMPTY : forall N:set, N <> Empty -> forall s c= R :^: idx N, open N s \/ closed N s -> interior N (frontier N s) = Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:2703 / FRONTIER_FRONTIER
// Source hash: md5:7f5e271b2f81b251685a0f0ef91a81d5
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FRONTIER_FRONTIER : forall N:set, N <> Empty -> forall s c= R :^: idx N, open N s \/ closed N s -> frontier N (frontier N s) = frontier N s.
Admitted.

// HOL Light: Multivariate/topology.ml:2708 / FRONTIER_FRONTIER_FRONTIER
// Source hash: md5:63414457fad46f1132bb48f16cdf4476
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FRONTIER_FRONTIER_FRONTIER : forall N:set, N <> Empty -> forall s c= R :^: idx N, frontier N (frontier N (frontier N s)) = frontier N (frontier N s).
Admitted.

// HOL Light: Multivariate/topology.ml:2712 / REGULAR_CLOSURE_INTERIOR
// Source hash: md5:f0e4fa0f940c5a1caccec77217cf8cc7
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem REGULAR_CLOSURE_INTERIOR : forall N:set, N <> Empty -> forall s c= R :^: idx N, s c= closure N (interior N s) <-> closure N (interior N s) = closure N s.
Admitted.

// HOL Light: Multivariate/topology.ml:2719 / REGULAR_INTERIOR_CLOSURE
// Source hash: md5:f3c1e9b35a6bf041dda811846cffddf0
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem REGULAR_INTERIOR_CLOSURE : forall N:set, N <> Empty -> forall s c= R :^: idx N, interior N (closure N s) c= s <-> interior N (closure N s) = interior N s.
Admitted.

// HOL Light: Multivariate/topology.ml:2726 / REGULAR_CLOSED
// Source hash: md5:56b236305d957b69437c1f094640e4b6
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem REGULAR_CLOSED : forall N:set, N <> Empty -> forall s c= R :^: idx N, closure N (interior N s) = s <-> closed N s /\ s c= closure N (interior N s).
Admitted.

// HOL Light: Multivariate/topology.ml:2733 / REGULAR_OPEN
// Source hash: md5:82162bf1cd0039fe1f9fdd7f2bc179f3
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem REGULAR_OPEN : forall N:set, N <> Empty -> forall s c= R :^: idx N, interior N (closure N s) = s <-> open N s /\ interior N (closure N s) c= s.
Admitted.

// HOL Light: Multivariate/topology.ml:2740 / REGULAR_CLOSURE_IMP_THIN_FRONTIER
// Source hash: md5:bde41da74dc37a2e8e05df5b6fa5cec9
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem REGULAR_CLOSURE_IMP_THIN_FRONTIER : forall N:set, N <> Empty -> forall s c= R :^: idx N, s c= closure N (interior N s) -> interior N (frontier N s) = Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:2745 / REGULAR_INTERIOR_IMP_THIN_FRONTIER
// Source hash: md5:6a88661060d0f7da0a3713c226349e11
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem REGULAR_INTERIOR_IMP_THIN_FRONTIER : forall N:set, N <> Empty -> forall s c= R :^: idx N, interior N (closure N s) c= s -> interior N (frontier N s) = Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:2750 / UNION_FRONTIER
// Source hash: md5:2c26242d580a779b76395da3ddcd014b
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem UNION_FRONTIER : forall N:set, N <> Empty -> forall s t c= R :^: idx N, frontier N s :\/: frontier N t = frontier N (s :\/: t) :\/: (frontier N (s :/\: t) :\/: frontier N s :/\: frontier N t).
Admitted.

// HOL Light: Multivariate/topology.ml:2782 / CONNECTED_INTER_FRONTIER
// Source hash: md5:6625ba757f749314802cf623bf3298f2
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_INTER_FRONTIER : forall N:set, N <> Empty -> forall s t c= R :^: idx N, connected N s /\ (~ s :/\: t = Empty /\ ~ s :\: t = Empty) -> ~ s :/\: frontier N t = Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:2789 / FRONTIER_NOT_EMPTY
// Source hash: md5:60c7ab36ae69a82e57fc6a59074c2dd6
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FRONTIER_NOT_EMPTY : forall N:set, N <> Empty -> forall s c= R :^: idx N, ~ s = Empty /\ ~ s = R :^: idx N -> ~ frontier N s = Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:2795 / FRONTIER_EQ_EMPTY
// Source hash: md5:ff9caddbb4860d1a5744100a24b2bd65
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FRONTIER_EQ_EMPTY : forall N:set, N <> Empty -> forall s c= R :^: idx N, frontier N s = Empty <-> s = Empty \/ s = R :^: idx N.
Admitted.

// HOL Light: Multivariate/topology.ml:2799 / INTERIOR_CLOSED_EQ_EMPTY_AS_FRONTIER
// Source hash: md5:e166abb196a3680f6be2350fab710988
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem INTERIOR_CLOSED_EQ_EMPTY_AS_FRONTIER : forall N:set, N <> Empty -> forall s c= R :^: idx N, closed N s /\ interior N s = Empty <-> exists t c= R :^: idx N, open N t /\ s = frontier N t.
Admitted.

// HOL Light: Multivariate/topology.ml:2808 / FRONTIER_UNION
// Source hash: md5:d135ddf4ce0ead0ab9ff84fadc73fdbf
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FRONTIER_UNION : forall N:set, N <> Empty -> forall s t c= R :^: idx N, closure N s :/\: closure N t = Empty -> frontier N (s :\/: t) = frontier N s :\/: frontier N t.
Admitted.

// HOL Light: Multivariate/topology.ml:2833 / CLOSURE_UNION_FRONTIER
// Source hash: md5:0b693b96e3cf8646cd4be0e5114a694f
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSURE_UNION_FRONTIER : forall N:set, N <> Empty -> forall s c= R :^: idx N, closure N s = s :\/: frontier N s.
Admitted.

// HOL Light: Multivariate/topology.ml:2840 / FRONTIER_INTERIOR_SUBSET
// Source hash: md5:c28f599ac66b5f60cdcfbe86a18778ff
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FRONTIER_INTERIOR_SUBSET : forall N:set, N <> Empty -> forall s c= R :^: idx N, frontier N (interior N s) c= frontier N s.
Admitted.

// HOL Light: Multivariate/topology.ml:2846 / FRONTIER_CLOSURE_SUBSET
// Source hash: md5:8b16aac51078024a4b40c058571f8821
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FRONTIER_CLOSURE_SUBSET : forall N:set, N <> Empty -> forall s c= R :^: idx N, frontier N (closure N s) c= frontier N s.
Admitted.

// HOL Light: Multivariate/topology.ml:2852 / SET_DIFF_FRONTIER
// Source hash: md5:2ea6b4f3658ab77cc47ef32e38a5d6ff
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem SET_DIFF_FRONTIER : forall N:set, N <> Empty -> forall s c= R :^: idx N, s :\: frontier N s = interior N s.
Admitted.

// HOL Light: Multivariate/topology.ml:2859 / FRONTIER_INTER_SUBSET_INTER
// Source hash: md5:d35d7b058e5b39ea67864cfff64dfece
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FRONTIER_INTER_SUBSET_INTER : forall N:set, N <> Empty -> forall s t c= R :^: idx N, frontier N (s :/\: t) c= closure N s :/\: frontier N t :\/: frontier N s :/\: closure N t.
Admitted.

// HOL Light: Multivariate/topology.ml:2868 / COMMON_FRONTIER_DOMAINS
// Source hash: md5:697a0089a8b033c900e4e516bd9cb307
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem COMMON_FRONTIER_DOMAINS : forall N:set, N <> Empty -> forall s t c= R :^: idx N, open N s /\ (open N t /\ (connected N s /\ (connected N t /\ frontier N s = frontier N t))) -> s = t \/ s :/\: t = Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:2884 / FRONTIER_OPEN_UNION
// Source hash: md5:c8eea66d1b0f832df3ec01dc85311024
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FRONTIER_OPEN_UNION : forall N:set, N <> Empty -> forall s t c= R :^: idx N, open N s /\ (open N t /\ s :/\: t = Empty) -> frontier N (s :\/: t) = frontier N s :\/: frontier N t.
Admitted.

// HOL Light: Multivariate/topology.ml:2897 / FRONTIER_OPEN_UNIONS
// Source hash: md5:e69c4593fb2214c7abbd65807908c21d
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_finite, hol_real_R)
Theorem FRONTIER_OPEN_UNIONS : forall N:set, N <> Empty -> forall f c= Power (R :^: idx N), finite f /\ ((forall s c= R :^: idx N, s :e f -> open N s) /\ (forall x y :e f, x <> y -> x :/\: y = Empty)) -> frontier N (Union f) = Union {frontier N s | s :e Power (R :^: idx N), s :e f}.
Admitted.

// HOL Light: Multivariate/topology.ml:2913 / CONNECTED_CLOSURE_FROM_FRONTIER
// Source hash: md5:c9985b0c8954aabed39cf908ec17f889
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_CLOSURE_FROM_FRONTIER : forall N:set, N <> Empty -> forall s c= R :^: idx N, connected N (frontier N s) -> connected N (closure N s).
Admitted.

// HOL Light: Multivariate/topology.ml:2933 / at
// Source hash: md5:878631671c5d6a27fa1b5669e6e02f30
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_net, hol_typedef_topology)
Theorem at_thm : forall A:set, A <> Empty -> forall a :e R :^: idx A, at A a = atpointof (R :^: idx A) (euclidean A) a.
Admitted.

// HOL Light: Multivariate/topology.ml:2936 / at_infinity
// Source hash: md5:58bfc4359e441fe3cb2cd078ccd52bc1
// Status: generalization_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R, hol_typedef_net)
Theorem at_infinity_thm : forall A:set, A <> Empty -> at_infinity A = ({{x :e R :^: idx A | b <= sqrt_SNo_nonneg (dot A x x)} | b :e R, b :e R},Empty).
Admitted.

// HOL Light: Multivariate/topology.ml:2939 / at_posinfinity
// Source hash: md5:2dd9f95370391934336e6e0fa52b5a69
// Status: generalization_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_net)
Theorem at_posinfinity_thm : at_posinfinity = ({{x :e R | a <= x} | a :e R, a :e R},Empty).
Admitted.

// HOL Light: Multivariate/topology.ml:2942 / at_neginfinity
// Source hash: md5:03432f45e8a2fc456f1dbd33c4a02874
// Status: generalization_required (bridges: hol_prod_setprod, hol_real_R, hol_typedef_net)
Theorem at_neginfinity_thm : at_neginfinity = ({{x :e R | x <= a} | a :e R, a :e R},Empty).
Admitted.

// HOL Light: Multivariate/topology.ml:2945 / in_direction
// Source hash: md5:b4ed8e6c39aabe8068f1af0985cd75ca
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, hol_typedef_net, omega_Subq_R)
Theorem in_direction_thm : forall A:set, A <> Empty -> forall a v :e R :^: idx A, in_direction A a v = within (R :^: idx A) (at A a) {b :e R :^: idx A | exists c :e R, 0 <= c /\ vector_sub A b a = vector_mul A c v}.
Admitted.

// HOL Light: Multivariate/topology.ml:2948 / AT
// Source hash: md5:7248d08a11269af6c6dc85ffce2e1816
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_net)
Theorem AT : forall N:set, N <> Empty -> forall a :e R :^: idx N, netfilter (R :^: idx N) (at N a) = {u :e Power (R :^: idx N) | open N u /\ a :e u}.
Admitted.

// HOL Light: Multivariate/topology.ml:2953 / NETLIMIT_AT
// Source hash: md5:aa1c969a921e4c63f399019e9f2721a8
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_net)
Theorem NETLIMIT_AT : forall A:set, A <> Empty -> forall a :e R :^: idx A, netlimit (R :^: idx A) (at A a) = a.
Admitted.

// HOL Light: Multivariate/topology.ml:2957 / NETLIMIT_WITHIN
// Source hash: md5:3a266b639875d09ef7dc6a957d8ec972
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_net)
Theorem NETLIMIT_WITHIN : forall N:set, N <> Empty -> forall a :e R :^: idx N, forall s c= R :^: idx N, netlimit (R :^: idx N) (within (R :^: idx N) (at N a) s) = a.
Admitted.

// HOL Light: Multivariate/topology.ml:2962 / AT_INFINITY
// Source hash: md5:c5a1ed52668af857b9d601daf7f318ea
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_net)
Theorem AT_INFINITY : forall N:set, N <> Empty -> netfilter (R :^: idx N) (at_infinity N) = {{x :e R :^: idx N | b <= sqrt_SNo_nonneg (dot N x x)} | b :e R, b :e R}.
Admitted.

