// Status: transport_required (bridges: hol_cart_setexp, hol_finite_finite, hol_real_R)
Theorem FINITE_COMPONENTS_FINITE : forall N:set, N <> Empty -> forall s c= R :^: idx N, finite s -> finite (components N s).
Admitted.

// HOL Light: Multivariate/topology.ml:11741 / COMPONENTS_FINITE
// Source hash: md5:de5f39d30ce1d0f006b94522ab0b4e1d
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_finite, hol_real_R)
Theorem COMPONENTS_FINITE : forall N:set, N <> Empty -> forall s c= R :^: idx N, finite s -> components N s = {{x} | x :e R :^: idx N, x :e s}.
Admitted.

// HOL Light: Multivariate/topology.ml:11747 / COMPONENTS_INTER_COMPONENTS
// Source hash: md5:d7c1f97b3e87268c7e8aa2e11533c3fe
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem COMPONENTS_INTER_COMPONENTS : forall N:set, N <> Empty -> forall s t c d c= R :^: idx N, c :e components N s /\ d :e components N (t :/\: c) -> d :e components N (t :/\: s).
Admitted.

// HOL Light: Multivariate/topology.ml:11758 / IN_COMPONENTS_UNIONS_COMPLEMENT
// Source hash: md5:6466cd448a8c81b1b55b3b244db25809
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem IN_COMPONENTS_UNIONS_COMPLEMENT : forall N:set, N <> Empty -> forall s c c= R :^: idx N, c :e components N s -> s :\: c = Union (components N s :\: {c}).
Admitted.

// HOL Light: Multivariate/topology.ml:11765 / CONNECTED_SUBSET_CLOPEN
// Source hash: md5:37ef65dcc88188ea5181409266fe845b
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CONNECTED_SUBSET_CLOPEN : forall N:set, N <> Empty -> forall u s c c= R :^: idx N, closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) u) s /\ (s :e subtopology (R :^: idx N) (euclidean N) u /\ (connected N c /\ (c c= u /\ ~ c :/\: s = Empty))) -> c c= s.
Admitted.

// HOL Light: Multivariate/topology.ml:11786 / CLOPEN_UNIONS_COMPONENTS
// Source hash: md5:a72ac1d694ab8cabcee6da86de6818e5
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CLOPEN_UNIONS_COMPONENTS : forall N:set, N <> Empty -> forall u s c= R :^: idx N, closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) u) s /\ s :e subtopology (R :^: idx N) (euclidean N) u -> exists k c= Power (R :^: idx N), k c= components N u /\ s = Union k.
Admitted.

// HOL Light: Multivariate/topology.ml:11802 / CLOPEN_IN_COMPONENTS
// Source hash: md5:defa6d5d586fe7b16734cf91e9afa726
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CLOPEN_IN_COMPONENTS : forall N:set, N <> Empty -> forall u s c= R :^: idx N, closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) u) s /\ (s :e subtopology (R :^: idx N) (euclidean N) u /\ (connected N s /\ ~ s = Empty)) -> s :e components N u.
Admitted.

// HOL Light: Multivariate/topology.ml:11829 / CONNECTED_UNIONS_PAIRWISE
// Source hash: md5:253683a09bff3e5f86a2279aa7c319c2
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_UNIONS_PAIRWISE : forall N:set, N <> Empty -> forall f c= Power (R :^: idx N), (forall s c= R :^: idx N, s :e f -> connected N s) /\ (forall x y :e f, x <> y -> ~ x = Empty /\ ~ y = Empty -> ~ x :/\: y = Empty) -> connected N (Union f).
Admitted.

// HOL Light: Multivariate/topology.ml:11862 / COMPONENTS_SEPARATED_UNION
// Source hash: md5:ad551fb3a0f145e82fab4d8c7d3450a6
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem COMPONENTS_SEPARATED_UNION : forall N:set, N <> Empty -> forall s t c= R :^: idx N, s :/\: closure N t = Empty /\ t :/\: closure N s = Empty -> components N (s :\/: t) = components N s :\/: components N t.
Admitted.

// HOL Light: Multivariate/topology.ml:11873 / COMPONENTS_COMPLEMENT_FRONTIER
// Source hash: md5:fff680c7bf673853f532e3e0f3b17a17
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem COMPONENTS_COMPLEMENT_FRONTIER : forall N:set, N <> Empty -> forall s c= R :^: idx N, components N ((R :^: idx N) :\: frontier N s) = components N (interior N s) :\/: components N ((R :^: idx N) :\: closure N s).
Admitted.

