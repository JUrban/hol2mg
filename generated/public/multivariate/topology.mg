Theorem POSITIVE_SEMIDEFINITE_MUL_EQ : forall N:set, N <> Empty -> forall A B :e R :^: idx N :^: idx N, positive_semidefinite N A /\ positive_semidefinite N B -> (positive_semidefinite N (matrix_mul N N N A B) <-> matrix_mul N N N A B = matrix_mul N N N B A).
Admitted.

// HOL Light: Multivariate/topology.ml:20915 / POSITIVE_SEMIDEFINITE_MUL
