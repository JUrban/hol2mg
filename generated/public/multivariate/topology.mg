// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem INTERIOR_UNIQUE : forall A:set, A <> Empty -> forall s t c= R :^: idx A, t c= s /\ (open A t /\ (forall t' c= R :^: idx A, t' c= s /\ open A t' -> t' c= t)) -> interior A s = t.
