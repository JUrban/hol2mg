// HOL Light: Multivariate/topology.ml:30519 / LAVRENTIEV
// Source hash: md5:bbcf8388e3213f92c9ae36099966ffe0
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem LAVRENTIEV : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, forall t c= R :^: idx N, continuous_on_hl M N f s /\ ({f x | x :e s} c= t /\ gdelta N t) -> exists u c= R :^: idx M, exists g:set -> set, (forall x :e R :^: idx M, g x :e R :^: idx N) /\ (gdelta M u /\ (s c= u /\ (u c= closure M s /\ (continuous_on_hl M N g u /\ ({g x | x :e u} c= t /\ forall x :e R :^: idx M, x :e s -> g x = f x))))).
Admitted.

// HOL Light: Multivariate/topology.ml:30534 / LAVRENTIEV_HOMEOMORPHISM
// Source hash: md5:c5ee0053f59c1ce9154aa956ff033c61
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem LAVRENTIEV_HOMEOMORPHISM : forall M N:set, M <> Empty -> N <> Empty -> forall f :e R :^: idx N :^: (R :^: idx M), forall f' :e R :^: idx M :^: (R :^: idx N), forall s c= R :^: idx M, forall s' c= R :^: idx N, homeomorphism M N (s,s') (f,f') -> exists u c= R :^: idx M, exists u' c= R :^: idx N, exists g :e R :^: idx N :^: (R :^: idx M), exists g' :e R :^: idx M :^: (R :^: idx N), gdelta M u /\ (s c= u /\ (u c= closure M s /\ (gdelta N u' /\ (s' c= u' /\ (u' c= closure N s' /\ ((forall x :e R :^: idx M, x :e s -> g x = f x) /\ ((forall x :e R :^: idx N, x :e s' -> g' x = f' x) /\ homeomorphism M N (u,u') (g,g')))))))).
Admitted.

// HOL Light: Multivariate/topology.ml:30581 / LAVRENTIEV_HOMEOMORPHISM_SELF
// Source hash: md5:8f3a9ce87bdc52e796d6fc1a3025d3cb
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem LAVRENTIEV_HOMEOMORPHISM_SELF : forall N:set, N <> Empty -> forall f f' :e R :^: idx N :^: (R :^: idx N), forall s c= R :^: idx N, homeomorphism N N (s,s) (f,f') -> exists u c= R :^: idx N, exists g g' :e R :^: idx N :^: (R :^: idx N), gdelta N u /\ (s c= u /\ (u c= closure N s /\ ((forall x :e R :^: idx N, x :e s -> g x = f x /\ g' x = f' x) /\ homeomorphism N N (u,u) (g,g')))).
Admitted.

