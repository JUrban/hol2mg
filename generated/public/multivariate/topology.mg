Theorem CAUCHY : forall N:set, N <> Empty -> forall s:set -> set, (forall x :e omega, s x :e R :^: idx N) -> (cauchy N s <-> forall e0 :e R, 0 < e0 -> exists N0 :e omega, forall n :e omega, N0 <= n -> distance N (s n,s N0) < e0).
Admitted.

// HOL Light: Multivariate/topology.ml:5691 / CAUCHY_SUBSEQUENCE
