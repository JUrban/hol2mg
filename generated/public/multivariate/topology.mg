// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem OPEN_TRANSLATION_EQ : forall N:set, N <> Empty -> forall a :e R :^: idx N, forall s c= R :^: idx N, open N {vector_add N a x | x :e s} <-> open N s.
Admitted.

// HOL Light: Multivariate/topology.ml:10631 / OPEN_AFFINITY_EQ
// Source hash: md5:fd4e23b5b9cbccea01a76a9a41a68432
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem OPEN_AFFINITY_EQ : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall m :e R, forall c :e R :^: idx N, open N {vector_add N (vector_mul N m x) c | x :e s} <-> (m = 0 -> s = Empty) /\ open N s.
Admitted.

