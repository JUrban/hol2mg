// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CONTINUOUS_ON_CASES_LOCAL_OPEN : forall M N:set, M <> Empty -> N <> Empty -> forall P:set -> prop, forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall g:set -> set, (forall x :e R :^: idx M, g x :e R :^: idx N) -> forall s t c= R :^: idx M, s :e subtopology (R :^: idx M) (euclidean M) (s :\/: t) /\ (t :e subtopology (R :^: idx M) (euclidean M) (s :\/: t) /\ (continuous_on_hl M N f s /\ (continuous_on_hl M N g t /\ (forall x :e R :^: idx M, x :e s /\ ~ P x \/ x :e t /\ P x -> f x = g x)))) -> continuous_on_hl M N (fun x:set => if P x then f x else g x) (s :\/: t).
Admitted.

// HOL Light: Multivariate/topology.ml:9432 / CONTINUOUS_ON_CASES_OPEN
// Source hash: md5:73eefc1d66f0d0caddda6e4b00d23370
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONTINUOUS_ON_CASES_OPEN : forall A B:set, A <> Empty -> B <> Empty -> forall P:set -> prop, forall f:set -> set, (forall x :e R :^: idx B, f x :e R :^: idx A) -> forall g:set -> set, (forall x :e R :^: idx B, g x :e R :^: idx A) -> forall s t c= R :^: idx B, open B s /\ (open B t /\ (continuous_on_hl B A f s /\ (continuous_on_hl B A g t /\ (forall x :e R :^: idx B, x :e s /\ ~ P x \/ x :e t /\ P x -> f x = g x)))) -> continuous_on_hl B A (fun x:set => if P x then f x else g x) (s :\/: t).
Admitted.

// HOL Light: Multivariate/topology.ml:9467 / CONTINUOUS_ON_LIFT_DOT
// Source hash: md5:6fdba1e1f41fd5cf6332823f72e25a7c
// Status: transport_required (bridges: hol_cart_setexp, hol_one_1, hol_real_R)
Theorem CONTINUOUS_ON_LIFT_DOT : forall A:set, A <> Empty -> forall a :e R :^: idx A, forall s c= R :^: idx A, continuous_on_hl A 1 (fun x:set => lift (dot A a x)) s.
Admitted.

