// Source hash: md5:f9d20f17678f8e26bf72229a25d27521
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem BOUNDED_SUMS : forall N:set, N <> Empty -> forall s t c= R :^: idx N, bounded_hl N s /\ bounded_hl N t -> bounded_hl N (\/_ x :e R :^: idx N, {vector_add N x y | y :e R :^: idx N, x :e s /\ y :e t}).
Admitted.

// HOL Light: Multivariate/topology.ml:5173 / BOUNDED_SUMS_IMAGE
// Source hash: md5:fac89ff8087e7ee7fae07086a8911ee4
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem BOUNDED_SUMS_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e R :^: idx B) -> forall g:set -> set, (forall x :e A, g x :e R :^: idx B) -> forall t c= A, bounded_hl B {f x | x :e A, x :e t} /\ bounded_hl B {g x | x :e A, x :e t} -> bounded_hl B {vector_add B (f x) (g x) | x :e A, x :e t}.
Admitted.

// HOL Light: Multivariate/topology.ml:5180 / BOUNDED_SUMS_IMAGES
// Source hash: md5:9fc9e16b4e890d7bcf9a67cc884c3456
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_finite, hol_real_R)
Theorem BOUNDED_SUMS_IMAGES : forall A B N:set, A <> Empty -> B <> Empty -> N <> Empty -> forall f:set -> set -> set, (forall x :e A, forall y :e B, f x y :e R :^: idx N) -> forall t c= A, forall s c= B, finite s /\ (forall a :e B, a :e s -> bounded_hl N {f x a | x :e A, x :e t}) -> bounded_hl N {vsum B N s (f x) | x :e A, x :e t}.
Admitted.

// HOL Light: Multivariate/topology.ml:5195 / BOUNDED_SUBSET_BALL
// Source hash: md5:5c1a07f5a9203410bbeb653346a527e0
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem BOUNDED_SUBSET_BALL : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x :e R :^: idx N, bounded_hl N s -> exists r :e R, 0 < r /\ s c= ball N (x,r).
Admitted.

// HOL Light: Multivariate/topology.ml:5206 / BOUNDED_SUBSET_CBALL
