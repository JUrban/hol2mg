Theorem DECREASING_CLOSED_NEST_SING : forall N:set, N <> Empty -> forall s :e Power (R :^: idx N) :^: omega, (forall n :e omega, closed N (s n)) /\ ((forall n :e omega, ~ s n = Empty) /\ ((forall m n :e omega, m <= n -> s n c= s m) /\ (forall e0 :e R, 0 < e0 -> exists n :e omega, forall x y :e R :^: idx N, x :e s n /\ y :e s n -> distance N (x,y) < e0))) -> exists a :e R :^: idx N, {x :e R :^: idx N | forall Y :e {t :e Power (R :^: idx N) | exists n :e omega, t = s n}, x :e Y} = {a}.
Admitted.

// HOL Light: Multivariate/topology.ml:6289 / BOUNDED_CLOSED_CHAIN
