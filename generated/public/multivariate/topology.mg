// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem HOMEOMORPHIC_MINIMAL : forall A B:set, A <> Empty -> B <> Empty -> forall s c= R :^: idx A, forall t c= R :^: idx B, homeomorphic B A s t <-> exists f:set -> set, (forall x :e R :^: idx A, f x :e R :^: idx B) /\ exists g:set -> set, (forall x :e R :^: idx B, g x :e R :^: idx A) /\ ((forall x :e R :^: idx A, x :e s -> f x :e t /\ g (f x) = x) /\ ((forall y :e R :^: idx B, y :e t -> g y :e s /\ f (g y) = y) /\ (continuous_on_hl A B f s /\ continuous_on_hl B A g t))).
Admitted.

