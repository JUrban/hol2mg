// Source hash: md5:4276ad6ddb7f45eed11330ae44759a42
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem COMPONENTS_EQ_SING_EXISTS : forall N:set, N <> Empty -> forall s c= R :^: idx N, (exists a c= R :^: idx N, components N s = {a}) <-> connected N s /\ ~ s = Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:11570 / CONNECTED_EQ_COMPONENTS_SING
// Source hash: md5:afee16835829512556bbf35fdcc7c0b5
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_EQ_COMPONENTS_SING : forall N:set, N <> Empty -> forall s c= R :^: idx N, connected N s <-> s = Empty \/ components N s = {s}.
Admitted.

