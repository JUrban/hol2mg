// Source hash: md5:5e9768f756cbea2e15df43520a02160a
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem IN_COMPONENTS_SELF : forall N:set, N <> Empty -> forall s c= R :^: idx N, s :e components N s <-> connected N s /\ ~ s = Empty.
Admitted.

