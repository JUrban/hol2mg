// HOL Light: Multivariate/topology.ml:36172 / BOREL_DOMAIN_OF_INJECTIVITY_CONTINUOUS
// Source hash: md5:13e242377935e413ef25192eda7f4838
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem BOREL_DOMAIN_OF_INJECTIVITY_CONTINUOUS : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, continuous_on_hl M N f s /\ fsigma M s -> exists t c= R :^: idx M, borel M t /\ (t c= s /\ ({f x | x :e t} = {f x | x :e s} /\ forall x y :e R :^: idx M, x :e t /\ (y :e t /\ f x = f y) -> x = y)).
Admitted.

