// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem MAPPING_CONNECTED_ONTO_SEGMENT : forall M N:set, M <> Empty -> N <> Empty -> forall s c= R :^: idx M, forall a b :e R :^: idx N, connected M s /\ ~ (exists a0 :e R :^: idx M, s c= {a0}) -> exists f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) /\ (continuous_on_hl M N f s /\ {f x | x :e s} = closed_segment N (seq_cons (a,b) seq_nil)).
Admitted.

// HOL Light: Multivariate/topology.ml:15981 / homeomorphism
// Source hash: md5:2d79c6300b1c85aaca4a98332a52ff49
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem homeomorphism_thm : forall A B:set, A <> Empty -> B <> Empty -> forall f :e R :^: idx B :^: (R :^: idx A), forall s c= R :^: idx A, forall g :e R :^: idx A :^: (R :^: idx B), forall t c= R :^: idx B, homeomorphism A B (s,t) (f,g) <-> (forall x :e R :^: idx A, x :e s -> g (f x) = x) /\ ({f x | x :e s} = t /\ (continuous_on_hl A B (fun x:set => f x) s /\ ((forall y :e R :^: idx B, y :e t -> f (g y) = y) /\ ({g x | x :e t} = s /\ continuous_on_hl B A (fun x:set => g x) t)))).
Admitted.

// HOL Light: Multivariate/topology.ml:15988 / homeomorphic
// Source hash: md5:18b7b6361de93c230255f2cc1219a617
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem homeomorphic_thm : forall A B:set, A <> Empty -> B <> Empty -> forall s c= R :^: idx B, forall t c= R :^: idx A, homeomorphic A B s t <-> exists f :e R :^: idx A :^: (R :^: idx B), exists g :e R :^: idx B :^: (R :^: idx A), homeomorphism B A (s,t) (f,g).
Admitted.

// HOL Light: Multivariate/topology.ml:15991 / HOMEOMORPHISM
// Source hash: md5:000d4404424d88a66e9b9242a7f4e14c
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem HOMEOMORPHISM : forall M N:set, M <> Empty -> N <> Empty -> forall s c= R :^: idx M, forall t c= R :^: idx N, forall f :e R :^: idx N :^: (R :^: idx M), forall g :e R :^: idx M :^: (R :^: idx N), homeomorphism M N (s,t) (f,g) <-> continuous_on_hl M N (fun x:set => f x) s /\ ({f x | x :e s} c= t /\ (continuous_on_hl N M (fun x:set => g x) t /\ ({g x | x :e t} c= s /\ ((forall x :e R :^: idx M, x :e s -> g (f x) = x) /\ forall y :e R :^: idx N, y :e t -> f (g y) = y)))).
Admitted.

