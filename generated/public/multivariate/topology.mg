Theorem HOMEOMORPHIC_CONNECTEDNESS : forall A B:set, A <> Empty -> B <> Empty -> forall s c= R :^: idx A, forall t c= R :^: idx B, homeomorphic B A s t -> (connected A s <-> connected B t).
Admitted.

// HOL Light: Multivariate/topology.ml:17152 / HOMEOMORPHISM_CONNECTEDNESS
// Source hash: md5:1500efb5d866b2038761f91cbcfb23c5
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem HOMEOMORPHISM_CONNECTEDNESS : forall M N:set, M <> Empty -> N <> Empty -> forall f :e R :^: idx N :^: (R :^: idx M), forall g :e R :^: idx M :^: (R :^: idx N), forall s c= R :^: idx M, forall t c= R :^: idx N, forall k c= R :^: idx M, homeomorphism M N (s,t) (f,g) /\ k c= s -> (connected N {f x | x :e k} <-> connected M k).
Admitted.

// HOL Light: Multivariate/topology.ml:17167 / HOMEOMORPHIC_SCALING
// Source hash: md5:d97d119941c37876aa4e57e9905b5f7d
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem HOMEOMORPHIC_SCALING : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall c :e R, ~ c = 0 -> homeomorphic N N s {vector_mul N c x | x :e s}.
Admitted.

// HOL Light: Multivariate/topology.ml:17175 / HOMEOMORPHIC_TRANSLATION
// Source hash: md5:32c23664443a3e355ed992e213b3e0bf
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem HOMEOMORPHIC_TRANSLATION : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall a :e R :^: idx N, homeomorphic N N s {vector_add N a x | x :e s}.
Admitted.

// HOL Light: Multivariate/topology.ml:17184 / HOMEOMORPHIC_AFFINITY
// Source hash: md5:25414ba114ca2a7c332536e66593aae0
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem HOMEOMORPHIC_AFFINITY : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall a :e R :^: idx N, forall c :e R, ~ c = 0 -> homeomorphic N N s {vector_add N (vector_mul N c x) a | x :e s}.
Admitted.

// HOL Light: Multivariate/topology.ml:17331 / HOMEOMORPHIC_OPEN_INTERVALS_1
// Source hash: md5:671f94ba6a2dbdbef4ca637208f3a689
// Status: transport_required (bridges: hol_cart_setexp, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem HOMEOMORPHIC_OPEN_INTERVALS_1 : forall a b c d :e R :^: idx 1, drop a < drop b /\ drop c < drop d -> homeomorphic 1 1 (open_interval 1 (a,b)) (open_interval 1 (c,d)).
Admitted.

// HOL Light: Multivariate/topology.ml:17363 / HOMEOMORPHIC_OPEN_INTERVAL_UNIV_1
// Source hash: md5:b3e56383c759507673faf3a38954dcde
// Status: transport_required (bridges: hol_cart_setexp, hol_one_1, hol_prod_setprod, hol_real_R)
Theorem HOMEOMORPHIC_OPEN_INTERVAL_UNIV_1 : forall a b :e R :^: idx 1, drop a < drop b -> homeomorphic 1 1 (open_interval 1 (a,b)) (R :^: idx 1).
Admitted.

// HOL Light: Multivariate/topology.ml:17430 / HOMEOMORPHIC_OPEN_INTERVALS
// Source hash: md5:4894d35bf880bf589083d1e33a89067e
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem HOMEOMORPHIC_OPEN_INTERVALS : forall N:set, N <> Empty -> forall a b c d :e R :^: idx N, (open_interval N (a,b) = Empty <-> open_interval N (c,d) = Empty) -> homeomorphic N N (open_interval N (a,b)) (open_interval N (c,d)).
Admitted.

// HOL Light: Multivariate/topology.ml:17467 / HOMEOMORPHIC_OPEN_INTERVAL_UNIV
// Source hash: md5:df9361f6a33260ee3415a55232cc70c4
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem HOMEOMORPHIC_OPEN_INTERVAL_UNIV : forall N:set, N <> Empty -> forall a b :e R :^: idx N, ~ open_interval N (a,b) = Empty -> homeomorphic N N (open_interval N (a,b)) (R :^: idx N).
Admitted.

// HOL Light: Multivariate/topology.ml:17503 / HOMEOMORPHIC_BALL_UNIV
// Source hash: md5:5f2f46b2b848ff7f8398324f04c855c9
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem HOMEOMORPHIC_BALL_UNIV : forall N:set, N <> Empty -> forall a :e R :^: idx N, forall r :e R, 0 < r -> homeomorphic N N (ball N (a,r)) (R :^: idx N).
Admitted.

// HOL Light: Multivariate/topology.ml:17550 / CARD_EQ_EUCLIDEAN
