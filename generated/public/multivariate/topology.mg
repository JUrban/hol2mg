Admitted.

// HOL Light: Multivariate/topology.ml:30675 / HOMEOMORPHISM_GDELTANESS
// Source hash: md5:b7a7598153f311f1f8e30bf5481c908c
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem HOMEOMORPHISM_GDELTANESS : forall M N:set, M <> Empty -> N <> Empty -> forall f :e R :^: idx N :^: (R :^: idx M), forall g :e R :^: idx M :^: (R :^: idx N), forall s c= R :^: idx M, forall t c= R :^: idx N, forall k c= R :^: idx M, homeomorphism M N (s,t) (f,g) /\ k c= s -> (gdelta N {f x | x :e k} <-> gdelta M k).
Admitted.

// HOL Light: Multivariate/topology.ml:30690 / EFFECTIVELY_COUNTABLE_CLOPEN_IN_CHAIN_UNIONS
// Source hash: md5:6b6601056758e9955af8f426b079312a
// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_real_R, hol_typedef_topology)
Theorem EFFECTIVELY_COUNTABLE_CLOPEN_IN_CHAIN_UNIONS : forall N:set, N <> Empty -> forall f c= Power (R :^: idx N), forall v c= R :^: idx N, (forall s c= R :^: idx N, s :e f -> closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) v) s \/ s :e subtopology (R :^: idx N) (euclidean N) v) /\ (forall s t c= R :^: idx N, s :e f /\ t :e f -> s c= t \/ t c= s) -> exists f' c= Power (R :^: idx N), countable f' /\ (f' c= f /\ Union f' = Union f).
Admitted.

// HOL Light: Multivariate/topology.ml:30782 / COUNTABLE_ASCENDING_CLOPEN_IN_CHAIN
// Source hash: md5:d33b049409a4f783df5926d1e53278c2
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, hol_typedef_topology)
Theorem COUNTABLE_ASCENDING_CLOPEN_IN_CHAIN : forall N:set, N <> Empty -> forall f c= Power (R :^: idx N), forall v c= R :^: idx N, ~ f = Empty /\ ((forall s c= R :^: idx N, s :e f -> closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) v) s \/ s :e subtopology (R :^: idx N) (euclidean N) v) /\ (forall s t c= R :^: idx N, s :e f /\ t :e f -> s c= t \/ t c= s)) -> exists u :e Power (R :^: idx N) :^: omega, (forall n :e omega, u n :e f) /\ ((forall n :e omega, u n c= u (ordsucc n)) /\ Union {u n | n :e omega, n :e omega} = Union f).
Admitted.

// HOL Light: Multivariate/topology.ml:30804 / EFFECTIVELY_COUNTABLE_CLOPEN_IN_CHAIN_INTERS
// Source hash: md5:6ecb14f0f2d56b86fc5f20e57340ebf2
// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_real_R, hol_typedef_topology)
Theorem EFFECTIVELY_COUNTABLE_CLOPEN_IN_CHAIN_INTERS : forall N:set, N <> Empty -> forall f c= Power (R :^: idx N), forall v c= R :^: idx N, (forall s c= R :^: idx N, s :e f -> closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) v) s \/ s :e subtopology (R :^: idx N) (euclidean N) v) /\ (forall s t c= R :^: idx N, s :e f /\ t :e f -> s c= t \/ t c= s) -> exists f' c= Power (R :^: idx N), countable f' /\ (f' c= f /\ {x :e R :^: idx N | forall Y :e f', x :e Y} = {x :e R :^: idx N | forall Y :e f, x :e Y}).
Admitted.

// HOL Light: Multivariate/topology.ml:30842 / COUNTABLE_DESCENDING_CLOPEN_IN_CHAIN
// Source hash: md5:2628f9f714504404c60773df985dea00
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, hol_typedef_topology)
Theorem COUNTABLE_DESCENDING_CLOPEN_IN_CHAIN : forall N:set, N <> Empty -> forall f c= Power (R :^: idx N), forall v c= R :^: idx N, ~ f = Empty /\ ((forall s c= R :^: idx N, s :e f -> closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) v) s \/ s :e subtopology (R :^: idx N) (euclidean N) v) /\ (forall s t c= R :^: idx N, s :e f /\ t :e f -> s c= t \/ t c= s)) -> exists u :e Power (R :^: idx N) :^: omega, (forall n :e omega, u n :e f) /\ ((forall n :e omega, u (ordsucc n) c= u n) /\ {x :e R :^: idx N | forall Y :e {u n | n :e omega, n :e omega}, x :e Y} = {x :e R :^: idx N | forall Y :e f, x :e Y}).
Admitted.

// HOL Light: Multivariate/topology.ml:30867 / EFFECTIVELY_COUNTABLE_CLOPEN_CHAIN_UNIONS
// Source hash: md5:32d91234f5f4eae431c0551d4d1437e9
// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_real_R)
Theorem EFFECTIVELY_COUNTABLE_CLOPEN_CHAIN_UNIONS : forall N:set, N <> Empty -> forall f c= Power (R :^: idx N), (forall s c= R :^: idx N, s :e f -> closed N s \/ open N s) /\ (forall s t c= R :^: idx N, s :e f /\ t :e f -> s c= t \/ t c= s) -> exists f' c= Power (R :^: idx N), countable f' /\ (f' c= f /\ Union f' = Union f).
Admitted.

// HOL Light: Multivariate/topology.ml:30876 / COUNTABLE_ASCENDING_CLOPEN_CHAIN
// Source hash: md5:3f4766ac2dae6769b61a3f6d8866eb19
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R)
Theorem COUNTABLE_ASCENDING_CLOPEN_CHAIN : forall N:set, N <> Empty -> forall f c= Power (R :^: idx N), ~ f = Empty /\ ((forall s c= R :^: idx N, s :e f -> closed N s \/ open N s) /\ (forall s t c= R :^: idx N, s :e f /\ t :e f -> s c= t \/ t c= s)) -> exists u :e Power (R :^: idx N) :^: omega, (forall n :e omega, u n :e f) /\ ((forall n :e omega, u n c= u (ordsucc n)) /\ Union {u n | n :e omega, n :e omega} = Union f).
Admitted.

