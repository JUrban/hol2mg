// HOL Light: Multivariate/topology.ml:31203 / CONTINUOUS_BOREL_PREIMAGE
// Source hash: md5:b9471c640aaa402a83cb84c466760851
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONTINUOUS_BOREL_PREIMAGE : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, forall t c= R :^: idx N, continuous_on_hl M N f s /\ (borel M s /\ borel N t) -> borel M {x :e R :^: idx M | x :e s /\ f x :e t}.
Admitted.

// HOL Light: Multivariate/topology.ml:31224 / HOMEOMORPHIC_BORELNESS
// Source hash: md5:75a4df550d76c2bab82159f2f9ec4239
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem HOMEOMORPHIC_BORELNESS : forall M N:set, M <> Empty -> N <> Empty -> forall s c= R :^: idx M, forall t c= R :^: idx N, homeomorphic N M s t -> (borel M s <-> borel N t).
Admitted.

// HOL Light: Multivariate/topology.ml:31247 / BOREL_TRANSLATION
// Source hash: md5:36ddf2c461041a044904d358f48f3ba5
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem BOREL_TRANSLATION : forall N:set, N <> Empty -> forall a :e R :^: idx N, forall s c= R :^: idx N, borel N {vector_add N a x | x :e s} <-> borel N s.
Admitted.

// HOL Light: Multivariate/topology.ml:31254 / BOREL_LINEAR_IMAGE
// Source hash: md5:53188d3852e415553c01d0f9ea511705
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem BOREL_LINEAR_IMAGE : forall N:set, N <> Empty -> forall f:set -> set, (forall x :e R :^: idx N, f x :e R :^: idx N) -> forall s c= R :^: idx N, linear N N f /\ (forall x y :e R :^: idx N, f x = f y -> x = y) -> (borel N {f x | x :e s} <-> borel N s).
Admitted.

// HOL Light: Multivariate/topology.ml:31264 / HOMEOMORPHISM_BORELNESS
// Source hash: md5:c28a4c6986d52f659d84cd3c7481f693
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem HOMEOMORPHISM_BORELNESS : forall M N:set, M <> Empty -> N <> Empty -> forall f :e R :^: idx N :^: (R :^: idx M), forall g :e R :^: idx M :^: (R :^: idx N), forall s c= R :^: idx M, forall t c= R :^: idx N, forall k c= R :^: idx M, homeomorphism M N (s,t) (f,g) /\ k c= s -> (borel N {f x | x :e k} <-> borel M k).
Admitted.

// HOL Light: Multivariate/topology.ml:31275 / BOREL_PCROSS
// Source hash: md5:b06f76052ba768efba6d308678d582f1
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_sum_idx, hol_real_R)
Theorem BOREL_PCROSS : forall M N:set, M <> Empty -> N <> Empty -> forall s c= R :^: idx M, forall t c= R :^: idx N, borel M s /\ borel N t -> borel (idx_n (dimindex M + dimindex N)) (\/_ x :e s, {pastecart M N x y | y :e t}).
Admitted.

// HOL Light: Multivariate/topology.ml:31290 / BOREL_PCROSS_EQ
// Source hash: md5:d692fe7354358faef30622c6763dbbf8
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_sum_idx, hol_real_R)
Theorem BOREL_PCROSS_EQ : forall M N:set, M <> Empty -> N <> Empty -> forall s c= R :^: idx M, forall t c= R :^: idx N, borel (idx_n (dimindex M + dimindex N)) (\/_ x :e s, {pastecart M N x y | y :e t}) <-> s = Empty \/ (t = Empty \/ borel M s /\ borel N t).
Admitted.

// HOL Light: Multivariate/topology.ml:31315 / LAVRENTIEV_BOREL
// Source hash: md5:c8c5bb9e4fa7933c4dd6542297988f07
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem LAVRENTIEV_BOREL : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, forall t c= R :^: idx N, continuous_on_hl M N f s /\ ({f x | x :e s} c= t /\ borel N t) -> exists u c= R :^: idx M, exists g:set -> set, (forall x :e R :^: idx M, g x :e R :^: idx N) /\ (borel M u /\ (s c= u /\ (u c= closure M s /\ (continuous_on_hl M N g u /\ ({g x | x :e u} c= t /\ forall x :e R :^: idx M, x :e s -> g x = f x))))).
Admitted.

// HOL Light: Multivariate/topology.ml:32308 / FSIGMA_REDUCTION
// Source hash: md5:f95bf98cca5d6d1100509e9b20c02c0e
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R)
Theorem FSIGMA_REDUCTION : forall N:set, N <> Empty -> forall s :e Power (R :^: idx N) :^: omega, (forall n :e omega, fsigma N (s n)) -> exists t :e Power (R :^: idx N) :^: omega, (forall n :e omega, fsigma N (t n)) /\ ((forall n :e omega, t n c= s n) /\ ((forall x y :e omega, x <> y -> t x :/\: t y = Empty) /\ Union {t n | n :e omega, n :e omega} = Union {s n | n :e omega, n :e omega})).
Admitted.

// HOL Light: Multivariate/topology.ml:32645 / GDELTA_SEPARATION
// Source hash: md5:ab42ceb7749ff5d72d84958470cebefe
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem GDELTA_SEPARATION : forall N:set, N <> Empty -> forall s t c= R :^: idx N, gdelta N s /\ (gdelta N t /\ s :/\: t = Empty) -> exists u c= R :^: idx N, fsigma N u /\ (gdelta N u /\ (s c= u /\ u :/\: t = Empty)).
Admitted.

