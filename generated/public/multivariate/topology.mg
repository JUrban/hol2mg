Theorem bounded_thm : forall N:set, N <> Empty -> forall s c= R :^: idx N, bounded_hl N s <-> exists a :e R, forall x :e R :^: idx N, x :e s -> sqrt_SNo_nonneg (dot N x x) <= a.
