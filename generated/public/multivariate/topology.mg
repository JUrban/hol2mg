// HOL Light: Multivariate/topology.ml:17661 / CARD_EQ_CONNECTED
// Source hash: md5:f8b9ff221859e72386efed1c17b2fefc
// Status: transport_required (bridges: hol_cart_setexp, hol_eq_c_equip, hol_real_R)
Theorem CARD_EQ_CONNECTED : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall a b :e R :^: idx N, connected N s /\ (a :e s /\ (b :e s /\ ~ a = b)) -> equip s R.
Admitted.

// HOL Light: Multivariate/topology.ml:17679 / UNCOUNTABLE_CONNECTED
// Source hash: md5:1d0b6b43e1e1f3252074de0136a7f6bb
// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_real_R)
Theorem UNCOUNTABLE_CONNECTED : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall a b :e R :^: idx N, connected N s /\ (a :e s /\ (b :e s /\ ~ a = b)) -> ~ countable s.
Admitted.

// HOL Light: Multivariate/topology.ml:17687 / CARD_LT_IMP_DISCONNECTED
// Source hash: md5:6eef464aedd6edfd6f002d4cbbc542d8
// Status: transport_required (bridges: hol_cart_setexp, hol_eq_c_equip, hol_real_R)
Theorem CARD_LT_IMP_DISCONNECTED : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x :e R :^: idx N, atleastp s R /\ ~ equip s R /\ x :e s -> forall x0 :e R :^: idx N, connected_component N s x x0 <-> x0 :e SetAdjoin Empty x.
Admitted.

// HOL Light: Multivariate/topology.ml:17702 / COUNTABLE_IMP_DISCONNECTED
// Source hash: md5:55b74d36268023d03e7b387b52f4d480
// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_real_R)
Theorem COUNTABLE_IMP_DISCONNECTED : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x :e R :^: idx N, countable s /\ x :e s -> forall x0 :e R :^: idx N, connected_component N s x x0 <-> x0 :e SetAdjoin Empty x.
Admitted.

// HOL Light: Multivariate/topology.ml:17706 / CONNECTED_CARD_EQ_IFF_NONTRIVIAL
// Source hash: md5:d58621155c5d12cecfca1d89c223ebb5
// Status: transport_required (bridges: hol_cart_setexp, hol_eq_c_equip, hol_real_R)
Theorem CONNECTED_CARD_EQ_IFF_NONTRIVIAL : forall N:set, N <> Empty -> forall s c= R :^: idx N, connected N s -> (equip s R <-> ~ exists a :e R :^: idx N, s c= {a}).
Admitted.

// HOL Light: Multivariate/topology.ml:17715 / CONNECTED_CARD_LT_IFF_TRIVIAL
// Source hash: md5:2c5594ec94ae4f1f49cdf99b39b959a2
// Status: transport_required (bridges: hol_cart_setexp, hol_eq_c_equip, hol_real_R)
Theorem CONNECTED_CARD_LT_IFF_TRIVIAL : forall N:set, N <> Empty -> forall s c= R :^: idx N, connected N s -> (atleastp s R /\ ~ equip s R <-> exists a :e R :^: idx N, s c= {a}).
Admitted.

// HOL Light: Multivariate/topology.ml:17726 / SMALL_IMP_TOTALLY_DISCONNECTED
// Source hash: md5:ad6f9f5b2c9e887a29f6ad369b01838a
// Status: transport_required (bridges: hol_cart_setexp, hol_eq_c_equip, hol_real_R)
Theorem SMALL_IMP_TOTALLY_DISCONNECTED : forall N:set, N <> Empty -> forall s c= R :^: idx N, atleastp s R /\ ~ equip s R -> components N s = {{x0 :e R :^: idx N | x0 :e {x}} | x :e s}.
Admitted.

