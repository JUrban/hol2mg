Theorem CONTINUOUS_RIGHT_INVERSE_IMP_QUOTIENT_MAP : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall g:set -> set, (forall x :e R :^: idx N, g x :e R :^: idx M) -> forall s c= R :^: idx M, forall t c= R :^: idx N, continuous_on_hl M N f s /\ ({f x | x :e s} c= t /\ (continuous_on_hl N M g t /\ ({g x | x :e t} c= s /\ (forall y :e R :^: idx N, y :e t -> f (g y) = y)))) -> forall u c= R :^: idx N, u c= t -> ({x :e R :^: idx M | x :e s /\ f x :e u} :e subtopology (R :^: idx M) (euclidean M) s <-> u :e subtopology (R :^: idx N) (euclidean N) t).
