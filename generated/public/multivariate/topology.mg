// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem OPEN_IN_SING : forall A:set, A <> Empty -> forall s c= R :^: idx A, forall a :e R :^: idx A, {a} :e subtopology (R :^: idx A) (euclidean A) s <-> a :e s /\ ~ limit_point_of A a s.
