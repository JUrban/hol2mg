// Status: transport_required (bridges: hol_cart_setexp, hol_finite_finite, hol_real_R)
Theorem FINITE_IMP_BOUNDED : forall N:set, N <> Empty -> forall s c= R :^: idx N, finite s -> bounded_hl N s.
Admitted.

// HOL Light: Multivariate/topology.ml:4976 / BOUNDED_NORM_IMAGE
