// Source hash: md5:2cb836a58bd1b41b359a44a644e5fdec
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem COMPONENTS_EQ_EMPTY : forall A:set, A <> Empty -> forall s c= R :^: idx A, components A s = Empty <-> s = Empty.
Admitted.

