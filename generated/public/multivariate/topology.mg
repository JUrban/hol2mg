// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem interior_thm : forall A:set, A <> Empty -> forall s c= R :^: idx A, interior A s = {x :e R :^: idx A | exists t c= R :^: idx A, open A t /\ (x :e t /\ t c= s)}.
