// Source hash: md5:77778d83156c07c4dae8793d33f48eec
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem COMPONENTS_MAXIMAL : forall N:set, N <> Empty -> forall s t c c= R :^: idx N, c :e components N s /\ (connected N t /\ (t c= s /\ ~ c :/\: t = Empty)) -> t c= c.
Admitted.

// HOL Light: Multivariate/topology.ml:11623 / IN_COMPONENTS_MAXIMAL_ALT
// Source hash: md5:e6dc753180e2d00fa35e0b9e16b037c3
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem IN_COMPONENTS_MAXIMAL_ALT : forall N:set, N <> Empty -> forall s c c= R :^: idx N, c :e components N s <-> ~ c = Empty /\ (c c= s /\ (connected N c /\ forall c' c= R :^: idx N, ~ c :/\: c' = Empty /\ (c' c= s /\ connected N c') -> c' c= c)).
Admitted.

// HOL Light: Multivariate/topology.ml:11640 / COMPONENTS_UNIQUE
// Source hash: md5:98f1ee6e6af67ea407b74c49b1f0a5aa
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem COMPONENTS_UNIQUE : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall k c= Power (R :^: idx N), Union k = s /\ (forall c c= R :^: idx N, c :e k -> connected N c /\ (~ c = Empty /\ forall c' c= R :^: idx N, connected N c' /\ (c c= c' /\ c' c= s) -> c' = c)) -> components N s = k.
Admitted.

// HOL Light: Multivariate/topology.ml:11676 / COMPONENTS_UNIQUE_EQ
// Source hash: md5:76379afbe8a6b63ff0fe3a86a41b8a4d
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem COMPONENTS_UNIQUE_EQ : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall k c= Power (R :^: idx N), components N s = k <-> Union k = s /\ forall c c= R :^: idx N, c :e k -> connected N c /\ (~ c = Empty /\ forall c' c= R :^: idx N, connected N c' /\ (c c= c' /\ c' c= s) -> c' = c).
Admitted.

// HOL Light: Multivariate/topology.ml:11692 / COMPONENTS_UNIQUE_2
// Source hash: md5:5abddab85be6b3d50e483305b3631cf6
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem COMPONENTS_UNIQUE_2 : forall N:set, N <> Empty -> forall s c1 c2 c= R :^: idx N, connected N c1 /\ (connected N c2 /\ (c1 :\/: c2 = s /\ ~ connected N s)) -> components N s = {c1,c2}.
Admitted.

// HOL Light: Multivariate/topology.ml:11713 / EXISTS_COMPONENT_SUPERSET
// Source hash: md5:b9984bacee11de923e16ce18b8d81185
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem EXISTS_COMPONENT_SUPERSET : forall N:set, N <> Empty -> forall s t c= R :^: idx N, t c= s /\ (~ s = Empty /\ connected N t) -> exists c c= R :^: idx N, c :e components N s /\ t c= c.
Admitted.

// HOL Light: Multivariate/topology.ml:11726 / COMPONENTS_INTERMEDIATE_SUBSET
// Source hash: md5:de1a97f6cd3b882818fe912b85b4ea50
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem COMPONENTS_INTERMEDIATE_SUBSET : forall N:set, N <> Empty -> forall s t u c= R :^: idx N, s :e components N u /\ (s c= t /\ t c= u) -> s :e components N t.
Admitted.

