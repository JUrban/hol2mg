// Source hash: md5:ee913e63acced6c72245083a917c4175
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_finite, hol_real_R)
Theorem PARACOMPACT : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall c c= Power (R :^: idx N), (forall t c= R :^: idx N, t :e c -> open N t) /\ s c= Union c -> exists c' c= Power (R :^: idx N), s c= Union c' /\ ((forall u c= R :^: idx N, u :e c' -> open N u /\ exists t c= R :^: idx N, t :e c /\ u c= t) /\ forall x :e R :^: idx N, x :e s -> exists v c= R :^: idx N, open N v /\ (x :e v /\ finite {u :e Power (R :^: idx N) | u :e c' /\ ~ u :/\: v = Empty})).
Admitted.

// HOL Light: Multivariate/topology.ml:36219 / SUBORDINATE_PARTITION_OF_UNITY
// Source hash: md5:f9aa7d9e3ecfa0145f7b74a8d623e929
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_finite, hol_num_omega, hol_one_1, hol_real_R, hol_sum_finsum, omega_Subq_R)
Theorem SUBORDINATE_PARTITION_OF_UNITY : forall N:set, N <> Empty -> forall c c= Power (R :^: idx N), forall s c= R :^: idx N, s c= Union c /\ (forall u c= R :^: idx N, u :e c -> open N u) -> exists f:set -> set -> set, (forall x :e Power (R :^: idx N), forall y :e R :^: idx N, f x y :e R) /\ ((forall u c= R :^: idx N, u :e c -> continuous_on_hl N 1 (fun x:set => lift (f u x)) s /\ forall x :e R :^: idx N, x :e s -> 0 <= f u x) /\ ((forall x :e R :^: idx N, forall u c= R :^: idx N, u :e c /\ (x :e s /\ ~ x :e u) -> f u x = 0) /\ ((forall x :e R :^: idx N, x :e s -> finsum c (fun u:set => f u x) = 1) /\ forall x :e R :^: idx N, x :e s -> exists n c= R :^: idx N, open N n /\ (x :e n /\ finite {u :e Power (R :^: idx N) | u :e c /\ ~ forall x0 :e R :^: idx N, x0 :e n -> f u x0 = 0})))).
Admitted.

