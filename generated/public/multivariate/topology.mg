Admitted.

// HOL Light: Multivariate/topology.ml:27496 / CONDENSATION_POINT_OF_CONDENSATION_POINTS
// Source hash: md5:f7fc0a0d0b4bf2c425aa3b1019bca5a1
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONDENSATION_POINT_OF_CONDENSATION_POINTS : forall N:set, N <> Empty -> forall x :e R :^: idx N, forall s c= R :^: idx N, condensation_point_of N x {y :e R :^: idx N | condensation_point_of N y s} <-> condensation_point_of N x s.
Admitted.

