// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_real_R)
Theorem UNCOUNTABLE_EUCLIDEAN : forall N:set, N <> Empty -> ~ countable (R :^: idx N).
Admitted.

// HOL Light: Multivariate/topology.ml:17559 / CARD_EQ_INTERVAL
// Source hash: md5:b22ed44a183e0595eb261ae7ddef29a7
// Status: transport_required (bridges: hol_cart_setexp, hol_eq_c_equip, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem CARD_EQ_INTERVAL : forall N:set, N <> Empty -> (forall a b :e R :^: idx N, ~ open_interval N (a,b) = Empty -> equip (closed_interval N (seq_cons (a,b) seq_nil)) R) /\ forall a b :e R :^: idx N, ~ open_interval N (a,b) = Empty -> equip (open_interval N (a,b)) R.
Admitted.

// HOL Light: Multivariate/topology.ml:17581 / UNCOUNTABLE_INTERVAL
// Source hash: md5:6051797243096cfa3d99b032ef3ab4ad
// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem UNCOUNTABLE_INTERVAL : forall A B:set, A <> Empty -> B <> Empty -> (forall a b :e R :^: idx A, ~ open_interval A (a,b) = Empty -> ~ countable (closed_interval A (seq_cons (a,b) seq_nil))) /\ forall a b :e R :^: idx B, ~ open_interval B (a,b) = Empty -> ~ countable (open_interval B (a,b)).
Admitted.

// HOL Light: Multivariate/topology.ml:17586 / COUNTABLE_OPEN_INTERVAL
// Source hash: md5:525fba6f176eaa1a9bca338eb8a839d2
// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_prod_setprod, hol_real_R)
Theorem COUNTABLE_OPEN_INTERVAL : forall A:set, A <> Empty -> forall a b :e R :^: idx A, countable (open_interval A (a,b)) <-> open_interval A (a,b) = Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:17590 / CARD_EQ_OPEN
