Admitted.

// HOL Light: Multivariate/topology.ml:30931 / CANTOR_BAIRE_STATIONARY_PRINCIPLE
// Source hash: md5:34d1e845f0f3d4c8e9eafa9f34a4bb9f
// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_prod_setprod, hol_real_R, hol_typedef_topology)
Theorem CANTOR_BAIRE_STATIONARY_PRINCIPLE : forall A N:set, A <> Empty -> N <> Empty -> forall f :e Power (R :^: idx N) :^: A, forall v c= R :^: idx N, forall w:set -> set -> prop, woset_on A w /\ (~ countable (\/_ x :e A, {(x,y) | y :e A, w x y}) /\ ((forall v0:set -> set -> prop, inseg_on A v0 w /\ ~ (forall x x0 :e A, v0 x x0 <-> w x x0) -> countable (\/_ x :e A, {(x,y) | y :e A, v0 x y})) /\ ((forall i :e A, i :e fld_on A w -> closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) v) (f i) \/ f i :e subtopology (R :^: idx N) (euclidean N) v) /\ (forall i j :e A, w i j -> f j c= f i)))) -> exists k :e A, k :e fld_on A w /\ forall i :e A, w k i -> f i = f k.
Admitted.

// HOL Light: Multivariate/topology.ml:30993 / borel_CASES
// Source hash: md5:db5ebf699acd04a3dca2910828e8f193
// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_real_R)
Theorem borel_CASES : forall N:set, N <> Empty -> forall a c= R :^: idx N, borel N a <-> open N a \/ ((exists s c= R :^: idx N, a = (R :^: idx N) :\: s /\ borel N s) \/ exists u c= Power (R :^: idx N), a = Union u /\ (countable u /\ forall s c= R :^: idx N, s :e u -> borel N s)).
Admitted.

// HOL Light: Multivariate/topology.ml:30993 / borel_INDUCT
// Source hash: md5:0547bb6d17b0ef2757fdcaac1848212f
// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_real_R)
Theorem borel_INDUCT : forall N:set, N <> Empty -> forall borel':set -> prop, (forall s c= R :^: idx N, open N s -> borel' s) /\ ((forall s c= R :^: idx N, borel' s -> borel' ((R :^: idx N) :\: s)) /\ (forall u c= Power (R :^: idx N), countable u /\ (forall s c= R :^: idx N, s :e u -> borel' s) -> borel' (Union u))) -> forall a c= R :^: idx N, borel N a -> borel' a.
Admitted.

// HOL Light: Multivariate/topology.ml:30993 / borel_RULES
// Source hash: md5:6dd70db33c687fd0350f68469969a7e4
// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_real_R)
Theorem borel_RULES : forall N:set, N <> Empty -> (forall s c= R :^: idx N, open N s -> borel N s) /\ ((forall s c= R :^: idx N, borel N s -> borel N ((R :^: idx N) :\: s)) /\ forall u c= Power (R :^: idx N), countable u /\ (forall s c= R :^: idx N, s :e u -> borel N s) -> borel N (Union u)).
Admitted.

