// Status: transport_required (bridges: hol_cart_setexp, hol_finite_finite, hol_real_R)
Theorem HEINE_BOREL_IMP_BOLZANO_WEIERSTRASS : forall N:set, N <> Empty -> forall s c= R :^: idx N, (forall f c= Power (R :^: idx N), (forall t c= R :^: idx N, t :e f -> open N t) /\ s c= Union f -> exists f' c= Power (R :^: idx N), f' c= f /\ (finite f' /\ s c= Union f')) -> forall t c= R :^: idx N, infinite t /\ t c= s -> exists x :e R :^: idx N, x :e s /\ limit_point_of N x t.
Admitted.

