// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem INTERIOR_EQ_EMPTY_ALT : forall N:set, N <> Empty -> forall s c= R :^: idx N, interior N s = Empty <-> forall t c= R :^: idx N, open N t /\ ~ t = Empty -> ~ t :\: s = Empty.
