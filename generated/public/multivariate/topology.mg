// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem OPEN_IN_INJECTIVE_LINEAR_IMAGE : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s t c= R :^: idx M, linear M N f /\ (forall x y :e R :^: idx M, f x = f y -> x = y) -> ({f x | x :e s} :e subtopology (R :^: idx N) (euclidean N) {f x | x :e t} <-> s :e subtopology (R :^: idx M) (euclidean M) t).
Admitted.

// HOL Light: Multivariate/topology.ml:885 / CLOSED_IN_INJECTIVE_LINEAR_IMAGE
// Source hash: md5:1da91072e4fa070e3e6649128a699805
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CLOSED_IN_INJECTIVE_LINEAR_IMAGE : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s t c= R :^: idx M, linear M N f /\ (forall x y :e R :^: idx M, f x = f y -> x = y) -> (closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) {f x | x :e t}) {f x | x :e s} <-> closed_in (R :^: idx M) (subtopology (R :^: idx M) (euclidean M) t) s).
Admitted.

// HOL Light: Multivariate/topology.ml:899 / HOMEOMORPHIC_MAPS_EUCLIDEAN_SPACE_EUCLIDEAN_GEN
// Source hash: md5:ddc21d35cf8070f703444e1ba155cd5f
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_topology, nat_le_SNoLe, omega_Subq_R)
Theorem HOMEOMORPHIC_MAPS_EUCLIDEAN_SPACE_EUCLIDEAN_GEN : forall N:set, N <> Empty -> forall n :e omega, n <= dimindex N -> homeomorphic_maps (R :^: omega) (R :^: idx N) (euclidean_space n,subtopology (R :^: idx N) (euclidean N) (span N {basis N x | x :e idx_n n})) (fun x :e R :^: omega => fun i :e idx N => if 1 <= i /\ i <= n then i i else 0,fun x :e R :^: idx N => fun i :e omega => if 1 <= i /\ i <= n then x i else 0).
Admitted.

// HOL Light: Multivariate/topology.ml:929 / HOMEOMORPHIC_MAPS_EUCLIDEAN_SPACE_EUCLIDEAN
// Source hash: md5:50048442f993e8b14175de433a70a865
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_topology, nat_le_SNoLe, omega_Subq_R)
Theorem HOMEOMORPHIC_MAPS_EUCLIDEAN_SPACE_EUCLIDEAN : forall N:set, N <> Empty -> homeomorphic_maps (R :^: omega) (R :^: idx N) (euclidean_space (dimindex N),euclidean N) (fun x :e R :^: omega => fun x :e idx N => x x,fun x :e R :^: idx N => fun i :e omega => if 1 <= i /\ i <= dimindex N then x i else 0).
Admitted.

// HOL Light: Multivariate/topology.ml:940 / HOMEOMORPHIC_MAPS_NSPHERE_EUCLIDEAN_SPHERE
// Source hash: md5:83472b38633f7dadd8a0ed3c69dcf81d
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_topology, nat_le_SNoLe, omega_Subq_R)
Theorem HOMEOMORPHIC_MAPS_NSPHERE_EUCLIDEAN_SPHERE : forall N:set, N <> Empty -> forall n :e omega, 1 <= n /\ n <= dimindex N -> homeomorphic_maps (R :^: omega) (R :^: idx N) (nsphere (minus_nat n 1),subtopology (R :^: idx N) (euclidean N) (sphere N (vec N 0,1) :/\: span N {basis N x | x :e idx_n n})) (fun x :e R :^: omega => fun i :e idx N => if 1 <= i /\ i <= n then i i else 0,fun x :e R :^: idx N => fun i :e omega => if 1 <= i /\ i <= n then x i else 0).
Admitted.

// HOL Light: Multivariate/topology.ml:970 / manhattan
// Source hash: md5:b7a3e23d6436fd72c042e48344d2bdf2
// Status: generalization_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_prod_setprod, hol_real_R, hol_sum_finsum, hol_typedef_metric)
Theorem manhattan_thm : forall N:set, N <> Empty -> manhattan N = (R :^: idx N,fun p :e R :^: idx N :*: R :^: idx N => finsum (idx N) (fun i:set => abs_SNo (p 0 i + - p 1 i))).
Admitted.

// HOL Light: Multivariate/topology.ml:974 / MANHATTAN
// Source hash: md5:2547a9dbc6752226a629baa9a59f3a33
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_prod_setprod, hol_real_R, hol_sum_finsum, hol_typedef_metric)
Theorem MANHATTAN : forall N:set, N <> Empty -> mspace (R :^: idx N) (manhattan N) = R :^: idx N /\ forall x y :e R :^: idx N, mdist (R :^: idx N) (manhattan N) (x,y) = finsum (idx N) (fun i:set => abs_SNo (x i + - y i)).
Admitted.

// HOL Light: Multivariate/topology.ml:1004 / closed_segment
// Source hash: md5:c17aa04e92e108132a5fc5ba73a54b69
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem closed_segment_thm : forall A:set, A <> Empty -> forall a b :e R :^: idx A, closed_segment A (seq_cons (a,b) seq_nil) = {vector_add A (vector_mul A (1 + - u) a) (vector_mul A u b) | u :e R, 0 <= u /\ u <= 1}.
Admitted.

// HOL Light: Multivariate/topology.ml:1007 / open_segment
// Source hash: md5:070ca5a3756651e4bd6e2ae29a3d3617
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem open_segment_thm : forall A:set, A <> Empty -> forall a b :e R :^: idx A, open_segment A (a,b) = closed_segment A (seq_cons (a,b) seq_nil) :\: {a,b}.
Admitted.

// HOL Light: Multivariate/topology.ml:1010 / OPEN_SEGMENT_ALT
// Source hash: md5:2227be1caf1afc70ead175f132cb9609
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem OPEN_SEGMENT_ALT : forall N:set, N <> Empty -> forall a b :e R :^: idx N, ~ a = b -> open_segment N (a,b) = {vector_add N (vector_mul N (1 + - u) a) (vector_mul N u b) | u :e R, 0 < u /\ u < 1}.
Admitted.

// HOL Light: Multivariate/topology.ml:1030 / segment
// Source hash: md5:6cbea95856d3da7a3de012dd90cb551a
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem segment : forall A:set, A <> Empty -> forall a b :e R :^: idx A, closed_segment A (seq_cons (a,b) seq_nil) = {vector_add A (vector_mul A (1 + - u) a) (vector_mul A u b) | u :e R, 0 <= u /\ u <= 1} /\ open_segment A (a,b) = closed_segment A (seq_cons (a,b) seq_nil) :\: {a,b}.
Admitted.

// HOL Light: Multivariate/topology.ml:1035 / SEGMENT_REFL
// Source hash: md5:4bec5fb15f1c8dac3e522966f1e34dfc
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem SEGMENT_REFL : forall A B:set, A <> Empty -> B <> Empty -> (forall a :e R :^: idx A, closed_segment A (seq_cons (a,a) seq_nil) = {a}) /\ forall a :e R :^: idx B, open_segment B (a,a) = Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:1041 / IN_SEGMENT
// Source hash: md5:5d919b5984cdffaa04bb62c171fbb9e3
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem IN_SEGMENT : forall N:set, N <> Empty -> forall a b x :e R :^: idx N, (x :e closed_segment N (seq_cons (a,b) seq_nil) <-> (exists u :e R, 0 <= u /\ (u <= 1 /\ x = vector_add N (vector_mul N (1 + - u) a) (vector_mul N u b)))) /\ (x :e open_segment N (a,b) <-> ~ a = b /\ exists u :e R, 0 < u /\ (u < 1 /\ x = vector_add N (vector_mul N (1 + - u) a) (vector_mul N u b))).
Admitted.

// HOL Light: Multivariate/topology.ml:1053 / SEGMENT_SYM
// Source hash: md5:a091749c90b9080a0e95be9bea4c87ec
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem SEGMENT_SYM : forall N:set, N <> Empty -> (forall a b :e R :^: idx N, closed_segment N (seq_cons (a,b) seq_nil) = closed_segment N (seq_cons (b,a) seq_nil)) /\ forall a b :e R :^: idx N, open_segment N (a,b) = open_segment N (b,a).
Admitted.

// HOL Light: Multivariate/topology.ml:1064 / ENDS_IN_SEGMENT
// Source hash: md5:edb3399efe725737fc48c4e966f81bdf
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem ENDS_IN_SEGMENT : forall A:set, A <> Empty -> forall a b :e R :^: idx A, a :e closed_segment A (seq_cons (a,b) seq_nil) /\ b :e closed_segment A (seq_cons (a,b) seq_nil).
Admitted.

// HOL Light: Multivariate/topology.ml:1070 / ENDS_NOT_IN_SEGMENT
// Source hash: md5:18fa233f5cf4ee240d73602c23959366
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem ENDS_NOT_IN_SEGMENT : forall A:set, A <> Empty -> forall a b :e R :^: idx A, ~ a :e open_segment A (a,b) /\ ~ b :e open_segment A (a,b).
Admitted.

// HOL Light: Multivariate/topology.ml:1074 / SEGMENT_CLOSED_OPEN
// Source hash: md5:0e2fce31cd815a16908e68d3b16a9a46
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem SEGMENT_CLOSED_OPEN : forall A:set, A <> Empty -> forall a b :e R :^: idx A, closed_segment A (seq_cons (a,b) seq_nil) = open_segment A (a,b) :\/: {a,b}.
Admitted.

// HOL Light: Multivariate/topology.ml:1080 / SEGMENT_OPEN_SUBSET_CLOSED
// Source hash: md5:5c962b8c8a2348d4e1f04cdcab326cc7
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem SEGMENT_OPEN_SUBSET_CLOSED : forall A:set, A <> Empty -> forall a b :e R :^: idx A, open_segment A (a,b) c= closed_segment A (seq_cons (a,b) seq_nil).
Admitted.

// HOL Light: Multivariate/topology.ml:1084 / MIDPOINT_IN_SEGMENT
// Source hash: md5:2b7449153ddbc0e7fc0c6caaacff6c85
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem MIDPOINT_IN_SEGMENT : forall N:set, N <> Empty -> (forall a b :e R :^: idx N, midpoint N (a,b) :e closed_segment N (seq_cons (a,b) seq_nil)) /\ forall a b :e R :^: idx N, midpoint N (a,b) :e open_segment N (a,b) <-> ~ a = b.
Admitted.

// HOL Light: Multivariate/topology.ml:1092 / BETWEEN_IN_SEGMENT
// Source hash: md5:214b7f354eb0bb5e1a56b50b11d80fcd
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem BETWEEN_IN_SEGMENT : forall N:set, N <> Empty -> forall x a b :e R :^: idx N, between N x (a,b) <-> x :e closed_segment N (seq_cons (a,b) seq_nil).
Admitted.

// HOL Light: Multivariate/topology.ml:1115 / IN_SEGMENT_COMPONENT
// Source hash: md5:9768f35a549a28489453d4b8dfa5cfd9
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_list_finseq, hol_num_omega, hol_prod_setprod, hol_real_R, nat_le_SNoLe)
Theorem IN_SEGMENT_COMPONENT : forall N:set, N <> Empty -> forall a b x :e R :^: idx N, forall i :e omega, x :e closed_segment N (seq_cons (a,b) seq_nil) /\ (1 <= i /\ i <= dimindex N) -> (if a i <= b i then a i else b i) <= x i /\ x i <= if a i <= b i then b i else a i.
Admitted.

// HOL Light: Multivariate/topology.ml:1127 / SEGMENT_TRANSLATION
// Source hash: md5:342dac7e16315e93c54049a2bb124264
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem SEGMENT_TRANSLATION : forall A B:set, A <> Empty -> B <> Empty -> (forall c a b :e R :^: idx A, closed_segment A (seq_cons (vector_add A c a,vector_add A c b) seq_nil) = {vector_add A c x | x :e closed_segment A (seq_cons (a,b) seq_nil)}) /\ forall c a b :e R :^: idx B, open_segment B (vector_add B c a,vector_add B c b) = {vector_add B c x | x :e open_segment B (a,b)}.
Admitted.

// HOL Light: Multivariate/topology.ml:1139 / CLOSED_SEGMENT_LINEAR_IMAGE
// Source hash: md5:6c72335002a053db59258e1efb9c0c18
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem CLOSED_SEGMENT_LINEAR_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e R :^: idx B, f x :e R :^: idx A) -> forall a b :e R :^: idx B, linear B A f -> closed_segment A (seq_cons (f a,f b) seq_nil) = {f x | x :e closed_segment B (seq_cons (a,b) seq_nil)}.
Admitted.

// HOL Light: Multivariate/topology.ml:1149 / OPEN_SEGMENT_LINEAR_IMAGE
// Source hash: md5:38b7a8611ecc37961c0393737320029c
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem OPEN_SEGMENT_LINEAR_IMAGE : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall a b :e R :^: idx M, linear M N f /\ (forall x y :e R :^: idx M, f x = f y -> x = y) -> open_segment N (f a,f b) = {f x | x :e open_segment M (a,b)}.
Admitted.

// HOL Light: Multivariate/topology.ml:1157 / IN_OPEN_SEGMENT
// Source hash: md5:30d534061423558101147a0bde5fea7b
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem IN_OPEN_SEGMENT : forall N:set, N <> Empty -> forall a b x :e R :^: idx N, x :e open_segment N (a,b) <-> x :e closed_segment N (seq_cons (a,b) seq_nil) /\ (~ x = a /\ ~ x = b).
Admitted.

// HOL Light: Multivariate/topology.ml:1162 / IN_OPEN_SEGMENT_ALT
// Source hash: md5:7ead87133d7e3408759fccf644486641
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem IN_OPEN_SEGMENT_ALT : forall N:set, N <> Empty -> forall a b x :e R :^: idx N, x :e open_segment N (a,b) <-> x :e closed_segment N (seq_cons (a,b) seq_nil) /\ (~ x = a /\ (~ x = b /\ ~ a = b)).
Admitted.

// HOL Light: Multivariate/topology.ml:1170 / COLLINEAR_DIST_IN_CLOSED_SEGMENT
// Source hash: md5:bf8089b2c0f3767629372dee236ada82
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem COLLINEAR_DIST_IN_CLOSED_SEGMENT : forall A:set, A <> Empty -> forall a b x :e R :^: idx A, collinear A {x,a,b} /\ (distance A (x,a) <= distance A (a,b) /\ distance A (x,b) <= distance A (a,b)) -> x :e closed_segment A (seq_cons (a,b) seq_nil).
Admitted.

// HOL Light: Multivariate/topology.ml:1176 / COLLINEAR_DIST_IN_OPEN_SEGMENT
// Source hash: md5:99a34226a406d1c35b97bdb58e5007ff
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem COLLINEAR_DIST_IN_OPEN_SEGMENT : forall A:set, A <> Empty -> forall a b x :e R :^: idx A, collinear A {x,a,b} /\ (distance A (x,a) < distance A (a,b) /\ distance A (x,b) < distance A (a,b)) -> x :e open_segment A (a,b).
Admitted.

// HOL Light: Multivariate/topology.ml:1183 / DIST_IN_CLOSED_SEGMENT
// Source hash: md5:f2cef9bd8cee1b22bb022f4174cc40e7
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem DIST_IN_CLOSED_SEGMENT : forall N:set, N <> Empty -> forall a b x :e R :^: idx N, x :e closed_segment N (seq_cons (a,b) seq_nil) -> distance N (x,a) <= distance N (a,b) /\ distance N (x,b) <= distance N (a,b).
Admitted.

// HOL Light: Multivariate/topology.ml:1183 / DIST_IN_OPEN_SEGMENT
// Source hash: md5:b6fbd7f627afb46ce7a2ae5b33c24490
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem DIST_IN_OPEN_SEGMENT : forall N:set, N <> Empty -> forall a b x :e R :^: idx N, x :e open_segment N (a,b) -> distance N (x,a) < distance N (a,b) /\ distance N (x,b) < distance N (a,b).
Admitted.

// HOL Light: Multivariate/topology.ml:1201 / DIST_DECREASES_OPEN_SEGMENT
// Source hash: md5:2fd37a20380b0a80d1050b4531496f22
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem DIST_DECREASES_OPEN_SEGMENT : forall N:set, N <> Empty -> forall a b c x :e R :^: idx N, x :e open_segment N (a,b) -> distance N (c,x) < distance N (c,a) \/ distance N (c,x) < distance N (c,b).
Admitted.

// HOL Light: Multivariate/topology.ml:1223 / DIST_DECREASES_CLOSED_SEGMENT
// Source hash: md5:d06c5d6f6dd8c585a67747b4497aa0dc
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem DIST_DECREASES_CLOSED_SEGMENT : forall N:set, N <> Empty -> forall a b c x :e R :^: idx N, x :e closed_segment N (seq_cons (a,b) seq_nil) -> distance N (c,x) <= distance N (c,a) \/ distance N (c,x) <= distance N (c,b).
Admitted.

// HOL Light: Multivariate/topology.ml:1229 / DIST_IN_CLOSED_SEGMENT_2
// Source hash: md5:4504eea568f048e95916bee5b63b904c
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem DIST_IN_CLOSED_SEGMENT_2 : forall N:set, N <> Empty -> forall a b x y :e R :^: idx N, x :e closed_segment N (seq_cons (a,b) seq_nil) /\ y :e closed_segment N (seq_cons (a,b) seq_nil) -> distance N (x,y) <= distance N (a,b).
Admitted.

// HOL Light: Multivariate/topology.ml:1244 / connected
// Source hash: md5:41d63641ee23acf3738367f3f932ed35
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem connected_thm : forall A:set, A <> Empty -> forall s c= R :^: idx A, connected A s <-> ~ exists e1 e2 c= R :^: idx A, open A e1 /\ (open A e2 /\ (s c= e1 :\/: e2 /\ (e1 :/\: (e2 :/\: s) = Empty /\ (~ e1 :/\: s = Empty /\ ~ e2 :/\: s = Empty)))).
Admitted.

// HOL Light: Multivariate/topology.ml:1250 / CONNECTED_IN_EUCLIDEAN
// Source hash: md5:28ef964595cf223069d83f854d7dfc04
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CONNECTED_IN_EUCLIDEAN : forall N:set, N <> Empty -> forall s c= R :^: idx N, connected_in (R :^: idx N) (euclidean N) s <-> connected N s.
Admitted.

// HOL Light: Multivariate/topology.ml:1255 / CONNECTED_SPACE_EUCLIDEAN_SUBTOPOLOGY
// Source hash: md5:c284deba513599b3187f11596260a139
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CONNECTED_SPACE_EUCLIDEAN_SUBTOPOLOGY : forall N:set, N <> Empty -> forall s c= R :^: idx N, connected_space (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) s) <-> connected N s.
Admitted.

// HOL Light: Multivariate/topology.ml:1263 / CONNECTED_CLOSED
// Source hash: md5:0aec48b06892f9671a47e89ac8f539a2
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_CLOSED : forall N:set, N <> Empty -> forall s c= R :^: idx N, connected N s <-> ~ exists e1 e2 c= R :^: idx N, closed N e1 /\ (closed N e2 /\ (s c= e1 :\/: e2 /\ (e1 :/\: (e2 :/\: s) = Empty /\ (~ e1 :/\: s = Empty /\ ~ e2 :/\: s = Empty)))).
Admitted.

// HOL Light: Multivariate/topology.ml:1273 / CONNECTED_OPEN_IN
// Source hash: md5:23c1e67336f2d8b6b908912b1d9a1f0e
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CONNECTED_OPEN_IN : forall A:set, A <> Empty -> forall s c= R :^: idx A, connected A s <-> ~ exists e1 e2 c= R :^: idx A, e1 :e subtopology (R :^: idx A) (euclidean A) s /\ (e2 :e subtopology (R :^: idx A) (euclidean A) s /\ (s c= e1 :\/: e2 /\ (e1 :/\: e2 = Empty /\ (~ e1 = Empty /\ ~ e2 = Empty)))).
Admitted.

// HOL Light: Multivariate/topology.ml:1286 / CONNECTED_OPEN_IN_EQ
// Source hash: md5:6bfabb1f9555d5d50dfc43bc34199588
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CONNECTED_OPEN_IN_EQ : forall A:set, A <> Empty -> forall s c= R :^: idx A, connected A s <-> ~ exists e1 e2 c= R :^: idx A, e1 :e subtopology (R :^: idx A) (euclidean A) s /\ (e2 :e subtopology (R :^: idx A) (euclidean A) s /\ (e1 :\/: e2 = s /\ (e1 :/\: e2 = Empty /\ (~ e1 = Empty /\ ~ e2 = Empty)))).
Admitted.

// HOL Light: Multivariate/topology.ml:1297 / CONNECTED_CLOSED_IN
// Source hash: md5:97b8e0658edb51ec4418242351d468ea
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CONNECTED_CLOSED_IN : forall A:set, A <> Empty -> forall s c= R :^: idx A, connected A s <-> ~ exists e1 e2 c= R :^: idx A, closed_in (R :^: idx A) (subtopology (R :^: idx A) (euclidean A) s) e1 /\ (closed_in (R :^: idx A) (subtopology (R :^: idx A) (euclidean A) s) e2 /\ (s c= e1 :\/: e2 /\ (e1 :/\: e2 = Empty /\ (~ e1 = Empty /\ ~ e2 = Empty)))).
Admitted.

// HOL Light: Multivariate/topology.ml:1310 / CONNECTED_CLOSED_IN_EQ
// Source hash: md5:016895379af89742088904d4d4a4447d
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CONNECTED_CLOSED_IN_EQ : forall A:set, A <> Empty -> forall s c= R :^: idx A, connected A s <-> ~ exists e1 e2 c= R :^: idx A, closed_in (R :^: idx A) (subtopology (R :^: idx A) (euclidean A) s) e1 /\ (closed_in (R :^: idx A) (subtopology (R :^: idx A) (euclidean A) s) e2 /\ (e1 :\/: e2 = s /\ (e1 :/\: e2 = Empty /\ (~ e1 = Empty /\ ~ e2 = Empty)))).
Admitted.

// HOL Light: Multivariate/topology.ml:1321 / CONNECTED_CLOPEN
// Source hash: md5:76c36ce91c1fe218e1bfff1bce7cbf3b
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CONNECTED_CLOPEN : forall A:set, A <> Empty -> forall s c= R :^: idx A, connected A s <-> forall t c= R :^: idx A, t :e subtopology (R :^: idx A) (euclidean A) s /\ closed_in (R :^: idx A) (subtopology (R :^: idx A) (euclidean A) s) t -> t = Empty \/ t = s.
Admitted.

// HOL Light: Multivariate/topology.ml:1329 / CONNECTED_CLOSED_SET
// Source hash: md5:f487a032e370dd265654696b3de36f1f
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_CLOSED_SET : forall N:set, N <> Empty -> forall s c= R :^: idx N, closed N s -> (connected N s <-> ~ exists e1 e2 c= R :^: idx N, closed N e1 /\ (closed N e2 /\ (~ e1 = Empty /\ (~ e2 = Empty /\ (e1 :\/: e2 = s /\ e1 :/\: e2 = Empty))))).
Admitted.

// HOL Light: Multivariate/topology.ml:1339 / CONNECTED_OPEN_SET
// Source hash: md5:3693fef1e0453972c339d3e2349ffa0c
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_OPEN_SET : forall N:set, N <> Empty -> forall s c= R :^: idx N, open N s -> (connected N s <-> ~ exists e1 e2 c= R :^: idx N, open N e1 /\ (open N e2 /\ (~ e1 = Empty /\ (~ e2 = Empty /\ (e1 :\/: e2 = s /\ e1 :/\: e2 = Empty))))).
Admitted.

// HOL Light: Multivariate/topology.ml:1349 / CONNECTED_IFF_CONNECTABLE_POINTS
// Source hash: md5:189a0487466b4692a9104547461e163e
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_IFF_CONNECTABLE_POINTS : forall N:set, N <> Empty -> forall s c= R :^: idx N, connected N s <-> forall a b :e R :^: idx N, a :e s /\ b :e s -> exists t c= R :^: idx N, connected N t /\ (t c= s /\ (a :e t /\ b :e t)).
Admitted.

// HOL Light: Multivariate/topology.ml:1360 / CONNECTED_EMPTY
// Source hash: md5:7ae5df203edd322b1fb5bc69e077c663
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_EMPTY : forall A:set, A <> Empty -> connected A Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:1364 / CONNECTED_SING
// Source hash: md5:5427f945f1c0e6a3a94bef50084e9a23
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_SING : forall A:set, A <> Empty -> forall a :e R :^: idx A, connected A {a}.
Admitted.

// HOL Light: Multivariate/topology.ml:1368 / CONNECTED_SEGMENT
// Source hash: md5:014311bbf465283b07fb305cb5226e1c
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem CONNECTED_SEGMENT : forall N:set, N <> Empty -> (forall a b :e R :^: idx N, connected N (closed_segment N (seq_cons (a,b) seq_nil))) /\ forall a b :e R :^: idx N, connected N (open_segment N (a,b)).
Admitted.

// HOL Light: Multivariate/topology.ml:1388 / CONNECTED_UNIV
// Source hash: md5:462ce8ea7328b8fdc214812fe1c129f6
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_UNIV : forall N:set, N <> Empty -> connected N (R :^: idx N).
Admitted.

// HOL Light: Multivariate/topology.ml:1396 / CLOPEN
// Source hash: md5:a7a8382dc157c213b3a7f3f99ddc4563
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOPEN : forall N:set, N <> Empty -> forall s c= R :^: idx N, closed N s /\ open N s <-> s = Empty \/ s = R :^: idx N.
Admitted.

// HOL Light: Multivariate/topology.ml:1403 / CONNECTED_UNIONS
// Source hash: md5:7a52639ab83d07f7a4829839c2263363
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_UNIONS : forall N:set, N <> Empty -> forall P c= Power (R :^: idx N), (forall s c= R :^: idx N, s :e P -> connected N s) /\ ~ {x :e R :^: idx N | forall Y :e P, x :e Y} = Empty -> connected N (Union P).
Admitted.

// HOL Light: Multivariate/topology.ml:1428 / CONNECTED_UNION
// Source hash: md5:1664f76bf23ff2a60e4d121e5b7f45df
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_UNION : forall N:set, N <> Empty -> forall s t c= R :^: idx N, connected N s /\ (connected N t /\ ~ s :/\: t = Empty) -> connected N (s :\/: t).
Admitted.

// HOL Light: Multivariate/topology.ml:1436 / CONNECTED_DIFF_OPEN_FROM_CLOSED
// Source hash: md5:4d952dd6b27d10a5451a2e4bd35d7bb3
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_DIFF_OPEN_FROM_CLOSED : forall N:set, N <> Empty -> forall s t u c= R :^: idx N, s c= t /\ (t c= u /\ (open N s /\ (closed N t /\ (connected N u /\ connected N (t :\: s))))) -> connected N (u :\: s).
Admitted.

// HOL Light: Multivariate/topology.ml:1458 / CONNECTED_DISJOINT_UNIONS_OPEN_UNIQUE
// Source hash: md5:8aff0f354e86d317269acd073178996b
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_DISJOINT_UNIONS_OPEN_UNIQUE : forall N:set, N <> Empty -> forall f f' c= Power (R :^: idx N), (forall x y :e f, x <> y -> x :/\: y = Empty) /\ ((forall x y :e f', x <> y -> x :/\: y = Empty) /\ ((forall s c= R :^: idx N, s :e f -> open N s /\ (connected N s /\ ~ s = Empty)) /\ ((forall s c= R :^: idx N, s :e f' -> open N s /\ (connected N s /\ ~ s = Empty)) /\ Union f = Union f'))) -> f = f'.
Admitted.

// HOL Light: Multivariate/topology.ml:1504 / CONNECTED_FROM_CLOSED_UNION_AND_INTER_LOCAL
// Source hash: md5:03eeb94ed9778db31a164b8414e8bce2
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CONNECTED_FROM_CLOSED_UNION_AND_INTER_LOCAL : forall N:set, N <> Empty -> forall u s t c= R :^: idx N, closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) u) s /\ (closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) u) t /\ (connected N (s :\/: t) /\ connected N (s :/\: t))) -> connected N s /\ connected N t.
Admitted.

// HOL Light: Multivariate/topology.ml:1545 / CONNECTED_FROM_OPEN_UNION_AND_INTER_LOCAL
// Source hash: md5:b95eefb6b1f826baf52fdf10bde1093a
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CONNECTED_FROM_OPEN_UNION_AND_INTER_LOCAL : forall N:set, N <> Empty -> forall u s t c= R :^: idx N, s :e subtopology (R :^: idx N) (euclidean N) u /\ (t :e subtopology (R :^: idx N) (euclidean N) u /\ (connected N (s :\/: t) /\ connected N (s :/\: t))) -> connected N s /\ connected N t.
Admitted.

// HOL Light: Multivariate/topology.ml:1586 / CONNECTED_FROM_CLOSED_UNION_AND_INTER
// Source hash: md5:a2c51f546daa409cde0c3ec98e7662ba
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_FROM_CLOSED_UNION_AND_INTER : forall N:set, N <> Empty -> forall s t c= R :^: idx N, closed N s /\ (closed N t /\ (connected N (s :\/: t) /\ connected N (s :/\: t))) -> connected N s /\ connected N t.
Admitted.

// HOL Light: Multivariate/topology.ml:1593 / CONNECTED_FROM_OPEN_UNION_AND_INTER
// Source hash: md5:a8f041f500f8dcd9f722de0b576e2508
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_FROM_OPEN_UNION_AND_INTER : forall N:set, N <> Empty -> forall s t c= R :^: idx N, open N s /\ (open N t /\ (connected N (s :\/: t) /\ connected N (s :/\: t))) -> connected N s /\ connected N t.
Admitted.

// HOL Light: Multivariate/topology.ml:1604 / CONNECTED_INDUCTION
// Source hash: md5:cebd45249ddd9244c97df7b0aabd6939
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CONNECTED_INDUCTION : forall N:set, N <> Empty -> forall P Q:set -> prop, forall s c= R :^: idx N, connected N s /\ ((forall t c= R :^: idx N, forall a :e R :^: idx N, t :e subtopology (R :^: idx N) (euclidean N) s /\ a :e t -> exists z :e R :^: idx N, z :e t /\ P z) /\ (forall a :e R :^: idx N, a :e s -> exists t c= R :^: idx N, t :e subtopology (R :^: idx N) (euclidean N) s /\ (a :e t /\ forall x y :e R :^: idx N, x :e t /\ (y :e t /\ (P x /\ (P y /\ Q x))) -> Q y))) -> forall a b :e R :^: idx N, a :e s /\ (b :e s /\ (P a /\ (P b /\ Q a))) -> Q b.
Admitted.

// HOL Light: Multivariate/topology.ml:1640 / CONNECTED_EQUIVALENCE_RELATION_GEN
// Source hash: md5:97616f7993e26ff3576b5a5154e699a6
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CONNECTED_EQUIVALENCE_RELATION_GEN : forall N:set, N <> Empty -> forall P:set -> prop, forall R0:set -> set -> prop, forall s c= R :^: idx N, connected N s /\ ((forall x y :e R :^: idx N, R0 x y -> R0 y x) /\ ((forall x y z :e R :^: idx N, R0 x y /\ R0 y z -> R0 x z) /\ ((forall t c= R :^: idx N, forall a :e R :^: idx N, t :e subtopology (R :^: idx N) (euclidean N) s /\ a :e t -> exists z :e R :^: idx N, z :e t /\ P z) /\ (forall a :e R :^: idx N, a :e s -> exists t c= R :^: idx N, t :e subtopology (R :^: idx N) (euclidean N) s /\ (a :e t /\ forall x y :e R :^: idx N, x :e t /\ (y :e t /\ (P x /\ P y)) -> R0 x y))))) -> forall a b :e R :^: idx N, a :e s /\ (b :e s /\ (P a /\ P b)) -> R0 a b.
Admitted.

// HOL Light: Multivariate/topology.ml:1659 / CONNECTED_INDUCTION_SIMPLE
// Source hash: md5:662da37338615c18e8d055527042c9df
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CONNECTED_INDUCTION_SIMPLE : forall N:set, N <> Empty -> forall P:set -> prop, forall s c= R :^: idx N, connected N s /\ (forall a :e R :^: idx N, a :e s -> exists t c= R :^: idx N, t :e subtopology (R :^: idx N) (euclidean N) s /\ (a :e t /\ forall x y :e R :^: idx N, x :e t /\ (y :e t /\ P x) -> P y)) -> forall a b :e R :^: idx N, a :e s /\ (b :e s /\ P a) -> P b.
Admitted.

// HOL Light: Multivariate/topology.ml:1670 / CONNECTED_EQUIVALENCE_RELATION
// Source hash: md5:a624723475723d6ddb1882d1975d86ea
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CONNECTED_EQUIVALENCE_RELATION : forall N:set, N <> Empty -> forall R0:set -> set -> prop, forall s c= R :^: idx N, connected N s /\ ((forall x y :e R :^: idx N, R0 x y -> R0 y x) /\ ((forall x y z :e R :^: idx N, R0 x y /\ R0 y z -> R0 x z) /\ (forall a :e R :^: idx N, a :e s -> exists t c= R :^: idx N, t :e subtopology (R :^: idx N) (euclidean N) s /\ (a :e t /\ forall x :e R :^: idx N, x :e t -> R0 a x)))) -> forall a b :e R :^: idx N, a :e s /\ b :e s -> R0 a b.
Admitted.

// HOL Light: Multivariate/topology.ml:1686 / LOCALLY_CONSTANT_IMP_CONSTANT
// Source hash: md5:d2f60a6bb73455f2170e497044f26518
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem LOCALLY_CONSTANT_IMP_CONSTANT : forall A N:set, A <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx N, f x :e A) -> forall s c= R :^: idx N, connected N s /\ (forall x :e R :^: idx N, x :e s -> exists u c= R :^: idx N, u :e subtopology (R :^: idx N) (euclidean N) s /\ (x :e u /\ forall x' :e R :^: idx N, x' :e u -> f x' = f x)) -> exists c :e A, forall x :e R :^: idx N, x :e s -> f x = c.
Admitted.

// HOL Light: Multivariate/topology.ml:1705 / limit_point_of
// Source hash: md5:b1072c345c679662f31e1e226633df66
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem limit_point_of_thm : forall A:set, A <> Empty -> forall x :e R :^: idx A, forall s c= R :^: idx A, limit_point_of A x s <-> forall t c= R :^: idx A, x :e t /\ open A t -> exists y :e R :^: idx A, ~ y = x /\ (y :e s /\ y :e t).
Admitted.

// HOL Light: Multivariate/topology.ml:1709 / EUCLIDEAN_DERIVED_SET_OF_IFF_LIMIT_POINT_OF
// Source hash: md5:09ae9d4cb9fd5dc84721278a530d5ae0
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem EUCLIDEAN_DERIVED_SET_OF_IFF_LIMIT_POINT_OF : forall N:set, N <> Empty -> forall s c= R :^: idx N, derived_set_of (R :^: idx N) (euclidean N) s = {x :e R :^: idx N | limit_point_of N x s}.
Admitted.

// HOL Light: Multivariate/topology.ml:1725 / LIMIT_POINT_IN_DERIVED_SET
// Source hash: md5:3c54a8ca5273b72e1077fb9376f69edd
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem LIMIT_POINT_IN_DERIVED_SET : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x :e R :^: idx N, limit_point_of N x s <-> x :e derived_set_of (R :^: idx N) (euclidean N) s.
Admitted.

// HOL Light: Multivariate/topology.ml:1729 / LIMPT_SUBSET
// Source hash: md5:f2ad4b70bfd09268ce14876183451173
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem LIMPT_SUBSET : forall A:set, A <> Empty -> forall x :e R :^: idx A, forall s t c= R :^: idx A, limit_point_of A x s /\ s c= t -> limit_point_of A x t.
Admitted.

// HOL Light: Multivariate/topology.ml:1733 / LIMPT_APPROACHABLE
// Source hash: md5:a802308776251678c64d4e36dcbb73f3
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem LIMPT_APPROACHABLE : forall A:set, A <> Empty -> forall x :e R :^: idx A, forall s c= R :^: idx A, limit_point_of A x s <-> forall e0 :e R, 0 < e0 -> exists x' :e R :^: idx A, x' :e s /\ (~ x' = x /\ distance A (x',x) < e0).
Admitted.

// HOL Light: Multivariate/topology.ml:1739 / LIMPT_APPROACHABLE_LE
// Source hash: md5:c95226f2524b973a50d785922a6baf08
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem LIMPT_APPROACHABLE_LE : forall A:set, A <> Empty -> forall x :e R :^: idx A, forall s c= R :^: idx A, limit_point_of A x s <-> forall e0 :e R, 0 < e0 -> exists x' :e R :^: idx A, x' :e s /\ (~ x' = x /\ distance A (x',x) <= e0).
Admitted.

// HOL Light: Multivariate/topology.ml:1747 / DISCRETE_SET
// Source hash: md5:d026566b73bf8d380b5de28f7a05f8ca
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem DISCRETE_SET : forall N:set, N <> Empty -> forall s t c= R :^: idx N, {x :e R :^: idx N | x :e t /\ limit_point_of N x s} = Empty <-> forall x :e R :^: idx N, x :e t -> exists e0 :e R, 0 < e0 /\ forall y :e R :^: idx N, y :e s /\ ~ y = x -> e0 <= sqrt_SNo_nonneg (dot N (vector_sub N y x) (vector_sub N y x)).
Admitted.

// HOL Light: Multivariate/topology.ml:1756 / CLOSED_LIMPT
// Source hash: md5:dd0f1e9c1c1bf28cbec7aaa3ccba81a9
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSED_LIMPT : forall A:set, A <> Empty -> forall s c= R :^: idx A, closed A s <-> forall x :e R :^: idx A, limit_point_of A x s -> x :e s.
Admitted.

// HOL Light: Multivariate/topology.ml:1761 / LIMPT_EMPTY
// Source hash: md5:c45124c8aa0b6ec582ca310329acefdc
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem LIMPT_EMPTY : forall A:set, A <> Empty -> forall x :e R :^: idx A, ~ limit_point_of A x Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:1765 / NO_LIMIT_POINT_IMP_CLOSED
// Source hash: md5:33bcea9ddd7e78acfa06be30fb66d284
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem NO_LIMIT_POINT_IMP_CLOSED : forall A:set, A <> Empty -> forall s c= R :^: idx A, ~ (exists x :e R :^: idx A, limit_point_of A x s) -> closed A s.
Admitted.

// HOL Light: Multivariate/topology.ml:1769 / CLOSED_POSITIVE_ORTHANT
// Source hash: md5:ee99c5296925da972cb0829ad0187587
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_real_R, nat_le_SNoLe, omega_Subq_R)
Theorem CLOSED_POSITIVE_ORTHANT : forall N:set, N <> Empty -> closed N {x :e R :^: idx N | forall i :e omega, 1 <= i /\ i <= dimindex N -> 0 <= x i}.
Admitted.

// HOL Light: Multivariate/topology.ml:1785 / FINITE_SET_AVOID
// Source hash: md5:3b78d3667959601ab39310c022a98af6
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_finite, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem FINITE_SET_AVOID : forall N:set, N <> Empty -> forall a :e R :^: idx N, forall s c= R :^: idx N, finite s -> exists d :e R, 0 < d /\ forall x :e R :^: idx N, x :e s /\ ~ x = a -> d <= distance N (a,x).
Admitted.

// HOL Light: Multivariate/topology.ml:1800 / LIMIT_POINT_FINITE
// Source hash: md5:01152477aa3838cd55757a014aaf2976
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_finite, hol_real_R)
Theorem LIMIT_POINT_FINITE : forall A:set, A <> Empty -> forall s c= R :^: idx A, forall a :e R :^: idx A, finite s -> ~ limit_point_of A a s.
Admitted.

// HOL Light: Multivariate/topology.ml:1807 / LIMPT_SING
// Source hash: md5:fbbc8a0d40ab4d44fb5a68cefd02bd9e
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem LIMPT_SING : forall N:set, N <> Empty -> forall x y :e R :^: idx N, ~ limit_point_of N x {y}.
Admitted.

// HOL Light: Multivariate/topology.ml:1811 / LIMIT_POINT_UNION
// Source hash: md5:ae80d7bfd7bb0880be455c35580009f0
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem LIMIT_POINT_UNION : forall N:set, N <> Empty -> forall s t c= R :^: idx N, forall x :e R :^: idx N, limit_point_of N x (s :\/: t) <-> limit_point_of N x s \/ limit_point_of N x t.
Admitted.

// HOL Light: Multivariate/topology.ml:1816 / LIMPT_INSERT
// Source hash: md5:4cb8e20ed9df99854c7ac27952c0e5e7
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem LIMPT_INSERT : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x y :e R :^: idx N, limit_point_of N x (SetAdjoin s y) <-> limit_point_of N x s.
Admitted.

// HOL Light: Multivariate/topology.ml:1822 / LIMPT_DELETE
// Source hash: md5:951a29b5d2ab166d8c4d058de00b0b74
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem LIMPT_DELETE : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall a x :e R :^: idx N, limit_point_of N x (s :\: {a}) <-> limit_point_of N x s.
Admitted.

// HOL Light: Multivariate/topology.ml:1829 / LIMIT_POINT_UNIONS
// Source hash: md5:456eaafd32fdfa00a6f3cb2990e80f9a
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_finite, hol_real_R)
Theorem LIMIT_POINT_UNIONS : forall N:set, N <> Empty -> forall f c= Power (R :^: idx N), forall x :e R :^: idx N, finite f -> (limit_point_of N x (Union f) <-> exists s c= R :^: idx N, s :e f /\ limit_point_of N x s).
Admitted.

// HOL Light: Multivariate/topology.ml:1838 / LIMPT_OF_LIMPTS
// Source hash: md5:11dd80436f6692efb4077528c41d2268
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem LIMPT_OF_LIMPTS : forall N:set, N <> Empty -> forall x :e R :^: idx N, forall s c= R :^: idx N, limit_point_of N x {y :e R :^: idx N | limit_point_of N y s} -> limit_point_of N x s.
