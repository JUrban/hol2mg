// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem locally_thm : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall P c= Power (R :^: idx N), locally N P s <-> forall w c= R :^: idx N, forall x :e R :^: idx N, w :e subtopology (R :^: idx N) (euclidean N) s /\ x :e w -> exists u v c= R :^: idx N, u :e subtopology (R :^: idx N) (euclidean N) s /\ (v :e P /\ (x :e u /\ (u c= v /\ v c= w))).
Admitted.

