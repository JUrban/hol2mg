// Source hash: md5:bf126dc62d94cd4f875c13772cd5bc16
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem LOCALLY_INJECTIVE_LINEAR_IMAGE : forall M N:set, M <> Empty -> N <> Empty -> forall P c= Power (R :^: idx N), forall Q c= Power (R :^: idx M), (forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, linear M N f /\ (forall x y :e R :^: idx M, f x = f y -> x = y) -> ({f x | x :e s} :e P <-> s :e Q)) -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, linear M N f /\ (forall x y :e R :^: idx M, f x = f y -> x = y) -> (locally N P {f x | x :e s} <-> locally M Q s).
Admitted.

