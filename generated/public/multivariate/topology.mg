// HOL Light: Multivariate/topology.ml:751 / open_in
// Source hash: md5:98358ac174aecf87998d1a5fdb82f85c
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, hol_typedef_topology, omega_Subq_R)
Theorem open_in : forall N:set, N <> Empty -> forall u s c= R :^: idx N, s :e subtopology (R :^: idx N) (euclidean N) u <-> s c= u /\ forall x :e R :^: idx N, x :e s -> exists e0 :e R, 0 < e0 /\ forall x' :e R :^: idx N, x' :e u /\ distance N (x',x) < e0 -> x' :e s.
Admitted.

