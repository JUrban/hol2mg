// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R, hol_typedef_topology)
Theorem HOMOEOMORPHISM_PASTE : forall M N:set, M <> Empty -> N <> Empty -> forall f :e R :^: idx N :^: (R :^: idx M), forall g :e R :^: idx M :^: (R :^: idx N), forall f' :e R :^: idx N :^: (R :^: idx M), forall g' :e R :^: idx M :^: (R :^: idx N), forall s c= R :^: idx M, forall t c= R :^: idx N, forall s' c= R :^: idx M, forall t' c= R :^: idx N, homeomorphism M N (s,t) (f,g) /\ (homeomorphism M N (s',t') (f',g') /\ ((s :e subtopology (R :^: idx M) (euclidean M) (s :\/: s') /\ (s' :e subtopology (R :^: idx M) (euclidean M) (s :\/: s') /\ (t :e subtopology (R :^: idx N) (euclidean N) (t :\/: t') /\ t' :e subtopology (R :^: idx N) (euclidean N) (t :\/: t'))) \/ closed_in (R :^: idx M) (subtopology (R :^: idx M) (euclidean M) (s :\/: s')) s /\ (closed_in (R :^: idx M) (subtopology (R :^: idx M) (euclidean M) (s :\/: s')) s' /\ (closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) (t :\/: t')) t /\ closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) (t :\/: t')) t'))) /\ ((forall x :e R :^: idx M, x :e s :/\: s' -> f' x = f x) /\ (forall y :e R :^: idx N, y :e t :/\: t' -> g' y = g y)))) -> exists h :e R :^: idx N :^: (R :^: idx M), exists k :e R :^: idx M :^: (R :^: idx N), homeomorphism M N (s :\/: s',t :\/: t') (h,k) /\ ((forall x :e R :^: idx M, x :e s -> h x = f x) /\ ((forall x :e R :^: idx M, x :e s' -> h x = f' x) /\ ((forall y :e R :^: idx N, y :e t -> k y = g y) /\ ((forall y :e R :^: idx N, y :e t' -> k y = g' y) /\ ({h x | x :e s} = t /\ ({h x | x :e s'} = t' /\ ({k x | x :e t} = s /\ ({k x | x :e t'} = s' /\ ({h x | x :e s :/\: s'} = t :/\: t' /\ ({h x | x :e s :\: s'} = t :\: t' /\ ({h x | x :e s' :\: s} = t' :\: t /\ ({k x | x :e t :/\: t'} = s :/\: s' /\ ({k x | x :e t :\: t'} = s :\: s' /\ {k x | x :e t' :\: t} = s' :\: s))))))))))))).
Admitted.

