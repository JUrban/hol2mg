// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_real_R)
Theorem BOREL_INDUCT_CLOSED_UNIONS_INTERS : forall N:set, N <> Empty -> forall P:set -> prop, (forall s c= R :^: idx N, closed N s -> P s) /\ ((forall u c= Power (R :^: idx N), countable u /\ (forall s c= R :^: idx N, s :e u -> P s) -> P (Union u)) /\ (forall u c= Power (R :^: idx N), countable u /\ (forall s c= R :^: idx N, s :e u -> P s) -> P {x :e R :^: idx N | forall Y :e u, x :e Y})) -> forall a c= R :^: idx N, borel N a -> P a.
Admitted.

