// HOL Light: Multivariate/topology.ml:8546 / LIFT_TO_QUOTIENT_SPACE
// Source hash: md5:bcf67b5073012fc1f1bf4af46d723b8a
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem LIFT_TO_QUOTIENT_SPACE : forall M N P:set, M <> Empty -> N <> Empty -> P <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall h:set -> set, (forall x :e R :^: idx M, h x :e R :^: idx P) -> forall s c= R :^: idx M, forall t c= R :^: idx N, forall u:set -> prop, {f x | x :e s} = t /\ ((forall v c= R :^: idx N, v c= t -> ({x :e R :^: idx M | x :e s /\ f x :e v} :e subtopology (R :^: idx M) (euclidean M) s <-> v :e subtopology (R :^: idx N) (euclidean N) t)) /\ (continuous_on_hl M P h s /\ ((forall x :e R :^: idx P, x :e {h x | x :e s} <-> u x) /\ (forall x y :e R :^: idx M, x :e s /\ (y :e s /\ f x = f y) -> h x = h y)))) -> exists g:set -> set, (forall x :e R :^: idx N, g x :e R :^: idx P) /\ (continuous_on_hl N P g t /\ ((forall x :e R :^: idx P, x :e {g x | x :e t} <-> u x) /\ forall x :e R :^: idx M, x :e s -> h x = g (f x))).
Admitted.

