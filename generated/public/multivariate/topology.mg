// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem HOMEOMORPHISM_EQ : forall M N:set, M <> Empty -> N <> Empty -> forall f :e R :^: idx N :^: (R :^: idx M), forall g :e R :^: idx M :^: (R :^: idx N), forall f' :e R :^: idx N :^: (R :^: idx M), forall g' :e R :^: idx M :^: (R :^: idx N), forall s c= R :^: idx M, forall t c= R :^: idx N, homeomorphism M N (s,t) (f,g) /\ ((forall x :e R :^: idx M, x :e s -> f' x = f x) /\ (forall y :e R :^: idx N, y :e t -> g' y = g y)) -> homeomorphism M N (s,t) (f',g').
Admitted.

