Admitted.

// HOL Light: Multivariate/topology.ml:15789 / CONNECTED_IVT_HYPERPLANE
// Source hash: md5:cb78d5a2ceb78eb88b5b58b67d92fe8c
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_IVT_HYPERPLANE : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x y a :e R :^: idx N, forall b :e R, connected N s /\ (x :e s /\ (y :e s /\ (dot N a x <= b /\ b <= dot N a y))) -> exists z :e R :^: idx N, z :e s /\ dot N a z = b.
Admitted.

// HOL Light: Multivariate/topology.ml:15804 / CONNECTED_IVT_COMPONENT
