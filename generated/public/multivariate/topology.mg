Theorem SILVERMAN_STEINHAUSLIKE : forall N:set, N <> Empty -> forall s t c= R :^: idx N, gdelta N s /\ (gdelta N t /\ (R :^: idx N c= closure N s /\ R :^: idx N c= closure N t)) -> (\/_ x :e R :^: idx N, {vector_add N x y | y :e R :^: idx N, x :e s /\ y :e t}) = R :^: idx N.
Admitted.

