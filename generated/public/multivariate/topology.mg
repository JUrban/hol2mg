// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem EUCLIDEAN_CLOSURE_OF : forall N:set, N <> Empty -> forall s c= R :^: idx N, closure_of (R :^: idx N) (euclidean N) s = closure N s.
