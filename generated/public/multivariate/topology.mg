Theorem COVARIANCE_UNIQUE_UP_TO_ORTHOGONAL : forall N:set, N <> Empty -> forall A B :e R :^: idx N :^: idx N, matrix_mul N N N (transp N N A) A = matrix_mul N N N (transp N N B) B <-> exists U :e R :^: idx N :^: idx N, orthogonal_matrix_hl N U /\ matrix_mul N N N U A = B.
Admitted.

