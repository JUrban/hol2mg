// Source hash: md5:4ecd0b1e6eb731ea94b83872eb32ce93
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem COMPONENTS_EMPTY : forall A:set, A <> Empty -> components A Empty = Empty.
Admitted.

