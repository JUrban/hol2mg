// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem BOUNDED_LINEAR_IMAGE : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, bounded_hl M s /\ linear M N f -> bounded_hl N {f x | x :e s}.
Admitted.

// HOL Light: Multivariate/topology.ml:5093 / BOUNDED_LINEAR_IMAGE_EQ
// Source hash: md5:74f781699d0ff2f0b1b862f25e605b2a
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem BOUNDED_LINEAR_IMAGE_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e R :^: idx B, f x :e R :^: idx A) -> forall s c= R :^: idx B, linear B A f /\ (forall x y :e R :^: idx B, f x = f y -> x = y) -> (bounded_hl A {f x | x :e s} <-> bounded_hl B s).
Admitted.

