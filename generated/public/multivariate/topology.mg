// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_real_R, nat_le_SNoLe)
Theorem CONNECTED_IVT_COMPONENT : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x y :e R :^: idx N, forall a :e R, forall k :e omega, connected N s /\ (x :e s /\ (y :e s /\ (1 <= k /\ (k <= dimindex N /\ (x k <= a /\ a <= y k))))) -> exists z :e R :^: idx N, z :e s /\ z k = a.
Admitted.

