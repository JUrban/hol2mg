// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem INTERIOR_UNION_EQ_EMPTY : forall N:set, N <> Empty -> forall s t c= R :^: idx N, closed N s \/ closed N t -> (interior N (s :\/: t) = Empty <-> interior N s = Empty /\ interior N t = Empty).
