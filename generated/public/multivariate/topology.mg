// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONNECTED_LIMIT_POINTS : forall N:set, N <> Empty -> forall s c= R :^: idx N, connected N s -> connected N {x :e R :^: idx N | limit_point_of N x s}.
Admitted.

