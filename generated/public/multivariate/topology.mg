// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem IN_CLOSURE_DELETE : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x :e R :^: idx N, x :e closure N (s :\: {x}) <-> limit_point_of N x s.
Admitted.

