// Source hash: md5:ef33be69bb6f683122258ec4b6cf515f
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_finite, hol_real_R)
Theorem OPEN_IMP_INFINITE : forall A:set, A <> Empty -> forall s c= R :^: idx A, open A s -> s = Empty \/ infinite s.
Admitted.

