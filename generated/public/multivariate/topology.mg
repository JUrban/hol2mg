// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem INTERIOR_INTER : forall N:set, N <> Empty -> forall s t c= R :^: idx N, interior N (s :/\: t) = interior N s :/\: interior N t.
