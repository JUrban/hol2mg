// Status: transport_required (bridges: hol_cart_setexp, hol_finite_finite, hol_real_R)
Theorem FINITE_IMP_TOTALLY_DISCONNECTED : forall N:set, N <> Empty -> forall s c= R :^: idx N, finite s -> components N s = {{x0 :e R :^: idx N | x0 :e {x}} | x :e s}.
Admitted.

// HOL Light: Multivariate/topology.ml:17857 / CONTINUOUS_DISCONNECTED_RANGE_CONSTANT
// Source hash: md5:8c93138c01a856743bb7e14c5e497614
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONTINUOUS_DISCONNECTED_RANGE_CONSTANT : forall M N:set, M <> Empty -> N <> Empty -> forall t c= R :^: idx N, forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, connected M s /\ (continuous_on_hl M N f s /\ ({f x | x :e s} c= t /\ (forall y :e R :^: idx N, y :e t -> forall x :e R :^: idx N, connected_component N t y x <-> x :e SetAdjoin Empty y))) -> exists a :e R :^: idx N, forall x :e R :^: idx M, x :e s -> f x = a.
Admitted.

// HOL Light: Multivariate/topology.ml:17865 / CONTINUOUS_DISCRETE_RANGE_CONSTANT
// Source hash: md5:3153ad1a068d3cf797fd7aca017513b4
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem CONTINUOUS_DISCRETE_RANGE_CONSTANT : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, connected M s /\ (continuous_on_hl M N f s /\ (forall x :e R :^: idx M, x :e s -> exists e0 :e R, 0 < e0 /\ forall y :e R :^: idx M, y :e s /\ ~ f y = f x -> e0 <= sqrt_SNo_nonneg (dot N (vector_sub N (f y) (f x)) (vector_sub N (f y) (f x))))) -> exists a :e R :^: idx N, forall x :e R :^: idx M, x :e s -> f x = a.
Admitted.

// HOL Light: Multivariate/topology.ml:17877 / CONTINUOUS_FINITE_RANGE_CONSTANT
// Source hash: md5:a04cd6ee739206d8c655cce34db29b30
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_finite, hol_real_R)
Theorem CONTINUOUS_FINITE_RANGE_CONSTANT : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, connected M s /\ (continuous_on_hl M N f s /\ finite {f x | x :e s}) -> exists a :e R :^: idx N, forall x :e R :^: idx M, x :e s -> f x = a.
Admitted.

// HOL Light: Multivariate/topology.ml:17885 / CONTINUOUS_COUNTABLE_RANGE_CONSTANT_EQ
// Source hash: md5:313c902abff890b86a57755b4d4d5252
// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_real_R)
Theorem CONTINUOUS_COUNTABLE_RANGE_CONSTANT_EQ : forall M N:set, M <> Empty -> N <> Empty -> forall s c= R :^: idx M, connected M s <-> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> continuous_on_hl M N f s /\ countable {f x | x :e s} -> exists a :e R :^: idx N, forall x :e R :^: idx M, x :e s -> f x = a.
Admitted.

// HOL Light: Multivariate/topology.ml:17898 / CONTINUOUS_CARD_LT_RANGE_CONSTANT_EQ
// Source hash: md5:3728cca347f32d82582fb924c8d9b151
// Status: transport_required (bridges: hol_cart_setexp, hol_eq_c_equip, hol_real_R)
Theorem CONTINUOUS_CARD_LT_RANGE_CONSTANT_EQ : forall M N:set, M <> Empty -> N <> Empty -> forall s c= R :^: idx M, connected M s <-> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> continuous_on_hl M N f s /\ (atleastp {f x | x :e s} R /\ ~ equip {f x | x :e s} R) -> exists a :e R :^: idx N, forall x :e R :^: idx M, x :e s -> f x = a.
Admitted.

// HOL Light: Multivariate/topology.ml:17911 / CONTINUOUS_COUNTABLE_RANGE_CONSTANT
// Source hash: md5:378f7c0fa01ac5ea168db89eb7590331
// Status: transport_required (bridges: hol_cart_setexp, hol_countable, hol_real_R)
Theorem CONTINUOUS_COUNTABLE_RANGE_CONSTANT : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, connected M s /\ (continuous_on_hl M N f s /\ countable {f x | x :e s}) -> exists a :e R :^: idx N, forall x :e R :^: idx M, x :e s -> f x = a.
Admitted.

// HOL Light: Multivariate/topology.ml:17917 / CONTINUOUS_CARD_LT_RANGE_CONSTANT
// Source hash: md5:a1e1219c5a6dba8e5e9b7d10c84f385b
// Status: transport_required (bridges: hol_cart_setexp, hol_eq_c_equip, hol_real_R)
Theorem CONTINUOUS_CARD_LT_RANGE_CONSTANT : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, connected M s /\ (continuous_on_hl M N f s /\ (atleastp {f x | x :e s} R /\ ~ equip {f x | x :e s} R)) -> exists a :e R :^: idx N, forall x :e R :^: idx M, x :e s -> f x = a.
Admitted.

// HOL Light: Multivariate/topology.ml:17927 / HOMEOMORPHIC_HYPERPLANES
// Source hash: md5:aa6901330e045e2fa352c37a4574d742
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R)
Theorem HOMEOMORPHIC_HYPERPLANES : forall N:set, N <> Empty -> forall a :e R :^: idx N, forall b :e R, forall c :e R :^: idx N, forall d :e R, ~ a = vec N 0 /\ ~ c = vec N 0 -> homeomorphic N N {x :e R :^: idx N | dot N a x = b} {x :e R :^: idx N | dot N c x = d}.
Admitted.

// HOL Light: Multivariate/topology.ml:17956 / HOMEOMORPHIC_HYPERPLANE_STANDARD_HYPERPLANE
// Source hash: md5:66fcb48f2dd4c2f4c27e3f0c7b080ee4
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_real_R, nat_le_SNoLe)
Theorem HOMEOMORPHIC_HYPERPLANE_STANDARD_HYPERPLANE : forall N:set, N <> Empty -> forall a :e R :^: idx N, forall b :e R, forall k :e omega, forall c :e R, ~ a = vec N 0 /\ (1 <= k /\ k <= dimindex N) -> homeomorphic N N {x :e R :^: idx N | dot N a x = b} {x :e R :^: idx N | x k = c}.
Admitted.

// HOL Light: Multivariate/topology.ml:17965 / HOMEOMORPHIC_STANDARD_HYPERPLANE_HYPERPLANE
// Source hash: md5:3b967c78a068fb70615883939882f391
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_real_R, nat_le_SNoLe)
Theorem HOMEOMORPHIC_STANDARD_HYPERPLANE_HYPERPLANE : forall N:set, N <> Empty -> forall a :e R :^: idx N, forall b :e R, forall k :e omega, forall c :e R, ~ a = vec N 0 /\ (1 <= k /\ k <= dimindex N) -> homeomorphic N N {x :e R :^: idx N | x k = c} {x :e R :^: idx N | dot N a x = b}.
Admitted.

// HOL Light: Multivariate/topology.ml:17972 / HOMEOMORPHIC_HYPERPLANE_UNIV
// Source hash: md5:21a762015c3da7be561c66da759f224c
// Status: transport_required (bridges: add_nat_add_SNo, hol_cart_setexp, hol_dimindex, hol_num_omega, hol_real_R)
Theorem HOMEOMORPHIC_HYPERPLANE_UNIV : forall M N:set, M <> Empty -> N <> Empty -> forall a :e R :^: idx N, forall b :e R, ~ a = vec N 0 /\ dimindex N = dimindex M + 1 -> homeomorphic M N {x :e R :^: idx N | dot N a x = b} (R :^: idx M).
Admitted.

// HOL Light: Multivariate/topology.ml:18008 / CAUCHY_ISOMETRIC
// Source hash: md5:9ef96be4b655a6054321f585c4ce72ad
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem CAUCHY_ISOMETRIC : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e R :^: idx B, f x :e R :^: idx A) -> forall s c= R :^: idx B, forall e0 :e R, forall x:set -> set, (forall x :e omega, x x :e R :^: idx B) -> 0 < e0 /\ (subspace B s /\ (linear B A f /\ ((forall x0 :e R :^: idx B, x0 :e s -> e0 * sqrt_SNo_nonneg (dot B x0 x0) <= sqrt_SNo_nonneg (dot A (f x0) (f x0))) /\ ((forall n :e omega, x n :e s) /\ cauchy A (fun x0:set => f (x x0)))))) -> cauchy B x.
Admitted.

// HOL Light: Multivariate/topology.ml:18041 / INJECTIVE_IMP_ISOMETRIC
// Source hash: md5:eb133fd109a505804c5131cb12ba1caf
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem INJECTIVE_IMP_ISOMETRIC : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, closed M s /\ (subspace M s /\ (linear M N f /\ (forall x :e R :^: idx M, x :e s /\ f x = vec N 0 -> x = vec M 0))) -> exists e0 :e R, 0 < e0 /\ forall x :e R :^: idx M, x :e s -> e0 * sqrt_SNo_nonneg (dot M x x) <= sqrt_SNo_nonneg (dot N (f x) (f x)).
Admitted.

// HOL Light: Multivariate/topology.ml:18096 / CLOSED_INJECTIVE_IMAGE_SUBSPACE
// Source hash: md5:c592580b71c479c36cefaa79248b5c9f
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R)
Theorem CLOSED_INJECTIVE_IMAGE_SUBSPACE : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e R :^: idx B, f x :e R :^: idx A) -> forall s c= R :^: idx B, subspace B s /\ (linear B A f /\ ((forall x :e R :^: idx B, x :e s /\ f x = vec A 0 -> x = vec B 0) /\ closed B s)) -> closed A {f x | x :e s}.
Admitted.

