Theorem HOMEOMORPHISM_COMPOSE : forall M N P:set, M <> Empty -> N <> Empty -> P <> Empty -> forall f :e R :^: idx N :^: (R :^: idx M), forall g :e R :^: idx M :^: (R :^: idx N), forall h :e R :^: idx P :^: (R :^: idx N), forall k :e R :^: idx N :^: (R :^: idx P), forall s c= R :^: idx M, forall t c= R :^: idx N, forall u c= R :^: idx P, homeomorphism M N (s,t) (f,g) /\ homeomorphism N P (t,u) (h,k) -> homeomorphism M P (s,u) (fun x :e R :^: idx M => h (f x),fun x :e R :^: idx P => g (k x)).
Admitted.

