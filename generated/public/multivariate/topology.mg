// Source hash: md5:478423f5e5327a32c99d6834dc2eac4c
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem FORALL_IN_INTERMEDIATE_CLOSURE_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e R :^: idx B, f x :e R :^: idx A) -> forall s s' c= R :^: idx B, forall t c= R :^: idx A, closed A t /\ (continuous_on_hl B A f s' /\ (s c= s' /\ s' c= closure B s)) -> ((forall x :e R :^: idx B, x :e s' -> f x :e t) <-> forall x :e R :^: idx B, x :e s -> f x :e t).
Admitted.

