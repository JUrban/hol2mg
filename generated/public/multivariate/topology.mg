// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem POSITIVE_SEMIDEFINITE_MUL : forall N:set, N <> Empty -> forall A B :e R :^: idx N :^: idx N, positive_semidefinite N A /\ (positive_semidefinite N B /\ matrix_mul N N N A B = matrix_mul N N N B A) -> positive_semidefinite N (matrix_mul N N N A B).
Admitted.

// HOL Light: Multivariate/topology.ml:20921 / POSITIVE_DEFINITE_MUL_EQ
