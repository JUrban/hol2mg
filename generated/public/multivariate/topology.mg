// Status: transport_required (bridges: hol_cart_setexp, hol_eq_c_equip, hol_real_R)
Theorem CARD_EQ_OPEN : forall N:set, N <> Empty -> forall s c= R :^: idx N, open N s /\ ~ s = Empty -> equip s R.
Admitted.

