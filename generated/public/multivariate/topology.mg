// HOL Light: Multivariate/topology.ml:10354 / LIPSCHITZ_ON_SUP
// Source hash: md5:32ad8eaf4ebdc6d947a67b5ef2c57d92
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_one_1, hol_real_R, omega_Subq_R)
Theorem LIPSCHITZ_ON_SUP : forall N:set, N <> Empty -> forall P:set -> prop, forall B :e R, forall s c= R :^: idx N, 0 <= B /\ ((forall f :e R :^: idx 1 :^: (R :^: idx N), P f -> forall x y :e R :^: idx N, x :e s /\ y :e s -> sqrt_SNo_nonneg (dot 1 (vector_sub 1 (f x) (f y)) (vector_sub 1 (f x) (f y))) <= B * sqrt_SNo_nonneg (dot N (vector_sub N x y) (vector_sub N x y))) /\ (forall x :e R :^: idx N, x :e s -> exists C :e R, forall f :e R :^: idx 1 :^: (R :^: idx N), P f -> drop (f x) <= C)) -> forall x y :e R :^: idx N, x :e s /\ y :e s -> sqrt_SNo_nonneg (dot 1 (vector_sub 1 (lift (sup {drop (f x) | f :e R :^: idx 1 :^: (R :^: idx N), P f})) (lift (sup {drop (f y) | f :e R :^: idx 1 :^: (R :^: idx N), P f}))) (vector_sub 1 (lift (sup {drop (f x) | f :e R :^: idx 1 :^: (R :^: idx N), P f})) (lift (sup {drop (f y) | f :e R :^: idx 1 :^: (R :^: idx N), P f})))) <= B * sqrt_SNo_nonneg (dot N (vector_sub N x y) (vector_sub N x y)).
Admitted.

// HOL Light: Multivariate/topology.ml:10387 / LIPSCHITZ_ON_INF
// Source hash: md5:3f5588cd1ac7660ee1c57391349592f9
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_one_1, hol_real_R, omega_Subq_R)
Theorem LIPSCHITZ_ON_INF : forall N:set, N <> Empty -> forall P:set -> prop, forall B :e R, forall s c= R :^: idx N, 0 <= B /\ ((forall f :e R :^: idx 1 :^: (R :^: idx N), P f -> forall x y :e R :^: idx N, x :e s /\ y :e s -> sqrt_SNo_nonneg (dot 1 (vector_sub 1 (f x) (f y)) (vector_sub 1 (f x) (f y))) <= B * sqrt_SNo_nonneg (dot N (vector_sub N x y) (vector_sub N x y))) /\ (forall x :e R :^: idx N, x :e s -> exists C :e R, forall f :e R :^: idx 1 :^: (R :^: idx N), P f -> C <= drop (f x))) -> forall x y :e R :^: idx N, x :e s /\ y :e s -> sqrt_SNo_nonneg (dot 1 (vector_sub 1 (lift (inf {drop (f x) | f :e R :^: idx 1 :^: (R :^: idx N), P f})) (lift (inf {drop (f y) | f :e R :^: idx 1 :^: (R :^: idx N), P f}))) (vector_sub 1 (lift (inf {drop (f x) | f :e R :^: idx 1 :^: (R :^: idx N), P f})) (lift (inf {drop (f y) | f :e R :^: idx 1 :^: (R :^: idx N), P f})))) <= B * sqrt_SNo_nonneg (dot N (vector_sub N x y) (vector_sub N x y)).
Admitted.

// HOL Light: Multivariate/topology.ml:10517 / CONTINUOUS_ON_AVOID
// Source hash: md5:48271360790ca32c2d067d400c714b1a
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem CONTINUOUS_ON_AVOID : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall x :e R :^: idx M, forall s c= R :^: idx M, forall a :e R :^: idx N, continuous_on_hl M N f s /\ (x :e s /\ ~ f x = a) -> exists e0 :e R, 0 < e0 /\ forall y :e R :^: idx M, y :e s /\ distance M (x,y) < e0 -> ~ f y = a.
Admitted.

// HOL Light: Multivariate/topology.ml:10525 / CONTINUOUS_ON_OPEN_AVOID
// Source hash: md5:1fad2dcbc090acf4993e7837225c4021
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem CONTINUOUS_ON_OPEN_AVOID : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall x :e R :^: idx M, forall s c= R :^: idx M, forall a :e R :^: idx N, continuous_on_hl M N f s /\ (open M s /\ (x :e s /\ ~ f x = a)) -> exists e0 :e R, 0 < e0 /\ forall y :e R :^: idx M, distance M (x,y) < e0 -> ~ f y = a.
Admitted.

// HOL Light: Multivariate/topology.ml:10538 / CONTINUOUS_LEVELSET_OPEN_IN_CASES
// Source hash: md5:9286cdd27a0c14b8ff09c369e4200ced
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CONTINUOUS_LEVELSET_OPEN_IN_CASES : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, forall a :e R :^: idx N, connected M s /\ (continuous_on_hl M N f s /\ {x :e R :^: idx M | x :e s /\ f x = a} :e subtopology (R :^: idx M) (euclidean M) s) -> (forall x :e R :^: idx M, x :e s -> ~ f x = a) \/ forall x :e R :^: idx M, x :e s -> f x = a.
Admitted.

// HOL Light: Multivariate/topology.ml:10552 / CONTINUOUS_LEVELSET_OPEN_IN
// Source hash: md5:ac6f7de8a06d78e0b55d9dc535d94a01
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CONTINUOUS_LEVELSET_OPEN_IN : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, forall a :e R :^: idx N, connected M s /\ (continuous_on_hl M N f s /\ ({x :e R :^: idx M | x :e s /\ f x = a} :e subtopology (R :^: idx M) (euclidean M) s /\ (exists x :e R :^: idx M, x :e s /\ f x = a))) -> forall x :e R :^: idx M, x :e s -> f x = a.
Admitted.

// HOL Light: Multivariate/topology.ml:10561 / CONTINUOUS_LEVELSET_OPEN
// Source hash: md5:de10a84246f040f885e948e98fbc27b3
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CONTINUOUS_LEVELSET_OPEN : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, forall a :e R :^: idx N, connected M s /\ (continuous_on_hl M N f s /\ (open M {x :e R :^: idx M | x :e s /\ f x = a} /\ (exists x :e R :^: idx M, x :e s /\ f x = a))) -> forall x :e R :^: idx M, x :e s -> f x = a.
Admitted.

// HOL Light: Multivariate/topology.ml:10578 / OPEN_SCALING
// Source hash: md5:17dd2c67f06a5a72b3e0371f32d59e46
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem OPEN_SCALING : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall c :e R, ~ c = 0 /\ open N s -> open N {vector_mul N c x | x :e s}.
Admitted.

// HOL Light: Multivariate/topology.ml:10596 / OPEN_SCALING_EQ
// Source hash: md5:5e99e2520b488f844fca4387ee5aa737
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R, omega_Subq_R)
Theorem OPEN_SCALING_EQ : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall c :e R, open N {vector_mul N c x | x :e s} <-> (c = 0 -> s = Empty) /\ open N s.
Admitted.

// HOL Light: Multivariate/topology.ml:10608 / OPEN_NEGATIONS
// Source hash: md5:02ee2dd7ba89a2e9ee8419cec89baf9f
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem OPEN_NEGATIONS : forall N:set, N <> Empty -> forall s c= R :^: idx N, open N s -> open N {vector_neg N x | x :e s}.
Admitted.

// HOL Light: Multivariate/topology.ml:10614 / OPEN_TRANSLATION
