// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem BOUNDED_DIFF : forall A:set, A <> Empty -> forall s t c= R :^: idx A, bounded_hl A s -> bounded_hl A (s :\: t).
Admitted.

