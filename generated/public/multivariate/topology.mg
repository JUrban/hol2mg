// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem LIMPT_OF_OPEN : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x :e R :^: idx N, open N s /\ x :e s -> limit_point_of N x s.
