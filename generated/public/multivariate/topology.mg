// Status: transport_required (bridges: hol_card_finite_cardinality, hol_cart_setexp, hol_finite_finite, hol_num_omega, hol_real_R, nat_le_SNoLe)
Theorem CONNECTED_EQ_CARD_COMPONENTS : forall N:set, N <> Empty -> forall s c= R :^: idx N, connected N s <-> finite (components N s) /\ finite_cardinality (components N s) <= 1.
Admitted.

