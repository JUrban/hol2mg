Theorem UNIFORMLY_CONTINUOUS_MAP_PASTED : forall A M N:set, A <> Empty -> M <> Empty -> N <> Empty -> forall m :e metric A, forall f:set -> set, (forall x :e A, f x :e R :^: idx M) -> forall g:set -> set, (forall x :e A, g x :e R :^: idx N) -> (uniformly_continuous_map (R :^: idx_n (dimindex M + dimindex N)) A (m,euclidean_metric (idx_n (dimindex M + dimindex N))) (fun x:set => pastecart M N (f x) (g x)) <-> uniformly_continuous_map (R :^: idx M) A (m,euclidean_metric M) f /\ uniformly_continuous_map (R :^: idx N) A (m,euclidean_metric N) g).
Admitted.

