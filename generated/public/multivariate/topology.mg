// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CLOSED_IN_COMPONENT : forall N:set, N <> Empty -> forall s c c= R :^: idx N, c :e components N s -> closed_in (R :^: idx N) (subtopology (R :^: idx N) (euclidean N) s) c.
Admitted.

// HOL Light: Multivariate/topology.ml:11477 / CLOSED_COMPONENTS
// Source hash: md5:473ab22ee4a0eb69b71353ff1b55a9db
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem CLOSED_COMPONENTS : forall A:set, A <> Empty -> forall s c c= R :^: idx A, closed A s /\ c :e components A s -> closed A c.
Admitted.

// HOL Light: Multivariate/topology.ml:11493 / CONTINUOUS_ON_COMPONENTS_GEN
// Source hash: md5:e7ef6139a3461633510cc8480c0baef7
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R, hol_typedef_topology)
Theorem CONTINUOUS_ON_COMPONENTS_GEN : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, (forall c c= R :^: idx M, c :e components M s -> c :e subtopology (R :^: idx M) (euclidean M) s /\ continuous_on_hl M N f c) -> continuous_on_hl M N f s.
Admitted.

// HOL Light: Multivariate/topology.ml:11510 / CONTINUOUS_ON_COMPONENTS_FINITE
// Source hash: md5:abd90da23562e5f5ee868604f9926646
// Status: transport_required (bridges: hol_cart_setexp, hol_finite_finite, hol_real_R)
Theorem CONTINUOUS_ON_COMPONENTS_FINITE : forall M N:set, M <> Empty -> N <> Empty -> forall f:set -> set, (forall x :e R :^: idx M, f x :e R :^: idx N) -> forall s c= R :^: idx M, finite (components M s) /\ (forall c c= R :^: idx M, c :e components M s -> continuous_on_hl M N f c) -> continuous_on_hl M N f s.
Admitted.

// HOL Light: Multivariate/topology.ml:11528 / COMPONENTS_NONOVERLAP
// Source hash: md5:c93a8b21ef1423afe944949c54c5da3f
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem COMPONENTS_NONOVERLAP : forall A:set, A <> Empty -> forall s c c' c= R :^: idx A, c :e components A s /\ c' :e components A s -> (c :/\: c' = Empty <-> ~ c = c').
Admitted.

// HOL Light: Multivariate/topology.ml:11534 / COMPONENTS_EQ
// Source hash: md5:d649a7344cb0918ecfa84baec3ac5e8e
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem COMPONENTS_EQ : forall A:set, A <> Empty -> forall s c c' c= R :^: idx A, c :e components A s /\ c' :e components A s -> (c = c' <-> ~ c :/\: c' = Empty).
Admitted.

