// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem BOUNDED_SUBSET_CBALL : forall N:set, N <> Empty -> forall s c= R :^: idx N, forall x :e R :^: idx N, bounded_hl N s -> exists r :e R, 0 < r /\ s c= cball N (x,r).
Admitted.

// HOL Light: Multivariate/topology.ml:5210 / UNBOUNDED_INTER_COBOUNDED
// Source hash: md5:1db2bfa3e1dd9fb9ac42dcf265410632
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem UNBOUNDED_INTER_COBOUNDED : forall N:set, N <> Empty -> forall s t c= R :^: idx N, ~ bounded_hl N s /\ bounded_hl N ((R :^: idx N) :\: t) -> ~ s :/\: t = Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:5215 / COBOUNDED_INTER_UNBOUNDED
// Source hash: md5:80aac91556df6c4ddcce4629705d942c
// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem COBOUNDED_INTER_UNBOUNDED : forall N:set, N <> Empty -> forall s t c= R :^: idx N, bounded_hl N ((R :^: idx N) :\: s) /\ ~ bounded_hl N t -> ~ s :/\: t = Empty.
Admitted.

// HOL Light: Multivariate/topology.ml:5220 / SUBSPACE_BOUNDED_EQ_TRIVIAL
// Source hash: md5:a1637be09fb088737b12bcb696237144
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_real_R)
Theorem SUBSPACE_BOUNDED_EQ_TRIVIAL : forall N:set, N <> Empty -> forall s c= R :^: idx N, subspace N s -> (bounded_hl N s <-> s = {vec N 0}).
Admitted.

// HOL Light: Multivariate/topology.ml:5233 / BOUNDED_COMPONENTWISE
// Source hash: md5:15f87f7739e32f80d677df39cdadae96
// Status: transport_required (bridges: hol_cart_setexp, hol_dimindex, hol_num_omega, hol_one_1, hol_real_R, nat_le_SNoLe)
Theorem BOUNDED_COMPONENTWISE : forall N:set, N <> Empty -> forall s c= R :^: idx N, bounded_hl N s <-> forall i :e omega, 1 <= i /\ i <= dimindex N -> bounded_hl 1 {lift (x i) | x :e s}.
Admitted.

// HOL Light: Multivariate/topology.ml:5253 / BOUNDED_SUBSET_OPEN_INTERVAL_SYMMETRIC
// Source hash: md5:278b98a552b6de8ea72c79e5834e0c53
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem BOUNDED_SUBSET_OPEN_INTERVAL_SYMMETRIC : forall N:set, N <> Empty -> forall s c= R :^: idx N, bounded_hl N s -> exists a :e R :^: idx N, s c= open_interval N (vector_neg N a,a).
Admitted.

// HOL Light: Multivariate/topology.ml:5263 / BOUNDED_SUBSET_OPEN_INTERVAL
// Source hash: md5:8b47d61a0420aa1a5e4c10de4c69a892
// Status: transport_required (bridges: hol_cart_setexp, hol_prod_setprod, hol_real_R)
Theorem BOUNDED_SUBSET_OPEN_INTERVAL : forall N:set, N <> Empty -> forall s c= R :^: idx N, bounded_hl N s -> exists a b :e R :^: idx N, s c= open_interval N (a,b).
Admitted.

// HOL Light: Multivariate/topology.ml:5267 / BOUNDED_SUBSET_CLOSED_INTERVAL_SYMMETRIC
// Source hash: md5:e8517ab24f8d22bacda3fe288eac2fee
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem BOUNDED_SUBSET_CLOSED_INTERVAL_SYMMETRIC : forall N:set, N <> Empty -> forall s c= R :^: idx N, bounded_hl N s -> exists a :e R :^: idx N, s c= closed_interval N (seq_cons (vector_neg N a,a) seq_nil).
Admitted.

// HOL Light: Multivariate/topology.ml:5274 / BOUNDED_SUBSET_CLOSED_INTERVAL
// Source hash: md5:a2149607d853c0c34dfe24789470f51e
// Status: transport_required (bridges: hol_cart_setexp, hol_list_finseq, hol_prod_setprod, hol_real_R)
Theorem BOUNDED_SUBSET_CLOSED_INTERVAL : forall N:set, N <> Empty -> forall s c= R :^: idx N, bounded_hl N s -> exists a b :e R :^: idx N, s c= closed_interval N (seq_cons (a,b) seq_nil).
Admitted.

// HOL Light: Multivariate/topology.ml:5282 / BOUNDED_LIFT
// Source hash: md5:3d103e049066acb474687910bce89807
// Status: transport_required (bridges: hol_cart_setexp, hol_one_1, hol_real_R)
Theorem BOUNDED_LIFT : forall s c= R, bounded_hl 1 {lift x | x :e s} <-> exists a :e R, forall x :e R, x :e s -> abs_SNo x <= a.
Admitted.

// HOL Light: Multivariate/topology.ml:5286 / BOUNDED_HAS_SUP
// Source hash: md5:731f4fb2188e4a19a2273fd24c127d8f
// Status: transport_required (bridges: hol_cart_setexp, hol_one_1, hol_real_R)
Theorem BOUNDED_HAS_SUP : forall s c= R, bounded_hl 1 {lift x | x :e s} /\ ~ s = Empty -> (forall x :e R, x :e s -> x <= sup s) /\ forall b :e R, (forall x :e R, x :e s -> x <= b) -> sup s <= b.
Admitted.

// HOL Light: Multivariate/topology.ml:5293 / SUP_INSERT
// Source hash: md5:74a077247e1787d495b77b991b228ba5
// Status: transport_required (bridges: hol_cart_setexp, hol_one_1, hol_real_R)
Theorem SUP_INSERT : forall x :e R, forall s c= R, bounded_hl 1 {lift x0 | x0 :e s} -> sup (SetAdjoin s x) = if s = Empty then x else if x <= sup s then sup s else x.
Admitted.

// HOL Light: Multivariate/topology.ml:5303 / BOUNDED_HAS_INF
// Source hash: md5:3f1babb18a0071e43cab690040dcb223
// Status: transport_required (bridges: hol_cart_setexp, hol_one_1, hol_real_R)
Theorem BOUNDED_HAS_INF : forall s c= R, bounded_hl 1 {lift x | x :e s} /\ ~ s = Empty -> (forall x :e R, x :e s -> inf s <= x) /\ forall b :e R, (forall x :e R, x :e s -> b <= x) -> b <= inf s.
Admitted.

// HOL Light: Multivariate/topology.ml:5310 / INF_INSERT
// Source hash: md5:571102bcc62cae645a7eb236ae9c9c90
// Status: transport_required (bridges: hol_cart_setexp, hol_one_1, hol_real_R)
Theorem INF_INSERT : forall x :e R, forall s c= R, bounded_hl 1 {lift x0 | x0 :e s} -> inf (SetAdjoin s x) = if s = Empty then x else if x <= inf s then x else inf s.
Admitted.

// HOL Light: Multivariate/topology.ml:5324 / SUBSET_BALLS
// Source hash: md5:04a55bf59c9efca59d9d251683a5897e
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem SUBSET_BALLS : forall N:set, N <> Empty -> (forall a a' :e R :^: idx N, forall r r' :e R, ball N (a,r) c= ball N (a',r') <-> distance N (a,a') + r <= r' \/ r <= 0) /\ ((forall a a' :e R :^: idx N, forall r r' :e R, ball N (a,r) c= cball N (a',r') <-> distance N (a,a') + r <= r' \/ r <= 0) /\ ((forall a a' :e R :^: idx N, forall r r' :e R, cball N (a,r) c= ball N (a',r') <-> distance N (a,a') + r < r' \/ r < 0) /\ forall a a' :e R :^: idx N, forall r r' :e R, cball N (a,r) c= cball N (a',r') <-> distance N (a,a') + r <= r' \/ r < 0)).
Admitted.

// HOL Light: Multivariate/topology.ml:5367 / INTER_BALLS_EQ_EMPTY
// Source hash: md5:68dd65f697f1c907fc1744ad687f0256
// Status: transport_required (bridges: hol_cart_setexp, hol_num_omega, hol_prod_setprod, hol_real_R, omega_Subq_R)
Theorem INTER_BALLS_EQ_EMPTY : forall N:set, N <> Empty -> (forall a b :e R :^: idx N, forall r s :e R, ball N (a,r) :/\: ball N (b,s) = Empty <-> r <= 0 \/ (s <= 0 \/ r + s <= distance N (a,b))) /\ ((forall a b :e R :^: idx N, forall r s :e R, ball N (a,r) :/\: cball N (b,s) = Empty <-> r <= 0 \/ (s < 0 \/ r + s <= distance N (a,b))) /\ ((forall a b :e R :^: idx N, forall r s :e R, cball N (a,r) :/\: ball N (b,s) = Empty <-> r < 0 \/ (s <= 0 \/ r + s <= distance N (a,b))) /\ forall a b :e R :^: idx N, forall r s :e R, cball N (a,r) :/\: cball N (b,s) = Empty <-> r < 0 \/ (s < 0 \/ r + s < distance N (a,b)))).
Admitted.

