// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem MEASURABLE_ELEMENTARY : forall A:set, A <> Empty -> forall d c= Power (R :^: idx A), forall s c= R :^: idx A, division_of A d s -> measurable A s.
