// Status: transport_required (bridges: hol_cart_setexp, hol_real_R)
Theorem MEASURABLE_OPEN : forall N:set, N <> Empty -> forall s c= R :^: idx N, bounded_hl N s /\ open N s -> measurable N s.
Admitted.

