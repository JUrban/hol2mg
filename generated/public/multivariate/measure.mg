Theorem NEGLIGIBLE_COUNTABLE_UNIONS_GEN : forall N:set, N <> Empty -> forall f c= Power (R :^: idx N), countable f /\ (forall s c= R :^: idx N, s :e f -> negligible N s) -> negligible N (Union f).
