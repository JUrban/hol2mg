Theorem mod_subset_thm : forall A:set, A <> Empty -> forall p :e omega, forall top :e topology A, forall c1 c2 :e frag (A :^: (R :^: omega)), mod_subset A (p,top) c1 c2 <-> singular_chain A (p,top) (frag_sub (A :^: (R :^: omega)) c1 c2).
Admitted.

