Theorem gauge_thm : forall A:set, A <> Empty -> forall d :e Power (R :^: idx A) :^: (R :^: idx A), gauge A (fun x:set => fun x0:set => x0 :e d x) <-> forall x :e R :^: idx A, x :e d x /\ open A (d x).
Admitted.

