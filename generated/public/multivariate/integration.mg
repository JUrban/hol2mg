// HOL Light: Multivariate/integration.ml:17564 / VECTOR_VARIATION_LE_UNION
// Source hash: md5:1c8d0aa5b570406df872a6f1cb78c69b
// Status: transport_required (bridges: hol_cart_setexp, hol_one_1, hol_real_R)
Theorem VECTOR_VARIATION_LE_UNION : forall N:set, N <> Empty -> forall f:set -> set, (forall x :e R :^: idx 1, f x :e R :^: idx N) -> forall s t c= R :^: idx 1, has_bounded_variation_on N f (s :\/: t) /\ interior 1 s :/\: interior 1 t = Empty -> vector_variation N s f + vector_variation N t f <= vector_variation N (s :\/: t) f.
Admitted.

// HOL Light: Multivariate/integration.ml:17615 / HAS_BOUNDED_VARIATION_ON_UNION
// Source hash: md5:547b0bc230e94e9ebd631588f538d6f7
// Status: transport_required (bridges: hol_cart_setexp, hol_one_1, hol_real_R)
