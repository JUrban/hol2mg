Theorem GAUGE_INTER : forall A:set, A <> Empty -> forall d1 d2 :e Power (R :^: idx A) :^: (R :^: idx A), gauge A (fun x:set => fun x0:set => x0 :e d1 x) /\ gauge A (fun x:set => fun x0:set => x0 :e d2 x) -> gauge A (fun x:set => fun x0:set => x0 :e d1 x :/\: d2 x).
