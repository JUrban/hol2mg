Theorem CONTENT_CLOSED_INTERVAL : forall N:set, N <> Empty -> forall a b :e R :^: idx N, (forall i :e omega, 1 <= i /\ i <= dimindex N -> a i <= b i) -> content N (closed_interval N (seq_cons (a,b) seq_nil)) = finprod (idx N) (fun i:set => b i + - a i).
Admitted.

