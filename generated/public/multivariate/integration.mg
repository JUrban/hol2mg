Theorem fine_thm : forall A B:set, A <> Empty -> B <> Empty -> forall s c= B :*: Power A, forall d :e Power A :^: B, fine A B (fun x:set => fun x0:set => x0 :e d x) s <-> forall x :e B, forall k c= A, (x,k) :e s -> k c= d x.
