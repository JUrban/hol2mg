// HOL Light: int.ml:1579 / INT_LT_DIV_EQ
// Source hash: md5:50d91c5e09b1ba9c172c4a8a2777e808
// Status: transport_required (bridges: hol_int_int, hol_num_omega, omega_Subq_int)
