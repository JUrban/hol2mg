Admitted.

// HOL Light: int.ml:1932 / WF_INT_MEASURE
// Source hash: md5:d175c8a507c83d306dca6b28aa2ef3bc
// Status: generalization_required (bridges: empty_case:A, hol_int_int, hol_num_omega, omega_Subq_int)
Theorem WF_INT_MEASURE : forall A:set, forall P:set -> prop, forall m:set -> set, (forall x :e A, m x :e int) -> (forall x :e A, 0 <= m x) /\ (forall x :e A, (forall y :e A, m y < m x -> P y) -> P x) -> forall x :e A, P x.
Admitted.

// HOL Light: int.ml:1939 / WF_INT_MEASURE_2
// Source hash: md5:fae54c5bd47e76c11b3c61f389ee17d4
// Status: generalization_required (bridges: empty_case:A, empty_case:B, hol_int_int, hol_num_omega, omega_Subq_int)
Theorem WF_INT_MEASURE_2 : forall A B:set, forall P:set -> set -> prop, forall m:set -> set -> set, (forall x :e A, forall y :e B, m x y :e int) -> (forall x :e A, forall y :e B, 0 <= m x y) /\ (forall x :e A, forall y :e B, (forall x' :e A, forall y' :e B, m x' y' < m x y -> P x' y') -> P x y) -> forall x :e A, forall y :e B, P x y.
Admitted.

// HOL Light: int.ml:1945 / INT_GCD_EXISTS
// Source hash: md5:1fd3791a36b29532c3099944ac467d39
// Status: transport_required (bridges: hol_int_int)
Theorem INT_GCD_EXISTS : forall a b :e int, exists d :e int, divides_int d a /\ (divides_int d b /\ exists x y :e int, d = a * x + b * y).
Admitted.

// HOL Light: int.ml:1960 / INT_GCD_EXISTS_POS
// Source hash: md5:1b3900d7b6feb6eef3efbcc605f4765d
// Status: transport_required (bridges: hol_int_int, hol_num_omega, omega_Subq_int)
Theorem INT_GCD_EXISTS_POS : forall a b :e int, exists d :e int, 0 <= d /\ (divides_int d a /\ (divides_int d b /\ exists x y :e int, d = a * x + b * y)).
Admitted.

// HOL Light: int.ml:1976 / int_gcd
// Source hash: md5:cc4dc0393e98852218de48c840ac1a04
// Status: transport_required (bridges: hol_int_int, hol_num_omega, hol_prod_setprod, omega_Subq_int)
Theorem int_gcd : forall a b :e int, 0 <= gcd_int a b /\ (divides_int (gcd_int a b) a /\ (divides_int (gcd_int a b) b /\ exists x y :e int, gcd_int a b = a * x + b * y)).
Admitted.

// HOL Light: int.ml:1979 / int_lcm
// Source hash: md5:3e2f81e18192fa729407cfda1c9cd015
// Status: transport_required (bridges: hol_int_int, hol_num_omega, hol_prod_setprod, omega_Subq_int)
Theorem int_lcm : forall m n :e int, lcm_int m n = if m * n = 0 then 0 else div_int (abs_SNo (m * n)) (gcd_int m n).
Admitted.

// HOL Light: int.ml:1982 / INT_DIVIDES_LABS
// Source hash: md5:d0405fc666157042fe61e8e6934de0eb
// Status: transport_required (bridges: hol_int_int)
Theorem INT_DIVIDES_LABS : forall d n :e int, divides_int (abs_SNo d) n <-> divides_int d n.
Admitted.

// HOL Light: int.ml:1986 / INT_DIVIDES_RABS
// Source hash: md5:54a183ff77262d86e8880285db5b390e
// Status: transport_required (bridges: hol_int_int)
Theorem INT_DIVIDES_RABS : forall d n :e int, divides_int d (abs_SNo n) <-> divides_int d n.
Admitted.

// HOL Light: int.ml:1990 / INT_DIVIDES_ABS
// Source hash: md5:5b524740441d5ab663e44177f1def421
// Status: transport_required (bridges: hol_int_int)
Theorem INT_DIVIDES_ABS : (forall d n :e int, divides_int (abs_SNo d) n <-> divides_int d n) /\ forall d n :e int, divides_int d (abs_SNo n) <-> divides_int d n.
Admitted.

// HOL Light: int.ml:1995 / INT_LCM_POS
// Source hash: md5:b5e8a2fcb73512ef97b6f4e4dc197849
// Status: transport_required (bridges: hol_int_int, hol_num_omega, hol_prod_setprod, omega_Subq_int)
Theorem INT_LCM_POS : forall m n :e int, 0 <= lcm_int m n.
Admitted.

// HOL Light: int.ml:2000 / INT_MUL_GCD_LCM
// Source hash: md5:9e7edc44bf404cc3c0b1329673ba9a49
// Status: transport_required (bridges: hol_int_int, hol_prod_setprod)
Theorem INT_MUL_GCD_LCM : forall m n :e int, gcd_int m n * lcm_int m n = abs_SNo (m * n).
Admitted.

// HOL Light: int.ml:2008 / INT_MUL_LCM_GCD
// Source hash: md5:47847ad93bb9ed424129f834c06f1cfd
// Status: transport_required (bridges: hol_int_int, hol_prod_setprod)
Theorem INT_MUL_LCM_GCD : forall m n :e int, lcm_int m n * gcd_int m n = abs_SNo (m * n).
Admitted.

// HOL Light: int.ml:2012 / INT_DIVIDES_LCM_GCD
// Source hash: md5:957694396f7356ea6e0ea0d772dadff6
// Status: transport_required (bridges: hol_int_int, hol_prod_setprod)
Theorem INT_DIVIDES_LCM_GCD : forall m n d :e int, divides_int d (lcm_int m n) <-> divides_int (d * gcd_int m n) (m * n).
Admitted.

// HOL Light: int.ml:2022 / INT_LCM_DIVIDES
// Source hash: md5:05c1c5d88fea8771868273b3083b47df
// Status: transport_required (bridges: hol_int_int, hol_prod_setprod)
Theorem INT_LCM_DIVIDES : forall m n d :e int, divides_int (lcm_int m n) d <-> divides_int m d /\ divides_int n d.
Admitted.

// HOL Light: int.ml:2033 / INT_LCM
// Source hash: md5:c054e7e768e8302cd09d9c229140e065
// Status: transport_required (bridges: hol_int_int, hol_prod_setprod)
Theorem INT_LCM : forall m n :e int, divides_int m (lcm_int m n) /\ (divides_int n (lcm_int m n) /\ forall d :e int, divides_int m d /\ divides_int n d -> divides_int (lcm_int m n) d).
Admitted.

// HOL Light: int.ml:2071 / num_of_int
// Source hash: md5:050bca84fac48047cdafe51481d3708c
// Status: generalization_required (bridges: choose_in_spec, hol_int_int, hol_num_omega, omega_Subq_int)
Theorem num_of_int : forall x :e int, (if x :e omega then x else 0) = choose_in omega (fun n:set => n = x).
Admitted.

// HOL Light: int.ml:2074 / NUM_OF_INT_OF_NUM
// Source hash: md5:c009afb9d7386914218b003872a341e8
// Status: generalization_required (bridges: hol_int_int, hol_num_omega, omega_Subq_int)
Theorem NUM_OF_INT_OF_NUM : forall n :e omega, (if n :e omega then n else 0) = n.
let n. assume Hn.
exact (If_i_1 (n :e omega) (n) (0) Hn).
Qed.

// HOL Light: int.ml:2078 / INT_OF_NUM_OF_INT
// Source hash: md5:9dd43ce894f2017692e90eededc92bb8
// Status: generalization_required (bridges: hol_int_int, hol_num_omega, omega_Subq_int)
Theorem INT_OF_NUM_OF_INT : forall x :e int, 0 <= x -> (if x :e omega then x else 0) = x.
Admitted.

// HOL Light: int.ml:2083 / NUM_OF_INT
// Source hash: md5:695dcc6218781ccdc6c65fb7edfe5eff
// Status: generalization_required (bridges: hol_int_int, hol_num_omega, omega_Subq_int)
Theorem NUM_OF_INT : forall x :e int, 0 <= x <-> (if x :e omega then x else 0) = x.
Admitted.

// HOL Light: int.ml:2087 / NUM_OF_INT_ADD
// Source hash: md5:ebd21729756b5f5b6a17dd9d6e14e1d8
// Status: generalization_required (bridges: add_nat_add_SNo, hol_int_int, hol_num_omega, omega_Subq_int)
Theorem NUM_OF_INT_ADD : forall x y :e int, 0 <= x /\ 0 <= y -> (if x + y :e omega then x + y else 0) = (if x :e omega then x else 0) + if y :e omega then y else 0.
Admitted.

// HOL Light: int.ml:2093 / NUM_OF_INT_MUL
// Source hash: md5:9502893ed777cd8ae23a877d105cb100
// Status: generalization_required (bridges: hol_int_int, hol_num_omega, mul_nat_mul_SNo, omega_Subq_int)
Theorem NUM_OF_INT_MUL : forall x y :e int, 0 <= x /\ 0 <= y -> (if x * y :e omega then x * y else 0) = (if x :e omega then x else 0) * if y :e omega then y else 0.
Admitted.

// HOL Light: int.ml:2099 / NUM_OF_INT_POW
// Source hash: md5:64a0561c1f8b4c6dbd9af7310d8f5a74
// Status: generalization_required (bridges: exp_nat_exp_SNo_nat, hol_int_int, hol_num_omega, omega_Subq_int)
Theorem NUM_OF_INT_POW : forall x :e int, forall n :e omega, 0 <= x -> (if x ^ n :e omega then x ^ n else 0) = (if x :e omega then x else 0) ^ n.
Admitted.

// HOL Light: int.ml:2114 / num_divides
// Source hash: md5:c56d7381d5153af98b96af09f7a0ea7c
// Status: transport_required (bridges: hol_int_int, hol_num_omega, omega_Subq_int)
Theorem num_divides : forall a b :e omega, divides_nat a b <-> divides_int a b.
let a. assume Ha.
let b. assume Hb.
apply iffI.
- assume H1.
  exact (divides_nat_divides_int (a) (b) H1).
- assume H.
  exact (divides_int_divides_nat (a) Ha (b) Hb H).
Qed.

// HOL Light: int.ml:2117 / num_mod
// Source hash: md5:e4335a2cd1f189968a27e39cf7c9bec0
// Status: transport_required (bridges: hol_int_int, hol_num_omega, omega_Subq_int)
Theorem num_mod : forall n x y :e omega, (exists q1 q2 :e omega, x + n * q1 = y + n * q2) <-> divides_int n (x + - y).
Admitted.

// HOL Light: int.ml:2120 / num_congruent
// Source hash: md5:0716c1ffb97b6bcb237d37b6dcbacfa2
// Status: transport_required (bridges: hol_int_int, hol_num_omega, omega_Subq_int)
Theorem num_congruent : forall x y n :e omega, (exists q1 q2 :e omega, x + n * q1 = y + n * q2) <-> divides_int n (x + - y).
Admitted.

// HOL Light: int.ml:2124 / num_coprime
// Source hash: md5:a033603383a8113f0137bd5bbb618384
// Status: transport_required (bridges: hol_int_int, hol_num_omega, hol_prod_setprod, omega_Subq_int)
Theorem num_coprime : forall a b :e omega, gcd_int a b = 1 <-> gcd_int a b = 1.
let a. assume Ha.
let b. assume Hb.
apply iffI.
- assume H1.
  exact H1.
- assume H.
  exact H.
Qed.

// HOL Light: int.ml:2127 / num_gcd
// Source hash: md5:88962877646a99de9617e2dde9640448
// Status: generalization_required (bridges: hol_int_int, hol_num_omega, hol_prod_setprod, omega_Subq_int)
Theorem num_gcd : forall a b :e omega, gcd_int a b = if gcd_int a b :e omega then gcd_int a b else 0.
Admitted.

// HOL Light: int.ml:2130 / num_lcm
// Source hash: md5:4d6f47880c271e3f113de43e43caa935
// Status: generalization_required (bridges: hol_int_int, hol_num_omega, hol_prod_setprod, omega_Subq_int)
Theorem num_lcm : forall a b :e omega, lcm_int a b = if lcm_int a b :e omega then lcm_int a b else 0.
Admitted.

// HOL Light: int.ml:2327 / BINARY_INDUCT
// Source hash: md5:869363624c7db47ab915a1432494e610
// Status: transport_required (bridges: add_nat_add_SNo, hol_num_omega, mul_nat_mul_SNo)
Theorem BINARY_INDUCT : forall P:set -> prop, P 0 /\ (forall n :e omega, P n -> P (2 * n) /\ P (2 * n + 1)) -> forall n :e omega, P n.
Admitted.

// HOL Light: int.ml:2334 / NUM_CASES_BINARY
// Source hash: md5:6e98df0214775661103107b2b7381920
// Status: transport_required (bridges: add_nat_add_SNo, hol_num_omega, mul_nat_mul_SNo)
Theorem NUM_CASES_BINARY : forall P:set -> prop, (forall n :e omega, P n) <-> (forall n :e omega, P (2 * n)) /\ forall n :e omega, P (2 * n + 1).
Admitted.

// HOL Light: int.ml:2338 / num_WF_DOWN
// Source hash: md5:e78ae369138c3b7c17c51f610c71c228
// Status: transport_required (bridges: hol_num_omega, nat_le_SNoLe, nat_lt_SNoLt)
Theorem num_WF_DOWN : forall P:set -> prop, forall m :e omega, (forall n :e omega, m <= n -> P n) /\ (forall n :e omega, n < m /\ (forall p :e omega, n < p -> P p) -> P n) -> forall n :e omega, P n.
Admitted.

// HOL Light: int.ml:2357 / INT_REM_REM_POW_MIN
// Source hash: md5:d334b8fa849849d2b4d889aa9fe0c20c
// Status: transport_required (bridges: hol_int_int, hol_num_omega)
Theorem INT_REM_REM_POW_MIN : forall x p :e int, forall m n :e omega, rem_int (rem_int x (p ^ m)) (p ^ n) = rem_int x (p ^ if m <= n then m else n).
Admitted.

// HOL Light: int.ml:2379 / NUM_GCD
// Source hash: md5:71b969f4ff9cc7292e8e593f142bdcc9
// Status: transport_required (bridges: hol_int_int, hol_num_omega, hol_prod_setprod, omega_Subq_int)
Theorem NUM_GCD : forall a b :e omega, gcd_int a b = gcd_int a b.
let a. assume Ha.
let b. assume Hb.
exact (fun q H => H).
Qed.

// HOL Light: int.ml:2383 / NUM_LCM
// Source hash: md5:5835913443b97f15ffa6ce8be615afcb
// Status: transport_required (bridges: hol_int_int, hol_num_omega, hol_prod_setprod, omega_Subq_int)
Theorem NUM_LCM : forall a b :e omega, lcm_int a b = lcm_int a b.
let a. assume Ha.
let b. assume Hb.
exact (fun q H => H).
Qed.

// HOL Light: int.ml:2387 / CONG
// Source hash: md5:724c7646174213ceafea3e62084f528f
// Status: transport_required (bridges: hol_num_omega)
Theorem CONG : forall x y n :e omega, (exists q1 q2 :e omega, x + n * q1 = y + n * q2) <-> mod_nat x n = mod_nat y n.
Admitted.

// HOL Light: int.ml:2391 / CONG_LMOD
// Source hash: md5:cc8435758d69c43777026b9c6e3a2d76
// Status: transport_required (bridges: hol_num_omega)
Theorem CONG_LMOD : forall x y n :e omega, (exists q1 q2 :e omega, mod_nat x n + n * q1 = y + n * q2) <-> exists q1 q2 :e omega, x + n * q1 = y + n * q2.
Admitted.

// HOL Light: int.ml:2395 / CONG_RMOD
// Source hash: md5:9b5e1121e3c5b8f81a52b0737b342961
// Status: transport_required (bridges: hol_num_omega)
Theorem CONG_RMOD : forall x y n :e omega, (exists q1 q2 :e omega, x + n * q1 = mod_nat y n + n * q2) <-> exists q1 q2 :e omega, x + n * q1 = y + n * q2.
Admitted.

// HOL Light: int.ml:2399 / CONG_DIV2
// Source hash: md5:887eb65183d44b09dda623c33ddb6a8d
// Status: transport_required (bridges: hol_num_omega, mul_nat_mul_SNo)
Theorem CONG_DIV2 : forall a b m n :e omega, (exists q1 q2 :e omega, a + (m * n) * q1 = b + (m * n) * q2) -> exists q1 q2 :e omega, div_nat a m + n * q1 = div_nat b m + n * q2.
Admitted.

// HOL Light: int.ml:2403 / divides
// Source hash: md5:d3642b2b1aea1bc3246730597a27cd9d
// Status: transport_required (bridges: hol_num_omega, mul_nat_mul_SNo)
Theorem divides : forall a b :e omega, divides_nat a b <-> exists x :e omega, b = a * x.
Admitted.

// HOL Light: int.ml:2413 / DIVIDES_LE
// Source hash: md5:93602e824a3effbaf8a6bca87922e929
// Status: transport_required (bridges: hol_num_omega, nat_le_SNoLe)
Theorem DIVIDES_LE : forall m n :e omega, divides_nat m n -> m <= n \/ n = 0.
Admitted.

// HOL Light: int.ml:2421 / DIVIDES_LE_STRONG
// Source hash: md5:ebfb4a09440c014fe8d4ebd40da7694e
// Status: transport_required (bridges: hol_num_omega, nat_le_SNoLe)
Theorem DIVIDES_LE_STRONG : forall m n :e omega, divides_nat m n -> 1 <= m /\ m <= n \/ n = 0.
Admitted.

// HOL Light: int.ml:2427 / DIVIDES_LE_IMP
// Source hash: md5:cb062223bb4a5669c6a359f894e8892e
// Status: transport_required (bridges: hol_num_omega, nat_le_SNoLe)
Theorem DIVIDES_LE_IMP : forall m n :e omega, divides_nat m n /\ (n = 0 -> m = 0) -> m <= n.
Admitted.

// HOL Light: int.ml:2431 / PROPERLY_DIVIDES_LE_IMP
// Source hash: md5:cc745e0727346b2341fbe7898629bd1d
// Status: transport_required (bridges: hol_num_omega, mul_nat_mul_SNo, nat_le_SNoLe)
Theorem PROPERLY_DIVIDES_LE_IMP : forall m n :e omega, divides_nat m n /\ (~ n = 0 /\ ~ m = n) -> 2 * m <= n.
Admitted.

// HOL Light: int.ml:2438 / DIVIDES_ANTISYM
// Source hash: md5:673b7fb9f2ef7a41b45c5d9866e1be5f
// Status: transport_required (bridges: hol_num_omega)
Theorem DIVIDES_ANTISYM : forall m n :e omega, divides_nat m n /\ divides_nat n m <-> m = n.
Admitted.

// HOL Light: int.ml:2445 / DIVIDES_ONE
// Source hash: md5:fd64b6d3d2b7d667e6ba8ff9c3405dc0
// Status: transport_required (bridges: hol_num_omega)
Theorem DIVIDES_ONE : forall n :e omega, divides_nat n 1 <-> n = 1.
Admitted.

// HOL Light: int.ml:2449 / DIV_ADD
// Source hash: md5:970c15ab9dad65b89cf1c08d3bc327f1
// Status: transport_required (bridges: add_nat_add_SNo, hol_num_omega)
Theorem DIV_ADD : forall d a b :e omega, divides_nat d a \/ divides_nat d b -> div_nat (a + b) d = div_nat a d + div_nat b d.
Admitted.

// HOL Light: int.ml:2457 / DIVIDES_MOD
// Source hash: md5:28b3eb0982533ced3cbc2dc962a28e84
// Status: transport_required (bridges: hol_num_omega)
Theorem DIVIDES_MOD : forall m n :e omega, divides_nat m n <-> mod_nat n m = 0.
Admitted.

// HOL Light: int.ml:2461 / DIVIDES_DIV_MULT
// Source hash: md5:b8be1c8833ae7d467f442c698d4b0140
// Status: transport_required (bridges: hol_num_omega, mul_nat_mul_SNo)
Theorem DIVIDES_DIV_MULT : forall m n :e omega, divides_nat m n <-> div_nat n m * m = n.
Admitted.

// HOL Light: int.ml:2466 / DIV_BY_DIV
// Source hash: md5:6158977836d11c193b73e7a5137c2ab3
// Status: transport_required (bridges: hol_num_omega)
Theorem DIV_BY_DIV : forall m n :e omega, ~ n = 0 /\ divides_nat m n -> div_nat n (div_nat n m) = m.
Admitted.

// HOL Light: int.ml:2471 / DIVIDES_DIV_DIVIDES
// Source hash: md5:4f9ed4a25fb883a29f709aa8e2632d83
// Status: transport_required (bridges: hol_num_omega, mul_nat_mul_SNo)
Theorem DIVIDES_DIV_DIVIDES : forall n d e0 :e omega, divides_nat d n /\ (n = 0 -> e0 = 0) -> (divides_nat (div_nat n d) e0 <-> divides_nat n (d * e0)).
Admitted.

// HOL Light: int.ml:2477 / DIVIDES_DIV_SELF
// Source hash: md5:60881d0c0adad94cda8fa69d8e6dfea3
// Status: transport_required (bridges: hol_num_omega)
Theorem DIVIDES_DIV_SELF : forall n d :e omega, divides_nat d n -> divides_nat (div_nat n d) n.
Admitted.

// HOL Light: int.ml:2481 / DIVIDES_DIVIDES_DIV
// Source hash: md5:0ae2bdd990680c6a1d514dc9980dc566
// Status: transport_required (bridges: hol_num_omega, mul_nat_mul_SNo)
Theorem DIVIDES_DIVIDES_DIV : forall n d e0 :e omega, divides_nat d n -> (divides_nat e0 (div_nat n d) <-> divides_nat (d * e0) n).
Admitted.

// HOL Light: int.ml:2486 / DIVIDES_DIVIDES_DIV_EQ
// Source hash: md5:874302f2fba8510d781fd850e7d2d744
// Status: transport_required (bridges: hol_num_omega, mul_nat_mul_SNo)
Theorem DIVIDES_DIVIDES_DIV_EQ : forall n d e0 :e omega, divides_nat d n /\ divides_nat e0 (div_nat n d) <-> divides_nat (d * e0) n.
Admitted.

// HOL Light: int.ml:2491 / DIVIDES_DIVIDES_DIV_IMP
// Source hash: md5:f301ef94119ceb9bb1f737d2cce3fa2f
// Status: transport_required (bridges: hol_num_omega, mul_nat_mul_SNo)
Theorem DIVIDES_DIVIDES_DIV_IMP : forall n d e0 :e omega, divides_nat (d * e0) n -> divides_nat e0 (div_nat n d).
Admitted.

// HOL Light: int.ml:2495 / MULT_DIV
// Source hash: md5:601fc17ada0ecb6f5c2f5a82f26fd3e9
// Status: transport_required (bridges: hol_num_omega, mul_nat_mul_SNo)
Theorem MULT_DIV : (forall m n p :e omega, divides_nat p m -> div_nat (m * n) p = div_nat m p * n) /\ forall m n p :e omega, divides_nat p n -> div_nat (m * n) p = m * div_nat n p.
Admitted.

// HOL Light: int.ml:2529 / COPRIME_LMOD
// Source hash: md5:82edd8f721fd49d9fdb847f1107441b6
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem COPRIME_LMOD : forall a n :e omega, gcd_int (mod_nat a n) n = 1 <-> gcd_int a n = 1.
Admitted.

// HOL Light: int.ml:2534 / COPRIME_RMOD
// Source hash: md5:eba4352f0a84489e096c6c3df75885dc
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem COPRIME_RMOD : forall a n :e omega, gcd_int n (mod_nat a n) = 1 <-> gcd_int n a = 1.
Admitted.

// HOL Light: int.ml:2539 / INT_CONG_NUM_EXISTS
// Source hash: md5:0792d2d3dc96cffba17b67f4642f41f3
// Status: transport_required (bridges: hol_int_int, hol_num_omega, omega_Subq_int)
Theorem INT_CONG_NUM_EXISTS : forall x y :e int, (y = 0 -> 0 <= x) -> exists n :e omega, divides_int y (n + - x).
Admitted.

// HOL Light: int.ml:2557 / GCD
// Source hash: md5:7d4d9f7b3f042d6254fdf4aee87b9ac7
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem GCD : forall a b :e omega, divides_nat (gcd_int a b) a /\ divides_nat (gcd_int a b) b /\ forall e0 :e omega, divides_nat e0 a /\ divides_nat e0 b -> divides_nat e0 (gcd_int a b).
Admitted.

// HOL Light: int.ml:2562 / coprime
// Source hash: md5:c83526bbeb567461aea27548ec97d34b
// Status: transport_required (bridges: hol_num_omega, hol_prod_setprod)
Theorem coprime : forall a b :e omega, gcd_int a b = 1 <-> forall d :e omega, divides_nat d a /\ divides_nat d b -> d = 1.
Admitted.

// HOL Light: int.ml:2572 / prime
// Source hash: md5:621cbb38fa09f55474fec032bc5c4c7f
// Status: transport_required (bridges: hol_num_omega)
Theorem prime : forall p :e omega, prime_nat p <-> ~ p = 1 /\ forall x :e omega, divides_nat x p -> x = 1 \/ x = p.
Admitted.

// HOL Light: int.ml:2575 / ONE_OR_PRIME
