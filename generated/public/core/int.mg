// Status: transport_required (bridges: hol_int_int, hol_num_omega, omega_Subq_int)
Theorem INT_CONG_SOLVE_BOUNDS : forall a n :e int, ~ n = 0 -> exists x :e int, 0 <= x /\ (x < abs_SNo n /\ divides_int n (x + - a)).
