// Status: native_reuse (bridges: hol_int_int)
// Reuse: this proposition is already a theorem of the target library (reproved natively).
Theorem INT_GE : forall x y :e int, y <= x <-> y <= x.
let x. assume Hx.
let y. assume Hy.
apply iffI.
- assume H1.
  exact H1.
- assume H.
  exact H.
Qed.

