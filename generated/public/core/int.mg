Theorem REAL_ZPOW_MUL : forall x y :e R, forall n :e int, (if 0 <= n then (x * y) ^ n else recip_SNo ((x * y) ^ (- n))) = (if 0 <= n then x ^ n else recip_SNo (x ^ (- n))) * if 0 <= n then y ^ n else recip_SNo (y ^ (- n)).
