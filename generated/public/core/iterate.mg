Theorem INTER_NUMSEG : forall m n p q :e omega, {i :e omega | m <= i /\ i <= n} :/\: {i :e omega | p <= i /\ i <= q} = {i :e omega | (if m <= p then p else m) <= i /\ i <= if n <= q then n else q}.
