// Status: transport_required (bridges: hol_prod_setprod)
Theorem CROSS_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall s s' c= A, forall t t' c= B, s * t = s' * t' <-> (s = Empty \/ t = Empty) /\ (s' = Empty \/ t' = Empty) \/ s = s' /\ t = t'.
