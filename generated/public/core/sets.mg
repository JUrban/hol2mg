// Status: exact_native
Theorem INTERS_ANTIMONO : forall A:set, A <> Empty -> forall f g c= Power A, g c= f -> {x :e A | forall Y :e f, x :e Y} c= {x :e A | forall Y :e g, x :e Y}.
