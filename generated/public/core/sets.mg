// Status: exact_native
Theorem EXISTS_IN_UNIONS : forall A:set, A <> Empty -> forall P:set -> prop, forall s c= Power A, (exists x :e A, x :e Union s /\ P x) <-> exists t c= A, exists x :e A, t :e s /\ (x :e t /\ P x).
