// Status: transport_required (bridges: hol_num_omega, nat_lt_SNoLt)
Theorem NUMSEG_CLAUSES_LT : {i :e omega | i < 0} = Empty /\ forall k :e omega, {i :e omega | i < ordsucc k} = SetAdjoin {i :e omega | i < k} k.
Admitted.

// HOL Light: sets.ml:3562 / HAS_SIZE_NUMSEG_LT
