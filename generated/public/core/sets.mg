// Source hash: md5:bfba4d47a7c25bafcabf364ee4a2c550
// Status: transport_required (bridges: hol_finite_finite, hol_real_R)
Theorem INF_FINITE_LEMMA : forall s c= R, finite s /\ ~ s = Empty -> exists b :e R, b :e s /\ forall x :e R, x :e s -> b <= x.
Admitted.

