// Status: transport_required (bridges: hol_finite_finite, hol_num_omega, nat_lt_SNoLt)
Theorem INFINITE_ENUMERATE : forall s c= omega, infinite s -> exists r:set -> set, (forall x :e omega, r x :e omega) /\ ((forall m n :e omega, m < n -> r m < r n) /\ {r x | x :e omega} = s).
