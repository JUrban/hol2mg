Theorem INTER_UNIONS : forall A:set, A <> Empty -> (forall s c= Power A, forall t c= A, Union s :/\: t = Union {x :/\: t | x :e Power A, x :e s}) /\ forall s c= Power A, forall t c= A, t :/\: Union s = Union {t :/\: x | x :e Power A, x :e s}.
Admitted.

