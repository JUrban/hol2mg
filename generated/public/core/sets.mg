Theorem INTERS_UNION : forall A:set, A <> Empty -> forall s t c= Power A, {x :e A | forall Y :e s :\/: t, x :e Y} = {x :e A | forall Y :e s, x :e Y} :/\: {x :e A | forall Y :e t, x :e Y}.
