// Source hash: md5:83807e05d6d99ac17e56dd0530561033
// Status: transport_required (bridges: hol_finite_finite, hol_num_omega)
Theorem INFINITE_ENUMERATE_SUBSET : forall A:set, A <> Empty -> forall s c= A, infinite s <-> exists f:set -> set, (forall x :e omega, f x :e A) /\ ((forall x :e omega, f x :e s) /\ forall x y :e omega, f x = f y -> x = y).
Admitted.

// HOL Light: sets.ml:3894 / pairwise
// Source hash: md5:f591b58ad9838277f3fd24b4deccb546
// Status: exact_native
Theorem pairwise : forall A:set, A <> Empty -> forall s c= A, forall r:set -> set -> prop, (forall x y :e s, x <> y -> r x y) <-> forall x y :e A, x :e s /\ (y :e s /\ ~ x = y) -> r x y.
Admitted.

