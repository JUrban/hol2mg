Theorem CARD_DELETE : forall A:set, A <> Empty -> forall x :e A, forall s c= A, finite s -> card (s :\: {x}) = if x :e s then minus_nat (card s) 1 else card s.
Admitted.

// HOL Light: sets.ml:2039 / CARD_UNION_EQ
