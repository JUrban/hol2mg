// HOL Light: sets.ml:4755 / REAL_SUP_LE
// Source hash: md5:fd4c43287aec7cdf757331cc07b2e64e
// Status: transport_required (bridges: hol_real_R)
Theorem REAL_SUP_LE : forall s c= R, forall b :e R, ~ s = Empty /\ (forall x :e R, x :e s -> x <= b) -> sup s <= b.
Admitted.

// HOL Light: sets.ml:4759 / REAL_SUP_LE_SUBSET
// Source hash: md5:11e6a0fa80ef64c360010c6adebb40c2
// Status: transport_required (bridges: hol_real_R)
Theorem REAL_SUP_LE_SUBSET : forall s t c= R, ~ s = Empty /\ (s c= t /\ (exists b :e R, forall x :e R, x :e t -> x <= b)) -> sup s <= sup t.
Admitted.

// HOL Light: sets.ml:4765 / REAL_SUP_BOUNDS
// Source hash: md5:cb3c7a5564807549abec37dfc574b11e
// Status: transport_required (bridges: hol_real_R)
Theorem REAL_SUP_BOUNDS : forall s c= R, forall a b :e R, ~ s = Empty /\ (forall x :e R, x :e s -> a <= x /\ x <= b) -> a <= sup s /\ sup s <= b.
Admitted.

// HOL Light: sets.ml:4774 / REAL_ABS_SUP_LE
// Source hash: md5:1386df99119b34c458da70f0bd947449
// Status: transport_required (bridges: hol_real_R)
Theorem REAL_ABS_SUP_LE : forall s c= R, forall a :e R, ~ s = Empty /\ (forall x :e R, x :e s -> abs_SNo x <= a) -> abs_SNo (sup s) <= a.
Admitted.

// HOL Light: sets.ml:4778 / REAL_SUP_ASCLOSE
// Source hash: md5:899e68432ca3d03908a0b4e5e1b7cd92
// Status: transport_required (bridges: hol_real_R)
Theorem REAL_SUP_ASCLOSE : forall s c= R, forall l e0 :e R, ~ s = Empty /\ (forall x :e R, x :e s -> abs_SNo (x + - l) <= e0) -> abs_SNo (sup s + - l) <= e0.
Admitted.

// HOL Light: sets.ml:4784 / SUP_UNIQUE_FINITE
// Source hash: md5:a5a2121571ee6bc6c8fcf32cf8d0f7c7
// Status: transport_required (bridges: hol_finite_finite, hol_real_R)
Theorem SUP_UNIQUE_FINITE : forall a :e R, forall s c= R, finite s /\ ~ s = Empty -> (sup s = a <-> a :e s /\ forall y :e R, y :e s -> y <= a).
Admitted.

// HOL Light: sets.ml:4791 / SUP_INSERT_FINITE
// Source hash: md5:f27fac5aee3a4a0cdd1d6e320865d873
// Status: transport_required (bridges: hol_finite_finite, hol_real_R)
Theorem SUP_INSERT_FINITE : forall x :e R, forall s c= R, finite s -> sup (SetAdjoin s x) = if s = Empty then x else if x <= sup s then sup s else x.
Admitted.

// HOL Light: sets.ml:4801 / SUP_SING
// Source hash: md5:3a9cb35b953582fc5909b65168df7703
// Status: transport_required (bridges: hol_real_R)
Theorem SUP_SING : forall a :e R, sup {a} = a.
Admitted.

// HOL Light: sets.ml:4805 / SUP_INSERT_INSERT
// Source hash: md5:db5a0106a36c762e7c82cb152ae005c5
// Status: transport_required (bridges: hol_real_R)
Theorem SUP_INSERT_INSERT : forall a b :e R, forall s c= R, sup (SetAdjoin (SetAdjoin s a) b) = sup (SetAdjoin s (if a <= b then b else a)).
Admitted.

// HOL Light: sets.ml:4812 / REAL_LE_SUP
// Source hash: md5:b21ea54fdfddac32cd95324d42132f84
// Status: transport_required (bridges: hol_real_R)
Theorem REAL_LE_SUP : forall s c= R, forall a b y :e R, y :e s /\ (a <= y /\ (forall x :e R, x :e s -> x <= b)) -> a <= sup s.
Admitted.

// HOL Light: sets.ml:4816 / REAL_SUP_LE_EQ
// Source hash: md5:9f6f5f5e1ff041b6230f0ad673a7b1d5
// Status: transport_required (bridges: hol_real_R)
Theorem REAL_SUP_LE_EQ : forall s c= R, forall y :e R, ~ s = Empty /\ (exists b :e R, forall x :e R, x :e s -> x <= b) -> (sup s <= y <-> forall x :e R, x :e s -> x <= y).
Admitted.

// HOL Light: sets.ml:4821 / SUP_UNIQUE
// Source hash: md5:aeff6e2a6420e0f5569a94de7ce75985
// Status: transport_required (bridges: hol_real_R)
Theorem SUP_UNIQUE : forall s c= R, forall b :e R, (forall c :e R, (forall x :e R, x :e s -> x <= c) <-> b <= c) -> sup s = b.
Admitted.

// HOL Light: sets.ml:4826 / SUP_UNION
// Source hash: md5:a5e7010b4354600553d6c25417791f75
// Status: transport_required (bridges: hol_real_R)
Theorem SUP_UNION : forall s t c= R, ~ s = Empty /\ (~ t = Empty /\ ((exists b :e R, forall x :e R, x :e s -> x <= b) /\ (exists c :e R, forall x :e R, x :e t -> x <= c))) -> sup (s :\/: t) = if sup s <= sup t then sup t else sup s.
Admitted.

// HOL Light: sets.ml:4834 / ELEMENT_LE_SUP
// Source hash: md5:8c6cbb9981dc1512672fc20fc2b981ce
// Status: transport_required (bridges: hol_real_R)
Theorem ELEMENT_LE_SUP : forall s c= R, forall a :e R, (exists b :e R, forall x :e R, x :e s -> x <= b) /\ a :e s -> a <= sup s.
Admitted.

// HOL Light: sets.ml:4838 / SUP_APPROACH
// Source hash: md5:32183111dabd69ee6a7e3910e3fd2bc5
// Status: transport_required (bridges: hol_real_R)
Theorem SUP_APPROACH : forall s c= R, forall c :e R, ~ s = Empty /\ ((exists b :e R, forall x :e R, x :e s -> x <= b) /\ c < sup s) -> exists x :e R, x :e s /\ c < x.
Admitted.

// HOL Light: sets.ml:4849 / REAL_MAX_SUP
// Source hash: md5:84d1c01e26b91a687b52852d378103a7
// Status: transport_required (bridges: hol_real_R)
Theorem REAL_MAX_SUP : forall x y :e R, (if x <= y then y else x) = sup {x,y}.
Admitted.

// HOL Light: sets.ml:4855 / inf
// Source hash: md5:b6e4351d5c7f0c88c6789029373b4145
// Status: transport_required (bridges: choose_in_spec, hol_real_R)
Theorem inf_hl : forall s c= R, inf s = choose_in R (fun a:set => (forall x :e R, x :e s -> a <= x) /\ forall b :e R, (forall x :e R, x :e s -> b <= x) -> b <= a).
Admitted.

// HOL Light: sets.ml:4859 / INF_EQ
// Source hash: md5:bdf9df8416b9b5c2ee70d7924516b24d
// Status: transport_required (bridges: hol_real_R)
Theorem INF_EQ : forall s t c= R, (forall a :e R, (forall x :e R, x :e s -> a <= x) <-> forall x :e R, x :e t -> a <= x) -> inf s = inf t.
Admitted.

// HOL Light: sets.ml:4864 / INF
// Source hash: md5:832a778e84902cbe8201ca419f6f8f6d
// Status: transport_required (bridges: hol_real_R)
Theorem INF : forall s c= R, ~ s = Empty /\ (exists b :e R, forall x :e R, x :e s -> b <= x) -> (forall x :e R, x :e s -> inf s <= x) /\ forall b :e R, (forall x :e R, x :e s -> b <= x) -> b <= inf s.
Admitted.

