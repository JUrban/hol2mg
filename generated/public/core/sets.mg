// Source hash: md5:70a8a2d45d230cb1a42aaf9faab99fd3
// Status: exact_native
Theorem POWERSET_CLAUSES : forall A:set, A <> Empty -> {s :e Power A | s c= Empty} = {Empty} /\ forall a :e A, forall t c= A, {s :e Power A | s c= SetAdjoin t a} = {s :e Power A | s c= t} :\/: {(fun x0:set => if x0 :e SetAdjoin x a then 1 else 0) | x :e {s :e Power A | s c= t}}.
Admitted.

// HOL Light: sets.ml:3495 / FINITE_IMAGE_INFINITE
// Source hash: md5:31d295c1043c3a66b02308e635b29881
// Status: transport_required (bridges: hol_finite_finite)
Theorem FINITE_IMAGE_INFINITE : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall s c= A, infinite s /\ finite {f x | x :e s} -> exists a :e A, a :e s /\ infinite {x :e A | x :e s /\ f x = f a}.
Admitted.

// HOL Light: sets.ml:3507 / FINITE_RESTRICTED_POWERSET
// Source hash: md5:6d5e319604ba9537fa3f9a8ec03ec919
// Status: transport_required (bridges: hol_finite_finite, hol_has_size_equip, hol_num_omega)
Theorem FINITE_RESTRICTED_POWERSET : forall A:set, A <> Empty -> forall s c= A, forall n :e omega, finite {t :e Power A | t c= s /\ equip t n} <-> finite s \/ n = 0.
Admitted.

// HOL Light: sets.ml:3531 / FINITE_RESTRICTED_FUNSPACE
// Source hash: md5:4e867d485b4202d1178efdda8a9b4106
// Status: transport_required (bridges: hol_finite_finite)
Theorem FINITE_RESTRICTED_FUNSPACE : forall A B:set, A <> Empty -> B <> Empty -> forall s c= A, forall t c= B, forall k:set -> set, (forall x :e A, k x :e B) -> finite s /\ finite t -> finite {f :e B :^: A | {f x | x :e s} c= t /\ {x :e A | ~ f x = k x} c= s}.
Admitted.

// HOL Light: sets.ml:3557 / NUMSEG_CLAUSES_LT
