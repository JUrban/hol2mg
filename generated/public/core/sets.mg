// Status: transport_required (bridges: hol_finite_finite, hol_real_R)
Theorem INF_FINITE : forall s c= R, finite s /\ ~ s = Empty -> inf s :e s /\ forall x :e R, x :e s -> inf s <= x.
Admitted.

