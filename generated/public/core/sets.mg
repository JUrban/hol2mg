// HOL Light: sets.ml:3631 / FINITE_REAL_INTERVAL
// Source hash: md5:6c1df66e4d26b520247a3dfbd5f7fce9
// Status: transport_required (bridges: hol_finite_finite, hol_real_R)
Theorem FINITE_REAL_INTERVAL : (forall a :e R, ~ finite {x :e R | a < x}) /\ ((forall a :e R, ~ finite {x :e R | a <= x}) /\ ((forall b :e R, ~ finite {x :e R | x < b}) /\ ((forall b :e R, ~ finite {x :e R | x <= b}) /\ ((forall a b :e R, finite {x :e R | a < x /\ x < b} <-> b <= a) /\ ((forall a b :e R, finite {x :e R | a <= x /\ x < b} <-> b <= a) /\ ((forall a b :e R, finite {x :e R | a < x /\ x <= b} <-> b <= a) /\ forall a b :e R, finite {x :e R | a <= x /\ x <= b} <-> b <= a)))))).
Admitted.

// HOL Light: sets.ml:3689 / real_INFINITE
// Source hash: md5:c6e856ca19eac4996c814db7019590c1
// Status: transport_required (bridges: hol_finite_finite, hol_real_R)
Theorem real_INFINITE : infinite R.
Admitted.

// HOL Light: sets.ml:3700 / HAS_SIZE_INDEX
// Source hash: md5:7471a6144c4e96e37f24d156f109f23b
// Status: transport_required (bridges: hol_has_size_equip, hol_num_omega, nat_lt_SNoLt)
Theorem HAS_SIZE_INDEX : forall A:set, A <> Empty -> forall s c= A, forall n :e omega, equip s n -> exists f:set -> set, (forall x :e omega, f x :e A) /\ ((forall m :e omega, m < n -> f m :e s) /\ forall x :e A, x :e s -> exists m :e omega, m < n /\ f m = x /\ forall y :e omega, m < n /\ f m = x -> y = m).
Admitted.

// HOL Light: sets.ml:3722 / INFINITE_ENUMERATE
