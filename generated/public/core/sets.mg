// Status: transport_required (bridges: hol_prod_setprod)
Theorem IMAGE_FST_CROSS : forall A B:set, A <> Empty -> B <> Empty -> forall s c= A, forall t c= B, {x 0 | x :e s * t} = if t = Empty then Empty else s.
