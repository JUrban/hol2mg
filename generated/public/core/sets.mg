// Status: exact_native
Theorem PAIRWISE_IMP : forall A:set, A <> Empty -> forall P Q:set -> set -> prop, forall s c= A, (forall x y :e s, x <> y -> P x y) /\ (forall x y :e A, x :e s /\ (y :e s /\ (P x y /\ ~ x = y)) -> Q x y) -> forall x y :e s, x <> y -> Q x y.
Admitted.

