// Status: exact_native
Theorem SURJECTIVE_IMAGE_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall s c= A, forall t c= B, (forall y :e B, y :e t -> exists x :e A, f x = y) /\ (forall x :e A, f x :e t <-> x :e s) -> {f x | x :e s} = t.
