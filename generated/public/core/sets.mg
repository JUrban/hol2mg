// Source hash: md5:2f4398e047ebc020895696a2c2b6a9ce
// Status: exact_native
Theorem UNIONS_SUBSET : forall A:set, A <> Empty -> forall f c= Power A, forall t c= A, Union f c= t <-> forall s c= A, s :e f -> s c= t.
