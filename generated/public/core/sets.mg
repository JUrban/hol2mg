Theorem INJECTIVE_ON_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall u c= A, (forall s t c= A, s c= u /\ (t c= u /\ {f x | x :e s} = {f x | x :e t}) -> s = t) <-> forall x y :e A, x :e u /\ (y :e u /\ f x = f y) -> x = y.
