// Status: transport_required (bridges: add_nat_add_SNo, hol_card, hol_finite_finite, hol_num_omega)
Theorem CARD_UNION_EQ : forall A:set, A <> Empty -> forall s t u c= A, finite u /\ (s :/\: t = Empty /\ s :\/: t = u) -> card s + card t = card u.
