// Source hash: md5:7435153190af43f717a585882cf89016
// Status: exact_native
Theorem PAIRWISE_MONO : forall A:set, A <> Empty -> forall r:set -> set -> prop, forall s t c= A, (forall x y :e s, x <> y -> r x y) /\ t c= s -> forall x y :e t, x <> y -> r x y.
