// Status: exact_native
Theorem DISJOINT_DELETE_SYM : forall A:set, A <> Empty -> forall s t c= A, forall x :e A, (s :\: {x}) :/\: t = Empty <-> (t :\: {x}) :/\: s = Empty.
Admitted.

