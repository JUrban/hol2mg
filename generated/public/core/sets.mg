// Status: transport_required (bridges: hol_num_omega, nat_le_SNoLe)
Theorem NUMSEG_CLAUSES_LE : {i :e omega | i <= 0} = {0} /\ forall k :e omega, {i :e omega | i <= ordsucc k} = SetAdjoin {i :e omega | i <= k} (ordsucc k).
