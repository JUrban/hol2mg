// Status: transport_required (bridges: hol_prod_setprod)
Theorem DISJOINT_CROSS : forall A B:set, A <> Empty -> B <> Empty -> forall s c= A, forall t c= B, forall s' c= A, forall t' c= B, (s * t) :/\: (s' * t') = Empty <-> s :/\: s' = Empty \/ t :/\: t' = Empty.
