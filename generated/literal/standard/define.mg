// HOL Light: define.ml:198 / ADMISSIBLE_MAP   (hash md5:0257e30674f5e41799bc15b9e4c7a21b)
Theorem hlt_ADMISSIBLE_MAP : forall C D E A B P:set, C <> Empty -> D <> Empty -> E <> Empty -> A <> Empty -> B <> Empty -> P <> Empty -> forall lt :e 2 :^: C :^: A, forall p :e 2 :^: P :^: (B :^: A), forall s :e C :^: P, forall h :e D :^: E :^: P :^: (B :^: A), forall l :e finseq E :^: P :^: (B :^: A), hl_admissible A C B P (finseq E) lt p s l = 1 /\ hl_admissible A C B (E :*: P) D lt (fun f :e B :^: A => hl_GABS (2 :^: (E :*: P)) (fun f1 :e 2 :^: (E :*: P) => if forall y :e E, forall x :e P, hl_GEQ 2 (f1 (hl_pair E P y x)) (if p f x = 1 /\ hl_MEM E y (l f x) = 1 then 1 else 0) = 1 then 1 else 0)) (hl_GABS (C :^: (E :*: P)) (fun f :e C :^: (E :*: P) => if forall y :e E, forall x :e P, hl_GEQ C (f (hl_pair E P y x)) (s x) = 1 then 1 else 0)) (fun f :e B :^: A => hl_GABS (D :^: (E :*: P)) (fun f1 :e D :^: (E :*: P) => if forall y :e E, forall x :e P, hl_GEQ D (f1 (hl_pair E P y x)) (h f x y) = 1 then 1 else 0)) = 1 -> hl_admissible A C B P (finseq D) lt p s (fun f :e B :^: A => fun x :e P => hl_MAP E D (h f x) (l f x)) = 1.
