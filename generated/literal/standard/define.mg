Theorem hlt_SUPERADMISSIBLE_MATCH_UNGUARDED_PATTERN : forall A B D P Q:set, A <> Empty -> B <> Empty -> D <> Empty -> P <> Empty -> Q <> Empty -> forall lt :e 2 :^: A :^: A, forall p :e 2 :^: P :^: (B :^: A), forall s :e A :^: P, forall e1 :e D :^: P, forall pat :e D :^: Q, forall arg :e A :^: Q :^: P, (forall f :e B :^: A, forall a :e P, forall t u :e Q, p f a = 1 /\ (pat t = e1 a /\ pat u = e1 a) -> arg a t = arg a u) /\ (forall f :e B :^: A, forall a :e P, forall t :e Q, p f a = 1 /\ pat t = e1 a -> forall y :e A, lt y (arg a t) = 1 -> lt y (s a) = 1) -> hl_superadmissible A B P lt p s (fun f :e B :^: A => fun x :e P => hl__MATCH D B (e1 x) (fun u :e D => fun v :e B => if exists t :e Q, hl__UNGUARDED_PATTERN (hl_GEQ D (pat t) u) (hl_GEQ B (f (arg x t)) v) = 1 then 1 else 0)) = 1.
