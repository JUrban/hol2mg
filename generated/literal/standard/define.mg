// HOL Light: define.ml:117 / ADMISSIBLE_COND   (hash md5:8fb922126aee181c9a631a307c648f29)
Theorem hlt_ADMISSIBLE_COND : forall A B C D P:set, A <> Empty -> B <> Empty -> C <> Empty -> D <> Empty -> P <> Empty -> forall lt :e 2 :^: A :^: B, forall p P1 :e 2 :^: P :^: (C :^: B), forall s :e A :^: P, forall h k :e D :^: P :^: (C :^: B), hl_admissible B A C P 2 lt p s P1 = 1 /\ (hl_admissible B A C P D lt (fun f :e C :^: B => fun x :e P => if p f x = 1 /\ P1 f x = 1 then 1 else 0) s h = 1 /\ hl_admissible B A C P D lt (fun f :e C :^: B => fun x :e P => if p f x = 1 /\ ~ P1 f x = 1 then 1 else 0) s k = 1) -> hl_admissible B A C P D lt p s (fun f :e C :^: B => fun x :e P => hl_COND D (P1 f x) (h f x) (k f x)) = 1.
Admitted.

// HOL Light: define.ml:129 / ADMISSIBLE_MATCH   (hash md5:3d5542a1dd873098d8d18234606ebd7d)
Theorem hlt_ADMISSIBLE_MATCH : forall A B C D E P:set, A <> Empty -> B <> Empty -> C <> Empty -> D <> Empty -> E <> Empty -> P <> Empty -> forall lt :e 2 :^: A :^: B, forall p :e 2 :^: P :^: (C :^: B), forall s :e A :^: P, forall e1 :e E :^: P :^: (C :^: B), forall c :e 2 :^: D :^: E :^: P :^: (C :^: B), hl_admissible B A C P E lt p s e1 = 1 /\ hl_admissible B A C P (2 :^: D) lt p s (fun f :e C :^: B => fun x :e P => c f x (e1 f x)) = 1 -> hl_admissible B A C P D lt p s (fun f :e C :^: B => fun x :e P => hl__MATCH E D (e1 f x) (c f x)) = 1.
