// hol2mg literal statements (private): shard define of profile standard.  Each theorem is the literal
// interpretation of the HOL Light theorem named in the comment; all are admitted source facts.

// HOL Light: define.ml:13 / CASEWISE_DEF   (hash md5:04c558398abe0b89339aa1a8f533455d)
Theorem hlt_CASEWISE_DEF : forall A B C D:set, A <> Empty -> B <> Empty -> C <> Empty -> D <> Empty -> forall f :e D, forall x :e C, forall h :e C :^: B :*: A :^: B :^: D, forall t :e finseq (C :^: B :*: A :^: B :^: D), hl_CASEWISE B C D A (hl_NIL (C :^: B :*: A :^: B :^: D)) f x = hl_select A (fun y :e A => if True then 1 else 0) /\ hl_CASEWISE B C D A (hl_CONS (C :^: B :*: A :^: B :^: D) h t) f x = hl_COND A (if exists y :e B, hl_FST (C :^: B) (A :^: B :^: D) h y = x then 1 else 0) (hl_SND (C :^: B) (A :^: B :^: D) h f (hl_select B (fun y :e B => if hl_FST (C :^: B) (A :^: B :^: D) h y = x then 1 else 0))) (hl_CASEWISE B C D A t f x).
Admitted.

// HOL Light: define.ml:19 / CASEWISE   (hash md5:3bf37005a9385fa59bedd49af522468a)
Theorem hlt_CASEWISE : forall A B C D E F:set, A <> Empty -> B <> Empty -> C <> Empty -> D <> Empty -> E <> Empty -> F <> Empty -> forall f :e E, forall x :e D, forall s :e D :^: F, forall t :e C :^: F :^: E, forall clauses :e finseq (D :^: F :*: C :^: F :^: E), hl_CASEWISE A D E B (hl_NIL (D :^: A :*: B :^: A :^: E)) f x = hl_select B (fun y :e B => if True then 1 else 0) /\ hl_CASEWISE F D E C (hl_CONS (D :^: F :*: C :^: F :^: E) (hl_pair (D :^: F) (C :^: F :^: E) s t) clauses) f x = hl_COND C (if exists y :e F, s y = x then 1 else 0) (t f (hl_select F (fun y :e F => if s y = x then 1 else 0))) (hl_CASEWISE F D E C clauses f x).
Admitted.

// HOL Light: define.ml:29 / CASEWISE_CASES   (hash md5:d3cec3faa29c44a9ae38789e6f5ea0aa)
Theorem hlt_CASEWISE_CASES : forall A B C D:set, A <> Empty -> B <> Empty -> C <> Empty -> D <> Empty -> forall clauses :e finseq (A :^: C :*: D :^: C :^: B), forall c :e B, forall x :e A, (exists s :e A :^: C, exists t :e D :^: C :^: B, exists a :e C, hl_MEM (A :^: C :*: D :^: C :^: B) (hl_pair (A :^: C) (D :^: C :^: B) s t) clauses = 1 /\ (s a = x /\ hl_CASEWISE C A B D clauses c x = t c a)) \/ ~ (exists s :e A :^: C, exists t :e D :^: C :^: B, exists a :e C, hl_MEM (A :^: C :*: D :^: C :^: B) (hl_pair (A :^: C) (D :^: C :^: B) s t) clauses = 1 /\ s a = x) /\ hl_CASEWISE C A B D clauses c x = hl_select D (fun y :e D => if True then 1 else 0).
Admitted.

// HOL Light: define.ml:39 / CASEWISE_WORKS   (hash md5:a3cfd94ac3b1eb7949683c8770441014)
Theorem hlt_CASEWISE_WORKS : forall A B C P:set, A <> Empty -> B <> Empty -> C <> Empty -> P <> Empty -> forall clauses :e finseq (A :^: P :*: B :^: P :^: C), forall c :e C, (forall s :e A :^: P, forall t :e B :^: P :^: C, forall s' :e A :^: P, forall t' :e B :^: P :^: C, forall x y :e P, hl_MEM (A :^: P :*: B :^: P :^: C) (hl_pair (A :^: P) (B :^: P :^: C) s t) clauses = 1 /\ (hl_MEM (A :^: P :*: B :^: P :^: C) (hl_pair (A :^: P) (B :^: P :^: C) s' t') clauses = 1 /\ s x = s' y) -> t c x = t' c y) -> hl_ALL (A :^: P :*: B :^: P :^: C) (hl_GABS (2 :^: (A :^: P :*: B :^: P :^: C)) (fun f :e 2 :^: (A :^: P :*: B :^: P :^: C) => if forall s :e A :^: P, forall t :e B :^: P :^: C, hl_GEQ 2 (f (hl_pair (A :^: P) (B :^: P :^: C) s t)) (if forall x :e P, hl_CASEWISE P A C B clauses c (s x) = t c x then 1 else 0) = 1 then 1 else 0)) clauses = 1.
Admitted.

// HOL Light: define.ml:51 / admissible   (hash md5:e94c0c82026d6a452d34410186b2e050)
Theorem hlt_admissible : forall A B C D E:set, A <> Empty -> B <> Empty -> C <> Empty -> D <> Empty -> E <> Empty -> forall p :e 2 :^: E :^: (B :^: C), forall lt :e 2 :^: A :^: C, forall s :e A :^: E, forall t :e D :^: E :^: (B :^: C), hl_admissible C A B E D lt p s t = 1 <-> forall f g :e B :^: C, forall a :e E, p f a = 1 /\ (p g a = 1 /\ (forall z :e C, lt z (s a) = 1 -> f z = g z)) -> t f a = t g a.
Admitted.

// HOL Light: define.ml:56 / tailadmissible   (hash md5:1c4b6569fbaf14b2d9943f6879c1be24)
Theorem hlt_tailadmissible : forall A B P:set, A <> Empty -> B <> Empty -> P <> Empty -> forall lt :e 2 :^: A :^: A, forall s :e A :^: P, forall p :e 2 :^: P :^: (B :^: A), forall t :e B :^: P :^: (B :^: A), hl_tailadmissible A B P lt p s t = 1 <-> exists P1 :e 2 :^: P :^: (B :^: A), exists G :e A :^: P :^: (B :^: A), exists H :e B :^: P :^: (B :^: A), (forall f :e B :^: A, forall a :e P, forall y :e A, P1 f a = 1 /\ lt y (G f a) = 1 -> lt y (s a) = 1) /\ ((forall f g :e B :^: A, forall a :e P, (forall z :e A, lt z (s a) = 1 -> f z = g z) -> (P1 f a = 1 <-> P1 g a = 1) /\ (G f a = G g a /\ H f a = H g a)) /\ forall f :e B :^: A, forall a :e P, p f a = 1 -> t f a = hl_COND B (P1 f a) (f (G f a)) (H f a)).
Admitted.

// HOL Light: define.ml:65 / superadmissible   (hash md5:a80e37dca25b87283e6f9eeb4e4188ce)
Theorem hlt_superadmissible : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall lt :e 2 :^: A :^: A, forall p :e 2 :^: C :^: (B :^: A), forall s :e A :^: C, forall t :e B :^: C :^: (B :^: A), hl_superadmissible A B C lt p s t = 1 <-> hl_admissible A A B C 2 lt (fun f :e B :^: A => fun a :e C => if True then 1 else 0) s p = 1 -> hl_tailadmissible A B C lt p s t = 1.
Admitted.

// HOL Light: define.ml:73 / MATCH_SEQPATTERN   (hash md5:2719e8f75f67f2a6d564cc1938b1c3ff)
Theorem hlt_MATCH_SEQPATTERN : forall A B:set, A <> Empty -> B <> Empty -> forall x :e B, forall r s :e 2 :^: A :^: B, hl__MATCH B A x (hl__SEQPATTERN B A r s) = hl_COND A (if exists y :e A, r x y = 1 then 1 else 0) (hl__MATCH B A x r) (hl__MATCH B A x s).
Admitted.

// HOL Light: define.ml:82 / ADMISSIBLE_CONST   (hash md5:bb96cb18747abad22ab85274e4d36cdf)
Theorem hlt_ADMISSIBLE_CONST : forall A B C D E:set, A <> Empty -> B <> Empty -> C <> Empty -> D <> Empty -> E <> Empty -> forall lt :e 2 :^: A :^: B, forall p :e 2 :^: D :^: (C :^: B), forall s :e A :^: D, forall c :e E :^: D, hl_admissible B A C D E lt p s (fun f :e C :^: B => c) = 1.
Admitted.

// HOL Light: define.ml:86 / ADMISSIBLE_BASE   (hash md5:f147c06a32f964f30d1a9b9b9c9fec00)
Theorem hlt_ADMISSIBLE_BASE : forall A B P:set, A <> Empty -> B <> Empty -> P <> Empty -> forall lt :e 2 :^: A :^: A, forall p :e 2 :^: P :^: (B :^: A), forall s t :e A :^: P, (forall f :e B :^: A, forall a :e P, p f a = 1 -> lt (t a) (s a) = 1) -> hl_admissible A A B P B lt p s (fun f :e B :^: A => fun x :e P => f (t x)) = 1.
Admitted.

// HOL Light: define.ml:92 / ADMISSIBLE_COMB   (hash md5:ac115267ecb12e4de5a5ed34c553a478)
Theorem hlt_ADMISSIBLE_COMB : forall A B C D P:set, A <> Empty -> B <> Empty -> C <> Empty -> D <> Empty -> P <> Empty -> forall lt :e 2 :^: A :^: A, forall p :e 2 :^: P :^: (B :^: A), forall s :e A :^: P, forall g :e D :^: C :^: P :^: (B :^: A), forall y :e C :^: P :^: (B :^: A), hl_admissible A A B P (D :^: C) lt p s g = 1 /\ hl_admissible A A B P C lt p s y = 1 -> hl_admissible A A B P D lt p s (fun f :e B :^: A => fun x :e P => g f x (y f x)) = 1.
Admitted.

// HOL Light: define.ml:98 / ADMISSIBLE_RAND   (hash md5:fd6452976bf99771b28a13b5be85e443)
Theorem hlt_ADMISSIBLE_RAND : forall A B C D P:set, A <> Empty -> B <> Empty -> C <> Empty -> D <> Empty -> P <> Empty -> forall lt :e 2 :^: A :^: A, forall p :e 2 :^: P :^: (B :^: A), forall s :e A :^: P, forall g :e D :^: C :^: P, forall y :e C :^: P :^: (B :^: A), hl_admissible A A B P C lt p s y = 1 -> hl_admissible A A B P D lt p s (fun f :e B :^: A => fun x :e P => g x (y f x)) = 1.
Admitted.

// HOL Light: define.ml:104 / ADMISSIBLE_LAMBDA   (hash md5:5a8d26b12fc402d07f42dc5a7b7d537d)
Theorem hlt_ADMISSIBLE_LAMBDA : forall A B C P:set, A <> Empty -> B <> Empty -> C <> Empty -> P <> Empty -> forall lt :e 2 :^: A :^: A, forall p :e 2 :^: P :^: (B :^: A), forall s :e A :^: P, forall t :e 2 :^: P :^: C :^: (B :^: A), hl_admissible A A B (C :*: P) 2 lt (fun f :e B :^: A => hl_GABS (2 :^: (C :*: P)) (fun f1 :e 2 :^: (C :*: P) => if forall u :e C, forall x :e P, hl_GEQ 2 (f1 (hl_pair C P u x)) (p f x) = 1 then 1 else 0)) (hl_GABS (A :^: (C :*: P)) (fun f :e A :^: (C :*: P) => if forall u :e C, forall x :e P, hl_GEQ A (f (hl_pair C P u x)) (s x) = 1 then 1 else 0)) (fun f :e B :^: A => hl_GABS (2 :^: (C :*: P)) (fun f1 :e 2 :^: (C :*: P) => if forall u :e C, forall x :e P, hl_GEQ 2 (f1 (hl_pair C P u x)) (t f u x) = 1 then 1 else 0)) = 1 -> hl_admissible A A B P (2 :^: C) lt p s (fun f :e B :^: A => fun x :e P => fun u :e C => t f u x) = 1.
Admitted.

// HOL Light: define.ml:110 / ADMISSIBLE_NEST   (hash md5:b6ca3290ca80b3845d272118f8ba5fe8)
Theorem hlt_ADMISSIBLE_NEST : forall A B P:set, A <> Empty -> B <> Empty -> P <> Empty -> forall lt :e 2 :^: A :^: A, forall p :e 2 :^: P :^: (B :^: A), forall s :e A :^: P, forall t :e A :^: P :^: (B :^: A), hl_admissible A A B P A lt p s t = 1 /\ (forall f :e B :^: A, forall a :e P, p f a = 1 -> lt (t f a) (s a) = 1) -> hl_admissible A A B P B lt p s (fun f :e B :^: A => fun x :e P => f (t f x)) = 1.
