// HOL Light: define.ml:162 / ADMISSIBLE_GUARDED_PATTERN   (hash md5:b89dfe4e85509fd42f53d6022d562cd9)
Theorem hlt_ADMISSIBLE_GUARDED_PATTERN : forall A B C D E P:set, A <> Empty -> B <> Empty -> C <> Empty -> D <> Empty -> E <> Empty -> P <> Empty -> forall lt :e 2 :^: A :^: B, forall p :e 2 :^: P :^: (C :^: B), forall s :e A :^: P, forall pat :e D :^: P :^: (C :^: B), forall q :e 2 :^: P :^: (C :^: B), forall e1 :e D :^: P :^: (C :^: B), forall t y :e E :^: P :^: (C :^: B), hl_admissible B A C P D lt p s pat = 1 /\ (hl_admissible B A C P D lt p s e1 = 1 /\ (hl_admissible B A C P E lt (fun f :e C :^: B => fun x :e P => if p f x = 1 /\ (pat f x = e1 f x /\ q f x = 1) then 1 else 0) s t = 1 /\ (hl_admissible B A C P 2 lt (fun f :e C :^: B => fun x :e P => if p f x = 1 /\ pat f x = e1 f x then 1 else 0) s q = 1 /\ hl_admissible B A C P E lt (fun f :e C :^: B => fun x :e P => if p f x = 1 /\ (pat f x = e1 f x /\ q f x = 1) then 1 else 0) s y = 1))) -> hl_admissible B A C P 2 lt p s (fun f :e C :^: B => fun x :e P => hl__GUARDED_PATTERN (hl_GEQ D (pat f x) (e1 f x)) (q f x) (hl_GEQ E (t f x) (y f x))) = 1.
