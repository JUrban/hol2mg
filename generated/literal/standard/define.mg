// HOL Light: define.ml:136 / ADMISSIBLE_SEQPATTERN   (hash md5:461f008fdef484c64584686580e7a3e7)
Theorem hlt_ADMISSIBLE_SEQPATTERN : forall A B C D E P:set, A <> Empty -> B <> Empty -> C <> Empty -> D <> Empty -> E <> Empty -> P <> Empty -> forall lt :e 2 :^: A :^: B, forall p :e 2 :^: P :^: (C :^: B), forall s :e A :^: P, forall c1 c2 :e 2 :^: D :^: E :^: P :^: (C :^: B), forall e1 :e E :^: P :^: (C :^: B), hl_admissible B A C P 2 lt p s (fun f :e C :^: B => fun x :e P => if exists y :e D, c1 f x (e1 f x) y = 1 then 1 else 0) = 1 /\ (hl_admissible B A C P (2 :^: D) lt (fun f :e C :^: B => fun x :e P => if p f x = 1 /\ exists y :e D, c1 f x (e1 f x) y = 1 then 1 else 0) s (fun f :e C :^: B => fun x :e P => c1 f x (e1 f x)) = 1 /\ hl_admissible B A C P (2 :^: D) lt (fun f :e C :^: B => fun x :e P => if p f x = 1 /\ ~ exists y :e D, c1 f x (e1 f x) y = 1 then 1 else 0) s (fun f :e C :^: B => fun x :e P => c2 f x (e1 f x)) = 1) -> hl_admissible B A C P (2 :^: D) lt p s (fun f :e C :^: B => fun x :e P => hl__SEQPATTERN E D (c1 f x) (c2 f x) (e1 f x)) = 1.
