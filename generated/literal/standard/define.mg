Theorem hlt_WF_REC_CASES : forall A B P:set, A <> Empty -> B <> Empty -> P <> Empty -> forall lt :e 2 :^: A :^: A, forall clauses :e finseq (A :^: P :*: B :^: P :^: (B :^: A)), hl_WF A lt = 1 /\ hl_ALL (A :^: P :*: B :^: P :^: (B :^: A)) (hl_GABS (2 :^: (A :^: P :*: B :^: P :^: (B :^: A))) (fun f :e 2 :^: (A :^: P :*: B :^: P :^: (B :^: A)) => if forall s :e A :^: P, forall t :e B :^: P :^: (B :^: A), hl_GEQ 2 (f (hl_pair (A :^: P) (B :^: P :^: (B :^: A)) s t)) (if exists P1 :e 2 :^: P :^: (B :^: A), exists G :e A :^: P :^: (B :^: A), exists H :e B :^: P :^: (B :^: A), (forall f1 :e B :^: A, forall a :e P, forall y :e A, P1 f1 a = 1 /\ lt y (G f1 a) = 1 -> lt y (s a) = 1) /\ ((forall f1 g :e B :^: A, forall a :e P, (forall z :e A, lt z (s a) = 1 -> f1 z = g z) -> (P1 f1 a = 1 <-> P1 g a = 1) /\ (G f1 a = G g a /\ H f1 a = H g a)) /\ forall f1 :e B :^: A, forall a :e P, t f1 a = hl_COND B (P1 f1 a) (f1 (G f1 a)) (H f1 a)) then 1 else 0) = 1 then 1 else 0)) clauses = 1 -> exists f :e B :^: A, forall x :e A, f x = hl_CASEWISE P A (B :^: A) B clauses f x.
