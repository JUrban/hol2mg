Theorem hlt_ADMISSIBLE_SUM : forall A B C P:set, A <> Empty -> B <> Empty -> C <> Empty -> P <> Empty -> forall lt :e 2 :^: A :^: B, forall p :e 2 :^: P :^: (C :^: B), forall s :e A :^: P, forall h :e R :^: omega :^: P :^: (C :^: B), forall a b :e omega :^: P, hl_admissible B A C (omega :*: P) R lt (fun f :e C :^: B => hl_GABS (2 :^: (omega :*: P)) (fun f1 :e 2 :^: (omega :*: P) => if forall k :e omega, forall x :e P, hl_GEQ 2 (f1 (hl_pair omega P k x)) (if hl_le (a x) k = 1 /\ (hl_le k (b x) = 1 /\ p f x = 1) then 1 else 0) = 1 then 1 else 0)) (hl_GABS (A :^: (omega :*: P)) (fun f :e A :^: (omega :*: P) => if forall k :e omega, forall x :e P, hl_GEQ A (f (hl_pair omega P k x)) (s x) = 1 then 1 else 0)) (fun f :e C :^: B => hl_GABS (R :^: (omega :*: P)) (fun f1 :e R :^: (omega :*: P) => if forall k :e omega, forall x :e P, hl_GEQ R (f1 (hl_pair omega P k x)) (h f x k) = 1 then 1 else 0)) = 1 -> hl_admissible B A C P R lt p s (fun f :e C :^: B => fun x :e P => hl_sum omega (hl_numseg (a x) (b x)) (h f x)) = 1.
