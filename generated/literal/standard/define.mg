Theorem hlt_WF_REC_TAIL_GENERAL' : forall A B:set, A <> Empty -> B <> Empty -> forall lt :e 2 :^: B :^: B, forall P :e 2 :^: B :^: (A :^: B), forall G :e B :^: B :^: (A :^: B), forall H H' :e A :^: B :^: (A :^: B), hl_WF B lt = 1 /\ ((forall f g :e A :^: B, forall x :e B, (forall z :e B, lt z x = 1 -> f z = g z) -> (P f x = 1 <-> P g x = 1) /\ (G f x = G g x /\ H' f x = H' g x)) /\ ((forall f :e A :^: B, forall x y :e B, P f x = 1 /\ lt y (G f x) = 1 -> lt y x = 1) /\ (forall f :e A :^: B, forall x :e B, H f x = hl_COND A (P f x) (f (G f x)) (H' f x)))) -> exists f :e A :^: B, forall x :e B, f x = H f x.
