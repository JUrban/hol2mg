// HOL Light: Multivariate/topology.ml:3609 / LIM_WITHIN_OPEN_IN   (hash md5:c78c85203cb203aef8a1e9645337f760)
Theorem hlt_LIM_WITHIN_OPEN_IN : forall M N:set, M <> Empty -> N <> Empty -> forall f :e hl_ty_cart R N :^: hl_ty_cart R M, forall l :e hl_ty_cart R N, forall a :e hl_ty_cart R M, forall s t :e 2 :^: hl_ty_cart R M, hl_IN (hl_ty_cart R M) a t = 1 /\ hl_open_in (hl_ty_cart R M) (hl_subtopology (hl_ty_cart R M) (hl_euclidean M) s) t = 1 -> (hl_tendsto (hl_ty_cart R M) N f l (hl_within (hl_ty_cart R M) (hl_at M a) t) = 1 <-> hl_tendsto (hl_ty_cart R M) N f l (hl_within (hl_ty_cart R M) (hl_at M a) s) = 1).
