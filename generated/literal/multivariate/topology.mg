Theorem hlt_CAUCHY_ABSOLUTELY_SUMMABLE_SUBSEQUENCE : forall N:set, N <> Empty -> forall x :e hl_ty_cart R N :^: omega, hl_cauchy N x = 1 -> exists r :e omega :^: omega, (forall m n :e omega, hl_lt m n = 1 -> hl_lt (r m) (r n) = 1) /\ hl_summable 1 (hl_from (hl_NUMERAL hl_zero)) (fun n :e omega => hl_lift (hl_distance N (hl_pair (hl_ty_cart R N) (hl_ty_cart R N) (x (r (hl_add n (hl_NUMERAL (hl_BIT1 hl_zero))))) (x (r n))))) = 1.
