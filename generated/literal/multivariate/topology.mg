Theorem hlt_LIM_TRANSFORM_WITHIN_OPEN : forall M N:set, M <> Empty -> N <> Empty -> forall f g :e hl_ty_cart R N :^: hl_ty_cart R M, forall s :e 2 :^: hl_ty_cart R M, forall a :e hl_ty_cart R M, forall l :e hl_ty_cart R N, hl_open M s = 1 /\ (hl_IN (hl_ty_cart R M) a s = 1 /\ ((forall x :e hl_ty_cart R M, hl_IN (hl_ty_cart R M) x s = 1 /\ ~ x = a -> f x = g x) /\ hl_tendsto (hl_ty_cart R M) N f l (hl_at M a) = 1)) -> hl_tendsto (hl_ty_cart R M) N g l (hl_at M a) = 1.
