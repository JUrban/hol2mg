Theorem hlt_LIM_AT_WITHIN : forall A B:set, A <> Empty -> B <> Empty -> forall f :e hl_ty_cart R A :^: hl_ty_cart R B, forall l :e hl_ty_cart R A, forall a :e hl_ty_cart R B, forall s :e 2 :^: hl_ty_cart R B, hl_tendsto (hl_ty_cart R B) A f l (hl_at B a) = 1 -> hl_tendsto (hl_ty_cart R B) A f l (hl_within (hl_ty_cart R B) (hl_at B a) s) = 1.
