Theorem hlt_DENSE_OPEN_INTER : forall N:set, N <> Empty -> forall s t u :e 2 :^: hl_ty_cart R N, hl_open_in (hl_ty_cart R N) (hl_subtopology (hl_ty_cart R N) (hl_euclidean N) u) s = 1 /\ hl_SUBSET (hl_ty_cart R N) t u = 1 \/ hl_open_in (hl_ty_cart R N) (hl_subtopology (hl_ty_cart R N) (hl_euclidean N) u) t = 1 /\ hl_SUBSET (hl_ty_cart R N) s u = 1 -> (hl_SUBSET (hl_ty_cart R N) u (hl_closure N (hl_INTER (hl_ty_cart R N) s t)) = 1 <-> hl_SUBSET (hl_ty_cart R N) u (hl_closure N s) = 1 /\ hl_SUBSET (hl_ty_cart R N) u (hl_closure N t) = 1).
