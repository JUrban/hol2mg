Theorem hlt_LIM_BILINEAR_CONVOLUTION : forall M N P:set, M <> Empty -> N <> Empty -> P <> Empty -> forall bop :e hl_ty_cart R P :^: hl_ty_cart R N :^: hl_ty_cart R M, forall x :e hl_ty_cart R M :^: omega, forall y :e hl_ty_cart R N :^: omega, forall m :e omega, forall k :e R, forall a :e hl_ty_cart R M, forall b :e hl_ty_cart R N, hl_bilinear M N P bop = 1 /\ (hl_tendsto omega M x a hl_sequentially = 1 /\ hl_tendsto omega N y b hl_sequentially = 1) -> hl_tendsto omega P (fun n :e omega => hl_vmul P (hl_real_inv (hl_real_add (hl_real_of_num n) k)) (hl_vsum omega P (hl_numseg m n) (fun i :e omega => bop (x i) (y (hl_sub n i))))) (bop a b) hl_sequentially = 1.
