// HOL Light: Multivariate/topology.ml:4418 / LINEAR_LIMIT   (hash md5:3bd454184f972fce048c86e9f1b1b960)
Theorem hlt_LINEAR_LIMIT : forall A M N:set, A <> Empty -> M <> Empty -> N <> Empty -> forall net1 :e hl_ty_net A, forall f :e hl_ty_cart R N :^: hl_ty_cart R M :^: A, forall g :e hl_ty_cart R N :^: hl_ty_cart R M, ~ hl_trivial_limit A net1 = 1 /\ (hl_eventually A (fun i :e A => hl_linear M N (f i)) net1 = 1 /\ (forall x :e hl_ty_cart R M, hl_tendsto A N (fun i :e A => f i x) (g x) net1 = 1)) -> hl_linear M N g = 1.
