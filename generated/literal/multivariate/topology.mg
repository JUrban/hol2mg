// HOL Light: Multivariate/topology.ml:6941 / LIM_WITHIN_SEQUENTIALLY   (hash md5:33b4741620cbcc3b03e6f76199bc3600)
Theorem hlt_LIM_WITHIN_SEQUENTIALLY : forall M N:set, M <> Empty -> N <> Empty -> forall f :e hl_ty_cart R N :^: hl_ty_cart R M, forall s :e 2 :^: hl_ty_cart R M, forall a :e hl_ty_cart R M, forall l :e hl_ty_cart R N, hl_tendsto (hl_ty_cart R M) N f l (hl_within (hl_ty_cart R M) (hl_at M a) s) = 1 <-> forall x :e hl_ty_cart R M :^: omega, (forall n :e omega, hl_IN (hl_ty_cart R M) (x n) (hl_DELETE (hl_ty_cart R M) s a) = 1) /\ hl_tendsto omega M x a hl_sequentially = 1 -> hl_tendsto omega N (hl_o (hl_ty_cart R M) (hl_ty_cart R N) omega f x) l hl_sequentially = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:6952 / LIM_WITHIN_SEQUENTIALLY_INJ   (hash md5:145741ac72565b959ebe0b36de8c1285)
Theorem hlt_LIM_WITHIN_SEQUENTIALLY_INJ : forall M N:set, M <> Empty -> N <> Empty -> forall f :e hl_ty_cart R N :^: hl_ty_cart R M, forall s :e 2 :^: hl_ty_cart R M, forall a :e hl_ty_cart R M, forall l :e hl_ty_cart R N, hl_tendsto (hl_ty_cart R M) N f l (hl_within (hl_ty_cart R M) (hl_at M a) s) = 1 <-> forall x :e hl_ty_cart R M :^: omega, (forall n :e omega, hl_IN (hl_ty_cart R M) (x n) (hl_DELETE (hl_ty_cart R M) s a) = 1) /\ ((forall m n :e omega, x m = x n <-> m = n) /\ hl_tendsto omega M x a hl_sequentially = 1) -> hl_tendsto omega N (hl_o (hl_ty_cart R M) (hl_ty_cart R N) omega f x) l hl_sequentially = 1.
