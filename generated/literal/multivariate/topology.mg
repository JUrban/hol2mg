Theorem hlt_DINI : forall N:set, N <> Empty -> forall f :e hl_ty_cart R 1 :^: hl_ty_cart R N :^: omega, forall g :e hl_ty_cart R 1 :^: hl_ty_cart R N, forall s :e 2 :^: hl_ty_cart R N, hl_compact N s = 1 /\ ((forall n :e omega, hl_continuous_on N 1 (f n) s = 1) /\ (hl_continuous_on N 1 g s = 1 /\ ((forall x :e hl_ty_cart R N, hl_IN (hl_ty_cart R N) x s = 1 -> hl_tendsto omega 1 (fun n :e omega => f n x) (g x) hl_sequentially = 1) /\ (forall n :e omega, forall x :e hl_ty_cart R N, hl_IN (hl_ty_cart R N) x s = 1 -> hl_real_le (hl_drop (f n x)) (hl_drop (f (hl_add n (hl_NUMERAL (hl_BIT1 hl_zero))) x)) = 1)))) -> forall e1 :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) e1 = 1 -> hl_eventually omega (fun n :e omega => if forall x :e hl_ty_cart R N, hl_IN (hl_ty_cart R N) x s = 1 -> hl_real_lt (hl_vector_norm 1 (hl_vector_sub 1 (f n x) (g x))) e1 = 1 then 1 else 0) hl_sequentially = 1.
