// HOL Light: Multivariate/topology.ml:3995 / LIM_NULL_VMUL_BOUNDED   (hash md5:d59210c321e90b4e28e7b24abbb0c4ce)
Theorem hlt_LIM_NULL_VMUL_BOUNDED : forall A N:set, A <> Empty -> N <> Empty -> forall net1 :e hl_ty_net A, forall f :e R :^: A, forall g :e hl_ty_cart R N :^: A, forall B :e R, hl_tendsto A 1 (hl_o R (hl_ty_cart R 1) A hl_lift f) (hl_vec 1 (hl_NUMERAL hl_zero)) net1 = 1 /\ hl_eventually A (fun a :e A => if f a = hl_real_of_num (hl_NUMERAL hl_zero) \/ hl_real_le (hl_vector_norm N (g a)) B = 1 then 1 else 0) net1 = 1 -> hl_tendsto A N (fun n :e A => hl_vmul N (f n) (g n)) (hl_vec N (hl_NUMERAL hl_zero)) net1 = 1.
