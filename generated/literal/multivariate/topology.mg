// HOL Light: Multivariate/topology.ml:4298 / LIM_TRANSFORM_EVENTUALLY   (hash md5:1216c1f70422d39e34c8329f2bfda8f7)
Theorem hlt_LIM_TRANSFORM_EVENTUALLY : forall A B:set, A <> Empty -> B <> Empty -> forall net1 :e hl_ty_net A, forall f g :e hl_ty_cart R B :^: A, forall l :e hl_ty_cart R B, hl_eventually A (fun x :e A => if f x = g x then 1 else 0) net1 = 1 /\ hl_tendsto A B f l net1 = 1 -> hl_tendsto A B g l net1 = 1.
