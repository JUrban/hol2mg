// HOL Light: Multivariate/topology.ml:4325 / LIM_TRANSFORM_EQ   (hash md5:d9bfe47325af31d98ac8677590932f7a)
Theorem hlt_LIM_TRANSFORM_EQ : forall A N:set, A <> Empty -> N <> Empty -> forall net1 :e hl_ty_net A, forall f g :e hl_ty_cart R N :^: A, forall l :e hl_ty_cart R N, hl_tendsto A N (fun x :e A => hl_vector_sub N (f x) (g x)) (hl_vec N (hl_NUMERAL hl_zero)) net1 = 1 -> (hl_tendsto A N f l net1 = 1 <-> hl_tendsto A N g l net1 = 1).
