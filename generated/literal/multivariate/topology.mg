Theorem hlt_BALL_LINEAR_IMAGE : forall M N:set, M <> Empty -> N <> Empty -> forall f :e hl_ty_cart R N :^: hl_ty_cart R M, forall x :e hl_ty_cart R M, forall r :e R, hl_linear M N f = 1 /\ ((forall y :e hl_ty_cart R N, exists x1 :e hl_ty_cart R M, f x1 = y) /\ (forall x1 :e hl_ty_cart R M, hl_vector_norm N (f x1) = hl_vector_norm M x1)) -> hl_ball N (hl_pair (hl_ty_cart R N) R (f x) r) = hl_IMAGE (hl_ty_cart R M) (hl_ty_cart R N) f (hl_ball M (hl_pair (hl_ty_cart R M) R x r)).
Admitted.

