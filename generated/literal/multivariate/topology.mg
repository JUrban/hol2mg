// HOL Light: Multivariate/topology.ml:4441 / LINEAR_SEQUENTIAL_LIMIT   (hash md5:8e42dbb71f6476325bdfcbd3b1648360)
Theorem hlt_LINEAR_SEQUENTIAL_LIMIT : forall M N:set, M <> Empty -> N <> Empty -> forall f :e hl_ty_cart R N :^: hl_ty_cart R M :^: omega, forall g :e hl_ty_cart R N :^: hl_ty_cart R M, hl_eventually omega (fun n :e omega => hl_linear M N (f n)) hl_sequentially = 1 /\ (forall x :e hl_ty_cart R M, hl_tendsto omega N (fun n :e omega => f n x) (g x) hl_sequentially = 1) -> hl_linear M N g = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:4454 / LIM_CASES_FINITE_SEQUENTIALLY   (hash md5:3565ff4f40de2b4e5d34bd49abd5866d)
Theorem hlt_LIM_CASES_FINITE_SEQUENTIALLY : forall A:set, A <> Empty -> forall P :e 2 :^: omega, forall f g :e hl_ty_cart R A :^: omega, forall l :e hl_ty_cart R A, hl_FINITE omega (hl_GSPEC omega (fun GEN_PVAR_3157 :e omega => if exists n :e omega, hl_SETSPEC omega GEN_PVAR_3157 (P n) n = 1 then 1 else 0)) = 1 -> (hl_tendsto omega A (fun n :e omega => hl_COND (hl_ty_cart R A) (P n) (f n) (g n)) l hl_sequentially = 1 <-> hl_tendsto omega A g l hl_sequentially = 1).
