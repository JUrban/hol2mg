// HOL Light: Multivariate/topology.ml:11013 / CONNECTED_COMPONENT_NONOVERLAP   (hash md5:ce15d5473a83ca94ed9ddae26f862e69)
Theorem hlt_CONNECTED_COMPONENT_NONOVERLAP : forall N:set, N <> Empty -> forall s :e 2 :^: hl_ty_cart R N, forall a b :e hl_ty_cart R N, hl_INTER (hl_ty_cart R N) (hl_connected_component N s a) (hl_connected_component N s b) = hl_EMPTY (hl_ty_cart R N) <-> ~ hl_IN (hl_ty_cart R N) a s = 1 \/ (~ hl_IN (hl_ty_cart R N) b s = 1 \/ ~ hl_connected_component N s a = hl_connected_component N s b).
