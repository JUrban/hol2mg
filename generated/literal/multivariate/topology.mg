Theorem hlt_INFINITE_OPEN_IN : forall N:set, N <> Empty -> forall u s :e 2 :^: hl_ty_cart R N, hl_open_in (hl_ty_cart R N) (hl_subtopology (hl_ty_cart R N) (hl_euclidean N) u) s = 1 /\ (exists x :e hl_ty_cart R N, hl_IN (hl_ty_cart R N) x s = 1 /\ hl_limit_point_of N x u = 1) -> hl_INFINITE (hl_ty_cart R N) s = 1.
