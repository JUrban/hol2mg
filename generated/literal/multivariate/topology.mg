Theorem hlt_CONNECTED_COMPONENT_EQUIVALENCE_RELATION : forall N:set, N <> Empty -> forall R1 :e 2 :^: hl_ty_cart R N :^: hl_ty_cart R N, forall s :e 2 :^: hl_ty_cart R N, (forall x y :e hl_ty_cart R N, R1 x y = 1 -> R1 y x = 1) /\ ((forall x y z :e hl_ty_cart R N, R1 x y = 1 /\ R1 y z = 1 -> R1 x z = 1) /\ (forall a :e hl_ty_cart R N, hl_IN (hl_ty_cart R N) a s = 1 -> exists t :e 2 :^: hl_ty_cart R N, hl_open_in (hl_ty_cart R N) (hl_subtopology (hl_ty_cart R N) (hl_euclidean N) s) t = 1 /\ (hl_IN (hl_ty_cart R N) a t = 1 /\ forall x :e hl_ty_cart R N, hl_IN (hl_ty_cart R N) x t = 1 -> R1 a x = 1))) -> forall a b :e hl_ty_cart R N, hl_connected_component N s a b = 1 -> R1 a b = 1.
