// HOL Light: Multivariate/topology.ml:20148 / EIGENVALUE_LOWERBOUND_DOT   (hash md5:7d4b3d8ef2f6ffd82b2840cfc7142b65)
Theorem hlt_EIGENVALUE_LOWERBOUND_DOT : forall N:set, N <> Empty -> forall A :e hl_ty_cart (hl_ty_cart R N) N, forall a :e R, hl_symmetric_matrix N A = 1 /\ (forall c :e R, forall v :e hl_ty_cart R N, hl_matrix_vector_mul N N A v = hl_vmul N c v /\ ~ v = hl_vec N (hl_NUMERAL hl_zero) -> hl_real_le a c = 1) -> forall x :e hl_ty_cart R N, hl_real_le (hl_real_mul a (hl_real_pow (hl_vector_norm N x) (hl_NUMERAL (hl_BIT0 (hl_BIT1 hl_zero))))) (hl_dot N x (hl_matrix_vector_mul N N A x)) = 1.
