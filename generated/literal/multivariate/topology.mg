// HOL Light: Multivariate/topology.ml:3706 / condensation_point_of   (hash md5:7d9da0c578edacefaaaffe00d653fbf7)
Theorem hlt_condensation_point_of_thm : forall A:set, A <> Empty -> forall x :e hl_ty_cart R A, forall s :e 2 :^: hl_ty_cart R A, hl_condensation_point_of A x s = 1 <-> forall t :e 2 :^: hl_ty_cart R A, hl_IN (hl_ty_cart R A) x t = 1 /\ hl_open A t = 1 -> ~ hl_COUNTABLE (hl_ty_cart R A) (hl_INTER (hl_ty_cart R A) s t) = 1.
