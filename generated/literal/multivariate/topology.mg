// HOL Light: Multivariate/topology.ml:4125 / LIM_AT_ZERO   (hash md5:ec32a2ef288a8ab7bf5387338d1e4d67)
Theorem hlt_LIM_AT_ZERO : forall M N:set, M <> Empty -> N <> Empty -> forall f :e hl_ty_cart R N :^: hl_ty_cart R M, forall l :e hl_ty_cart R N, forall a :e hl_ty_cart R M, hl_tendsto (hl_ty_cart R M) N f l (hl_at M a) = 1 <-> hl_tendsto (hl_ty_cart R M) N (fun x :e hl_ty_cart R M => f (hl_vector_add M a x)) l (hl_at M (hl_vec M (hl_NUMERAL hl_zero))) = 1.
