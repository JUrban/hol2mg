Theorem hlt_EVENTUALLY_WITHIN_ZERO : forall N:set, N <> Empty -> forall P s :e 2 :^: hl_ty_cart R N, forall a :e hl_ty_cart R N, hl_eventually (hl_ty_cart R N) P (hl_within (hl_ty_cart R N) (hl_at N a) s) = 1 <-> hl_eventually (hl_ty_cart R N) (fun x :e hl_ty_cart R N => P (hl_vector_add N a x)) (hl_within (hl_ty_cart R N) (hl_at N (hl_vec N (hl_NUMERAL hl_zero))) (hl_IMAGE (hl_ty_cart R N) (hl_ty_cart R N) (fun x :e hl_ty_cart R N => hl_vector_sub N x a) s)) = 1.
