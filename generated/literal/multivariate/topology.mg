// HOL Light: Multivariate/topology.ml:5367 / INTER_BALLS_EQ_EMPTY   (hash md5:68dd65f697f1c907fc1744ad687f0256)
Theorem hlt_INTER_BALLS_EQ_EMPTY : forall N:set, N <> Empty -> (forall a b :e hl_ty_cart R N, forall r s :e R, hl_INTER (hl_ty_cart R N) (hl_ball N (hl_pair (hl_ty_cart R N) R a r)) (hl_ball N (hl_pair (hl_ty_cart R N) R b s)) = hl_EMPTY (hl_ty_cart R N) <-> hl_real_le r (hl_real_of_num (hl_NUMERAL hl_zero)) = 1 \/ (hl_real_le s (hl_real_of_num (hl_NUMERAL hl_zero)) = 1 \/ hl_real_le (hl_real_add r s) (hl_distance N (hl_pair (hl_ty_cart R N) (hl_ty_cart R N) a b)) = 1)) /\ ((forall a b :e hl_ty_cart R N, forall r s :e R, hl_INTER (hl_ty_cart R N) (hl_ball N (hl_pair (hl_ty_cart R N) R a r)) (hl_cball N (hl_pair (hl_ty_cart R N) R b s)) = hl_EMPTY (hl_ty_cart R N) <-> hl_real_le r (hl_real_of_num (hl_NUMERAL hl_zero)) = 1 \/ (hl_real_lt s (hl_real_of_num (hl_NUMERAL hl_zero)) = 1 \/ hl_real_le (hl_real_add r s) (hl_distance N (hl_pair (hl_ty_cart R N) (hl_ty_cart R N) a b)) = 1)) /\ ((forall a b :e hl_ty_cart R N, forall r s :e R, hl_INTER (hl_ty_cart R N) (hl_cball N (hl_pair (hl_ty_cart R N) R a r)) (hl_ball N (hl_pair (hl_ty_cart R N) R b s)) = hl_EMPTY (hl_ty_cart R N) <-> hl_real_lt r (hl_real_of_num (hl_NUMERAL hl_zero)) = 1 \/ (hl_real_le s (hl_real_of_num (hl_NUMERAL hl_zero)) = 1 \/ hl_real_le (hl_real_add r s) (hl_distance N (hl_pair (hl_ty_cart R N) (hl_ty_cart R N) a b)) = 1)) /\ forall a b :e hl_ty_cart R N, forall r s :e R, hl_INTER (hl_ty_cart R N) (hl_cball N (hl_pair (hl_ty_cart R N) R a r)) (hl_cball N (hl_pair (hl_ty_cart R N) R b s)) = hl_EMPTY (hl_ty_cart R N) <-> hl_real_lt r (hl_real_of_num (hl_NUMERAL hl_zero)) = 1 \/ (hl_real_lt s (hl_real_of_num (hl_NUMERAL hl_zero)) = 1 \/ hl_real_lt (hl_real_add r s) (hl_distance N (hl_pair (hl_ty_cart R N) (hl_ty_cart R N) a b)) = 1))).
