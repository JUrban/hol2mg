Theorem hlt_CONNECTED_COMPONENT_UNIQUE : forall N:set, N <> Empty -> forall s c :e 2 :^: hl_ty_cart R N, forall x :e hl_ty_cart R N, hl_IN (hl_ty_cart R N) x c = 1 /\ (hl_SUBSET (hl_ty_cart R N) c s = 1 /\ (hl_connected N c = 1 /\ (forall c' :e 2 :^: hl_ty_cart R N, hl_IN (hl_ty_cart R N) x c' = 1 /\ (hl_SUBSET (hl_ty_cart R N) c' s = 1 /\ hl_connected N c' = 1) -> hl_SUBSET (hl_ty_cart R N) c' c = 1))) -> hl_connected_component N s x = c.
