// HOL Light: Multivariate/topology.ml:19753 / DET_OPEN_MAP   (hash md5:bb75ed06a3ecac5e72a27f747566ddd5)
Theorem hlt_DET_OPEN_MAP : forall N:set, N <> Empty -> forall A :e hl_ty_cart (hl_ty_cart R N) N, forall e1 :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) e1 = 1 -> (exists B :e hl_ty_cart (hl_ty_cart R N) N, (forall i j :e omega, hl_real_lt (hl_real_abs (hl_real_sub (hl_vindex R N (hl_vindex (hl_ty_cart R N) N B i) j) (hl_vindex R N (hl_vindex (hl_ty_cart R N) N A i) j))) e1 = 1) /\ hl_real_lt (hl_det N B) (hl_det N A) = 1) /\ exists C :e hl_ty_cart (hl_ty_cart R N) N, (forall i j :e omega, hl_real_lt (hl_real_abs (hl_real_sub (hl_vindex R N (hl_vindex (hl_ty_cart R N) N C i) j) (hl_vindex R N (hl_vindex (hl_ty_cart R N) N A i) j))) e1 = 1) /\ hl_real_gt (hl_det N C) (hl_det N A) = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:19975 / SELF_ADJOINT_HAS_EIGENVECTOR_IN_SUBSPACE   (hash md5:b4d6f3b9fc55f9ceaab3f65a07433584)
Theorem hlt_SELF_ADJOINT_HAS_EIGENVECTOR_IN_SUBSPACE : forall N:set, N <> Empty -> forall f :e hl_ty_cart R N :^: hl_ty_cart R N, forall s :e 2 :^: hl_ty_cart R N, hl_linear N N f = 1 /\ (hl_adjoint N N f = f /\ (hl_subspace N s = 1 /\ (~ s = hl_INSERT (hl_ty_cart R N) (hl_vec N (hl_NUMERAL hl_zero)) (hl_EMPTY (hl_ty_cart R N)) /\ (forall x :e hl_ty_cart R N, hl_IN (hl_ty_cart R N) x s = 1 -> hl_IN (hl_ty_cart R N) (f x) s = 1)))) -> exists v :e hl_ty_cart R N, exists c :e R, hl_IN (hl_ty_cart R N) v s = 1 /\ (hl_vector_norm N v = hl_real_of_num (hl_NUMERAL (hl_BIT1 hl_zero)) /\ f v = hl_vmul N c v).
Admitted.

