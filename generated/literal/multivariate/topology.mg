// HOL Light: Multivariate/topology.ml:3304 / LIM_EVENTUALLY_IN_OPEN_IN   (hash md5:9d06aedd84bb9c42919d0107e31d6e4d)
Theorem hlt_LIM_EVENTUALLY_IN_OPEN_IN : forall A N:set, A <> Empty -> N <> Empty -> forall net1 :e hl_ty_net A, forall f :e hl_ty_cart R N :^: A, forall l :e hl_ty_cart R N, forall u s :e 2 :^: hl_ty_cart R N, hl_IN (hl_ty_cart R N) l s = 1 /\ (hl_open_in (hl_ty_cart R N) (hl_subtopology (hl_ty_cart R N) (hl_euclidean N) u) s = 1 /\ (hl_eventually A (fun x :e A => hl_IN (hl_ty_cart R N) (f x) u) net1 = 1 /\ hl_tendsto A N f l net1 = 1)) -> hl_eventually A (fun x :e A => hl_IN (hl_ty_cart R N) (f x) s) net1 = 1.
