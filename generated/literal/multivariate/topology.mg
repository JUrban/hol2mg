// HOL Light: Multivariate/topology.ml:6798 / CONTINUOUS_ON_RESTRICT   (hash md5:ebc7901585c31ba4d1128747f08b3113)
Theorem hlt_CONTINUOUS_ON_RESTRICT : forall M N:set, M <> Empty -> N <> Empty -> forall P :e 2 :^: hl_ty_cart R M, forall f g :e hl_ty_cart R N :^: hl_ty_cart R M, forall s :e 2 :^: hl_ty_cart R M, (forall x :e hl_ty_cart R M, hl_IN (hl_ty_cart R M) x s = 1 -> P x = 1) -> (hl_continuous_on M N (fun x :e hl_ty_cart R M => hl_COND (hl_ty_cart R N) (P x) (f x) (g x)) s = 1 <-> hl_continuous_on M N f s = 1).
