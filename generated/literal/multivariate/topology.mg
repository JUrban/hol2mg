// HOL Light: Multivariate/topology.ml:4244 / LIM_BILINEAR   (hash md5:26dc4bb6743ac31e8ce8b16ea2fb142b)
Theorem hlt_LIM_BILINEAR : forall A M N P:set, A <> Empty -> M <> Empty -> N <> Empty -> P <> Empty -> forall net1 :e hl_ty_net A, forall h :e hl_ty_cart R P :^: hl_ty_cart R N :^: hl_ty_cart R M, forall f :e hl_ty_cart R M :^: A, forall g :e hl_ty_cart R N :^: A, forall l :e hl_ty_cart R M, forall m :e hl_ty_cart R N, hl_tendsto A M f l net1 = 1 /\ (hl_tendsto A N g m net1 = 1 /\ hl_bilinear M N P h = 1) -> hl_tendsto A P (fun x :e A => h (f x) (g x)) (h l m) net1 = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:4258 / BILINEAR_EPSILON_DELTA   (hash md5:aeb69316bf45bad0958a3c7f303054c7)
Theorem hlt_BILINEAR_EPSILON_DELTA : forall M N P:set, M <> Empty -> N <> Empty -> P <> Empty -> forall bop :e hl_ty_cart R P :^: hl_ty_cart R N :^: hl_ty_cart R M, forall a :e hl_ty_cart R M, forall b :e hl_ty_cart R N, forall e1 :e R, hl_bilinear M N P bop = 1 /\ hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) e1 = 1 -> exists d :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) d = 1 /\ forall x :e hl_ty_cart R M, forall y :e hl_ty_cart R N, hl_real_lt (hl_vector_norm M (hl_vector_sub M x a)) d = 1 /\ hl_real_lt (hl_vector_norm N (hl_vector_sub N y b)) d = 1 -> hl_real_lt (hl_vector_norm P (hl_vector_sub P (bop x y) (bop a b))) e1 = 1.
