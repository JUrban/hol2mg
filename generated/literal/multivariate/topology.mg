// HOL Light: Multivariate/topology.ml:10957 / CONNECTED_COMPONENT_MAXIMAL   (hash md5:cc582d8d9db503c66f2ffecbd61dd55f)
Theorem hlt_CONNECTED_COMPONENT_MAXIMAL : forall N:set, N <> Empty -> forall s t :e 2 :^: hl_ty_cart R N, forall x :e hl_ty_cart R N, hl_IN (hl_ty_cart R N) x t = 1 /\ (hl_connected N t = 1 /\ hl_SUBSET (hl_ty_cart R N) t s = 1) -> hl_SUBSET (hl_ty_cart R N) t (hl_connected_component N s x) = 1.
