Theorem hlt_CONNECTED_COMPONENT_SET : forall A:set, A <> Empty -> forall s :e 2 :^: hl_ty_cart R A, forall x :e hl_ty_cart R A, hl_connected_component A s x = hl_GSPEC (hl_ty_cart R A) (fun GEN_PVAR_3465 :e hl_ty_cart R A => if exists y :e hl_ty_cart R A, hl_SETSPEC (hl_ty_cart R A) GEN_PVAR_3465 (if exists t :e 2 :^: hl_ty_cart R A, hl_connected A t = 1 /\ (hl_SUBSET (hl_ty_cart R A) t s = 1 /\ (hl_IN (hl_ty_cart R A) x t = 1 /\ hl_IN (hl_ty_cart R A) y t = 1)) then 1 else 0) y = 1 then 1 else 0).
