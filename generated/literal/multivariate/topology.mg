// HOL Light: Multivariate/topology.ml:3555 / LIM_UNION_UNIV   (hash md5:9e40a4f30a22ab7e2f081f3a3168f639)
Theorem hlt_LIM_UNION_UNIV : forall A N:set, A <> Empty -> N <> Empty -> forall f :e hl_ty_cart R A :^: hl_ty_cart R N, forall x :e hl_ty_cart R N, forall l :e hl_ty_cart R A, forall s t :e 2 :^: hl_ty_cart R N, hl_tendsto (hl_ty_cart R N) A f l (hl_within (hl_ty_cart R N) (hl_at N x) s) = 1 /\ (hl_tendsto (hl_ty_cart R N) A f l (hl_within (hl_ty_cart R N) (hl_at N x) t) = 1 /\ hl_UNION (hl_ty_cart R N) s t = hl_UNIV (hl_ty_cart R N)) -> hl_tendsto (hl_ty_cart R N) A f l (hl_at N x) = 1.
