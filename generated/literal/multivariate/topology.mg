Theorem hlt_CONNECTED_COMPONENT_TRANSLATION : forall A:set, A <> Empty -> forall a :e hl_ty_cart R A, forall s :e 2 :^: hl_ty_cart R A, forall x :e hl_ty_cart R A, hl_connected_component A (hl_IMAGE (hl_ty_cart R A) (hl_ty_cart R A) (fun x1 :e hl_ty_cart R A => hl_vector_add A a x1) s) (hl_vector_add A a x) = hl_IMAGE (hl_ty_cart R A) (hl_ty_cart R A) (fun x1 :e hl_ty_cart R A => hl_vector_add A a x1) (hl_connected_component A s x).
