// HOL Light: Multivariate/topology.ml:3959 / LIM_TRANSFORM_BOUND   (hash md5:178b683d633ca13d3ca3fd304c96bf83)
Theorem hlt_LIM_TRANSFORM_BOUND : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall net1 :e hl_ty_net A, forall f :e hl_ty_cart R C :^: A, forall g :e hl_ty_cart R B :^: A, hl_eventually A (fun n :e A => hl_real_le (hl_vector_norm C (f n)) (hl_vector_norm B (g n))) net1 = 1 /\ hl_tendsto A B g (hl_vec B (hl_NUMERAL hl_zero)) net1 = 1 -> hl_tendsto A C f (hl_vec C (hl_NUMERAL hl_zero)) net1 = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:3969 / LIM_NULL_CMUL_BOUNDED   (hash md5:509959a875c0a86f1fa2e02e8a429e78)
Theorem hlt_LIM_NULL_CMUL_BOUNDED : forall A N:set, A <> Empty -> N <> Empty -> forall net1 :e hl_ty_net A, forall f :e R :^: A, forall g :e hl_ty_cart R N :^: A, forall B :e R, hl_eventually A (fun a :e A => if g a = hl_vec N (hl_NUMERAL hl_zero) \/ hl_real_le (hl_real_abs (f a)) B = 1 then 1 else 0) net1 = 1 /\ hl_tendsto A N g (hl_vec N (hl_NUMERAL hl_zero)) net1 = 1 -> hl_tendsto A N (fun n :e A => hl_vmul N (f n) (g n)) (hl_vec N (hl_NUMERAL hl_zero)) net1 = 1.
