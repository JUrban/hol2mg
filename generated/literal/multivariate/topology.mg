// HOL Light: Multivariate/topology.ml:7049 / CONTINUOUS_AT_SEQUENTIALLY_ALT   (hash md5:f399feb8935b6547f7be0f7b26a9eb15)
Theorem hlt_CONTINUOUS_AT_SEQUENTIALLY_ALT : forall M N:set, M <> Empty -> N <> Empty -> forall f :e hl_ty_cart R N :^: hl_ty_cart R M, forall a :e hl_ty_cart R M, hl_continuous (hl_ty_cart R M) N f (hl_at M a) = 1 <-> forall e1 :e R, forall x :e hl_ty_cart R M :^: omega, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) e1 = 1 /\ ((forall n :e omega, ~ x n = a) /\ (hl_tendsto omega M x a hl_sequentially = 1 /\ (forall m n :e omega, x m = x n <-> m = n))) -> exists n :e omega, hl_real_lt (hl_distance N (hl_pair (hl_ty_cart R N) (hl_ty_cart R N) (f (x n)) (f a))) e1 = 1.
