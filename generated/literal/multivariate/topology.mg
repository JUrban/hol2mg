// HOL Light: Multivariate/topology.ml:4347 / LIM_TRANSFORM_WITHIN_SET_IMP   (hash md5:e20bbf632597fdc5a25fa17440f380f0)
Theorem hlt_LIM_TRANSFORM_WITHIN_SET_IMP : forall A B:set, A <> Empty -> B <> Empty -> forall f :e hl_ty_cart R A :^: hl_ty_cart R B, forall l :e hl_ty_cart R A, forall a :e hl_ty_cart R B, forall s t :e 2 :^: hl_ty_cart R B, hl_eventually (hl_ty_cart R B) (fun x :e hl_ty_cart R B => if hl_IN (hl_ty_cart R B) x t = 1 -> hl_IN (hl_ty_cart R B) x s = 1 then 1 else 0) (hl_at B a) = 1 /\ hl_tendsto (hl_ty_cart R B) A f l (hl_within (hl_ty_cart R B) (hl_at B a) s) = 1 -> hl_tendsto (hl_ty_cart R B) A f l (hl_within (hl_ty_cart R B) (hl_at B a) t) = 1.
