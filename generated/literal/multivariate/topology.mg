Theorem hlt_CONNECTED_COMPONENT_SEPARATED_UNION : forall N:set, N <> Empty -> forall s t :e 2 :^: hl_ty_cart R N, forall x :e hl_ty_cart R N, hl_INTER (hl_ty_cart R N) s (hl_closure N t) = hl_EMPTY (hl_ty_cart R N) /\ hl_INTER (hl_ty_cart R N) t (hl_closure N s) = hl_EMPTY (hl_ty_cart R N) -> hl_connected_component N (hl_UNION (hl_ty_cart R N) s t) x = hl_COND (2 :^: hl_ty_cart R N) (hl_IN (hl_ty_cart R N) x s) (hl_connected_component N s x) (hl_COND (2 :^: hl_ty_cart R N) (hl_IN (hl_ty_cart R N) x t) (hl_connected_component N t x) (hl_EMPTY (hl_ty_cart R N))).
