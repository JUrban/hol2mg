Theorem hlt_SAME_EIGENVALUES_MATRIX_MUL : forall N:set, N <> Empty -> forall A B :e hl_ty_cart (hl_ty_cart R N) N, forall c :e R, (exists v :e hl_ty_cart R N, ~ v = hl_vec N (hl_NUMERAL hl_zero) /\ hl_matrix_vector_mul N N (hl_matrix_mul N N N A B) v = hl_vmul N c v) <-> exists v :e hl_ty_cart R N, ~ v = hl_vec N (hl_NUMERAL hl_zero) /\ hl_matrix_vector_mul N N (hl_matrix_mul N N N B A) v = hl_vmul N c v.
Admitted.

// HOL Light: Multivariate/topology.ml:19695 / SAME_EIGENVECTORS_MATRIX_INV   (hash md5:a398086d8cb4cacb8b171fe835459b6f)
