Theorem hlt_DENSE_OPEN_INTERS : forall N:set, N <> Empty -> forall g :e 2 :^: (2 :^: hl_ty_cart R N), forall s :e 2 :^: hl_ty_cart R N, hl_FINITE (2 :^: hl_ty_cart R N) g = 1 /\ (forall t :e 2 :^: hl_ty_cart R N, hl_IN (2 :^: hl_ty_cart R N) t g = 1 -> hl_open_in (hl_ty_cart R N) (hl_subtopology (hl_ty_cart R N) (hl_euclidean N) s) t = 1 /\ hl_SUBSET (hl_ty_cart R N) s (hl_closure N t) = 1) -> hl_SUBSET (hl_ty_cart R N) s (hl_closure N (hl_INTERS (hl_ty_cart R N) g)) = 1.
