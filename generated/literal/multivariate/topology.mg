Theorem hlt_CONTINUOUS_TRANSFORM_WITHIN : forall M N:set, M <> Empty -> N <> Empty -> forall f g :e hl_ty_cart R N :^: hl_ty_cart R M, forall s :e 2 :^: hl_ty_cart R M, forall x :e hl_ty_cart R M, forall d :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) d = 1 /\ (hl_IN (hl_ty_cart R M) x s = 1 /\ ((forall x' :e hl_ty_cart R M, hl_IN (hl_ty_cart R M) x' s = 1 /\ hl_real_lt (hl_distance M (hl_pair (hl_ty_cart R M) (hl_ty_cart R M) x' x)) d = 1 -> f x' = g x') /\ hl_continuous (hl_ty_cart R M) N f (hl_within (hl_ty_cart R M) (hl_at M x) s) = 1)) -> hl_continuous (hl_ty_cart R M) N g (hl_within (hl_ty_cart R M) (hl_at M x) s) = 1.
