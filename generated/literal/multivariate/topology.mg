// HOL Light: Multivariate/topology.ml:5324 / SUBSET_BALLS   (hash md5:04a55bf59c9efca59d9d251683a5897e)
Theorem hlt_SUBSET_BALLS : forall N:set, N <> Empty -> (forall a a' :e hl_ty_cart R N, forall r r' :e R, hl_SUBSET (hl_ty_cart R N) (hl_ball N (hl_pair (hl_ty_cart R N) R a r)) (hl_ball N (hl_pair (hl_ty_cart R N) R a' r')) = 1 <-> hl_real_le (hl_real_add (hl_distance N (hl_pair (hl_ty_cart R N) (hl_ty_cart R N) a a')) r) r' = 1 \/ hl_real_le r (hl_real_of_num (hl_NUMERAL hl_zero)) = 1) /\ ((forall a a' :e hl_ty_cart R N, forall r r' :e R, hl_SUBSET (hl_ty_cart R N) (hl_ball N (hl_pair (hl_ty_cart R N) R a r)) (hl_cball N (hl_pair (hl_ty_cart R N) R a' r')) = 1 <-> hl_real_le (hl_real_add (hl_distance N (hl_pair (hl_ty_cart R N) (hl_ty_cart R N) a a')) r) r' = 1 \/ hl_real_le r (hl_real_of_num (hl_NUMERAL hl_zero)) = 1) /\ ((forall a a' :e hl_ty_cart R N, forall r r' :e R, hl_SUBSET (hl_ty_cart R N) (hl_cball N (hl_pair (hl_ty_cart R N) R a r)) (hl_ball N (hl_pair (hl_ty_cart R N) R a' r')) = 1 <-> hl_real_lt (hl_real_add (hl_distance N (hl_pair (hl_ty_cart R N) (hl_ty_cart R N) a a')) r) r' = 1 \/ hl_real_lt r (hl_real_of_num (hl_NUMERAL hl_zero)) = 1) /\ forall a a' :e hl_ty_cart R N, forall r r' :e R, hl_SUBSET (hl_ty_cart R N) (hl_cball N (hl_pair (hl_ty_cart R N) R a r)) (hl_cball N (hl_pair (hl_ty_cart R N) R a' r')) = 1 <-> hl_real_le (hl_real_add (hl_distance N (hl_pair (hl_ty_cart R N) (hl_ty_cart R N) a a')) r) r' = 1 \/ hl_real_lt r (hl_real_of_num (hl_NUMERAL hl_zero)) = 1)).
