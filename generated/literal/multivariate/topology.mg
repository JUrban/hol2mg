// HOL Light: Multivariate/topology.ml:4117 / LIM_WITHIN_ID   (hash md5:943cea3d99722c32b2d09d348b5d1add)
Theorem hlt_LIM_WITHIN_ID : forall A:set, A <> Empty -> forall a :e hl_ty_cart R A, forall s :e 2 :^: hl_ty_cart R A, hl_tendsto (hl_ty_cart R A) A (fun x :e hl_ty_cart R A => x) a (hl_within (hl_ty_cart R A) (hl_at A a) s) = 1.
