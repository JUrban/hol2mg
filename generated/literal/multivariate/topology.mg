Theorem hlt_NORMAL_RIGHT_POLAR_DECOMPOSITION : forall N:set, N <> Empty -> forall A U P :e hl_ty_cart (hl_ty_cart R N) N, hl_orthogonal_matrix N U = 1 /\ (hl_positive_semidefinite N P = 1 /\ hl_matrix_mul N N N U P = A) -> (hl_normal_matrix N A = 1 <-> hl_matrix_mul N N N P U = hl_matrix_mul N N N U P).
Admitted.

// HOL Light: Multivariate/topology.ml:21794 / NORMAL_LEFT_POLAR_DECOMPOSITION   (hash md5:ec4d107462c07325a9185d773fd78893)
Theorem hlt_NORMAL_LEFT_POLAR_DECOMPOSITION : forall N:set, N <> Empty -> forall A U P :e hl_ty_cart (hl_ty_cart R N) N, hl_orthogonal_matrix N U = 1 /\ (hl_positive_semidefinite N P = 1 /\ hl_matrix_mul N N N P U = A) -> (hl_normal_matrix N A = 1 <-> hl_matrix_mul N N N P U = hl_matrix_mul N N N U P).
Admitted.

// HOL Light: Multivariate/topology.ml:21807 / NORMAL_BIPOLAR_DECOMPOSITION   (hash md5:f813c8c29fe62b379bd6867853ef2d0e)
Theorem hlt_NORMAL_BIPOLAR_DECOMPOSITION : forall N:set, N <> Empty -> forall A :e hl_ty_cart (hl_ty_cart R N) N, hl_normal_matrix N A = 1 <-> exists U P :e hl_ty_cart (hl_ty_cart R N) N, hl_orthogonal_matrix N U = 1 /\ (hl_positive_semidefinite N P = 1 /\ (hl_matrix_mul N N N U P = A /\ hl_matrix_mul N N N P U = A)).
Admitted.

// HOL Light: Multivariate/topology.ml:21826 / LEFT_POLAR_DECOMPOSITION_UNIQUE   (hash md5:6be4bcf43484c25bacc8ea626f5fcd89)
Theorem hlt_LEFT_POLAR_DECOMPOSITION_UNIQUE : forall N:set, N <> Empty -> forall A :e hl_ty_cart (hl_ty_cart R N) N, hl_exists_unique (hl_ty_cart (hl_ty_cart R N) N) (fun P :e hl_ty_cart (hl_ty_cart R N) N => if exists U :e hl_ty_cart (hl_ty_cart R N) N, hl_orthogonal_matrix N U = 1 /\ (hl_positive_semidefinite N P = 1 /\ hl_matrix_mul N N N P U = A) then 1 else 0) = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:21851 / RIGHT_POLAR_DECOMPOSITION_UNIQUE   (hash md5:d8a8f870eb47a86bf6bad7a50b567ead)
Theorem hlt_RIGHT_POLAR_DECOMPOSITION_UNIQUE : forall N:set, N <> Empty -> forall A :e hl_ty_cart (hl_ty_cart R N) N, hl_exists_unique (hl_ty_cart (hl_ty_cart R N) N) (fun P :e hl_ty_cart (hl_ty_cart R N) N => if exists U :e hl_ty_cart (hl_ty_cart R N) N, hl_orthogonal_matrix N U = 1 /\ (hl_positive_semidefinite N P = 1 /\ hl_matrix_mul N N N U P = A) then 1 else 0) = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:21876 / LEFT_POLAR_DECOMPOSITION_INVERTIBLE_UNIQUE   (hash md5:ebbbbf82e122eae8bf2c3e8155cf9639)
Theorem hlt_LEFT_POLAR_DECOMPOSITION_INVERTIBLE_UNIQUE : forall N:set, N <> Empty -> forall A U V P S :e hl_ty_cart (hl_ty_cart R N) N, hl_invertible N N A = 1 /\ (hl_orthogonal_matrix N U = 1 /\ (hl_positive_semidefinite N P = 1 /\ (hl_orthogonal_matrix N V = 1 /\ (hl_positive_semidefinite N S = 1 /\ (hl_matrix_mul N N N P U = A /\ hl_matrix_mul N N N S V = A))))) -> P = S /\ U = V.
Admitted.

// HOL Light: Multivariate/topology.ml:21888 / RIGHT_POLAR_DECOMPOSITION_INVERTIBLE_UNIQUE   (hash md5:7e558e9e444498ff670f826b7c0802dc)
Theorem hlt_RIGHT_POLAR_DECOMPOSITION_INVERTIBLE_UNIQUE : forall N:set, N <> Empty -> forall A U V P S :e hl_ty_cart (hl_ty_cart R N) N, hl_invertible N N A = 1 /\ (hl_orthogonal_matrix N U = 1 /\ (hl_positive_semidefinite N P = 1 /\ (hl_orthogonal_matrix N V = 1 /\ (hl_positive_semidefinite N S = 1 /\ (hl_matrix_mul N N N U P = A /\ hl_matrix_mul N N N V S = A))))) -> P = S /\ U = V.
Admitted.

// HOL Light: Multivariate/topology.ml:21900 / COVARIANCE_UNIQUE_UP_TO_ORTHOGONAL   (hash md5:6b251eb3723f996328ebe8b3433ffebb)
Theorem hlt_COVARIANCE_UNIQUE_UP_TO_ORTHOGONAL : forall N:set, N <> Empty -> forall A B :e hl_ty_cart (hl_ty_cart R N) N, hl_matrix_mul N N N (hl_transp N N A) A = hl_matrix_mul N N N (hl_transp N N B) B <-> exists U :e hl_ty_cart (hl_ty_cart R N) N, hl_orthogonal_matrix N U = 1 /\ hl_matrix_mul N N N U A = B.
Admitted.

// HOL Light: Multivariate/topology.ml:21929 / COVARIANCE_UNIQUE_UP_TO_ORTHOGONAL_ALT   (hash md5:6a0903c4e3318c43d1524d4e9ef703e7)
Theorem hlt_COVARIANCE_UNIQUE_UP_TO_ORTHOGONAL_ALT : forall N:set, N <> Empty -> forall A B :e hl_ty_cart (hl_ty_cart R N) N, hl_matrix_mul N N N A (hl_transp N N A) = hl_matrix_mul N N N B (hl_transp N N B) <-> exists U :e hl_ty_cart (hl_ty_cart R N) N, hl_orthogonal_matrix N U = 1 /\ hl_matrix_mul N N N A U = B.
Admitted.

// HOL Light: Multivariate/topology.ml:21942 / NORMAL_MATRIX_SIMILAR_TRANSP   (hash md5:74c223dd6bed2924418f87523a2867af)
Theorem hlt_NORMAL_MATRIX_SIMILAR_TRANSP : forall N:set, N <> Empty -> forall A :e hl_ty_cart (hl_ty_cart R N) N, hl_normal_matrix N A = 1 <-> exists U :e hl_ty_cart (hl_ty_cart R N) N, hl_orthogonal_matrix N U = 1 /\ hl_matrix_mul N N N U (hl_transp N N A) = A.
Admitted.

// HOL Light: Multivariate/topology.ml:21949 / NORMAL_MATRIX_SIMILAR_TRANSP_ALT   (hash md5:d35f5409c420d0783d78f0f68726757e)
Theorem hlt_NORMAL_MATRIX_SIMILAR_TRANSP_ALT : forall N:set, N <> Empty -> forall A :e hl_ty_cart (hl_ty_cart R N) N, hl_normal_matrix N A = 1 <-> exists U :e hl_ty_cart (hl_ty_cart R N) N, hl_orthogonal_matrix N U = 1 /\ hl_matrix_mul N N N (hl_transp N N A) U = A.
Admitted.

// HOL Light: Multivariate/topology.ml:21958 / MATRIX_DIAGONALIZABLE   (hash md5:d7ef6fd6276546a0b429c221523d82f0)
Theorem hlt_MATRIX_DIAGONALIZABLE : forall N:set, N <> Empty -> forall A :e hl_ty_cart (hl_ty_cart R N) N, exists P D Q :e hl_ty_cart (hl_ty_cart R N) N, hl_orthogonal_matrix N P = 1 /\ (hl_diagonal_matrix N N D = 1 /\ (hl_orthogonal_matrix N Q = 1 /\ ((forall i :e omega, hl_le (hl_NUMERAL (hl_BIT1 hl_zero)) i = 1 /\ hl_le i (hl_dimindex N (hl_UNIV N)) = 1 -> hl_real_le (hl_real_of_num (hl_NUMERAL hl_zero)) (hl_vindex R N (hl_vindex (hl_ty_cart R N) N D i) i) = 1) /\ A = hl_matrix_mul N N N P (hl_matrix_mul N N N D Q)))).
Admitted.

// HOL Light: Multivariate/topology.ml:21988 / sums   (hash md5:169f9acc2b70016a02351c7bb5e38a47)
Theorem hlt_sums_thm : forall A:set, A <> Empty -> forall s :e 2 :^: omega, forall f :e hl_ty_cart R A :^: omega, forall l :e hl_ty_cart R A, hl_sums A f l s = 1 <-> hl_tendsto omega A (fun n :e omega => hl_vsum omega A (hl_INTER omega s (hl_numseg (hl_NUMERAL hl_zero) n)) f) l hl_sequentially = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:21991 / infsum   (hash md5:481363c2c3b164321fd50111d2a47a2c)
Theorem hlt_infsum_thm : forall A:set, A <> Empty -> forall f :e hl_ty_cart R A :^: omega, forall s :e 2 :^: omega, hl_infsum A s f = hl_select (hl_ty_cart R A) (fun l :e hl_ty_cart R A => hl_sums A f l s).
Admitted.

// HOL Light: Multivariate/topology.ml:21994 / summable   (hash md5:7da270343d61874344208e05046dfc7e)
Theorem hlt_summable_thm : forall A:set, A <> Empty -> forall f :e hl_ty_cart R A :^: omega, forall s :e 2 :^: omega, hl_summable A s f = 1 <-> exists l :e hl_ty_cart R A, hl_sums A f l s = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:21997 / SUMS_SUMMABLE   (hash md5:29c04c42ca37ec78355e9f61ec23eabb)
Theorem hlt_SUMS_SUMMABLE : forall A:set, A <> Empty -> forall f :e hl_ty_cart R A :^: omega, forall l :e hl_ty_cart R A, forall s :e 2 :^: omega, hl_sums A f l s = 1 -> hl_summable A s f = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:22001 / SUMS_INFSUM   (hash md5:5ec546bbd8789705629e95614b4b9cd6)
Theorem hlt_SUMS_INFSUM : forall A:set, A <> Empty -> forall f :e hl_ty_cart R A :^: omega, forall s :e 2 :^: omega, hl_sums A f (hl_infsum A s f) s = 1 <-> hl_summable A s f = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:22005 / SUMS_LIM   (hash md5:ed1ddc5ea159fb64d23a0d4694e70568)
Theorem hlt_SUMS_LIM : forall N:set, N <> Empty -> forall f :e hl_ty_cart R N :^: omega, forall s :e 2 :^: omega, hl_sums N f (hl_lim omega N hl_sequentially (fun n :e omega => hl_vsum omega N (hl_INTER omega s (hl_numseg (hl_NUMERAL hl_zero) n)) f)) s = 1 <-> hl_summable N s f = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:22013 / SERIES_FROM   (hash md5:759588b02dea7396f884cd69f1742b9f)
Theorem hlt_SERIES_FROM : forall A:set, A <> Empty -> forall f :e hl_ty_cart R A :^: omega, forall l :e hl_ty_cart R A, forall k :e omega, hl_sums A f l (hl_from k) = 1 <-> hl_tendsto omega A (fun n :e omega => hl_vsum omega A (hl_numseg k n) f) l hl_sequentially = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:22020 / SERIES_UNIQUE   (hash md5:979b04acbf7be2cfbf93ea1a8618f66d)
Theorem hlt_SERIES_UNIQUE : forall N:set, N <> Empty -> forall f :e hl_ty_cart R N :^: omega, forall l l' :e hl_ty_cart R N, forall s :e 2 :^: omega, hl_sums N f l s = 1 /\ hl_sums N f l' s = 1 -> l = l'.
Admitted.

// HOL Light: Multivariate/topology.ml:22024 / INFSUM_UNIQUE   (hash md5:a83732097a200ee893f31f4623d9c6d1)
Theorem hlt_INFSUM_UNIQUE : forall N:set, N <> Empty -> forall f :e hl_ty_cart R N :^: omega, forall l :e hl_ty_cart R N, forall s :e 2 :^: omega, hl_sums N f l s = 1 -> hl_infsum N s f = l.
Admitted.

// HOL Light: Multivariate/topology.ml:22028 / SERIES_TERMS_TOZERO   (hash md5:80e54530d7ba02d76212e35eba269d39)
Theorem hlt_SERIES_TERMS_TOZERO : forall A:set, A <> Empty -> forall f :e hl_ty_cart R A :^: omega, forall l :e hl_ty_cart R A, forall n :e omega, hl_sums A f l (hl_from n) = 1 -> hl_tendsto omega A f (hl_vec A (hl_NUMERAL hl_zero)) hl_sequentially = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:22042 / SERIES_FINITE   (hash md5:afd2ce99f4d0c6ad53ba553ed062dc42)
Theorem hlt_SERIES_FINITE : forall A:set, A <> Empty -> forall f :e hl_ty_cart R A :^: omega, forall s :e 2 :^: omega, hl_FINITE omega s = 1 -> hl_sums A f (hl_vsum omega A s f) s = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:22053 / SERIES_FINITE_EQ   (hash md5:efec8eb96cbd9a33f6ad640edc298f00)
Theorem hlt_SERIES_FINITE_EQ : forall N:set, N <> Empty -> forall f :e hl_ty_cart R N :^: omega, forall s :e 2 :^: omega, forall y :e hl_ty_cart R N, hl_FINITE omega s = 1 -> (hl_sums N f y s = 1 <-> hl_vsum omega N s f = y).
Admitted.

// HOL Light: Multivariate/topology.ml:22058 / SERIES_LINEAR   (hash md5:16b60fa343760e83eeddb9ebd3e41519)
Theorem hlt_SERIES_LINEAR : forall A B:set, A <> Empty -> B <> Empty -> forall f :e hl_ty_cart R A :^: omega, forall h :e hl_ty_cart R B :^: hl_ty_cart R A, forall l :e hl_ty_cart R A, forall s :e 2 :^: omega, hl_sums A f l s = 1 /\ hl_linear A B h = 1 -> hl_sums B (fun n :e omega => h (f n)) (h l) s = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:22063 / SERIES_0   (hash md5:0ccfb806f4ed481d8e87dac5345b1ce5)
Theorem hlt_SERIES_0 : forall A:set, A <> Empty -> forall s :e 2 :^: omega, hl_sums A (fun n :e omega => hl_vec A (hl_NUMERAL hl_zero)) (hl_vec A (hl_NUMERAL hl_zero)) s = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:22067 / SERIES_ADD   (hash md5:af248999cbe56ec6d8d331cf4c0fc28d)
Theorem hlt_SERIES_ADD : forall A:set, A <> Empty -> forall x :e hl_ty_cart R A :^: omega, forall x0 :e hl_ty_cart R A, forall y :e hl_ty_cart R A :^: omega, forall y0 :e hl_ty_cart R A, forall s :e 2 :^: omega, hl_sums A x x0 s = 1 /\ hl_sums A y y0 s = 1 -> hl_sums A (fun n :e omega => hl_vector_add A (x n) (y n)) (hl_vector_add A x0 y0) s = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:22072 / SERIES_SUB   (hash md5:883524132213d22bd73da7daeda902eb)
Theorem hlt_SERIES_SUB : forall A:set, A <> Empty -> forall x :e hl_ty_cart R A :^: omega, forall x0 :e hl_ty_cart R A, forall y :e hl_ty_cart R A :^: omega, forall y0 :e hl_ty_cart R A, forall s :e 2 :^: omega, hl_sums A x x0 s = 1 /\ hl_sums A y y0 s = 1 -> hl_sums A (fun n :e omega => hl_vector_sub A (x n) (y n)) (hl_vector_sub A x0 y0) s = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:22077 / SERIES_CMUL   (hash md5:ea5becb762fd85621d22a3abbd8ae0e2)
Theorem hlt_SERIES_CMUL : forall A:set, A <> Empty -> forall x :e hl_ty_cart R A :^: omega, forall x0 :e hl_ty_cart R A, forall c :e R, forall s :e 2 :^: omega, hl_sums A x x0 s = 1 -> hl_sums A (fun n :e omega => hl_vmul A c (x n)) (hl_vmul A c x0) s = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:22081 / SERIES_NEG   (hash md5:f5e76c095c59af43a39732b50772390d)
Theorem hlt_SERIES_NEG : forall A:set, A <> Empty -> forall x :e hl_ty_cart R A :^: omega, forall x0 :e hl_ty_cart R A, forall s :e 2 :^: omega, hl_sums A x x0 s = 1 -> hl_sums A (fun n :e omega => hl_vector_neg A (x n)) (hl_vector_neg A x0) s = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:22085 / SUMS_IFF   (hash md5:9eda49ea69ed368e29d1de1f195e7686)
Theorem hlt_SUMS_IFF : forall A:set, A <> Empty -> forall l :e hl_ty_cart R A, forall f g :e hl_ty_cart R A :^: omega, forall k :e 2 :^: omega, (forall x :e omega, hl_IN omega x k = 1 -> f x = g x) -> (hl_sums A f l k = 1 <-> hl_sums A g l k = 1).
Admitted.

// HOL Light: Multivariate/topology.ml:22091 / SUMS_EQ   (hash md5:9e7741b262f97243a69b078674c53b02)
Theorem hlt_SUMS_EQ : forall A:set, A <> Empty -> forall l :e hl_ty_cart R A, forall f g :e hl_ty_cart R A :^: omega, forall k :e 2 :^: omega, (forall x :e omega, hl_IN omega x k = 1 -> f x = g x) /\ hl_sums A f l k = 1 -> hl_sums A g l k = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:22095 / SUMS_0   (hash md5:dc2877267e210ec8f2c5610ae3c67c1f)
Theorem hlt_SUMS_0 : forall N:set, N <> Empty -> forall f :e hl_ty_cart R N :^: omega, forall s :e 2 :^: omega, (forall n :e omega, hl_IN omega n s = 1 -> f n = hl_vec N (hl_NUMERAL hl_zero)) -> hl_sums N f (hl_vec N (hl_NUMERAL hl_zero)) s = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:22100 / SERIES_FINITE_SUPPORT   (hash md5:9b93f01302438c2b7a98bc97661b7fc9)
Theorem hlt_SERIES_FINITE_SUPPORT : forall N:set, N <> Empty -> forall f :e hl_ty_cart R N :^: omega, forall s k :e 2 :^: omega, hl_FINITE omega (hl_INTER omega s k) = 1 /\ (forall x :e omega, hl_IN omega x k = 1 /\ ~ hl_IN omega x s = 1 -> f x = hl_vec N (hl_NUMERAL hl_zero)) -> hl_sums N f (hl_vsum omega N (hl_INTER omega s k) f) k = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:22114 / SERIES_COMPONENT   (hash md5:bdf98a4cbb44257cc9ae1440056ce72c)
Theorem hlt_SERIES_COMPONENT : forall N:set, N <> Empty -> forall f :e hl_ty_cart R N :^: omega, forall s :e 2 :^: omega, forall l :e hl_ty_cart R N, forall k :e omega, hl_sums N f l s = 1 /\ (hl_le (hl_NUMERAL (hl_BIT1 hl_zero)) k = 1 /\ hl_le k (hl_dimindex N (hl_UNIV N)) = 1) -> hl_sums 1 (fun i :e omega => hl_lift (hl_vindex R N (f i) k)) (hl_lift (hl_vindex R N l k)) s = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:22123 / SERIES_DIFFS   (hash md5:2b6d10db39bae0a2688c0f3ed190f505)
Theorem hlt_SERIES_DIFFS : forall N:set, N <> Empty -> forall f :e hl_ty_cart R N :^: omega, forall k :e omega, hl_tendsto omega N f (hl_vec N (hl_NUMERAL hl_zero)) hl_sequentially = 1 -> hl_sums N (fun n :e omega => hl_vector_sub N (f n) (f (hl_add n (hl_NUMERAL (hl_BIT1 hl_zero))))) (f k) (hl_from k) = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:22136 / SERIES_TRIVIAL   (hash md5:61bc1b02ef46a32583ea465b2a8c083d)
Theorem hlt_SERIES_TRIVIAL : forall A:set, A <> Empty -> forall f :e hl_ty_cart R A :^: omega, hl_sums A f (hl_vec A (hl_NUMERAL hl_zero)) (hl_EMPTY omega) = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:22140 / SERIES_RESTRICT   (hash md5:27f8c11968e4b043d5a37e903d831b22)
Theorem hlt_SERIES_RESTRICT : forall N:set, N <> Empty -> forall f :e hl_ty_cart R N :^: omega, forall k :e 2 :^: omega, forall l :e hl_ty_cart R N, hl_sums N (fun n :e omega => hl_COND (hl_ty_cart R N) (hl_IN omega n k) (f n) (hl_vec N (hl_NUMERAL hl_zero))) l (hl_UNIV omega) = 1 <-> hl_sums N f l k = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:22153 / SERIES_VSUM   (hash md5:e0e6c80871bb94b8f480e1ec2b3fb1a0)
Theorem hlt_SERIES_VSUM : forall A:set, A <> Empty -> forall f :e hl_ty_cart R A :^: omega, forall l :e hl_ty_cart R A, forall k s :e 2 :^: omega, hl_FINITE omega s = 1 /\ (hl_SUBSET omega s k = 1 /\ ((forall x :e omega, ~ hl_IN omega x s = 1 -> f x = hl_vec A (hl_NUMERAL hl_zero)) /\ hl_vsum omega A s f = l)) -> hl_sums A f l k = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:22160 / SUMS_REINDEX   (hash md5:68cd940820215b78281238dc98dab1a5)
Theorem hlt_SUMS_REINDEX : forall N:set, N <> Empty -> forall k :e omega, forall a :e hl_ty_cart R N :^: omega, forall l :e hl_ty_cart R N, forall n :e omega, hl_sums N (fun x :e omega => a (hl_add x k)) l (hl_from n) = 1 <-> hl_sums N a l (hl_from (hl_add n k)) = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:22169 / SUMS_REINDEX_GEN   (hash md5:5ce912ac9dad1edeb7cf7c1009e98845)
Theorem hlt_SUMS_REINDEX_GEN : forall N:set, N <> Empty -> forall k :e omega, forall a :e hl_ty_cart R N :^: omega, forall l :e hl_ty_cart R N, forall s :e 2 :^: omega, hl_sums N (fun x :e omega => a (hl_add x k)) l s = 1 <-> hl_sums N a l (hl_IMAGE omega omega (fun i :e omega => hl_add i k) s) = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:22188 / SERIES_EVEN   (hash md5:6cdb826c8d45abc12f063ea03d75328b)
Theorem hlt_SERIES_EVEN : forall N:set, N <> Empty -> forall f :e hl_ty_cart R N :^: omega, forall l :e hl_ty_cart R N, forall n :e omega, hl_sums N f l (hl_from n) = 1 <-> hl_sums N (fun i :e omega => hl_COND (hl_ty_cart R N) (hl_EVEN i) (f (hl_DIV i (hl_NUMERAL (hl_BIT0 (hl_BIT1 hl_zero))))) (hl_vec N (hl_NUMERAL hl_zero))) l (hl_from (hl_mul (hl_NUMERAL (hl_BIT0 (hl_BIT1 hl_zero))) n)) = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:22223 / SERIES_ODD   (hash md5:98602f503eaca6c7b7fd73dcf6da606d)
Theorem hlt_SERIES_ODD : forall N:set, N <> Empty -> forall f :e hl_ty_cart R N :^: omega, forall l :e hl_ty_cart R N, forall n :e omega, hl_sums N f l (hl_from n) = 1 <-> hl_sums N (fun i :e omega => hl_COND (hl_ty_cart R N) (hl_ODD i) (f (hl_DIV i (hl_NUMERAL (hl_BIT0 (hl_BIT1 hl_zero))))) (hl_vec N (hl_NUMERAL hl_zero))) l (hl_from (hl_add (hl_mul (hl_NUMERAL (hl_BIT0 (hl_BIT1 hl_zero))) n) (hl_NUMERAL (hl_BIT1 hl_zero)))) = 1.
Admitted.

