Theorem hlt_CANTOR_BAIRE_STATIONARY_PRINCIPLE : forall A N:set, A <> Empty -> N <> Empty -> forall f :e 2 :^: hl_ty_cart R N :^: A, forall v :e 2 :^: hl_ty_cart R N, forall w :e 2 :^: A :^: A, hl_woset A w = 1 /\ (~ hl_COUNTABLE (A :*: A) (hl_GSPEC (A :*: A) (fun GEN_PVAR_4026 :e A :*: A => if exists x y :e A, hl_SETSPEC (A :*: A) GEN_PVAR_4026 (w x y) (hl_pair A A x y) = 1 then 1 else 0)) = 1 /\ ((forall v1 :e 2 :^: A :^: A, hl_inseg A v1 w = 1 /\ ~ v1 = w -> hl_COUNTABLE (A :*: A) (hl_GSPEC (A :*: A) (fun GEN_PVAR_4027 :e A :*: A => if exists x y :e A, hl_SETSPEC (A :*: A) GEN_PVAR_4027 (v1 x y) (hl_pair A A x y) = 1 then 1 else 0)) = 1) /\ ((forall i :e A, hl_IN A i (hl_fld A w) = 1 -> hl_closed_in (hl_ty_cart R N) (hl_subtopology (hl_ty_cart R N) (hl_euclidean N) v) (f i) = 1 \/ hl_open_in (hl_ty_cart R N) (hl_subtopology (hl_ty_cart R N) (hl_euclidean N) v) (f i) = 1) /\ (forall i j :e A, w i j = 1 -> hl_SUBSET (hl_ty_cart R N) (f j) (f i) = 1)))) -> exists k :e A, hl_IN A k (hl_fld A w) = 1 /\ forall i :e A, w k i = 1 -> f i = f k.
Admitted.

