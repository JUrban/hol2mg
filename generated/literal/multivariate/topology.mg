Theorem hlt_LIM_NULL_COMPARISON : forall A B:set, A <> Empty -> B <> Empty -> forall net1 :e hl_ty_net A, forall f :e hl_ty_cart R B :^: A, forall g :e R :^: A, hl_eventually A (fun x :e A => hl_real_le (hl_vector_norm B (f x)) (g x)) net1 = 1 /\ hl_tendsto A 1 (fun x :e A => hl_lift (g x)) (hl_vec 1 (hl_NUMERAL hl_zero)) net1 = 1 -> hl_tendsto A B f (hl_vec B (hl_NUMERAL hl_zero)) net1 = 1.
