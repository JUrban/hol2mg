Theorem hlt_LIM_UNION : forall A B:set, A <> Empty -> B <> Empty -> forall f :e hl_ty_cart R A :^: hl_ty_cart R B, forall x :e hl_ty_cart R B, forall l :e hl_ty_cart R A, forall s t :e 2 :^: hl_ty_cart R B, hl_tendsto (hl_ty_cart R B) A f l (hl_within (hl_ty_cart R B) (hl_at B x) s) = 1 /\ hl_tendsto (hl_ty_cart R B) A f l (hl_within (hl_ty_cart R B) (hl_at B x) t) = 1 -> hl_tendsto (hl_ty_cart R B) A f l (hl_within (hl_ty_cart R B) (hl_at B x) (hl_UNION (hl_ty_cart R B) s t)) = 1.
