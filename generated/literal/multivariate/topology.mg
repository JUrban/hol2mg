// HOL Light: Multivariate/topology.ml:4290 / LIM_TRANSFORM   (hash md5:b79a8b3116f721456f64908839246aba)
Theorem hlt_LIM_TRANSFORM : forall A B:set, A <> Empty -> B <> Empty -> forall net1 :e hl_ty_net A, forall f g :e hl_ty_cart R B :^: A, forall l :e hl_ty_cart R B, hl_tendsto A B (fun x :e A => hl_vector_sub B (f x) (g x)) (hl_vec B (hl_NUMERAL hl_zero)) net1 = 1 /\ hl_tendsto A B f l net1 = 1 -> hl_tendsto A B g l net1 = 1.
