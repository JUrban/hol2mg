// HOL Light: Multivariate/topology.ml:4363 / LIM_TRANSFORM_AWAY_WITHIN   (hash md5:886d469854460aaf9dd3c5cb05022045)
Theorem hlt_LIM_TRANSFORM_AWAY_WITHIN : forall M N:set, M <> Empty -> N <> Empty -> forall l :e hl_ty_cart R N, forall f g :e hl_ty_cart R N :^: hl_ty_cart R M, forall a b :e hl_ty_cart R M, forall s :e 2 :^: hl_ty_cart R M, ~ a = b /\ ((forall x :e hl_ty_cart R M, hl_IN (hl_ty_cart R M) x s = 1 /\ (~ x = a /\ ~ x = b) -> f x = g x) /\ hl_tendsto (hl_ty_cart R M) N f l (hl_within (hl_ty_cart R M) (hl_at M a) s) = 1) -> hl_tendsto (hl_ty_cart R M) N g l (hl_within (hl_ty_cart R M) (hl_at M a) s) = 1.
