// HOL Light: Multivariate/topology.ml:3604 / LIM_WITHIN_OPEN   (hash md5:46df21a1e77adea9d1e1c27581f0eb01)
Theorem hlt_LIM_WITHIN_OPEN : forall A M:set, A <> Empty -> M <> Empty -> forall f :e hl_ty_cart R A :^: hl_ty_cart R M, forall l :e hl_ty_cart R A, forall a :e hl_ty_cart R M, forall s :e 2 :^: hl_ty_cart R M, hl_IN (hl_ty_cart R M) a s = 1 /\ hl_open M s = 1 -> (hl_tendsto (hl_ty_cart R M) A f l (hl_within (hl_ty_cart R M) (hl_at M a) s) = 1 <-> hl_tendsto (hl_ty_cart R M) A f l (hl_at M a) = 1).
