Theorem hlt_FRONTIER_SUBSET_CLOSED : forall A:set, A <> Empty -> forall s :e 2 :^: hl_ty_cart R A, hl_closed A s = 1 -> hl_SUBSET (hl_ty_cart R A) (hl_frontier A s) s = 1.
