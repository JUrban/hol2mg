// HOL Light: Multivariate/topology.ml:20057 / SELF_ADJOINT_HAS_EIGENVECTOR_BASIS_OF_SUBSPACE   (hash md5:f4d70f97251b3aa24b0635f97164c493)
Theorem hlt_SELF_ADJOINT_HAS_EIGENVECTOR_BASIS_OF_SUBSPACE : forall N:set, N <> Empty -> forall f :e hl_ty_cart R N :^: hl_ty_cart R N, forall s :e 2 :^: hl_ty_cart R N, hl_linear N N f = 1 /\ (hl_adjoint N N f = f /\ (hl_subspace N s = 1 /\ (forall x :e hl_ty_cart R N, hl_IN (hl_ty_cart R N) x s = 1 -> hl_IN (hl_ty_cart R N) (f x) s = 1))) -> exists b :e 2 :^: hl_ty_cart R N, hl_SUBSET (hl_ty_cart R N) b s = 1 /\ (hl_pairwise (hl_ty_cart R N) (hl_orthogonal N) b = 1 /\ ((forall x :e hl_ty_cart R N, hl_IN (hl_ty_cart R N) x b = 1 -> hl_vector_norm N x = hl_real_of_num (hl_NUMERAL (hl_BIT1 hl_zero)) /\ exists c :e R, f x = hl_vmul N c x) /\ (hl_independent N b = 1 /\ (hl_span N b = s /\ hl_HAS_SIZE (hl_ty_cart R N) b (hl_dim N s) = 1)))).
