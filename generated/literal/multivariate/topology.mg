Theorem hlt_CONNECTED_COMPONENT_UNIONS : forall A:set, A <> Empty -> forall s :e 2 :^: hl_ty_cart R A, forall x :e hl_ty_cart R A, hl_connected_component A s x = hl_UNIONS (hl_ty_cart R A) (hl_GSPEC (2 :^: hl_ty_cart R A) (fun GEN_PVAR_3466 :e 2 :^: hl_ty_cart R A => if exists t :e 2 :^: hl_ty_cart R A, hl_SETSPEC (2 :^: hl_ty_cart R A) GEN_PVAR_3466 (if hl_connected A t = 1 /\ (hl_IN (hl_ty_cart R A) x t = 1 /\ hl_SUBSET (hl_ty_cart R A) t s = 1) then 1 else 0) t = 1 then 1 else 0)).
