Theorem hlt_UNIFORMLY_CONTINUOUS_MAP_EQ_DROP : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall f :e hl_ty_cart R 1 :^: A, hl_uniformly_continuous_map A (hl_ty_cart R 1) (hl_pair (hl_ty_metric A) (hl_ty_metric (hl_ty_cart R 1)) m (hl_euclidean_metric 1)) f = 1 <-> hl_uniformly_continuous_map A R (hl_pair (hl_ty_metric A) (hl_ty_metric R) m hl_real_euclidean_metric) (hl_o (hl_ty_cart R 1) R A hl_drop f) = 1.
