// HOL Light: Multivariate/topology.ml:3949 / LIM_COMPONENT   (hash md5:c43a9a3ce163adde997e39550f61ef4d)
Theorem hlt_LIM_COMPONENT : forall A N:set, A <> Empty -> N <> Empty -> forall net1 :e hl_ty_net A, forall f :e hl_ty_cart R N :^: A, forall i :e omega, forall l :e hl_ty_cart R N, hl_tendsto A N f l net1 = 1 -> hl_tendsto A 1 (fun a :e A => hl_lift (hl_vindex R N (f a) i)) (hl_lift (hl_vindex R N l i)) net1 = 1.
