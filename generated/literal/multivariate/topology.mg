Theorem hlt_BANACH_FIX : forall N:set, N <> Empty -> forall f :e hl_ty_cart R N :^: hl_ty_cart R N, forall s :e 2 :^: hl_ty_cart R N, forall c :e R, hl_complete N s = 1 /\ (~ s = hl_EMPTY (hl_ty_cart R N) /\ (hl_real_le (hl_real_of_num (hl_NUMERAL hl_zero)) c = 1 /\ (hl_real_lt c (hl_real_of_num (hl_NUMERAL (hl_BIT1 hl_zero))) = 1 /\ (hl_SUBSET (hl_ty_cart R N) (hl_IMAGE (hl_ty_cart R N) (hl_ty_cart R N) f s) s = 1 /\ (forall x y :e hl_ty_cart R N, hl_IN (hl_ty_cart R N) x s = 1 /\ hl_IN (hl_ty_cart R N) y s = 1 -> hl_real_le (hl_distance N (hl_pair (hl_ty_cart R N) (hl_ty_cart R N) (f x) (f y))) (hl_real_mul c (hl_distance N (hl_pair (hl_ty_cart R N) (hl_ty_cart R N) x y))) = 1))))) -> hl_exists_unique (hl_ty_cart R N) (fun x :e hl_ty_cart R N => if hl_IN (hl_ty_cart R N) x s = 1 /\ f x = x then 1 else 0) = 1.
