// HOL Light: Multivariate/topology.ml:6964 / LIM_WITHIN_SEQUENTIALLY_DECREASING   (hash md5:fa46dd320e71b04479dfe9a1bce393ec)
Theorem hlt_LIM_WITHIN_SEQUENTIALLY_DECREASING : forall M N:set, M <> Empty -> N <> Empty -> forall f :e hl_ty_cart R N :^: hl_ty_cart R M, forall s :e 2 :^: hl_ty_cart R M, forall a :e hl_ty_cart R M, forall l :e hl_ty_cart R N, hl_tendsto (hl_ty_cart R M) N f l (hl_within (hl_ty_cart R M) (hl_at M a) s) = 1 <-> forall x :e hl_ty_cart R M :^: omega, (forall n :e omega, hl_IN (hl_ty_cart R M) (x n) (hl_DELETE (hl_ty_cart R M) s a) = 1) /\ ((forall m n :e omega, hl_lt m n = 1 -> hl_real_lt (hl_distance M (hl_pair (hl_ty_cart R M) (hl_ty_cart R M) (x n) a)) (hl_distance M (hl_pair (hl_ty_cart R M) (hl_ty_cart R M) (x m) a)) = 1) /\ hl_tendsto omega M x a hl_sequentially = 1) -> hl_tendsto omega N (hl_o (hl_ty_cart R M) (hl_ty_cart R N) omega f x) l hl_sequentially = 1.
