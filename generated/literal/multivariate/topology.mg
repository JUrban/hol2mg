// HOL Light: Multivariate/topology.ml:2595 / FRONTIER_STRADDLE   (hash md5:a31a4d5509267f81bc90e8597d66cf84)
Theorem hlt_FRONTIER_STRADDLE : forall N:set, N <> Empty -> forall a :e hl_ty_cart R N, forall s :e 2 :^: hl_ty_cart R N, hl_IN (hl_ty_cart R N) a (hl_frontier N s) = 1 <-> forall e1 :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) e1 = 1 -> (exists x :e hl_ty_cart R N, hl_IN (hl_ty_cart R N) x s = 1 /\ hl_real_lt (hl_distance N (hl_pair (hl_ty_cart R N) (hl_ty_cart R N) a x)) e1 = 1) /\ exists x :e hl_ty_cart R N, ~ hl_IN (hl_ty_cart R N) x s = 1 /\ hl_real_lt (hl_distance N (hl_pair (hl_ty_cart R N) (hl_ty_cart R N) a x)) e1 = 1.
