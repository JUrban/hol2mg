// HOL Light: Multivariate/topology.ml:4182 / UNIFORM_LIM_BILINEAR   (hash md5:38aecedbe790a4aaefa830c27276e079)
Theorem hlt_UNIFORM_LIM_BILINEAR : forall A B M N P:set, A <> Empty -> B <> Empty -> M <> Empty -> N <> Empty -> P <> Empty -> forall net1 :e hl_ty_net A, forall P1 :e 2 :^: B, forall h :e hl_ty_cart R P :^: hl_ty_cart R N :^: hl_ty_cart R M, forall f :e hl_ty_cart R M :^: A :^: B, forall g :e hl_ty_cart R N :^: A :^: B, forall l :e hl_ty_cart R M :^: B, forall m :e hl_ty_cart R N :^: B, forall b1 b2 :e R, hl_bilinear M N P h = 1 /\ (hl_eventually A (fun x :e A => if forall n :e B, P1 n = 1 -> hl_real_le (hl_vector_norm M (l n)) b1 = 1 then 1 else 0) net1 = 1 /\ (hl_eventually A (fun x :e A => if forall n :e B, P1 n = 1 -> hl_real_le (hl_vector_norm N (m n)) b2 = 1 then 1 else 0) net1 = 1 /\ ((forall e1 :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) e1 = 1 -> hl_eventually A (fun x :e A => if forall n :e B, P1 n = 1 -> hl_real_lt (hl_vector_norm M (hl_vector_sub M (f n x) (l n))) e1 = 1 then 1 else 0) net1 = 1) /\ (forall e1 :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) e1 = 1 -> hl_eventually A (fun x :e A => if forall n :e B, P1 n = 1 -> hl_real_lt (hl_vector_norm N (hl_vector_sub N (g n x) (m n))) e1 = 1 then 1 else 0) net1 = 1)))) -> forall e1 :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) e1 = 1 -> hl_eventually A (fun x :e A => if forall n :e B, P1 n = 1 -> hl_real_lt (hl_vector_norm P (hl_vector_sub P (h (f n x) (g n x)) (h (l n) (m n)))) e1 = 1 then 1 else 0) net1 = 1.
