Theorem hlt_CONTINUOUS_WITHIN_OPEN_IN : forall M N:set, M <> Empty -> N <> Empty -> forall f :e hl_ty_cart R N :^: hl_ty_cart R M, forall a :e hl_ty_cart R M, forall s t :e 2 :^: hl_ty_cart R M, hl_IN (hl_ty_cart R M) a t = 1 /\ hl_open_in (hl_ty_cart R M) (hl_subtopology (hl_ty_cart R M) (hl_euclidean M) s) t = 1 -> (hl_continuous (hl_ty_cart R M) N f (hl_within (hl_ty_cart R M) (hl_at M a) t) = 1 <-> hl_continuous (hl_ty_cart R M) N f (hl_within (hl_ty_cart R M) (hl_at M a) s) = 1).
