Theorem hlt_homeomorphism_thm : forall A B:set, A <> Empty -> B <> Empty -> forall f :e hl_ty_cart R B :^: hl_ty_cart R A, forall s :e 2 :^: hl_ty_cart R A, forall g :e hl_ty_cart R A :^: hl_ty_cart R B, forall t :e 2 :^: hl_ty_cart R B, hl_homeomorphism A B (hl_pair (2 :^: hl_ty_cart R A) (2 :^: hl_ty_cart R B) s t) (hl_pair (hl_ty_cart R B :^: hl_ty_cart R A) (hl_ty_cart R A :^: hl_ty_cart R B) f g) = 1 <-> (forall x :e hl_ty_cart R A, hl_IN (hl_ty_cart R A) x s = 1 -> g (f x) = x) /\ (hl_IMAGE (hl_ty_cart R A) (hl_ty_cart R B) f s = t /\ (hl_continuous_on A B f s = 1 /\ ((forall y :e hl_ty_cart R B, hl_IN (hl_ty_cart R B) y t = 1 -> f (g y) = y) /\ (hl_IMAGE (hl_ty_cart R B) (hl_ty_cart R A) g t = s /\ hl_continuous_on B A g t = 1)))).
