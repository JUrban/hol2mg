Theorem hlt_compact_thm : forall N:set, N <> Empty -> forall s :e 2 :^: hl_ty_cart R N, hl_compact N s = 1 <-> forall f :e hl_ty_cart R N :^: omega, (forall n :e omega, hl_IN (hl_ty_cart R N) (f n) s = 1) -> exists l :e hl_ty_cart R N, exists r :e omega :^: omega, hl_IN (hl_ty_cart R N) l s = 1 /\ ((forall m n :e omega, hl_lt m n = 1 -> hl_lt (r m) (r n) = 1) /\ hl_tendsto omega N (hl_o omega (hl_ty_cart R N) omega f r) l hl_sequentially = 1).
