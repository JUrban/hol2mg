// HOL Light: Multivariate/topology.ml:23520 / SERIES_BILINEAR   (hash md5:5b8c0c578b64e271a1d84ecf7234c45d)
Theorem hlt_SERIES_BILINEAR : forall M N P:set, M <> Empty -> N <> Empty -> P <> Empty -> forall bop :e hl_ty_cart R P :^: hl_ty_cart R N :^: hl_ty_cart R M, forall x :e hl_ty_cart R M :^: omega, forall y :e hl_ty_cart R N :^: omega, forall a :e hl_ty_cart R M, forall b :e hl_ty_cart R N, hl_bilinear M N P bop = 1 /\ (hl_sums M x a (hl_from (hl_NUMERAL hl_zero)) = 1 /\ (hl_sums N y b (hl_from (hl_NUMERAL hl_zero)) = 1 /\ (hl_summable 1 (hl_from (hl_NUMERAL hl_zero)) (fun n :e omega => hl_lift (hl_vector_norm M (x n))) = 1 \/ hl_summable 1 (hl_from (hl_NUMERAL hl_zero)) (fun n :e omega => hl_lift (hl_vector_norm N (y n))) = 1))) -> hl_sums P (fun n :e omega => hl_vsum omega P (hl_numseg (hl_NUMERAL hl_zero) n) (fun i :e omega => bop (x i) (y (hl_sub n i)))) (bop a b) (hl_from (hl_NUMERAL hl_zero)) = 1.
