Theorem hlt_SERIES_PASTECART : forall M N:set, M <> Empty -> N <> Empty -> forall f1 :e hl_ty_cart R N :^: omega, forall f2 :e hl_ty_cart R M :^: omega, forall l1 :e hl_ty_cart R N, forall l2 :e hl_ty_cart R M, forall s :e 2 :^: omega, hl_sums (hl_ty_finite_sum N M) (fun x :e omega => hl_pastecart R N M (f1 x) (f2 x)) (hl_pastecart R N M l1 l2) s = 1 <-> hl_sums N f1 l1 s = 1 /\ hl_sums M f2 l2 s = 1.
