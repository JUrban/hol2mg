Theorem hlt_CONTINUOUS_ON_EQ_CONTINUOUS_AT : forall M N:set, M <> Empty -> N <> Empty -> forall f :e hl_ty_cart R N :^: hl_ty_cart R M, forall s :e 2 :^: hl_ty_cart R M, hl_open M s = 1 -> (hl_continuous_on M N f s = 1 <-> forall x :e hl_ty_cart R M, hl_IN (hl_ty_cart R M) x s = 1 -> hl_continuous (hl_ty_cart R M) N f (hl_at M x) = 1).
