Theorem hlt_SEGMENT_TRANSLATION : forall A B:set, A <> Empty -> B <> Empty -> (forall c a b :e hl_ty_cart R A, hl_closed_segment A (hl_CONS (hl_ty_cart R A :*: hl_ty_cart R A) (hl_pair (hl_ty_cart R A) (hl_ty_cart R A) (hl_vector_add A c a) (hl_vector_add A c b)) (hl_NIL (hl_ty_cart R A :*: hl_ty_cart R A))) = hl_IMAGE (hl_ty_cart R A) (hl_ty_cart R A) (fun x :e hl_ty_cart R A => hl_vector_add A c x) (hl_closed_segment A (hl_CONS (hl_ty_cart R A :*: hl_ty_cart R A) (hl_pair (hl_ty_cart R A) (hl_ty_cart R A) a b) (hl_NIL (hl_ty_cart R A :*: hl_ty_cart R A))))) /\ forall c a b :e hl_ty_cart R B, hl_open_segment B (hl_pair (hl_ty_cart R B) (hl_ty_cart R B) (hl_vector_add B c a) (hl_vector_add B c b)) = hl_IMAGE (hl_ty_cart R B) (hl_ty_cart R B) (fun x :e hl_ty_cart R B => hl_vector_add B c x) (hl_open_segment B (hl_pair (hl_ty_cart R B) (hl_ty_cart R B) a b)).
