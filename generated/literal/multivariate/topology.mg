// HOL Light: Multivariate/topology.ml:11033 / CONNECTED_COMPONENT_OVERLAP   (hash md5:49515e68085f02a80e77bcafb5678560)
Theorem hlt_CONNECTED_COMPONENT_OVERLAP : forall N:set, N <> Empty -> forall s :e 2 :^: hl_ty_cart R N, forall a b :e hl_ty_cart R N, ~ hl_INTER (hl_ty_cart R N) (hl_connected_component N s a) (hl_connected_component N s b) = hl_EMPTY (hl_ty_cart R N) <-> hl_IN (hl_ty_cart R N) a s = 1 /\ (hl_IN (hl_ty_cart R N) b s = 1 /\ hl_connected_component N s a = hl_connected_component N s b).
