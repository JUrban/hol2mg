// HOL Light: Multivariate/topology.ml:3566 / LIM_COMPOSE_WITHIN   (hash md5:3a7c934220d851120aeb4baad6427708)
Theorem hlt_LIM_COMPOSE_WITHIN : forall A N P:set, A <> Empty -> N <> Empty -> P <> Empty -> forall net1 :e hl_ty_net A, forall f :e hl_ty_cart R N :^: A, forall g :e hl_ty_cart R P :^: hl_ty_cart R N, forall s :e 2 :^: hl_ty_cart R N, forall y :e hl_ty_cart R N, forall z :e hl_ty_cart R P, hl_tendsto A N f y net1 = 1 /\ (hl_eventually A (fun w :e A => if hl_IN (hl_ty_cart R N) (f w) s = 1 /\ (f w = y -> g y = z) then 1 else 0) net1 = 1 /\ hl_tendsto (hl_ty_cart R N) P g z (hl_within (hl_ty_cart R N) (hl_at N y) s) = 1) -> hl_tendsto A P (hl_o (hl_ty_cart R N) (hl_ty_cart R P) A g f) z net1 = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:3584 / LIM_COMPOSE_AT   (hash md5:e60e5e8a50c77a69e56845935202ba86)
Theorem hlt_LIM_COMPOSE_AT : forall A N P:set, A <> Empty -> N <> Empty -> P <> Empty -> forall net1 :e hl_ty_net A, forall f :e hl_ty_cart R N :^: A, forall g :e hl_ty_cart R P :^: hl_ty_cart R N, forall y :e hl_ty_cart R N, forall z :e hl_ty_cart R P, hl_tendsto A N f y net1 = 1 /\ (hl_eventually A (fun w :e A => if f w = y -> g y = z then 1 else 0) net1 = 1 /\ hl_tendsto (hl_ty_cart R N) P g z (hl_at N y) = 1) -> hl_tendsto A P (hl_o (hl_ty_cart R N) (hl_ty_cart R P) A g f) z net1 = 1.
