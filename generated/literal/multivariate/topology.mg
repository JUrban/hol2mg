// HOL Light: Multivariate/topology.ml:4020 / LIM_VSUM   (hash md5:f92414b013169a42266ae015faa90e93)
Theorem hlt_LIM_VSUM : forall A B N:set, A <> Empty -> B <> Empty -> N <> Empty -> forall net1 :e hl_ty_net B, forall f :e hl_ty_cart R N :^: B :^: A, forall l :e hl_ty_cart R N :^: A, forall s :e 2 :^: A, hl_FINITE A s = 1 /\ (forall i :e A, hl_IN A i s = 1 -> hl_tendsto B N (f i) (l i) net1 = 1) -> hl_tendsto B N (fun x :e B => hl_vsum A N s (fun i :e A => f i x)) (hl_vsum A N s l) net1 = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:4028 / LIM_NULL_VSUM   (hash md5:b2b17ae1e6376b8322fc8ba38796b4dc)
Theorem hlt_LIM_NULL_VSUM : forall A B N:set, A <> Empty -> B <> Empty -> N <> Empty -> forall net1 :e hl_ty_net A, forall f :e hl_ty_cart R N :^: B :^: A, forall s :e 2 :^: B, hl_FINITE B s = 1 /\ (forall a :e B, hl_IN B a s = 1 -> hl_tendsto A N (fun x :e A => f x a) (hl_vec N (hl_NUMERAL hl_zero)) net1 = 1) -> hl_tendsto A N (fun x :e A => hl_vsum B N s (f x)) (hl_vec N (hl_NUMERAL hl_zero)) net1 = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:4039 / LIM_IN_CLOSED_SET   (hash md5:1f9fb69bacaa45b1bfe836620b5b9c84)
Theorem hlt_LIM_IN_CLOSED_SET : forall A N:set, A <> Empty -> N <> Empty -> forall net1 :e hl_ty_net A, forall f :e hl_ty_cart R N :^: A, forall s :e 2 :^: hl_ty_cart R N, forall l :e hl_ty_cart R N, hl_closed N s = 1 /\ (hl_eventually A (fun x :e A => hl_IN (hl_ty_cart R N) (f x) s) net1 = 1 /\ (~ hl_trivial_limit A net1 = 1 /\ hl_tendsto A N f l net1 = 1)) -> hl_IN (hl_ty_cart R N) l s = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:4060 / LIM_NORM_UBOUND   (hash md5:9ff1eba1463465eafc02e919628671d0)
Theorem hlt_LIM_NORM_UBOUND : forall A N:set, A <> Empty -> N <> Empty -> forall net1 :e hl_ty_net A, forall f :e hl_ty_cart R N :^: A, forall l :e hl_ty_cart R N, forall b :e R, ~ hl_trivial_limit A net1 = 1 /\ (hl_tendsto A N f l net1 = 1 /\ hl_eventually A (fun x :e A => hl_real_le (hl_vector_norm N (f x)) b) net1 = 1) -> hl_real_le (hl_vector_norm N l) b = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:4075 / LIM_NORM_LBOUND   (hash md5:8ff1cacf84a14f1ad918bbeb092a8c46)
Theorem hlt_LIM_NORM_LBOUND : forall A N:set, A <> Empty -> N <> Empty -> forall net1 :e hl_ty_net A, forall f :e hl_ty_cart R N :^: A, forall l :e hl_ty_cart R N, forall b :e R, ~ hl_trivial_limit A net1 = 1 /\ (hl_tendsto A N f l net1 = 1 /\ hl_eventually A (fun x :e A => hl_real_le b (hl_vector_norm N (f x))) net1 = 1) -> hl_real_le b (hl_vector_norm N l) = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:4093 / LIM_UNIQUE   (hash md5:2ef12c5f7768567516f721ec03be70fb)
Theorem hlt_LIM_UNIQUE : forall A N:set, A <> Empty -> N <> Empty -> forall net1 :e hl_ty_net A, forall f :e hl_ty_cart R N :^: A, forall l l' :e hl_ty_cart R N, ~ hl_trivial_limit A net1 = 1 /\ (hl_tendsto A N f l net1 = 1 /\ hl_tendsto A N f l' net1 = 1) -> l = l'.
Admitted.

// HOL Light: Multivariate/topology.ml:4099 / TENDSTO_LIM   (hash md5:8a35e1205295c817976819a49320dcd5)
Theorem hlt_TENDSTO_LIM : forall A B:set, A <> Empty -> B <> Empty -> forall net1 :e hl_ty_net A, forall f :e hl_ty_cart R B :^: A, forall l :e hl_ty_cart R B, ~ hl_trivial_limit A net1 = 1 /\ hl_tendsto A B f l net1 = 1 -> hl_lim A B net1 f = l.
Admitted.

// HOL Light: Multivariate/topology.ml:4103 / LIM_CONST_EQ   (hash md5:b2252a3da4e36ad66d44caabe36b27eb)
Theorem hlt_LIM_CONST_EQ : forall A N:set, A <> Empty -> N <> Empty -> forall net1 :e hl_ty_net A, forall c d :e hl_ty_cart R N, hl_tendsto A N (fun x :e A => c) d net1 = 1 <-> hl_trivial_limit A net1 = 1 \/ c = d.
