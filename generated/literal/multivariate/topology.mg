Theorem hlt_SEPARATION_CLOSED_IN_UNION : forall N:set, N <> Empty -> forall s t :e 2 :^: hl_ty_cart R N, hl_INTER (hl_ty_cart R N) s (hl_closure N t) = hl_EMPTY (hl_ty_cart R N) /\ hl_INTER (hl_ty_cart R N) t (hl_closure N s) = hl_EMPTY (hl_ty_cart R N) <-> hl_DISJOINT (hl_ty_cart R N) s t = 1 /\ (hl_closed_in (hl_ty_cart R N) (hl_subtopology (hl_ty_cart R N) (hl_euclidean N) (hl_UNION (hl_ty_cart R N) s t)) s = 1 /\ hl_closed_in (hl_ty_cart R N) (hl_subtopology (hl_ty_cart R N) (hl_euclidean N) (hl_UNION (hl_ty_cart R N) s t)) t = 1).
