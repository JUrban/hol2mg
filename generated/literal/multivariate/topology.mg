// HOL Light: Multivariate/topology.ml:2541 / CONNECTED_SEPARATION   (hash md5:52b9612807512cd03cd96f295036f123)
Theorem hlt_CONNECTED_SEPARATION : forall N:set, N <> Empty -> forall s :e 2 :^: hl_ty_cart R N, hl_connected N s = 1 <-> ~ exists c1 c2 :e 2 :^: hl_ty_cart R N, hl_UNION (hl_ty_cart R N) c1 c2 = s /\ (~ c1 = hl_EMPTY (hl_ty_cart R N) /\ (~ c2 = hl_EMPTY (hl_ty_cart R N) /\ (hl_INTER (hl_ty_cart R N) c1 (hl_closure N c2) = hl_EMPTY (hl_ty_cart R N) /\ hl_INTER (hl_ty_cart R N) c2 (hl_closure N c1) = hl_EMPTY (hl_ty_cart R N)))).
