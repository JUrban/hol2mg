// hol2mg literal statements (private): shard topology of profile multivariate.  Each theorem is the literal
// interpretation of the HOL Light theorem named in the comment; all are admitted source facts.

// HOL Light: Multivariate/topology.ml:19 / open_def   (hash md5:d3a5a09813c27433a3c321613ff2fb29)
Theorem hlt_open_def : forall A:set, A <> Empty -> forall s :e 2 :^: hl_ty_cart R A, hl_open A s = 1 <-> forall x :e hl_ty_cart R A, hl_IN (hl_ty_cart R A) x s = 1 -> exists e1 :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) e1 = 1 /\ forall x' :e hl_ty_cart R A, hl_real_lt (hl_distance A (hl_pair (hl_ty_cart R A) (hl_ty_cart R A) x' x)) e1 = 1 -> hl_IN (hl_ty_cart R A) x' s = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:22 / euclidean   (hash md5:20793706bae8591933d60ab9f2cf3c62)
Theorem hlt_euclidean_thm : forall A:set, A <> Empty -> hl_euclidean A = hl_topology (hl_ty_cart R A) (hl_open A).
Admitted.

// HOL Light: Multivariate/topology.ml:25 / euclidean_metric   (hash md5:b8260d0b3d8c01606ddff4657f3215bd)
Theorem hlt_euclidean_metric_thm : forall N:set, N <> Empty -> hl_euclidean_metric N = hl_metric (hl_ty_cart R N) (hl_pair (2 :^: hl_ty_cart R N) (R :^: (hl_ty_cart R N :*: hl_ty_cart R N)) (hl_UNIV (hl_ty_cart R N)) (hl_distance N)).
Admitted.

// HOL Light: Multivariate/topology.ml:28 / EUCLIDEAN_METRIC   (hash md5:959b92cb01079d9449f15815eed3ebd8)
Theorem hlt_EUCLIDEAN_METRIC : forall N:set, N <> Empty -> hl_mdist (hl_ty_cart R N) (hl_euclidean_metric N) = hl_distance N /\ hl_mspace (hl_ty_cart R N) (hl_euclidean_metric N) = hl_UNIV (hl_ty_cart R N).
Admitted.

// HOL Light: Multivariate/topology.ml:36 / OPEN_IN_EUCLIDEAN_METRIC   (hash md5:d299aa6bdf1b26c1128022f4755d0f55)
Theorem hlt_OPEN_IN_EUCLIDEAN_METRIC : forall N:set, N <> Empty -> hl_open_in (hl_ty_cart R N) (hl_mtopology (hl_ty_cart R N) (hl_euclidean_metric N)) = hl_open N.
Admitted.

// HOL Light: Multivariate/topology.ml:41 / OPEN_IN_EUCLIDEAN   (hash md5:087038fb512b63273b87e54acab4aa2a)
Theorem hlt_OPEN_IN_EUCLIDEAN : forall A:set, A <> Empty -> hl_open_in (hl_ty_cart R A) (hl_euclidean A) = hl_open A.
Admitted.

// HOL Light: Multivariate/topology.ml:46 / OPEN_IN   (hash md5:b3d7a5e1b3fe86d32faeaf00d59697b6)
