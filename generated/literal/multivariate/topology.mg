// HOL Light: Multivariate/topology.ml:4136 / UNIFORM_LIM_ADD   (hash md5:0b5c6e75883277ab12e72f803c4b00ae)
Theorem hlt_UNIFORM_LIM_ADD : forall C A B:set, C <> Empty -> A <> Empty -> B <> Empty -> forall net1 :e hl_ty_net A, forall P :e 2 :^: B, forall f g :e hl_ty_cart R C :^: A :^: B, forall l m :e hl_ty_cart R C :^: B, (forall e1 :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) e1 = 1 -> hl_eventually A (fun x :e A => if forall n :e B, P n = 1 -> hl_real_lt (hl_vector_norm C (hl_vector_sub C (f n x) (l n))) e1 = 1 then 1 else 0) net1 = 1) /\ (forall e1 :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) e1 = 1 -> hl_eventually A (fun x :e A => if forall n :e B, P n = 1 -> hl_real_lt (hl_vector_norm C (hl_vector_sub C (g n x) (m n))) e1 = 1 then 1 else 0) net1 = 1) -> forall e1 :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) e1 = 1 -> hl_eventually A (fun x :e A => if forall n :e B, P n = 1 -> hl_real_lt (hl_vector_norm C (hl_vector_sub C (hl_vector_add C (f n x) (g n x)) (hl_vector_add C (l n) (m n)))) e1 = 1 then 1 else 0) net1 = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:4157 / UNIFORM_LIM_SUB   (hash md5:14f40b8fd302df819f679b855381b921)
Theorem hlt_UNIFORM_LIM_SUB : forall C A B:set, C <> Empty -> A <> Empty -> B <> Empty -> forall net1 :e hl_ty_net A, forall P :e 2 :^: B, forall f g :e hl_ty_cart R C :^: A :^: B, forall l m :e hl_ty_cart R C :^: B, (forall e1 :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) e1 = 1 -> hl_eventually A (fun x :e A => if forall n :e B, P n = 1 -> hl_real_lt (hl_vector_norm C (hl_vector_sub C (f n x) (l n))) e1 = 1 then 1 else 0) net1 = 1) /\ (forall e1 :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) e1 = 1 -> hl_eventually A (fun x :e A => if forall n :e B, P n = 1 -> hl_real_lt (hl_vector_norm C (hl_vector_sub C (g n x) (m n))) e1 = 1 then 1 else 0) net1 = 1) -> forall e1 :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) e1 = 1 -> hl_eventually A (fun x :e A => if forall n :e B, P n = 1 -> hl_real_lt (hl_vector_norm C (hl_vector_sub C (hl_vector_sub C (f n x) (g n x)) (hl_vector_sub C (l n) (m n)))) e1 = 1 then 1 else 0) net1 = 1.
