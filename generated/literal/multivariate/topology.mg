Theorem hlt_HOMEOMORPHIC_ONE_POINT_COMPACTIFICATIONS : forall M N:set, M <> Empty -> N <> Empty -> forall s :e 2 :^: hl_ty_cart R M, forall t :e 2 :^: hl_ty_cart R N, forall a :e hl_ty_cart R M, forall b :e hl_ty_cart R N, hl_compact M s = 1 /\ (hl_compact N t = 1 /\ (hl_IN (hl_ty_cart R M) a s = 1 /\ (hl_IN (hl_ty_cart R N) b t = 1 /\ hl_homeomorphic M N (hl_DELETE (hl_ty_cart R M) s a) (hl_DELETE (hl_ty_cart R N) t b) = 1))) -> hl_homeomorphic M N s t = 1.
