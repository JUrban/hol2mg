// HOL Light: Multivariate/topology.ml:20189 / SYMMETRIC_MATRIX_DIAGONALIZABLE_EXPLICIT   (hash md5:2446a70cc571581be1a78c6b364a4f51)
Theorem hlt_SYMMETRIC_MATRIX_DIAGONALIZABLE_EXPLICIT : forall N:set, N <> Empty -> forall A :e hl_ty_cart (hl_ty_cart R N) N, hl_symmetric_matrix N A = 1 -> exists P :e hl_ty_cart (hl_ty_cart R N) N, exists d :e R :^: omega, hl_orthogonal_matrix N P = 1 /\ hl_matrix_mul N N N (hl_transp N N P) (hl_matrix_mul N N N A P) = hl_lambda (hl_ty_cart R N) N (fun i :e omega => hl_lambda R N (fun j :e omega => hl_COND R (if i = j then 1 else 0) (d i) (hl_real_of_num (hl_NUMERAL hl_zero)))).
