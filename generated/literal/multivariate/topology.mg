Theorem hlt_TOEPLITZ_BILINEAR_SERIES : forall M N P:set, M <> Empty -> N <> Empty -> P <> Empty -> forall bop :e hl_ty_cart R P :^: hl_ty_cart R N :^: hl_ty_cart R M, forall a :e hl_ty_cart R M :^: omega :^: omega, forall x :e hl_ty_cart R N :^: omega, forall m r :e omega, forall l :e hl_ty_cart R N, forall i :e hl_ty_cart R M, forall b :e R, hl_bilinear M N P bop = 1 /\ (hl_tendsto omega N x l hl_sequentially = 1 /\ ((forall p :e omega, hl_tendsto omega M (fun n :e omega => a n p) (hl_vec M (hl_NUMERAL hl_zero)) hl_sequentially = 1) /\ (hl_tendsto omega M (fun n :e omega => hl_vsum omega M (hl_numseg r n) (fun i1 :e omega => a n i1)) i hl_sequentially = 1 /\ (forall n :e omega, hl_real_le (hl_sum omega (hl_numseg (hl_NUMERAL hl_zero) n) (fun i1 :e omega => hl_vector_norm M (a n i1))) b = 1)))) -> hl_tendsto omega P (fun n :e omega => hl_vsum omega P (hl_numseg m n) (fun i1 :e omega => bop (a n i1) (x i1))) (bop i l) hl_sequentially = 1.
Admitted.

