// HOL Light: Multivariate/topology.ml:6731 / CONTINUOUS_ON_COMPARISON   (hash md5:aac0238a078833e0bf5a79a741baaf2c)
Theorem hlt_CONTINUOUS_ON_COMPARISON : forall M N P:set, M <> Empty -> N <> Empty -> P <> Empty -> forall f :e hl_ty_cart R N :^: hl_ty_cart R M, forall g :e hl_ty_cart R P :^: hl_ty_cart R M, forall s :e 2 :^: hl_ty_cart R M, hl_continuous_on M P g s = 1 /\ (forall x y :e hl_ty_cart R M, hl_IN (hl_ty_cart R M) x s = 1 /\ hl_IN (hl_ty_cart R M) y s = 1 -> hl_real_le (hl_distance N (hl_pair (hl_ty_cart R N) (hl_ty_cart R N) (f x) (f y))) (hl_distance P (hl_pair (hl_ty_cart R P) (hl_ty_cart R P) (g x) (g y))) = 1) -> hl_continuous_on M N f s = 1.
