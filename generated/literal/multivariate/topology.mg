Theorem hlt_CONNECTED_SEPARATION_ALT : forall N:set, N <> Empty -> forall s :e 2 :^: hl_ty_cart R N, hl_connected N s = 1 <-> ~ exists c1 c2 :e 2 :^: hl_ty_cart R N, hl_SUBSET (hl_ty_cart R N) s (hl_UNION (hl_ty_cart R N) c1 c2) = 1 /\ (~ hl_INTER (hl_ty_cart R N) c1 s = hl_EMPTY (hl_ty_cart R N) /\ (~ hl_INTER (hl_ty_cart R N) c2 s = hl_EMPTY (hl_ty_cart R N) /\ (hl_INTER (hl_ty_cart R N) c1 (hl_closure N c2) = hl_EMPTY (hl_ty_cart R N) /\ hl_INTER (hl_ty_cart R N) c2 (hl_closure N c1) = hl_EMPTY (hl_ty_cart R N)))).
