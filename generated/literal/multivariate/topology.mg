// HOL Light: Multivariate/topology.ml:2380 / NOWHERE_DENSE   (hash md5:e3c89b9eb6aaf2118365523e7c519b1d)
Theorem hlt_NOWHERE_DENSE : forall N:set, N <> Empty -> forall s :e 2 :^: hl_ty_cart R N, hl_interior N (hl_closure N s) = hl_EMPTY (hl_ty_cart R N) <-> forall t :e 2 :^: hl_ty_cart R N, hl_open N t = 1 /\ ~ t = hl_EMPTY (hl_ty_cart R N) -> exists u :e 2 :^: hl_ty_cart R N, hl_open N u = 1 /\ (~ u = hl_EMPTY (hl_ty_cart R N) /\ (hl_SUBSET (hl_ty_cart R N) u t = 1 /\ hl_INTER (hl_ty_cart R N) u s = hl_EMPTY (hl_ty_cart R N))).
