Theorem hlt_JOINABLE_CONNECTED_COMPONENT_EQ : forall N:set, N <> Empty -> forall s t :e 2 :^: hl_ty_cart R N, forall x y :e hl_ty_cart R N, hl_connected N t = 1 /\ (hl_SUBSET (hl_ty_cart R N) t s = 1 /\ (~ hl_INTER (hl_ty_cart R N) (hl_connected_component N s x) t = hl_EMPTY (hl_ty_cart R N) /\ ~ hl_INTER (hl_ty_cart R N) (hl_connected_component N s y) t = hl_EMPTY (hl_ty_cart R N))) -> hl_connected_component N s x = hl_connected_component N s y.
