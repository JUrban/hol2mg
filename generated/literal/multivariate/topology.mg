Theorem hlt_SUMMABLE_BILINEAR_LEFT : forall M N P:set, M <> Empty -> N <> Empty -> P <> Empty -> forall bop :e hl_ty_cart R P :^: hl_ty_cart R N :^: hl_ty_cart R M, forall x :e hl_ty_cart R M :^: omega, forall y :e hl_ty_cart R N :^: omega, forall m n p :e omega, hl_bilinear M N P bop = 1 /\ (hl_summable 1 (hl_from m) (fun n1 :e omega => hl_lift (hl_vector_norm M (x n1))) = 1 /\ hl_summable N (hl_from n) y = 1) -> hl_summable P (hl_from p) (fun n1 :e omega => hl_vsum omega P (hl_numseg (hl_NUMERAL hl_zero) n1) (fun i :e omega => bop (x i) (y (hl_sub n1 i)))) = 1.
