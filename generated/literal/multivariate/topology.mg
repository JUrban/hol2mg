Theorem hlt_CONNECTED_CONNECTED_DIFF : forall N:set, N <> Empty -> forall s t :e 2 :^: hl_ty_cart R N, hl_connected N s = 1 /\ (hl_SUBSET (hl_ty_cart R N) s (hl_closure N (hl_DIFF (hl_ty_cart R N) s t)) = 1 /\ (forall x :e hl_ty_cart R N, hl_IN (hl_ty_cart R N) x s = 1 -> exists u :e 2 :^: hl_ty_cart R N, hl_IN (hl_ty_cart R N) x u = 1 /\ (hl_open_in (hl_ty_cart R N) (hl_subtopology (hl_ty_cart R N) (hl_euclidean N) s) u = 1 /\ hl_connected N (hl_DIFF (hl_ty_cart R N) u t) = 1))) -> hl_connected N (hl_DIFF (hl_ty_cart R N) s t) = 1.
