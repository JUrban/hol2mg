// HOL Light: Multivariate/topology.ml:3273 / tendsto   (hash md5:4fa1cc189ae439f70a9d9f9937922204)
Theorem hlt_tendsto_thm : forall A B:set, A <> Empty -> B <> Empty -> forall f :e hl_ty_cart R A :^: B, forall l :e hl_ty_cart R A, forall net1 :e hl_ty_net B, hl_tendsto B A f l net1 = 1 <-> forall e1 :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) e1 = 1 -> hl_eventually B (fun x :e B => hl_real_lt (hl_distance A (hl_pair (hl_ty_cart R A) (hl_ty_cart R A) (f x) l)) e1) net1 = 1.
