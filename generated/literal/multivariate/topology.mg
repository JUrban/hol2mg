// HOL Light: Multivariate/topology.ml:4305 / LIM_TRANSFORM_WITHIN   (hash md5:dd075c10be1bd0babb28aee73b67b91a)
Theorem hlt_LIM_TRANSFORM_WITHIN : forall A B:set, A <> Empty -> B <> Empty -> forall l :e hl_ty_cart R A, forall f g :e hl_ty_cart R A :^: hl_ty_cart R B, forall x :e hl_ty_cart R B, forall s :e 2 :^: hl_ty_cart R B, forall d :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) d = 1 /\ ((forall x' :e hl_ty_cart R B, hl_IN (hl_ty_cart R B) x' s = 1 /\ (hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) (hl_distance B (hl_pair (hl_ty_cart R B) (hl_ty_cart R B) x' x)) = 1 /\ hl_real_lt (hl_distance B (hl_pair (hl_ty_cart R B) (hl_ty_cart R B) x' x)) d = 1) -> f x' = g x') /\ hl_tendsto (hl_ty_cart R B) A f l (hl_within (hl_ty_cart R B) (hl_at B x) s) = 1) -> hl_tendsto (hl_ty_cart R B) A g l (hl_within (hl_ty_cart R B) (hl_at B x) s) = 1.
Admitted.

// HOL Light: Multivariate/topology.ml:4317 / LIM_TRANSFORM_AT   (hash md5:d1758c31f9b90cc66ad95baea16097a2)
Theorem hlt_LIM_TRANSFORM_AT : forall A B:set, A <> Empty -> B <> Empty -> forall l :e hl_ty_cart R A, forall f g :e hl_ty_cart R A :^: hl_ty_cart R B, forall x :e hl_ty_cart R B, forall d :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) d = 1 /\ ((forall x' :e hl_ty_cart R B, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) (hl_distance B (hl_pair (hl_ty_cart R B) (hl_ty_cart R B) x' x)) = 1 /\ hl_real_lt (hl_distance B (hl_pair (hl_ty_cart R B) (hl_ty_cart R B) x' x)) d = 1 -> f x' = g x') /\ hl_tendsto (hl_ty_cart R B) A f l (hl_at B x) = 1) -> hl_tendsto (hl_ty_cart R B) A g l (hl_at B x) = 1.
