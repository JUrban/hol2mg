// HOL Light: Multivariate/metric.ml:1059 / OPEN_IN_INTER_DERIVED_SET_OF_SUBSET   (hash md5:1e165c06276b5c40360dac613af133e7)
Theorem hlt_OPEN_IN_INTER_DERIVED_SET_OF_SUBSET : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_open_in A top s = 1 -> hl_SUBSET A (hl_INTER A s (hl_derived_set_of A top t)) (hl_derived_set_of A top (hl_INTER A s t)) = 1.
