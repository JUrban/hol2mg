Theorem hlt_MCOMPLETE_NEST : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, hl_mcomplete A m = 1 <-> forall c :e 2 :^: A :^: omega, (forall n :e omega, hl_closed_in A (hl_mtopology A m) (c n) = 1) /\ ((forall n :e omega, ~ c n = hl_EMPTY A) /\ ((forall m1 n :e omega, hl_le m1 n = 1 -> hl_SUBSET A (c n) (c m1) = 1) /\ (forall e1 :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) e1 = 1 -> exists n :e omega, exists a :e A, hl_SUBSET A (c n) (hl_mcball A m (hl_pair A R a e1)) = 1))) -> ~ hl_INTERS A (hl_GSPEC (2 :^: A) (fun GEN_PVAR_1864 :e 2 :^: A => if exists n :e omega, hl_SETSPEC (2 :^: A) GEN_PVAR_1864 (hl_IN omega n (hl_UNIV omega)) (c n) = 1 then 1 else 0)) = hl_EMPTY A.
