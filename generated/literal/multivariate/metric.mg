Theorem hlt_uniformly_continuous_map_thm : forall A B:set, A <> Empty -> B <> Empty -> forall m1 :e hl_ty_metric B, forall m2 :e hl_ty_metric A, forall f :e A :^: B, hl_uniformly_continuous_map B A (hl_pair (hl_ty_metric B) (hl_ty_metric A) m1 m2) f = 1 <-> hl_SUBSET A (hl_IMAGE B A f (hl_mspace B m1)) (hl_mspace A m2) = 1 /\ forall e1 :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) e1 = 1 -> exists d :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) d = 1 /\ forall x x' :e B, hl_IN B x (hl_mspace B m1) = 1 /\ (hl_IN B x' (hl_mspace B m1) = 1 /\ hl_real_lt (hl_mdist B m1 (hl_pair B B x' x)) d = 1) -> hl_real_lt (hl_mdist A m2 (hl_pair A A (f x') (f x))) e1 = 1.
Admitted.

