// HOL Light: Multivariate/metric.ml:11707 / MBALL_SUBSET_MSPACE   (hash md5:e0e14da4e1f5f3c475208bd885e5a08d)
Theorem hlt_MBALL_SUBSET_MSPACE : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall x :e A, forall r :e R, hl_SUBSET A (hl_mball A m (hl_pair A R x r)) (hl_mspace A m) = 1.
