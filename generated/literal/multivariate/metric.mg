// HOL Light: Multivariate/metric.ml:26587 / CONNECTED_SPACE_IFF_QUASI_COMPONENTS_SUBSET_SING   (hash md5:d7af46fe7f1f4bd8e3b8ef6cf1938114)
Theorem hlt_CONNECTED_SPACE_IFF_QUASI_COMPONENTS_SUBSET_SING : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_connected_space A top = 1 <-> exists a :e 2 :^: A, hl_SUBSET (2 :^: A) (hl_quasi_components_of A top) (hl_INSERT (2 :^: A) a (hl_EMPTY (2 :^: A))) = 1.
