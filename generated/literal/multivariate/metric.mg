// HOL Light: Multivariate/metric.ml:6365 / RETRACT_OF_SPACE_DISJOINT_UNION   (hash md5:60e0b6a7f9b2e273c3d29b6e845f68d3)
Theorem hlt_RETRACT_OF_SPACE_DISJOINT_UNION : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_open_in A top s = 1 /\ (hl_open_in A top t = 1 /\ (hl_DISJOINT A s t = 1 /\ (hl_UNION A s t = hl_topspace A top /\ (s = hl_EMPTY A -> hl_topspace A top = hl_EMPTY A)))) -> hl_retract_of_space A s top = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:6377 / RETRACTION_MAPS_SECTION_IMAGE   (hash md5:693b6cd56d4ff369c8436db033b717bd)
Theorem hlt_RETRACTION_MAPS_SECTION_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall r :e B :^: A, forall s :e A :^: B, hl_retraction_maps A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') (hl_pair (B :^: A) (A :^: B) r s) = 1 -> hl_retract_of_space A (hl_IMAGE B A s (hl_topspace B top')) top = 1 /\ hl_homeomorphic_space A B (hl_subtopology A top (hl_IMAGE B A s (hl_topspace B top'))) top' = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:6392 / HEREDITARY_IMP_RETRACTIVE_PROPERTY   (hash md5:190a60e412976428c1262ce3ed9a0edc)
Theorem hlt_HEREDITARY_IMP_RETRACTIVE_PROPERTY : forall A B:set, A <> Empty -> B <> Empty -> forall P :e 2 :^: hl_ty_topology A, forall Q :e 2 :^: hl_ty_topology B, (forall top :e hl_ty_topology A, forall s :e 2 :^: A, P top = 1 -> P (hl_subtopology A top s) = 1) /\ (forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_homeomorphic_space A B top top' = 1 -> (P top = 1 <-> Q top' = 1)) -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall r :e B :^: A, hl_retraction_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') r = 1 /\ P top = 1 -> Q top' = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:6410 / compact_in   (hash md5:efca2089b61ad30ebaa83ed26893a2a4)
Theorem hlt_compact_in_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_compact_in A top s = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1 /\ forall U :e 2 :^: (2 :^: A), (forall u :e 2 :^: A, hl_IN (2 :^: A) u U = 1 -> hl_open_in A top u = 1) /\ hl_SUBSET A s (hl_UNIONS A U) = 1 -> exists V :e 2 :^: (2 :^: A), hl_FINITE (2 :^: A) V = 1 /\ (hl_SUBSET (2 :^: A) V U = 1 /\ hl_SUBSET A s (hl_UNIONS A V) = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:6417 / compact_space   (hash md5:0467717f1879e92e9c1bb75d8019ef4c)
Theorem hlt_compact_space_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_compact_space A top = 1 <-> hl_compact_in A top (hl_topspace A top) = 1.
