// HOL Light: Multivariate/metric.ml:1234 / CLOSED_IN_DERIVED_SET   (hash md5:a9e49726dfbd9dcc4ca52ba1bdbffdc2)
Theorem hlt_CLOSED_IN_DERIVED_SET : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_closed_in A (hl_subtopology A top t) s = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1 /\ (hl_SUBSET A s t = 1 /\ forall x :e A, hl_IN A x (hl_derived_set_of A top s) = 1 /\ hl_IN A x t = 1 -> hl_IN A x s = 1).
