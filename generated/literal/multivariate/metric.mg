// HOL Light: Multivariate/metric.ml:26683 / SEPARATED_BETWEEN_QUASI_COMPONENT_COMPACT   (hash md5:308c98d753f5f26902751ba09277aa98)
Theorem hlt_SEPARATED_BETWEEN_QUASI_COMPONENT_COMPACT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall c k :e 2 :^: A, hl_IN (2 :^: A) c (hl_quasi_components_of A top) = 1 /\ hl_compact_in A top k = 1 -> (hl_separated_between A top c k = 1 <-> hl_DISJOINT A c k = 1).
