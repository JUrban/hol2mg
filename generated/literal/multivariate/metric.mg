// HOL Light: Multivariate/metric.ml:22390 / PATH_CONNECTED_IN_CROSS   (hash md5:f74e0c4a346d34a0394dbe9a87ffcb0b)
Theorem hlt_PATH_CONNECTED_IN_CROSS : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, forall s :e 2 :^: A, forall t :e 2 :^: B, hl_path_connected_in (A :*: B) (hl_prod_topology A B top1 top2) (hl_CROSS A B s t) = 1 <-> s = hl_EMPTY A \/ (t = hl_EMPTY B \/ hl_path_connected_in A top1 s = 1 /\ hl_path_connected_in B top2 t = 1).
Admitted.

