Theorem hlt_QUASI_COMPONENT_OF_ALT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall x y :e A, hl_quasi_component_of A top x y = 1 <-> hl_IN A x (hl_topspace A top) = 1 /\ (hl_IN A y (hl_topspace A top) = 1 /\ ~ exists u v :e 2 :^: A, hl_open_in A top u = 1 /\ (hl_open_in A top v = 1 /\ (hl_UNION A u v = hl_topspace A top /\ (hl_DISJOINT A u v = 1 /\ (hl_IN A x u = 1 /\ hl_IN A y v = 1))))).
