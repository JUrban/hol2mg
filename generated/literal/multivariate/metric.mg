// HOL Light: Multivariate/metric.ml:27103 / SEPARATED_BETWEEN_FROM_FRONTIER_OF_CLOSED_SUBTOPOLOGY   (hash md5:e87696884e7cd79d4dc5d1b86d33e7c9)
Theorem hlt_SEPARATED_BETWEEN_FROM_FRONTIER_OF_CLOSED_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_separated_between A (hl_subtopology A top t) s (hl_frontier_of A top t) = 1 -> hl_separated_between A top s (hl_DIFF A (hl_topspace A top) t) = 1.
