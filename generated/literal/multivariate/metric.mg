Theorem hlt_KC_SPACE_AS_COMPACTIFICATION_UNIQUE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall a :e A, hl_kc_space A top = 1 /\ hl_compact_space A top = 1 -> forall u :e 2 :^: A, hl_open_in A top u = 1 <-> hl_IN A a u = 1 /\ (hl_SUBSET A u (hl_topspace A top) = 1 /\ hl_compact_in A top (hl_DIFF A (hl_topspace A top) u) = 1) \/ ~ hl_IN A a u = 1 /\ hl_open_in A (hl_subtopology A top (hl_DELETE A (hl_topspace A top) a)) u = 1.
