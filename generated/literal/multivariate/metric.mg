// HOL Light: Multivariate/metric.ml:50030 / KURATOWSKI_COMPONENT_NUMBER_INVARIANCE   (hash md5:09df6b351fc6ed456d9dd1972cd2da48)
Theorem hlt_KURATOWSKI_COMPONENT_NUMBER_INVARIANCE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_compact_space A top = 1 /\ (hl_hausdorff_space A top = 1 /\ (hl_locally_connected_space A top = 1 /\ hl_hereditarily A (hl_normal_space A) top = 1)) -> ((forall s t :e 2 :^: A, forall n :e omega, hl_closed_in A top s = 1 /\ (hl_closed_in A top t = 1 /\ hl_homeomorphic_space A A (hl_subtopology A top s) (hl_subtopology A top t) = 1) -> (hl_HAS_SIZE (2 :^: A) (hl_connected_components_of A (hl_subtopology A top (hl_DIFF A (hl_topspace A top) s))) n = 1 <-> hl_HAS_SIZE (2 :^: A) (hl_connected_components_of A (hl_subtopology A top (hl_DIFF A (hl_topspace A top) t))) n = 1)) <-> forall s t :e 2 :^: A, forall n :e omega, hl_homeomorphic_space A A (hl_subtopology A top s) (hl_subtopology A top t) = 1 -> (hl_HAS_SIZE (2 :^: A) (hl_connected_components_of A (hl_subtopology A top (hl_DIFF A (hl_topspace A top) s))) n = 1 <-> hl_HAS_SIZE (2 :^: A) (hl_connected_components_of A (hl_subtopology A top (hl_DIFF A (hl_topspace A top) t))) n = 1)).
Admitted.

