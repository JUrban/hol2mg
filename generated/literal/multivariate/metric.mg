Theorem hlt_QUASI_EQ_CONNECTED_COMPONENTS_OF_INCLUSION : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_quasi_components_of A top = hl_connected_components_of A top <-> hl_SUBSET (2 :^: A) (hl_connected_components_of A top) (hl_quasi_components_of A top) = 1 \/ hl_SUBSET (2 :^: A) (hl_quasi_components_of A top) (hl_connected_components_of A top) = 1.
