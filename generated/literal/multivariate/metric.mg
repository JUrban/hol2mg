// HOL Light: Multivariate/metric.ml:25540 / LOCALLY_PATH_CONNECTED_SPACE_PRODUCT_TOPOLOGY   (hash md5:1a7839d471c517bf1017e6880c1520dd)
Theorem hlt_LOCALLY_PATH_CONNECTED_SPACE_PRODUCT_TOPOLOGY : forall A K:set, A <> Empty -> K <> Empty -> forall tops :e hl_ty_topology A :^: K, forall k :e 2 :^: K, hl_locally_path_connected_space (A :^: K) (hl_product_topology K A k tops) = 1 <-> hl_topspace (A :^: K) (hl_product_topology K A k tops) = hl_EMPTY (A :^: K) \/ hl_FINITE K (hl_GSPEC K (fun GEN_PVAR_2031 :e K => if exists i :e K, hl_SETSPEC K GEN_PVAR_2031 (if hl_IN K i k = 1 /\ ~ hl_path_connected_space A (tops i) = 1 then 1 else 0) i = 1 then 1 else 0)) = 1 /\ forall i :e K, hl_IN K i k = 1 -> hl_locally_path_connected_space A (tops i) = 1.
