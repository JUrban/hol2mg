// HOL Light: Multivariate/metric.ml:1220 / DERIVED_SET_SUBSET_GEN   (hash md5:9e26c06d899beacf72e6822ccc5584bd)
Theorem hlt_DERIVED_SET_SUBSET_GEN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_SUBSET A (hl_derived_set_of A top s) s = 1 <-> hl_closed_in A top (hl_INTER A (hl_topspace A top) s) = 1.
