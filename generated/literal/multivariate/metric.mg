Theorem hlt_HOMOTOPIC_WITH_IMP_PROPERTY : forall A B:set, A <> Empty -> B <> Empty -> forall P :e 2 :^: (B :^: A), forall X :e hl_ty_topology A, forall Y :e hl_ty_topology B, forall f g :e B :^: A, hl_homotopic_with A B P (hl_pair (hl_ty_topology A) (hl_ty_topology B) X Y) f g = 1 -> P f = 1 /\ P g = 1.
