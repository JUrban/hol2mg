// HOL Light: Multivariate/metric.ml:26630 / SEPARATED_BETWEEN_QUASI_COMPONENT_POINTWISE_LEFT   (hash md5:b5079abbc970904525b1637843f95afe)
Theorem hlt_SEPARATED_BETWEEN_QUASI_COMPONENT_POINTWISE_LEFT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall c s :e 2 :^: A, hl_IN (2 :^: A) c (hl_quasi_components_of A top) = 1 -> (hl_separated_between A top c s = 1 <-> exists x :e A, hl_IN A x c = 1 /\ hl_separated_between A top (hl_INSERT A x (hl_EMPTY A)) s = 1).
Admitted.

