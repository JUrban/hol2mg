Theorem hlt_OPEN_IN_INTER_CLOSURE_OF_EQ : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_open_in A top s = 1 -> hl_INTER A s (hl_closure_of A top t) = hl_INTER A s (hl_closure_of A top (hl_INTER A s t)).
