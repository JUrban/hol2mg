Theorem hlt_CONTINUOUS_EXTENSION_OF_PROPER_MAP_FROM_SUBTOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall s :e 2 :^: A, forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_hausdorff_space A top = 1 /\ (hl_SUBSET A s (hl_topspace A top) = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_proper_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top s) top') f = 1)) -> hl_closed_in A top s = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:9679 / perfect_map   (hash md5:f2a0717d4c87742171cf255cd6b31978)
Theorem hlt_perfect_map_thm : forall A B:set, A <> Empty -> B <> Empty -> forall f :e B :^: A, forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_perfect_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 <-> hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (hl_proper_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_IMAGE A B f (hl_topspace A top) = hl_topspace B top').
Admitted.

// HOL Light: Multivariate/metric.ml:9685 / HOMEOMORPHIC_IMP_PERFECT_MAP   (hash md5:fb568cf8813a0d048b02b23dce52d1a6)
Theorem hlt_HOMEOMORPHIC_IMP_PERFECT_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_homeomorphic_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 -> hl_perfect_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1.
