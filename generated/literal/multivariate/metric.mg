Theorem hlt_PROPER_MAP_FROM_SUBTOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, forall c :e 2 :^: A, hl_proper_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_closed_in A top c = 1 -> hl_proper_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top c) top') f = 1.
