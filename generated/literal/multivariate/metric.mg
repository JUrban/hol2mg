Theorem hlt_HAUSDORFF_NORMAL_SPACE_CLOSED_CONTINUOUS_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_normal_space A top = 1 /\ (hl_closed_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (hl_IMAGE A B f (hl_topspace A top) = hl_topspace B top' /\ hl_t1_space B top' = 1))) -> hl_hausdorff_space B top' = 1.
