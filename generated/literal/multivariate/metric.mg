// HOL Light: Multivariate/metric.ml:1006 / DERIVED_SET_OF_UNIONS   (hash md5:343df38757045f48af2eac8192c1a414)
Theorem hlt_DERIVED_SET_OF_UNIONS : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall f :e 2 :^: (2 :^: A), hl_FINITE (2 :^: A) f = 1 -> hl_derived_set_of A top (hl_UNIONS A f) = hl_UNIONS A (hl_GSPEC (2 :^: A) (fun GEN_PVAR_1247 :e 2 :^: A => if exists s :e 2 :^: A, hl_SETSPEC (2 :^: A) GEN_PVAR_1247 (hl_IN (2 :^: A) s f) (hl_derived_set_of A top s) = 1 then 1 else 0)).
