// HOL Light: Multivariate/metric.ml:3529 / QUOTIENT_MAP_RESTRICTION   (hash md5:ff358224cd2137e963d9b4484bc576b8)
Theorem hlt_QUOTIENT_MAP_RESTRICTION : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, forall u :e 2 :^: A, forall v :e 2 :^: B, hl_quotient_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ ((hl_open_in B top' v = 1 \/ hl_closed_in B top' v = 1) /\ hl_GSPEC A (fun GEN_PVAR_1379 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_1379 (if hl_IN A x (hl_topspace A top) = 1 /\ hl_IN B (f x) v = 1 then 1 else 0) x = 1 then 1 else 0) = u) -> hl_quotient_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top u) (hl_subtopology B top' v)) f = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:3553 / QUOTIENT_MAP_SATURATED_OPEN   (hash md5:9324b5878f3d349c5c3d4bb9bf99ab0c)
Theorem hlt_QUOTIENT_MAP_SATURATED_OPEN : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_quotient_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 <-> hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (hl_IMAGE A B f (hl_topspace A top) = hl_topspace B top' /\ forall u :e 2 :^: A, hl_open_in A top u = 1 /\ hl_SUBSET A (hl_GSPEC A (fun GEN_PVAR_1381 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_1381 (if hl_IN A x (hl_topspace A top) = 1 /\ hl_IN B (f x) (hl_IMAGE A B f u) = 1 then 1 else 0) x = 1 then 1 else 0)) u = 1 -> hl_open_in B top' (hl_IMAGE A B f u) = 1).
