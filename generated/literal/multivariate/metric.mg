Theorem hlt_PATH_IN_COMPOSE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, forall g :e A :^: R, hl_path_in A top g = 1 /\ hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 -> hl_path_in B top' (hl_o A B R f g) = 1.
