Theorem hlt_OPEN_IN_CLOSED_IN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_SUBSET A s (hl_topspace A top) = 1 -> (hl_open_in A top s = 1 <-> hl_closed_in A top (hl_DIFF A (hl_topspace A top) s) = 1).
