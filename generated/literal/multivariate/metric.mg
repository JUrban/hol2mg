// HOL Light: Multivariate/metric.ml:1302 / FORALL_IN_CLOSURE_OF_GEN   (hash md5:a7ba831cba52dbac012dbad21f72ef8e)
Theorem hlt_FORALL_IN_CLOSURE_OF_GEN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall P s :e 2 :^: A, (forall x :e A, hl_IN A x s = 1 -> P x = 1) /\ hl_closed_in A top (hl_GSPEC A (fun GEN_PVAR_1253 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_1253 (if hl_IN A x (hl_closure_of A top s) = 1 /\ P x = 1 then 1 else 0) x = 1 then 1 else 0)) = 1 -> forall x :e A, hl_IN A x (hl_closure_of A top s) = 1 -> P x = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:1316 / FORALL_IN_CLOSURE_OF   (hash md5:f4ecc0f6bd5ce1b8f9946615c33c60f3)
Theorem hlt_FORALL_IN_CLOSURE_OF : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall P s :e 2 :^: A, (forall x :e A, hl_IN A x s = 1 -> P x = 1) /\ hl_closed_in A top (hl_GSPEC A (fun GEN_PVAR_1256 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_1256 (if hl_IN A x (hl_topspace A top) = 1 /\ P x = 1 then 1 else 0) x = 1 then 1 else 0)) = 1 -> forall x :e A, hl_IN A x (hl_closure_of A top s) = 1 -> P x = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:1330 / FORALL_IN_CLOSURE_OF_UNIV   (hash md5:672b03e51903a5d6ecf6b1446da6f81b)
Theorem hlt_FORALL_IN_CLOSURE_OF_UNIV : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall P s :e 2 :^: A, (forall x :e A, hl_IN A x s = 1 -> P x = 1) /\ hl_closed_in A top (hl_GSPEC A (fun GEN_PVAR_1258 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_1258 (P x) x = 1 then 1 else 0)) = 1 -> forall x :e A, hl_IN A x (hl_closure_of A top s) = 1 -> P x = 1.
Admitted.

