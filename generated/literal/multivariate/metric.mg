Theorem hlt_PATH_CONNECTED_IN_SUBSET_TOPSPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_path_connected_in A top s = 1 -> hl_SUBSET A s (hl_topspace A top) = 1.
