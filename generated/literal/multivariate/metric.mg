Theorem hlt_CLOSURE_OF_EQ_UNIV : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_closure_of A top s = hl_topspace A top <-> hl_interior_of A top (hl_DIFF A (hl_topspace A top) s) = hl_EMPTY A.
