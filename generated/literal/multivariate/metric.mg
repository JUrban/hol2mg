Theorem hlt_HAUSDORFF_SPACE_COMPACT_SETS : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_hausdorff_space A top = 1 <-> forall s t :e 2 :^: A, hl_compact_in A top s = 1 /\ (hl_compact_in A top t = 1 /\ hl_DISJOINT A s t = 1) -> exists u v :e 2 :^: A, hl_open_in A top u = 1 /\ (hl_open_in A top v = 1 /\ (hl_SUBSET A s u = 1 /\ (hl_SUBSET A t v = 1 /\ hl_DISJOINT A u v = 1))).
Admitted.

// HOL Light: Multivariate/metric.ml:8167 / COMPACT_IN_IMP_CLOSED_IN   (hash md5:195786facf2fcb682f31d4cff3dc3d8b)
