Admitted.

// HOL Light: Multivariate/metric.ml:14227 / separated_between   (hash md5:74be5bf55ab7fb978b983a6be0d979db)
Theorem hlt_separated_between_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_separated_between A top s t = 1 <-> exists u v :e 2 :^: A, hl_open_in A top u = 1 /\ (hl_open_in A top v = 1 /\ (hl_UNION A u v = hl_topspace A top /\ (hl_DISJOINT A u v = 1 /\ (hl_SUBSET A s u = 1 /\ hl_SUBSET A t v = 1)))).
Admitted.

