Theorem hlt_CLOSURE_OF_EQ_EMPTY : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_SUBSET A s (hl_topspace A top) = 1 -> (hl_closure_of A top s = hl_EMPTY A <-> s = hl_EMPTY A).
