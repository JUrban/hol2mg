// HOL Light: Multivariate/metric.ml:25278 / WEAKLY_LOCALLY_PATH_CONNECTED_AT   (hash md5:f9f79fce17e1e670c41d8c2ebb016c64)
Theorem hlt_WEAKLY_LOCALLY_PATH_CONNECTED_AT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall x :e A, hl_weakly_locally_path_connected_at A x top = 1 <-> forall v :e 2 :^: A, hl_open_in A top v = 1 /\ hl_IN A x v = 1 -> exists u :e 2 :^: A, hl_open_in A top u = 1 /\ (hl_IN A x u = 1 /\ (hl_SUBSET A u v = 1 /\ forall y :e A, hl_IN A y u = 1 -> exists c :e 2 :^: A, hl_path_connected_in A top c = 1 /\ (hl_SUBSET A c v = 1 /\ (hl_IN A x c = 1 /\ hl_IN A y c = 1)))).
Admitted.

// HOL Light: Multivariate/metric.ml:25307 / LOCALLY_PATH_CONNECTED_SPACE_IM_KLEINEN   (hash md5:d20fc2a2fe8f54fcbf23263e87611382)
Theorem hlt_LOCALLY_PATH_CONNECTED_SPACE_IM_KLEINEN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_locally_path_connected_space A top = 1 <-> forall v :e 2 :^: A, forall x :e A, hl_open_in A top v = 1 /\ hl_IN A x v = 1 -> exists u :e 2 :^: A, hl_open_in A top u = 1 /\ (hl_IN A x u = 1 /\ (hl_SUBSET A u v = 1 /\ forall y :e A, hl_IN A y u = 1 -> exists c :e 2 :^: A, hl_path_connected_in A top c = 1 /\ (hl_SUBSET A c v = 1 /\ (hl_IN A x c = 1 /\ hl_IN A y c = 1)))).
