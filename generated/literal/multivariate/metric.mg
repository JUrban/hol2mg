Theorem hlt_TOTALLY_BOUNDED_IN_UNION : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall s t :e 2 :^: A, hl_totally_bounded_in A m s = 1 /\ hl_totally_bounded_in A m t = 1 -> hl_totally_bounded_in A m (hl_UNION A s t) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:20566 / TOTALLY_BOUNDED_IN_UNIONS   (hash md5:a015617bccc40e8bab270fd7c01c7a81)
Theorem hlt_TOTALLY_BOUNDED_IN_UNIONS : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall f :e 2 :^: (2 :^: A), hl_FINITE (2 :^: A) f = 1 /\ (forall s :e 2 :^: A, hl_IN (2 :^: A) s f = 1 -> hl_totally_bounded_in A m s = 1) -> hl_totally_bounded_in A m (hl_UNIONS A f) = 1.
