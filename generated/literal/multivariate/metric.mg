// HOL Light: Multivariate/metric.ml:9705 / PERFECT_INJECTIVE_EQ_HOMEOMORPHIC_MAP   (hash md5:b4d4ee44e791d01387e7d2bb24a936b0)
Theorem hlt_PERFECT_INJECTIVE_EQ_HOMEOMORPHIC_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_perfect_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (forall x y :e A, hl_IN A x (hl_topspace A top) = 1 /\ (hl_IN A y (hl_topspace A top) = 1 /\ f x = f y) -> x = y) <-> hl_homeomorphic_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1.
Admitted.

