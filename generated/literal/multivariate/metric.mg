// HOL Light: Multivariate/metric.ml:26659 / SEPARATED_BETWEEN_QUASI_COMPONENT_POINT   (hash md5:25978a482e2a15a0dc98ba7806664b4c)
Theorem hlt_SEPARATED_BETWEEN_QUASI_COMPONENT_POINT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall c :e 2 :^: A, forall x :e A, hl_IN (2 :^: A) c (hl_quasi_components_of A top) = 1 -> (hl_separated_between A top c (hl_INSERT A x (hl_EMPTY A)) = 1 <-> hl_IN A x (hl_DIFF A (hl_topspace A top) c) = 1).
