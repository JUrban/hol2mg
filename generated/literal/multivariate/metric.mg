// HOL Light: Multivariate/metric.ml:18935 / LIMIT_IN_MSPACE   (hash md5:35d723926e9faaf9abde82677bbb8206)
Theorem hlt_LIMIT_IN_MSPACE : forall A B:set, A <> Empty -> B <> Empty -> forall net1 :e hl_ty_net A, forall m :e hl_ty_metric B, forall f :e B :^: A, forall l :e B, hl_limit B A (hl_mtopology B m) f l net1 = 1 -> hl_IN B l (hl_mspace B m) = 1.
