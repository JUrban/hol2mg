Theorem hlt_URYSOHN_LEMMA : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, forall a b :e R, hl_real_le a b = 1 /\ (hl_normal_space A top = 1 /\ (hl_closed_in A top s = 1 /\ (hl_closed_in A top t = 1 /\ hl_DISJOINT A s t = 1))) -> exists f :e R :^: A, hl_continuous_map A R (hl_pair (hl_ty_topology A) (hl_ty_topology R) top (hl_subtopology R hl_euclideanreal (hl_closed_real_interval (hl_CONS (R :*: R) (hl_pair R R a b) (hl_NIL (R :*: R)))))) f = 1 /\ ((forall x :e A, hl_IN A x s = 1 -> f x = a) /\ forall x :e A, hl_IN A x t = 1 -> f x = b).
Admitted.

