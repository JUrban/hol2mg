// HOL Light: Multivariate/metric.ml:289 / CARD_EQ_OPEN_CLOSED_IN_SETS   (hash md5:dc969e95bbee8e1d78031bbbf8afa101)
Theorem hlt_CARD_EQ_OPEN_CLOSED_IN_SETS : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_sym_3d5f63 (2 :^: A) (2 :^: A) (hl_GSPEC (2 :^: A) (fun GEN_PVAR_1233 :e 2 :^: A => if exists s :e 2 :^: A, hl_SETSPEC (2 :^: A) GEN_PVAR_1233 (hl_open_in A top s) s = 1 then 1 else 0)) (hl_GSPEC (2 :^: A) (fun GEN_PVAR_1234 :e 2 :^: A => if exists s :e 2 :^: A, hl_SETSPEC (2 :^: A) GEN_PVAR_1234 (hl_closed_in A top s) s = 1 then 1 else 0)) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:302 / discrete_topology   (hash md5:c29386a3ed67e648311129fe25e693d4)
Theorem hlt_discrete_topology_thm : forall A:set, A <> Empty -> forall u :e 2 :^: A, hl_discrete_topology A u = hl_topology A (hl_GSPEC (2 :^: A) (fun GEN_PVAR_1235 :e 2 :^: A => if exists s :e 2 :^: A, hl_SETSPEC (2 :^: A) GEN_PVAR_1235 (hl_SUBSET A s u) s = 1 then 1 else 0)).
Admitted.

// HOL Light: Multivariate/metric.ml:305 / discrete_space   (hash md5:519855f58fd882f891e51f7c30aae4d7)
Theorem hlt_discrete_space_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_discrete_space A top = 1 <-> hl_discrete_topology A (hl_topspace A top) = top.
Admitted.

