// HOL Light: Multivariate/metric.ml:22038 / path_in   (hash md5:debcaa2bee7c9725b526ec00d0e75c1b)
Theorem hlt_path_in_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall g :e A :^: R, hl_path_in A top g = 1 <-> hl_continuous_map R A (hl_pair (hl_ty_topology R) (hl_ty_topology A) (hl_subtopology R hl_euclideanreal (hl_closed_real_interval (hl_CONS (R :*: R) (hl_pair R R (hl_real_of_num (hl_NUMERAL hl_zero)) (hl_real_of_num (hl_NUMERAL (hl_BIT1 hl_zero)))) (hl_NIL (R :*: R))))) top) g = 1.
