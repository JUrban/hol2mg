Theorem hlt_CONNECTED_SPACE_CLOPEN_IN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_connected_space A top = 1 <-> forall t :e 2 :^: A, hl_open_in A top t = 1 /\ hl_closed_in A top t = 1 -> t = hl_EMPTY A \/ t = hl_topspace A top.
