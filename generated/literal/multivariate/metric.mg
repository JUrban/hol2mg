Theorem hlt_OPEN_IN_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u s :e 2 :^: A, hl_open_in A (hl_discrete_topology A u) s = 1 <-> hl_SUBSET A s u = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:316 / TOPSPACE_DISCRETE_TOPOLOGY   (hash md5:0811947d58a3b058e9d0f4d17264aa1b)
Theorem hlt_TOPSPACE_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u :e 2 :^: A, hl_topspace A (hl_discrete_topology A u) = u.
Admitted.

