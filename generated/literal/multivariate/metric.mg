Theorem hlt_ISTOPOLOGY_BASE_ALT : forall A:set, A <> Empty -> forall P :e 2 :^: (2 :^: A), hl_istopology A (hl_UNION_OF A (hl_ARBITRARY A) P) = 1 <-> forall s t :e 2 :^: A, hl_UNION_OF A (hl_ARBITRARY A) P s = 1 /\ hl_UNION_OF A (hl_ARBITRARY A) P t = 1 -> hl_UNION_OF A (hl_ARBITRARY A) P (hl_INTER A s t) = 1.
