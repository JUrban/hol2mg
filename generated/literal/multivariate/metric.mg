Theorem hlt_PROPER_MAP_FST : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_proper_map (A :*: B) A (hl_pair (hl_ty_topology (A :*: B)) (hl_ty_topology A) (hl_prod_topology A B top top') top) (hl_FST A B) = 1 <-> hl_topspace A top = hl_EMPTY A \/ hl_compact_space B top' = 1.
