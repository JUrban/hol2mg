Theorem hlt_TOTALLY_BOUNDED_IN_CAUCHY_SEQUENCE : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall x :e A :^: omega, hl_cauchy_in A m x = 1 -> hl_totally_bounded_in A m (hl_IMAGE omega A x (hl_UNIV omega)) = 1.
