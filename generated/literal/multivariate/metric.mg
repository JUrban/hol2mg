Theorem hlt_HOMEOMORPHIC_NORMAL_SPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_homeomorphic_space A B top top' = 1 -> (hl_normal_space A top = 1 <-> hl_normal_space B top' = 1).
