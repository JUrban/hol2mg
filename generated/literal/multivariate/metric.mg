Theorem hlt_HOMOTOPIC_WITH_IMP_CONTINUOUS_MAPS : forall A B:set, A <> Empty -> B <> Empty -> forall P :e 2 :^: (B :^: A), forall X :e hl_ty_topology A, forall Y :e hl_ty_topology B, forall p q :e B :^: A, hl_homotopic_with A B P (hl_pair (hl_ty_topology A) (hl_ty_topology B) X Y) p q = 1 -> hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) X Y) p = 1 /\ hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) X Y) q = 1.
