Theorem hlt_TOPOLOGY_EQ_ALT : forall A:set, A <> Empty -> forall top1 top2 :e hl_ty_topology A, top1 = top2 <-> forall s :e 2 :^: A, hl_closed_in A top1 s = 1 <-> hl_closed_in A top2 s = 1.
