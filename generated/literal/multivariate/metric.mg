Theorem hlt_LOCALLY_COMPACT_REGULAR_IMP_COMPLETELY_REGULAR_SPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_locally_compact_space A top = 1 /\ (hl_hausdorff_space A top = 1 \/ hl_regular_space A top = 1) -> hl_completely_regular_space A top = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:25046 / COMPLETELY_REGULAR_EQ_REGULAR_SPACE   (hash md5:c79bb9edfe66d171dfc159af447d56e1)
Theorem hlt_COMPLETELY_REGULAR_EQ_REGULAR_SPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_locally_compact_space A top = 1 -> (hl_completely_regular_space A top = 1 <-> hl_regular_space A top = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:25053 / COMPLETELY_REGULAR_SPACE_PROD_TOPOLOGY   (hash md5:01b08ce2f63c11216cb9a32b8cd66711)
Theorem hlt_COMPLETELY_REGULAR_SPACE_PROD_TOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, hl_completely_regular_space (A :*: B) (hl_prod_topology A B top1 top2) = 1 <-> hl_topspace (A :*: B) (hl_prod_topology A B top1 top2) = hl_EMPTY (A :*: B) \/ hl_completely_regular_space A top1 = 1 /\ hl_completely_regular_space B top2 = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:25095 / COMPLETELY_REGULAR_SPACE_PRODUCT_TOPOLOGY   (hash md5:363c0f0e8d27455e3ee31d8f539ca6de)
Theorem hlt_COMPLETELY_REGULAR_SPACE_PRODUCT_TOPOLOGY : forall A K:set, A <> Empty -> K <> Empty -> forall tops :e hl_ty_topology A :^: K, forall k :e 2 :^: K, hl_completely_regular_space (A :^: K) (hl_product_topology K A k tops) = 1 <-> hl_topspace (A :^: K) (hl_product_topology K A k tops) = hl_EMPTY (A :^: K) \/ forall i :e K, hl_IN K i k = 1 -> hl_completely_regular_space A (tops i) = 1.
Admitted.

