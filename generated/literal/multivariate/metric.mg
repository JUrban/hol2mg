Admitted.

// HOL Light: Multivariate/metric.ml:27042 / CUT_WIRE_FENCE_THEOREM_GEN   (hash md5:5bd230af303f77d8c70c3c8a8d3b5282)
Theorem hlt_CUT_WIRE_FENCE_THEOREM_GEN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_compact_space A top = 1 /\ ((hl_hausdorff_space A top = 1 \/ (hl_regular_space A top = 1 \/ hl_normal_space A top = 1)) /\ (hl_compact_in A top s = 1 /\ (hl_closed_in A top t = 1 /\ (forall c :e 2 :^: A, hl_connected_in A top c = 1 -> hl_DISJOINT A c s = 1 \/ hl_DISJOINT A c t = 1)))) -> hl_separated_between A top s t = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:27066 / CUT_WIRE_FENCE_THEOREM   (hash md5:2d47d7a9fc16c7604f1cc6528dab9b98)
Theorem hlt_CUT_WIRE_FENCE_THEOREM : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_compact_space A top = 1 /\ (hl_hausdorff_space A top = 1 /\ (hl_closed_in A top s = 1 /\ (hl_closed_in A top t = 1 /\ (forall c :e 2 :^: A, hl_connected_in A top c = 1 -> hl_DISJOINT A c s = 1 \/ hl_DISJOINT A c t = 1)))) -> hl_separated_between A top s t = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:27075 / SEPARATED_BETWEEN_FROM_CLOSED_SUBTOPOLOGY   (hash md5:3bed39015ba0b60f25a766393cf76478)
Theorem hlt_SEPARATED_BETWEEN_FROM_CLOSED_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t c :e 2 :^: A, hl_separated_between A (hl_subtopology A top c) s (hl_frontier_of A top c) = 1 /\ hl_separated_between A (hl_subtopology A top c) s t = 1 -> hl_separated_between A top s t = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:27097 / SEPARATED_BETWEEN_FROM_CLOSED_SUBTOPOLOGY_FRONTIER   (hash md5:36ea6f877b979734e20a480042139916)
Theorem hlt_SEPARATED_BETWEEN_FROM_CLOSED_SUBTOPOLOGY_FRONTIER : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_separated_between A (hl_subtopology A top t) s (hl_frontier_of A top t) = 1 -> hl_separated_between A top s (hl_frontier_of A top t) = 1.
