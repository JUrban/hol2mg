// HOL Light: Multivariate/metric.ml:18597 / LIMIT_REAL_CONST   (hash md5:afbf609c43779c99f32778eb50e0fbd0)
Theorem hlt_LIMIT_REAL_CONST : forall A:set, A <> Empty -> forall net1 :e hl_ty_net A, forall l :e R, hl_limit R A hl_euclideanreal (fun a :e A => l) l net1 = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:18601 / LIMIT_CONST_EQ   (hash md5:375d07b8a630ae3b552df325d42f6152)
Theorem hlt_LIMIT_CONST_EQ : forall A K:set, A <> Empty -> K <> Empty -> forall net1 :e hl_ty_net K, forall top :e hl_ty_topology A, forall a l :e A, hl_t1_space A top = 1 /\ ~ hl_trivial_limit K net1 = 1 -> (hl_limit A K top (fun k :e K => a) l net1 = 1 <-> hl_IN A l (hl_topspace A top) = 1 /\ a = l).
Admitted.

// HOL Light: Multivariate/metric.ml:18619 / LIMIT_EVENTUALLY   (hash md5:c6c2498fba9a6651ef92d9895e25d021)
Theorem hlt_LIMIT_EVENTUALLY : forall A K:set, A <> Empty -> K <> Empty -> forall top :e hl_ty_topology A, forall net1 :e hl_ty_net K, forall f :e A :^: K, forall l :e A, hl_IN A l (hl_topspace A top) = 1 /\ hl_eventually K (fun x :e K => if f x = l then 1 else 0) net1 = 1 -> hl_limit A K top f l net1 = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:18628 / LIMIT_WITHIN_SUBSET   (hash md5:2f2158b6e167dd11d7e7f199b1f7adcb)
Theorem hlt_LIMIT_WITHIN_SUBSET : forall A B:set, A <> Empty -> B <> Empty -> forall net1 :e hl_ty_net A, forall top :e hl_ty_topology B, forall f :e B :^: A, forall l :e B, forall s t :e 2 :^: A, hl_limit B A top f l (hl_within A net1 s) = 1 /\ hl_SUBSET A t s = 1 -> hl_limit B A top f l (hl_within A net1 t) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:18634 / LIMIT_SUBSEQUENCE   (hash md5:3568c21ccbffc4f51bea5e897e50e5b3)
Theorem hlt_LIMIT_SUBSEQUENCE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall f :e A :^: omega, forall l :e A, forall r :e omega :^: omega, (forall m n :e omega, hl_lt m n = 1 -> hl_lt (r m) (r n) = 1) /\ hl_limit A omega top f l hl_sequentially = 1 -> hl_limit A omega top (hl_o omega A omega f r) l hl_sequentially = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:18648 / LIMIT_SUBTOPOLOGY   (hash md5:fff35006a8b372108eef1c5bfa0c7a2c)
Theorem hlt_LIMIT_SUBTOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall net1 :e hl_ty_net A, forall top :e hl_ty_topology B, forall s :e 2 :^: B, forall l :e B, forall f :e B :^: A, hl_limit B A (hl_subtopology B top s) f l net1 = 1 <-> hl_IN B l s = 1 /\ (hl_eventually A (fun a :e A => hl_IN B (f a) s) net1 = 1 /\ hl_limit B A top f l net1 = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:18662 / LIMIT_SEQUENTIALLY   (hash md5:5fb8652c1d42378a2167bf98bbb076b9)
Theorem hlt_LIMIT_SEQUENTIALLY : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e A :^: omega, forall l :e A, hl_limit A omega top s l hl_sequentially = 1 <-> hl_IN A l (hl_topspace A top) = 1 /\ forall u :e 2 :^: A, hl_open_in A top u = 1 /\ hl_IN A l u = 1 -> exists N :e omega, forall n :e omega, hl_le N n = 1 -> hl_IN A (s n) u = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:18669 / LIMIT_SEQUENTIALLY_OFFSET   (hash md5:08251f9801ddea6245d84178dfc27a60)
Theorem hlt_LIMIT_SEQUENTIALLY_OFFSET : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall f :e A :^: omega, forall l :e A, forall k :e omega, hl_limit A omega top f l hl_sequentially = 1 -> hl_limit A omega top (fun i :e omega => f (hl_add i k)) l hl_sequentially = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:18677 / LIMIT_SEQUENTIALLY_OFFSET_REV   (hash md5:bc648839fe21756827652a03d8b6beca)
Theorem hlt_LIMIT_SEQUENTIALLY_OFFSET_REV : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall f :e A :^: omega, forall l :e A, forall k :e omega, hl_limit A omega top (fun i :e omega => f (hl_add i k)) l hl_sequentially = 1 -> hl_limit A omega top f l hl_sequentially = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:18688 / LIMIT_ATPOINTOF   (hash md5:cf945934bd854d423a7b6e3b1d801966)
Theorem hlt_LIMIT_ATPOINTOF : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, forall x :e A, forall y :e B, hl_limit B A top' f y (hl_atpointof A top x) = 1 <-> hl_IN B y (hl_topspace B top') = 1 /\ (hl_IN A x (hl_topspace A top) = 1 -> forall v :e 2 :^: B, hl_open_in B top' v = 1 /\ hl_IN B y v = 1 -> exists u :e 2 :^: A, hl_open_in A top u = 1 /\ (hl_IN A x u = 1 /\ hl_SUBSET B (hl_IMAGE A B f (hl_DELETE A u x)) v = 1)).
Admitted.

// HOL Light: Multivariate/metric.ml:18701 / LIMIT_ATPOINTOF_SELF   (hash md5:41149b36bdd89c4a075e1c7b6a2fb9c5)
Theorem hlt_LIMIT_ATPOINTOF_SELF : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, forall f :e B :^: A, forall a :e A, hl_limit B A top2 f (f a) (hl_atpointof A top1 a) = 1 <-> hl_IN B (f a) (hl_topspace B top2) = 1 /\ (hl_IN A a (hl_topspace A top1) = 1 -> forall v :e 2 :^: B, hl_open_in B top2 v = 1 /\ hl_IN B (f a) v = 1 -> exists u :e 2 :^: A, hl_open_in A top1 u = 1 /\ (hl_IN A a u = 1 /\ hl_SUBSET B (hl_IMAGE A B f u) v = 1)).
Admitted.

// HOL Light: Multivariate/metric.ml:18710 / LIMIT_TRIVIAL   (hash md5:6244833b42b43b1d3044ee43753d30d3)
Theorem hlt_LIMIT_TRIVIAL : forall A B:set, A <> Empty -> B <> Empty -> forall net1 :e hl_ty_net A, forall f :e B :^: A, forall top :e hl_ty_topology B, forall y :e B, hl_trivial_limit A net1 = 1 /\ hl_IN B y (hl_topspace B top) = 1 -> hl_limit B A top f y net1 = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:18715 / LIMIT_TRANSFORM_EVENTUALLY   (hash md5:d0be9498f7d70cbef87f9190b01f4af1)
Theorem hlt_LIMIT_TRANSFORM_EVENTUALLY : forall A B:set, A <> Empty -> B <> Empty -> forall net1 :e hl_ty_net A, forall top :e hl_ty_topology B, forall f g :e B :^: A, forall l :e B, hl_eventually A (fun x :e A => if f x = g x then 1 else 0) net1 = 1 /\ hl_limit B A top f l net1 = 1 -> hl_limit B A top g l net1 = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:18729 / CONTINUOUS_MAP_LIMIT   (hash md5:58fe988251c2e4412ffe2a5a6a32843d)
Theorem hlt_CONTINUOUS_MAP_LIMIT : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall net1 :e hl_ty_net A, forall top :e hl_ty_topology B, forall top' :e hl_ty_topology C, forall f :e B :^: A, forall g :e C :^: B, forall l :e B, hl_continuous_map B C (hl_pair (hl_ty_topology B) (hl_ty_topology C) top top') g = 1 /\ hl_limit B A top f l net1 = 1 -> hl_limit C A top' (hl_o B C A g f) (g l) net1 = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:18742 / LIMIT_PAIRWISE   (hash md5:807739b6b1e4b584da3c123c655f357e)
Theorem hlt_LIMIT_PAIRWISE : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall net1 :e hl_ty_net C, forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, forall f :e (A :*: B) :^: C, forall l :e A :*: B, hl_limit (A :*: B) C (hl_prod_topology A B top1 top2) f l net1 = 1 <-> hl_limit A C top1 (hl_o (A :*: B) A C (hl_FST A B) f) (hl_FST A B l) net1 = 1 /\ hl_limit B C top2 (hl_o (A :*: B) B C (hl_SND A B) f) (hl_SND A B l) net1 = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:18773 / LIMIT_COMPONENTWISE   (hash md5:2e586d8e97eb6d55dd09e803435b6a58)
Theorem hlt_LIMIT_COMPONENTWISE : forall A C K:set, A <> Empty -> C <> Empty -> K <> Empty -> forall net1 :e hl_ty_net C, forall tops :e hl_ty_topology A :^: K, forall t :e 2 :^: K, forall f :e A :^: K :^: C, forall l :e A :^: K, hl_limit (A :^: K) C (hl_product_topology K A t tops) f l net1 = 1 <-> hl_EXTENSIONAL K A t l = 1 /\ (hl_eventually C (fun a :e C => hl_IN (A :^: K) (f a) (hl_topspace (A :^: K) (hl_product_topology K A t tops))) net1 = 1 /\ forall k :e K, hl_IN K k t = 1 -> hl_limit A C (tops k) (fun c :e C => f c k) (l k) net1 = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:18845 / COMPACT_IN_SEQUENCE_WITH_LIMIT   (hash md5:7820f34325bc34baac284c930c0d8cbb)
Theorem hlt_COMPACT_IN_SEQUENCE_WITH_LIMIT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, forall a :e A :^: omega, forall l :e A, hl_limit A omega top a l hl_sequentially = 1 /\ (hl_SUBSET A s (hl_IMAGE omega A a (hl_UNIV omega)) = 1 /\ hl_SUBSET A s (hl_topspace A top) = 1) -> hl_compact_in A top (hl_INSERT A l s) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:18877 / LIMIT_HAUSDORFF_UNIQUE   (hash md5:10ebda3ba961ff60d6ff53b7dc57cacf)
Theorem hlt_LIMIT_HAUSDORFF_UNIQUE : forall A B:set, A <> Empty -> B <> Empty -> forall net1 :e hl_ty_net A, forall top :e hl_ty_topology B, forall f :e B :^: A, forall l1 l2 :e B, ~ hl_trivial_limit A net1 = 1 /\ (hl_hausdorff_space B top = 1 /\ (hl_limit B A top f l1 net1 = 1 /\ hl_limit B A top f l2 net1 = 1)) -> l1 = l2.
Admitted.

// HOL Light: Multivariate/metric.ml:18896 / LIMIT_KC_UNIQUE   (hash md5:82a4bd67ec80c308638ef4ac94e678f9)
Theorem hlt_LIMIT_KC_UNIQUE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall f :e A :^: omega, forall l1 l2 :e A, hl_kc_space A top = 1 /\ (hl_limit A omega top f l1 hl_sequentially = 1 /\ hl_limit A omega top f l2 hl_sequentially = 1) -> l1 = l2.
