Theorem hlt_CONNECTED_IN_TOPSPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_connected_in A top (hl_topspace A top) = 1 <-> hl_connected_space A top = 1.
Admitted.

