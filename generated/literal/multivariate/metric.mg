// HOL Light: Multivariate/metric.ml:18201 / REAL_CLOSED_CONTAINS_SUP   (hash md5:1ed0cb7181db3381e9040a3368c86cca)
Theorem hlt_REAL_CLOSED_CONTAINS_SUP : forall s :e 2 :^: R, forall b :e R, hl_real_closed s = 1 /\ (~ s = hl_EMPTY R /\ (forall x :e R, hl_IN R x s = 1 -> hl_real_le x b = 1)) -> hl_IN R (hl_sup s) s = 1.
