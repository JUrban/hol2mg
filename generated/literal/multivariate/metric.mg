// HOL Light: Multivariate/metric.ml:739 / CLOSED_IN_SUBTOPOLOGY_UNION   (hash md5:be9f9d40e15ee2940ffeaf231a02b2f6)
Theorem hlt_CLOSED_IN_SUBTOPOLOGY_UNION : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t u :e 2 :^: A, hl_closed_in A (hl_subtopology A top t) s = 1 /\ hl_closed_in A (hl_subtopology A top u) s = 1 -> hl_closed_in A (hl_subtopology A top (hl_UNION A t u)) s = 1.
