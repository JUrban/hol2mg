// HOL Light: Multivariate/metric.ml:11664 / MDIST_POS_EQ   (hash md5:67ec83d31a6982ed5e863d195ecd10fa)
Theorem hlt_MDIST_POS_EQ : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall x y :e A, hl_IN A x (hl_mspace A m) = 1 /\ hl_IN A y (hl_mspace A m) = 1 -> (hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) (hl_mdist A m (hl_pair A A x y)) = 1 <-> ~ x = y).
Admitted.

// HOL Light: Multivariate/metric.ml:11670 / MDIST_REVERSE_TRIANGLE   (hash md5:e7b219e074622aa20ffb32936018b2a7)
Theorem hlt_MDIST_REVERSE_TRIANGLE : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall x y z :e A, hl_IN A x (hl_mspace A m) = 1 /\ (hl_IN A y (hl_mspace A m) = 1 /\ hl_IN A z (hl_mspace A m) = 1) -> hl_real_le (hl_real_abs (hl_real_sub (hl_mdist A m (hl_pair A A x y)) (hl_mdist A m (hl_pair A A y z)))) (hl_mdist A m (hl_pair A A x z)) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:11687 / mball   (hash md5:9b9f307003f6e45d111ed1c3c6e39a91)
Theorem hlt_mball_thm : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall x :e A, forall r :e R, hl_mball A m (hl_pair A R x r) = hl_GSPEC A (fun GEN_PVAR_1638 :e A => if exists y :e A, hl_SETSPEC A GEN_PVAR_1638 (if hl_IN A x (hl_mspace A m) = 1 /\ (hl_IN A y (hl_mspace A m) = 1 /\ hl_real_lt (hl_mdist A m (hl_pair A A x y)) r = 1) then 1 else 0) y = 1 then 1 else 0).
Admitted.

// HOL Light: Multivariate/metric.ml:11691 / IN_MBALL   (hash md5:c7dde3bd874efc23dac15b4588a484ae)
Theorem hlt_IN_MBALL : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall x y :e A, forall r :e R, hl_IN A y (hl_mball A m (hl_pair A R x r)) = 1 <-> hl_IN A x (hl_mspace A m) = 1 /\ (hl_IN A y (hl_mspace A m) = 1 /\ hl_real_lt (hl_mdist A m (hl_pair A A x y)) r = 1).
