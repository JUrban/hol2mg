// HOL Light: Multivariate/metric.ml:6080 / RETRACTION_MAPS_COMPOSE   (hash md5:6f3770b9b9b5d1252d325899b1e579e5)
Theorem hlt_RETRACTION_MAPS_COMPOSE : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, forall top3 :e hl_ty_topology C, forall f :e B :^: A, forall g :e C :^: B, forall f' :e A :^: B, forall g' :e B :^: C, hl_retraction_maps A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top1 top2) (hl_pair (B :^: A) (A :^: B) f f') = 1 /\ hl_retraction_maps B C (hl_pair (hl_ty_topology B) (hl_ty_topology C) top2 top3) (hl_pair (C :^: B) (B :^: C) g g') = 1 -> hl_retraction_maps A C (hl_pair (hl_ty_topology A) (hl_ty_topology C) top1 top3) (hl_pair (C :^: A) (A :^: C) (hl_o B C A g f) (hl_o B A C f' g')) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:6090 / RETRACTION_MAP_COMPOSE   (hash md5:a6ed359b1e1f374bfd2a36454b08684d)
Theorem hlt_RETRACTION_MAP_COMPOSE : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, forall top3 :e hl_ty_topology C, forall f :e B :^: A, forall g :e C :^: B, hl_retraction_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top1 top2) f = 1 /\ hl_retraction_map B C (hl_pair (hl_ty_topology B) (hl_ty_topology C) top2 top3) g = 1 -> hl_retraction_map A C (hl_pair (hl_ty_topology A) (hl_ty_topology C) top1 top3) (hl_o B C A g f) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:6097 / SECTION_MAP_COMPOSE   (hash md5:c539fcbab23c326cba27988f407b236f)
Theorem hlt_SECTION_MAP_COMPOSE : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, forall top3 :e hl_ty_topology C, forall f :e B :^: A, forall g :e C :^: B, hl_section_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top1 top2) f = 1 /\ hl_section_map B C (hl_pair (hl_ty_topology B) (hl_ty_topology C) top2 top3) g = 1 -> hl_section_map A C (hl_pair (hl_ty_topology A) (hl_ty_topology C) top1 top3) (hl_o B C A g f) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:6104 / SURJECTIVE_SECTION_EQ_HOMEOMORPHIC_MAP   (hash md5:4da8188e2658c03226bcd8b94e3b88a1)
Theorem hlt_SURJECTIVE_SECTION_EQ_HOMEOMORPHIC_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_section_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_IMAGE A B f (hl_topspace A top) = hl_topspace B top' <-> hl_homeomorphic_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:6111 / SURJECTIVE_RETRACTION_OR_SECTION_MAP   (hash md5:2343c003d46c6e97e26cfd6c0e0cbb45)
Theorem hlt_SURJECTIVE_RETRACTION_OR_SECTION_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_IMAGE A B f (hl_topspace A top) = hl_topspace B top' -> (hl_retraction_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 \/ hl_section_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 <-> hl_retraction_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:6119 / RETRACTION_IMP_SURJECTIVE_MAP   (hash md5:a38dc1d1d4d2286946803590ddc1b1f1)
Theorem hlt_RETRACTION_IMP_SURJECTIVE_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_retraction_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 -> hl_IMAGE A B f (hl_topspace A top) = hl_topspace B top'.
Admitted.

// HOL Light: Multivariate/metric.ml:6125 / SECTION_IMP_INJECTIVE_MAP   (hash md5:6137de208ab21ec43898b67d29a6657a)
Theorem hlt_SECTION_IMP_INJECTIVE_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_section_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 -> forall x y :e A, hl_IN A x (hl_topspace A top) = 1 /\ hl_IN A y (hl_topspace A top) = 1 -> (f x = f y <-> x = y).
Admitted.

// HOL Light: Multivariate/metric.ml:6132 / RETRACTION_MAPS_TO_RETRACT_MAPS   (hash md5:6c1bf2ae3abe3ff649b4958d67d54fc4)
Theorem hlt_RETRACTION_MAPS_TO_RETRACT_MAPS : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall r :e B :^: A, forall s :e A :^: B, hl_retraction_maps A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') (hl_pair (B :^: A) (A :^: B) r s) = 1 -> hl_retraction_maps A A (hl_pair (hl_ty_topology A) (hl_ty_topology A) top (hl_subtopology A top (hl_IMAGE B A s (hl_topspace B top')))) (hl_pair (A :^: A) (A :^: A) (hl_o B A A s r) (hl_I A)) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:6143 / EMBEDDING_EQ_SECTION_MAP   (hash md5:fa972486e17928f14aa2bdfff27a044f)
Theorem hlt_EMBEDDING_EQ_SECTION_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_embedding_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 <-> hl_section_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top (hl_subtopology B top' (hl_IMAGE A B f (hl_topspace A top)))) f = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:6152 / RETRACTION_MAP_INTO_SUBTOPOLOGY   (hash md5:796be8ef7ff9368346444255a1cb5b91)
Theorem hlt_RETRACTION_MAP_INTO_SUBTOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall t :e 2 :^: B, forall r :e B :^: A, hl_retraction_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') r = 1 /\ hl_SUBSET B (hl_IMAGE A B r (hl_topspace A top)) t = 1 -> hl_retraction_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top (hl_subtopology B top' t)) r = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:6161 / RETRACTION_MAPS_SUBTOPOLOGIES   (hash md5:16f108fa1c3670c9cc1946d2ed83e80b)
Theorem hlt_RETRACTION_MAPS_SUBTOPOLOGIES : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall s :e 2 :^: A, forall t :e 2 :^: B, forall r :e B :^: A, forall r' :e A :^: B, hl_retraction_maps A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') (hl_pair (B :^: A) (A :^: B) r r') = 1 /\ (hl_SUBSET B (hl_IMAGE A B r s) t = 1 /\ hl_SUBSET A (hl_IMAGE B A r' t) s = 1) -> hl_retraction_maps A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top s) (hl_subtopology B top' t)) (hl_pair (B :^: A) (A :^: B) r r') = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:6172 / RETRACTION_MAP_FST   (hash md5:1fa9527874582ee97cb3bbde9cfc558b)
Theorem hlt_RETRACTION_MAP_FST : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, hl_retraction_map (A :*: B) A (hl_pair (hl_ty_topology (A :*: B)) (hl_ty_topology A) (hl_prod_topology A B top1 top2) top1) (hl_FST A B) = 1 <-> hl_topspace B top2 = hl_EMPTY B -> hl_topspace A top1 = hl_EMPTY A.
Admitted.

// HOL Light: Multivariate/metric.ml:6190 / RETRACTION_MAP_SND   (hash md5:63de5bcf6635c263ab28ad235c25af1e)
Theorem hlt_RETRACTION_MAP_SND : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, hl_retraction_map (A :*: B) B (hl_pair (hl_ty_topology (A :*: B)) (hl_ty_topology B) (hl_prod_topology A B top1 top2) top2) (hl_SND A B) = 1 <-> hl_topspace A top1 = hl_EMPTY A -> hl_topspace B top2 = hl_EMPTY B.
Admitted.

// HOL Light: Multivariate/metric.ml:6208 / RETRACTION_MAP_PRODUCT_PROJECTION   (hash md5:da2f27e2cfeecbf30a3949b4f3ac55ba)
Theorem hlt_RETRACTION_MAP_PRODUCT_PROJECTION : forall A K:set, A <> Empty -> K <> Empty -> forall k :e 2 :^: K, forall tops :e hl_ty_topology A :^: K, forall i :e K, hl_IN K i k = 1 -> (hl_retraction_map (A :^: K) A (hl_pair (hl_ty_topology (A :^: K)) (hl_ty_topology A) (hl_product_topology K A k tops) (tops i)) (fun x :e A :^: K => x i) = 1 <-> hl_topspace (A :^: K) (hl_product_topology K A k tops) = hl_EMPTY (A :^: K) -> hl_topspace A (tops i) = hl_EMPTY A).
Admitted.

// HOL Light: Multivariate/metric.ml:6234 / DISCRETE_SPACE_RETRACTION_MAP_IMAGE   (hash md5:1df94d9ebeedffc459c6569d390ce794)
Theorem hlt_DISCRETE_SPACE_RETRACTION_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall r :e B :^: A, hl_retraction_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') r = 1 /\ hl_discrete_space A top = 1 -> hl_discrete_space B top' = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:6240 / HOMEOMORPHIC_DISCRETE_SPACE   (hash md5:adc87dd6e44dc8e09ba0a7a031cc06ee)
Theorem hlt_HOMEOMORPHIC_DISCRETE_SPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_homeomorphic_space A B top top' = 1 -> (hl_discrete_space A top = 1 <-> hl_discrete_space B top' = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:6248 / HOMEOMORPHIC_DISCRETE_SPACES   (hash md5:6b2d96ebf1ab9370b36ccd7050ceaf68)
Theorem hlt_HOMEOMORPHIC_DISCRETE_SPACES : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_discrete_space A top = 1 /\ hl_discrete_space B top' = 1 -> (hl_homeomorphic_space A B top top' = 1 <-> hl_sym_3d5f63 A B (hl_topspace A top) (hl_topspace B top') = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:6265 / retract_of_space   (hash md5:cf02de8ba548bb029379dc2d381a5f87)
Theorem hlt_retract_of_space_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_retract_of_space A s top = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1 /\ exists r :e A :^: A, hl_continuous_map A A (hl_pair (hl_ty_topology A) (hl_ty_topology A) top (hl_subtopology A top s)) r = 1 /\ forall x :e A, hl_IN A x s = 1 -> r x = x.
Admitted.

// HOL Light: Multivariate/metric.ml:6271 / RETRACT_OF_SPACE_RETRACTION_MAPS   (hash md5:064e7f441e0e843006f133c1c2b15054)
Theorem hlt_RETRACT_OF_SPACE_RETRACTION_MAPS : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_retract_of_space A s top = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1 /\ exists r :e A :^: A, hl_retraction_maps A A (hl_pair (hl_ty_topology A) (hl_ty_topology A) top (hl_subtopology A top s)) (hl_pair (A :^: A) (A :^: A) r (hl_I A)) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:6280 / RETRACT_OF_SPACE_SECTION_MAP   (hash md5:09b8c9c27e26f1a6f20000b5fd205908)
Theorem hlt_RETRACT_OF_SPACE_SECTION_MAP : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_retract_of_space A s top = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1 /\ hl_section_map A A (hl_pair (hl_ty_topology A) (hl_ty_topology A) (hl_subtopology A top s) top) (fun x :e A => x) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:6288 / RETRACT_OF_SPACE_IMP_SUBSET   (hash md5:870e7be5fe84f0babb29d1c7e7a27f31)
Theorem hlt_RETRACT_OF_SPACE_IMP_SUBSET : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_retract_of_space A s top = 1 -> hl_SUBSET A s (hl_topspace A top) = 1.
Admitted.

