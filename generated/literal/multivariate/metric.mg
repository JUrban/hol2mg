// HOL Light: Multivariate/metric.ml:26965 / QUASI_EQ_CONNECTED_COMPONENTS_OF   (hash md5:b560e4e0223038d99388a41d5848907b)
Theorem hlt_QUASI_EQ_CONNECTED_COMPONENTS_OF : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_FINITE (2 :^: A) (hl_connected_components_of A top) = 1 \/ (hl_FINITE (2 :^: A) (hl_quasi_components_of A top) = 1 \/ (hl_locally_connected_space A top = 1 \/ hl_compact_space A top = 1 /\ (hl_hausdorff_space A top = 1 \/ (hl_regular_space A top = 1 \/ hl_normal_space A top = 1)))) -> hl_quasi_components_of A top = hl_connected_components_of A top.
Admitted.

