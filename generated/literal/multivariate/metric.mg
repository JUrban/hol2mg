Theorem hlt_HOMEOMORPHIC_MAPS_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, forall g :e A :^: B, hl_homeomorphic_maps A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') (hl_pair (B :^: A) (A :^: B) f g) = 1 <-> hl_homeomorphic_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (hl_homeomorphic_map B A (hl_pair (hl_ty_topology B) (hl_ty_topology A) top' top) g = 1 /\ ((forall x :e A, hl_IN A x (hl_topspace A top) = 1 -> g (f x) = x) /\ forall y :e B, hl_IN B y (hl_topspace B top') = 1 -> f (g y) = y)).
