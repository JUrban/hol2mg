// HOL Light: Multivariate/metric.ml:3659 / prod_topology   (hash md5:a1e771f5df91b978f5b2e5cb1ad14f4b)
Theorem hlt_prod_topology_thm : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, hl_prod_topology A B top1 top2 = hl_topology (A :*: B) (hl_UNION_OF (A :*: B) (hl_ARBITRARY (A :*: B)) (hl_GSPEC (2 :^: (A :*: B)) (fun GEN_PVAR_1385 :e 2 :^: (A :*: B) => if exists s :e 2 :^: A, exists t :e 2 :^: B, hl_SETSPEC (2 :^: (A :*: B)) GEN_PVAR_1385 (if hl_open_in A top1 s = 1 /\ hl_open_in B top2 t = 1 then 1 else 0) (hl_CROSS A B s t) = 1 then 1 else 0))).
Admitted.

// HOL Light: Multivariate/metric.ml:3664 / OPEN_IN_PROD_TOPOLOGY   (hash md5:8b99679941b04ecd6b6cbce1cf34fb3f)
Theorem hlt_OPEN_IN_PROD_TOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, hl_open_in (A :*: B) (hl_prod_topology A B top1 top2) = hl_UNION_OF (A :*: B) (hl_ARBITRARY (A :*: B)) (hl_GSPEC (2 :^: (A :*: B)) (fun GEN_PVAR_1386 :e 2 :^: (A :*: B) => if exists s :e 2 :^: A, exists t :e 2 :^: B, hl_SETSPEC (2 :^: (A :*: B)) GEN_PVAR_1386 (if hl_open_in A top1 s = 1 /\ hl_open_in B top2 t = 1 then 1 else 0) (hl_CROSS A B s t) = 1 then 1 else 0)).
Admitted.

// HOL Light: Multivariate/metric.ml:3678 / TOPSPACE_PROD_TOPOLOGY   (hash md5:bd772c3b0f5e2eac3a92679e44e875ca)
Theorem hlt_TOPSPACE_PROD_TOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, hl_topspace (A :*: B) (hl_prod_topology A B top1 top2) = hl_CROSS A B (hl_topspace A top1) (hl_topspace B top2).
Admitted.

// HOL Light: Multivariate/metric.ml:3700 / SUBTOPOLOGY_CROSS   (hash md5:71c0917f0283af818a2d9cd78f6f8c66)
Theorem hlt_SUBTOPOLOGY_CROSS : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, forall s :e 2 :^: A, forall t :e 2 :^: B, hl_subtopology (A :*: B) (hl_prod_topology A B top1 top2) (hl_CROSS A B s t) = hl_prod_topology A B (hl_subtopology A top1 s) (hl_subtopology B top2 t).
Admitted.

// HOL Light: Multivariate/metric.ml:3714 / PROD_TOPOLOGY_SUBTOPOLOGY   (hash md5:0a8094517df45e8271a059b61bd716e7)
Theorem hlt_PROD_TOPOLOGY_SUBTOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> (forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall s :e 2 :^: A, hl_prod_topology A B (hl_subtopology A top s) top' = hl_subtopology (A :*: B) (hl_prod_topology A B top top') (hl_CROSS A B s (hl_topspace B top'))) /\ forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall t :e 2 :^: B, hl_prod_topology A B top (hl_subtopology B top' t) = hl_subtopology (A :*: B) (hl_prod_topology A B top top') (hl_CROSS A B (hl_topspace A top) t).
Admitted.

// HOL Light: Multivariate/metric.ml:3723 / PROD_TOPOLOGY_DISCRETE_TOPOLOGY   (hash md5:4a1d83c1462d81e2e4c7e2c7681373ac)
Theorem hlt_PROD_TOPOLOGY_DISCRETE_TOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall s :e 2 :^: A, forall t :e 2 :^: B, hl_prod_topology A B (hl_discrete_topology A s) (hl_discrete_topology B t) = hl_discrete_topology (A :*: B) (hl_CROSS A B s t).
