Theorem hlt_CONNECTED_COMPONENTS_OF_EQ_SING : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_connected_components_of A top = hl_INSERT (2 :^: A) s (hl_EMPTY (2 :^: A)) <-> hl_connected_space A top = 1 /\ (~ hl_topspace A top = hl_EMPTY A /\ s = hl_topspace A top).
Admitted.

// HOL Light: Multivariate/metric.ml:14746 / CONNECTED_COMPONENTS_OF_CONNECTED_SPACE   (hash md5:0ee7c8b933fed0e9e6672ad05d454e04)
Theorem hlt_CONNECTED_COMPONENTS_OF_CONNECTED_SPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_connected_space A top = 1 -> hl_connected_components_of A top = hl_COND (2 :^: (2 :^: A)) (if hl_topspace A top = hl_EMPTY A then 1 else 0) (hl_EMPTY (2 :^: A)) (hl_INSERT (2 :^: A) (hl_topspace A top) (hl_EMPTY (2 :^: A))).
