Theorem hlt_CONNECTED_IN_CLOSURE_OF : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_connected_in A top s = 1 -> hl_connected_in A top (hl_closure_of A top s) = 1.
