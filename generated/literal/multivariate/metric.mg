// HOL Light: Multivariate/metric.ml:24211 / NORMAL_SPACE_EQ_URYSOHN   (hash md5:3c1dd3dd9f23cfae1c9906af38a2af52)
Theorem hlt_NORMAL_SPACE_EQ_URYSOHN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_normal_space A top = 1 <-> forall s t :e 2 :^: A, hl_closed_in A top s = 1 /\ (hl_closed_in A top t = 1 /\ hl_DISJOINT A s t = 1) -> exists f :e R :^: A, hl_continuous_map A R (hl_pair (hl_ty_topology A) (hl_ty_topology R) top (hl_subtopology R hl_euclideanreal (hl_closed_real_interval (hl_CONS (R :*: R) (hl_pair R R (hl_real_of_num (hl_NUMERAL hl_zero)) (hl_real_of_num (hl_NUMERAL (hl_BIT1 hl_zero)))) (hl_NIL (R :*: R)))))) f = 1 /\ ((forall x :e A, hl_IN A x s = 1 -> f x = hl_real_of_num (hl_NUMERAL hl_zero)) /\ forall x :e A, hl_IN A x t = 1 -> f x = hl_real_of_num (hl_NUMERAL (hl_BIT1 hl_zero))).
