// HOL Light: Multivariate/metric.ml:11711 / MBALL_EMPTY   (hash md5:30ffe49f7fae8af0bb6b212f89ad78a6)
Theorem hlt_MBALL_EMPTY : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall x :e A, forall r :e R, hl_real_le r (hl_real_of_num (hl_NUMERAL hl_zero)) = 1 -> hl_mball A m (hl_pair A R x r) = hl_EMPTY A.
