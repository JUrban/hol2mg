Admitted.

// HOL Light: Multivariate/metric.ml:18297 / IS_REALINTERVAL_INTERIOR_OF   (hash md5:c52d2f64071c2b69abc39769f3194609)
Theorem hlt_IS_REALINTERVAL_INTERIOR_OF : forall s :e 2 :^: R, hl_is_realinterval s = 1 -> hl_is_realinterval (hl_interior_of R hl_euclideanreal s) = 1.
