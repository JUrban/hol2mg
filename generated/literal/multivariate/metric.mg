Theorem hlt_DERIVED_SET_OF_UNION : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_derived_set_of A top (hl_UNION A s t) = hl_UNION A (hl_derived_set_of A top s) (hl_derived_set_of A top t).
