// HOL Light: Multivariate/metric.ml:13151 / CONNECTED_SPACE_EQ_FRONTIER_EQ_EMPTY   (hash md5:a46120bf654f3592729cccf60fc1f1bf)
Theorem hlt_CONNECTED_SPACE_EQ_FRONTIER_EQ_EMPTY : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_connected_space A top = 1 <-> forall s :e 2 :^: A, hl_SUBSET A s (hl_topspace A top) = 1 /\ hl_frontier_of A top s = hl_EMPTY A -> s = hl_EMPTY A \/ s = hl_topspace A top.
Admitted.

// HOL Light: Multivariate/metric.ml:13159 / CONNECTED_SPACE_FRONTIER_EQ_EMPTY   (hash md5:07aa864fa8e66319c219249d5865fe1b)
Theorem hlt_CONNECTED_SPACE_FRONTIER_EQ_EMPTY : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_connected_space A top = 1 /\ hl_SUBSET A s (hl_topspace A top) = 1 -> (hl_frontier_of A top s = hl_EMPTY A <-> s = hl_EMPTY A \/ s = hl_topspace A top).
Admitted.

// HOL Light: Multivariate/metric.ml:13166 / CONNECTED_IN   (hash md5:95b2e6dfb80576c8fd2b51a2da5fddc2)
Theorem hlt_CONNECTED_IN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_connected_in A top s = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1 /\ ~ exists e1 e2 :e 2 :^: A, hl_open_in A top e1 = 1 /\ (hl_open_in A top e2 = 1 /\ (hl_SUBSET A s (hl_UNION A e1 e2) = 1 /\ (hl_INTER A e1 (hl_INTER A e2 s) = hl_EMPTY A /\ (~ hl_INTER A e1 s = hl_EMPTY A /\ ~ hl_INTER A e2 s = hl_EMPTY A)))).
Admitted.

// HOL Light: Multivariate/metric.ml:13186 / CONNECTED_IN_CLOSED_IN   (hash md5:e378b2e2cafa400d449aa31a422bb26b)
Theorem hlt_CONNECTED_IN_CLOSED_IN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_connected_in A top s = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1 /\ ~ exists e1 e2 :e 2 :^: A, hl_closed_in A top e1 = 1 /\ (hl_closed_in A top e2 = 1 /\ (hl_SUBSET A s (hl_UNION A e1 e2) = 1 /\ (hl_INTER A e1 (hl_INTER A e2 s) = hl_EMPTY A /\ (~ hl_INTER A e1 s = hl_EMPTY A /\ ~ hl_INTER A e2 s = hl_EMPTY A)))).
Admitted.

