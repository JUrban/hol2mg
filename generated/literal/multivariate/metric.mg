Admitted.

// HOL Light: Multivariate/metric.ml:6815 / COMPACT_SPACE_IMP_BOLZANO_WEIERSTRASS   (hash md5:9d7aa0df6f8b9b2969a61cc6c268ec29)
Theorem hlt_COMPACT_SPACE_IMP_BOLZANO_WEIERSTRASS : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_compact_space A top = 1 /\ (hl_INFINITE A s = 1 /\ hl_SUBSET A s (hl_topspace A top) = 1) -> ~ hl_derived_set_of A top s = hl_EMPTY A.
