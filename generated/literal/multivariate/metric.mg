Theorem hlt_PROPER_MAP_FROM_COMPOSITION_RIGHT_INJ : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall top'' :e hl_ty_topology C, forall f :e B :^: A, forall g :e C :^: B, hl_proper_map A C (hl_pair (hl_ty_topology A) (hl_ty_topology C) top top'') (hl_o B C A g f) = 1 /\ (hl_SUBSET B (hl_IMAGE A B f (hl_topspace A top)) (hl_topspace B top') = 1 /\ (hl_continuous_map B C (hl_pair (hl_ty_topology B) (hl_ty_topology C) top' top'') g = 1 /\ (forall x y :e B, hl_IN B x (hl_topspace B top') = 1 /\ (hl_IN B y (hl_topspace B top') = 1 /\ g x = g y) -> x = y))) -> hl_proper_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:9492 / PROPER_MAP_PROD   (hash md5:99210db120622c19b88d505df98c4479)
Theorem hlt_PROPER_MAP_PROD : forall A B C D:set, A <> Empty -> B <> Empty -> C <> Empty -> D <> Empty -> forall top1 :e hl_ty_topology A, forall top1' :e hl_ty_topology C, forall top2 :e hl_ty_topology B, forall top2' :e hl_ty_topology D, forall f :e C :^: A, forall g :e D :^: B, hl_proper_map (A :*: B) (C :*: D) (hl_pair (hl_ty_topology (A :*: B)) (hl_ty_topology (C :*: D)) (hl_prod_topology A B top1 top2) (hl_prod_topology C D top1' top2')) (hl_GABS ((C :*: D) :^: (A :*: B)) (fun f1 :e (C :*: D) :^: (A :*: B) => if forall x :e A, forall y :e B, hl_GEQ (C :*: D) (f1 (hl_pair A B x y)) (hl_pair C D (f x) (g y)) = 1 then 1 else 0)) = 1 <-> hl_topspace (A :*: B) (hl_prod_topology A B top1 top2) = hl_EMPTY (A :*: B) \/ hl_proper_map A C (hl_pair (hl_ty_topology A) (hl_ty_topology C) top1 top1') f = 1 /\ hl_proper_map B D (hl_pair (hl_ty_topology B) (hl_ty_topology D) top2 top2') g = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:9594 / PROPER_MAP_PAIRED   (hash md5:af447d2e904c1b3f6d0abfb00bb30abd)
Theorem hlt_PROPER_MAP_PAIRED : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e hl_ty_topology A, forall top1 :e hl_ty_topology B, forall top2 :e hl_ty_topology C, forall f :e B :^: A, forall g :e C :^: A, hl_hausdorff_space A top = 1 /\ (hl_proper_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top1) f = 1 /\ hl_proper_map A C (hl_pair (hl_ty_topology A) (hl_ty_topology C) top top2) g = 1) \/ (hl_hausdorff_space B top1 = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top1) f = 1 /\ hl_proper_map A C (hl_pair (hl_ty_topology A) (hl_ty_topology C) top top2) g = 1) \/ hl_hausdorff_space C top2 = 1 /\ (hl_proper_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top1) f = 1 /\ hl_continuous_map A C (hl_pair (hl_ty_topology A) (hl_ty_topology C) top top2) g = 1)) -> hl_proper_map A (B :*: C) (hl_pair (hl_ty_topology A) (hl_ty_topology (B :*: C)) top (hl_prod_topology B C top1 top2)) (fun x :e A => hl_pair B C (f x) (g x)) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:9625 / PROPER_MAP_PAIRWISE   (hash md5:76c2ae790d6afe15898858086e39081c)
Theorem hlt_PROPER_MAP_PAIRWISE : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e hl_ty_topology A, forall top1 :e hl_ty_topology B, forall top2 :e hl_ty_topology C, forall f :e (B :*: C) :^: A, hl_hausdorff_space A top = 1 /\ (hl_proper_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top1) (hl_o (B :*: C) B A (hl_FST B C) f) = 1 /\ hl_proper_map A C (hl_pair (hl_ty_topology A) (hl_ty_topology C) top top2) (hl_o (B :*: C) C A (hl_SND B C) f) = 1) \/ (hl_hausdorff_space B top1 = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top1) (hl_o (B :*: C) B A (hl_FST B C) f) = 1 /\ hl_proper_map A C (hl_pair (hl_ty_topology A) (hl_ty_topology C) top top2) (hl_o (B :*: C) C A (hl_SND B C) f) = 1) \/ hl_hausdorff_space C top2 = 1 /\ (hl_proper_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top1) (hl_o (B :*: C) B A (hl_FST B C) f) = 1 /\ hl_continuous_map A C (hl_pair (hl_ty_topology A) (hl_ty_topology C) top top2) (hl_o (B :*: C) C A (hl_SND B C) f) = 1)) -> hl_proper_map A (B :*: C) (hl_pair (hl_ty_topology A) (hl_ty_topology (B :*: C)) top (hl_prod_topology B C top1 top2)) f = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:9637 / PROPER_MAP_FROM_COMPOSITION_RIGHT   (hash md5:38872ca22564c3e41ae149453c25f9a3)
Theorem hlt_PROPER_MAP_FROM_COMPOSITION_RIGHT : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall top'' :e hl_ty_topology C, forall f :e B :^: A, forall g :e C :^: B, hl_hausdorff_space B top' = 1 /\ (hl_proper_map A C (hl_pair (hl_ty_topology A) (hl_ty_topology C) top top'') (hl_o B C A g f) = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_continuous_map B C (hl_pair (hl_ty_topology B) (hl_ty_topology C) top' top'') g = 1)) -> hl_proper_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1.
