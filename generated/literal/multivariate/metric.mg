// HOL Light: Multivariate/metric.ml:12635 / discrete_metric   (hash md5:bdc416d8208757b37ca3b03ab68a6703)
Theorem hlt_discrete_metric_thm : forall A:set, A <> Empty -> forall s :e 2 :^: A, hl_discrete_metric A s = hl_metric A (hl_pair (2 :^: A) (R :^: (A :*: A)) s (hl_GABS (R :^: (A :*: A)) (fun f :e R :^: (A :*: A) => if forall x y :e A, hl_GEQ R (f (hl_pair A A x y)) (hl_COND R (if x = y then 1 else 0) (hl_real_of_num (hl_NUMERAL hl_zero)) (hl_real_of_num (hl_NUMERAL (hl_BIT1 hl_zero)))) = 1 then 1 else 0))).
Admitted.

// HOL Light: Multivariate/metric.ml:12638 / DISCRETE_METRIC   (hash md5:9ace00113208c399e73d8c348598b5f4)
Theorem hlt_DISCRETE_METRIC : forall A:set, A <> Empty -> (forall s :e 2 :^: A, hl_mspace A (hl_discrete_metric A s) = s) /\ forall s :e 2 :^: A, forall x y :e A, hl_mdist A (hl_discrete_metric A s) (hl_pair A A x y) = hl_COND R (if x = y then 1 else 0) (hl_real_of_num (hl_NUMERAL hl_zero)) (hl_real_of_num (hl_NUMERAL (hl_BIT1 hl_zero))).
Admitted.

