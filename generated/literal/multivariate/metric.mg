// HOL Light: Multivariate/metric.ml:1228 / DERIVED_SET_SUBSET   (hash md5:6859d7bc7e162c22ab1ea0e759a2ec78)
Theorem hlt_DERIVED_SET_SUBSET : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_SUBSET A s (hl_topspace A top) = 1 -> (hl_SUBSET A (hl_derived_set_of A top s) s = 1 <-> hl_closed_in A top s = 1).
