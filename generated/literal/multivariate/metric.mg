// HOL Light: Multivariate/metric.ml:19195 / EVENTUALLY_ATPOINTOF_SEQUENTIALLY   (hash md5:8586e9d4ad02b533c785f972d132c103)
Theorem hlt_EVENTUALLY_ATPOINTOF_SEQUENTIALLY : forall A:set, A <> Empty -> forall met :e hl_ty_metric A, forall P :e 2 :^: A, forall a :e A, hl_eventually A P (hl_atpointof A (hl_mtopology A met) a) = 1 <-> forall x :e A :^: omega, (forall n :e omega, hl_IN A (x n) (hl_DELETE A (hl_mspace A met) a) = 1) /\ hl_limit A omega (hl_mtopology A met) x a hl_sequentially = 1 -> hl_eventually omega (fun n :e omega => P (x n)) hl_sequentially = 1.
