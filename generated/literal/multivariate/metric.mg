Theorem hlt_DERIVED_SET_OF_TOPSPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_derived_set_of A top (hl_topspace A top) = hl_GSPEC A (fun GEN_PVAR_1248 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_1248 (if hl_IN A x (hl_topspace A top) = 1 /\ ~ hl_open_in A top (hl_INSERT A x (hl_EMPTY A)) = 1 then 1 else 0) x = 1 then 1 else 0).
Admitted.

// HOL Light: Multivariate/metric.ml:1027 / DISCRETE_TOPOLOGY_UNIQUE_DERIVED_SET   (hash md5:3141c235b849417a6006fe8a6b55dcfb)
Theorem hlt_DISCRETE_TOPOLOGY_UNIQUE_DERIVED_SET : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall u :e 2 :^: A, hl_discrete_topology A u = top <-> hl_topspace A top = u /\ hl_derived_set_of A top u = hl_EMPTY A.
