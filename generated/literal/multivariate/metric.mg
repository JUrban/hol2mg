Theorem hlt_connected_space_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_connected_space A top = 1 <-> ~ exists e1 e2 :e 2 :^: A, hl_open_in A top e1 = 1 /\ (hl_open_in A top e2 = 1 /\ (hl_SUBSET A (hl_topspace A top) (hl_UNION A e1 e2) = 1 /\ (hl_INTER A e1 e2 = hl_EMPTY A /\ (~ e1 = hl_EMPTY A /\ ~ e2 = hl_EMPTY A)))).
Admitted.

// HOL Light: Multivariate/metric.ml:13073 / connected_in   (hash md5:42c2a8575f64260866305f7725d90c5b)
Theorem hlt_connected_in_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_connected_in A top s = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1 /\ hl_connected_space A (hl_subtopology A top s) = 1.
Admitted.

