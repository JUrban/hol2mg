Theorem hlt_locally_path_connected_space_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_locally_path_connected_space A top = 1 <-> hl_neighbourhood_base_of A (hl_path_connected_in A top) top = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:25224 / LOCALLY_PATH_CONNECTED_SPACE   (hash md5:d233a31369e4b29b270e46f883551104)
Theorem hlt_LOCALLY_PATH_CONNECTED_SPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_locally_path_connected_space A top = 1 <-> forall v :e 2 :^: A, forall x :e A, hl_open_in A top v = 1 /\ hl_IN A x v = 1 -> exists u :e 2 :^: A, hl_open_in A top u = 1 /\ (hl_path_connected_in A top u = 1 /\ (hl_IN A x u = 1 /\ hl_SUBSET A u v = 1)).
Admitted.

// HOL Light: Multivariate/metric.ml:25234 / LOCALLY_PATH_CONNECTED_SPACE_OPEN_PATH_COMPONENTS   (hash md5:7a5cbe7dc0e5185ff40d9914c54e10af)
Theorem hlt_LOCALLY_PATH_CONNECTED_SPACE_OPEN_PATH_COMPONENTS : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_locally_path_connected_space A top = 1 <-> forall u c :e 2 :^: A, hl_open_in A top u = 1 /\ hl_IN (2 :^: A) c (hl_path_components_of A (hl_subtopology A top u)) = 1 -> hl_open_in A top c = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:25244 / OPEN_IN_PATH_COMPONENT_OF_LOCALLY_PATH_CONNECTED_SPACE   (hash md5:bbce26561ab8939c79d876800e8e3436)
