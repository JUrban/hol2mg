Theorem hlt_topcontinuous_at_thm : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, forall x :e A, hl_topcontinuous_at A B top top' f x = 1 <-> hl_IN A x (hl_topspace A top) = 1 /\ ((forall x1 :e A, hl_IN A x1 (hl_topspace A top) = 1 -> hl_IN B (f x1) (hl_topspace B top') = 1) /\ forall v :e 2 :^: B, hl_open_in B top' v = 1 /\ hl_IN B (f x) v = 1 -> exists u :e 2 :^: A, hl_open_in A top u = 1 /\ (hl_IN A x u = 1 /\ forall y :e A, hl_IN A y u = 1 -> hl_IN B (f y) v = 1)).
