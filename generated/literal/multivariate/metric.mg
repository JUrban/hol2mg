Theorem hlt_QUOTIENT_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_quotient_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 <-> hl_IMAGE A B f (hl_topspace A top) = hl_topspace B top' /\ forall u :e 2 :^: B, hl_SUBSET B u (hl_topspace B top') = 1 -> (hl_closed_in A top (hl_GSPEC A (fun GEN_PVAR_1376 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_1376 (if hl_IN A x (hl_topspace A top) = 1 /\ hl_IN B (f x) u = 1 then 1 else 0) x = 1 then 1 else 0)) = 1 <-> hl_closed_in B top' u = 1).
