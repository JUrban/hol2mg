// HOL Light: Multivariate/metric.ml:18939 / LIMIT_METRIC_UNIQUE   (hash md5:cf09f18a47d3ca36ef4dc4c61cc4372d)
Theorem hlt_LIMIT_METRIC_UNIQUE : forall A B:set, A <> Empty -> B <> Empty -> forall net1 :e hl_ty_net A, forall m :e hl_ty_metric B, forall f :e B :^: A, forall l1 l2 :e B, ~ hl_trivial_limit A net1 = 1 /\ (hl_limit B A (hl_mtopology B m) f l1 net1 = 1 /\ hl_limit B A (hl_mtopology B m) f l2 net1 = 1) -> l1 = l2.
Admitted.

// HOL Light: Multivariate/metric.ml:18947 / LIMIT_METRIC   (hash md5:a553ef4c112eccfd64858fd49177b2af)
Theorem hlt_LIMIT_METRIC : forall A B:set, A <> Empty -> B <> Empty -> forall m :e hl_ty_metric B, forall f :e B :^: A, forall l :e B, forall net1 :e hl_ty_net A, hl_limit B A (hl_mtopology B m) f l net1 = 1 <-> hl_IN B l (hl_mspace B m) = 1 /\ forall e1 :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) e1 = 1 -> hl_eventually A (fun x :e A => if hl_IN B (f x) (hl_mspace B m) = 1 /\ hl_real_lt (hl_mdist B m (hl_pair B B (f x) l)) e1 = 1 then 1 else 0) net1 = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:18979 / LIMIT_METRIC_SEQUENTIALLY   (hash md5:a9effc2b79b0ff761e5443e375f2cb4b)
Theorem hlt_LIMIT_METRIC_SEQUENTIALLY : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall f :e A :^: omega, forall l :e A, hl_limit A omega (hl_mtopology A m) f l hl_sequentially = 1 <-> hl_IN A l (hl_mspace A m) = 1 /\ forall e1 :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) e1 = 1 -> exists N :e omega, forall n :e omega, hl_le N n = 1 -> hl_IN A (f n) (hl_mspace A m) = 1 /\ hl_real_lt (hl_mdist A m (hl_pair A A (f n) l)) e1 = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:18988 / LIMIT_IN_CLOSED_IN   (hash md5:e96f9b1d9db8cc0f510d5be78d0d7cb2)
Theorem hlt_LIMIT_IN_CLOSED_IN : forall A B:set, A <> Empty -> B <> Empty -> forall net1 :e hl_ty_net A, forall top :e hl_ty_topology B, forall s :e 2 :^: B, forall f :e B :^: A, forall l :e B, ~ hl_trivial_limit A net1 = 1 /\ (hl_limit B A top f l net1 = 1 /\ (hl_closed_in B top s = 1 /\ hl_eventually A (fun x :e A => hl_IN B (f x) s) net1 = 1)) -> hl_IN B l s = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:19002 / LIMIT_SUBMETRIC_IFF   (hash md5:9c75fdb5fe6757ca364db224e01493b4)
Theorem hlt_LIMIT_SUBMETRIC_IFF : forall A B:set, A <> Empty -> B <> Empty -> forall net1 :e hl_ty_net A, forall m :e hl_ty_metric B, forall s :e 2 :^: B, forall f :e B :^: A, forall l :e B, hl_limit B A (hl_mtopology B (hl_submetric B m s)) f l net1 = 1 <-> hl_IN B l s = 1 /\ (hl_eventually A (fun x :e A => hl_IN B (f x) s) net1 = 1 /\ hl_limit B A (hl_mtopology B m) f l net1 = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:19011 / METRIC_CLOSED_IN_IFF_SEQUENTIALLY_CLOSED   (hash md5:112d651f5773c12c6e11a42e8520421c)
Theorem hlt_METRIC_CLOSED_IN_IFF_SEQUENTIALLY_CLOSED : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall s :e 2 :^: A, hl_closed_in A (hl_mtopology A m) s = 1 <-> hl_SUBSET A s (hl_mspace A m) = 1 /\ forall a :e A :^: omega, forall l :e A, (forall n :e omega, hl_IN A (a n) s = 1) /\ hl_limit A omega (hl_mtopology A m) a l hl_sequentially = 1 -> hl_IN A l s = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:19050 / LIMIT_ATPOINTOF_METRIC   (hash md5:65cd0184fc956d158096fd65f335d982)
Theorem hlt_LIMIT_ATPOINTOF_METRIC : forall A B:set, A <> Empty -> B <> Empty -> forall m :e hl_ty_metric A, forall top :e hl_ty_topology B, forall f :e B :^: A, forall x :e A, forall y :e B, hl_limit B A top f y (hl_atpointof A (hl_mtopology A m) x) = 1 <-> hl_IN B y (hl_topspace B top) = 1 /\ (hl_IN A x (hl_mspace A m) = 1 -> forall v :e 2 :^: B, hl_open_in B top v = 1 /\ hl_IN B y v = 1 -> exists d :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) d = 1 /\ forall x' :e A, hl_IN A x' (hl_mspace A m) = 1 /\ (hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) (hl_mdist A m (hl_pair A A x' x)) = 1 /\ hl_real_lt (hl_mdist A m (hl_pair A A x' x)) d = 1) -> hl_IN B (f x') v = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:19063 / LIMIT_METRIC_DIST_NULL   (hash md5:8f596871a756875091cb0639eaaf1032)
Theorem hlt_LIMIT_METRIC_DIST_NULL : forall A K:set, A <> Empty -> K <> Empty -> forall net1 :e hl_ty_net K, forall m :e hl_ty_metric A, forall f :e A :^: K, forall l :e A, hl_limit A K (hl_mtopology A m) f l net1 = 1 <-> hl_IN A l (hl_mspace A m) = 1 /\ (hl_eventually K (fun x :e K => hl_IN A (f x) (hl_mspace A m)) net1 = 1 /\ hl_limit R K hl_euclideanreal (fun x :e K => hl_mdist A m (hl_pair A A (f x) l)) (hl_real_of_num (hl_NUMERAL hl_zero)) net1 = 1).
Admitted.

