// HOL Light: Multivariate/metric.ml:2775 / CONTINUOUS_MAP_CASES_FUNCTION   (hash md5:91ad48db2dea1f569762d61fded20a94)
Theorem hlt_CONTINUOUS_MAP_CASES_FUNCTION : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall top'' :e hl_ty_topology C, forall p :e C :^: A, forall f g :e B :^: A, forall u :e 2 :^: C, hl_continuous_map A C (hl_pair (hl_ty_topology A) (hl_ty_topology C) top top'') p = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top (hl_GSPEC A (fun GEN_PVAR_1356 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_1356 (if hl_IN A x (hl_topspace A top) = 1 /\ hl_IN C (p x) (hl_closure_of C top'' u) = 1 then 1 else 0) x = 1 then 1 else 0))) top') f = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top (hl_GSPEC A (fun GEN_PVAR_1357 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_1357 (if hl_IN A x (hl_topspace A top) = 1 /\ hl_IN C (p x) (hl_closure_of C top'' (hl_DIFF C (hl_topspace C top'') u)) = 1 then 1 else 0) x = 1 then 1 else 0))) top') g = 1 /\ (forall x :e A, hl_IN A x (hl_topspace A top) = 1 /\ hl_IN C (p x) (hl_frontier_of C top'' u) = 1 -> f x = g x))) -> hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') (fun x :e A => hl_COND B (hl_IN C (p x) u) (f x) (g x)) = 1.
