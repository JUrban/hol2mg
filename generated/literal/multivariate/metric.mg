// HOL Light: Multivariate/metric.ml:31893 / CONTINUOUS_MAP_EXTENSION_POINTWISE_ALT   (hash md5:bf445b77172ef50e8cd31e1a9ab206f1)
Theorem hlt_CONTINUOUS_MAP_EXTENSION_POINTWISE_ALT : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, forall f :e B :^: A, forall s t :e 2 :^: A, hl_regular_space B top2 = 1 /\ (hl_SUBSET A s t = 1 /\ (hl_SUBSET A t (hl_closure_of A top1 s) = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top1 s) top2) f = 1 /\ (forall x :e A, hl_IN A x (hl_DIFF A t s) = 1 -> exists l :e B, hl_limit B A top2 f l (hl_within A (hl_atpointof A top1 x) s) = 1)))) -> exists g :e B :^: A, hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top1 t) top2) g = 1 /\ forall x :e A, hl_IN A x s = 1 -> g x = f x.
Admitted.

// HOL Light: Multivariate/metric.ml:31916 / CONTINUOUS_MAP_EXTENSION_POINTWISE   (hash md5:6b083853e27313191addff151fbf8e53)
Theorem hlt_CONTINUOUS_MAP_EXTENSION_POINTWISE : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, forall f :e B :^: A, forall s t :e 2 :^: A, hl_regular_space B top2 = 1 /\ (hl_SUBSET A s t = 1 /\ (hl_SUBSET A t (hl_closure_of A top1 s) = 1 /\ (forall x :e A, hl_IN A x t = 1 -> exists g :e B :^: A, hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top1 (hl_INSERT A x s)) top2) g = 1 /\ forall x1 :e A, hl_IN A x1 s = 1 -> g x1 = f x1))) -> exists g :e B :^: A, hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top1 t) top2) g = 1 /\ forall x :e A, hl_IN A x s = 1 -> g x = f x.
Admitted.

