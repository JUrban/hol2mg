Theorem hlt_INTERIOR_OF_SUBSET_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_SUBSET A (hl_interior_of A (hl_subtopology A top s) t) s = 1.
