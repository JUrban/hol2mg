Theorem hlt_INTERIOR_OF_SUBTOPOLOGY_SUBSETS : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t u :e 2 :^: A, hl_SUBSET A t u = 1 -> hl_SUBSET A (hl_INTER A t (hl_interior_of A (hl_subtopology A top u) s)) (hl_interior_of A (hl_subtopology A top t) s) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:1648 / INTERIOR_OF_SUBTOPOLOGY_MONO   (hash md5:d04d49af49037d84593c61ab4af73cee)
Theorem hlt_INTERIOR_OF_SUBTOPOLOGY_MONO : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t u :e 2 :^: A, hl_SUBSET A s t = 1 /\ hl_SUBSET A t u = 1 -> hl_SUBSET A (hl_interior_of A (hl_subtopology A top u) s) (hl_interior_of A (hl_subtopology A top t) s) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:1660 / INTERIOR_OF_SUBTOPOLOGY_OPEN   (hash md5:4afbffe7dff8b84fc32ff73993aa6b2b)
Theorem hlt_INTERIOR_OF_SUBTOPOLOGY_OPEN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall u s :e 2 :^: A, hl_open_in A top u = 1 -> hl_interior_of A (hl_subtopology A top u) s = hl_INTER A u (hl_interior_of A top s).
