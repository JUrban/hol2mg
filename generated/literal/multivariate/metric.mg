Theorem hlt_HOMEOMORPHIC_MAP_SWAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_homeomorphic_map (A :*: B) (B :*: A) (hl_pair (hl_ty_topology (A :*: B)) (hl_ty_topology (B :*: A)) (hl_prod_topology A B top top') (hl_prod_topology B A top' top)) (hl_GABS ((B :*: A) :^: (A :*: B)) (fun f :e (B :*: A) :^: (A :*: B) => if forall x :e A, forall y :e B, hl_GEQ (B :*: A) (f (hl_pair A B x y)) (hl_pair B A y x) = 1 then 1 else 0)) = 1.
