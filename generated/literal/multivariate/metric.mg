// HOL Light: Multivariate/metric.ml:9696 / HOMEOMORPHIC_EQ_INJECTIVE_PERFECT_MAP   (hash md5:d73356e24fe932688afec7e95be06244)
Theorem hlt_HOMEOMORPHIC_EQ_INJECTIVE_PERFECT_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_homeomorphic_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 <-> hl_perfect_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ forall x y :e A, hl_IN A x (hl_topspace A top) = 1 /\ hl_IN A y (hl_topspace A top) = 1 -> (f x = f y <-> x = y).
