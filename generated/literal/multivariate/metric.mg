Theorem hlt_BOREL_MEASURABLE_MAP_FROM_SUBTOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, forall f :e B :^: A, forall s :e 2 :^: A, hl_borel_measurable_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top1 top2) f = 1 -> hl_borel_measurable_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top1 s) top2) f = 1.
