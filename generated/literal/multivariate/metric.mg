// HOL Light: Multivariate/metric.ml:5101 / homeomorphic_map   (hash md5:93a86d28d7e368eeb393ad4f8aa2a933)
Theorem hlt_homeomorphic_map_thm : forall A B:set, A <> Empty -> B <> Empty -> forall top' :e hl_ty_topology B, forall top :e hl_ty_topology A, forall f :e B :^: A, hl_homeomorphic_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 <-> hl_quotient_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ forall x y :e A, hl_IN A x (hl_topspace A top) = 1 /\ hl_IN A y (hl_topspace A top) = 1 -> (f x = f y <-> x = y).
Admitted.

// HOL Light: Multivariate/metric.ml:5107 / homeomorphic_maps   (hash md5:02cf88904ad95228e1a11fcb153de3c8)
Theorem hlt_homeomorphic_maps_thm : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, forall g :e A :^: B, hl_homeomorphic_maps A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') (hl_pair (B :^: A) (A :^: B) f g) = 1 <-> hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (hl_continuous_map B A (hl_pair (hl_ty_topology B) (hl_ty_topology A) top' top) g = 1 /\ ((forall x :e A, hl_IN A x (hl_topspace A top) = 1 -> g (f x) = x) /\ forall y :e B, hl_IN B y (hl_topspace B top') = 1 -> f (g y) = y)).
Admitted.

// HOL Light: Multivariate/metric.ml:5114 / HOMEOMORPHIC_MAP_EQ   (hash md5:6f44892aac852e30271d9c239b5314f5)
Theorem hlt_HOMEOMORPHIC_MAP_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f g :e B :^: A, (forall x :e A, hl_IN A x (hl_topspace A top) = 1 -> f x = g x) /\ hl_homeomorphic_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 -> hl_homeomorphic_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') g = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5120 / HOMEOMORPHIC_MAPS_EQ   (hash md5:1e247adb7e05722ff619bad631ef63ae)
Theorem hlt_HOMEOMORPHIC_MAPS_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f f' :e B :^: A, forall g g' :e A :^: B, (forall x :e A, hl_IN A x (hl_topspace A top) = 1 -> f x = f' x) /\ ((forall x :e B, hl_IN B x (hl_topspace B top') = 1 -> g x = g' x) /\ hl_homeomorphic_maps A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') (hl_pair (B :^: A) (A :^: B) f g) = 1) -> hl_homeomorphic_maps A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') (hl_pair (B :^: A) (A :^: B) f' g') = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5133 / HOMEOMORPHIC_MAPS_SYM   (hash md5:0d15f4959868c3481e43356ac8b63a92)
Theorem hlt_HOMEOMORPHIC_MAPS_SYM : forall A B:set, A <> Empty -> B <> Empty -> forall f :e B :^: A, forall g :e A :^: B, forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_homeomorphic_maps A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') (hl_pair (B :^: A) (A :^: B) f g) = 1 <-> hl_homeomorphic_maps B A (hl_pair (hl_ty_topology B) (hl_ty_topology A) top' top) (hl_pair (A :^: B) (B :^: A) g f) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5139 / HOMEOMORPHIC_MAPS_ID   (hash md5:12a5eea94f3e57fb3a6a0ae8e3b7b120)
Theorem hlt_HOMEOMORPHIC_MAPS_ID : forall A:set, A <> Empty -> forall top top' :e hl_ty_topology A, hl_homeomorphic_maps A A (hl_pair (hl_ty_topology A) (hl_ty_topology A) top top') (hl_pair (A :^: A) (A :^: A) (fun x :e A => x) (fun x :e A => x)) = 1 <-> top' = top.
