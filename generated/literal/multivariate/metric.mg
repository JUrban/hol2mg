Theorem hlt_REALLIM_LE : forall A:set, A <> Empty -> forall net1 :e hl_ty_net A, forall f g :e R :^: A, forall l m :e R, hl_tendsto_real A f l net1 = 1 /\ (hl_tendsto_real A g m net1 = 1 /\ (~ hl_trivial_limit A net1 = 1 /\ hl_eventually A (fun x :e A => hl_real_le (f x) (g x)) net1 = 1)) -> hl_real_le l m = 1.
