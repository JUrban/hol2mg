Theorem hlt_HOMEOMORPHIC_SPACE_FINITENESS : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_homeomorphic_space A B top top' = 1 -> (hl_FINITE A (hl_topspace A top) = 1 <-> hl_FINITE B (hl_topspace B top') = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:5620 / HOMEOMORPHIC_SPACE_INFINITENESS   (hash md5:e58ef71fa41203032cc7c9f7a53e4243)
Theorem hlt_HOMEOMORPHIC_SPACE_INFINITENESS : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_homeomorphic_space A B top top' = 1 -> (hl_INFINITE A (hl_topspace A top) = 1 <-> hl_INFINITE B (hl_topspace B top') = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:5626 / HOMEOMORPHIC_SPACE_COUNTABILITY   (hash md5:b944ee0f4b84c6bf03ea63a14a016c5d)
Theorem hlt_HOMEOMORPHIC_SPACE_COUNTABILITY : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_homeomorphic_space A B top top' = 1 -> (hl_COUNTABLE A (hl_topspace A top) = 1 <-> hl_COUNTABLE B (hl_topspace B top') = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:5634 / HOMEOMORPHIC_EMPTY_SPACE   (hash md5:0f775268c7c5e600a7b4ab96e2abd033)
Theorem hlt_HOMEOMORPHIC_EMPTY_SPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_homeomorphic_space A B top top' = 1 -> (hl_topspace A top = hl_EMPTY A <-> hl_topspace B top' = hl_EMPTY B).
Admitted.

// HOL Light: Multivariate/metric.ml:5641 / HOMEOMORPHIC_EMPTY_SPACE_EQ   (hash md5:a0806f46a0a1f53fe4a69d46896b17d7)
Theorem hlt_HOMEOMORPHIC_EMPTY_SPACE_EQ : forall A B:set, A <> Empty -> B <> Empty -> (forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_topspace A top = hl_EMPTY A -> (hl_homeomorphic_space A B top top' = 1 <-> hl_topspace B top' = hl_EMPTY B)) /\ forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_topspace B top' = hl_EMPTY B -> (hl_homeomorphic_space A B top top' = 1 <-> hl_topspace A top = hl_EMPTY A).
Admitted.

// HOL Light: Multivariate/metric.ml:5655 / PROD_TOPOLOGY_HOMEOMORPHIC_SPACE_LEFT   (hash md5:fb9057501355cf2867867a17e21a8ab3)
Theorem hlt_PROD_TOPOLOGY_HOMEOMORPHIC_SPACE_LEFT : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall b :e B, hl_topspace B top' = hl_INSERT B b (hl_EMPTY B) -> hl_homeomorphic_space (A :*: B) A (hl_prod_topology A B top top') top = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5665 / PROD_TOPOLOGY_HOMEOMORPHIC_SPACE_RIGHT   (hash md5:67fa4e4f87198e367d9675cc53d4a9bf)
Theorem hlt_PROD_TOPOLOGY_HOMEOMORPHIC_SPACE_RIGHT : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall a :e A, hl_topspace A top = hl_INSERT A a (hl_EMPTY A) -> hl_homeomorphic_space (A :*: B) B (hl_prod_topology A B top top') top' = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5675 / HOMEOMORPHIC_SPACE_PROD_TOPOLOGY_SING   (hash md5:2a969f6c8b9822d50a1e922a75a89da6)
Theorem hlt_HOMEOMORPHIC_SPACE_PROD_TOPOLOGY_SING : forall A B:set, A <> Empty -> B <> Empty -> (forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall b :e B, hl_IN B b (hl_topspace B top') = 1 -> hl_homeomorphic_space A (A :*: B) top (hl_prod_topology A B top (hl_subtopology B top' (hl_INSERT B b (hl_EMPTY B)))) = 1) /\ forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall a :e A, hl_IN A a (hl_topspace A top) = 1 -> hl_homeomorphic_space B (A :*: B) top' (hl_prod_topology A B (hl_subtopology A top (hl_INSERT A a (hl_EMPTY A))) top') = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5689 / TOPOLOGICAL_PROPERTY_OF_PROD_COMPONENT   (hash md5:9a27afdfb7772976ea9d937f402efcbf)
Theorem hlt_TOPOLOGICAL_PROPERTY_OF_PROD_COMPONENT : forall A B:set, A <> Empty -> B <> Empty -> forall P :e 2 :^: hl_ty_topology (A :*: B), forall Q :e 2 :^: hl_ty_topology A, forall R1 :e 2 :^: hl_ty_topology B, forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, (forall a :e A, hl_IN A a (hl_topspace A top1) = 1 /\ P (hl_prod_topology A B top1 top2) = 1 -> P (hl_subtopology (A :*: B) (hl_prod_topology A B top1 top2) (hl_CROSS A B (hl_INSERT A a (hl_EMPTY A)) (hl_topspace B top2))) = 1) /\ ((forall b :e B, hl_IN B b (hl_topspace B top2) = 1 /\ P (hl_prod_topology A B top1 top2) = 1 -> P (hl_subtopology (A :*: B) (hl_prod_topology A B top1 top2) (hl_CROSS A B (hl_topspace A top1) (hl_INSERT B b (hl_EMPTY B)))) = 1) /\ ((forall top :e hl_ty_topology (A :*: B), forall top' :e hl_ty_topology A, hl_homeomorphic_space (A :*: B) A top top' = 1 -> (P top = 1 <-> Q top' = 1)) /\ (forall top :e hl_ty_topology (A :*: B), forall top' :e hl_ty_topology B, hl_homeomorphic_space (A :*: B) B top top' = 1 -> (P top = 1 <-> R1 top' = 1)))) -> P (hl_prod_topology A B top1 top2) = 1 -> hl_topspace (A :*: B) (hl_prod_topology A B top1 top2) = hl_EMPTY (A :*: B) \/ Q top1 = 1 /\ R1 top2 = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5714 / PRODUCT_TOPOLOGY_HOMEOMORPHIC_COMPONENT   (hash md5:960550b96f951ebc59447f0dd49cc427)
Theorem hlt_PRODUCT_TOPOLOGY_HOMEOMORPHIC_COMPONENT : forall A K:set, A <> Empty -> K <> Empty -> forall tops :e hl_ty_topology A :^: K, forall k :e 2 :^: K, forall i :e K, hl_IN K i k = 1 /\ (forall j :e K, hl_IN K j k = 1 /\ ~ j = i -> exists a :e A, hl_topspace A (tops j) = hl_INSERT A a (hl_EMPTY A)) -> hl_homeomorphic_space (A :^: K) A (hl_product_topology K A k tops) (tops i) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5733 / TOPOLOGICAL_PROPERTY_OF_PRODUCT_COMPONENT   (hash md5:71258c1d9e32a8872db518aa35559219)
Theorem hlt_TOPOLOGICAL_PROPERTY_OF_PRODUCT_COMPONENT : forall A K:set, A <> Empty -> K <> Empty -> forall P :e 2 :^: hl_ty_topology (A :^: K), forall Q :e 2 :^: hl_ty_topology A, forall tops :e hl_ty_topology A :^: K, forall k :e 2 :^: K, (forall z :e A :^: K, forall i :e K, hl_IN (A :^: K) z (hl_topspace (A :^: K) (hl_product_topology K A k tops)) = 1 /\ (P (hl_product_topology K A k tops) = 1 /\ hl_IN K i k = 1) -> P (hl_subtopology (A :^: K) (hl_product_topology K A k tops) (hl_cartesian_product K A k (fun j :e K => hl_COND (2 :^: A) (if j = i then 1 else 0) (hl_topspace A (tops i)) (hl_INSERT A (z j) (hl_EMPTY A))))) = 1) /\ (forall top :e hl_ty_topology (A :^: K), forall top' :e hl_ty_topology A, hl_homeomorphic_space (A :^: K) A top top' = 1 -> (P top = 1 <-> Q top' = 1)) -> P (hl_product_topology K A k tops) = 1 -> hl_topspace (A :^: K) (hl_product_topology K A k tops) = hl_EMPTY (A :^: K) \/ forall i :e K, hl_IN K i k = 1 -> Q (tops i) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5763 / HOMEOMORPHIC_SPACE_PROD_TOPOLOGY   (hash md5:be55f894ac7db6be72b68cddef843c75)
Theorem hlt_HOMEOMORPHIC_SPACE_PROD_TOPOLOGY : forall A B C D:set, A <> Empty -> B <> Empty -> C <> Empty -> D <> Empty -> forall top1 :e hl_ty_topology A, forall top1' :e hl_ty_topology B, forall top2 :e hl_ty_topology C, forall top2' :e hl_ty_topology D, hl_homeomorphic_space A B top1 top1' = 1 /\ hl_homeomorphic_space C D top2 top2' = 1 -> hl_homeomorphic_space (A :*: C) (B :*: D) (hl_prod_topology A C top1 top2) (hl_prod_topology B D top1' top2') = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5774 / HOMEOMORPHIC_SPACE_PROD_TOPOLOGY_SWAP   (hash md5:02698412fa0e824a710be79a68be9ba8)
Theorem hlt_HOMEOMORPHIC_SPACE_PROD_TOPOLOGY_SWAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_homeomorphic_space (A :*: B) (B :*: A) (hl_prod_topology A B top top') (hl_prod_topology B A top' top) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5780 / HOMEOMORPHIC_SPACE_SINGLETON_PRODUCT   (hash md5:c8cf718b3960ee94dd0777a0e92d05c7)
Theorem hlt_HOMEOMORPHIC_SPACE_SINGLETON_PRODUCT : forall A K:set, A <> Empty -> K <> Empty -> forall tops :e hl_ty_topology A :^: K, forall k :e K, hl_homeomorphic_space (A :^: K) A (hl_product_topology K A (hl_INSERT K k (hl_EMPTY K)) tops) (tops k) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5798 / embedding_map   (hash md5:5e054115a72ea29d61c0882ebfaa7324)
Theorem hlt_embedding_map_thm : forall A B:set, A <> Empty -> B <> Empty -> forall top' :e hl_ty_topology B, forall top :e hl_ty_topology A, forall f :e B :^: A, hl_embedding_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 <-> hl_homeomorphic_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top (hl_subtopology B top' (hl_IMAGE A B f (hl_topspace A top)))) f = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5802 / EMBEDDING_MAP_EQ   (hash md5:bc87c86a6532da368ce29b9d397b49c9)
Theorem hlt_EMBEDDING_MAP_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f g :e B :^: A, (forall x :e A, hl_IN A x (hl_topspace A top) = 1 -> f x = g x) /\ hl_embedding_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 -> hl_embedding_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') g = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5809 / EMBEDDING_MAP_COMPOSE   (hash md5:2abf7c4722d69b83e0aff5734eef07cd)
Theorem hlt_EMBEDDING_MAP_COMPOSE : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall top'' :e hl_ty_topology C, forall f :e B :^: A, forall g :e C :^: B, hl_embedding_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_embedding_map B C (hl_pair (hl_ty_topology B) (hl_ty_topology C) top' top'') g = 1 -> hl_embedding_map A C (hl_pair (hl_ty_topology A) (hl_ty_topology C) top top'') (hl_o B C A g f) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5829 / SURJECTIVE_EMBEDDING_MAP   (hash md5:c7f259ea22355c988a92ee1d49581a78)
Theorem hlt_SURJECTIVE_EMBEDDING_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_embedding_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_IMAGE A B f (hl_topspace A top) = hl_topspace B top' <-> hl_homeomorphic_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5836 / EMBEDDING_MAP_IN_SUBTOPOLOGY   (hash md5:16d958d7d7f0dfde82bce280b463cb05)
Theorem hlt_EMBEDDING_MAP_IN_SUBTOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall s :e 2 :^: B, forall f :e B :^: A, hl_embedding_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top (hl_subtopology B top' s)) f = 1 <-> hl_embedding_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_SUBSET B (hl_IMAGE A B f (hl_topspace A top)) s = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5847 / INJECTIVE_OPEN_IMP_EMBEDDING_MAP   (hash md5:bcb3390f3e507a0d67198701dc50fab7)
Theorem hlt_INJECTIVE_OPEN_IMP_EMBEDDING_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (hl_open_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (forall x y :e A, hl_IN A x (hl_topspace A top) = 1 /\ hl_IN A y (hl_topspace A top) = 1 -> (f x = f y <-> x = y))) -> hl_embedding_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5862 / INJECTIVE_CLOSED_IMP_EMBEDDING_MAP   (hash md5:c9584fcb670a6d2b2873f6996509fb61)
Theorem hlt_INJECTIVE_CLOSED_IMP_EMBEDDING_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (hl_closed_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (forall x y :e A, hl_IN A x (hl_topspace A top) = 1 /\ hl_IN A y (hl_topspace A top) = 1 -> (f x = f y <-> x = y))) -> hl_embedding_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5877 / EMBEDDING_MAP_IMP_HOMEOMORPHIC_SPACE   (hash md5:72a6760894f9e0a5162baa64b6a4035e)
Theorem hlt_EMBEDDING_MAP_IMP_HOMEOMORPHIC_SPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_embedding_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 -> hl_homeomorphic_space A B top (hl_subtopology B top' (hl_IMAGE A B f (hl_topspace A top))) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5884 / EMBEDDING_IMP_CONTINUOUS_MAP   (hash md5:0be1052ec5a166d50794c106a299334f)
Theorem hlt_EMBEDDING_IMP_CONTINUOUS_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_embedding_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 -> hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5890 / EMBEDDING_IMP_INJECTIVE_MAP   (hash md5:644c5edcfba85c71dd330faf9e41b46e)
Theorem hlt_EMBEDDING_IMP_INJECTIVE_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_embedding_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 -> forall x y :e A, hl_IN A x (hl_topspace A top) = 1 /\ hl_IN A y (hl_topspace A top) = 1 -> (f x = f y <-> x = y).
Admitted.

// HOL Light: Multivariate/metric.ml:5898 / EMBEDDING_IMP_CLOSED_MAP   (hash md5:5e60d66e4e44d95e3579ddd7700fd1e7)
Theorem hlt_EMBEDDING_IMP_CLOSED_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_embedding_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_closed_in B top' (hl_IMAGE A B f (hl_topspace A top)) = 1 -> hl_closed_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5909 / EMBEDDING_IMP_CLOSED_MAP_EQ   (hash md5:c7535b40d577829ee10b5491c0d18bd6)
Theorem hlt_EMBEDDING_IMP_CLOSED_MAP_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_embedding_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 -> (hl_closed_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 <-> hl_closed_in B top' (hl_IMAGE A B f (hl_topspace A top)) = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:5915 / EMBEDDING_IMP_OPEN_MAP   (hash md5:e8450c3f100c13811dc8f272ef45fe30)
Theorem hlt_EMBEDDING_IMP_OPEN_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_embedding_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_open_in B top' (hl_IMAGE A B f (hl_topspace A top)) = 1 -> hl_open_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5926 / EMBEDDING_IMP_OPEN_MAP_EQ   (hash md5:f4503915d3a897a746adf7d5e9c2d316)
Theorem hlt_EMBEDDING_IMP_OPEN_MAP_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_embedding_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 -> (hl_open_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 <-> hl_open_in B top' (hl_IMAGE A B f (hl_topspace A top)) = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:5932 / EMBEDDING_MAP_ON_EMPTY   (hash md5:929f75af99ccf61666f3549cd0a24605)
Theorem hlt_EMBEDDING_MAP_ON_EMPTY : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_topspace A top = hl_EMPTY A -> hl_embedding_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5938 / EMBEDDING_MAP_COMPONENT_INJECTION   (hash md5:7ce8274f7bc91d44fc9bb55abceb8c80)
Theorem hlt_EMBEDDING_MAP_COMPONENT_INJECTION : forall A K:set, A <> Empty -> K <> Empty -> forall k :e 2 :^: K, forall top :e hl_ty_topology A :^: K, forall i :e K, hl_IN K i k = 1 -> hl_embedding_map A (K :*: A) (hl_pair (hl_ty_topology A) (hl_ty_topology (K :*: A)) (top i) (hl_sum_topology K A k top)) (fun x :e A => hl_pair K A i x) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5945 / TOPOLOGICAL_PROPERTY_OF_SUM_COMPONENT   (hash md5:86cfdf11493c58f5847830375bcabb40)
Theorem hlt_TOPOLOGICAL_PROPERTY_OF_SUM_COMPONENT : forall A K:set, A <> Empty -> K <> Empty -> forall P :e 2 :^: hl_ty_topology (K :*: A), forall Q :e 2 :^: hl_ty_topology A, forall tops :e hl_ty_topology A :^: K, forall k :e 2 :^: K, (forall top :e hl_ty_topology (K :*: A), forall s :e 2 :^: (K :*: A), P top = 1 /\ (hl_closed_in (K :*: A) top s = 1 /\ hl_open_in (K :*: A) top s = 1) -> P (hl_subtopology (K :*: A) top s) = 1) /\ (forall top :e hl_ty_topology (K :*: A), forall top' :e hl_ty_topology A, hl_homeomorphic_space (K :*: A) A top top' = 1 -> (P top = 1 <-> Q top' = 1)) -> P (hl_sum_topology K A k tops) = 1 -> forall i :e K, hl_IN K i k = 1 -> Q (tops i) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5972 / retraction_maps   (hash md5:5d9060cd3d7e8d36c3130059c6b8ffbf)
Theorem hlt_retraction_maps_thm : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, forall g :e A :^: B, hl_retraction_maps A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') (hl_pair (B :^: A) (A :^: B) f g) = 1 <-> hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (hl_continuous_map B A (hl_pair (hl_ty_topology B) (hl_ty_topology A) top' top) g = 1 /\ forall x :e B, hl_IN B x (hl_topspace B top') = 1 -> f (g x) = x).
Admitted.

// HOL Light: Multivariate/metric.ml:5978 / section_map   (hash md5:efdca10662e39666ba9ef9ae4041a847)
Theorem hlt_section_map_thm : forall A B:set, A <> Empty -> B <> Empty -> forall top' :e hl_ty_topology B, forall top :e hl_ty_topology A, forall f :e B :^: A, hl_section_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 <-> exists g :e A :^: B, hl_retraction_maps B A (hl_pair (hl_ty_topology B) (hl_ty_topology A) top' top) (hl_pair (A :^: B) (B :^: A) g f) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5982 / retraction_map   (hash md5:731580ff80e67c7bf584215c8466345c)
Theorem hlt_retraction_map_thm : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_retraction_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 <-> exists g :e A :^: B, hl_retraction_maps A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') (hl_pair (B :^: A) (A :^: B) f g) = 1.
Admitted.

