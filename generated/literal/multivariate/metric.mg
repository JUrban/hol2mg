// HOL Light: Multivariate/metric.ml:27117 / SEPARATED_BETWEEN_COMPACT_CONNECTED_COMPONENT   (hash md5:f6f105d407e6661d8c2fe04b5ba46aec)
Theorem hlt_SEPARATED_BETWEEN_COMPACT_CONNECTED_COMPONENT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall c t :e 2 :^: A, hl_locally_compact_space A top = 1 /\ (hl_hausdorff_space A top = 1 /\ (hl_IN (2 :^: A) c (hl_connected_components_of A top) = 1 /\ (hl_compact_in A top c = 1 /\ (hl_closed_in A top t = 1 /\ hl_DISJOINT A c t = 1)))) -> hl_separated_between A top c t = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:27171 / WILDER_LOCALLY_COMPACT_COMPONENT_THM   (hash md5:3bf13235570754b6207bf65237be6002)
Theorem hlt_WILDER_LOCALLY_COMPACT_COMPONENT_THM : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall c w :e 2 :^: A, hl_locally_compact_space A top = 1 /\ (hl_hausdorff_space A top = 1 /\ (hl_IN (2 :^: A) c (hl_connected_components_of A top) = 1 /\ (hl_compact_in A top c = 1 /\ (hl_open_in A top w = 1 /\ hl_SUBSET A c w = 1)))) -> exists u v :e 2 :^: A, hl_open_in A top u = 1 /\ (hl_open_in A top v = 1 /\ (hl_DISJOINT A u v = 1 /\ (hl_UNION A u v = hl_topspace A top /\ (hl_SUBSET A c u = 1 /\ hl_SUBSET A u w = 1)))).
Admitted.

// HOL Light: Multivariate/metric.ml:27186 / COMPACT_QUASI_EQ_CONNECTED_COMPONENTS_OF   (hash md5:7cea2d7ff57c5eac7dca5b96f7a16eb0)
Theorem hlt_COMPACT_QUASI_EQ_CONNECTED_COMPONENTS_OF : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall c :e 2 :^: A, hl_locally_compact_space A top = 1 /\ (hl_hausdorff_space A top = 1 /\ hl_compact_in A top c = 1) -> (hl_IN (2 :^: A) c (hl_quasi_components_of A top) = 1 <-> hl_IN (2 :^: A) c (hl_connected_components_of A top) = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:27223 / BOUNDARY_BUMPING_THEOREM_CLOSED_GEN   (hash md5:76a0a0f0641d81b7962a6d3fd57e6d0f)
Theorem hlt_BOUNDARY_BUMPING_THEOREM_CLOSED_GEN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s c :e 2 :^: A, hl_connected_space A top = 1 /\ (hl_locally_compact_space A top = 1 /\ (hl_hausdorff_space A top = 1 /\ (hl_closed_in A top s = 1 /\ (~ s = hl_topspace A top /\ (hl_compact_in A top c = 1 /\ hl_IN (2 :^: A) c (hl_connected_components_of A (hl_subtopology A top s)) = 1))))) -> ~ hl_INTER A c (hl_frontier_of A top s) = hl_EMPTY A.
Admitted.

// HOL Light: Multivariate/metric.ml:27255 / BOUNDARY_BUMPING_THEOREM_CLOSED   (hash md5:5f9e7f74b99c521eea45eea2f79e446b)
Theorem hlt_BOUNDARY_BUMPING_THEOREM_CLOSED : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s c :e 2 :^: A, hl_connected_space A top = 1 /\ (hl_compact_space A top = 1 /\ (hl_hausdorff_space A top = 1 /\ (hl_closed_in A top s = 1 /\ (~ s = hl_topspace A top /\ hl_IN (2 :^: A) c (hl_connected_components_of A (hl_subtopology A top s)) = 1)))) -> ~ hl_INTER A c (hl_frontier_of A top s) = hl_EMPTY A.
Admitted.

// HOL Light: Multivariate/metric.ml:27268 / INTERMEDIATE_CONTINUUM_EXISTS   (hash md5:b76ef5b021bfe22010057a6cf3f49425)
Theorem hlt_INTERMEDIATE_CONTINUUM_EXISTS : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall c u :e 2 :^: A, hl_connected_space A top = 1 /\ (hl_locally_compact_space A top = 1 /\ (hl_hausdorff_space A top = 1 /\ (hl_compact_in A top c = 1 /\ (hl_connected_in A top c = 1 /\ (~ c = hl_EMPTY A /\ (~ c = hl_topspace A top /\ (hl_open_in A top u = 1 /\ hl_SUBSET A c u = 1))))))) -> exists d :e 2 :^: A, hl_compact_in A top d = 1 /\ (hl_connected_in A top d = 1 /\ (hl_PSUBSET A c d = 1 /\ hl_PSUBSET A d u = 1)).
Admitted.

