// HOL Light: Multivariate/metric.ml:1383 / OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY   (hash md5:7d838278a170b7cb0c630d2b1a19a6f6)
Theorem hlt_OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_open_in A top s = 1 -> (hl_INTER A s (hl_closure_of A top t) = hl_EMPTY A <-> hl_INTER A s t = hl_EMPTY A).
