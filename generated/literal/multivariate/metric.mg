Theorem hlt_HOMOTOPY_EQUIVALENT_SPACE_REFL : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_homotopy_equivalent_space A A top top = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:29429 / HOMOTOPY_EQUIVALENT_SPACE_SYM   (hash md5:b458a4900459eb74987fa60867076acb)
Theorem hlt_HOMOTOPY_EQUIVALENT_SPACE_SYM : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_homotopy_equivalent_space A B top top' = 1 <-> hl_homotopy_equivalent_space B A top' top = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:29437 / HOMOTOPY_EQUIVALENT_SPACE_TRANS   (hash md5:0a4a7af1e868a16337128315dbec050f)
Theorem hlt_HOMOTOPY_EQUIVALENT_SPACE_TRANS : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, forall top3 :e hl_ty_topology C, hl_homotopy_equivalent_space A B top1 top2 = 1 /\ hl_homotopy_equivalent_space B C top2 top3 = 1 -> hl_homotopy_equivalent_space A C top1 top3 = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:29465 / DEFORMATION_RETRACTION_IMP_HOMOTOPY_EQUIVALENT_SPACE   (hash md5:d0f6da62b2de0bf4286014eb402b3a08)
Theorem hlt_DEFORMATION_RETRACTION_IMP_HOMOTOPY_EQUIVALENT_SPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall r :e B :^: A, forall s :e A :^: B, hl_homotopic_with A A (fun x :e A :^: A => if True then 1 else 0) (hl_pair (hl_ty_topology A) (hl_ty_topology A) top top) (hl_o B A A s r) (hl_I A) = 1 /\ hl_retraction_maps A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') (hl_pair (B :^: A) (A :^: B) r s) = 1 -> hl_homotopy_equivalent_space A B top top' = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:29478 / DEFORMATION_RETRACT_IMP_HOMOTOPY_EQUIVALENT_SPACE   (hash md5:88e9c140e4c83499545f457c48a2c85a)
Theorem hlt_DEFORMATION_RETRACT_IMP_HOMOTOPY_EQUIVALENT_SPACE : forall A:set, A <> Empty -> forall top top' :e hl_ty_topology A, forall r :e A :^: A, hl_homotopic_with A A (fun x :e A :^: A => if True then 1 else 0) (hl_pair (hl_ty_topology A) (hl_ty_topology A) top top) r (hl_I A) = 1 /\ hl_retraction_maps A A (hl_pair (hl_ty_topology A) (hl_ty_topology A) top top') (hl_pair (A :^: A) (A :^: A) r (hl_I A)) = 1 -> hl_homotopy_equivalent_space A A top top' = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:29488 / DEFORMATION_RETRACT_OF_SPACE   (hash md5:5d735b1d57eecd93da7c1f3dc899be75)
Theorem hlt_DEFORMATION_RETRACT_OF_SPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_SUBSET A s (hl_topspace A top) = 1 /\ (exists r :e A :^: A, hl_homotopic_with A A (fun x :e A :^: A => if True then 1 else 0) (hl_pair (hl_ty_topology A) (hl_ty_topology A) top top) (hl_I A) r = 1 /\ hl_retraction_maps A A (hl_pair (hl_ty_topology A) (hl_ty_topology A) top (hl_subtopology A top s)) (hl_pair (A :^: A) (A :^: A) r (hl_I A)) = 1) <-> hl_retract_of_space A s top = 1 /\ exists f :e A :^: A, hl_homotopic_with A A (fun x :e A :^: A => if True then 1 else 0) (hl_pair (hl_ty_topology A) (hl_ty_topology A) top top) (hl_I A) f = 1 /\ hl_SUBSET A (hl_IMAGE A A f (hl_topspace A top)) s = 1.
Admitted.

