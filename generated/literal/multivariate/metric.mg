Theorem hlt_SEPARATED_BETWEEN_QUASI_COMPONENT_POINTWISE_RIGHT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s c :e 2 :^: A, hl_IN (2 :^: A) c (hl_quasi_components_of A top) = 1 -> (hl_separated_between A top s c = 1 <-> exists x :e A, hl_IN A x c = 1 /\ hl_separated_between A top s (hl_INSERT A x (hl_EMPTY A)) = 1).
