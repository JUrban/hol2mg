// HOL Light: Multivariate/metric.ml:26884 / OPEN_IN_QUASI_COMPONENTS_OF_LOCALLY_CONNECTED_SPACE   (hash md5:a8cfbd888e347a328ecec5661f8a28b6)
Theorem hlt_OPEN_IN_QUASI_COMPONENTS_OF_LOCALLY_CONNECTED_SPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall c :e 2 :^: A, hl_locally_connected_space A top = 1 /\ hl_IN (2 :^: A) c (hl_quasi_components_of A top) = 1 -> hl_open_in A top c = 1.
