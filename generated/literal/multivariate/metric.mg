// HOL Light: Multivariate/metric.ml:326 / DISCRETE_SPACE_DISCRETE_TOPOLOGY   (hash md5:c65b80ae60444066cdb60a8815c506eb)
Theorem hlt_DISCRETE_SPACE_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u :e 2 :^: A, hl_discrete_space A (hl_discrete_topology A u) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:330 / DISCRETE_SPACE   (hash md5:3aa2392c7f6539daccfc57cfbdbad5f0)
Theorem hlt_DISCRETE_SPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_discrete_space A top = 1 <-> exists u :e 2 :^: A, hl_discrete_topology A u = top.
Admitted.

// HOL Light: Multivariate/metric.ml:334 / FORALL_DISCRETE_SPACES   (hash md5:c0e243942dc54d0eb202119efa8a7395)
Theorem hlt_FORALL_DISCRETE_SPACES : forall A:set, A <> Empty -> forall P :e 2 :^: hl_ty_topology A :^: (2 :^: A), (forall top :e hl_ty_topology A, hl_discrete_space A top = 1 -> P (hl_topspace A top) top = 1) <-> forall u :e 2 :^: A, P u (hl_discrete_topology A u) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:339 / DISCRETE_TOPOLOGY_UNIQUE   (hash md5:eee40f384150906a60aeae828847c05e)
Theorem hlt_DISCRETE_TOPOLOGY_UNIQUE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall u :e 2 :^: A, hl_discrete_topology A u = top <-> hl_topspace A top = u /\ forall x :e A, hl_IN A x u = 1 -> hl_open_in A top (hl_INSERT A x (hl_EMPTY A)) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:355 / DISCRETE_SPACE_UNIQUE   (hash md5:1ab80a3f1c80336b5e3b53fab4db353d)
Theorem hlt_DISCRETE_SPACE_UNIQUE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_discrete_space A top = 1 <-> forall x :e A, hl_IN A x (hl_topspace A top) = 1 -> hl_open_in A top (hl_INSERT A x (hl_EMPTY A)) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:360 / DISCRETE_TOPOLOGY_UNIQUE_ALT   (hash md5:3cf796f7b0c4f1a0213b6e908d6c473f)
Theorem hlt_DISCRETE_TOPOLOGY_UNIQUE_ALT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall u :e 2 :^: A, hl_discrete_topology A u = top <-> hl_SUBSET A (hl_topspace A top) u = 1 /\ forall x :e A, hl_IN A x u = 1 -> hl_open_in A top (hl_INSERT A x (hl_EMPTY A)) = 1.
