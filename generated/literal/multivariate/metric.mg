Theorem hlt_QUASI_COMPONENTS_OF_EQ_SING : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_quasi_components_of A top = hl_INSERT (2 :^: A) s (hl_EMPTY (2 :^: A)) <-> hl_connected_space A top = 1 /\ (~ hl_topspace A top = hl_EMPTY A /\ s = hl_topspace A top).
