Theorem hlt_PATH_COMPONENT_OF_NONOVERLAP : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall x y :e A, hl_INTER A (hl_path_component_of A top x) (hl_path_component_of A top y) = hl_EMPTY A <-> ~ hl_IN A x (hl_topspace A top) = 1 \/ (~ hl_IN A y (hl_topspace A top) = 1 \/ ~ hl_path_component_of A top x = hl_path_component_of A top y).
