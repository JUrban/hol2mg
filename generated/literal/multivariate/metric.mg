// HOL Light: Multivariate/metric.ml:1502 / INTERIOR_OF_MAXIMAL   (hash md5:e4a541290e56ac0e983b1c0f68a63e5d)
Theorem hlt_INTERIOR_OF_MAXIMAL : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_SUBSET A t s = 1 /\ hl_open_in A top t = 1 -> hl_SUBSET A t (hl_interior_of A top s) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:1507 / INTERIOR_OF_MAXIMAL_EQ   (hash md5:e0eb4761fb38d89fdb1f921f93b33538)
Theorem hlt_INTERIOR_OF_MAXIMAL_EQ : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_open_in A top t = 1 -> (hl_SUBSET A t (hl_interior_of A top s) = 1 <-> hl_SUBSET A t s = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:1512 / INTERIOR_OF_UNIQUE   (hash md5:a10483ee0c3484f19520879d58671a22)
Theorem hlt_INTERIOR_OF_UNIQUE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_SUBSET A t s = 1 /\ (hl_open_in A top t = 1 /\ (forall t' :e 2 :^: A, hl_SUBSET A t' s = 1 /\ hl_open_in A top t' = 1 -> hl_SUBSET A t' t = 1)) -> hl_interior_of A top s = t.
Admitted.

// HOL Light: Multivariate/metric.ml:1520 / INTERIOR_OF_SUBSET_TOPSPACE   (hash md5:6316433ee7c8b94040e26721680b37b3)
Theorem hlt_INTERIOR_OF_SUBSET_TOPSPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_SUBSET A (hl_interior_of A top s) (hl_topspace A top) = 1.
