Theorem hlt_PROPER_MAP_PAIRED_CONTINUOUS_MAP_RIGHT : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_hausdorff_space B top' = 1 -> hl_proper_map A (A :*: B) (hl_pair (hl_ty_topology A) (hl_ty_topology (A :*: B)) top (hl_prod_topology A B top top')) (fun x :e A => hl_pair A B x (f x)) = 1.
