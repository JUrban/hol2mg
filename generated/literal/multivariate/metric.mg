// HOL Light: Multivariate/metric.ml:32797 / MDIAMETER_COMPACT_ATTAINED   (hash md5:7d508277f4837f24a6ac07733b66f422)
Theorem hlt_MDIAMETER_COMPACT_ATTAINED : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall s :e 2 :^: A, hl_compact_in A (hl_mtopology A m) s = 1 /\ ~ s = hl_EMPTY A -> exists x y :e A, hl_IN A x s = 1 /\ (hl_IN A y s = 1 /\ hl_mdist A m (hl_pair A A x y) = hl_mdiameter A m s).
