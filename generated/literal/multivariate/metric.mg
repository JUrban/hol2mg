// HOL Light: Multivariate/metric.ml:3830 / CONTINUOUS_MAP_PAIRWISE   (hash md5:c58b05d8f00e7cadb4b909cf2d38652f)
Theorem hlt_CONTINUOUS_MAP_PAIRWISE : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e hl_ty_topology A, forall top1 :e hl_ty_topology B, forall top2 :e hl_ty_topology C, forall f :e (B :*: C) :^: A, hl_continuous_map A (B :*: C) (hl_pair (hl_ty_topology A) (hl_ty_topology (B :*: C)) top (hl_prod_topology B C top1 top2)) f = 1 <-> hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top1) (hl_o (B :*: C) B A (hl_FST B C) f) = 1 /\ hl_continuous_map A C (hl_pair (hl_ty_topology A) (hl_ty_topology C) top top2) (hl_o (B :*: C) C A (hl_SND B C) f) = 1.
