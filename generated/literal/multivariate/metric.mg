// HOL Light: Multivariate/metric.ml:14329 / SEPARATED_BETWEEN_FULL   (hash md5:0a0af4c05a4ac21d5750210f97e3d594)
Theorem hlt_SEPARATED_BETWEEN_FULL : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_UNION A s t = hl_topspace A top -> (hl_separated_between A top s t = 1 <-> hl_DISJOINT A s t = 1 /\ (hl_closed_in A top s = 1 /\ (hl_open_in A top s = 1 /\ (hl_closed_in A top t = 1 /\ hl_open_in A top t = 1)))).
