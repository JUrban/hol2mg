// HOL Light: Multivariate/metric.ml:11650 / REAL_ABS_MDIST   (hash md5:10780492c5afb03b60feba4af2520615)
Theorem hlt_REAL_ABS_MDIST : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall x y :e A, hl_IN A x (hl_mspace A m) = 1 /\ hl_IN A y (hl_mspace A m) = 1 -> hl_real_abs (hl_mdist A m (hl_pair A A x y)) = hl_mdist A m (hl_pair A A x y).
