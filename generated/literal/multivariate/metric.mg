// HOL Light: Multivariate/metric.ml:1482 / INTERIOR_OF_SUBSET   (hash md5:cae3a503e01c298f8184516bebe24a22)
Theorem hlt_INTERIOR_OF_SUBSET : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_SUBSET A (hl_interior_of A top s) s = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:1486 / INTERIOR_OF_SUBSET_CLOSURE_OF   (hash md5:2004da0bf79c12db7c1c9da197039b03)
Theorem hlt_INTERIOR_OF_SUBSET_CLOSURE_OF : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_SUBSET A (hl_interior_of A top s) (hl_closure_of A top s) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:1493 / SUBSET_INTERIOR_OF_EQ   (hash md5:14877bdff1bf616b3600d3a6fdc7cbfa)
Theorem hlt_SUBSET_INTERIOR_OF_EQ : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_SUBSET A s (hl_interior_of A top s) = 1 <-> hl_open_in A top s = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:1497 / INTERIOR_OF_MONO   (hash md5:2cc12e40d315be64af3e55cd3f2a8ff1)
Theorem hlt_INTERIOR_OF_MONO : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_SUBSET A s t = 1 -> hl_SUBSET A (hl_interior_of A top s) (hl_interior_of A top t) = 1.
