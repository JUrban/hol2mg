Theorem hlt_COMPACT_IN_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_compact_in A (hl_subtopology A top s) t = 1 <-> hl_compact_in A top t = 1 /\ hl_SUBSET A t s = 1.
