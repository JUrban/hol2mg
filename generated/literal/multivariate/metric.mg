Theorem hlt_HOMOTOPIC_COMPOSE_CONTINUOUS_MAP_LEFT : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall f g :e B :^: A, forall h :e C :^: B, forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, forall top3 :e hl_ty_topology C, hl_homotopic_with A B (fun k :e B :^: A => if True then 1 else 0) (hl_pair (hl_ty_topology A) (hl_ty_topology B) top1 top2) f g = 1 /\ hl_continuous_map B C (hl_pair (hl_ty_topology B) (hl_ty_topology C) top2 top3) h = 1 -> hl_homotopic_with A C (fun k :e C :^: A => if True then 1 else 0) (hl_pair (hl_ty_topology A) (hl_ty_topology C) top1 top3) (hl_o B C A h f) (hl_o B C A h g) = 1.
