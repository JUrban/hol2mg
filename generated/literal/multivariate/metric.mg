// HOL Light: Multivariate/metric.ml:21904 / REALLIM_LBOUND   (hash md5:d980249050fa5e56b3c9f6765d428430)
Theorem hlt_REALLIM_LBOUND : forall A:set, A <> Empty -> forall net1 :e hl_ty_net A, forall f :e R :^: A, forall l b :e R, hl_tendsto_real A f l net1 = 1 /\ (~ hl_trivial_limit A net1 = 1 /\ hl_eventually A (fun x :e A => hl_real_le b (f x)) net1 = 1) -> hl_real_le b l = 1.
