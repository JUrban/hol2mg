Theorem hlt_CARD_LE_CONNNECTED_COMPONENTS_CONNECTED_IN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall u :e 2 :^: (2 :^: A), (forall c :e 2 :^: A, hl_IN (2 :^: A) c u = 1 -> hl_connected_in A top c = 1) /\ hl_UNIONS A u = hl_topspace A top -> hl_sym_3c3d5f63 (2 :^: A) (2 :^: A) (hl_connected_components_of A top) u = 1.
