// HOL Light: Multivariate/metric.ml:21948 / real_summable   (hash md5:b309165bbdad47f73e47d8fbf0204a5d)
Theorem hlt_real_summable_thm : forall f :e R :^: omega, forall s :e 2 :^: omega, hl_real_summable s f = 1 <-> exists l :e R, hl_real_sums f l s = 1.
