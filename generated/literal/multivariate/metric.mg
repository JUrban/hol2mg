// HOL Light: Multivariate/metric.ml:6672 / COMPACT_SPACE_FIP   (hash md5:e676c5ae359431010b85b98f31165100)
Theorem hlt_COMPACT_SPACE_FIP : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_compact_space A top = 1 <-> forall f :e 2 :^: (2 :^: A), (forall c :e 2 :^: A, hl_IN (2 :^: A) c f = 1 -> hl_closed_in A top c = 1) /\ (forall f' :e 2 :^: (2 :^: A), hl_FINITE (2 :^: A) f' = 1 /\ hl_SUBSET (2 :^: A) f' f = 1 -> ~ hl_INTERS A f' = hl_EMPTY A) -> ~ hl_INTERS A f = hl_EMPTY A.
Admitted.

// HOL Light: Multivariate/metric.ml:6730 / COMPACT_IN_FIP   (hash md5:b451682f78006271778f0f54d26cd37d)
Theorem hlt_COMPACT_IN_FIP : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_compact_in A top s = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1 /\ forall f :e 2 :^: (2 :^: A), (forall c :e 2 :^: A, hl_IN (2 :^: A) c f = 1 -> hl_closed_in A top c = 1) /\ (forall f' :e 2 :^: (2 :^: A), hl_FINITE (2 :^: A) f' = 1 /\ hl_SUBSET (2 :^: A) f' f = 1 -> ~ hl_INTER A s (hl_INTERS A f') = hl_EMPTY A) -> ~ hl_INTER A s (hl_INTERS A f) = hl_EMPTY A.
Admitted.

// HOL Light: Multivariate/metric.ml:6765 / COMPACT_SPACE_IMP_NEST   (hash md5:2f3244e7f34bde368534e273f45a76c8)
Theorem hlt_COMPACT_SPACE_IMP_NEST : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall c :e 2 :^: A :^: omega, hl_compact_space A top = 1 /\ ((forall n :e omega, hl_closed_in A top (c n) = 1) /\ ((forall n :e omega, ~ c n = hl_EMPTY A) /\ (forall m n :e omega, hl_le m n = 1 -> hl_SUBSET A (c n) (c m) = 1))) -> ~ hl_INTERS A (hl_GSPEC (2 :^: A) (fun GEN_PVAR_1482 :e 2 :^: A => if exists n :e omega, hl_SETSPEC (2 :^: A) GEN_PVAR_1482 (hl_IN omega n (hl_UNIV omega)) (c n) = 1 then 1 else 0)) = hl_EMPTY A.
Admitted.

