// HOL Light: Multivariate/metric.ml:23014 / PATH_COMPONENT_OF_PRODUCT_TOPOLOGY   (hash md5:8da4f03c1342b1198463529127cf8c55)
Theorem hlt_PATH_COMPONENT_OF_PRODUCT_TOPOLOGY : forall A K:set, A <> Empty -> K <> Empty -> forall k :e 2 :^: K, forall tops :e hl_ty_topology A :^: K, forall x :e A :^: K, hl_path_component_of (A :^: K) (hl_product_topology K A k tops) x = hl_COND (2 :^: (A :^: K)) (hl_EXTENSIONAL K A k x) (hl_cartesian_product K A k (fun i :e K => hl_path_component_of A (tops i) (x i))) (hl_EMPTY (A :^: K)).
