Theorem hlt_REGULAR_SPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_regular_space A top = 1 <-> forall c :e 2 :^: A, forall a :e A, hl_closed_in A top c = 1 /\ hl_IN A a (hl_DIFF A (hl_topspace A top) c) = 1 -> exists u :e 2 :^: A, hl_open_in A top u = 1 /\ (hl_IN A a u = 1 /\ hl_DISJOINT A c (hl_closure_of A top u) = 1).
