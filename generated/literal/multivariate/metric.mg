Theorem hlt_PASTING_LEMMA_CLOSED : forall A B K:set, A <> Empty -> B <> Empty -> K <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A :^: K, forall g :e B :^: A, forall t :e 2 :^: A :^: K, forall k :e 2 :^: K, hl_FINITE K k = 1 /\ ((forall i :e K, hl_IN K i k = 1 -> hl_closed_in A top (t i) = 1 /\ hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top (t i)) top') (f i) = 1) /\ ((forall i j :e K, forall x :e A, hl_IN K i k = 1 /\ (hl_IN K j k = 1 /\ hl_IN A x (hl_INTER A (hl_topspace A top) (hl_INTER A (t i) (t j))) = 1) -> f i x = f j x) /\ (forall x :e A, hl_IN A x (hl_topspace A top) = 1 -> exists j :e K, hl_IN K j k = 1 /\ (hl_IN A x (t j) = 1 /\ g x = f j x)))) -> hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') g = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:2720 / PASTING_LEMMA_EXISTS_CLOSED   (hash md5:e784bb20d077d7bf1fc6155f99cdcbd3)
Theorem hlt_PASTING_LEMMA_EXISTS_CLOSED : forall A B K:set, A <> Empty -> B <> Empty -> K <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A :^: K, forall t :e 2 :^: A :^: K, forall k :e 2 :^: K, hl_FINITE K k = 1 /\ (hl_SUBSET A (hl_topspace A top) (hl_UNIONS A (hl_GSPEC (2 :^: A) (fun GEN_PVAR_1339 :e 2 :^: A => if exists i :e K, hl_SETSPEC (2 :^: A) GEN_PVAR_1339 (hl_IN K i k) (t i) = 1 then 1 else 0))) = 1 /\ ((forall i :e K, hl_IN K i k = 1 -> hl_closed_in A top (t i) = 1 /\ hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top (t i)) top') (f i) = 1) /\ (forall i j :e K, forall x :e A, hl_IN K i k = 1 /\ (hl_IN K j k = 1 /\ hl_IN A x (hl_INTER A (hl_topspace A top) (hl_INTER A (t i) (t j))) = 1) -> f i x = f j x))) -> exists g :e B :^: A, hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') g = 1 /\ forall x :e A, forall i :e K, hl_IN K i k = 1 /\ hl_IN A x (hl_INTER A (hl_topspace A top) (t i)) = 1 -> g x = f i x.
Admitted.

// HOL Light: Multivariate/metric.ml:2736 / CONTINUOUS_MAP_CASES   (hash md5:6e4efb99bb48983328cb582d89c52389)
Theorem hlt_CONTINUOUS_MAP_CASES : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall P :e 2 :^: A, forall f g :e B :^: A, hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top (hl_closure_of A top (hl_GSPEC A (fun GEN_PVAR_1346 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_1346 (P x) x = 1 then 1 else 0)))) top') f = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top (hl_closure_of A top (hl_GSPEC A (fun GEN_PVAR_1347 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_1347 (if ~ P x = 1 then 1 else 0) x = 1 then 1 else 0)))) top') g = 1 /\ (forall x :e A, hl_IN A x (hl_frontier_of A top (hl_GSPEC A (fun GEN_PVAR_1348 :e A => if exists x1 :e A, hl_SETSPEC A GEN_PVAR_1348 (P x1) x1 = 1 then 1 else 0))) = 1 -> f x = g x)) -> hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') (fun x :e A => hl_COND B (P x) (f x) (g x)) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:2763 / CONTINUOUS_MAP_CASES_ALT   (hash md5:1a9df466c5df87ebecd95ca57fc08fb4)
Theorem hlt_CONTINUOUS_MAP_CASES_ALT : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall P :e 2 :^: A, forall f g :e B :^: A, hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top (hl_closure_of A top (hl_GSPEC A (fun GEN_PVAR_1351 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_1351 (if hl_IN A x (hl_topspace A top) = 1 /\ P x = 1 then 1 else 0) x = 1 then 1 else 0)))) top') f = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top (hl_closure_of A top (hl_GSPEC A (fun GEN_PVAR_1352 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_1352 (if hl_IN A x (hl_topspace A top) = 1 /\ ~ P x = 1 then 1 else 0) x = 1 then 1 else 0)))) top') g = 1 /\ (forall x :e A, hl_IN A x (hl_frontier_of A top (hl_GSPEC A (fun GEN_PVAR_1353 :e A => if exists x1 :e A, hl_SETSPEC A GEN_PVAR_1353 (if hl_IN A x1 (hl_topspace A top) = 1 /\ P x1 = 1 then 1 else 0) x1 = 1 then 1 else 0))) = 1 -> f x = g x)) -> hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') (fun x :e A => hl_COND B (P x) (f x) (g x)) = 1.
