// HOL Light: Multivariate/metric.ml:5183 / HOMEOMORPHIC_MAPS_COMPOSE   (hash md5:5d45907f2e25a77b2e9ba5f865111e9d)
Theorem hlt_HOMEOMORPHIC_MAPS_COMPOSE : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall top'' :e hl_ty_topology C, forall f :e B :^: A, forall g :e C :^: B, forall h :e A :^: B, forall k :e B :^: C, hl_homeomorphic_maps A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') (hl_pair (B :^: A) (A :^: B) f h) = 1 /\ hl_homeomorphic_maps B C (hl_pair (hl_ty_topology B) (hl_ty_topology C) top' top'') (hl_pair (C :^: B) (B :^: C) g k) = 1 -> hl_homeomorphic_maps A C (hl_pair (hl_ty_topology A) (hl_ty_topology C) top top'') (hl_pair (C :^: A) (A :^: C) (hl_o B C A g f) (hl_o B A C h k)) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5195 / HOMEOMORPHIC_EQ_EVERYTHING_MAP   (hash md5:b9063ad1f2cb58584ae5545133b6a338)
Theorem hlt_HOMEOMORPHIC_EQ_EVERYTHING_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_homeomorphic_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 <-> hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (hl_open_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (hl_closed_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (hl_IMAGE A B f (hl_topspace A top) = hl_topspace B top' /\ forall x y :e A, hl_IN A x (hl_topspace A top) = 1 /\ hl_IN A y (hl_topspace A top) = 1 -> (f x = f y <-> x = y)))).
Admitted.

// HOL Light: Multivariate/metric.ml:5211 / HOMEOMORPHIC_IMP_QUOTIENT_MAP   (hash md5:0c0ded65b2642f9a7feb66c647c913e3)
