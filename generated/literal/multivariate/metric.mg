// HOL Light: Multivariate/metric.ml:11620 / MSPACE   (hash md5:ae1d537b90b02074e3b4d7a0d82443ca)
Theorem hlt_MSPACE : forall A:set, A <> Empty -> forall s :e 2 :^: A, forall d :e R :^: (A :*: A), hl_is_metric_space A (hl_pair (2 :^: A) (R :^: (A :*: A)) s d) = 1 -> hl_mspace A (hl_metric A (hl_pair (2 :^: A) (R :^: (A :*: A)) s d)) = s.
