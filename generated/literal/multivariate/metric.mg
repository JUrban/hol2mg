Theorem hlt_reallim_thm : forall A:set, A <> Empty -> forall f :e R :^: A, forall net1 :e hl_ty_net A, hl_reallim A net1 f = hl_select R (fun l :e R => hl_tendsto_real A f l net1).
Admitted.

