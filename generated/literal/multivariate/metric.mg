Theorem hlt_HOMOTOPIC_WITH_REFL : forall A B:set, A <> Empty -> B <> Empty -> forall P :e 2 :^: (B :^: A), forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_homotopic_with A B P (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f f = 1 <-> hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ P f = 1.
