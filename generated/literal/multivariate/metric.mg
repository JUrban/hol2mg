Theorem hlt_COMPACT_IMP_PROPER_MAP_GEN : forall A B:set, A <> Empty -> B <> Empty -> forall top' :e hl_ty_topology B, (forall s :e 2 :^: B, hl_SUBSET B s (hl_topspace B top') = 1 /\ (forall k :e 2 :^: B, hl_compact_in B top' k = 1 -> hl_compact_in B top' (hl_INTER B s k) = 1) -> hl_closed_in B top' s = 1) -> forall top :e hl_ty_topology A, forall f :e B :^: A, hl_SUBSET B (hl_IMAGE A B f (hl_topspace A top)) (hl_topspace B top') = 1 /\ ((hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 \/ hl_kc_space A top = 1) /\ (forall k :e 2 :^: B, hl_compact_in B top' k = 1 -> hl_compact_in A top (hl_GSPEC A (fun GEN_PVAR_1556 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_1556 (if hl_IN A x (hl_topspace A top) = 1 /\ hl_IN B (f x) k = 1 then 1 else 0) x = 1 then 1 else 0)) = 1)) -> hl_proper_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1.
Admitted.

