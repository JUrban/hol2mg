Theorem hlt_CONNECTED_COMPONENTS_OF_DISJOINT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall c c' :e 2 :^: A, hl_IN (2 :^: A) c (hl_connected_components_of A top) = 1 /\ hl_IN (2 :^: A) c' (hl_connected_components_of A top) = 1 -> (hl_DISJOINT A c c' = 1 <-> ~ c = c').
