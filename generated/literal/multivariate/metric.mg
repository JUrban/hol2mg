// HOL Light: Multivariate/metric.ml:206 / CLOPEN_IN_COMPLEMENT   (hash md5:2d5228337158db85c26d0cee8f98862e)
Theorem hlt_CLOPEN_IN_COMPLEMENT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_closed_in A top s = 1 /\ hl_open_in A top s = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1 /\ (hl_closed_in A top (hl_DIFF A (hl_topspace A top) s) = 1 /\ hl_open_in A top (hl_DIFF A (hl_topspace A top) s) = 1).
