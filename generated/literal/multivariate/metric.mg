// HOL Light: Multivariate/metric.ml:11608 / mspace   (hash md5:63a4a3e5301b9b8ab056fff53a4b8853)
Theorem hlt_mspace_thm : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, hl_mspace A m = hl_FST (2 :^: A) (R :^: (A :*: A)) (hl_dest_metric A m).
Admitted.

// HOL Light: Multivariate/metric.ml:11611 / mdist   (hash md5:1f35c5c9d89c78347f7c86c57690104e)
Theorem hlt_mdist_thm : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, hl_mdist A m = hl_SND (2 :^: A) (R :^: (A :*: A)) (hl_dest_metric A m).
