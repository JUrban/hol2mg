// HOL Light: Multivariate/metric.ml:385 / SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_SING   (hash md5:5c78702105c2e913bd40b2bd23e537ef)
Theorem hlt_SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_SING : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall a :e A, top = hl_discrete_topology A (hl_INSERT A a (hl_EMPTY A)) <-> hl_topspace A top = hl_INSERT A a (hl_EMPTY A).
