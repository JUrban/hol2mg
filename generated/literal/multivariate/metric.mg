// HOL Light: Multivariate/metric.ml:13255 / CONNECTED_IN_UNION   (hash md5:21779b36017389a4ef786df79218099e)
Theorem hlt_CONNECTED_IN_UNION : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_connected_in A top s = 1 /\ (hl_connected_in A top t = 1 /\ ~ hl_INTER A s t = hl_EMPTY A) -> hl_connected_in A top (hl_UNION A s t) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:13263 / CONNECTED_SPACE_SUBCONNECTED   (hash md5:7b69392a77652e771d3022b8cf1e7901)
Theorem hlt_CONNECTED_SPACE_SUBCONNECTED : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_connected_space A top = 1 <-> forall x y :e A, hl_IN A x (hl_topspace A top) = 1 /\ hl_IN A y (hl_topspace A top) = 1 -> exists s :e 2 :^: A, hl_connected_in A top s = 1 /\ (hl_IN A x s = 1 /\ hl_IN A y s = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:13285 / CONNECTED_IN_INTERMEDIATE_CLOSURE_OF   (hash md5:e4257946b46e80bc95904ea4768bf2aa)
Theorem hlt_CONNECTED_IN_INTERMEDIATE_CLOSURE_OF : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_connected_in A top s = 1 /\ (hl_SUBSET A s t = 1 /\ hl_SUBSET A t (hl_closure_of A top s) = 1) -> hl_connected_in A top t = 1.
