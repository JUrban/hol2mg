// HOL Light: Multivariate/metric.ml:22852 / PATH_COMPONENT_OF_EQ_OVERLAP   (hash md5:0759d0c26397da293215c1fe475041f8)
Theorem hlt_PATH_COMPONENT_OF_EQ_OVERLAP : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall x y :e A, hl_path_component_of A top x = hl_path_component_of A top y <-> ~ hl_IN A x (hl_topspace A top) = 1 /\ ~ hl_IN A y (hl_topspace A top) = 1 \/ ~ hl_INTER A (hl_path_component_of A top x) (hl_path_component_of A top y) = hl_EMPTY A.
