// HOL Light: Multivariate/metric.ml:11614 / METRIC   (hash md5:c2086e63439a22a14ca24c194c2a967c)
Theorem hlt_METRIC : forall A:set, A <> Empty -> forall s :e 2 :^: A, forall d :e R :^: (A :*: A), hl_is_metric_space A (hl_pair (2 :^: A) (R :^: (A :*: A)) s d) = 1 -> hl_mspace A (hl_metric A (hl_pair (2 :^: A) (R :^: (A :*: A)) s d)) = s /\ hl_mdist A (hl_metric A (hl_pair (2 :^: A) (R :^: (A :*: A)) s d)) = d.
