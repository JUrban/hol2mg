// HOL Light: Multivariate/metric.ml:23047 / PATH_COMPONENTS_OF_PRODUCT_TOPOLOGY   (hash md5:d97b725475252956a28e06970c51d48e)
Theorem hlt_PATH_COMPONENTS_OF_PRODUCT_TOPOLOGY : forall A K:set, A <> Empty -> K <> Empty -> forall k :e 2 :^: K, forall tops :e hl_ty_topology A :^: K, hl_path_components_of (A :^: K) (hl_product_topology K A k tops) = hl_GSPEC (2 :^: (A :^: K)) (fun GEN_PVAR_1952 :e 2 :^: (A :^: K) => if exists c :e 2 :^: A :^: K, hl_SETSPEC (2 :^: (A :^: K)) GEN_PVAR_1952 (if forall i :e K, hl_IN K i k = 1 -> hl_IN (2 :^: A) (c i) (hl_path_components_of A (tops i)) = 1 then 1 else 0) (hl_cartesian_product K A k c) = 1 then 1 else 0).
