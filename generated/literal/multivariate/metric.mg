// HOL Light: Multivariate/metric.ml:1120 / DERIVED_SET_OF_SUBSET_CLOSURE_OF   (hash md5:aba7c7a392354bbde67a163ab9709a10)
Theorem hlt_DERIVED_SET_OF_SUBSET_CLOSURE_OF : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_SUBSET A (hl_derived_set_of A top s) (hl_closure_of A top s) = 1.
