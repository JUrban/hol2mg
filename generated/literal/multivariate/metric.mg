Theorem hlt_CONTINUOUS_MAP_SEPARATED_UNION : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, forall s t :e 2 :^: A, hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top s) top') f = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top t) top') f = 1 /\ (hl_DISJOINT A s (hl_closure_of A top t) = 1 /\ hl_DISJOINT A t (hl_closure_of A top s) = 1)) -> hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top (hl_UNION A s t)) top') f = 1.
