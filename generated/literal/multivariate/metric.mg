Theorem hlt_PATH_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall q :e B :^: A, hl_quotient_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') q = 1 /\ hl_path_connected_space A top = 1 -> hl_path_connected_space B top' = 1.
