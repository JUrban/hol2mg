Theorem hlt_LIPSCHITZ_CONTINUOUS_MAP_REAL_ADDITION : hl_lipschitz_continuous_map (R :*: R) R (hl_pair (hl_ty_metric (R :*: R)) (hl_ty_metric R) (hl_prod_metric R R hl_real_euclidean_metric hl_real_euclidean_metric) hl_real_euclidean_metric) (hl_GABS (R :^: (R :*: R)) (fun f :e R :^: (R :*: R) => if forall x y :e R, hl_GEQ R (f (hl_pair R R x y)) (hl_real_add x y) = 1 then 1 else 0)) = 1.
