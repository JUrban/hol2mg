// HOL Light: Multivariate/metric.ml:32352 / CONVERGENT_EQ_ZERO_OSCILLATION_GEN   (hash md5:19c2d66947ab364d67e6dabd25a2b1c0)
Theorem hlt_CONVERGENT_EQ_ZERO_OSCILLATION_GEN : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall m :e hl_ty_metric B, forall f :e B :^: A, forall s :e 2 :^: A, forall a :e A, hl_mcomplete B m = 1 /\ hl_SUBSET B (hl_IMAGE A B f (hl_INTER A (hl_topspace A top) s)) (hl_mspace B m) = 1 -> ((exists l :e B, hl_limit B A (hl_mtopology B m) f l (hl_within A (hl_atpointof A top a) s) = 1) <-> ~ hl_mspace B m = hl_EMPTY B /\ (hl_IN A a (hl_topspace A top) = 1 -> forall e1 :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) e1 = 1 -> exists u :e 2 :^: A, hl_open_in A top u = 1 /\ (hl_IN A a u = 1 /\ forall x y :e A, hl_IN A x (hl_DELETE A (hl_INTER A s u) a) = 1 /\ hl_IN A y (hl_DELETE A (hl_INTER A s u) a) = 1 -> hl_real_lt (hl_mdist B m (hl_pair B B (f x) (f y))) e1 = 1))).
Admitted.

// HOL Light: Multivariate/metric.ml:32467 / GDELTA_IN_POINTS_OF_CONVERGENCE_WITHIN   (hash md5:42d52154f1bfc12894fae3e18979bd72)
Theorem hlt_GDELTA_IN_POINTS_OF_CONVERGENCE_WITHIN : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, forall s :e 2 :^: A, hl_completely_metrizable_space B top' = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top s) top') f = 1 \/ hl_t1_space A top = 1 /\ hl_SUBSET B (hl_IMAGE A B f s) (hl_topspace B top') = 1) -> hl_gdelta_in A top (hl_GSPEC A (fun GEN_PVAR_2105 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_2105 (if hl_IN A x (hl_topspace A top) = 1 /\ exists l :e B, hl_limit B A top' f l (hl_within A (hl_atpointof A top x) s) = 1 then 1 else 0) x = 1 then 1 else 0)) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:32555 / LAVRENTIEV_EXTENSION_GEN   (hash md5:fa277189f69a114499756f93151314fe)
Theorem hlt_LAVRENTIEV_EXTENSION_GEN : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_SUBSET A s (hl_topspace A top) = 1 /\ (hl_completely_metrizable_space B top' = 1 /\ hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top s) top') f = 1) -> exists u :e 2 :^: A, exists g :e B :^: A, hl_gdelta_in A top u = 1 /\ (hl_SUBSET A s u = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top (hl_INTER A (hl_closure_of A top s) u)) top') g = 1 /\ forall x :e A, hl_IN A x s = 1 -> g x = f x)).
Admitted.

// HOL Light: Multivariate/metric.ml:32583 / LAVRENTIEV_EXTENSION   (hash md5:9b0f6a2391d1da721b67a41b37bb83b1)
Theorem hlt_LAVRENTIEV_EXTENSION : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_SUBSET A s (hl_topspace A top) = 1 /\ ((hl_metrizable_space A top = 1 \/ hl_SUBSET A (hl_topspace A top) (hl_closure_of A top s) = 1) /\ (hl_completely_metrizable_space B top' = 1 /\ hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top s) top') f = 1)) -> exists u :e 2 :^: A, exists g :e B :^: A, hl_gdelta_in A top u = 1 /\ (hl_SUBSET A s u = 1 /\ (hl_SUBSET A u (hl_closure_of A top s) = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top u) top') g = 1 /\ forall x :e A, hl_IN A x s = 1 -> g x = f x))).
Admitted.

// HOL Light: Multivariate/metric.ml:32615 / mdiameter   (hash md5:c8100bd2cf227127dfe4ae3909013e1f)
Theorem hlt_mdiameter_thm : forall A:set, A <> Empty -> forall s :e 2 :^: A, forall m :e hl_ty_metric A, hl_mdiameter A m s = hl_COND R (if s = hl_EMPTY A then 1 else 0) (hl_real_of_num (hl_NUMERAL hl_zero)) (hl_sup (hl_GSPEC R (fun GEN_PVAR_2107 :e R => if exists x y :e A, hl_SETSPEC R GEN_PVAR_2107 (if hl_IN A x s = 1 /\ hl_IN A y s = 1 then 1 else 0) (hl_mdist A m (hl_pair A A x y)) = 1 then 1 else 0))).
Admitted.

// HOL Light: Multivariate/metric.ml:32620 / MDIAMETER_EMPTY   (hash md5:58b9cf8bdd976329af1b1a559ca71d7e)
Theorem hlt_MDIAMETER_EMPTY : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, hl_mdiameter A m (hl_EMPTY A) = hl_real_of_num (hl_NUMERAL hl_zero).
Admitted.

// HOL Light: Multivariate/metric.ml:32624 / MDIAMETER_SING   (hash md5:30fb045da3504119bed28428a6ee9cab)
Theorem hlt_MDIAMETER_SING : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall x :e A, hl_IN A x (hl_mspace A m) = 1 -> hl_mdiameter A m (hl_INSERT A x (hl_EMPTY A)) = hl_real_of_num (hl_NUMERAL hl_zero).
Admitted.

// HOL Light: Multivariate/metric.ml:32631 / MDIAMETER_POS_LE   (hash md5:b104aabd01639bbe9b2f0f7d6db6bee2)
Theorem hlt_MDIAMETER_POS_LE : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall s :e 2 :^: A, hl_mbounded A m s = 1 -> hl_real_le (hl_real_of_num (hl_NUMERAL hl_zero)) (hl_mdiameter A m s) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:32648 / MDIAMETER_BOUNDED   (hash md5:49b9df08166aa72a96c099ae225086d4)
Theorem hlt_MDIAMETER_BOUNDED : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall s :e 2 :^: A, hl_mbounded A m s = 1 -> (forall x y :e A, hl_IN A x s = 1 /\ hl_IN A y s = 1 -> hl_real_le (hl_mdist A m (hl_pair A A x y)) (hl_mdiameter A m s) = 1) /\ forall d :e R, hl_real_le (hl_real_of_num (hl_NUMERAL hl_zero)) d = 1 /\ hl_real_lt d (hl_mdiameter A m s) = 1 -> exists x y :e A, hl_IN A x s = 1 /\ (hl_IN A y s = 1 /\ hl_real_gt (hl_mdist A m (hl_pair A A x y)) d = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:32671 / MDIAMETER_BOUNDED_BOUND   (hash md5:c8621528132c5aa924dbc4c72dda5b8e)
Theorem hlt_MDIAMETER_BOUNDED_BOUND : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall s :e 2 :^: A, forall x y :e A, hl_mbounded A m s = 1 /\ (hl_IN A x s = 1 /\ hl_IN A y s = 1) -> hl_real_le (hl_mdist A m (hl_pair A A x y)) (hl_mdiameter A m s) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:32677 / MDIAMETER_LE   (hash md5:159b6677222589e6c38ecb36d798e6c5)
Theorem hlt_MDIAMETER_LE : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall s :e 2 :^: A, forall d :e R, hl_SUBSET A s (hl_mspace A m) = 1 /\ ((~ s = hl_EMPTY A \/ hl_real_le (hl_real_of_num (hl_NUMERAL hl_zero)) d = 1) /\ (forall x y :e A, hl_IN A x s = 1 /\ hl_IN A y s = 1 -> hl_real_le (hl_mdist A m (hl_pair A A x y)) d = 1)) -> hl_real_le (hl_mdiameter A m s) d = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:32688 / MBOUNDED_AND_MDIAMETER_LE   (hash md5:87275699cc9c1588f09011d619ef7a74)
Theorem hlt_MBOUNDED_AND_MDIAMETER_LE : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall s :e 2 :^: A, forall r :e R, hl_SUBSET A s (hl_mspace A m) = 1 -> (hl_mbounded A m s = 1 /\ hl_real_le (hl_mdiameter A m s) r = 1 <-> hl_real_le (hl_real_of_num (hl_NUMERAL hl_zero)) r = 1 /\ forall x y :e A, hl_IN A x s = 1 /\ hl_IN A y s = 1 -> hl_real_le (hl_mdist A m (hl_pair A A x y)) r = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:32705 / MDIAMETER_SUBSET   (hash md5:2fbc6c24f7864f5f1d0742ccaa82aa0a)
Theorem hlt_MDIAMETER_SUBSET : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall s t :e 2 :^: A, hl_SUBSET A s t = 1 /\ hl_mbounded A m t = 1 -> hl_real_le (hl_mdiameter A m s) (hl_mdiameter A m t) = 1.
Admitted.

