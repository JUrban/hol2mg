Theorem hlt_CLOSED_IN_CONNECTED_COMPONENT_OF_SUBTOPOLOGY : forall A:set, A <> Empty -> forall s :e 2 :^: A, forall top :e hl_ty_topology A, forall c :e 2 :^: A, hl_IN (2 :^: A) c (hl_connected_components_of A (hl_subtopology A top s)) = 1 /\ hl_SUBSET A (hl_closure_of A top c) s = 1 -> hl_closed_in A top c = 1.
