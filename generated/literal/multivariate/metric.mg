// HOL Light: Multivariate/metric.ml:22219 / PATH_CONNECTED_IN_EUCLIDEANREAL_INTERVAL   (hash md5:a61368f46552f2aa0b2a95a416198f1d)
Theorem hlt_PATH_CONNECTED_IN_EUCLIDEANREAL_INTERVAL : (forall a b :e R, hl_path_connected_in R hl_euclideanreal (hl_closed_real_interval (hl_CONS (R :*: R) (hl_pair R R a b) (hl_NIL (R :*: R)))) = 1) /\ forall a b :e R, hl_path_connected_in R hl_euclideanreal (hl_open_real_interval (hl_pair R R a b)) = 1.
