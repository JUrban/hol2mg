Theorem hlt_SEPARATION_BY_CLOSED_INTERMEDIATES_GEN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_hereditarily A (hl_normal_space A) top = 1 /\ ~ hl_connected_in A top (hl_DIFF A (hl_topspace A top) s) = 1 -> exists c :e 2 :^: A, hl_closed_in A top c = 1 /\ (hl_SUBSET A c s = 1 /\ forall d :e 2 :^: A, hl_closed_in A top d = 1 /\ (hl_SUBSET A c d = 1 /\ hl_SUBSET A d s = 1) -> ~ hl_connected_in A top (hl_DIFF A (hl_topspace A top) d) = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:49826 / SEPARATION_BY_CLOSED_INTERMEDIATES_EQ_COUNT   (hash md5:d7f5916518947b5c78ef3fb5268318a6)
Theorem hlt_SEPARATION_BY_CLOSED_INTERMEDIATES_EQ_COUNT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, forall n :e omega, hl_locally_connected_space A top = 1 /\ hl_hereditarily A (hl_normal_space A) top = 1 -> ((exists u :e 2 :^: (2 :^: A), hl_HAS_SIZE (2 :^: A) u n = 1 /\ (hl_pairwise (2 :^: A) (hl_separated_in A top) u = 1 /\ ((forall t :e 2 :^: A, hl_IN (2 :^: A) t u = 1 -> ~ t = hl_EMPTY A) /\ hl_UNIONS A u = hl_DIFF A (hl_topspace A top) s))) <-> exists c :e 2 :^: A, hl_closed_in A top c = 1 /\ (hl_SUBSET A c s = 1 /\ forall d :e 2 :^: A, hl_closed_in A top d = 1 /\ (hl_SUBSET A c d = 1 /\ hl_SUBSET A d s = 1) -> exists u :e 2 :^: (2 :^: A), hl_HAS_SIZE (2 :^: A) u n = 1 /\ (hl_pairwise (2 :^: A) (hl_separated_in A top) u = 1 /\ ((forall t :e 2 :^: A, hl_IN (2 :^: A) t u = 1 -> ~ t = hl_EMPTY A) /\ hl_UNIONS A u = hl_DIFF A (hl_topspace A top) d)))).
Admitted.

