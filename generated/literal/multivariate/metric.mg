Theorem hlt_CONNECTED_IN_SUBSET_SEPARATED_UNION : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t c :e 2 :^: A, hl_connected_in A top c = 1 /\ (hl_separated_in A top s t = 1 /\ hl_SUBSET A c (hl_UNION A s t) = 1) -> hl_SUBSET A c s = 1 \/ hl_SUBSET A c t = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:13406 / CONNECTED_IN_NONSEPARATED_UNION   (hash md5:0febd185d75beff9ea5b11986e9c13f1)
Theorem hlt_CONNECTED_IN_NONSEPARATED_UNION : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_connected_in A top s = 1 /\ (hl_connected_in A top t = 1 /\ ~ hl_separated_in A top s t = 1) -> hl_connected_in A top (hl_UNION A s t) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:13423 / CONNECTED_IN_UNIONS_STRONG   (hash md5:f63952815c235dd9b0f69e43020b15f3)
Theorem hlt_CONNECTED_IN_UNIONS_STRONG : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall f :e 2 :^: (2 :^: A), (forall s :e 2 :^: A, hl_IN (2 :^: A) s f = 1 -> hl_connected_in A top s = 1) /\ ~ hl_INTER A (hl_UNIONS A f) (hl_INTERS A (hl_GSPEC (2 :^: A) (fun GEN_PVAR_1667 :e 2 :^: A => if exists s :e 2 :^: A, hl_SETSPEC (2 :^: A) GEN_PVAR_1667 (hl_IN (2 :^: A) s f) (hl_closure_of A top s) = 1 then 1 else 0))) = hl_EMPTY A -> hl_connected_in A top (hl_UNIONS A f) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:13473 / CONNECTED_IN_CHAIN   (hash md5:9dfca09d7bf01ca1bca28925316815e3)
Theorem hlt_CONNECTED_IN_CHAIN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall f :e 2 :^: (2 :^: A), hl_hausdorff_space A top = 1 /\ (~ f = hl_EMPTY (2 :^: A) /\ ((forall s :e 2 :^: A, hl_IN (2 :^: A) s f = 1 -> hl_compact_in A top s = 1 /\ hl_connected_in A top s = 1) /\ (forall s t :e 2 :^: A, hl_IN (2 :^: A) s f = 1 /\ hl_IN (2 :^: A) t f = 1 -> hl_SUBSET A s t = 1 \/ hl_SUBSET A t s = 1))) -> hl_connected_in A top (hl_INTERS A f) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:13645 / CONNECTED_IN_CHAIN_GEN   (hash md5:e353fb236c65ee88989fcbf1aad207e3)
Theorem hlt_CONNECTED_IN_CHAIN_GEN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall f :e 2 :^: (2 :^: A), hl_hausdorff_space A top = 1 /\ ((forall s :e 2 :^: A, hl_IN (2 :^: A) s f = 1 -> hl_closed_in A top s = 1 /\ hl_connected_in A top s = 1) /\ ((exists s :e 2 :^: A, hl_IN (2 :^: A) s f = 1 /\ hl_compact_in A top s = 1) /\ (forall s t :e 2 :^: A, hl_IN (2 :^: A) s f = 1 /\ hl_IN (2 :^: A) t f = 1 -> hl_SUBSET A s t = 1 \/ hl_SUBSET A t s = 1))) -> hl_connected_in A top (hl_INTERS A f) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:13672 / CONNECTED_IN_NEST   (hash md5:adfdac0cbcda205684dc0128cbc8e8d4)
Theorem hlt_CONNECTED_IN_NEST : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A :^: omega, hl_hausdorff_space A top = 1 /\ ((forall n :e omega, hl_compact_in A top (s n) = 1 /\ hl_connected_in A top (s n) = 1) /\ (forall m n :e omega, hl_le m n = 1 -> hl_SUBSET A (s n) (s m) = 1)) -> hl_connected_in A top (hl_INTERS A (hl_GSPEC (2 :^: A) (fun GEN_PVAR_1668 :e 2 :^: A => if exists n :e omega, hl_SETSPEC (2 :^: A) GEN_PVAR_1668 (hl_IN omega n (hl_UNIV omega)) (s n) = 1 then 1 else 0))) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:13685 / CONNECTED_IN_NEST_GEN   (hash md5:d5400ee70f85a11b5f3e27aadfa7f335)
Theorem hlt_CONNECTED_IN_NEST_GEN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A :^: omega, hl_hausdorff_space A top = 1 /\ ((forall n :e omega, hl_closed_in A top (s n) = 1 /\ hl_connected_in A top (s n) = 1) /\ ((exists n :e omega, hl_compact_in A top (s n) = 1) /\ (forall m n :e omega, hl_le m n = 1 -> hl_SUBSET A (s n) (s m) = 1))) -> hl_connected_in A top (hl_INTERS A (hl_GSPEC (2 :^: A) (fun GEN_PVAR_1669 :e 2 :^: A => if exists n :e omega, hl_SETSPEC (2 :^: A) GEN_PVAR_1669 (hl_IN omega n (hl_UNIV omega)) (s n) = 1 then 1 else 0))) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:13700 / CONNECTED_IN_EQ_SUBSET_SEPARATED_UNION   (hash md5:61c75d61c5a517834715dc858f56205f)
Theorem hlt_CONNECTED_IN_EQ_SUBSET_SEPARATED_UNION : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall c :e 2 :^: A, hl_connected_in A top c = 1 <-> hl_SUBSET A c (hl_topspace A top) = 1 /\ forall s t :e 2 :^: A, hl_separated_in A top s t = 1 /\ hl_SUBSET A c (hl_UNION A s t) = 1 -> hl_SUBSET A c s = 1 \/ hl_SUBSET A c t = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:13717 / CONNECTED_IN_CLOPEN_CASES   (hash md5:931aa446fb1edf30d84a914ac8f212c2)
Theorem hlt_CONNECTED_IN_CLOPEN_CASES : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall c t :e 2 :^: A, hl_connected_in A top c = 1 /\ (hl_closed_in A top t = 1 /\ hl_open_in A top t = 1) -> hl_SUBSET A c t = 1 \/ hl_DISJOINT A c t = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:13728 / CONNECTED_SPACE_CLOSURES   (hash md5:b1985af3eeb615a861184e5908541780)
Theorem hlt_CONNECTED_SPACE_CLOSURES : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_connected_space A top = 1 <-> ~ exists e1 e2 :e 2 :^: A, hl_UNION A e1 e2 = hl_topspace A top /\ (hl_INTER A (hl_closure_of A top e1) (hl_closure_of A top e2) = hl_EMPTY A /\ (~ e1 = hl_EMPTY A /\ ~ e2 = hl_EMPTY A)).
Admitted.

// HOL Light: Multivariate/metric.ml:13749 / CONNECTED_IN_INTER_FRONTIER_OF   (hash md5:74c26033ebba6ba7cef583d4d813b37c)
Theorem hlt_CONNECTED_IN_INTER_FRONTIER_OF : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_connected_in A top s = 1 /\ (~ hl_INTER A s t = hl_EMPTY A /\ ~ hl_DIFF A s t = hl_EMPTY A) -> ~ hl_INTER A s (hl_frontier_of A top t) = hl_EMPTY A.
Admitted.

// HOL Light: Multivariate/metric.ml:13775 / CONNECTED_IN_CONTINUOUS_MAP_IMAGE   (hash md5:aa7d9b146c85e5666e7b5975d8a9f3fc)
Theorem hlt_CONNECTED_IN_CONTINUOUS_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall f :e B :^: A, forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall s :e 2 :^: A, hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_connected_in A top s = 1 -> hl_connected_in B top' (hl_IMAGE A B f s) = 1.
Admitted.

