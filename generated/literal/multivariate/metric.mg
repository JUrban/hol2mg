Theorem hlt_FORALL_OPEN_IN : forall A:set, A <> Empty -> forall P :e 2 :^: (2 :^: A), forall top :e hl_ty_topology A, (forall s :e 2 :^: A, hl_open_in A top s = 1 -> P s = 1) <-> forall s :e 2 :^: A, hl_closed_in A top s = 1 -> P (hl_DIFF A (hl_topspace A top) s) = 1.
