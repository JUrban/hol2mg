Theorem hlt_CLOSURE_OF_SUBTOPOLOGY_MONO : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t u :e 2 :^: A, hl_SUBSET A t u = 1 -> hl_SUBSET A (hl_closure_of A (hl_subtopology A top t) s) (hl_closure_of A (hl_subtopology A top u) s) = 1.
