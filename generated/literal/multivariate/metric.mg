Theorem hlt_INTERIOR_OF_CLOSURE_OF : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_interior_of A top s = hl_DIFF A (hl_topspace A top) (hl_closure_of A top (hl_DIFF A (hl_topspace A top) s)).
Admitted.

// HOL Light: Multivariate/metric.ml:1592 / CLOSURE_OF_INTERIOR_OF   (hash md5:0e1ba30572840f428363ac85789ae21f)
Theorem hlt_CLOSURE_OF_INTERIOR_OF : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_closure_of A top s = hl_DIFF A (hl_topspace A top) (hl_interior_of A top (hl_DIFF A (hl_topspace A top) s)).
Admitted.

// HOL Light: Multivariate/metric.ml:1600 / CLOSURE_OF_COMPLEMENT   (hash md5:6006445038eba356750b5276da9a1a8c)
Theorem hlt_CLOSURE_OF_COMPLEMENT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_closure_of A top (hl_DIFF A (hl_topspace A top) s) = hl_DIFF A (hl_topspace A top) (hl_interior_of A top s).
