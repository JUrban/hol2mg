// HOL Light: Multivariate/metric.ml:22061 / path_connected_space   (hash md5:f7d1151c8c9b17acb2d914c9f999f2ac)
Theorem hlt_path_connected_space_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_path_connected_space A top = 1 <-> forall x y :e A, hl_IN A x (hl_topspace A top) = 1 /\ hl_IN A y (hl_topspace A top) = 1 -> exists g :e A :^: R, hl_path_in A top g = 1 /\ (g (hl_real_of_num (hl_NUMERAL hl_zero)) = x /\ g (hl_real_of_num (hl_NUMERAL (hl_BIT1 hl_zero))) = y).
