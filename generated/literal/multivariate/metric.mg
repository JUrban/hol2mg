// HOL Light: Multivariate/metric.ml:877 / MINIMAL_TOPOLOGY_SUBBASE   (hash md5:edc7c195144e418b48988997303555ef)
Theorem hlt_MINIMAL_TOPOLOGY_SUBBASE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall u :e 2 :^: A, forall P :e 2 :^: (2 :^: A), (forall s :e 2 :^: A, P s = 1 -> hl_open_in A top s = 1) /\ hl_open_in A top u = 1 -> forall s :e 2 :^: A, hl_open_in A (hl_topology A (hl_UNION_OF A (hl_ARBITRARY A) (hl_relative_to A (hl_INTERSECTION_OF A (hl_FINITE (2 :^: A)) P) u))) s = 1 -> hl_open_in A top s = 1.
