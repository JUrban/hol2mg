// HOL Light: Multivariate/metric.ml:30975 / LIPSCHITZ_COEFFICIENT_POS   (hash md5:6c9746f3ffb263ecc2bae1ee36a5a186)
Theorem hlt_LIPSCHITZ_COEFFICIENT_POS : forall A B:set, A <> Empty -> B <> Empty -> forall m :e hl_ty_metric A, forall m' :e hl_ty_metric B, forall f :e B :^: A, forall k :e R, (forall x :e A, hl_IN A x (hl_mspace A m) = 1 -> hl_IN B (f x) (hl_mspace B m') = 1) /\ ((forall x y :e A, hl_IN A x (hl_mspace A m) = 1 /\ hl_IN A y (hl_mspace A m) = 1 -> hl_real_le (hl_mdist B m' (hl_pair B B (f x) (f y))) (hl_real_mul k (hl_mdist A m (hl_pair A A x y))) = 1) /\ (exists x y :e A, hl_IN A x (hl_mspace A m) = 1 /\ (hl_IN A y (hl_mspace A m) = 1 /\ ~ f x = f y))) -> hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) k = 1.
Admitted.

