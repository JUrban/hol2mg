// HOL Light: Multivariate/metric.ml:17504 / LOCALLY_COMPACT_SPACE_PERFECT_MAP_IMAGE_EQ   (hash md5:435d5290606a298d605ebe64c12095fe)
Theorem hlt_LOCALLY_COMPACT_SPACE_PERFECT_MAP_IMAGE_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, (hl_hausdorff_space A top = 1 \/ hl_regular_space A top = 1) /\ hl_perfect_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 -> (hl_locally_compact_space A top = 1 <-> hl_locally_compact_space B top' = 1).
