Theorem hlt_SEPARATED_BETWEEN_EMPTY : forall A:set, A <> Empty -> (forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_separated_between A top (hl_EMPTY A) s = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1) /\ forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_separated_between A top s (hl_EMPTY A) = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1.
