Theorem hlt_CLOSED_IN_SUBTOPOLOGY_DIFF_OPEN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_SUBSET A s (hl_topspace A top) = 1 /\ hl_open_in A top t = 1 -> hl_closed_in A (hl_subtopology A top s) (hl_DIFF A s t) = 1.
