// HOL Light: Multivariate/metric.ml:13090 / CONNECTED_IN_SUBTOPOLOGY   (hash md5:de75415dad9d60d19ed99ed06cb57251)
Theorem hlt_CONNECTED_IN_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_connected_in A (hl_subtopology A top s) t = 1 <-> hl_connected_in A top t = 1 /\ hl_SUBSET A t s = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:13099 / CONNECTED_SPACE_EQ   (hash md5:c4e0faf749bf622c2d33aec8a757cb55)
Theorem hlt_CONNECTED_SPACE_EQ : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_connected_space A top = 1 <-> ~ exists e1 e2 :e 2 :^: A, hl_open_in A top e1 = 1 /\ (hl_open_in A top e2 = 1 /\ (hl_UNION A e1 e2 = hl_topspace A top /\ (hl_INTER A e1 e2 = hl_EMPTY A /\ (~ e1 = hl_EMPTY A /\ ~ e2 = hl_EMPTY A)))).
Admitted.

// HOL Light: Multivariate/metric.ml:13109 / CONNECTED_SPACE_CLOSED_IN   (hash md5:697e2b461344b4c163a13f58b64300dd)
Theorem hlt_CONNECTED_SPACE_CLOSED_IN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_connected_space A top = 1 <-> ~ exists e1 e2 :e 2 :^: A, hl_closed_in A top e1 = 1 /\ (hl_closed_in A top e2 = 1 /\ (hl_SUBSET A (hl_topspace A top) (hl_UNION A e1 e2) = 1 /\ (hl_INTER A e1 e2 = hl_EMPTY A /\ (~ e1 = hl_EMPTY A /\ ~ e2 = hl_EMPTY A)))).
Admitted.

