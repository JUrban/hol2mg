Theorem hlt_TIETZE_EXTENSION_CLOSED_REAL_INTERVAL : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall f :e R :^: A, forall s :e 2 :^: A, forall a b :e R, hl_normal_space A top = 1 /\ (hl_closed_in A top s = 1 /\ (hl_real_le a b = 1 /\ (hl_continuous_map A R (hl_pair (hl_ty_topology A) (hl_ty_topology R) (hl_subtopology A top s) hl_euclideanreal) f = 1 /\ (forall x :e A, hl_IN A x s = 1 -> hl_IN R (f x) (hl_closed_real_interval (hl_CONS (R :*: R) (hl_pair R R a b) (hl_NIL (R :*: R)))) = 1)))) -> exists g :e R :^: A, hl_continuous_map A R (hl_pair (hl_ty_topology A) (hl_ty_topology R) top hl_euclideanreal) g = 1 /\ ((forall x :e A, hl_IN A x (hl_topspace A top) = 1 -> hl_IN R (g x) (hl_closed_real_interval (hl_CONS (R :*: R) (hl_pair R R a b) (hl_NIL (R :*: R)))) = 1) /\ forall x :e A, hl_IN A x s = 1 -> g x = f x).
Admitted.

