// HOL Light: Multivariate/metric.ml:13353 / CONNECTED_IN_EQ_NOT_SEPARATED   (hash md5:150f526b04d9cf93905a27c25c5ee1a2)
Theorem hlt_CONNECTED_IN_EQ_NOT_SEPARATED : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_connected_in A top s = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1 /\ ~ exists c1 c2 :e 2 :^: A, hl_UNION A c1 c2 = s /\ (~ c1 = hl_EMPTY A /\ (~ c2 = hl_EMPTY A /\ hl_separated_in A top c1 c2 = 1)).
