// HOL Light: Multivariate/metric.ml:26574 / QUASI_COMPONENTS_OF_SUBSET_SING   (hash md5:0d060ed578128fe2c083de6f6211622c)
Theorem hlt_QUASI_COMPONENTS_OF_SUBSET_SING : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_SUBSET (2 :^: A) (hl_quasi_components_of A top) (hl_INSERT (2 :^: A) s (hl_EMPTY (2 :^: A))) = 1 <-> hl_connected_space A top = 1 /\ (hl_topspace A top = hl_EMPTY A \/ hl_topspace A top = s).
