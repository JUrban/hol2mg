// HOL Light: Multivariate/metric.ml:176 / CLOSED_IN_INTERS   (hash md5:343b1d26ca2d25f671374859ef172416)
Theorem hlt_CLOSED_IN_INTERS : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall k :e 2 :^: (2 :^: A), ~ k = hl_EMPTY (2 :^: A) /\ (forall s :e 2 :^: A, hl_IN (2 :^: A) s k = 1 -> hl_closed_in A top s = 1) -> hl_closed_in A top (hl_INTERS A k) = 1.
