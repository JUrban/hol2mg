Theorem hlt_INTERIOR_OF_RESTRICT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_interior_of A top s = hl_interior_of A top (hl_INTER A (hl_topspace A top) s).
