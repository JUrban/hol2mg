Admitted.

// HOL Light: Multivariate/metric.ml:20652 / MBALL_INTER_DSEPARATED_SINGLETON   (hash md5:16b01b2db0836234df1db5a54917fd22)
Theorem hlt_MBALL_INTER_DSEPARATED_SINGLETON : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall s t :e 2 :^: A, forall d :e R, forall x y :e A, hl_SUBSET A t s = 1 /\ (hl_SUBSET A s (hl_mspace A m) = 1 /\ (hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) d = 1 /\ ((forall a b :e A, hl_IN A a t = 1 /\ (hl_IN A b t = 1 /\ ~ a = b) -> hl_real_ge (hl_mdist A m (hl_pair A A a b)) d = 1) /\ (hl_IN A x (hl_mspace A m) = 1 /\ hl_IN A y (hl_INTER A (hl_mball A m (hl_pair A R x (hl_real_div d (hl_real_of_num (hl_NUMERAL (hl_BIT0 (hl_BIT1 hl_zero))))))) t) = 1)))) -> hl_INTER A (hl_mball A m (hl_pair A R x (hl_real_div d (hl_real_of_num (hl_NUMERAL (hl_BIT0 (hl_BIT1 hl_zero))))))) t = hl_INSERT A y (hl_EMPTY A).
Admitted.

// HOL Light: Multivariate/metric.ml:20675 / TOTALLY_BOUNDED_IMP_DISCRETE_FINITE   (hash md5:13a186a5fd88c401e98391e69631845d)
Theorem hlt_TOTALLY_BOUNDED_IMP_DISCRETE_FINITE : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall s t :e 2 :^: A, forall d :e R, hl_totally_bounded_in A m s = 1 /\ (hl_SUBSET A t s = 1 /\ (hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) d = 1 /\ (forall x y :e A, hl_IN A x t = 1 /\ (hl_IN A y t = 1 /\ ~ x = y) -> hl_real_ge (hl_mdist A m (hl_pair A A x y)) d = 1))) -> hl_FINITE A t = 1.
Admitted.

