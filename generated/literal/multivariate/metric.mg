// HOL Light: Multivariate/metric.ml:18468 / atpointof   (hash md5:7055b3e35faa29fa186a5a2f0fa730c1)
Theorem hlt_atpointof_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall a :e A, hl_atpointof A top a = hl_mk_net A (hl_pair (2 :^: (2 :^: A)) (2 :^: A) (hl_GSPEC (2 :^: A) (fun GEN_PVAR_1817 :e 2 :^: A => if exists u :e 2 :^: A, hl_SETSPEC (2 :^: A) GEN_PVAR_1817 (if hl_open_in A top u = 1 /\ hl_IN A a u = 1 then 1 else 0) u = 1 then 1 else 0)) (hl_INSERT A a (hl_EMPTY A))).
Admitted.

// HOL Light: Multivariate/metric.ml:18471 / ATPOINTOF   (hash md5:7b1e4738cdcb1171df1ec3dc24d5922b)
Theorem hlt_ATPOINTOF : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall a :e A, hl_netfilter A (hl_atpointof A top a) = hl_GSPEC (2 :^: A) (fun GEN_PVAR_1818 :e 2 :^: A => if exists u :e 2 :^: A, hl_SETSPEC (2 :^: A) GEN_PVAR_1818 (if hl_open_in A top u = 1 /\ hl_IN A a u = 1 then 1 else 0) u = 1 then 1 else 0).
Admitted.

// HOL Light: Multivariate/metric.ml:18471 / NETLIMITS_ATPOINTOF   (hash md5:593e7aa53f8767af4217a65478b2c301)
Theorem hlt_NETLIMITS_ATPOINTOF : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall a :e A, hl_netlimits A (hl_atpointof A top a) = hl_INSERT A a (hl_EMPTY A).
Admitted.

// HOL Light: Multivariate/metric.ml:18483 / NETLIMIT_ATPOINTOF   (hash md5:30834302088092060d8683428f8ff049)
Theorem hlt_NETLIMIT_ATPOINTOF : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall a :e A, hl_netlimit A (hl_atpointof A top a) = a.
Admitted.

// HOL Light: Multivariate/metric.ml:18487 / EVENTUALLY_ATPOINTOF   (hash md5:8a90740a3af778e72652521cf3736804)
Theorem hlt_EVENTUALLY_ATPOINTOF : forall A:set, A <> Empty -> forall P :e 2 :^: A, forall top :e hl_ty_topology A, forall a :e A, hl_eventually A P (hl_atpointof A top a) = 1 <-> ~ hl_IN A a (hl_topspace A top) = 1 \/ exists u :e 2 :^: A, hl_open_in A top u = 1 /\ (hl_IN A a u = 1 /\ forall x :e A, hl_IN A x (hl_DELETE A u a) = 1 -> P x = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:18499 / ATPOINTOF_WITHIN_TRIVIAL   (hash md5:f40630d2a18473273e73695564a18169)
Theorem hlt_ATPOINTOF_WITHIN_TRIVIAL : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall u :e 2 :^: A, forall a :e A, hl_SUBSET A (hl_topspace A top) u = 1 -> hl_within A (hl_atpointof A top a) u = hl_atpointof A top a.
Admitted.

// HOL Light: Multivariate/metric.ml:18514 / ATPOINTOF_WITHIN_TOPSPACE   (hash md5:7cb935975373ee322dde66c7998b731d)
Theorem hlt_ATPOINTOF_WITHIN_TOPSPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall a :e A, hl_within A (hl_atpointof A top a) (hl_topspace A top) = hl_atpointof A top a.
Admitted.

// HOL Light: Multivariate/metric.ml:18518 / TRIVIAL_LIMIT_ATPOINTOF_WITHIN   (hash md5:7cef8bad693c5ef36b76615878c5a6e3)
Theorem hlt_TRIVIAL_LIMIT_ATPOINTOF_WITHIN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, forall a :e A, hl_trivial_limit A (hl_within A (hl_atpointof A top a) s) = 1 <-> ~ hl_IN A a (hl_derived_set_of A top s) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:18528 / DERIVED_SET_OF_TRIVIAL_LIMIT   (hash md5:3849a6840bfb91e7fc3004014fe8cf2c)
Theorem hlt_DERIVED_SET_OF_TRIVIAL_LIMIT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, forall a :e A, hl_IN A a (hl_derived_set_of A top s) = 1 <-> ~ hl_trivial_limit A (hl_within A (hl_atpointof A top a) s) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:18533 / TRIVIAL_LIMIT_ATPOINTOF   (hash md5:d24786110750a340ebf422d80729cc8c)
Theorem hlt_TRIVIAL_LIMIT_ATPOINTOF : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall a :e A, hl_trivial_limit A (hl_atpointof A top a) = 1 <-> ~ hl_IN A a (hl_derived_set_of A top (hl_topspace A top)) = 1.
