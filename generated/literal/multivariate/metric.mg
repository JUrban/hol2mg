// HOL Light: Multivariate/metric.ml:23530 / NORMAL_SPACE   (hash md5:6c8db94b304c54c6763db45890a625b3)
Theorem hlt_NORMAL_SPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_normal_space A top = 1 <-> forall s t :e 2 :^: A, hl_closed_in A top s = 1 /\ (hl_closed_in A top t = 1 /\ hl_DISJOINT A s t = 1) -> exists u :e 2 :^: A, hl_open_in A top u = 1 /\ (hl_SUBSET A s u = 1 /\ hl_DISJOINT A t (hl_closure_of A top u) = 1).
Admitted.

