Theorem hlt_MBOUNDED_IMP_IN_MSPACE : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall s :e 2 :^: A, forall x :e A, hl_mbounded A m s = 1 /\ hl_IN A x s = 1 -> hl_IN A x (hl_mspace A m) = 1.
