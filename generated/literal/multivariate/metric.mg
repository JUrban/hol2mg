// HOL Light: Multivariate/metric.ml:11575 / is_metric_space   (hash md5:de33a1978776f9c63f92642fb0047670)
Theorem hlt_is_metric_space_thm : forall A:set, A <> Empty -> forall s :e 2 :^: A, forall d :e R :^: (A :*: A), hl_is_metric_space A (hl_pair (2 :^: A) (R :^: (A :*: A)) s d) = 1 <-> (forall x y :e A, hl_IN A x s = 1 /\ hl_IN A y s = 1 -> hl_real_le (hl_real_of_num (hl_NUMERAL hl_zero)) (d (hl_pair A A x y)) = 1) /\ ((forall x y :e A, hl_IN A x s = 1 /\ hl_IN A y s = 1 -> (d (hl_pair A A x y) = hl_real_of_num (hl_NUMERAL hl_zero) <-> x = y)) /\ ((forall x y :e A, hl_IN A x s = 1 /\ hl_IN A y s = 1 -> d (hl_pair A A x y) = d (hl_pair A A y x)) /\ forall x y z :e A, hl_IN A x s = 1 /\ (hl_IN A y s = 1 /\ hl_IN A z s = 1) -> hl_real_le (d (hl_pair A A x z)) (hl_real_add (d (hl_pair A A x y)) (d (hl_pair A A y z))) = 1)).
Admitted.

// HOL Light: Multivariate/metric.ml:11582 / IS_METRIC_SPACE   (hash md5:8279baa69296b7c64db4900c9b8bb119)
Theorem hlt_IS_METRIC_SPACE : forall A:set, A <> Empty -> forall s :e 2 :^: A, forall d :e R :^: (A :*: A), hl_is_metric_space A (hl_pair (2 :^: A) (R :^: (A :*: A)) s d) = 1 <-> (forall x y :e A, hl_IN A x s = 1 /\ hl_IN A y s = 1 -> (d (hl_pair A A x y) = hl_real_of_num (hl_NUMERAL hl_zero) <-> x = y)) /\ forall x y z :e A, hl_IN A x s = 1 /\ (hl_IN A y s = 1 /\ hl_IN A z s = 1) -> hl_real_le (d (hl_pair A A x z)) (hl_real_add (d (hl_pair A A y x)) (d (hl_pair A A y z))) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:11597 / metric_tybij   (hash md5:e783c59972e20f15bb3bfe87b5dfe4bb)
Theorem hlt_metric_tybij : forall A:set, A <> Empty -> (forall a :e hl_ty_metric A, hl_metric A (hl_dest_metric A a) = a) /\ forall r :e 2 :^: A :*: R :^: (A :*: A), hl_is_metric_space A r = 1 <-> hl_dest_metric A (hl_metric A r) = r.
Admitted.

// HOL Light: Multivariate/metric.ml:11603 / IS_METRIC_SPACE_SUBSPACE   (hash md5:308929510de82fc6100d2e7394ebcbfe)
Theorem hlt_IS_METRIC_SPACE_SUBSPACE : forall A:set, A <> Empty -> forall s :e 2 :^: A, forall d :e R :^: (A :*: A), hl_is_metric_space A (hl_pair (2 :^: A) (R :^: (A :*: A)) s d) = 1 -> forall s' :e 2 :^: A, hl_SUBSET A s' s = 1 -> hl_is_metric_space A (hl_pair (2 :^: A) (R :^: (A :*: A)) s' d) = 1.
