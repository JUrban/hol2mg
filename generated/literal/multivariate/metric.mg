// HOL Light: Multivariate/metric.ml:1096 / IN_CLOSURE_OF   (hash md5:6290b02bf42d02f52273685308befe97)
Theorem hlt_IN_CLOSURE_OF : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, forall x :e A, hl_IN A x (hl_closure_of A top s) = 1 <-> hl_IN A x (hl_topspace A top) = 1 /\ forall t :e 2 :^: A, hl_IN A x t = 1 /\ hl_open_in A top t = 1 -> exists y :e A, hl_IN A y s = 1 /\ hl_IN A y t = 1.
