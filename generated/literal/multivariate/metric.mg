Theorem hlt_LOCALLY_COMPACT_SPACE_PERFECT_MAP_PREIMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_locally_compact_space B top' = 1 /\ hl_perfect_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 -> hl_locally_compact_space A top = 1.
