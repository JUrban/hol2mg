// HOL Light: Multivariate/metric.ml:127 / OPEN_IN_INTERS   (hash md5:3fff732c16bff43d68e17bc42967f01f)
Theorem hlt_OPEN_IN_INTERS : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: (2 :^: A), hl_FINITE (2 :^: A) s = 1 /\ (~ s = hl_EMPTY (2 :^: A) /\ (forall t :e 2 :^: A, hl_IN (2 :^: A) t s = 1 -> hl_open_in A top t = 1)) -> hl_open_in A top (hl_INTERS A s) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:139 / OPEN_IN_SUBOPEN   (hash md5:91a253c4b68db0ade774915722fb0b9b)
Theorem hlt_OPEN_IN_SUBOPEN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_open_in A top s = 1 <-> forall x :e A, hl_IN A x s = 1 -> exists t :e 2 :^: A, hl_open_in A top t = 1 /\ (hl_IN A x t = 1 /\ hl_SUBSET A t s = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:155 / closed_in   (hash md5:a83e192ba906dbf1d4a447f88e13851a)
Theorem hlt_closed_in_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_closed_in A top s = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1 /\ hl_open_in A top (hl_DIFF A (hl_topspace A top) s) = 1.
Admitted.

