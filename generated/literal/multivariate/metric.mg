Theorem hlt_REALLIM_SUB : forall A:set, A <> Empty -> forall net1 :e hl_ty_net A, forall f g :e R :^: A, forall l m :e R, hl_tendsto_real A f l net1 = 1 /\ hl_tendsto_real A g m net1 = 1 -> hl_tendsto_real A (fun x :e A => hl_real_sub (f x) (g x)) (hl_real_sub l m) net1 = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:21893 / REALLIM_UBOUND   (hash md5:41456f2ce4e274f38ae86a79bd3eed58)
Theorem hlt_REALLIM_UBOUND : forall A:set, A <> Empty -> forall net1 :e hl_ty_net A, forall f :e R :^: A, forall l b :e R, hl_tendsto_real A f l net1 = 1 /\ (~ hl_trivial_limit A net1 = 1 /\ hl_eventually A (fun x :e A => hl_real_le (f x) b) net1 = 1) -> hl_real_le l b = 1.
