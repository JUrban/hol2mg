Admitted.

// HOL Light: Multivariate/metric.ml:25392 / LOCALLY_PATH_CONNECTED_SPACE_RETRACTION_MAP_IMAGE   (hash md5:036c0253be58f411ab0d0455468f3218)
Theorem hlt_LOCALLY_PATH_CONNECTED_SPACE_RETRACTION_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall r :e B :^: A, hl_retraction_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') r = 1 /\ hl_locally_path_connected_space A top = 1 -> hl_locally_path_connected_space B top' = 1.
Admitted.

