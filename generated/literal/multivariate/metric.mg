// HOL Light: Multivariate/metric.ml:859 / TOPSPACE_SUBBASE   (hash md5:7c4601562e552edba00d97614d9a1586)
Theorem hlt_TOPSPACE_SUBBASE : forall A:set, A <> Empty -> forall B :e 2 :^: (2 :^: A), forall u :e 2 :^: A, hl_topspace A (hl_topology A (hl_UNION_OF A (hl_ARBITRARY A) (hl_relative_to A (hl_INTERSECTION_OF A (hl_FINITE (2 :^: A)) B) u))) = u.
