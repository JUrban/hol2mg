Theorem hlt_CLOSED_IN_SUM_TOPOLOGY_ALT : forall A K:set, A <> Empty -> K <> Empty -> forall k :e 2 :^: K, forall top :e hl_ty_topology A :^: K, forall u :e 2 :^: (K :*: A), hl_closed_in (K :*: A) (hl_sum_topology K A k top) u = 1 <-> exists t :e 2 :^: A :^: K, u = hl_disjoint_union K A k t /\ forall i :e K, hl_IN K i k = 1 -> hl_closed_in A (top i) (t i) = 1.
