// HOL Light: Multivariate/metric.ml:22047 / PATH_IN_SUBTOPOLOGY   (hash md5:27762af9dd6912ff2f781f2eba5eb838)
Theorem hlt_PATH_IN_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, forall g :e A :^: R, hl_path_in A (hl_subtopology A top s) g = 1 <-> hl_path_in A top g = 1 /\ forall x :e R, hl_IN R x (hl_closed_real_interval (hl_CONS (R :*: R) (hl_pair R R (hl_real_of_num (hl_NUMERAL hl_zero)) (hl_real_of_num (hl_NUMERAL (hl_BIT1 hl_zero)))) (hl_NIL (R :*: R)))) = 1 -> hl_IN A (g x) s = 1.
