// HOL Light: Multivariate/metric.ml:23495 / NORMAL_SPACE_RETRACTION_MAP_IMAGE   (hash md5:63f72014dbd7becc39139f9051ab7f72)
Theorem hlt_NORMAL_SPACE_RETRACTION_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall r :e B :^: A, hl_retraction_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') r = 1 /\ hl_normal_space A top = 1 -> hl_normal_space B top' = 1.
Admitted.

