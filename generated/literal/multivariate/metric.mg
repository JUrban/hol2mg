Theorem hlt_CLOSED_IN_UNIONS : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: (2 :^: A), hl_FINITE (2 :^: A) s = 1 /\ (forall t :e 2 :^: A, hl_IN (2 :^: A) t s = 1 -> hl_closed_in A top t = 1) -> hl_closed_in A top (hl_UNIONS A s) = 1.
Admitted.

