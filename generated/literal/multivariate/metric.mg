Theorem hlt_mtopology_thm : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, hl_mtopology A m = hl_topology A (hl_GSPEC (2 :^: A) (fun GEN_PVAR_1639 :e 2 :^: A => if exists u :e 2 :^: A, hl_SETSPEC (2 :^: A) GEN_PVAR_1639 (if hl_SUBSET A u (hl_mspace A m) = 1 /\ forall x :e A, hl_IN A x u = 1 -> exists r :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) r = 1 /\ hl_SUBSET A (hl_mball A m (hl_pair A R x r)) u = 1 then 1 else 0) u = 1 then 1 else 0)).
