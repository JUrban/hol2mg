Theorem hlt_HEREDITARILY_NORMAL_SEPARATION : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_hereditarily A (hl_normal_space A) top = 1 <-> forall s t :e 2 :^: A, hl_separated_in A top s t = 1 -> exists u v :e 2 :^: A, hl_open_in A top u = 1 /\ (hl_open_in A top v = 1 /\ (hl_SUBSET A s u = 1 /\ (hl_SUBSET A t v = 1 /\ hl_DISJOINT A u v = 1))).
Admitted.

// HOL Light: Multivariate/metric.ml:24643 / HEREDITARILY_NORMAL_SPACE   (hash md5:64f1c89e1bfbfbc93321299ae0470a74)
Theorem hlt_HEREDITARILY_NORMAL_SPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_hereditarily A (hl_normal_space A) top = 1 <-> forall u :e 2 :^: A, hl_open_in A top u = 1 -> hl_normal_space A (hl_subtopology A top u) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:24695 / METRIZABLE_IMP_HEREDITARILY_NORMAL_SPACE   (hash md5:1208cf604d1fdab9ae0a2321ab883a7d)
Theorem hlt_METRIZABLE_IMP_HEREDITARILY_NORMAL_SPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_metrizable_space A top = 1 -> hl_hereditarily A (hl_normal_space A) top = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:24700 / METRIZABLE_SPACE_SEPARATION   (hash md5:9b8d1c2cc5d346d29bff96005193319e)
Theorem hlt_METRIZABLE_SPACE_SEPARATION : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_metrizable_space A top = 1 /\ hl_separated_in A top s t = 1 -> exists u v :e 2 :^: A, hl_open_in A top u = 1 /\ (hl_open_in A top v = 1 /\ (hl_SUBSET A s u = 1 /\ (hl_SUBSET A t v = 1 /\ hl_DISJOINT A u v = 1))).
Admitted.

// HOL Light: Multivariate/metric.ml:24709 / HEREDITARILY_NORMAL_SEPARATION_PAIRWISE   (hash md5:a017fbe444687420c5e513c84574f075)
Theorem hlt_HEREDITARILY_NORMAL_SEPARATION_PAIRWISE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_hereditarily A (hl_normal_space A) top = 1 <-> forall u :e 2 :^: (2 :^: A), hl_FINITE (2 :^: A) u = 1 /\ ((forall s :e 2 :^: A, hl_IN (2 :^: A) s u = 1 -> hl_SUBSET A s (hl_topspace A top) = 1) /\ hl_pairwise (2 :^: A) (hl_separated_in A top) u = 1) -> exists f :e 2 :^: A :^: (2 :^: A), (forall s :e 2 :^: A, hl_IN (2 :^: A) s u = 1 -> hl_open_in A top (f s) = 1 /\ hl_SUBSET A s (f s) = 1) /\ hl_pairwise (2 :^: A) (fun s :e 2 :^: A => fun t :e 2 :^: A => hl_DISJOINT A (f s) (f t)) u = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:24757 / HEREDITARILY_NORMAL_SPACE_PERFECT_MAP_IMAGE   (hash md5:831b62a34b771e97a898dbc961b497ef)
Theorem hlt_HEREDITARILY_NORMAL_SPACE_PERFECT_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_hereditarily A (hl_normal_space A) top = 1 /\ hl_perfect_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 -> hl_hereditarily B (hl_normal_space B) top' = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:24764 / REGULAR_SECOND_COUNTABLE_IMP_HEREDITARILY_NORMAL_SPACE   (hash md5:2cb4988f76a4e3111700fe65e279d4a6)
Theorem hlt_REGULAR_SECOND_COUNTABLE_IMP_HEREDITARILY_NORMAL_SPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_regular_space A top = 1 /\ hl_second_countable A top = 1 -> hl_hereditarily A (hl_normal_space A) top = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:24774 / REGULAR_SECOND_COUNTABLE_HAUSDORFF_IMP_NORMAL_SPACE   (hash md5:cbe0cda785af70212057ae80e6c751f5)
Theorem hlt_REGULAR_SECOND_COUNTABLE_HAUSDORFF_IMP_NORMAL_SPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_regular_space A top = 1 /\ (hl_second_countable A top = 1 /\ hl_hausdorff_space A top = 1) -> hl_normal_space A top = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:24785 / completely_regular_space   (hash md5:9d2c4b35741ae9f464d5a9648963d4da)
Theorem hlt_completely_regular_space_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_completely_regular_space A top = 1 <-> forall s :e 2 :^: A, forall x :e A, hl_closed_in A top s = 1 /\ hl_IN A x (hl_DIFF A (hl_topspace A top) s) = 1 -> exists f :e R :^: A, hl_continuous_map A R (hl_pair (hl_ty_topology A) (hl_ty_topology R) top (hl_subtopology R hl_euclideanreal (hl_closed_real_interval (hl_CONS (R :*: R) (hl_pair R R (hl_real_of_num (hl_NUMERAL hl_zero)) (hl_real_of_num (hl_NUMERAL (hl_BIT1 hl_zero)))) (hl_NIL (R :*: R)))))) f = 1 /\ (f x = hl_real_of_num (hl_NUMERAL hl_zero) /\ forall x1 :e A, hl_IN A x1 s = 1 -> f x1 = hl_real_of_num (hl_NUMERAL (hl_BIT1 hl_zero))).
Admitted.

// HOL Light: Multivariate/metric.ml:24792 / HOMEOMORPHIC_COMPLETELY_REGULAR_SPACE   (hash md5:50a06d5b781b45901ddaa4bc87510f7c)
Theorem hlt_HOMEOMORPHIC_COMPLETELY_REGULAR_SPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_homeomorphic_space A B top top' = 1 -> (hl_completely_regular_space A top = 1 <-> hl_completely_regular_space B top' = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:24821 / COMPLETELY_REGULAR_SPACE_ALT   (hash md5:c3789093763f9a03a43ed69c86c7f8c2)
Theorem hlt_COMPLETELY_REGULAR_SPACE_ALT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_completely_regular_space A top = 1 <-> forall s :e 2 :^: A, forall x :e A, hl_closed_in A top s = 1 /\ hl_IN A x (hl_DIFF A (hl_topspace A top) s) = 1 -> exists f :e R :^: A, hl_continuous_map A R (hl_pair (hl_ty_topology A) (hl_ty_topology R) top hl_euclideanreal) f = 1 /\ (f x = hl_real_of_num (hl_NUMERAL hl_zero) /\ forall x1 :e A, hl_IN A x1 s = 1 -> f x1 = hl_real_of_num (hl_NUMERAL (hl_BIT1 hl_zero))).
Admitted.

// HOL Light: Multivariate/metric.ml:24842 / COMPLETELY_REGULAR_SPACE_GEN_ALT   (hash md5:867c255e961fb4819226ae9f755ad150)
Theorem hlt_COMPLETELY_REGULAR_SPACE_GEN_ALT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall a b :e R, ~ a = b -> (hl_completely_regular_space A top = 1 <-> forall s :e 2 :^: A, forall x :e A, hl_closed_in A top s = 1 /\ hl_IN A x (hl_DIFF A (hl_topspace A top) s) = 1 -> exists f :e R :^: A, hl_continuous_map A R (hl_pair (hl_ty_topology A) (hl_ty_topology R) top hl_euclideanreal) f = 1 /\ (f x = a /\ forall x1 :e A, hl_IN A x1 s = 1 -> f x1 = b)).
Admitted.

// HOL Light: Multivariate/metric.ml:24863 / COMPLETELY_REGULAR_SPACE_GEN   (hash md5:b6e15ff8b073b0bceb4872edab2684cd)
Theorem hlt_COMPLETELY_REGULAR_SPACE_GEN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall a b :e R, hl_real_lt a b = 1 -> (hl_completely_regular_space A top = 1 <-> forall s :e 2 :^: A, forall x :e A, hl_closed_in A top s = 1 /\ hl_IN A x (hl_DIFF A (hl_topspace A top) s) = 1 -> exists f :e R :^: A, hl_continuous_map A R (hl_pair (hl_ty_topology A) (hl_ty_topology R) top (hl_subtopology R hl_euclideanreal (hl_closed_real_interval (hl_CONS (R :*: R) (hl_pair R R a b) (hl_NIL (R :*: R)))))) f = 1 /\ (f x = a /\ forall x1 :e A, hl_IN A x1 s = 1 -> f x1 = b)).
Admitted.

// HOL Light: Multivariate/metric.ml:24889 / NORMAL_IMP_COMPLETELY_REGULAR_SPACE_GEN   (hash md5:7eea56e8ef0724edad286cbd4d44b6cb)
Theorem hlt_NORMAL_IMP_COMPLETELY_REGULAR_SPACE_GEN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_normal_space A top = 1 /\ (hl_t1_space A top = 1 \/ (hl_hausdorff_space A top = 1 \/ hl_regular_space A top = 1)) -> hl_completely_regular_space A top = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:24916 / NORMAL_IMP_COMPLETELY_REGULAR_SPACE   (hash md5:6810b078891dc54dd96082a30e3803fa)
Theorem hlt_NORMAL_IMP_COMPLETELY_REGULAR_SPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_normal_space A top = 1 /\ (hl_hausdorff_space A top = 1 \/ hl_regular_space A top = 1) -> hl_completely_regular_space A top = 1.
Admitted.

