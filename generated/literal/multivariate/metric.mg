// HOL Light: Multivariate/metric.ml:1670 / DENSE_INTERSECTS_OPEN   (hash md5:d15c42dc0577f0f0110b6237cbe5f2a6)
Theorem hlt_DENSE_INTERSECTS_OPEN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_closure_of A top s = hl_topspace A top <-> forall t :e 2 :^: A, hl_open_in A top t = 1 /\ ~ t = hl_EMPTY A -> ~ hl_INTER A s t = hl_EMPTY A.
Admitted.

// HOL Light: Multivariate/metric.ml:1681 / INTERIOR_OF_CLOSED_IN_UNION_EMPTY_INTERIOR_OF   (hash md5:921fbc512a1524bf20a885fa18f58a07)
Theorem hlt_INTERIOR_OF_CLOSED_IN_UNION_EMPTY_INTERIOR_OF : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_closed_in A top s = 1 /\ hl_interior_of A top t = hl_EMPTY A -> hl_interior_of A top (hl_UNION A s t) = hl_interior_of A top s.
Admitted.

// HOL Light: Multivariate/metric.ml:1695 / INTERIOR_OF_UNION_EQ_EMPTY   (hash md5:7c4d7700164b43841d046a4c8ec83e36)
Theorem hlt_INTERIOR_OF_UNION_EQ_EMPTY : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_closed_in A top s = 1 \/ hl_closed_in A top t = 1 -> (hl_interior_of A top (hl_UNION A s t) = hl_EMPTY A <-> hl_interior_of A top s = hl_EMPTY A /\ hl_interior_of A top t = hl_EMPTY A).
Admitted.

// HOL Light: Multivariate/metric.ml:1710 / DISCRETE_TOPOLOGY_INTERIOR_OF   (hash md5:f5c1892862a18948f63414e9c7c104c5)
Theorem hlt_DISCRETE_TOPOLOGY_INTERIOR_OF : forall A:set, A <> Empty -> forall u s :e 2 :^: A, hl_interior_of A (hl_discrete_topology A u) s = hl_INTER A u s.
Admitted.

// HOL Light: Multivariate/metric.ml:1722 / frontier_of   (hash md5:fa70446600fd85dca8fbb6906b62e525)
Theorem hlt_frontier_of_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_frontier_of A top s = hl_DIFF A (hl_closure_of A top s) (hl_interior_of A top s).
Admitted.

// HOL Light: Multivariate/metric.ml:1725 / FRONTIER_OF_CLOSURES   (hash md5:a8d7b6e24606adf8ca15137f7515b549)
Theorem hlt_FRONTIER_OF_CLOSURES : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_frontier_of A top s = hl_INTER A (hl_closure_of A top s) (hl_closure_of A top (hl_DIFF A (hl_topspace A top) s)).
Admitted.

// HOL Light: Multivariate/metric.ml:1733 / INTERIOR_OF_UNION_FRONTIER_OF   (hash md5:3284f3f752f660234638167c52ca1a8d)
Theorem hlt_INTERIOR_OF_UNION_FRONTIER_OF : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_UNION A (hl_interior_of A top s) (hl_frontier_of A top s) = hl_closure_of A top s.
Admitted.

// HOL Light: Multivariate/metric.ml:1741 / FRONTIER_OF_RESTRICT   (hash md5:7f7ac16b64542090cca6268d284b7e3d)
Theorem hlt_FRONTIER_OF_RESTRICT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_frontier_of A top s = hl_frontier_of A top (hl_INTER A (hl_topspace A top) s).
Admitted.

// HOL Light: Multivariate/metric.ml:1747 / CLOSED_IN_FRONTIER_OF   (hash md5:204079335a6d18f691f2b20eae6bfaab)
Theorem hlt_CLOSED_IN_FRONTIER_OF : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_closed_in A top (hl_frontier_of A top s) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:1751 / FRONTIER_OF_SUBSET_TOPSPACE   (hash md5:cf90607e216ade17541b08f89d2f0ad2)
Theorem hlt_FRONTIER_OF_SUBSET_TOPSPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_SUBSET A (hl_frontier_of A top s) (hl_topspace A top) = 1.
