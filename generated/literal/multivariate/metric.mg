// HOL Light: Multivariate/metric.ml:24951 / COMPLETELY_REGULAR_SPACE_RETRACTION_MAP_IMAGE   (hash md5:927cc70ebed35e20441b28bd4d431d74)
Theorem hlt_COMPLETELY_REGULAR_SPACE_RETRACTION_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall r :e B :^: A, hl_retraction_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') r = 1 /\ hl_completely_regular_space A top = 1 -> hl_completely_regular_space B top' = 1.
Admitted.

