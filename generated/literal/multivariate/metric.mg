Admitted.

// HOL Light: Multivariate/metric.ml:26810 / QUASI_COMPONENT_OF_CONTINUOUS_IMAGE   (hash md5:730da14d414960bb7143cb9a9ca71c00)
Theorem hlt_QUASI_COMPONENT_OF_CONTINUOUS_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, forall x y :e A, hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_quasi_component_of A top x y = 1 -> hl_quasi_component_of B top' (f x) (f y) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:26825 / QUASI_COMPONENT_OF_DISCRETE_TOPOLOGY   (hash md5:c57ca94c9e3362778a59221bdd7da2fd)
Theorem hlt_QUASI_COMPONENT_OF_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u :e 2 :^: A, forall x :e A, hl_quasi_component_of A (hl_discrete_topology A u) x = hl_COND (2 :^: A) (hl_IN A x u) (hl_INSERT A x (hl_EMPTY A)) (hl_EMPTY A).
Admitted.

// HOL Light: Multivariate/metric.ml:26837 / QUASI_COMPONENTS_OF_DISCRETE_TOPOLOGY   (hash md5:09d42dae918f620ee71c45c7bc1e86cb)
Theorem hlt_QUASI_COMPONENTS_OF_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u :e 2 :^: A, hl_quasi_components_of A (hl_discrete_topology A u) = hl_GSPEC (2 :^: A) (fun GEN_PVAR_2046 :e 2 :^: A => if exists x :e A, hl_SETSPEC (2 :^: A) GEN_PVAR_2046 (hl_IN A x u) (hl_INSERT A x (hl_EMPTY A)) = 1 then 1 else 0).
Admitted.

// HOL Light: Multivariate/metric.ml:26845 / HOMEOMORPHIC_MAP_QUASI_COMPONENT_OF   (hash md5:427d472cb10a274709822fa19369951c)
Theorem hlt_HOMEOMORPHIC_MAP_QUASI_COMPONENT_OF : forall A B:set, A <> Empty -> B <> Empty -> forall f :e B :^: A, forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall x :e A, hl_homeomorphic_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_IN A x (hl_topspace A top) = 1 -> hl_quasi_component_of B top' (f x) = hl_IMAGE A B f (hl_quasi_component_of A top x).
Admitted.

// HOL Light: Multivariate/metric.ml:26864 / HOMEOMORPHIC_MAP_QUASI_COMPONENTS_OF   (hash md5:407ddc9950d063f8fab61d4e4693adf7)
Theorem hlt_HOMEOMORPHIC_MAP_QUASI_COMPONENTS_OF : forall A B:set, A <> Empty -> B <> Empty -> forall f :e B :^: A, forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_homeomorphic_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 -> hl_quasi_components_of B top' = hl_IMAGE (2 :^: A) (2 :^: B) (hl_IMAGE A B f) (hl_quasi_components_of A top).
Admitted.

