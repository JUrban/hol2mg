Theorem hlt_METRIC_INTERIOR_OF : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall s :e 2 :^: A, hl_interior_of A (hl_mtopology A m) s = hl_GSPEC A (fun GEN_PVAR_1650 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_1650 (if hl_IN A x (hl_mspace A m) = 1 /\ exists e1 :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) e1 = 1 /\ hl_SUBSET A (hl_mball A m (hl_pair A R x e1)) s = 1 then 1 else 0) x = 1 then 1 else 0).
