// HOL Light: Multivariate/metric.ml:23488 / normal_space   (hash md5:4483973862b3a97120c36bc7f20f109b)
Theorem hlt_normal_space_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_normal_space A top = 1 <-> forall s t :e 2 :^: A, hl_closed_in A top s = 1 /\ (hl_closed_in A top t = 1 /\ hl_DISJOINT A s t = 1) -> exists u v :e 2 :^: A, hl_open_in A top u = 1 /\ (hl_open_in A top v = 1 /\ (hl_SUBSET A s u = 1 /\ (hl_SUBSET A t v = 1 /\ hl_DISJOINT A u v = 1))).
