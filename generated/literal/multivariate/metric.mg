// HOL Light: Multivariate/metric.ml:29053 / homotopic_with   (hash md5:9c05e375f8f10f72ea0964d23a37e76e)
Theorem hlt_homotopic_with_thm : forall A B:set, A <> Empty -> B <> Empty -> forall X :e hl_ty_topology B, forall Y :e hl_ty_topology A, forall p q :e A :^: B, forall P :e 2 :^: (A :^: B), hl_homotopic_with B A P (hl_pair (hl_ty_topology B) (hl_ty_topology A) X Y) p q = 1 <-> exists h :e A :^: (R :*: B), hl_continuous_map (R :*: B) A (hl_pair (hl_ty_topology (R :*: B)) (hl_ty_topology A) (hl_prod_topology R B (hl_subtopology R hl_euclideanreal (hl_closed_real_interval (hl_CONS (R :*: R) (hl_pair R R (hl_real_of_num (hl_NUMERAL hl_zero)) (hl_real_of_num (hl_NUMERAL (hl_BIT1 hl_zero)))) (hl_NIL (R :*: R))))) X) Y) h = 1 /\ ((forall x :e B, h (hl_pair R B (hl_real_of_num (hl_NUMERAL hl_zero)) x) = p x) /\ ((forall x :e B, h (hl_pair R B (hl_real_of_num (hl_NUMERAL (hl_BIT1 hl_zero))) x) = q x) /\ forall t :e R, hl_IN R t (hl_closed_real_interval (hl_CONS (R :*: R) (hl_pair R R (hl_real_of_num (hl_NUMERAL hl_zero)) (hl_real_of_num (hl_NUMERAL (hl_BIT1 hl_zero)))) (hl_NIL (R :*: R)))) = 1 -> P (fun x :e B => h (hl_pair R B t x)) = 1)).
Admitted.

// HOL Light: Multivariate/metric.ml:29061 / HOMOTOPIC_WITH   (hash md5:71a964d5021a9a45d0996e5b8d623c72)
Theorem hlt_HOMOTOPIC_WITH : forall A B:set, A <> Empty -> B <> Empty -> forall P :e 2 :^: (B :^: A), forall X :e hl_ty_topology A, forall Y :e hl_ty_topology B, forall p q :e B :^: A, (forall h k :e B :^: A, (forall x :e A, hl_IN A x (hl_topspace A X) = 1 -> h x = k x) -> (P h = 1 <-> P k = 1)) -> (hl_homotopic_with A B P (hl_pair (hl_ty_topology A) (hl_ty_topology B) X Y) p q = 1 <-> exists h :e B :^: (R :*: A), hl_continuous_map (R :*: A) B (hl_pair (hl_ty_topology (R :*: A)) (hl_ty_topology B) (hl_prod_topology R A (hl_subtopology R hl_euclideanreal (hl_closed_real_interval (hl_CONS (R :*: R) (hl_pair R R (hl_real_of_num (hl_NUMERAL hl_zero)) (hl_real_of_num (hl_NUMERAL (hl_BIT1 hl_zero)))) (hl_NIL (R :*: R))))) X) Y) h = 1 /\ ((forall x :e A, hl_IN A x (hl_topspace A X) = 1 -> h (hl_pair R A (hl_real_of_num (hl_NUMERAL hl_zero)) x) = p x) /\ ((forall x :e A, hl_IN A x (hl_topspace A X) = 1 -> h (hl_pair R A (hl_real_of_num (hl_NUMERAL (hl_BIT1 hl_zero))) x) = q x) /\ forall t :e R, hl_IN R t (hl_closed_real_interval (hl_CONS (R :*: R) (hl_pair R R (hl_real_of_num (hl_NUMERAL hl_zero)) (hl_real_of_num (hl_NUMERAL (hl_BIT1 hl_zero)))) (hl_NIL (R :*: R)))) = 1 -> P (fun x :e A => h (hl_pair R A t x)) = 1))).
Admitted.

