// HOL Light: Multivariate/metric.ml:11624 / MDIST   (hash md5:06498f38c1a5dbfb4f0c17e571c81462)
Theorem hlt_MDIST : forall A:set, A <> Empty -> forall s :e 2 :^: A, forall d :e R :^: (A :*: A), hl_is_metric_space A (hl_pair (2 :^: A) (R :^: (A :*: A)) s d) = 1 -> hl_mdist A (hl_metric A (hl_pair (2 :^: A) (R :^: (A :*: A)) s d)) = d.
