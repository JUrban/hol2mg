// HOL Light: Multivariate/metric.ml:9458 / PROPER_MAP_FROM_COMPOSITION_LEFT   (hash md5:91f9d00bc4f734ae525f6310b226cd7d)
Theorem hlt_PROPER_MAP_FROM_COMPOSITION_LEFT : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall top'' :e hl_ty_topology C, forall f :e B :^: A, forall g :e C :^: B, hl_proper_map A C (hl_pair (hl_ty_topology A) (hl_ty_topology C) top top'') (hl_o B C A g f) = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_IMAGE A B f (hl_topspace A top) = hl_topspace B top') -> hl_proper_map B C (hl_pair (hl_ty_topology B) (hl_ty_topology C) top' top'') g = 1.
