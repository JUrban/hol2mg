Admitted.

// HOL Light: Multivariate/metric.ml:18263 / REAL_COMPACT_ATTAINS_INF   (hash md5:ac2a9d1e007e3ce907c0d744a5153a80)
Theorem hlt_REAL_COMPACT_ATTAINS_INF : forall s :e 2 :^: R, hl_real_compact s = 1 /\ ~ s = hl_EMPTY R -> exists x :e R, hl_IN R x s = 1 /\ forall y :e R, hl_IN R y s = 1 -> hl_real_le x y = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:18273 / REAL_COMPACT_IS_REALINTERVAL   (hash md5:c60651746fcc1954312ea8047163e134)
Theorem hlt_REAL_COMPACT_IS_REALINTERVAL : forall s :e 2 :^: R, hl_real_compact s = 1 /\ hl_is_realinterval s = 1 <-> exists a b :e R, s = hl_closed_real_interval (hl_CONS (R :*: R) (hl_pair R R a b) (hl_NIL (R :*: R))).
Admitted.

// HOL Light: Multivariate/metric.ml:18293 / IS_REALINTERVAL_CLOSURE_OF   (hash md5:9a4d34438173abf42501ceefb95e68a9)
