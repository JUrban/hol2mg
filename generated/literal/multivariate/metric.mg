Admitted.

// HOL Light: Multivariate/metric.ml:26205 / quasi_component_of   (hash md5:3db9daa7a4b56a4b4654a1ca9957a389)
Theorem hlt_quasi_component_of_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall x y :e A, hl_quasi_component_of A top x y = 1 <-> hl_IN A x (hl_topspace A top) = 1 /\ (hl_IN A y (hl_topspace A top) = 1 /\ forall t :e 2 :^: A, hl_closed_in A top t = 1 /\ hl_open_in A top t = 1 -> (hl_IN A x t = 1 <-> hl_IN A y t = 1)).
Admitted.

// HOL Light: Multivariate/metric.ml:26210 / quasi_components_of   (hash md5:49d801e49f28921f60f6375859a91290)
Theorem hlt_quasi_components_of_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_quasi_components_of A top = hl_GSPEC (2 :^: A) (fun GEN_PVAR_2040 :e 2 :^: A => if exists x :e A, hl_SETSPEC (2 :^: A) GEN_PVAR_2040 (hl_IN A x (hl_topspace A top)) (hl_quasi_component_of A top x) = 1 then 1 else 0).
Admitted.

