// HOL Light: Multivariate/metric.ml:20733 / CAUCHY_IN_IMP_MBOUNDED   (hash md5:5bdf4d165c005e70d898b843847ce9b4)
Theorem hlt_CAUCHY_IN_IMP_MBOUNDED : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall x :e A :^: omega, hl_cauchy_in A m x = 1 -> hl_mbounded A m (hl_GSPEC A (fun GEN_PVAR_1886 :e A => if exists i :e omega, hl_SETSPEC A GEN_PVAR_1886 (hl_IN omega i (hl_UNIV omega)) (x i) = 1 then 1 else 0)) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:20743 / BOLZANO_WEIERSTRASS_PROPERTY   (hash md5:c66af8cb390d19beb2ef1a464464c08d)
Theorem hlt_BOLZANO_WEIERSTRASS_PROPERTY : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall u s :e 2 :^: A, hl_SUBSET A s u = 1 /\ hl_SUBSET A s (hl_mspace A m) = 1 -> ((forall x :e A :^: omega, (forall n :e omega, hl_IN A (x n) s = 1) -> exists l :e A, exists r :e omega :^: omega, hl_IN A l u = 1 /\ ((forall m1 n :e omega, hl_lt m1 n = 1 -> hl_lt (r m1) (r n) = 1) /\ hl_limit A omega (hl_mtopology A m) (hl_o omega A omega x r) l hl_sequentially = 1)) <-> forall t :e 2 :^: A, hl_SUBSET A t s = 1 /\ hl_INFINITE A t = 1 -> ~ hl_INTER A u (hl_derived_set_of A (hl_mtopology A m) t) = hl_EMPTY A).
Admitted.

// HOL Light: Multivariate/metric.ml:20937 / COMPACT_SPACE_SEQUENTIALLY   (hash md5:0f8c616dd4b0f7f28bafcaf29d9e4bef)
Theorem hlt_COMPACT_SPACE_SEQUENTIALLY : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, hl_compact_space A (hl_mtopology A m) = 1 <-> forall x :e A :^: omega, (forall n :e omega, hl_IN A (x n) (hl_mspace A m) = 1) -> exists l :e A, exists r :e omega :^: omega, hl_IN A l (hl_mspace A m) = 1 /\ ((forall m1 n :e omega, hl_lt m1 n = 1 -> hl_lt (r m1) (r n) = 1) /\ hl_limit A omega (hl_mtopology A m) (hl_o omega A omega x r) l hl_sequentially = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:20947 / COMPACT_SPACE_EQ_BOLZANO_WEIERSTRASS   (hash md5:3b293bc3d2c744f9bd9e1297d92bd2a8)
Theorem hlt_COMPACT_SPACE_EQ_BOLZANO_WEIERSTRASS : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, hl_compact_space A (hl_mtopology A m) = 1 <-> forall s :e 2 :^: A, hl_SUBSET A s (hl_mspace A m) = 1 /\ hl_INFINITE A s = 1 -> ~ hl_derived_set_of A (hl_mtopology A m) s = hl_EMPTY A.
