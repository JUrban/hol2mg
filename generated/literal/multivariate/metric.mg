// HOL Light: Multivariate/metric.ml:22195 / HOMEOMORPHIC_MAP_PATH_CONNECTEDNESS_EQ   (hash md5:a6b89e0fbfbc414c57be037192673df3)
Theorem hlt_HOMEOMORPHIC_MAP_PATH_CONNECTEDNESS_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall f :e B :^: A, forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall u :e 2 :^: A, hl_homeomorphic_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 -> (hl_path_connected_in A top u = 1 <-> hl_SUBSET A u (hl_topspace A top) = 1 /\ hl_path_connected_in B top' (hl_IMAGE A B f u) = 1).
