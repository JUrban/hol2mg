Theorem hlt_NULLHOMOTOPIC_THROUGH_CONTRACTIBLE_SPACE : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall f :e B :^: A, forall g :e C :^: B, forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, forall top3 :e hl_ty_topology C, hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top1 top2) f = 1 /\ (hl_continuous_map B C (hl_pair (hl_ty_topology B) (hl_ty_topology C) top2 top3) g = 1 /\ hl_contractible_space B top2 = 1) -> exists c :e C, hl_homotopic_with A C (fun h :e C :^: A => if True then 1 else 0) (hl_pair (hl_ty_topology A) (hl_ty_topology C) top1 top3) (hl_o B C A g f) (fun x :e A => c) = 1.
