// hol2mg literal statements (private): shard metric of profile multivariate.  Each theorem is the literal
// interpretation of the HOL Light theorem named in the comment; all are admitted source facts.

// HOL Light: Multivariate/metric.ml:62 / istopology   (hash md5:d822fc545985806b6e4390c70e65e259)
Theorem hlt_istopology_thm : forall A:set, A <> Empty -> forall L :e 2 :^: (2 :^: A), hl_istopology A L = 1 <-> hl_IN (2 :^: A) (hl_EMPTY A) L = 1 /\ ((forall s t :e 2 :^: A, hl_IN (2 :^: A) s L = 1 /\ hl_IN (2 :^: A) t L = 1 -> hl_IN (2 :^: A) (hl_INTER A s t) L = 1) /\ forall k :e 2 :^: (2 :^: A), hl_SUBSET (2 :^: A) k L = 1 -> hl_IN (2 :^: A) (hl_UNIONS A k) L = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:68 / topology_tybij_th   (hash md5:b234717571736b0c67ce38a627bd430a)
Theorem hlt_topology_tybij_th : forall A:set, A <> Empty -> exists t :e 2 :^: (2 :^: A), hl_istopology A t = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:72 / topology_tybij   (hash md5:33ce1308fc9c50e8fa4d3b1c4cded16c)
Theorem hlt_topology_tybij : forall A:set, A <> Empty -> (forall a :e hl_ty_topology A, hl_topology A (hl_open_in A a) = a) /\ forall r :e 2 :^: (2 :^: A), hl_istopology A r = 1 <-> hl_open_in A (hl_topology A r) = r.
Admitted.

// HOL Light: Multivariate/metric.ml:75 / ISTOPOLOGY_OPEN_IN   (hash md5:30dcbb8794734e563c7fa9104c7ea251)
Theorem hlt_ISTOPOLOGY_OPEN_IN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_istopology A (hl_open_in A top) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:79 / TOPOLOGY_EQ   (hash md5:20e26b3c37c76209346b3ac71414fd72)
Theorem hlt_TOPOLOGY_EQ : forall A:set, A <> Empty -> forall top1 top2 :e hl_ty_topology A, top1 = top2 <-> forall s :e 2 :^: A, hl_open_in A top1 s = 1 <-> hl_open_in A top2 s = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:88 / topspace   (hash md5:4ff295c9944fa9d9bab2d900e97fa301)
Theorem hlt_topspace_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_topspace A top = hl_UNIONS A (hl_GSPEC (2 :^: A) (fun GEN_PVAR_1231 :e 2 :^: A => if exists s :e 2 :^: A, hl_SETSPEC (2 :^: A) GEN_PVAR_1231 (hl_open_in A top s) s = 1 then 1 else 0)).
Admitted.

// HOL Light: Multivariate/metric.ml:95 / OPEN_IN_CLAUSES   (hash md5:cc067173f0d950e83f79e01c4f02c2e1)
Theorem hlt_OPEN_IN_CLAUSES : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_open_in A top (hl_EMPTY A) = 1 /\ ((forall s t :e 2 :^: A, hl_open_in A top s = 1 /\ hl_open_in A top t = 1 -> hl_open_in A top (hl_INTER A s t) = 1) /\ forall k :e 2 :^: (2 :^: A), (forall s :e 2 :^: A, hl_IN (2 :^: A) s k = 1 -> hl_open_in A top s = 1) -> hl_open_in A top (hl_UNIONS A k) = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:102 / OPEN_IN_SUBSET   (hash md5:60ef1a810e1e0a2d956008225c54d9fa)
Theorem hlt_OPEN_IN_SUBSET : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_open_in A top s = 1 -> hl_SUBSET A s (hl_topspace A top) = 1.
Admitted.

