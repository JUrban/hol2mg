// HOL Light: Multivariate/metric.ml:25323 / LOCALLY_PATH_CONNECTED_SPACE_OPEN_SUBSET   (hash md5:d9e001a928af671d77307e6d1b56085d)
Theorem hlt_LOCALLY_PATH_CONNECTED_SPACE_OPEN_SUBSET : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_locally_path_connected_space A top = 1 /\ hl_open_in A top s = 1 -> hl_locally_path_connected_space A (hl_subtopology A top s) = 1.
