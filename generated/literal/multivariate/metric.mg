Theorem hlt_REAL_CLOSED_CONTAINS_INF : forall s :e 2 :^: R, forall b :e R, hl_real_closed s = 1 /\ (~ s = hl_EMPTY R /\ (forall x :e R, hl_IN R x s = 1 -> hl_real_le b x = 1)) -> hl_IN R (hl_inf s) s = 1.
