// HOL Light: Multivariate/metric.ml:23818 / NORMAL_SPACE_CONTINUOUS_CLOSED_MAP_IMAGE   (hash md5:daaf8182615c61cfa0d791aeef422c15)
Theorem hlt_NORMAL_SPACE_CONTINUOUS_CLOSED_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (hl_closed_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (hl_IMAGE A B f (hl_topspace A top) = hl_topspace B top' /\ hl_normal_space A top = 1)) -> hl_normal_space B top' = 1.
Admitted.

