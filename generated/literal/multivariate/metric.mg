Theorem hlt_HOMEOMORPHIC_MAPS_INVOLUTION : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall f :e A :^: A, hl_continuous_map A A (hl_pair (hl_ty_topology A) (hl_ty_topology A) top top) f = 1 /\ (forall x :e A, hl_IN A x (hl_topspace A top) = 1 -> f (f x) = x) -> hl_homeomorphic_maps A A (hl_pair (hl_ty_topology A) (hl_ty_topology A) top top) (hl_pair (A :^: A) (A :^: A) f f) = 1.
