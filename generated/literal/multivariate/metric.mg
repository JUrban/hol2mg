// HOL Light: Multivariate/metric.ml:5270 / OPEN_EQ_CONTINUOUS_INVERSE_MAP   (hash md5:06a475fcce68bf0f844e333bf94a94c1)
Theorem hlt_OPEN_EQ_CONTINUOUS_INVERSE_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, forall g :e A :^: B, (forall x :e A, hl_IN A x (hl_topspace A top) = 1 -> hl_IN B (f x) (hl_topspace B top') = 1 /\ g (f x) = x) /\ (forall y :e B, hl_IN B y (hl_topspace B top') = 1 -> hl_IN A (g y) (hl_topspace A top) = 1 /\ f (g y) = y) -> (hl_open_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 <-> hl_continuous_map B A (hl_pair (hl_ty_topology B) (hl_ty_topology A) top' top) g = 1).
