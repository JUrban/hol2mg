// HOL Light: Multivariate/metric.ml:18540 / ATPOINTOF_SUBTOPOLOGY   (hash md5:b944a8c372449e29015d3ae2c91f13e1)
Theorem hlt_ATPOINTOF_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, forall a :e A, hl_IN A a s = 1 -> hl_atpointof A (hl_subtopology A top s) a = hl_within A (hl_atpointof A top a) s.
Admitted.

// HOL Light: Multivariate/metric.ml:18554 / EVENTUALLY_ATPOINTOF_METRIC   (hash md5:a0889070325031ff858a4271496f43ad)
Theorem hlt_EVENTUALLY_ATPOINTOF_METRIC : forall A:set, A <> Empty -> forall P :e 2 :^: A, forall m :e hl_ty_metric A, forall a :e A, hl_eventually A P (hl_atpointof A (hl_mtopology A m) a) = 1 <-> hl_IN A a (hl_mspace A m) = 1 -> exists d :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) d = 1 /\ forall x :e A, hl_IN A x (hl_mspace A m) = 1 /\ (hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) (hl_mdist A m (hl_pair A A x a)) = 1 /\ hl_real_lt (hl_mdist A m (hl_pair A A x a)) d = 1) -> P x = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:18579 / limit   (hash md5:f141b136b87e9bc68c5bd98540d616ba)
Theorem hlt_limit_thm : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology B, forall l :e B, forall f :e B :^: A, forall net1 :e hl_ty_net A, hl_limit B A top f l net1 = 1 <-> hl_IN B l (hl_topspace B top) = 1 /\ forall u :e 2 :^: B, hl_open_in B top u = 1 /\ hl_IN B l u = 1 -> hl_eventually A (fun x :e A => hl_IN B (f x) u) net1 = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:18584 / LIMIT_IMP_WITHIN   (hash md5:79e3d435ae696c9309e4dc48d94134ab)
Theorem hlt_LIMIT_IMP_WITHIN : forall A B:set, A <> Empty -> B <> Empty -> forall net1 :e hl_ty_net A, forall top :e hl_ty_topology B, forall f :e B :^: A, forall l :e B, forall s :e 2 :^: A, hl_limit B A top f l net1 = 1 -> hl_limit B A top f l (hl_within A net1 s) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:18589 / LIMIT_IN_TOPSPACE   (hash md5:4345febf395866dbdc4cc51f1fc442d5)
Theorem hlt_LIMIT_IN_TOPSPACE : forall A B:set, A <> Empty -> B <> Empty -> forall net1 :e hl_ty_net A, forall top :e hl_ty_topology B, forall f :e B :^: A, forall l :e B, hl_limit B A top f l net1 = 1 -> hl_IN B l (hl_topspace B top) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:18593 / LIMIT_CONST   (hash md5:b09e150dd17615f9e1f75ead3c19ef73)
Theorem hlt_LIMIT_CONST : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology B, forall net1 :e hl_ty_net A, forall l :e B, hl_limit B A top (fun a :e A => l) l net1 = 1 <-> hl_IN B l (hl_topspace B top) = 1.
