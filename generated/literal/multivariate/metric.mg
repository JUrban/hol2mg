// HOL Light: Multivariate/metric.ml:11655 / MDIST_POS_LT   (hash md5:b2c823a3b8e1da7f88706b06b0ea9358)
Theorem hlt_MDIST_POS_LT : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall x y :e A, hl_IN A x (hl_mspace A m) = 1 /\ (hl_IN A y (hl_mspace A m) = 1 /\ ~ x = y) -> hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) (hl_mdist A m (hl_pair A A x y)) = 1.
