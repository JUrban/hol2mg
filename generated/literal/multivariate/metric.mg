// HOL Light: Multivariate/metric.ml:1531 / INTERIOR_OF_INTER   (hash md5:3ac2d1fb493883eb5dd75ae512beee4a)
Theorem hlt_INTERIOR_OF_INTER : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_interior_of A top (hl_INTER A s t) = hl_INTER A (hl_interior_of A top s) (hl_interior_of A top t).
Admitted.

// HOL Light: Multivariate/metric.ml:1542 / INTERIOR_OF_INTERS_SUBSET   (hash md5:c4d9e4dfcd9ff1d4bb9fa5fda4488a31)
Theorem hlt_INTERIOR_OF_INTERS_SUBSET : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall f :e 2 :^: (2 :^: A), hl_SUBSET A (hl_interior_of A top (hl_INTERS A f)) (hl_INTERS A (hl_GSPEC (2 :^: A) (fun GEN_PVAR_1260 :e 2 :^: A => if exists s :e 2 :^: A, hl_SETSPEC (2 :^: A) GEN_PVAR_1260 (hl_IN (2 :^: A) s f) (hl_interior_of A top s) = 1 then 1 else 0))) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:1549 / UNION_INTERIOR_OF_SUBSET   (hash md5:6f411ef2cbe027fffee1db101d69496d)
Theorem hlt_UNION_INTERIOR_OF_SUBSET : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_SUBSET A (hl_UNION A (hl_interior_of A top s) (hl_interior_of A top t)) (hl_interior_of A top (hl_UNION A s t)) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:1555 / INTERIOR_OF_EQ_EMPTY   (hash md5:3b00cb14cccc8ca4f9b23ac35e19400c)
Theorem hlt_INTERIOR_OF_EQ_EMPTY : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_interior_of A top s = hl_EMPTY A <-> forall t :e 2 :^: A, hl_open_in A top t = 1 /\ hl_SUBSET A t s = 1 -> t = hl_EMPTY A.
Admitted.

// HOL Light: Multivariate/metric.ml:1562 / INTERIOR_OF_EQ_EMPTY_ALT   (hash md5:27e14c250e9afcbe86d1eae73d047bb2)
Theorem hlt_INTERIOR_OF_EQ_EMPTY_ALT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_interior_of A top s = hl_EMPTY A <-> forall t :e 2 :^: A, hl_open_in A top t = 1 /\ ~ t = hl_EMPTY A -> ~ hl_DIFF A t s = hl_EMPTY A.
Admitted.

// HOL Light: Multivariate/metric.ml:1568 / INTERIOR_OF_UNIONS_OPEN_IN_SUBSETS   (hash md5:8d196d706ffcd1551ba0bdb3966cecc8)
Theorem hlt_INTERIOR_OF_UNIONS_OPEN_IN_SUBSETS : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_UNIONS A (hl_GSPEC (2 :^: A) (fun GEN_PVAR_1261 :e 2 :^: A => if exists t :e 2 :^: A, hl_SETSPEC (2 :^: A) GEN_PVAR_1261 (if hl_open_in A top t = 1 /\ hl_SUBSET A t s = 1 then 1 else 0) t = 1 then 1 else 0)) = hl_interior_of A top s.
Admitted.

// HOL Light: Multivariate/metric.ml:1575 / INTERIOR_OF_COMPLEMENT   (hash md5:2ed165b8e282e626593320c7039c9375)
Theorem hlt_INTERIOR_OF_COMPLEMENT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_interior_of A top (hl_DIFF A (hl_topspace A top) s) = hl_DIFF A (hl_topspace A top) (hl_closure_of A top s).
Admitted.

