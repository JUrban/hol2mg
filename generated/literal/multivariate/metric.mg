// HOL Light: Multivariate/metric.ml:23620 / NORMAL_SPACE_DUAL   (hash md5:32e570deb3e1410032b009b29d7f7a73)
Theorem hlt_NORMAL_SPACE_DUAL : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_normal_space A top = 1 <-> forall u v :e 2 :^: A, hl_open_in A top u = 1 /\ (hl_open_in A top v = 1 /\ hl_UNION A u v = hl_topspace A top) -> exists s t :e 2 :^: A, hl_closed_in A top s = 1 /\ (hl_closed_in A top t = 1 /\ (hl_SUBSET A s u = 1 /\ (hl_SUBSET A t v = 1 /\ hl_UNION A s t = hl_topspace A top))).
Admitted.

