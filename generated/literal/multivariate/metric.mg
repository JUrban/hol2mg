// HOL Light: Multivariate/metric.ml:1103 / CLOSURE_OF   (hash md5:b2165d93208cfea8af81b9ad28a26421)
Theorem hlt_CLOSURE_OF : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_closure_of A top s = hl_INTER A (hl_topspace A top) (hl_UNION A s (hl_derived_set_of A top s)).
