Theorem hlt_PERFECT_IMP_QUOTIENT_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_perfect_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 -> hl_quotient_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1.
