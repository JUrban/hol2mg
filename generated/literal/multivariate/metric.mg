Theorem hlt_LIMIT_NULL_REAL_COMPARISON : forall A:set, A <> Empty -> forall net1 :e hl_ty_net A, forall f g :e R :^: A, hl_limit R A hl_euclideanreal f (hl_real_of_num (hl_NUMERAL hl_zero)) net1 = 1 /\ hl_eventually A (fun a :e A => hl_real_le (hl_real_abs (g a)) (hl_real_abs (f a))) net1 = 1 -> hl_limit R A hl_euclideanreal g (hl_real_of_num (hl_NUMERAL hl_zero)) net1 = 1.
