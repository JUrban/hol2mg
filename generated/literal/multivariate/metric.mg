Theorem hlt_LOCALLY_COMPACT_SPACE_SUM_TOPOLOGY : forall A K:set, A <> Empty -> K <> Empty -> forall k :e 2 :^: K, forall top :e hl_ty_topology A :^: K, hl_locally_compact_space (K :*: A) (hl_sum_topology K A k top) = 1 <-> forall i :e K, hl_IN K i k = 1 -> hl_locally_compact_space A (top i) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:17305 / QUOTIENT_MAP_PROD_RIGHT   (hash md5:21a2f9055d73b9614cdaa01e0cb1ed60)
Theorem hlt_QUOTIENT_MAP_PROD_RIGHT : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e hl_ty_topology A, forall top1 :e hl_ty_topology B, forall top2 :e hl_ty_topology C, forall f :e C :^: B, hl_locally_compact_space A top = 1 /\ ((hl_hausdorff_space A top = 1 \/ hl_regular_space A top = 1) /\ hl_quotient_map B C (hl_pair (hl_ty_topology B) (hl_ty_topology C) top1 top2) f = 1) -> hl_quotient_map (A :*: B) (A :*: C) (hl_pair (hl_ty_topology (A :*: B)) (hl_ty_topology (A :*: C)) (hl_prod_topology A B top top1) (hl_prod_topology A C top top2)) (hl_GABS ((A :*: C) :^: (A :*: B)) (fun f1 :e (A :*: C) :^: (A :*: B) => if forall x :e A, forall y :e B, hl_GEQ (A :*: C) (f1 (hl_pair A B x y)) (hl_pair A C x (f y)) = 1 then 1 else 0)) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:17394 / QUOTIENT_MAP_PROD_LEFT   (hash md5:ecca674a9754c4ace551ac80bff71f43)
Theorem hlt_QUOTIENT_MAP_PROD_LEFT : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, forall top :e hl_ty_topology C, forall f :e B :^: A, hl_locally_compact_space C top = 1 /\ ((hl_hausdorff_space C top = 1 \/ hl_regular_space C top = 1) /\ hl_quotient_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top1 top2) f = 1) -> hl_quotient_map (A :*: C) (B :*: C) (hl_pair (hl_ty_topology (A :*: C)) (hl_ty_topology (B :*: C)) (hl_prod_topology A C top1 top) (hl_prod_topology B C top2 top)) (hl_GABS ((B :*: C) :^: (A :*: C)) (fun f1 :e (B :*: C) :^: (A :*: C) => if forall x :e A, forall y :e C, hl_GEQ (B :*: C) (f1 (hl_pair A C x y)) (hl_pair B C (f x) y) = 1 then 1 else 0)) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:17414 / QUOTIENT_MAP_PROD   (hash md5:3c71291b8236c03104fcdefeee14bf61)
Theorem hlt_QUOTIENT_MAP_PROD : forall A B C D:set, A <> Empty -> B <> Empty -> C <> Empty -> D <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology C, forall top1' :e hl_ty_topology B, forall top2' :e hl_ty_topology D, forall f :e B :^: A, forall g :e D :^: C, (hl_locally_compact_space A top1 = 1 /\ ((hl_hausdorff_space A top1 = 1 \/ hl_regular_space A top1 = 1) /\ (hl_locally_compact_space D top2' = 1 /\ (hl_hausdorff_space D top2' = 1 \/ hl_regular_space D top2' = 1))) \/ hl_locally_compact_space B top1' = 1 /\ ((hl_hausdorff_space B top1' = 1 \/ hl_regular_space B top1' = 1) /\ (hl_locally_compact_space C top2 = 1 /\ (hl_hausdorff_space C top2 = 1 \/ hl_regular_space C top2 = 1)))) /\ (hl_quotient_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top1 top1') f = 1 /\ hl_quotient_map C D (hl_pair (hl_ty_topology C) (hl_ty_topology D) top2 top2') g = 1) -> hl_quotient_map (A :*: C) (B :*: D) (hl_pair (hl_ty_topology (A :*: C)) (hl_ty_topology (B :*: D)) (hl_prod_topology A C top1 top2) (hl_prod_topology B D top1' top2')) (hl_GABS ((B :*: D) :^: (A :*: C)) (fun f1 :e (B :*: D) :^: (A :*: C) => if forall x :e A, forall y :e C, hl_GEQ (B :*: D) (f1 (hl_pair A C x y)) (hl_pair B D (f x) (g y)) = 1 then 1 else 0)) = 1.
Admitted.

