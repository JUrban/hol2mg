Admitted.

// HOL Light: Multivariate/metric.ml:29279 / HOMOTOPIC_ON_EMPTY   (hash md5:3d258cf8ce4474c32af37e6e363e2018)
Theorem hlt_HOMOTOPIC_ON_EMPTY : forall A B:set, A <> Empty -> B <> Empty -> forall P :e 2 :^: (B :^: A), forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f g :e B :^: A, hl_topspace A top = hl_EMPTY A -> (hl_homotopic_with A B P (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f g = 1 <-> P f = 1 /\ P g = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:29292 / HOMOTOPIC_CONSTANT_MAPS   (hash md5:e0d40b8378d57e41e499458f4ce898e6)
Theorem hlt_HOMOTOPIC_CONSTANT_MAPS : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall a b :e B, hl_homotopic_with A B (fun x :e B :^: A => if True then 1 else 0) (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') (fun x :e A => a) (fun x :e A => b) = 1 <-> hl_topspace A top = hl_EMPTY A \/ hl_path_component_of B top' a b = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:29313 / HOMOTOPIC_WITH_EQ   (hash md5:b0efd40fe0a43f8df32aab1e8a341664)
Theorem hlt_HOMOTOPIC_WITH_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall P :e 2 :^: (B :^: A), forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f g f' g' :e B :^: A, hl_homotopic_with A B P (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f g = 1 /\ ((forall x :e A, hl_IN A x (hl_topspace A top) = 1 -> f' x = f x /\ g' x = g x) /\ (forall h k :e B :^: A, (forall x :e A, hl_IN A x (hl_topspace A top) = 1 -> h x = k x) -> (P h = 1 <-> P k = 1))) -> hl_homotopic_with A B P (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f' g' = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:29339 / HOMOTOPIC_WITH_PROD_TOPOLOGY   (hash md5:5c7b84cafb92a553221db307be0ffaa7)
Theorem hlt_HOMOTOPIC_WITH_PROD_TOPOLOGY : forall A B C D:set, A <> Empty -> B <> Empty -> C <> Empty -> D <> Empty -> forall p :e 2 :^: (B :^: A), forall q :e 2 :^: (D :^: C), forall r :e 2 :^: ((B :*: D) :^: (A :*: C)), forall top1 :e hl_ty_topology A, forall top1' :e hl_ty_topology B, forall top2 :e hl_ty_topology C, forall top2' :e hl_ty_topology D, forall f :e B :^: A, forall g :e D :^: C, forall f' :e B :^: A, forall g' :e D :^: C, hl_homotopic_with A B p (hl_pair (hl_ty_topology A) (hl_ty_topology B) top1 top1') f f' = 1 /\ (hl_homotopic_with C D q (hl_pair (hl_ty_topology C) (hl_ty_topology D) top2 top2') g g' = 1 /\ (forall i :e B :^: A, forall j :e D :^: C, p i = 1 /\ q j = 1 -> r (hl_GABS ((B :*: D) :^: (A :*: C)) (fun f1 :e (B :*: D) :^: (A :*: C) => if forall x :e A, forall y :e C, hl_GEQ (B :*: D) (f1 (hl_pair A C x y)) (hl_pair B D (i x) (j y)) = 1 then 1 else 0)) = 1)) -> hl_homotopic_with (A :*: C) (B :*: D) r (hl_pair (hl_ty_topology (A :*: C)) (hl_ty_topology (B :*: D)) (hl_prod_topology A C top1 top2) (hl_prod_topology B D top1' top2')) (fun z :e A :*: C => hl_pair B D (f (hl_FST A C z)) (g (hl_SND A C z))) (fun z :e A :*: C => hl_pair B D (f' (hl_FST A C z)) (g' (hl_SND A C z))) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:29369 / HOMOTOPIC_WITH_PRODUCT_TOPOLOGY   (hash md5:843341b617f5304c05762ae88fc31deb)
Theorem hlt_HOMOTOPIC_WITH_PRODUCT_TOPOLOGY : forall A B K:set, A <> Empty -> B <> Empty -> K <> Empty -> forall k :e 2 :^: K, forall tops :e hl_ty_topology A :^: K, forall tops' :e hl_ty_topology B :^: K, forall p :e 2 :^: (B :^: A) :^: K, forall q :e 2 :^: (B :^: K :^: (A :^: K)), forall f g :e B :^: A :^: K, (forall i :e K, hl_IN K i k = 1 -> hl_homotopic_with A B (p i) (hl_pair (hl_ty_topology A) (hl_ty_topology B) (tops i) (tops' i)) (f i) (g i) = 1) /\ (forall h :e B :^: A :^: K, (forall i :e K, hl_IN K i k = 1 -> p i (h i) = 1) -> q (fun x :e A :^: K => hl_RESTRICTION K B k (fun i :e K => h i (x i))) = 1) -> hl_homotopic_with (A :^: K) (B :^: K) q (hl_pair (hl_ty_topology (A :^: K)) (hl_ty_topology (B :^: K)) (hl_product_topology K A k tops) (hl_product_topology K B k tops')) (fun z :e A :^: K => hl_RESTRICTION K B k (fun i :e K => f i (z i))) (fun z :e A :^: K => hl_RESTRICTION K B k (fun i :e K => g i (z i))) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:29405 / homotopy_equivalent_space   (hash md5:665f1fd92b876f0a11c055d3ab4a3d9c)
Theorem hlt_homotopy_equivalent_space_thm : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_homotopy_equivalent_space A B top top' = 1 <-> exists f :e B :^: A, exists g :e A :^: B, hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (hl_continuous_map B A (hl_pair (hl_ty_topology B) (hl_ty_topology A) top' top) g = 1 /\ (hl_homotopic_with A A (fun x :e A :^: A => if True then 1 else 0) (hl_pair (hl_ty_topology A) (hl_ty_topology A) top top) (hl_o B A A g f) (hl_I A) = 1 /\ hl_homotopic_with B B (fun x :e B :^: B => if True then 1 else 0) (hl_pair (hl_ty_topology B) (hl_ty_topology B) top' top') (hl_o A B B f g) (hl_I B) = 1)).
Admitted.

// HOL Light: Multivariate/metric.ml:29412 / HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT_SPACE   (hash md5:69dedf7a318b0f1d27908f7e4c182887)
Theorem hlt_HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT_SPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_homeomorphic_space A B top top' = 1 -> hl_homotopy_equivalent_space A B top top' = 1.
Admitted.

