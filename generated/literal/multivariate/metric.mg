Theorem hlt_REAL_SUMMABLE_COMPARISON : forall f g :e R :^: omega, forall s :e 2 :^: omega, hl_real_summable s g = 1 /\ (exists N :e omega, forall n :e omega, hl_ge n N = 1 /\ hl_IN omega n s = 1 -> hl_real_le (hl_real_abs (f n)) (g n) = 1) -> hl_real_summable s f = 1.
