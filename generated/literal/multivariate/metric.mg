Theorem hlt_SEPARATED_BETWEEN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_separated_between A top s t = 1 <-> exists u :e 2 :^: A, hl_closed_in A top u = 1 /\ (hl_open_in A top u = 1 /\ (hl_SUBSET A s u = 1 /\ hl_SUBSET A t (hl_DIFF A (hl_topspace A top) u) = 1)).
