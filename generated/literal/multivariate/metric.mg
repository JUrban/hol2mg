Theorem hlt_PASTING_LEMMA : forall A B K:set, A <> Empty -> B <> Empty -> K <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A :^: K, forall g :e B :^: A, forall t :e 2 :^: A :^: K, forall k :e 2 :^: K, (forall i :e K, hl_IN K i k = 1 -> hl_open_in A top (t i) = 1 /\ hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top (t i)) top') (f i) = 1) /\ ((forall i j :e K, forall x :e A, hl_IN K i k = 1 /\ (hl_IN K j k = 1 /\ hl_IN A x (hl_INTER A (hl_topspace A top) (hl_INTER A (t i) (t j))) = 1) -> f i x = f j x) /\ (forall x :e A, hl_IN A x (hl_topspace A top) = 1 -> exists j :e K, hl_IN K j k = 1 /\ (hl_IN A x (t j) = 1 /\ g x = f j x))) -> hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') g = 1.
Admitted.

