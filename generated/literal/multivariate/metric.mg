Theorem hlt_FRONTIER_OF_LOCALLY_CONNECTED_SUBSPACE_COMPONENT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s c :e 2 :^: A, hl_locally_connected_space A top = 1 /\ (hl_closed_in A top s = 1 /\ hl_IN (2 :^: A) c (hl_connected_components_of A (hl_subtopology A top s)) = 1) -> hl_frontier_of A top c = hl_INTER A c (hl_frontier_of A top s).
