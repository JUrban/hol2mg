Theorem hlt_CONNECTED_COMPONENTS_OF_OVERLAP : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall c c' :e 2 :^: A, hl_IN (2 :^: A) c (hl_connected_components_of A top) = 1 /\ hl_IN (2 :^: A) c' (hl_connected_components_of A top) = 1 -> (~ hl_INTER A c c' = hl_EMPTY A <-> c = c').
