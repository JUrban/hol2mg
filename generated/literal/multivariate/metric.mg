Theorem hlt_CONTRACTIBLE_SPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_contractible_space A top = 1 <-> hl_topspace A top = hl_EMPTY A \/ exists a :e A, hl_IN A a (hl_topspace A top) = 1 /\ hl_homotopic_with A A (fun x :e A :^: A => if True then 1 else 0) (hl_pair (hl_ty_topology A) (hl_ty_topology A) top top) (fun x :e A => x) (fun x :e A => a) = 1.
