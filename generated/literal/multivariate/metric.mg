// HOL Light: Multivariate/metric.ml:3623 / QUOTIENT_MAP_LIFT_EXISTS   (hash md5:290cc0510427b0070c7c102ff9b7717e)
Theorem hlt_QUOTIENT_MAP_LIFT_EXISTS : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall top'' :e hl_ty_topology C, forall f :e B :^: A, forall h :e C :^: A, hl_quotient_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (hl_continuous_map A C (hl_pair (hl_ty_topology A) (hl_ty_topology C) top top'') h = 1 /\ (forall x y :e A, hl_IN A x (hl_topspace A top) = 1 /\ (hl_IN A y (hl_topspace A top) = 1 /\ f x = f y) -> h x = h y)) -> exists g :e C :^: B, hl_continuous_map B C (hl_pair (hl_ty_topology B) (hl_ty_topology C) top' top'') g = 1 /\ (hl_IMAGE B C g (hl_topspace B top') = hl_IMAGE A C h (hl_topspace A top) /\ forall x :e A, hl_IN A x (hl_topspace A top) = 1 -> g (f x) = h x).
Admitted.

// HOL Light: Multivariate/metric.ml:3643 / DISCRETE_SPACE_QUOTIENT_MAP_IMAGE   (hash md5:f9a9e95c69997cfd6b77963051a7ffe2)
