// HOL Light: Multivariate/metric.ml:11697 / CENTRE_IN_MBALL   (hash md5:e8172892c44753179052282acb6f0949)
Theorem hlt_CENTRE_IN_MBALL : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall x :e A, forall r :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) r = 1 /\ hl_IN A x (hl_mspace A m) = 1 -> hl_IN A x (hl_mball A m (hl_pair A R x r)) = 1.
