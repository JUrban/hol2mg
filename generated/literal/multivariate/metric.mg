Theorem hlt_CLOSURE_OF_ALT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_closure_of A top s = hl_UNION A (hl_INTER A (hl_topspace A top) s) (hl_derived_set_of A top s).
