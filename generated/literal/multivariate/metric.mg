Theorem hlt_PATH_CONNECTED_IN_CONTINUOUS_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall f :e B :^: A, forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall s :e 2 :^: A, hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_path_connected_in A top s = 1 -> hl_path_connected_in B top' (hl_IMAGE A B f s) = 1.
