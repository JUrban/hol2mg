Theorem hlt_CARD_LE_CONNECTED_COMPONENTS_ALT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall n :e omega, hl_sym_3c3d5f63 omega (2 :^: A) (hl_numseg (hl_NUMERAL (hl_BIT1 hl_zero)) n) (hl_connected_components_of A top) = 1 <-> n = hl_NUMERAL hl_zero \/ exists u :e 2 :^: (2 :^: A), hl_HAS_SIZE (2 :^: A) u n = 1 /\ (hl_pairwise (2 :^: A) (hl_separated_in A top) u = 1 /\ ((forall t :e 2 :^: A, hl_IN (2 :^: A) t u = 1 -> ~ t = hl_EMPTY A) /\ hl_UNIONS A u = hl_topspace A top)).
