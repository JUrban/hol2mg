Theorem hlt_MBALL_EMPTY_ALT : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall x :e A, forall r :e R, ~ hl_IN A x (hl_mspace A m) = 1 -> hl_mball A m (hl_pair A R x r) = hl_EMPTY A.
