// HOL Light: Multivariate/metric.ml:25756 / LOCALLY_CONNECTED_SPACE   (hash md5:ce2ebe9614a43656fb58d2e87df88fcc)
Theorem hlt_LOCALLY_CONNECTED_SPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_locally_connected_space A top = 1 <-> forall v :e 2 :^: A, forall x :e A, hl_open_in A top v = 1 /\ hl_IN A x v = 1 -> exists u :e 2 :^: A, hl_open_in A top u = 1 /\ (hl_connected_in A top u = 1 /\ (hl_IN A x u = 1 /\ hl_SUBSET A u v = 1)).
