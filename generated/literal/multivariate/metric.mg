Theorem hlt_CLOSED_IN_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u s :e 2 :^: A, hl_closed_in A (hl_discrete_topology A u) s = 1 <-> hl_SUBSET A s u = 1.
