Theorem hlt_REAL_BOUNDED_REAL_INTERVAL : (forall a b :e R, hl_real_bounded (hl_closed_real_interval (hl_CONS (R :*: R) (hl_pair R R a b) (hl_NIL (R :*: R)))) = 1) /\ forall a b :e R, hl_real_bounded (hl_open_real_interval (hl_pair R R a b)) = 1.
