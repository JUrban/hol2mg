Theorem hlt_CONTINUOUS_MAP_CASES_LT : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall p q :e R :^: A, forall f g :e B :^: A, hl_continuous_map A R (hl_pair (hl_ty_topology A) (hl_ty_topology R) top hl_euclideanreal) p = 1 /\ (hl_continuous_map A R (hl_pair (hl_ty_topology A) (hl_ty_topology R) top hl_euclideanreal) q = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top (hl_GSPEC A (fun GEN_PVAR_1936 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_1936 (if hl_IN A x (hl_topspace A top) = 1 /\ hl_real_le (p x) (q x) = 1 then 1 else 0) x = 1 then 1 else 0))) top') f = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top (hl_GSPEC A (fun GEN_PVAR_1937 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_1937 (if hl_IN A x (hl_topspace A top) = 1 /\ hl_real_le (q x) (p x) = 1 then 1 else 0) x = 1 then 1 else 0))) top') g = 1 /\ (forall x :e A, hl_IN A x (hl_topspace A top) = 1 /\ p x = q x -> f x = g x)))) -> hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') (fun x :e A => hl_COND B (hl_real_lt (p x) (q x)) (f x) (g x)) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:21866 / tendsto_real_def   (hash md5:5bc7eba35e02d8030dd29e1cd14bf249)
Theorem hlt_tendsto_real_def : forall A:set, A <> Empty -> forall f :e R :^: A, forall l :e R, forall net1 :e hl_ty_net A, hl_tendsto_real A f l net1 = 1 <-> hl_limit R A hl_euclideanreal f l net1 = 1.
Admitted.

