Theorem hlt_DERIVED_SET_OF_INFINITE_OPEN_IN_METRIC : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall s :e 2 :^: A, hl_derived_set_of A (hl_mtopology A m) s = hl_GSPEC A (fun GEN_PVAR_1891 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_1891 (if hl_IN A x (hl_mspace A m) = 1 /\ forall u :e 2 :^: A, hl_IN A x u = 1 /\ hl_open_in A (hl_mtopology A m) u = 1 -> hl_INFINITE A (hl_INTER A s u) = 1 then 1 else 0) x = 1 then 1 else 0).
