// HOL Light: Multivariate/metric.ml:23328 / MONOTONE_MAP_EUCLIDEANREAL   (hash md5:4ee1a166a2c8a046e6bfc772c63535dd)
Theorem hlt_MONOTONE_MAP_EUCLIDEANREAL : forall f :e R :^: R, forall s :e 2 :^: R, hl_is_realinterval s = 1 /\ hl_continuous_map R R (hl_pair (hl_ty_topology R) (hl_ty_topology R) (hl_subtopology R hl_euclideanreal s) hl_euclideanreal) f = 1 -> (hl_monotone_map R R (hl_pair (hl_ty_topology R) (hl_ty_topology R) (hl_subtopology R hl_euclideanreal s) hl_euclideanreal) f = 1 <-> (forall x y :e R, hl_IN R x s = 1 /\ (hl_IN R y s = 1 /\ hl_real_le x y = 1) -> hl_real_le (f x) (f y) = 1) \/ forall x y :e R, hl_IN R x s = 1 /\ (hl_IN R y s = 1 /\ hl_real_le x y = 1) -> hl_real_le (f y) (f x) = 1).
