Theorem hlt_MONOTONE_MAP_INTO_EUCLIDEANREAL_ALT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall f :e R :^: A, hl_continuous_map A R (hl_pair (hl_ty_topology A) (hl_ty_topology R) top hl_euclideanreal) f = 1 -> ((forall k :e 2 :^: R, hl_is_realinterval k = 1 -> hl_connected_in A top (hl_GSPEC A (fun GEN_PVAR_1976 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_1976 (if hl_IN A x (hl_topspace A top) = 1 /\ hl_IN R (f x) k = 1 then 1 else 0) x = 1 then 1 else 0)) = 1) <-> hl_connected_space A top = 1 /\ hl_monotone_map A R (hl_pair (hl_ty_topology A) (hl_ty_topology R) top hl_euclideanreal) f = 1).
