Theorem hlt_HOMEOMORPHIC_MAP_CONNECTED_COMPONENTS_OF : forall A B:set, A <> Empty -> B <> Empty -> forall f :e B :^: A, forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_homeomorphic_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 -> hl_connected_components_of B top' = hl_IMAGE (2 :^: A) (2 :^: B) (hl_IMAGE A B f) (hl_connected_components_of A top).
