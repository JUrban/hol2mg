Theorem hlt_HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_MAP_LEFT : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall p :e 2 :^: (B :^: A), forall q :e 2 :^: (C :^: A), forall f g :e B :^: A, forall h :e C :^: B, forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, forall top3 :e hl_ty_topology C, hl_homotopic_with A B p (hl_pair (hl_ty_topology A) (hl_ty_topology B) top1 top2) f g = 1 /\ (hl_continuous_map B C (hl_pair (hl_ty_topology B) (hl_ty_topology C) top2 top3) h = 1 /\ (forall j :e B :^: A, p j = 1 -> q (hl_o B C A h j) = 1)) -> hl_homotopic_with A C q (hl_pair (hl_ty_topology A) (hl_ty_topology C) top1 top3) (hl_o B C A h f) (hl_o B C A h g) = 1.
