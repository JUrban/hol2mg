// HOL Light: Multivariate/metric.ml:22931 / PATH_COMPONENTS_OF_DISCRETE_TOPOLOGY   (hash md5:a39bd1724c1f708796e2750dcfa52d79)
Theorem hlt_PATH_COMPONENTS_OF_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u :e 2 :^: A, hl_path_components_of A (hl_discrete_topology A u) = hl_GSPEC (2 :^: A) (fun GEN_PVAR_1943 :e 2 :^: A => if exists x :e A, hl_SETSPEC (2 :^: A) GEN_PVAR_1943 (hl_IN A x u) (hl_INSERT A x (hl_EMPTY A)) = 1 then 1 else 0).
