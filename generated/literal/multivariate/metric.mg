Admitted.

// HOL Light: Multivariate/metric.ml:10068 / LINDELOF_SPACE_SUBTOPOLOGY_SUBSET   (hash md5:77661c229dad9e3905dbf36600f95fd7)
Theorem hlt_LINDELOF_SPACE_SUBTOPOLOGY_SUBSET : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_SUBSET A s (hl_topspace A top) = 1 -> (hl_lindelof_space A (hl_subtopology A top s) = 1 <-> forall U :e 2 :^: (2 :^: A), (forall u :e 2 :^: A, hl_IN (2 :^: A) u U = 1 -> hl_open_in A top u = 1) /\ hl_SUBSET A s (hl_UNIONS A U) = 1 -> exists V :e 2 :^: (2 :^: A), hl_COUNTABLE (2 :^: A) V = 1 /\ (hl_SUBSET (2 :^: A) V U = 1 /\ hl_SUBSET A s (hl_UNIONS A V) = 1)).
Admitted.

// HOL Light: Multivariate/metric.ml:10077 / LINDELOF_SPACE_CLOSED_IN_SUBTOPOLOGY   (hash md5:4983e4c3cc9544eb6a6adcc84cf2cbcb)
Theorem hlt_LINDELOF_SPACE_CLOSED_IN_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_lindelof_space A top = 1 /\ hl_closed_in A top s = 1 -> hl_lindelof_space A (hl_subtopology A top s) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:10103 / LINDELOF_SPACE_CONTINUOUS_MAP_IMAGE   (hash md5:3ac7be309f107b366ba6989d754503c6)
Theorem hlt_LINDELOF_SPACE_CONTINUOUS_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_lindelof_space A top = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_IMAGE A B f (hl_topspace A top) = hl_topspace B top') -> hl_lindelof_space B top' = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:10119 / LINDELOF_SPACE_QUOTIENT_MAP_IMAGE   (hash md5:7c268ef5728dc5e54467dcfb46d1baa3)
Theorem hlt_LINDELOF_SPACE_QUOTIENT_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall q :e B :^: A, hl_quotient_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') q = 1 /\ hl_lindelof_space A top = 1 -> hl_lindelof_space B top' = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:10126 / LINDELOF_SPACE_RETRACTION_MAP_IMAGE   (hash md5:1218313b54b32f670dccc625b7051b77)
Theorem hlt_LINDELOF_SPACE_RETRACTION_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall r :e B :^: A, hl_retraction_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') r = 1 /\ hl_lindelof_space A top = 1 -> hl_lindelof_space B top' = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:10133 / LOCALLY_FINITE_COVER_OF_LINDELOF_SPACE   (hash md5:df0fa24189e9832a17068d76e2e4b26c)
Theorem hlt_LOCALLY_FINITE_COVER_OF_LINDELOF_SPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall u :e 2 :^: (2 :^: A), hl_lindelof_space A top = 1 /\ (hl_SUBSET A (hl_topspace A top) (hl_UNIONS A u) = 1 /\ hl_locally_finite_in A top u = 1) -> hl_COUNTABLE (2 :^: A) u = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:10162 / LINDELOF_SPACE_PROPER_MAP_PREIMAGE   (hash md5:76712293e99d8192177f3267d45f92c8)
Theorem hlt_LINDELOF_SPACE_PROPER_MAP_PREIMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_proper_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_lindelof_space B top' = 1 -> hl_lindelof_space A top = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:10204 / LINDELOF_SPACE_PERFECT_MAP_IMAGE   (hash md5:eeb59490c3ce2920a175197e7d919bad)
Theorem hlt_LINDELOF_SPACE_PERFECT_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_lindelof_space A top = 1 /\ hl_perfect_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 -> hl_lindelof_space B top' = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:10209 / LINDELOF_SPACE_PERFECT_MAP_IMAGE_EQ   (hash md5:6e8434790823e65e91c2255f91dcde9a)
Theorem hlt_LINDELOF_SPACE_PERFECT_MAP_IMAGE_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_perfect_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 -> (hl_lindelof_space A top = 1 <-> hl_lindelof_space B top' = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:10220 / second_countable   (hash md5:9577a94caf0b03c8fc4a8faca3919147)
Theorem hlt_second_countable_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_second_countable A top = 1 <-> exists b :e 2 :^: (2 :^: A), hl_COUNTABLE (2 :^: A) b = 1 /\ ((forall v :e 2 :^: A, hl_IN (2 :^: A) v b = 1 -> hl_open_in A top v = 1) /\ forall u :e 2 :^: A, forall x :e A, hl_open_in A top u = 1 /\ hl_IN A x u = 1 -> exists v :e 2 :^: A, hl_IN (2 :^: A) v b = 1 /\ (hl_IN A x v = 1 /\ hl_SUBSET A v u = 1)).
Admitted.

// HOL Light: Multivariate/metric.ml:10227 / first_countable   (hash md5:9e839deb18e2e9d43965a0b91a0501b3)
Theorem hlt_first_countable_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_first_countable A top = 1 <-> forall x :e A, hl_IN A x (hl_topspace A top) = 1 -> exists b :e 2 :^: (2 :^: A), hl_COUNTABLE (2 :^: A) b = 1 /\ ((forall v :e 2 :^: A, hl_IN (2 :^: A) v b = 1 -> hl_open_in A top v = 1) /\ forall u :e 2 :^: A, hl_open_in A top u = 1 /\ hl_IN A x u = 1 -> exists v :e 2 :^: A, hl_IN (2 :^: A) v b = 1 /\ (hl_IN A x v = 1 /\ hl_SUBSET A v u = 1)).
Admitted.

// HOL Light: Multivariate/metric.ml:10235 / separable_space   (hash md5:43120608288838a9f5a227a73f44a582)
Theorem hlt_separable_space_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_separable_space A top = 1 <-> exists c :e 2 :^: A, hl_COUNTABLE A c = 1 /\ (hl_SUBSET A c (hl_topspace A top) = 1 /\ hl_closure_of A top c = hl_topspace A top).
Admitted.

// HOL Light: Multivariate/metric.ml:10241 / SECOND_COUNTABLE   (hash md5:e90e9e77c0a83963884b0c66b8f1c6c5)
Theorem hlt_SECOND_COUNTABLE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_second_countable A top = 1 <-> exists b :e 2 :^: (2 :^: A), hl_COUNTABLE (2 :^: A) b = 1 /\ hl_open_in A top = hl_UNION_OF A (hl_ARBITRARY A) b.
Admitted.

// HOL Light: Multivariate/metric.ml:10247 / SECOND_COUNTABLE_SUBTOPOLOGY   (hash md5:360b529b1c6249a22f674383f123a424)
Theorem hlt_SECOND_COUNTABLE_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_second_countable A top = 1 -> hl_second_countable A (hl_subtopology A top s) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:10259 / SECOND_COUNTABLE_DISCRETE_TOPOLOGY   (hash md5:51773733fada041c86a6e60d5f0193c2)
Theorem hlt_SECOND_COUNTABLE_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u :e 2 :^: A, hl_second_countable A (hl_discrete_topology A u) = 1 <-> hl_COUNTABLE A u = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:10277 / SECOND_COUNTABLE_OPEN_MAP_IMAGE   (hash md5:234aa94aaee74eba67b4a56be2dd6787)
Theorem hlt_SECOND_COUNTABLE_OPEN_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall f :e B :^: A, forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (hl_open_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (hl_IMAGE A B f (hl_topspace A top) = hl_topspace B top' /\ hl_second_countable A top = 1)) -> hl_second_countable B top' = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:10299 / HOMEOMORPHIC_SPACE_SECOND_COUNTABILITY   (hash md5:6a68cf51f8755b753ea3cf95f751180c)
Theorem hlt_HOMEOMORPHIC_SPACE_SECOND_COUNTABILITY : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_homeomorphic_space A B top top' = 1 -> (hl_second_countable A top = 1 <-> hl_second_countable B top' = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:10307 / SECOND_COUNTABLE_RETRACTION_MAP_IMAGE   (hash md5:37dc1fc0239fba655c32615c34d33245)
Theorem hlt_SECOND_COUNTABLE_RETRACTION_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall r :e B :^: A, hl_retraction_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') r = 1 /\ hl_second_countable A top = 1 -> hl_second_countable B top' = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:10315 / SECOND_COUNTABLE_IMP_FIRST_COUNTABLE   (hash md5:337faec8094eb6687418ad984869ace4)
Theorem hlt_SECOND_COUNTABLE_IMP_FIRST_COUNTABLE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_second_countable A top = 1 -> hl_first_countable A top = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:10321 / FIRST_COUNTABLE_SUBTOPOLOGY   (hash md5:d1d3a4b8906f96cbace3a67caa68d76c)
Theorem hlt_FIRST_COUNTABLE_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_first_countable A top = 1 -> hl_first_countable A (hl_subtopology A top s) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:10332 / FIRST_COUNTABLE_DISCRETE_TOPOLOGY   (hash md5:457013d074dea7b8e4f7e33acd7d98a0)
Theorem hlt_FIRST_COUNTABLE_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u :e 2 :^: A, hl_first_countable A (hl_discrete_topology A u) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:10340 / FIRST_COUNTABLE_OPEN_MAP_IMAGE   (hash md5:20b7acaeab75be9a08ecde3166ba96a2)
Theorem hlt_FIRST_COUNTABLE_OPEN_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall f :e B :^: A, forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (hl_open_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (hl_IMAGE A B f (hl_topspace A top) = hl_topspace B top' /\ hl_first_countable A top = 1)) -> hl_first_countable B top' = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:10364 / HOMEOMORPHIC_SPACE_FIRST_COUNTABILITY   (hash md5:4f20614ac12895d612959880e1d5ba9e)
Theorem hlt_HOMEOMORPHIC_SPACE_FIRST_COUNTABILITY : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_homeomorphic_space A B top top' = 1 -> (hl_first_countable A top = 1 <-> hl_first_countable B top' = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:10372 / FIRST_COUNTABLE_RETRACTION_MAP_IMAGE   (hash md5:427bd227ad6970a20918cd7d6f6a203d)
Theorem hlt_FIRST_COUNTABLE_RETRACTION_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall r :e B :^: A, hl_retraction_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') r = 1 /\ hl_first_countable A top = 1 -> hl_first_countable B top' = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:10380 / SEPARABLE_SPACE_OPEN_SUBSET   (hash md5:db1455b2d5ddcf1f4c2d613fc299baea)
Theorem hlt_SEPARABLE_SPACE_OPEN_SUBSET : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_separable_space A top = 1 /\ hl_open_in A top s = 1 -> hl_separable_space A (hl_subtopology A top s) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:10395 / SEPARABLE_SPACE_CONTINUOUS_MAP_IMAGE   (hash md5:c96b89c2b377484fb55fd4068a078da3)
Theorem hlt_SEPARABLE_SPACE_CONTINUOUS_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_separable_space A top = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_IMAGE A B f (hl_topspace A top) = hl_topspace B top') -> hl_separable_space B top' = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:10409 / SEPARABLE_SPACE_QUOTIENT_MAP_IMAGE   (hash md5:a16c0e9b6bea6445f8cf2ce24d05f804)
Theorem hlt_SEPARABLE_SPACE_QUOTIENT_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall q :e B :^: A, hl_quotient_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') q = 1 /\ hl_separable_space A top = 1 -> hl_separable_space B top' = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:10416 / SEPARABLE_SPACE_RETRACTION_MAP_IMAGE   (hash md5:69e0e5e4116e866d43f94d299ba04ea0)
Theorem hlt_SEPARABLE_SPACE_RETRACTION_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall r :e B :^: A, hl_retraction_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') r = 1 /\ hl_separable_space A top = 1 -> hl_separable_space B top' = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:10423 / HOMEOMORPHIC_SEPARABLE_SPACE   (hash md5:0cb2dd650d20dc301804162cf9790369)
Theorem hlt_HOMEOMORPHIC_SEPARABLE_SPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_homeomorphic_space A B top top' = 1 -> (hl_separable_space A top = 1 <-> hl_separable_space B top' = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:10431 / SEPARABLE_SPACE_DISCRETE_TOPOLOGY   (hash md5:b7af3932dc4a15881531df196c6428af)
Theorem hlt_SEPARABLE_SPACE_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u :e 2 :^: A, hl_separable_space A (hl_discrete_topology A u) = 1 <-> hl_COUNTABLE A u = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:10438 / SECOND_COUNTABLE_IMP_SEPARABLE_SPACE   (hash md5:aa14a32f5dea1c21a67558acb14ef904)
Theorem hlt_SECOND_COUNTABLE_IMP_SEPARABLE_SPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_second_countable A top = 1 -> hl_separable_space A top = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:10455 / SECOND_COUNTABLE_IMP_LINDELOF_SPACE   (hash md5:fed83c7ad6e37691351648ecba703e9b)
Theorem hlt_SECOND_COUNTABLE_IMP_LINDELOF_SPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_second_countable A top = 1 -> hl_lindelof_space A top = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:10479 / net_tybij   (hash md5:d7d089616de5f75437794a1190d8cd74)
Theorem hlt_net_tybij : forall A:set, A <> Empty -> (forall a :e hl_ty_net A, hl_mk_net A (hl_dest_net A a) = a) /\ forall r :e 2 :^: (2 :^: A) :*: 2 :^: A, (forall s t :e 2 :^: A, hl_IN (2 :^: A) s (hl_FST (2 :^: (2 :^: A)) (2 :^: A) r) = 1 /\ hl_IN (2 :^: A) t (hl_FST (2 :^: (2 :^: A)) (2 :^: A) r) = 1 -> hl_IN (2 :^: A) (hl_INTER A s t) (hl_FST (2 :^: (2 :^: A)) (2 :^: A) r) = 1) <-> hl_dest_net A (hl_mk_net A r) = r.
Admitted.

// HOL Light: Multivariate/metric.ml:10486 / netfilter   (hash md5:b0486ab12ad318521bb37caded036ece)
Theorem hlt_netfilter_thm : forall A:set, A <> Empty -> forall n :e hl_ty_net A, hl_netfilter A n = hl_FST (2 :^: (2 :^: A)) (2 :^: A) (hl_dest_net A n).
Admitted.

// HOL Light: Multivariate/metric.ml:10489 / netlimits   (hash md5:c307bc2dc4a59258bbea58e6ac5cfe9b)
Theorem hlt_netlimits_thm : forall A:set, A <> Empty -> forall n :e hl_ty_net A, hl_netlimits A n = hl_SND (2 :^: (2 :^: A)) (2 :^: A) (hl_dest_net A n).
Admitted.

// HOL Light: Multivariate/metric.ml:10492 / netlimit   (hash md5:b398cfee2b7b08c9c6dec595009f4046)
Theorem hlt_netlimit_thm : forall A:set, A <> Empty -> forall n :e hl_ty_net A, hl_netlimit A n = hl_select A (fun x :e A => hl_IN A x (hl_netlimits A n)).
Admitted.

// HOL Light: Multivariate/metric.ml:10495 / NET   (hash md5:f4925e0cd65839708305c707fb75dad1)
Theorem hlt_NET : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall n :e hl_ty_net C, forall s :e A, forall t :e B, forall s1 t1 :e 2 :^: C, hl_IN (2 :^: C) s1 (hl_netfilter C n) = 1 /\ hl_IN (2 :^: C) t1 (hl_netfilter C n) = 1 -> hl_IN (2 :^: C) (hl_INTER C s1 t1) (hl_netfilter C n) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:10506 / within   (hash md5:c45af53fe7bf69915dd6ac2a712146fe)
Theorem hlt_within_thm : forall A:set, A <> Empty -> forall s :e 2 :^: A, forall net1 :e hl_ty_net A, hl_within A net1 s = hl_mk_net A (hl_pair (2 :^: (2 :^: A)) (2 :^: A) (hl_relative_to A (hl_netfilter A net1) s) (hl_netlimits A net1)).
Admitted.

// HOL Light: Multivariate/metric.ml:10509 / NETLIMITS_WITHIN   (hash md5:60fcbf52938ac2dc3d62f15229699a13)
Theorem hlt_NETLIMITS_WITHIN : forall A:set, A <> Empty -> forall n :e hl_ty_net A, forall s :e 2 :^: A, hl_netlimits A (hl_within A n s) = hl_netlimits A n.
Admitted.

// HOL Light: Multivariate/metric.ml:10509 / WITHIN   (hash md5:cd3e47e2686a6a2e6a08afcdc1499f74)
Theorem hlt_WITHIN : forall A:set, A <> Empty -> forall n :e hl_ty_net A, forall s :e 2 :^: A, hl_netfilter A (hl_within A n s) = hl_relative_to A (hl_netfilter A n) s.
Admitted.

// HOL Light: Multivariate/metric.ml:10526 / NET_WITHIN_UNIV   (hash md5:d29645dcab004ce6654b2ac8d82b72b3)
Theorem hlt_NET_WITHIN_UNIV : forall A:set, A <> Empty -> forall net1 :e hl_ty_net A, hl_within A net1 (hl_UNIV A) = net1.
Admitted.

// HOL Light: Multivariate/metric.ml:10535 / WITHIN_WITHIN   (hash md5:97cebddce9d27e9fd4a5c58723517bb1)
Theorem hlt_WITHIN_WITHIN : forall A:set, A <> Empty -> forall net1 :e hl_ty_net A, forall s t :e 2 :^: A, hl_within A (hl_within A net1 s) t = hl_within A net1 (hl_INTER A s t).
Admitted.

// HOL Light: Multivariate/metric.ml:10548 / eventually   (hash md5:6813e73aa9cd7853047e540feb2f784b)
Theorem hlt_eventually_thm : forall A:set, A <> Empty -> forall net1 :e hl_ty_net A, forall P :e 2 :^: A, hl_eventually A P net1 = 1 <-> hl_netfilter A net1 = hl_EMPTY (2 :^: A) \/ exists u :e 2 :^: A, hl_IN (2 :^: A) u (hl_netfilter A net1) = 1 /\ forall x :e A, hl_IN A x (hl_DIFF A u (hl_netlimits A net1)) = 1 -> P x = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:10554 / trivial_limit   (hash md5:aaf903fa0e13e8f9dc6db6cf215f79d2)
Theorem hlt_trivial_limit_thm : forall A:set, A <> Empty -> forall net1 :e hl_ty_net A, hl_trivial_limit A net1 = 1 <-> hl_eventually A (fun x :e A => if False then 1 else 0) net1 = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:10557 / EVENTUALLY_WITHIN_IMP   (hash md5:b8e4262325145aacbf96b03975065139)
Theorem hlt_EVENTUALLY_WITHIN_IMP : forall A:set, A <> Empty -> forall net1 :e hl_ty_net A, forall P s :e 2 :^: A, hl_eventually A P (hl_within A net1 s) = 1 <-> hl_eventually A (fun x :e A => if hl_IN A x s = 1 -> P x = 1 then 1 else 0) net1 = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:10564 / EVENTUALLY_IMP_WITHIN   (hash md5:e474abdc15b3804c6769575728fbb669)
