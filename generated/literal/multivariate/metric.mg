Theorem hlt_CONNECTED_IN_ABSOLUTE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_connected_in A (hl_subtopology A top s) s = 1 <-> hl_connected_in A top s = 1.
