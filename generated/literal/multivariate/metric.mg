// HOL Light: Multivariate/metric.ml:26723 / QUASI_EQ_CONNECTED_COMPONENT_OF_EQ   (hash md5:7ef3a54e967181ea9e751f7c3ccd0ad5)
Theorem hlt_QUASI_EQ_CONNECTED_COMPONENT_OF_EQ : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall x :e A, hl_quasi_component_of A top x = hl_connected_component_of A top x <-> hl_connected_in A top (hl_quasi_component_of A top x) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:26739 / CONNECTED_QUASI_COMPONENT_OF   (hash md5:98c470648cafc25f1a9499c785812fe8)
Theorem hlt_CONNECTED_QUASI_COMPONENT_OF : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall c :e 2 :^: A, hl_IN (2 :^: A) c (hl_quasi_components_of A top) = 1 -> (hl_IN (2 :^: A) c (hl_connected_components_of A top) = 1 <-> hl_connected_in A top c = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:26751 / QUASI_COMPONENT_OF_CLOPEN_CASES   (hash md5:778face235b89d2e083548c7fd876824)
Theorem hlt_QUASI_COMPONENT_OF_CLOPEN_CASES : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall c t :e 2 :^: A, hl_IN (2 :^: A) c (hl_quasi_components_of A top) = 1 /\ (hl_closed_in A top t = 1 /\ hl_open_in A top t = 1) -> hl_SUBSET A c t = 1 \/ hl_DISJOINT A c t = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:26761 / QUASI_COMPONENTS_OF_SET   (hash md5:50a71c3656136c93c3639f88818678f4)
Theorem hlt_QUASI_COMPONENTS_OF_SET : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall c :e 2 :^: A, hl_IN (2 :^: A) c (hl_quasi_components_of A top) = 1 -> hl_INTERS A (hl_GSPEC (2 :^: A) (fun GEN_PVAR_2044 :e 2 :^: A => if exists t :e 2 :^: A, hl_SETSPEC (2 :^: A) GEN_PVAR_2044 (if hl_closed_in A top t = 1 /\ (hl_open_in A top t = 1 /\ hl_SUBSET A c t = 1) then 1 else 0) t = 1 then 1 else 0)) = c.
Admitted.

// HOL Light: Multivariate/metric.ml:26777 / OPEN_QUASI_EQ_CONNECTED_COMPONENTS_OF   (hash md5:5627976eee01dbdde99f3fc45b8dfde2)
