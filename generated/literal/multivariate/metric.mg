Theorem hlt_OPEN_IN_UNION : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_open_in A top s = 1 /\ hl_open_in A top t = 1 -> hl_open_in A top (hl_UNION A s t) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:123 / OPEN_IN_TOPSPACE   (hash md5:ae16fffebf28c40f9b7a08b291f12cc4)
Theorem hlt_OPEN_IN_TOPSPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_open_in A top (hl_topspace A top) = 1.
