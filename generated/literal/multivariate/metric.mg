// HOL Light: Multivariate/metric.ml:5533 / HOMEOMORPHIC_MAPS_PROD   (hash md5:1691deb1e1ec30df6fbbb9b368907ab4)
Theorem hlt_HOMEOMORPHIC_MAPS_PROD : forall A B C D:set, A <> Empty -> B <> Empty -> C <> Empty -> D <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology C, forall top3 :e hl_ty_topology B, forall top4 :e hl_ty_topology D, forall f :e B :^: A, forall g :e D :^: C, forall f' :e A :^: B, forall g' :e C :^: D, hl_homeomorphic_maps (A :*: C) (B :*: D) (hl_pair (hl_ty_topology (A :*: C)) (hl_ty_topology (B :*: D)) (hl_prod_topology A C top1 top2) (hl_prod_topology B D top3 top4)) (hl_pair ((B :*: D) :^: (A :*: C)) ((A :*: C) :^: (B :*: D)) (hl_GABS ((B :*: D) :^: (A :*: C)) (fun f1 :e (B :*: D) :^: (A :*: C) => if forall x :e A, forall y :e C, hl_GEQ (B :*: D) (f1 (hl_pair A C x y)) (hl_pair B D (f x) (g y)) = 1 then 1 else 0)) (hl_GABS ((A :*: C) :^: (B :*: D)) (fun f1 :e (A :*: C) :^: (B :*: D) => if forall x :e B, forall y :e D, hl_GEQ (A :*: C) (f1 (hl_pair B D x y)) (hl_pair A C (f' x) (g' y)) = 1 then 1 else 0))) = 1 <-> hl_topspace (A :*: C) (hl_prod_topology A C top1 top2) = hl_EMPTY (A :*: C) /\ hl_topspace (B :*: D) (hl_prod_topology B D top3 top4) = hl_EMPTY (B :*: D) \/ hl_homeomorphic_maps A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top1 top3) (hl_pair (B :^: A) (A :^: B) f f') = 1 /\ hl_homeomorphic_maps C D (hl_pair (hl_ty_topology C) (hl_ty_topology D) top2 top4) (hl_pair (D :^: C) (C :^: D) g g') = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:5546 / HOMEOMORPHIC_MAPS_SWAP   (hash md5:c2ed80722d2b5a2c0084473f1b2898ba)
Theorem hlt_HOMEOMORPHIC_MAPS_SWAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_homeomorphic_maps (A :*: B) (B :*: A) (hl_pair (hl_ty_topology (A :*: B)) (hl_ty_topology (B :*: A)) (hl_prod_topology A B top top') (hl_prod_topology B A top' top)) (hl_pair ((B :*: A) :^: (A :*: B)) ((A :*: B) :^: (B :*: A)) (hl_GABS ((B :*: A) :^: (A :*: B)) (fun f :e (B :*: A) :^: (A :*: B) => if forall x :e A, forall y :e B, hl_GEQ (B :*: A) (f (hl_pair A B x y)) (hl_pair B A y x) = 1 then 1 else 0)) (hl_GABS ((A :*: B) :^: (B :*: A)) (fun f :e (A :*: B) :^: (B :*: A) => if forall y :e B, forall x :e A, hl_GEQ (A :*: B) (f (hl_pair B A y x)) (hl_pair A B x y) = 1 then 1 else 0))) = 1.
Admitted.

