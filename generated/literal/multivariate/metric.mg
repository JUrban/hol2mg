Theorem hlt_SECOND_COUNTABLE_CLOSED_MAP_IMAGE : forall B C:set, B <> Empty -> C <> Empty -> forall f :e C :^: B, forall top :e hl_ty_topology B, forall top' :e hl_ty_topology C, hl_continuous_map B C (hl_pair (hl_ty_topology B) (hl_ty_topology C) top top') f = 1 /\ (hl_closed_map B C (hl_pair (hl_ty_topology B) (hl_ty_topology C) top top') f = 1 /\ (hl_compact_space B top = 1 /\ (hl_hausdorff_space C top' = 1 /\ (hl_IMAGE B C f (hl_topspace B top) = hl_topspace C top' /\ hl_second_countable B top = 1)))) -> hl_second_countable C top' = 1.
Admitted.

