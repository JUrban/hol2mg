Theorem hlt_DISCRETE_SPACE_OPEN_EQ : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_discrete_space A top = 1 <-> forall s :e 2 :^: A, hl_open_in A top s = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1.
