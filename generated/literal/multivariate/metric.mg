// HOL Light: Multivariate/metric.ml:3748 / OPEN_IN_CROSS   (hash md5:3fb9276ec9ae2148f1ed2c95cac2b810)
Theorem hlt_OPEN_IN_CROSS : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, forall s :e 2 :^: A, forall t :e 2 :^: B, hl_open_in (A :*: B) (hl_prod_topology A B top1 top2) (hl_CROSS A B s t) = 1 <-> s = hl_EMPTY A \/ (t = hl_EMPTY B \/ hl_open_in A top1 s = 1 /\ hl_open_in B top2 t = 1).
