Theorem hlt_ISTOPOLOGY_BASE : forall A:set, A <> Empty -> forall P :e 2 :^: (2 :^: A), (forall s t :e 2 :^: A, P s = 1 /\ P t = 1 -> P (hl_INTER A s t) = 1) -> hl_istopology A (hl_UNION_OF A (hl_ARBITRARY A) P) = 1.
