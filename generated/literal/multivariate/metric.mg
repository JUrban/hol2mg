// HOL Light: Multivariate/metric.ml:17973 / real_bounded   (hash md5:2b5748b83326c046695808567bfbe41c)
Theorem hlt_real_bounded_thm : forall s :e 2 :^: R, hl_real_bounded s = 1 <-> exists B :e R, forall x :e R, hl_IN R x s = 1 -> hl_real_le (hl_real_abs x) B = 1.
