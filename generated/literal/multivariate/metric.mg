// HOL Light: Multivariate/metric.ml:1180 / CLOSURE_OF_UNIONS   (hash md5:c1600ead7baef8bc37bed1fd0bd5ca49)
Theorem hlt_CLOSURE_OF_UNIONS : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall f :e 2 :^: (2 :^: A), hl_FINITE (2 :^: A) f = 1 -> hl_closure_of A top (hl_UNIONS A f) = hl_UNIONS A (hl_GSPEC (2 :^: A) (fun GEN_PVAR_1250 :e 2 :^: A => if exists s :e 2 :^: A, hl_SETSPEC (2 :^: A) GEN_PVAR_1250 (hl_IN (2 :^: A) s f) (hl_closure_of A top s) = 1 then 1 else 0)).
Admitted.

// HOL Light: Multivariate/metric.ml:1188 / CLOSURE_OF_SUBSET   (hash md5:a58b997ba4e80779f95dd3e7def8334e)
