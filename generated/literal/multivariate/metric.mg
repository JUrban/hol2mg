Theorem hlt_HAUSDORFF_SPACE_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u :e 2 :^: A, hl_hausdorff_space A (hl_discrete_topology A u) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:8201 / COMPACT_IN_INTER   (hash md5:957ae0c17e00a77fd96e11f906fef16d)
Theorem hlt_COMPACT_IN_INTER : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_hausdorff_space A top = 1 /\ (hl_compact_in A top s = 1 /\ hl_compact_in A top t = 1) -> hl_compact_in A top (hl_INTER A s t) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:8207 / FINITE_TOPSPACE_IMP_DISCRETE_TOPOLOGY   (hash md5:0b441a9d7d1a73db040e9d918915f360)
Theorem hlt_FINITE_TOPSPACE_IMP_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u :e 2 :^: A, forall top :e hl_ty_topology A, hl_topspace A top = u /\ (hl_FINITE A u = 1 /\ hl_hausdorff_space A top = 1) -> top = hl_discrete_topology A u.
Admitted.

// HOL Light: Multivariate/metric.ml:8214 / DERIVED_SET_OF_FINITE   (hash md5:6a58f3307cfad663ed80d0ceccc56980)
Theorem hlt_DERIVED_SET_OF_FINITE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_hausdorff_space A top = 1 /\ hl_FINITE A s = 1 -> hl_derived_set_of A top s = hl_EMPTY A.
Admitted.

// HOL Light: Multivariate/metric.ml:8219 / DERIVED_SET_OF_SING   (hash md5:0b25e7e61f6ac261c6cd83eecc9c2d97)
Theorem hlt_DERIVED_SET_OF_SING : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall x :e A, hl_hausdorff_space A top = 1 -> hl_derived_set_of A top (hl_INSERT A x (hl_EMPTY A)) = hl_EMPTY A.
Admitted.

// HOL Light: Multivariate/metric.ml:8223 / CLOSED_IN_HAUSDORFF_FINITE   (hash md5:75b4740636259557f4afa27bfe5bb07a)
Theorem hlt_CLOSED_IN_HAUSDORFF_FINITE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_hausdorff_space A top = 1 /\ (hl_SUBSET A s (hl_topspace A top) = 1 /\ hl_FINITE A s = 1) -> hl_closed_in A top s = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:8229 / OPEN_IN_HAUSDORFF_DELETE   (hash md5:4566ad61b2cff6df49892eee7d8dad64)
Theorem hlt_OPEN_IN_HAUSDORFF_DELETE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, forall x :e A, hl_hausdorff_space A top = 1 /\ hl_open_in A top s = 1 -> hl_open_in A top (hl_DELETE A s x) = 1.
