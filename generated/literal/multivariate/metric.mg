Theorem hlt_CONNECTED_COMPONENT_OF_PRODUCT_TOPOLOGY : forall A K:set, A <> Empty -> K <> Empty -> forall k :e 2 :^: K, forall tops :e hl_ty_topology A :^: K, forall x :e A :^: K, hl_connected_component_of (A :^: K) (hl_product_topology K A k tops) x = hl_COND (2 :^: (A :^: K)) (hl_EXTENSIONAL K A k x) (hl_cartesian_product K A k (fun i :e K => hl_connected_component_of A (tops i) (x i))) (hl_EMPTY (A :^: K)).
