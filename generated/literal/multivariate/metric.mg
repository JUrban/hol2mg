// HOL Light: Multivariate/metric.ml:14487 / connected_components_of   (hash md5:4a37f307f3337b73fc6cf6814627aca8)
Theorem hlt_connected_components_of_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_connected_components_of A top = hl_GSPEC (2 :^: A) (fun GEN_PVAR_1686 :e 2 :^: A => if exists x :e A, hl_SETSPEC (2 :^: A) GEN_PVAR_1686 (hl_IN A x (hl_topspace A top)) (hl_connected_component_of A top x) = 1 then 1 else 0).
Admitted.

