Theorem hlt_LINDELOF_SPACE_ALT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_lindelof_space A top = 1 <-> forall U :e 2 :^: (2 :^: A), (forall u :e 2 :^: A, hl_IN (2 :^: A) u U = 1 -> hl_open_in A top u = 1) /\ hl_SUBSET A (hl_topspace A top) (hl_UNIONS A U) = 1 -> exists V :e 2 :^: (2 :^: A), hl_COUNTABLE (2 :^: A) V = 1 /\ (hl_SUBSET (2 :^: A) V U = 1 /\ hl_SUBSET A (hl_topspace A top) (hl_UNIONS A V) = 1).
Admitted.

