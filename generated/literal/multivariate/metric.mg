Theorem hlt_TENDSTO_REAL_EPS_DELTA : forall A:set, A <> Empty -> forall f :e R :^: A, forall l :e R, forall net1 :e hl_ty_net A, hl_tendsto_real A f l net1 = 1 <-> forall e1 :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) e1 = 1 -> hl_eventually A (fun x :e A => hl_real_lt (hl_real_abs (hl_real_sub (f x) l)) e1) net1 = 1.
Admitted.

