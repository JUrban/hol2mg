Theorem hlt_FRONTIER_OF_SUBSET_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_SUBSET A (hl_frontier_of A (hl_subtopology A top s) t) s = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:1759 / FRONTIER_OF_SUBTOPOLOGY_SUBSET   (hash md5:b604a79d4cf31d534cc401107f8ca587)
Theorem hlt_FRONTIER_OF_SUBTOPOLOGY_SUBSET : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s u :e 2 :^: A, hl_SUBSET A (hl_INTER A u (hl_frontier_of A (hl_subtopology A top u) s)) (hl_frontier_of A top s) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:1767 / FRONTIER_OF_SUBTOPOLOGY_MONO   (hash md5:bf2e923c972c027bb8170743558c6ad3)
Theorem hlt_FRONTIER_OF_SUBTOPOLOGY_MONO : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t u :e 2 :^: A, hl_SUBSET A s t = 1 /\ hl_SUBSET A t u = 1 -> hl_SUBSET A (hl_frontier_of A (hl_subtopology A top t) s) (hl_frontier_of A (hl_subtopology A top u) s) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:1776 / CLOPEN_IN_EQ_FRONTIER_OF   (hash md5:c4ac5e07e0c8b39a055d9ccd036b29e5)
Theorem hlt_CLOPEN_IN_EQ_FRONTIER_OF : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_closed_in A top s = 1 /\ hl_open_in A top s = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1 /\ hl_frontier_of A top s = hl_EMPTY A.
Admitted.

// HOL Light: Multivariate/metric.ml:1791 / FRONTIER_OF_EQ_EMPTY   (hash md5:b7e20db90f9154d9dc55518140d2a914)
Theorem hlt_FRONTIER_OF_EQ_EMPTY : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_SUBSET A s (hl_topspace A top) = 1 -> (hl_frontier_of A top s = hl_EMPTY A <-> hl_closed_in A top s = 1 /\ hl_open_in A top s = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:1797 / FRONTIER_OF_OPEN_IN   (hash md5:5e2530dcfa5f135fdc55b6d6e82b54f3)
Theorem hlt_FRONTIER_OF_OPEN_IN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_open_in A top s = 1 -> hl_frontier_of A top s = hl_DIFF A (hl_closure_of A top s) s.
Admitted.

// HOL Light: Multivariate/metric.ml:1802 / FRONTIER_OF_OPEN_IN_STRADDLE_INTER   (hash md5:05a277a45eb36695424b1fd7f09e82df)
Theorem hlt_FRONTIER_OF_OPEN_IN_STRADDLE_INTER : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s u :e 2 :^: A, hl_open_in A top u = 1 /\ ~ hl_INTER A u (hl_frontier_of A top s) = hl_EMPTY A -> ~ hl_INTER A u s = hl_EMPTY A /\ ~ hl_DIFF A u s = hl_EMPTY A.
Admitted.

// HOL Light: Multivariate/metric.ml:1816 / FRONTIER_OF_SUBSET_CLOSED_IN   (hash md5:69d812e5be068bcc4b1b43687cf7ce63)
Theorem hlt_FRONTIER_OF_SUBSET_CLOSED_IN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_closed_in A top s = 1 -> hl_SUBSET A (hl_frontier_of A top s) s = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:1820 / FRONTIER_OF_EMPTY   (hash md5:016c3508c5e96e130f8e8b3dd06991d4)
Theorem hlt_FRONTIER_OF_EMPTY : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_frontier_of A top (hl_EMPTY A) = hl_EMPTY A.
Admitted.

// HOL Light: Multivariate/metric.ml:1824 / FRONTIER_OF_TOPSPACE   (hash md5:3eb4b670d49af43d80243e50dd08a09b)
Theorem hlt_FRONTIER_OF_TOPSPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_frontier_of A top (hl_topspace A top) = hl_EMPTY A.
Admitted.

// HOL Light: Multivariate/metric.ml:1829 / FRONTIER_OF_SUBSET_EQ   (hash md5:f1a2f3e2eb144f178b2ce5f50fc5d214)
Theorem hlt_FRONTIER_OF_SUBSET_EQ : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_SUBSET A s (hl_topspace A top) = 1 -> (hl_SUBSET A (hl_frontier_of A top s) s = 1 <-> hl_closed_in A top s = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:1845 / FRONTIER_OF_COMPLEMENT   (hash md5:cd3647ad4686775d8ea0c8fb9ac0bdf4)
Theorem hlt_FRONTIER_OF_COMPLEMENT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_frontier_of A top (hl_DIFF A (hl_topspace A top) s) = hl_frontier_of A top s.
Admitted.

// HOL Light: Multivariate/metric.ml:1852 / FRONTIER_OF_DISJOINT_EQ   (hash md5:a2d62ac770231fca0c5d293a16604108)
Theorem hlt_FRONTIER_OF_DISJOINT_EQ : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_SUBSET A s (hl_topspace A top) = 1 -> (hl_INTER A (hl_frontier_of A top s) s = hl_EMPTY A <-> hl_open_in A top s = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:1863 / FRONTIER_OF_DISJOINT_EQ_ALT   (hash md5:fbb209179801352a1341cc8b3c0a9cd7)
Theorem hlt_FRONTIER_OF_DISJOINT_EQ_ALT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_SUBSET A s (hl_DIFF A (hl_topspace A top) (hl_frontier_of A top s)) = 1 <-> hl_open_in A top s = 1.
