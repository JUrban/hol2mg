Theorem hlt_CARD_LE_PAIRWISE_SEPARATED_CONNECTED_IN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall u v :e 2 :^: (2 :^: A), hl_FINITE (2 :^: A) u = 1 /\ (hl_pairwise (2 :^: A) (hl_separated_in A top) u = 1 /\ ((forall c :e 2 :^: A, hl_IN (2 :^: A) c u = 1 -> ~ c = hl_EMPTY A) /\ ((forall c :e 2 :^: A, hl_IN (2 :^: A) c v = 1 -> hl_connected_in A top c = 1) /\ hl_UNIONS A u = hl_UNIONS A v))) -> hl_sym_3c3d5f63 (2 :^: A) (2 :^: A) u v = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:13918 / CONNECTED_SPACE_PROD_TOPOLOGY   (hash md5:d6e2abaadc4a0913fb7b381eb2e2e4ba)
Theorem hlt_CONNECTED_SPACE_PROD_TOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, hl_connected_space (A :*: B) (hl_prod_topology A B top1 top2) = 1 <-> hl_topspace (A :*: B) (hl_prod_topology A B top1 top2) = hl_EMPTY (A :*: B) \/ hl_connected_space A top1 = 1 /\ hl_connected_space B top2 = 1.
