// HOL Light: Multivariate/metric.ml:11660 / MDIST_REFL   (hash md5:8c90e6d4f78f6ebb2d9b15ea2bcdc0ac)
Theorem hlt_MDIST_REFL : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall x :e A, hl_IN A x (hl_mspace A m) = 1 -> hl_mdist A m (hl_pair A A x x) = hl_real_of_num (hl_NUMERAL hl_zero).
