// HOL Light: Multivariate/metric.ml:1204 / CLOSURE_OF_EQ   (hash md5:f0edec45de0732dc5f8d9cd72473a7ba)
Theorem hlt_CLOSURE_OF_EQ : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_closure_of A top s = s <-> hl_closed_in A top s = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:1211 / CLOSED_IN_CONTAINS_DERIVED_SET   (hash md5:2395c80d8a49299fd03f00fd9867b24e)
Theorem hlt_CLOSED_IN_CONTAINS_DERIVED_SET : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_closed_in A top s = 1 <-> hl_SUBSET A (hl_derived_set_of A top s) s = 1 /\ hl_SUBSET A s (hl_topspace A top) = 1.
