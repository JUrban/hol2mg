Theorem hlt_HOMOTOPIC_FROM_CONTRACTIBLE_SPACE : forall A B:set, A <> Empty -> B <> Empty -> forall f g :e B :^: A, forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') g = 1 /\ (hl_contractible_space A top = 1 /\ hl_path_connected_space B top' = 1)) -> hl_homotopic_with A B (fun x :e B :^: A => if True then 1 else 0) (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f g = 1.
Admitted.

