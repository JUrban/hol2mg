// HOL Light: Multivariate/metric.ml:1291 / CLOSURE_OF_UNIQUE   (hash md5:bb3d7c1092cad8936c983ac21134d2b6)
Theorem hlt_CLOSURE_OF_UNIQUE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_SUBSET A s t = 1 /\ (hl_closed_in A top t = 1 /\ (forall t' :e 2 :^: A, hl_SUBSET A s t' = 1 /\ hl_closed_in A top t' = 1 -> hl_SUBSET A t t' = 1)) -> hl_closure_of A top s = t.
