// HOL Light: Multivariate/metric.ml:20958 / COMPACT_SPACE_NEST   (hash md5:4fd57a19826ea000a035f58222ac0814)
Theorem hlt_COMPACT_SPACE_NEST : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, hl_compact_space A (hl_mtopology A m) = 1 <-> forall c :e 2 :^: A :^: omega, (forall n :e omega, hl_closed_in A (hl_mtopology A m) (c n) = 1) /\ ((forall n :e omega, ~ c n = hl_EMPTY A) /\ (forall m1 n :e omega, hl_le m1 n = 1 -> hl_SUBSET A (c n) (c m1) = 1)) -> ~ hl_INTERS A (hl_GSPEC (2 :^: A) (fun GEN_PVAR_1890 :e 2 :^: A => if exists n :e omega, hl_SETSPEC (2 :^: A) GEN_PVAR_1890 (hl_IN omega n (hl_UNIV omega)) (c n) = 1 then 1 else 0)) = hl_EMPTY A.
Admitted.

