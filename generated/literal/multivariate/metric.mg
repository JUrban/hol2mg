// HOL Light: Multivariate/metric.ml:1070 / OPEN_IN_INTER_DERIVED_SET_OF_EQ   (hash md5:26f0d35465b3152d331d4e69e7739768)
Theorem hlt_OPEN_IN_INTER_DERIVED_SET_OF_EQ : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_open_in A top s = 1 -> hl_INTER A s (hl_derived_set_of A top t) = hl_INTER A s (hl_derived_set_of A top (hl_INTER A s t)).
