Theorem hlt_HOMEOMORPHIC_SPACE_CONTRACTIBILITY : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_homeomorphic_space A B top top' = 1 -> (hl_contractible_space A top = 1 <-> hl_contractible_space B top' = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:29745 / CONTRACTIBLE_EQ_HOMOTOPY_EQUIVALENT_SINGLETON_SUBTOPOLOGY   (hash md5:968416ff623c33017f0eebe9e256965d)
Theorem hlt_CONTRACTIBLE_EQ_HOMOTOPY_EQUIVALENT_SINGLETON_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_contractible_space A top = 1 <-> hl_topspace A top = hl_EMPTY A \/ exists a :e A, hl_IN A a (hl_topspace A top) = 1 /\ hl_homotopy_equivalent_space A A top (hl_subtopology A top (hl_INSERT A a (hl_EMPTY A))) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:29769 / CONTRACTIBLE_SPACE_RETRACTION_MAP_IMAGE   (hash md5:00b1359801ec72dda5447bc2ed0035db)
Theorem hlt_CONTRACTIBLE_SPACE_RETRACTION_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_retraction_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_contractible_space A top = 1 -> hl_contractible_space B top' = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:29787 / CONTRACTIBLE_SPACE_PROD_TOPOLOGY   (hash md5:5715d9c0ea232a96109d7182a7913b54)
Theorem hlt_CONTRACTIBLE_SPACE_PROD_TOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, hl_contractible_space (A :*: B) (hl_prod_topology A B top1 top2) = 1 <-> hl_topspace A top1 = hl_EMPTY A \/ (hl_topspace B top2 = hl_EMPTY B \/ hl_contractible_space A top1 = 1 /\ hl_contractible_space B top2 = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:29817 / CONTRACTIBLE_SPACE_PRODUCT_TOPOLOGY   (hash md5:7a0e3d135592f6fbf8acceca40a7577f)
Theorem hlt_CONTRACTIBLE_SPACE_PRODUCT_TOPOLOGY : forall A K:set, A <> Empty -> K <> Empty -> forall k :e 2 :^: K, forall tops :e hl_ty_topology A :^: K, hl_contractible_space (A :^: K) (hl_product_topology K A k tops) = 1 <-> hl_topspace (A :^: K) (hl_product_topology K A k tops) = hl_EMPTY (A :^: K) \/ forall i :e K, hl_IN K i k = 1 -> hl_contractible_space A (tops i) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:29843 / CONTRACTIBLE_SPACE_SUBTOPOLOGY_EUCLIDEANREAL   (hash md5:d1d7431c92803cfb3adca725acb170e5)
Theorem hlt_CONTRACTIBLE_SPACE_SUBTOPOLOGY_EUCLIDEANREAL : forall s :e 2 :^: R, hl_contractible_space R (hl_subtopology R hl_euclideanreal s) = 1 <-> hl_is_realinterval s = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:29878 / CONTRACTIBLE_SPACE_EUCLIDEANREAL   (hash md5:e36857b21fb7401997cc01fc77c03d3d)
Theorem hlt_CONTRACTIBLE_SPACE_EUCLIDEANREAL : hl_contractible_space R hl_euclideanreal = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:29888 / completely_metrizable_space   (hash md5:f1c407bcb190e7dab7af6bb2a8e09099)
Theorem hlt_completely_metrizable_space_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_completely_metrizable_space A top = 1 <-> exists m :e hl_ty_metric A, hl_mcomplete A m = 1 /\ top = hl_mtopology A m.
Admitted.

// HOL Light: Multivariate/metric.ml:29892 / COMPLETELY_METRIZABLE_IMP_METRIZABLE_SPACE   (hash md5:c56ab0896f19e93f616e764eea45e9fc)
Theorem hlt_COMPLETELY_METRIZABLE_IMP_METRIZABLE_SPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_completely_metrizable_space A top = 1 -> hl_metrizable_space A top = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:29897 / FORALL_MCOMPLETE_TOPOLOGY   (hash md5:e19bd50edbff1c2009532a0b70c773bd)
Theorem hlt_FORALL_MCOMPLETE_TOPOLOGY : forall A:set, A <> Empty -> forall P :e 2 :^: (2 :^: A) :^: hl_ty_topology A, (forall m :e hl_ty_metric A, hl_mcomplete A m = 1 -> P (hl_mtopology A m) (hl_mspace A m) = 1) <-> forall top :e hl_ty_topology A, hl_completely_metrizable_space A top = 1 -> P top (hl_topspace A top) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:29904 / FORALL_COMPLETELY_METRIZABLE_SPACE   (hash md5:2df204b15068ec5838a701ccac5d0e05)
Theorem hlt_FORALL_COMPLETELY_METRIZABLE_SPACE : forall A:set, A <> Empty -> forall P :e 2 :^: (2 :^: A) :^: hl_ty_topology A, (forall top :e hl_ty_topology A, hl_completely_metrizable_space A top = 1 -> P top (hl_topspace A top) = 1) <-> forall m :e hl_ty_metric A, hl_mcomplete A m = 1 -> P (hl_mtopology A m) (hl_mspace A m) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:29911 / EXISTS_COMPLETELY_METRIZABLE_SPACE   (hash md5:ca173c0925b143502df32889b136f39f)
Theorem hlt_EXISTS_COMPLETELY_METRIZABLE_SPACE : forall A:set, A <> Empty -> forall P :e 2 :^: (2 :^: A) :^: hl_ty_topology A, (exists top :e hl_ty_topology A, hl_completely_metrizable_space A top = 1 /\ P top (hl_topspace A top) = 1) <-> exists m :e hl_ty_metric A, hl_mcomplete A m = 1 /\ P (hl_mtopology A m) (hl_mspace A m) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:29917 / COMPLETELY_METRIZABLE_SPACE_MTOPOLOGY   (hash md5:7ad3478254c7a6e62ae66c4c248911c9)
Theorem hlt_COMPLETELY_METRIZABLE_SPACE_MTOPOLOGY : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, hl_mcomplete A m = 1 -> hl_completely_metrizable_space A (hl_mtopology A m) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:29921 / COMPLETELY_METRIZABLE_SPACE_DISCRETE_TOPOLOGY   (hash md5:374f2962276091ea462293ef7f6f6ab8)
Theorem hlt_COMPLETELY_METRIZABLE_SPACE_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u :e 2 :^: A, hl_completely_metrizable_space A (hl_discrete_topology A u) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:29926 / COMPLETELY_METRIZABLE_SPACE_EUCLIDEANREAL   (hash md5:fb487e3fbd003ee977d0b568cccad5dc)
Theorem hlt_COMPLETELY_METRIZABLE_SPACE_EUCLIDEANREAL : hl_completely_metrizable_space R hl_euclideanreal = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:29932 / COMPLETELY_METRIZABLE_SPACE_CLOSED_IN   (hash md5:babcc495b1ba21d8cac8bc310d5ad0bd)
Theorem hlt_COMPLETELY_METRIZABLE_SPACE_CLOSED_IN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_completely_metrizable_space A top = 1 /\ hl_closed_in A top s = 1 -> hl_completely_metrizable_space A (hl_subtopology A top s) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:29942 / HOMEOMORPHIC_COMPLETELY_METRIZABLE_SPACE   (hash md5:f25565d72f50f30902a0e384f56e5190)
Theorem hlt_HOMEOMORPHIC_COMPLETELY_METRIZABLE_SPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_homeomorphic_space A B top top' = 1 -> (hl_completely_metrizable_space A top = 1 <-> hl_completely_metrizable_space B top' = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:30008 / COMPLETELY_METRIZABLE_SPACE_RETRACTION_MAP_IMAGE   (hash md5:d00467cabbbde905ef6238439c7c93ab)
Theorem hlt_COMPLETELY_METRIZABLE_SPACE_RETRACTION_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall r :e B :^: A, hl_retraction_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') r = 1 /\ hl_completely_metrizable_space A top = 1 -> hl_completely_metrizable_space B top' = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:30023 / prod_metric   (hash md5:d95fa769e2b073f4d20df653ffa88d62)
Theorem hlt_prod_metric_thm : forall A B:set, A <> Empty -> B <> Empty -> forall m1 :e hl_ty_metric A, forall m2 :e hl_ty_metric B, hl_prod_metric A B m1 m2 = hl_metric (A :*: B) (hl_pair (2 :^: (A :*: B)) (R :^: (A :*: B :*: (A :*: B))) (hl_CROSS A B (hl_mspace A m1) (hl_mspace B m2)) (hl_GABS (R :^: (A :*: B :*: (A :*: B))) (fun f :e R :^: (A :*: B :*: (A :*: B)) => if forall x :e A, forall y :e B, forall x' :e A, forall y' :e B, hl_GEQ R (f (hl_pair (A :*: B) (A :*: B) (hl_pair A B x y) (hl_pair A B x' y'))) (hl_sqrt (hl_real_add (hl_real_pow (hl_mdist A m1 (hl_pair A A x x')) (hl_NUMERAL (hl_BIT0 (hl_BIT1 hl_zero)))) (hl_real_pow (hl_mdist B m2 (hl_pair B B y y')) (hl_NUMERAL (hl_BIT0 (hl_BIT1 hl_zero)))))) = 1 then 1 else 0))).
Admitted.

// HOL Light: Multivariate/metric.ml:30029 / PROD_METRIC   (hash md5:2dacb78c8af61d5ca814950d43928547)
Theorem hlt_PROD_METRIC : forall A B:set, A <> Empty -> B <> Empty -> (forall m1 :e hl_ty_metric A, forall m2 :e hl_ty_metric B, hl_mspace (A :*: B) (hl_prod_metric A B m1 m2) = hl_CROSS A B (hl_mspace A m1) (hl_mspace B m2)) /\ forall m1 :e hl_ty_metric A, forall m2 :e hl_ty_metric B, hl_mdist (A :*: B) (hl_prod_metric A B m1 m2) = hl_GABS (R :^: (A :*: B :*: (A :*: B))) (fun f :e R :^: (A :*: B :*: (A :*: B)) => if forall x :e A, forall y :e B, forall x' :e A, forall y' :e B, hl_GEQ R (f (hl_pair (A :*: B) (A :*: B) (hl_pair A B x y) (hl_pair A B x' y'))) (hl_sqrt (hl_real_add (hl_real_pow (hl_mdist A m1 (hl_pair A A x x')) (hl_NUMERAL (hl_BIT0 (hl_BIT1 hl_zero)))) (hl_real_pow (hl_mdist B m2 (hl_pair B B y y')) (hl_NUMERAL (hl_BIT0 (hl_BIT1 hl_zero)))))) = 1 then 1 else 0).
Admitted.

// HOL Light: Multivariate/metric.ml:30071 / COMPONENT_LE_PROD_METRIC   (hash md5:a62681b717f192851e7d0fef5aed20e5)
Theorem hlt_COMPONENT_LE_PROD_METRIC : forall A B:set, A <> Empty -> B <> Empty -> forall m1 :e hl_ty_metric A, forall m2 :e hl_ty_metric B, forall x1 :e A, forall y1 :e B, forall x2 :e A, forall y2 :e B, hl_real_le (hl_mdist A m1 (hl_pair A A x1 x2)) (hl_mdist (A :*: B) (hl_prod_metric A B m1 m2) (hl_pair (A :*: B) (A :*: B) (hl_pair A B x1 y1) (hl_pair A B x2 y2))) = 1 /\ hl_real_le (hl_mdist B m2 (hl_pair B B y1 y2)) (hl_mdist (A :*: B) (hl_prod_metric A B m1 m2) (hl_pair (A :*: B) (A :*: B) (hl_pair A B x1 y1) (hl_pair A B x2 y2))) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:30079 / PROD_METRIC_LE_COMPONENTS   (hash md5:8ae64c6a770750a6df71ca69e29f410a)
Theorem hlt_PROD_METRIC_LE_COMPONENTS : forall A B:set, A <> Empty -> B <> Empty -> forall m1 :e hl_ty_metric A, forall m2 :e hl_ty_metric B, forall x1 :e A, forall y1 :e B, forall x2 :e A, forall y2 :e B, hl_IN A x1 (hl_mspace A m1) = 1 /\ (hl_IN A x2 (hl_mspace A m1) = 1 /\ (hl_IN B y1 (hl_mspace B m2) = 1 /\ hl_IN B y2 (hl_mspace B m2) = 1)) -> hl_real_le (hl_mdist (A :*: B) (hl_prod_metric A B m1 m2) (hl_pair (A :*: B) (A :*: B) (hl_pair A B x1 y1) (hl_pair A B x2 y2))) (hl_real_add (hl_mdist A m1 (hl_pair A A x1 x2)) (hl_mdist B m2 (hl_pair B B y1 y2))) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:30090 / MBALL_PROD_METRIC_SUBSET   (hash md5:463d301df207a5cb634e178e3375e732)
Theorem hlt_MBALL_PROD_METRIC_SUBSET : forall A B:set, A <> Empty -> B <> Empty -> forall m1 :e hl_ty_metric A, forall m2 :e hl_ty_metric B, forall x :e A, forall y :e B, forall r :e R, hl_SUBSET (A :*: B) (hl_mball (A :*: B) (hl_prod_metric A B m1 m2) (hl_pair (A :*: B) R (hl_pair A B x y) r)) (hl_CROSS A B (hl_mball A m1 (hl_pair A R x r)) (hl_mball B m2 (hl_pair B R y r))) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:30098 / MCBALL_PROD_METRIC_SUBSET   (hash md5:89847d33dd76a9fc40943a4536a3c4b5)
Theorem hlt_MCBALL_PROD_METRIC_SUBSET : forall A B:set, A <> Empty -> B <> Empty -> forall m1 :e hl_ty_metric A, forall m2 :e hl_ty_metric B, forall x :e A, forall y :e B, forall r :e R, hl_SUBSET (A :*: B) (hl_mcball (A :*: B) (hl_prod_metric A B m1 m2) (hl_pair (A :*: B) R (hl_pair A B x y) r)) (hl_CROSS A B (hl_mcball A m1 (hl_pair A R x r)) (hl_mcball B m2 (hl_pair B R y r))) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:30106 / MBALL_SUBSET_PROD_METRIC   (hash md5:e34c0ac3e6628d7132e0f6d8aebb5b2b)
Theorem hlt_MBALL_SUBSET_PROD_METRIC : forall A B:set, A <> Empty -> B <> Empty -> forall m1 :e hl_ty_metric A, forall m2 :e hl_ty_metric B, forall x :e A, forall y :e B, forall r r' :e R, hl_SUBSET (A :*: B) (hl_CROSS A B (hl_mball A m1 (hl_pair A R x r)) (hl_mball B m2 (hl_pair B R y r'))) (hl_mball (A :*: B) (hl_prod_metric A B m1 m2) (hl_pair (A :*: B) R (hl_pair A B x y) (hl_real_add r r'))) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:30115 / MCBALL_SUBSET_PROD_METRIC   (hash md5:2dee2c8ba8142fab2642a8b62d61bfa6)
Theorem hlt_MCBALL_SUBSET_PROD_METRIC : forall A B:set, A <> Empty -> B <> Empty -> forall m1 :e hl_ty_metric A, forall m2 :e hl_ty_metric B, forall x :e A, forall y :e B, forall r r' :e R, hl_SUBSET (A :*: B) (hl_CROSS A B (hl_mcball A m1 (hl_pair A R x r)) (hl_mcball B m2 (hl_pair B R y r'))) (hl_mcball (A :*: B) (hl_prod_metric A B m1 m2) (hl_pair (A :*: B) R (hl_pair A B x y) (hl_real_add r r'))) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:30124 / MTOPOLOGY_PROD_METRIC   (hash md5:4e2ef36bc3a62538607901694814ee0b)
Theorem hlt_MTOPOLOGY_PROD_METRIC : forall A B:set, A <> Empty -> B <> Empty -> forall m1 :e hl_ty_metric A, forall m2 :e hl_ty_metric B, hl_mtopology (A :*: B) (hl_prod_metric A B m1 m2) = hl_prod_topology A B (hl_mtopology A m1) (hl_mtopology B m2).
Admitted.

// HOL Light: Multivariate/metric.ml:30162 / SUBMETRIC_PROD_METRIC   (hash md5:21c96de8010c5b6094bf019c1f45f186)
Theorem hlt_SUBMETRIC_PROD_METRIC : forall A B:set, A <> Empty -> B <> Empty -> forall m1 :e hl_ty_metric A, forall m2 :e hl_ty_metric B, forall s :e 2 :^: A, forall t :e 2 :^: B, hl_submetric (A :*: B) (hl_prod_metric A B m1 m2) (hl_CROSS A B s t) = hl_prod_metric A B (hl_submetric A m1 s) (hl_submetric B m2 t).
Admitted.

// HOL Light: Multivariate/metric.ml:30171 / METRIZABLE_SPACE_PROD_TOPOLOGY   (hash md5:9a3d4dba13296419f7a62d31401a3a55)
Theorem hlt_METRIZABLE_SPACE_PROD_TOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, hl_metrizable_space (A :*: B) (hl_prod_topology A B top1 top2) = 1 <-> hl_topspace (A :*: B) (hl_prod_topology A B top1 top2) = hl_EMPTY (A :*: B) \/ hl_metrizable_space A top1 = 1 /\ hl_metrizable_space B top2 = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:30196 / CAUCHY_IN_PROD_METRIC   (hash md5:df1f1d26687951f618ab42005b991684)
Theorem hlt_CAUCHY_IN_PROD_METRIC : forall A B:set, A <> Empty -> B <> Empty -> forall m1 :e hl_ty_metric A, forall m2 :e hl_ty_metric B, forall x :e (A :*: B) :^: omega, hl_cauchy_in (A :*: B) (hl_prod_metric A B m1 m2) x = 1 <-> hl_cauchy_in A m1 (hl_o (A :*: B) A omega (hl_FST A B) x) = 1 /\ hl_cauchy_in B m2 (hl_o (A :*: B) B omega (hl_SND A B) x) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:30220 / MCOMPLETE_PROD_METRIC   (hash md5:4df3a957b1a13c82228e8a5182572ade)
Theorem hlt_MCOMPLETE_PROD_METRIC : forall A B:set, A <> Empty -> B <> Empty -> forall m1 :e hl_ty_metric A, forall m2 :e hl_ty_metric B, hl_mcomplete (A :*: B) (hl_prod_metric A B m1 m2) = 1 <-> hl_mspace A m1 = hl_EMPTY A \/ (hl_mspace B m2 = hl_EMPTY B \/ hl_mcomplete A m1 = 1 /\ hl_mcomplete B m2 = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:30242 / COMPLETELY_METRIZABLE_SPACE_PROD_TOPOLOGY   (hash md5:d1d94073918e6a2a29ddacc105135af0)
Theorem hlt_COMPLETELY_METRIZABLE_SPACE_PROD_TOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, hl_completely_metrizable_space (A :*: B) (hl_prod_topology A B top1 top2) = 1 <-> hl_topspace (A :*: B) (hl_prod_topology A B top1 top2) = hl_EMPTY (A :*: B) \/ hl_completely_metrizable_space A top1 = 1 /\ hl_completely_metrizable_space B top2 = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:30278 / MBOUNDED_CROSS   (hash md5:3901503cd832c6024ad223639284ebcf)
Theorem hlt_MBOUNDED_CROSS : forall A B:set, A <> Empty -> B <> Empty -> forall m1 :e hl_ty_metric A, forall m2 :e hl_ty_metric B, forall s :e 2 :^: A, forall t :e 2 :^: B, hl_mbounded (A :*: B) (hl_prod_metric A B m1 m2) (hl_CROSS A B s t) = 1 <-> s = hl_EMPTY A \/ (t = hl_EMPTY B \/ hl_mbounded A m1 s = 1 /\ hl_mbounded B m2 t = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:30303 / MBOUNDED_PROD_METRIC   (hash md5:a4a935df730dcbfb0966d78bc65975e7)
Theorem hlt_MBOUNDED_PROD_METRIC : forall A B:set, A <> Empty -> B <> Empty -> forall m1 :e hl_ty_metric A, forall m2 :e hl_ty_metric B, forall u :e 2 :^: (A :*: B), hl_mbounded (A :*: B) (hl_prod_metric A B m1 m2) u = 1 <-> hl_mbounded A m1 (hl_IMAGE (A :*: B) A (hl_FST A B) u) = 1 /\ hl_mbounded B m2 (hl_IMAGE (A :*: B) B (hl_SND A B) u) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:30322 / TOTALLY_BOUNDED_IN_CROSS   (hash md5:a2821274b7c80ae2c6d24f2f1a06753f)
Theorem hlt_TOTALLY_BOUNDED_IN_CROSS : forall A B:set, A <> Empty -> B <> Empty -> forall m1 :e hl_ty_metric A, forall m2 :e hl_ty_metric B, forall s :e 2 :^: A, forall t :e 2 :^: B, hl_totally_bounded_in (A :*: B) (hl_prod_metric A B m1 m2) (hl_CROSS A B s t) = 1 <-> s = hl_EMPTY A \/ (t = hl_EMPTY B \/ hl_totally_bounded_in A m1 s = 1 /\ hl_totally_bounded_in B m2 t = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:30361 / TOTALLY_BOUNDED_IN_PROD_METRIC   (hash md5:6ba04c0d844fb70815e39fc4b0bfcb26)
Theorem hlt_TOTALLY_BOUNDED_IN_PROD_METRIC : forall A B:set, A <> Empty -> B <> Empty -> forall m1 :e hl_ty_metric A, forall m2 :e hl_ty_metric B, forall u :e 2 :^: (A :*: B), hl_totally_bounded_in (A :*: B) (hl_prod_metric A B m1 m2) u = 1 <-> hl_totally_bounded_in A m1 (hl_IMAGE (A :*: B) A (hl_FST A B) u) = 1 /\ hl_totally_bounded_in B m2 (hl_IMAGE (A :*: B) B (hl_SND A B) u) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:30386 / lipschitz_continuous_map   (hash md5:3797ef647403216ea7a394b226486801)
Theorem hlt_lipschitz_continuous_map_thm : forall A B:set, A <> Empty -> B <> Empty -> forall m2 :e hl_ty_metric A, forall f :e A :^: B, forall m1 :e hl_ty_metric B, hl_lipschitz_continuous_map B A (hl_pair (hl_ty_metric B) (hl_ty_metric A) m1 m2) f = 1 <-> hl_SUBSET A (hl_IMAGE B A f (hl_mspace B m1)) (hl_mspace A m2) = 1 /\ exists B1 :e R, forall x y :e B, hl_IN B x (hl_mspace B m1) = 1 /\ hl_IN B y (hl_mspace B m1) = 1 -> hl_real_le (hl_mdist A m2 (hl_pair A A (f x) (f y))) (hl_real_mul B1 (hl_mdist B m1 (hl_pair B B x y))) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:30392 / LIPSCHITZ_CONTINUOUS_MAP_POS   (hash md5:f28a85eaa99ac6b34ccc85c0fcb2b801)
Theorem hlt_LIPSCHITZ_CONTINUOUS_MAP_POS : forall A B:set, A <> Empty -> B <> Empty -> forall m1 :e hl_ty_metric A, forall m2 :e hl_ty_metric B, forall f :e B :^: A, hl_lipschitz_continuous_map A B (hl_pair (hl_ty_metric A) (hl_ty_metric B) m1 m2) f = 1 <-> hl_SUBSET B (hl_IMAGE A B f (hl_mspace A m1)) (hl_mspace B m2) = 1 /\ exists B1 :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) B1 = 1 /\ forall x y :e A, hl_IN A x (hl_mspace A m1) = 1 /\ hl_IN A y (hl_mspace A m1) = 1 -> hl_real_le (hl_mdist B m2 (hl_pair B B (f x) (f y))) (hl_real_mul B1 (hl_mdist A m1 (hl_pair A A x y))) = 1.
Admitted.

