// HOL Light: Multivariate/metric.ml:21929 / REALLIM_SEQUENTIALLY   (hash md5:7f66f68198f2f06ed4016a5c552ee771)
Theorem hlt_REALLIM_SEQUENTIALLY : forall f :e R :^: omega, forall l :e R, hl_tendsto_real omega f l hl_sequentially = 1 <-> forall e1 :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) e1 = 1 -> exists N :e omega, forall n :e omega, hl_le N n = 1 -> hl_real_lt (hl_real_abs (hl_real_sub (f n) l)) e1 = 1.
