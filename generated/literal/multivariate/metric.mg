Theorem hlt_CONNECTED_SPACE_IMP_SEPARATED_BETWEEN_TRIVIAL : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_connected_space A top = 1 -> (hl_separated_between A top s t = 1 <-> s = hl_EMPTY A /\ hl_SUBSET A t (hl_topspace A top) = 1 \/ hl_SUBSET A s (hl_topspace A top) = 1 /\ t = hl_EMPTY A).
