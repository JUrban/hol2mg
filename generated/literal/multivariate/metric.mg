// HOL Light: Multivariate/metric.ml:22786 / PATH_COMPONENTS_OF_SUBSET_SING   (hash md5:ef800341c0d09eed63336decdbc7fcf9)
Theorem hlt_PATH_COMPONENTS_OF_SUBSET_SING : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_SUBSET (2 :^: A) (hl_path_components_of A top) (hl_INSERT (2 :^: A) s (hl_EMPTY (2 :^: A))) = 1 <-> hl_path_connected_space A top = 1 /\ (hl_topspace A top = hl_EMPTY A \/ hl_topspace A top = s).
