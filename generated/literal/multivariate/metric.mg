Theorem hlt_interior_of_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_interior_of A top s = hl_GSPEC A (fun GEN_PVAR_1259 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_1259 (if exists t :e 2 :^: A, hl_open_in A top t = 1 /\ (hl_IN A x t = 1 /\ hl_SUBSET A t s = 1) then 1 else 0) x = 1 then 1 else 0).
