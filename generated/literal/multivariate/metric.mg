Theorem hlt_FORALL_METRIC_TOPOLOGY : forall A:set, A <> Empty -> forall P :e 2 :^: (2 :^: A) :^: hl_ty_topology A, (forall m :e hl_ty_metric A, P (hl_mtopology A m) (hl_mspace A m) = 1) <-> forall top :e hl_ty_topology A, hl_metrizable_space A top = 1 -> P top (hl_topspace A top) = 1.
