Theorem hlt_CLOSURE_OF_MINIMAL_EQ : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_SUBSET A s (hl_topspace A top) = 1 /\ hl_closed_in A top t = 1 -> (hl_SUBSET A (hl_closure_of A top s) t = 1 <-> hl_SUBSET A s t = 1).
