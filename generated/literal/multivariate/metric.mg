Theorem hlt_OPEN_IN_EMPTY : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_open_in A top (hl_EMPTY A) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:110 / OPEN_IN_INTER   (hash md5:9101cbe896710ea7f1814305c6f63eaa)
Theorem hlt_OPEN_IN_INTER : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_open_in A top s = 1 /\ hl_open_in A top t = 1 -> hl_open_in A top (hl_INTER A s t) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:114 / OPEN_IN_UNIONS   (hash md5:b1546676581b38595a13a34f5b37428a)
Theorem hlt_OPEN_IN_UNIONS : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall k :e 2 :^: (2 :^: A), (forall s :e 2 :^: A, hl_IN (2 :^: A) s k = 1 -> hl_open_in A top s = 1) -> hl_open_in A top (hl_UNIONS A k) = 1.
Admitted.

