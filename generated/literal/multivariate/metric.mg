Theorem hlt_LINDELOF_SPACE_UNIONS : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall U :e 2 :^: (2 :^: A), hl_COUNTABLE (2 :^: A) U = 1 /\ (forall c :e 2 :^: A, hl_IN (2 :^: A) c U = 1 -> hl_lindelof_space A (hl_subtopology A top c) = 1) -> hl_lindelof_space A (hl_subtopology A top (hl_UNIONS A U)) = 1.
Admitted.

