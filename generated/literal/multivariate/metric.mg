Theorem hlt_QUASI_SUBSET_CONNECTED_COMPONENTS_OF_POINTWISE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_SUBSET (2 :^: A) (hl_quasi_components_of A top) (hl_connected_components_of A top) = 1 <-> forall x :e A, hl_IN A x (hl_topspace A top) = 1 -> hl_quasi_component_of A top x = hl_connected_component_of A top x.
