// HOL Light: Multivariate/metric.ml:31792 / ISOMETRY_IMP_EMBEDDING_MAP   (hash md5:aa0ee13987bc6fca2ed72097f588d916)
Theorem hlt_ISOMETRY_IMP_EMBEDDING_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall m :e hl_ty_metric A, forall m' :e hl_ty_metric B, forall f :e B :^: A, hl_SUBSET B (hl_IMAGE A B f (hl_mspace A m)) (hl_mspace B m') = 1 /\ (forall x y :e A, hl_IN A x (hl_mspace A m) = 1 /\ hl_IN A y (hl_mspace A m) = 1 -> hl_mdist B m' (hl_pair B B (f x) (f y)) = hl_mdist A m (hl_pair A A x y)) -> hl_embedding_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_mtopology A m) (hl_mtopology B m')) f = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:31819 / ISOMETRY_IMP_HOMEOMORPHIC_MAP   (hash md5:39ca3808932f2eb05d199b214a4bb069)
Theorem hlt_ISOMETRY_IMP_HOMEOMORPHIC_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall m :e hl_ty_metric A, forall m' :e hl_ty_metric B, forall f :e B :^: A, hl_IMAGE A B f (hl_mspace A m) = hl_mspace B m' /\ (forall x y :e A, hl_IN A x (hl_mspace A m) = 1 /\ hl_IN A y (hl_mspace A m) = 1 -> hl_mdist B m' (hl_pair B B (f x) (f y)) = hl_mdist A m (hl_pair A A x y)) -> hl_homeomorphic_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_mtopology A m) (hl_mtopology B m')) f = 1.
