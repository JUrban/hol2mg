Theorem hlt_hausdorff_space_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_hausdorff_space A top = 1 <-> forall x y :e A, hl_IN A x (hl_topspace A top) = 1 /\ (hl_IN A y (hl_topspace A top) = 1 /\ ~ x = y) -> exists u v :e 2 :^: A, hl_open_in A top u = 1 /\ (hl_open_in A top v = 1 /\ (hl_IN A x u = 1 /\ (hl_IN A y v = 1 /\ hl_DISJOINT A u v = 1))).
