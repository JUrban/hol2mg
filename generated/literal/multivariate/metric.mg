// HOL Light: Multivariate/metric.ml:18434 / CARD_FRONTIER_OF_REALINTERVAL   (hash md5:02e2a9e84fee629f40b8af4943a21a73)
Theorem hlt_CARD_FRONTIER_OF_REALINTERVAL : forall s :e 2 :^: R, hl_is_realinterval s = 1 -> hl_FINITE R (hl_frontier_of R hl_euclideanreal s) = 1 /\ hl_le (hl_CARD R (hl_frontier_of R hl_euclideanreal s)) (hl_NUMERAL (hl_BIT0 (hl_BIT1 hl_zero))) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:18454 / LOCALLY_COMPACT_SPACE_EUCLIDEANREAL   (hash md5:c1e94e4b1870a2241de2feaa12d697f0)
Theorem hlt_LOCALLY_COMPACT_SPACE_EUCLIDEANREAL : hl_locally_compact_space R hl_euclideanreal = 1.
