// HOL Light: Multivariate/metric.ml:18315 / IS_REALINTERVAL_INTERIOR_SEGMENT   (hash md5:d98f0500742b27877afee3947f0df5ff)
Theorem hlt_IS_REALINTERVAL_INTERIOR_SEGMENT : forall s :e 2 :^: R, forall a b :e R, hl_is_realinterval s = 1 /\ (hl_IN R a (hl_closure_of R hl_euclideanreal s) = 1 /\ hl_IN R b (hl_closure_of R hl_euclideanreal s) = 1) -> hl_SUBSET R (hl_open_real_interval (hl_pair R R a b)) (hl_interior_of R hl_euclideanreal s) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:18342 / REAL_OPEN_SUBSET_CLOSURE_OF_REALINTERVAL   (hash md5:2f12848f2e79577c7a9237411f726c7b)
Theorem hlt_REAL_OPEN_SUBSET_CLOSURE_OF_REALINTERVAL : forall u s :e 2 :^: R, hl_real_open u = 1 /\ hl_is_realinterval s = 1 -> (hl_SUBSET R u (hl_closure_of R hl_euclideanreal s) = 1 <-> hl_SUBSET R u (hl_interior_of R hl_euclideanreal s) = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:18363 / REAL_OPEN_SUBSET_CLOSURE_OF_REALINTERVAL_ALT   (hash md5:b152a1553bbf1a688a002f10176c08e2)
