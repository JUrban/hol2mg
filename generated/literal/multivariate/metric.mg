Theorem hlt_BOREL_IN_HOMEOMORPHIC_MAPS_IMAGE_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, forall g :e A :^: B, forall s :e 2 :^: A, hl_homeomorphic_maps A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') (hl_pair (B :^: A) (A :^: B) f g) = 1 /\ hl_SUBSET A s (hl_topspace A top) = 1 -> (hl_borel_in B top' (hl_IMAGE A B f s) = 1 <-> hl_borel_in A top s = 1).
