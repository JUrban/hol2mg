Theorem hlt_BIJECTIVE_OPEN_IMP_CLOSED_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_open_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (hl_IMAGE A B f (hl_topspace A top) = hl_topspace B top' /\ (forall x y :e A, hl_IN A x (hl_topspace A top) = 1 /\ (hl_IN A y (hl_topspace A top) = 1 /\ f x = f y) -> x = y)) -> hl_closed_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1.
