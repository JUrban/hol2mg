// HOL Light: Multivariate/metric.ml:26695 / SEPARATED_BETWEEN_COMPACT_QUASI_COMPONENT   (hash md5:ef27dffeea3e0a74b5d711c8dc395878)
Theorem hlt_SEPARATED_BETWEEN_COMPACT_QUASI_COMPONENT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall k c :e 2 :^: A, hl_compact_in A top k = 1 /\ hl_IN (2 :^: A) c (hl_quasi_components_of A top) = 1 -> (hl_separated_between A top k c = 1 <-> hl_DISJOINT A k c = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:26702 / SEPARATED_BETWEEN_QUASI_COMPONENTS   (hash md5:de9508466eea525eb3d9747472aace5f)
Theorem hlt_SEPARATED_BETWEEN_QUASI_COMPONENTS : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall c c' :e 2 :^: A, hl_IN (2 :^: A) c (hl_quasi_components_of A top) = 1 /\ hl_IN (2 :^: A) c' (hl_quasi_components_of A top) = 1 -> (hl_separated_between A top c c' = 1 <-> hl_DISJOINT A c c' = 1).
