Theorem hlt_PATH_CONNECTED_IN_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_path_connected_in A (hl_subtopology A top s) t = 1 <-> hl_path_connected_in A top t = 1 /\ hl_SUBSET A t s = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:22091 / PATH_CONNECTED_IN   (hash md5:3bb6d69f94d4f7500d7cf5fba601cce1)
Theorem hlt_PATH_CONNECTED_IN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_path_connected_in A top s = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1 /\ forall x y :e A, hl_IN A x s = 1 /\ hl_IN A y s = 1 -> exists g :e A :^: R, hl_path_in A top g = 1 /\ (hl_SUBSET A (hl_IMAGE R A g (hl_closed_real_interval (hl_CONS (R :*: R) (hl_pair R R (hl_real_of_num (hl_NUMERAL hl_zero)) (hl_real_of_num (hl_NUMERAL (hl_BIT1 hl_zero)))) (hl_NIL (R :*: R))))) s = 1 /\ (g (hl_real_of_num (hl_NUMERAL hl_zero)) = x /\ g (hl_real_of_num (hl_NUMERAL (hl_BIT1 hl_zero))) = y)).
