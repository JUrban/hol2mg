// HOL Light: Multivariate/metric.ml:4996 / CLOSED_IN_SUM_TOPOLOGY   (hash md5:4b1c177f89c4dc4f94ab731130ad7e4f)
Theorem hlt_CLOSED_IN_SUM_TOPOLOGY : forall A K:set, A <> Empty -> K <> Empty -> forall k :e 2 :^: K, forall top :e hl_ty_topology A :^: K, forall u :e 2 :^: (K :*: A), hl_closed_in (K :*: A) (hl_sum_topology K A k top) u = 1 <-> hl_SUBSET (K :*: A) u (hl_disjoint_union K A k (hl_o (hl_ty_topology A) (2 :^: A) K (hl_topspace A) top)) = 1 /\ forall i :e K, hl_IN K i k = 1 -> hl_closed_in A (top i) (hl_GSPEC A (fun GEN_PVAR_1463 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_1463 (hl_IN (K :*: A) (hl_pair K A i x) u) x = 1 then 1 else 0)) = 1.
