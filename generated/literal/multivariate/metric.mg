Admitted.

// HOL Light: Multivariate/metric.ml:23564 / NORMAL_SPACE_CLOSURES   (hash md5:298c3a13e1bc249af7610a58be1ec1cc)
Theorem hlt_NORMAL_SPACE_CLOSURES : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_normal_space A top = 1 <-> forall s t :e 2 :^: A, hl_SUBSET A s (hl_topspace A top) = 1 /\ (hl_SUBSET A t (hl_topspace A top) = 1 /\ hl_DISJOINT A (hl_closure_of A top s) (hl_closure_of A top t) = 1) -> exists u v :e 2 :^: A, hl_open_in A top u = 1 /\ (hl_open_in A top v = 1 /\ (hl_SUBSET A s u = 1 /\ (hl_SUBSET A t v = 1 /\ hl_DISJOINT A u v = 1))).
Admitted.

// HOL Light: Multivariate/metric.ml:23582 / NORMAL_SPACE_DISJOINT_CLOSURES   (hash md5:b75ed659c83efcba60282d0be5e39549)
Theorem hlt_NORMAL_SPACE_DISJOINT_CLOSURES : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_normal_space A top = 1 <-> forall s t :e 2 :^: A, hl_closed_in A top s = 1 /\ (hl_closed_in A top t = 1 /\ hl_DISJOINT A s t = 1) -> exists u v :e 2 :^: A, hl_open_in A top u = 1 /\ (hl_open_in A top v = 1 /\ (hl_SUBSET A s u = 1 /\ (hl_SUBSET A t v = 1 /\ hl_DISJOINT A (hl_closure_of A top u) (hl_closure_of A top v) = 1))).
