// HOL Light: Multivariate/metric.ml:1086 / closure_of   (hash md5:4c7e8b283875053a0b2c19674271f055)
Theorem hlt_closure_of_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_closure_of A top s = hl_GSPEC A (fun GEN_PVAR_1249 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_1249 (if hl_IN A x (hl_topspace A top) = 1 /\ forall t :e 2 :^: A, hl_IN A x t = 1 /\ hl_open_in A top t = 1 -> exists y :e A, hl_IN A y s = 1 /\ hl_IN A y t = 1 then 1 else 0) x = 1 then 1 else 0).
