// HOL Light: Multivariate/metric.ml:6420 / COMPACT_SPACE_ALT   (hash md5:254f86225981444aaf9225d763f5414c)
Theorem hlt_COMPACT_SPACE_ALT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_compact_space A top = 1 <-> forall U :e 2 :^: (2 :^: A), (forall u :e 2 :^: A, hl_IN (2 :^: A) u U = 1 -> hl_open_in A top u = 1) /\ hl_SUBSET A (hl_topspace A top) (hl_UNIONS A U) = 1 -> exists V :e 2 :^: (2 :^: A), hl_FINITE (2 :^: A) V = 1 /\ (hl_SUBSET (2 :^: A) V U = 1 /\ hl_SUBSET A (hl_topspace A top) (hl_UNIONS A V) = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:6428 / COMPACT_SPACE   (hash md5:462fd24a2afac6a76cfc37b9569e534f)
Theorem hlt_COMPACT_SPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_compact_space A top = 1 <-> forall U :e 2 :^: (2 :^: A), (forall u :e 2 :^: A, hl_IN (2 :^: A) u U = 1 -> hl_open_in A top u = 1) /\ hl_UNIONS A U = hl_topspace A top -> exists V :e 2 :^: (2 :^: A), hl_FINITE (2 :^: A) V = 1 /\ (hl_SUBSET (2 :^: A) V U = 1 /\ hl_UNIONS A V = hl_topspace A top).
Admitted.

