Theorem hlt_METRIC_INJECTIVE_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall f :e B :^: A, forall m :e hl_ty_metric B, forall s :e 2 :^: A, hl_SUBSET B (hl_IMAGE A B f s) (hl_mspace B m) = 1 /\ (forall x y :e A, hl_IN A x s = 1 /\ (hl_IN A y s = 1 /\ f x = f y) -> x = y) -> hl_mspace A (hl_metric A (hl_pair (2 :^: A) (R :^: (A :*: A)) s (hl_GABS (R :^: (A :*: A)) (fun f1 :e R :^: (A :*: A) => if forall x y :e A, hl_GEQ R (f1 (hl_pair A A x y)) (hl_mdist B m (hl_pair B B (f x) (f y))) = 1 then 1 else 0)))) = s /\ hl_mdist A (hl_metric A (hl_pair (2 :^: A) (R :^: (A :*: A)) s (hl_GABS (R :^: (A :*: A)) (fun f1 :e R :^: (A :*: A) => if forall x y :e A, hl_GEQ R (f1 (hl_pair A A x y)) (hl_mdist B m (hl_pair B B (f x) (f y))) = 1 then 1 else 0)))) = hl_GABS (R :^: (A :*: A)) (fun f1 :e R :^: (A :*: A) => if forall x y :e A, hl_GEQ R (f1 (hl_pair A A x y)) (hl_mdist B m (hl_pair B B (f x) (f y))) = 1 then 1 else 0).
Admitted.

