// HOL Light: Multivariate/metric.ml:18369 / INTERIOR_OF_CLOSURE_OF_REALINTERVAL   (hash md5:f62ca200c8f861d54a1e16abb784f5da)
Theorem hlt_INTERIOR_OF_CLOSURE_OF_REALINTERVAL : forall s :e 2 :^: R, hl_is_realinterval s = 1 -> hl_interior_of R hl_euclideanreal (hl_closure_of R hl_euclideanreal s) = hl_interior_of R hl_euclideanreal s.
Admitted.

// HOL Light: Multivariate/metric.ml:18377 / CLOSURE_OF_REAL_INTERVAL   (hash md5:93e220ab8846a75ec16c9cf02b920693)
Theorem hlt_CLOSURE_OF_REAL_INTERVAL : forall a b :e R, hl_closure_of R hl_euclideanreal (hl_open_real_interval (hl_pair R R a b)) = hl_COND (2 :^: R) (if hl_open_real_interval (hl_pair R R a b) = hl_EMPTY R then 1 else 0) (hl_EMPTY R) (hl_closed_real_interval (hl_CONS (R :*: R) (hl_pair R R a b) (hl_NIL (R :*: R)))).
Admitted.

// HOL Light: Multivariate/metric.ml:18398 / INTERIOR_OF_REAL_INTERVAL   (hash md5:c7d8357aafad3374f1b2bad0cf80d6a0)
Theorem hlt_INTERIOR_OF_REAL_INTERVAL : forall a b :e R, hl_interior_of R hl_euclideanreal (hl_closed_real_interval (hl_CONS (R :*: R) (hl_pair R R a b) (hl_NIL (R :*: R)))) = hl_open_real_interval (hl_pair R R a b).
Admitted.

// HOL Light: Multivariate/metric.ml:18408 / CLOSURE_OF_INTERIOR_OF_REALINTERVAL   (hash md5:4d71814c02b4972727fa5091c246ccb8)
Theorem hlt_CLOSURE_OF_INTERIOR_OF_REALINTERVAL : forall s :e 2 :^: R, hl_is_realinterval s = 1 /\ ~ hl_interior_of R hl_euclideanreal s = hl_EMPTY R -> hl_closure_of R hl_euclideanreal (hl_interior_of R hl_euclideanreal s) = hl_closure_of R hl_euclideanreal s.
