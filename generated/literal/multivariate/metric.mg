Theorem hlt_TIETZE_EXTENSION_REALINTERVAL : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall f :e R :^: A, forall s :e 2 :^: A, forall t :e 2 :^: R, hl_normal_space A top = 1 /\ (hl_closed_in A top s = 1 /\ (hl_is_realinterval t = 1 /\ (~ t = hl_EMPTY R /\ (hl_continuous_map A R (hl_pair (hl_ty_topology A) (hl_ty_topology R) (hl_subtopology A top s) hl_euclideanreal) f = 1 /\ (forall x :e A, hl_IN A x s = 1 -> hl_IN R (f x) t = 1))))) -> exists g :e R :^: A, hl_continuous_map A R (hl_pair (hl_ty_topology A) (hl_ty_topology R) top hl_euclideanreal) g = 1 /\ ((forall x :e A, hl_IN A x (hl_topspace A top) = 1 -> hl_IN R (g x) t = 1) /\ forall x :e A, hl_IN A x s = 1 -> g x = f x).
Admitted.

