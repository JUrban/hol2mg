// HOL Light: Multivariate/metric.ml:9818 / PERFECT_MAP_FROM_COMPOSITION_RIGHT_INJ   (hash md5:92242c37c7387478b5d42ede943e63bc)
Theorem hlt_PERFECT_MAP_FROM_COMPOSITION_RIGHT_INJ : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall top'' :e hl_ty_topology C, forall f :e B :^: A, forall g :e C :^: B, hl_perfect_map A C (hl_pair (hl_ty_topology A) (hl_ty_topology C) top top'') (hl_o B C A g f) = 1 /\ (hl_IMAGE A B f (hl_topspace A top) = hl_topspace B top' /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (hl_continuous_map B C (hl_pair (hl_ty_topology B) (hl_ty_topology C) top' top'') g = 1 /\ (forall x y :e B, hl_IN B x (hl_topspace B top') = 1 /\ (hl_IN B y (hl_topspace B top') = 1 /\ g x = g y) -> x = y)))) -> hl_perfect_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1.
