Theorem hlt_TOPOLOGY_FINER_CLOSED_IN : forall A:set, A <> Empty -> forall top top' :e hl_ty_topology A, hl_topspace A top' = hl_topspace A top -> ((forall s :e 2 :^: A, hl_open_in A top s = 1 -> hl_open_in A top' s = 1) <-> forall s :e 2 :^: A, hl_closed_in A top s = 1 -> hl_closed_in A top' s = 1).
Admitted.

