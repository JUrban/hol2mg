// HOL Light: Multivariate/metric.ml:29114 / HOMOTOPIC_WITH_EQUAL   (hash md5:cece7cf456a4d4c0c95cb4e209759aa0)
Theorem hlt_HOMOTOPIC_WITH_EQUAL : forall A B:set, A <> Empty -> B <> Empty -> forall P :e 2 :^: (B :^: A), forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f g :e B :^: A, P f = 1 /\ (P g = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (forall x :e A, hl_IN A x (hl_topspace A top) = 1 -> f x = g x))) -> hl_homotopic_with A B P (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f g = 1.
