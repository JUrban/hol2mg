Theorem hlt_TOTALLY_BOUNDED_IN_IMP_SUBSET : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall s :e 2 :^: A, hl_totally_bounded_in A m s = 1 -> hl_SUBSET A s (hl_mspace A m) = 1.
