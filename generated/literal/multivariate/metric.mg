// HOL Light: Multivariate/metric.ml:11720 / MBALL_EQ_EMPTY   (hash md5:43b05dd4abbbd08413fe5de0ef8898c5)
Theorem hlt_MBALL_EQ_EMPTY : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall x :e A, forall r :e R, hl_mball A m (hl_pair A R x r) = hl_EMPTY A <-> ~ hl_IN A x (hl_mspace A m) = 1 \/ hl_real_le r (hl_real_of_num (hl_NUMERAL hl_zero)) = 1.
