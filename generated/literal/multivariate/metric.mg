// HOL Light: Multivariate/metric.ml:9982 / lindelof_space   (hash md5:0ed48380f7c7224964e1d4681c9526bd)
Theorem hlt_lindelof_space_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_lindelof_space A top = 1 <-> forall U :e 2 :^: (2 :^: A), (forall u :e 2 :^: A, hl_IN (2 :^: A) u U = 1 -> hl_open_in A top u = 1) /\ hl_UNIONS A U = hl_topspace A top -> exists V :e 2 :^: (2 :^: A), hl_COUNTABLE (2 :^: A) V = 1 /\ (hl_SUBSET (2 :^: A) V U = 1 /\ hl_UNIONS A V = hl_topspace A top).
Admitted.

