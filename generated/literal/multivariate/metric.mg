Theorem hlt_IN_DERIVED_SET_OF : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, forall x :e A, hl_IN A x (hl_derived_set_of A top s) = 1 <-> hl_IN A x (hl_topspace A top) = 1 /\ forall t :e 2 :^: A, hl_IN A x t = 1 /\ hl_open_in A top t = 1 -> exists y :e A, ~ y = x /\ (hl_IN A y s = 1 /\ hl_IN A y t = 1).
