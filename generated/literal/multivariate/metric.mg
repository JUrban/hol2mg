// HOL Light: Multivariate/metric.ml:11701 / CENTRE_IN_MBALL_EQ   (hash md5:424408e1325482e1e51c51893bad5c9f)
Theorem hlt_CENTRE_IN_MBALL_EQ : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall x :e A, forall r :e R, hl_IN A x (hl_mball A m (hl_pair A R x r)) = 1 <-> hl_IN A x (hl_mspace A m) = 1 /\ hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) r = 1.
