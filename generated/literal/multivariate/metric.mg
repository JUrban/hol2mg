// HOL Light: Multivariate/metric.ml:8234 / CLOSED_IN_HAUSDORFF_FINITE_EQ   (hash md5:e158494f89696766713a177b6e7a5cbf)
Theorem hlt_CLOSED_IN_HAUSDORFF_FINITE_EQ : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_hausdorff_space A top = 1 /\ hl_FINITE A s = 1 -> (hl_closed_in A top s = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:8240 / DERIVED_SET_OF_INFINITE_OPEN_IN   (hash md5:877c167607ec665540594d4ce675e5ea)
Theorem hlt_DERIVED_SET_OF_INFINITE_OPEN_IN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_hausdorff_space A top = 1 -> hl_derived_set_of A top s = hl_GSPEC A (fun GEN_PVAR_1514 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_1514 (if hl_IN A x (hl_topspace A top) = 1 /\ forall u :e 2 :^: A, hl_IN A x u = 1 /\ hl_open_in A top u = 1 -> hl_INFINITE A (hl_INTER A s u) = 1 then 1 else 0) x = 1 then 1 else 0).
Admitted.

// HOL Light: Multivariate/metric.ml:8250 / HAUSDORFF_SPACE_DISCRETE_COMPACT_IN   (hash md5:be453f813f891987cbffb0b3b983c327)
Theorem hlt_HAUSDORFF_SPACE_DISCRETE_COMPACT_IN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_hausdorff_space A top = 1 -> (hl_INTER A s (hl_derived_set_of A top s) = hl_EMPTY A /\ hl_compact_in A top s = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1 /\ hl_FINITE A s = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:8265 / HAUSDORFF_SPACE_FINITE_TOPSPACE   (hash md5:f30130d8617073affcca97bbafd1df17)
Theorem hlt_HAUSDORFF_SPACE_FINITE_TOPSPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_hausdorff_space A top = 1 -> (hl_derived_set_of A top (hl_topspace A top) = hl_EMPTY A /\ hl_compact_space A top = 1 <-> hl_FINITE A (hl_topspace A top) = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:8277 / DERIVED_SET_OF_DERIVED_SET_SUBSET   (hash md5:0fd252c1e14b7ac4f86e69c4c3569ce6)
Theorem hlt_DERIVED_SET_OF_DERIVED_SET_SUBSET : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_hausdorff_space A top = 1 -> hl_SUBSET A (hl_derived_set_of A top (hl_derived_set_of A top s)) (hl_derived_set_of A top s) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:8285 / HAUSDORFF_SPACE_INJECTIVE_PREIMAGE   (hash md5:e993d2beb3d0542268deabe4d1817c8a)
Theorem hlt_HAUSDORFF_SPACE_INJECTIVE_PREIMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ ((forall x y :e A, hl_IN A x (hl_topspace A top) = 1 /\ (hl_IN A y (hl_topspace A top) = 1 /\ f x = f y) -> x = y) /\ hl_hausdorff_space B top' = 1) -> hl_hausdorff_space A top = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:8302 / HOMEOMORPHIC_HAUSDORFF_SPACE   (hash md5:01c7f570f6558e9dc76098d7957bb8b8)
Theorem hlt_HOMEOMORPHIC_HAUSDORFF_SPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_homeomorphic_space A B top top' = 1 -> (hl_hausdorff_space A top = 1 <-> hl_hausdorff_space B top' = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:8314 / HAUSDORFF_SPACE_RETRACTION_MAP_IMAGE   (hash md5:28263152e024ff49a58aa8b570c84ec1)
Theorem hlt_HAUSDORFF_SPACE_RETRACTION_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall r :e B :^: A, hl_retraction_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') r = 1 /\ hl_hausdorff_space A top = 1 -> hl_hausdorff_space B top' = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:8321 / COMPACT_HAUSDORFF_SPACE_OPTIMAL   (hash md5:2dbce23e33e97a51ea3c55dc7bdf9c73)
Theorem hlt_COMPACT_HAUSDORFF_SPACE_OPTIMAL : forall A:set, A <> Empty -> forall top top' :e hl_ty_topology A, hl_topspace A top' = hl_topspace A top /\ ((forall u :e 2 :^: A, hl_open_in A top u = 1 -> hl_open_in A top' u = 1) /\ (hl_hausdorff_space A top = 1 /\ hl_compact_space A top' = 1)) -> top' = top.
Admitted.

// HOL Light: Multivariate/metric.ml:8338 / CONTINUOUS_IMP_CLOSED_MAP   (hash md5:a99d42e46b1be35d7fac930aca49c7ed)
Theorem hlt_CONTINUOUS_IMP_CLOSED_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_compact_space A top = 1 /\ (hl_hausdorff_space B top' = 1 /\ hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1) -> hl_closed_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:8347 / CONTINUOUS_IMP_QUOTIENT_MAP   (hash md5:29f8b321418bfa7377b638ffeeebc638)
Theorem hlt_CONTINUOUS_IMP_QUOTIENT_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_compact_space A top = 1 /\ (hl_hausdorff_space B top' = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_IMAGE A B f (hl_topspace A top) = hl_topspace B top')) -> hl_quotient_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:8355 / CONTINUOUS_IMP_HOMEOMORPHIC_MAP   (hash md5:2da423d66ef1358aafd0caf081f86b3c)
Theorem hlt_CONTINUOUS_IMP_HOMEOMORPHIC_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_compact_space A top = 1 /\ (hl_hausdorff_space B top' = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (hl_IMAGE A B f (hl_topspace A top) = hl_topspace B top' /\ (forall x y :e A, hl_IN A x (hl_topspace A top) = 1 /\ hl_IN A y (hl_topspace A top) = 1 -> (f x = f y <-> x = y))))) -> hl_homeomorphic_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:8365 / CONTINUOUS_IMP_EMBEDDING_MAP   (hash md5:17f15a110563b4e485656d15e7f696e9)
Theorem hlt_CONTINUOUS_IMP_EMBEDDING_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_compact_space A top = 1 /\ (hl_hausdorff_space B top' = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (forall x y :e A, hl_IN A x (hl_topspace A top) = 1 /\ hl_IN A y (hl_topspace A top) = 1 -> (f x = f y <-> x = y)))) -> hl_embedding_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:8380 / CONTINUOUS_INVERSE_MAP   (hash md5:46fb8785302bab5155b6a8d0b17961bb)
Theorem hlt_CONTINUOUS_INVERSE_MAP : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, forall g :e A :^: B, forall s :e 2 :^: B, hl_compact_space A top = 1 /\ (hl_hausdorff_space B top' = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ ((forall x :e A, hl_IN A x (hl_topspace A top) = 1 -> g (f x) = x) /\ hl_SUBSET B s (hl_IMAGE A B f (hl_topspace A top)) = 1))) -> hl_continuous_map B A (hl_pair (hl_ty_topology B) (hl_ty_topology A) (hl_subtopology B top' s) top) g = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:8404 / HAUSDORFF_SPACE_PROD_TOPOLOGY   (hash md5:f30e48ac8a57433aa0fdff10e1bcd769)
Theorem hlt_HAUSDORFF_SPACE_PROD_TOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, hl_hausdorff_space (A :*: B) (hl_prod_topology A B top1 top2) = 1 <-> hl_topspace (A :*: B) (hl_prod_topology A B top1 top2) = hl_EMPTY (A :*: B) \/ hl_hausdorff_space A top1 = 1 /\ hl_hausdorff_space B top2 = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:8439 / HAUSDORFF_SPACE_PRODUCT_TOPOLOGY   (hash md5:83769ecbac42f2b2217c4ea95f842afa)
Theorem hlt_HAUSDORFF_SPACE_PRODUCT_TOPOLOGY : forall A K:set, A <> Empty -> K <> Empty -> forall tops :e hl_ty_topology A :^: K, forall k :e 2 :^: K, hl_hausdorff_space (A :^: K) (hl_product_topology K A k tops) = 1 <-> hl_topspace (A :^: K) (hl_product_topology K A k tops) = hl_EMPTY (A :^: K) \/ forall i :e K, hl_IN K i k = 1 -> hl_hausdorff_space A (tops i) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:8482 / HAUSDORFF_SPACE_CLOSED_NEIGHBOURHOOD   (hash md5:701c7809ba6365ce01b1370c2b49022d)
Theorem hlt_HAUSDORFF_SPACE_CLOSED_NEIGHBOURHOOD : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_hausdorff_space A top = 1 <-> forall x :e A, hl_IN A x (hl_topspace A top) = 1 -> exists u c :e 2 :^: A, hl_open_in A top u = 1 /\ (hl_closed_in A top c = 1 /\ (hl_hausdorff_space A (hl_subtopology A top c) = 1 /\ (hl_IN A x u = 1 /\ hl_SUBSET A u c = 1))).
Admitted.

// HOL Light: Multivariate/metric.ml:8516 / INFINITE_PERFECT_SET   (hash md5:bea841f8d77e8e821c4a34f195869eec)
Theorem hlt_INFINITE_PERFECT_SET : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_hausdorff_space A top = 1 /\ (hl_SUBSET A s (hl_derived_set_of A top s) = 1 /\ ~ s = hl_EMPTY A) -> hl_INFINITE A s = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:8526 / HAUSDORFF_SPACE_CLOSED_IN_DIAGONAL   (hash md5:c3c1cb4f562fc6ef04aae7956c682cc6)
Theorem hlt_HAUSDORFF_SPACE_CLOSED_IN_DIAGONAL : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_hausdorff_space A top = 1 <-> hl_closed_in (A :*: A) (hl_prod_topology A A top top) (hl_GSPEC (A :*: A) (fun GEN_PVAR_1519 :e A :*: A => if exists x :e A, hl_SETSPEC (A :*: A) GEN_PVAR_1519 (hl_IN A x (hl_topspace A top)) (hl_pair A A x x) = 1 then 1 else 0)) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:8541 / CLOSED_MAP_DIAG_EQ   (hash md5:65e600e47b72a5192e9b16228ed5247d)
Theorem hlt_CLOSED_MAP_DIAG_EQ : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_closed_map A (A :*: A) (hl_pair (hl_ty_topology A) (hl_ty_topology (A :*: A)) top (hl_prod_topology A A top top)) (fun x :e A => hl_pair A A x x) = 1 <-> hl_hausdorff_space A top = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:8555 / CLOSED_IN_CONTINUOUS_MAPS_EQ   (hash md5:efa4618f30e91802fa650f24f0b321ac)
Theorem hlt_CLOSED_IN_CONTINUOUS_MAPS_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall f g :e B :^: A, forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_hausdorff_space B top' = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') g = 1) -> hl_closed_in A top (hl_GSPEC A (fun GEN_PVAR_1523 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_1523 (if hl_IN A x (hl_topspace A top) = 1 /\ f x = g x then 1 else 0) x = 1 then 1 else 0)) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:8573 / FORALL_IN_CLOSURE_OF_EQ   (hash md5:0b80957d5b12a98e728cdfa6afb28a6d)
Theorem hlt_FORALL_IN_CLOSURE_OF_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall s :e 2 :^: A, forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f g :e B :^: A, hl_hausdorff_space B top' = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') g = 1 /\ (forall x :e A, hl_IN A x s = 1 -> f x = g x))) -> forall x :e A, hl_IN A x (hl_closure_of A top s) = 1 -> f x = g x.
Admitted.

// HOL Light: Multivariate/metric.ml:8592 / RETRACT_OF_SPACE_IMP_CLOSED_IN   (hash md5:93231f36df58256ef2220bda6298443b)
Theorem hlt_RETRACT_OF_SPACE_IMP_CLOSED_IN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_hausdorff_space A top = 1 /\ hl_retract_of_space A s top = 1 -> hl_closed_in A top s = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:8603 / WEAKLY_HEREDITARY_IMP_RETRACTIVE_PROPERTY   (hash md5:9c4dd5540fb94677b4c01eee5808c384)
Theorem hlt_WEAKLY_HEREDITARY_IMP_RETRACTIVE_PROPERTY : forall A B:set, A <> Empty -> B <> Empty -> forall P :e 2 :^: hl_ty_topology A, forall Q :e 2 :^: hl_ty_topology B, (forall top :e hl_ty_topology A, P top = 1 -> hl_hausdorff_space A top = 1) /\ ((forall top :e hl_ty_topology A, forall s :e 2 :^: A, P top = 1 /\ hl_closed_in A top s = 1 -> P (hl_subtopology A top s) = 1) /\ (forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_homeomorphic_space A B top top' = 1 -> (P top = 1 <-> Q top' = 1))) -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall r :e B :^: A, hl_retraction_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') r = 1 /\ P top = 1 -> Q top' = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:8621 / HOMEOMORPHIC_MAPS_GRAPH   (hash md5:c54fa9b40d7cbc6931100c8973f2244f)
Theorem hlt_HOMEOMORPHIC_MAPS_GRAPH : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_homeomorphic_maps A (A :*: B) (hl_pair (hl_ty_topology A) (hl_ty_topology (A :*: B)) top (hl_subtopology (A :*: B) (hl_prod_topology A B top top') (hl_IMAGE A (A :*: B) (fun x :e A => hl_pair A B x (f x)) (hl_topspace A top)))) (hl_pair ((A :*: B) :^: A) (A :^: (A :*: B)) (fun x :e A => hl_pair A B x (f x)) (hl_FST A B)) = 1 <-> hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:8642 / EMBEDDING_MAP_GRAPH   (hash md5:0c7c418bddeea8fdcfe2d727a802853d)
Theorem hlt_EMBEDDING_MAP_GRAPH : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, hl_embedding_map A (A :*: B) (hl_pair (hl_ty_topology A) (hl_ty_topology (A :*: B)) top (hl_prod_topology A B top top')) (fun x :e A => hl_pair A B x (f x)) = 1 <-> hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1.
