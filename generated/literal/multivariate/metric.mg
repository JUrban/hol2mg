// HOL Light: Multivariate/metric.ml:14536 / CONNECTED_COMPONENT_OF_SET   (hash md5:522c1abb1fd91c12fb08ddac2b96e140)
Theorem hlt_CONNECTED_COMPONENT_OF_SET : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall x :e A, hl_connected_component_of A top x = hl_GSPEC A (fun GEN_PVAR_1687 :e A => if exists y :e A, hl_SETSPEC A GEN_PVAR_1687 (if exists t :e 2 :^: A, hl_connected_in A top t = 1 /\ (hl_IN A x t = 1 /\ hl_IN A y t = 1) then 1 else 0) y = 1 then 1 else 0).
