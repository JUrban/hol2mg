// HOL Light: Multivariate/metric.ml:23305 / MONOTONE_MAP_EUCLIDEANREAL_ALT   (hash md5:232130ce8100bb02311f05d7dc1bb247)
Theorem hlt_MONOTONE_MAP_EUCLIDEANREAL_ALT : forall f :e R :^: R, forall s :e 2 :^: R, (forall c :e 2 :^: R, hl_is_realinterval c = 1 -> hl_is_realinterval (hl_GSPEC R (fun GEN_PVAR_1980 :e R => if exists x :e R, hl_SETSPEC R GEN_PVAR_1980 (if hl_IN R x s = 1 /\ hl_IN R (f x) c = 1 then 1 else 0) x = 1 then 1 else 0)) = 1) <-> hl_is_realinterval s = 1 /\ ((forall x y :e R, hl_IN R x s = 1 /\ (hl_IN R y s = 1 /\ hl_real_le x y = 1) -> hl_real_le (f x) (f y) = 1) \/ forall x y :e R, hl_IN R x s = 1 /\ (hl_IN R y s = 1 /\ hl_real_le x y = 1) -> hl_real_le (f y) (f x) = 1).
