// HOL Light: Multivariate/metric.ml:1196 / CLOSURE_OF_SUBSET_EQ   (hash md5:1fd1bf34fa07fe1f8d03bf0b41985b92)
Theorem hlt_CLOSURE_OF_SUBSET_EQ : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_SUBSET A s (hl_topspace A top) = 1 /\ hl_SUBSET A (hl_closure_of A top s) s = 1 <-> hl_closed_in A top s = 1.
