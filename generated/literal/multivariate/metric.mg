// HOL Light: Multivariate/metric.ml:1035 / SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_EQ   (hash md5:d81ee60d46777414c190d7ef4c3ac957)
Theorem hlt_SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_EQ : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall u :e 2 :^: A, hl_subtopology A top u = hl_discrete_topology A u <-> hl_SUBSET A u (hl_topspace A top) = 1 /\ hl_INTER A u (hl_derived_set_of A top u) = hl_EMPTY A.
Admitted.

// HOL Light: Multivariate/metric.ml:1044 / SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY   (hash md5:06acde30894e95fdfb4c2664b5564781)
Theorem hlt_SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_SUBSET A s (hl_topspace A top) = 1 /\ hl_INTER A s (hl_derived_set_of A top s) = hl_EMPTY A -> hl_subtopology A top s = hl_discrete_topology A s.
