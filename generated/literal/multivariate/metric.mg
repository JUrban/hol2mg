// HOL Light: Multivariate/metric.ml:18001 / REAL_BOUNDED_SHRINK   (hash md5:d4c2feddb225988cc448331833fa5001)
Theorem hlt_REAL_BOUNDED_SHRINK : forall s :e 2 :^: R, hl_real_bounded (hl_IMAGE R R (fun x :e R => hl_real_div x (hl_real_add (hl_real_of_num (hl_NUMERAL (hl_BIT1 hl_zero))) (hl_real_abs x))) s) = 1.
