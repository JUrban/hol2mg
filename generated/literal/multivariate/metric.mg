Theorem hlt_QUASI_COMPONENT_OF : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall x y :e A, hl_quasi_component_of A top x y = 1 <-> hl_IN A x (hl_topspace A top) = 1 /\ (hl_IN A y (hl_topspace A top) = 1 /\ forall t :e 2 :^: A, hl_IN A x t = 1 /\ (hl_closed_in A top t = 1 /\ hl_open_in A top t = 1) -> hl_IN A y t = 1).
