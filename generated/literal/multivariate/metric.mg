// HOL Light: Multivariate/metric.ml:29651 / HOMOTOPIC_THROUGH_CONTRACTIBLE_SPACE   (hash md5:bf9dcaa8b90fa04ae26fe49821e37d01)
Theorem hlt_HOMOTOPIC_THROUGH_CONTRACTIBLE_SPACE : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall f :e B :^: A, forall g :e C :^: B, forall f' :e B :^: A, forall g' :e C :^: B, forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, forall top3 :e hl_ty_topology C, hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top1 top2) f = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top1 top2) f' = 1 /\ (hl_continuous_map B C (hl_pair (hl_ty_topology B) (hl_ty_topology C) top2 top3) g = 1 /\ (hl_continuous_map B C (hl_pair (hl_ty_topology B) (hl_ty_topology C) top2 top3) g' = 1 /\ (hl_contractible_space B top2 = 1 /\ hl_path_connected_space C top3 = 1)))) -> hl_homotopic_with A C (fun h :e C :^: A => if True then 1 else 0) (hl_pair (hl_ty_topology A) (hl_ty_topology C) top1 top3) (hl_o B C A g f) (hl_o B C A g' f') = 1.
Admitted.

