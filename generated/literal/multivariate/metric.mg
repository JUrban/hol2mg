Theorem hlt_RETRACTION_MAP_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f g :e B :^: A, (forall x :e A, hl_IN A x (hl_topspace A top) = 1 -> f x = g x) /\ hl_retraction_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 -> hl_retraction_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') g = 1.
