Theorem hlt_CONTRACTIBLE_SPACE_SUBSET_SING : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall a :e A, hl_SUBSET A (hl_topspace A top) (hl_INSERT A a (hl_EMPTY A)) = 1 -> hl_contractible_space A top = 1.
