// HOL Light: Multivariate/metric.ml:22180 / HOMEOMORPHIC_MAP_PATH_CONNECTEDNESS   (hash md5:15a5f8dfdee3c07eb21e5391476461b9)
Theorem hlt_HOMEOMORPHIC_MAP_PATH_CONNECTEDNESS : forall A B:set, A <> Empty -> B <> Empty -> forall f :e B :^: A, forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall u :e 2 :^: A, hl_homeomorphic_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_SUBSET A u (hl_topspace A top) = 1 -> (hl_path_connected_in B top' (hl_IMAGE A B f u) = 1 <-> hl_path_connected_in A top u = 1).
