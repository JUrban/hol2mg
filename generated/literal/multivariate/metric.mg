// HOL Light: Multivariate/metric.ml:1091 / CLOSURE_OF_RESTRICT   (hash md5:c48dcb066c11734cfcff7d0060b289d8)
Theorem hlt_CLOSURE_OF_RESTRICT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_closure_of A top s = hl_closure_of A top (hl_INTER A (hl_topspace A top) s).
