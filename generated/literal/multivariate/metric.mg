Theorem hlt_INJECTIVE_EQ_REAL_OPEN_MAP_EUCLIDEANREAL : forall f :e R :^: R, forall s :e 2 :^: R, hl_is_realinterval s = 1 /\ hl_continuous_map R R (hl_pair (hl_ty_topology R) (hl_ty_topology R) (hl_subtopology R hl_euclideanreal s) hl_euclideanreal) f = 1 -> ((forall x y :e R, hl_IN R x s = 1 /\ (hl_IN R y s = 1 /\ f x = f y) -> x = y) <-> forall u :e 2 :^: R, hl_real_open u = 1 /\ hl_SUBSET R u s = 1 -> hl_real_open (hl_IMAGE R R f u) = 1).
