Theorem hlt_BOREL_MEASURABLE_MAP_CLOSED_IN : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, forall f :e B :^: A, hl_borel_measurable_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top1 top2) f = 1 <-> (forall x :e A, hl_IN A x (hl_topspace A top1) = 1 -> hl_IN B (f x) (hl_topspace B top2) = 1) /\ forall c :e 2 :^: B, hl_closed_in B top2 c = 1 -> hl_borel_in A top1 (hl_GSPEC A (fun GEN_PVAR_1628 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_1628 (if hl_IN A x (hl_topspace A top1) = 1 /\ hl_IN B (f x) c = 1 then 1 else 0) x = 1 then 1 else 0)) = 1.
