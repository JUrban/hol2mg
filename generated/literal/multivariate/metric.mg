Theorem hlt_HOMOTOPY_DOMINATED_CONTRACTIBILITY : forall A B:set, A <> Empty -> B <> Empty -> forall f :e B :^: A, forall g :e A :^: B, forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (hl_continuous_map B A (hl_pair (hl_ty_topology B) (hl_ty_topology A) top' top) g = 1 /\ (hl_homotopic_with B B (fun x :e B :^: B => if True then 1 else 0) (hl_pair (hl_ty_topology B) (hl_ty_topology B) top' top') (hl_o A B B f g) (hl_I B) = 1 /\ hl_contractible_space A top = 1)) -> hl_contractible_space B top' = 1.
