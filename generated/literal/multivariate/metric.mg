Theorem hlt_locally_path_connected_at_thm : forall A:set, A <> Empty -> forall x :e A, forall top :e hl_ty_topology A, hl_locally_path_connected_at A x top = 1 <-> hl_neighbourhood_base_at A x (fun u :e 2 :^: A => if hl_open_in A top u = 1 /\ hl_path_connected_in A top u = 1 then 1 else 0) top = 1.
