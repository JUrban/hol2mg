Theorem hlt_COMPACT_IN_IMP_BOLZANO_WEIERSTRASS : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_compact_in A top s = 1 /\ (hl_INFINITE A t = 1 /\ hl_SUBSET A t s = 1) -> ~ hl_INTER A s (hl_derived_set_of A top t) = hl_EMPTY A.
Admitted.

// HOL Light: Multivariate/metric.ml:6838 / COMPACT_CLOSURE_OF_IMP_BOLZANO_WEIERSTRASS   (hash md5:5883e7ac87921df7de00a2b1dddd0d27)
Theorem hlt_COMPACT_CLOSURE_OF_IMP_BOLZANO_WEIERSTRASS : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_compact_in A top (hl_closure_of A top s) = 1 /\ (hl_INFINITE A t = 1 /\ (hl_SUBSET A t s = 1 /\ hl_SUBSET A t (hl_topspace A top) = 1)) -> ~ hl_derived_set_of A top t = hl_EMPTY A.
Admitted.

// HOL Light: Multivariate/metric.ml:6850 / DISCRETE_COMPACT_IN_EQ_FINITE   (hash md5:7d9f3d49ac397d62138c697344aebb88)
Theorem hlt_DISCRETE_COMPACT_IN_EQ_FINITE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_INTER A s (hl_derived_set_of A top s) = hl_EMPTY A -> (hl_compact_in A top s = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1 /\ hl_FINITE A s = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:6862 / DISCRETE_COMPACT_SPACE_EQ_FINITE   (hash md5:bb79d196c3f1ba0841fce98a4dcb620e)
Theorem hlt_DISCRETE_COMPACT_SPACE_EQ_FINITE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_derived_set_of A top (hl_topspace A top) = hl_EMPTY A -> (hl_compact_space A top = 1 <-> hl_FINITE A (hl_topspace A top) = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:6869 / IMAGE_COMPACT_IN   (hash md5:3a6ade3b2225410109aedd60ebaf569c)
Theorem hlt_IMAGE_COMPACT_IN : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, forall s :e 2 :^: A, hl_compact_in A top s = 1 /\ hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 -> hl_compact_in B top' (hl_IMAGE A B f s) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:6905 / HOMEOMORPHIC_COMPACT_SPACE   (hash md5:db1ff8ad8f555324beee961d68bceaf5)
Theorem hlt_HOMEOMORPHIC_COMPACT_SPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_homeomorphic_space A B top top' = 1 -> (hl_compact_space A top = 1 <-> hl_compact_space B top' = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:6919 / HOMEOMORPHIC_MAP_COMPACTNESS   (hash md5:48ac4f5105489f619118ba2f5a947356)
Theorem hlt_HOMEOMORPHIC_MAP_COMPACTNESS : forall A B:set, A <> Empty -> B <> Empty -> forall f :e B :^: A, forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall u :e 2 :^: A, hl_homeomorphic_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_SUBSET A u (hl_topspace A top) = 1 -> (hl_compact_in B top' (hl_IMAGE A B f u) = 1 <-> hl_compact_in A top u = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:6934 / HOMEOMORPHIC_MAP_COMPACTNESS_EQ   (hash md5:9a4462b8c65d49eac6811bc7bd43ae72)
Theorem hlt_HOMEOMORPHIC_MAP_COMPACTNESS_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall f :e B :^: A, forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall u :e 2 :^: A, hl_homeomorphic_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 -> (hl_compact_in A top u = 1 <-> hl_SUBSET A u (hl_topspace A top) = 1 /\ hl_compact_in B top' (hl_IMAGE A B f u) = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:6941 / COMPACT_SPACE_QUOTIENT_MAP_IMAGE   (hash md5:66419def21de1953d9ee1202c5ab2b0f)
Theorem hlt_COMPACT_SPACE_QUOTIENT_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall q :e B :^: A, hl_quotient_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') q = 1 /\ hl_compact_space A top = 1 -> hl_compact_space B top' = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:6950 / COMPACT_SPACE_RETRACTION_MAP_IMAGE   (hash md5:719bdd8355f0922395b4a7369e96e933)
Theorem hlt_COMPACT_SPACE_RETRACTION_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall r :e B :^: A, hl_retraction_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') r = 1 /\ hl_compact_space A top = 1 -> hl_compact_space B top' = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:6957 / ALEXANDER_SUBBASE_THEOREM   (hash md5:fdc4a098dd6baa7aa2efa9304e899450)
Theorem hlt_ALEXANDER_SUBBASE_THEOREM : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall B :e 2 :^: (2 :^: A), hl_topology A (hl_UNION_OF A (hl_ARBITRARY A) (hl_relative_to A (hl_INTERSECTION_OF A (hl_FINITE (2 :^: A)) B) (hl_UNIONS A B))) = top /\ (forall C :e 2 :^: (2 :^: A), hl_SUBSET (2 :^: A) C B = 1 /\ hl_UNIONS A C = hl_topspace A top -> exists C' :e 2 :^: (2 :^: A), hl_FINITE (2 :^: A) C' = 1 /\ (hl_SUBSET (2 :^: A) C' C = 1 /\ hl_UNIONS A C' = hl_topspace A top)) -> hl_compact_space A top = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:7070 / ALEXANDER_SUBBASE_THEOREM_ALT   (hash md5:70bdb70fe787716b8a281f5d98315697)
Theorem hlt_ALEXANDER_SUBBASE_THEOREM_ALT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall B :e 2 :^: (2 :^: A), forall u :e 2 :^: A, hl_SUBSET A u (hl_UNIONS A B) = 1 /\ (hl_topology A (hl_UNION_OF A (hl_ARBITRARY A) (hl_relative_to A (hl_INTERSECTION_OF A (hl_FINITE (2 :^: A)) B) u)) = top /\ (forall C :e 2 :^: (2 :^: A), hl_SUBSET (2 :^: A) C B = 1 /\ hl_SUBSET A u (hl_UNIONS A C) = 1 -> exists C' :e 2 :^: (2 :^: A), hl_FINITE (2 :^: A) C' = 1 /\ (hl_SUBSET (2 :^: A) C' C = 1 /\ hl_SUBSET A u (hl_UNIONS A C') = 1))) -> hl_compact_space A top = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:7098 / COMPACT_SPACE_PROD_TOPOLOGY   (hash md5:2be4d34780017405d16b79299a514290)
Theorem hlt_COMPACT_SPACE_PROD_TOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, hl_compact_space (A :*: B) (hl_prod_topology A B top1 top2) = 1 <-> hl_topspace (A :*: B) (hl_prod_topology A B top1 top2) = hl_EMPTY (A :*: B) \/ hl_compact_space A top1 = 1 /\ hl_compact_space B top2 = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:7199 / COMPACT_IN_CROSS   (hash md5:284e86dfbeec977113cf4acb29a30e69)
Theorem hlt_COMPACT_IN_CROSS : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, forall s :e 2 :^: A, forall t :e 2 :^: B, hl_compact_in (A :*: B) (hl_prod_topology A B top1 top2) (hl_CROSS A B s t) = 1 <-> s = hl_EMPTY A \/ (t = hl_EMPTY B \/ hl_compact_in A top1 s = 1 /\ hl_compact_in B top2 t = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:7212 / COMPACT_SPACE_PRODUCT_TOPOLOGY   (hash md5:90eea0a9843e45d87e189692d0dbdb20)
Theorem hlt_COMPACT_SPACE_PRODUCT_TOPOLOGY : forall A K:set, A <> Empty -> K <> Empty -> forall tops :e hl_ty_topology A :^: K, forall t :e 2 :^: K, hl_compact_space (A :^: K) (hl_product_topology K A t tops) = 1 <-> hl_topspace (A :^: K) (hl_product_topology K A t tops) = hl_EMPTY (A :^: K) \/ forall k :e K, hl_IN K k t = 1 -> hl_compact_space A (tops k) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:7294 / COMPACT_IN_CARTESIAN_PRODUCT   (hash md5:b445186e1832216ae7db1b1598b3b022)
Theorem hlt_COMPACT_IN_CARTESIAN_PRODUCT : forall A K:set, A <> Empty -> K <> Empty -> forall tops :e hl_ty_topology A :^: K, forall s :e 2 :^: A :^: K, forall k :e 2 :^: K, hl_compact_in (A :^: K) (hl_product_topology K A k tops) (hl_cartesian_product K A k s) = 1 <-> hl_cartesian_product K A k s = hl_EMPTY (A :^: K) \/ forall i :e K, hl_IN K i k = 1 -> hl_compact_in A (tops i) (s i) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:7305 / TUBE_LEMMA_LEFT   (hash md5:5e00da32bb084e6e4ef449699a9694de)
Theorem hlt_TUBE_LEMMA_LEFT : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall k :e 2 :^: A, forall y :e B, forall w :e 2 :^: (A :*: B), hl_open_in (A :*: B) (hl_prod_topology A B top top') w = 1 /\ (hl_compact_in A top k = 1 /\ (hl_IN B y (hl_topspace B top') = 1 /\ hl_SUBSET (A :*: B) (hl_CROSS A B k (hl_INSERT B y (hl_EMPTY B))) w = 1)) -> exists u :e 2 :^: A, exists v :e 2 :^: B, hl_open_in A top u = 1 /\ (hl_open_in B top' v = 1 /\ (hl_SUBSET A k u = 1 /\ (hl_IN B y v = 1 /\ hl_SUBSET (A :*: B) (hl_CROSS A B u v) w = 1))).
Admitted.

// HOL Light: Multivariate/metric.ml:7348 / TUBE_LEMMA_RIGHT   (hash md5:f60044eaf163991fb6a4cd12d4175e77)
Theorem hlt_TUBE_LEMMA_RIGHT : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall x :e A, forall k :e 2 :^: B, forall w :e 2 :^: (A :*: B), hl_open_in (A :*: B) (hl_prod_topology A B top top') w = 1 /\ (hl_compact_in B top' k = 1 /\ (hl_IN A x (hl_topspace A top) = 1 /\ hl_SUBSET (A :*: B) (hl_CROSS A B (hl_INSERT A x (hl_EMPTY A)) k) w = 1)) -> exists u :e 2 :^: A, exists v :e 2 :^: B, hl_open_in A top u = 1 /\ (hl_open_in B top' v = 1 /\ (hl_IN A x u = 1 /\ (hl_SUBSET B k v = 1 /\ hl_SUBSET (A :*: B) (hl_CROSS A B u v) w = 1))).
Admitted.

// HOL Light: Multivariate/metric.ml:7391 / CLOSED_MAP_FST   (hash md5:f70e12083e700d97e1d004353f5c443a)
Theorem hlt_CLOSED_MAP_FST : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_compact_space B top' = 1 -> hl_closed_map (A :*: B) A (hl_pair (hl_ty_topology (A :*: B)) (hl_ty_topology A) (hl_prod_topology A B top top') top) (hl_FST A B) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:7414 / CLOSED_MAP_SND   (hash md5:8c27aefb56a22baac56958047f6afed8)
Theorem hlt_CLOSED_MAP_SND : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_compact_space A top = 1 -> hl_closed_map (A :*: B) B (hl_pair (hl_ty_topology (A :*: B)) (hl_ty_topology B) (hl_prod_topology A B top top') top') (hl_SND A B) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:7428 / WALLACE_THEOREM_PROD_TOPOLOGY   (hash md5:e70a7f178b52fe528c30322c7ff485d6)
Theorem hlt_WALLACE_THEOREM_PROD_TOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall w :e 2 :^: (A :*: B), forall k :e 2 :^: A, forall l :e 2 :^: B, hl_compact_in A top k = 1 /\ (hl_compact_in B top' l = 1 /\ (hl_open_in (A :*: B) (hl_prod_topology A B top top') w = 1 /\ hl_SUBSET (A :*: B) (hl_CROSS A B k l) w = 1)) -> exists u :e 2 :^: A, exists v :e 2 :^: B, hl_open_in A top u = 1 /\ (hl_open_in B top' v = 1 /\ (hl_SUBSET A k u = 1 /\ (hl_SUBSET B l v = 1 /\ hl_SUBSET (A :*: B) (hl_CROSS A B u v) w = 1))).
Admitted.

// HOL Light: Multivariate/metric.ml:7470 / LOCALLY_FINITE_COVER_OF_COMPACT_SPACE   (hash md5:a5868e7dc713741b42643405dd8a8b4a)
Theorem hlt_LOCALLY_FINITE_COVER_OF_COMPACT_SPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall u :e 2 :^: (2 :^: A), hl_compact_space A top = 1 /\ (hl_SUBSET A (hl_topspace A top) (hl_UNIONS A u) = 1 /\ hl_locally_finite_in A top u = 1) -> hl_FINITE (2 :^: A) u = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:7502 / separated_in   (hash md5:37aa3b604008f43335cf416e0ddc9564)
Theorem hlt_separated_in_thm : forall A:set, A <> Empty -> forall t :e 2 :^: A, forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_separated_in A top s t = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1 /\ (hl_SUBSET A t (hl_topspace A top) = 1 /\ (hl_INTER A s (hl_closure_of A top t) = hl_EMPTY A /\ hl_INTER A t (hl_closure_of A top s) = hl_EMPTY A)).
Admitted.

// HOL Light: Multivariate/metric.ml:7507 / SEPARATED_IN_EMPTY   (hash md5:1b599d48d21660793a610970422317b1)
Theorem hlt_SEPARATED_IN_EMPTY : forall A:set, A <> Empty -> (forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_separated_in A top s (hl_EMPTY A) = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1) /\ forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_separated_in A top (hl_EMPTY A) s = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:7512 / SEPARATED_IN_REFL   (hash md5:f2bc1d0ea9d3592eec25a7f3ada03068)
Theorem hlt_SEPARATED_IN_REFL : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_separated_in A top s s = 1 <-> s = hl_EMPTY A.
Admitted.

// HOL Light: Multivariate/metric.ml:7520 / SEPARATED_IN_SYM   (hash md5:fb5108ddc8d2b4fc0fceb331df20175d)
Theorem hlt_SEPARATED_IN_SYM : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_separated_in A top s t = 1 <-> hl_separated_in A top t s = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:7525 / SEPARATED_IN_IMP_DISJOINT   (hash md5:73352db22cd59b31361d5bcd408552fc)
Theorem hlt_SEPARATED_IN_IMP_DISJOINT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_separated_in A top s t = 1 -> hl_DISJOINT A s t = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:7532 / SEPARATED_IN_MONO   (hash md5:ab0ad7c079ea2c564ac0672736554cf7)
Theorem hlt_SEPARATED_IN_MONO : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t s' t' :e 2 :^: A, hl_separated_in A top s t = 1 /\ (hl_SUBSET A s' s = 1 /\ hl_SUBSET A t' t = 1) -> hl_separated_in A top s' t' = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:7545 / SEPARATED_IN_OPEN_SETS   (hash md5:eed20ab5c82bdaf068041bc317bcd5d9)
Theorem hlt_SEPARATED_IN_OPEN_SETS : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_open_in A top s = 1 /\ hl_open_in A top t = 1 -> (hl_separated_in A top s t = 1 <-> hl_DISJOINT A s t = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:7553 / SEPARATED_IN_CLOSED_SETS   (hash md5:f75dead867bae6374d53de38e55ebae6)
Theorem hlt_SEPARATED_IN_CLOSED_SETS : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_closed_in A top s = 1 /\ hl_closed_in A top t = 1 -> (hl_separated_in A top s t = 1 <-> hl_DISJOINT A s t = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:7560 / SEPARATED_IN_COMPLEMENT   (hash md5:a32f623893c70426f74b4c319ffbb1cd)
Theorem hlt_SEPARATED_IN_COMPLEMENT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_separated_in A top s (hl_DIFF A (hl_topspace A top) s) = 1 <-> hl_closed_in A top s = 1 /\ hl_open_in A top s = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:7572 / SEPARATED_IN_SUBTOPOLOGY   (hash md5:ca32c65c271acd316cd694b994657bbf)
Theorem hlt_SEPARATED_IN_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall u s t :e 2 :^: A, hl_separated_in A (hl_subtopology A top u) s t = 1 <-> hl_SUBSET A s u = 1 /\ (hl_SUBSET A t u = 1 /\ hl_separated_in A top s t = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:7583 / SEPARATED_IN_DISCRETE_TOPOLOGY   (hash md5:1b6d6ca3b5a277b9b077bc4cf180207a)
Theorem hlt_SEPARATED_IN_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u s t :e 2 :^: A, hl_separated_in A (hl_discrete_topology A u) s t = 1 <-> hl_SUBSET A s u = 1 /\ (hl_SUBSET A t u = 1 /\ hl_DISJOINT A s t = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:7590 / SEPARATED_EQ_DISTINGUISHABLE   (hash md5:aa91252b74f36ac6706314e58b02a144)
Theorem hlt_SEPARATED_EQ_DISTINGUISHABLE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall x y :e A, hl_separated_in A top (hl_INSERT A x (hl_EMPTY A)) (hl_INSERT A y (hl_EMPTY A)) = 1 <-> hl_IN A x (hl_topspace A top) = 1 /\ (hl_IN A y (hl_topspace A top) = 1 /\ ((exists u :e 2 :^: A, hl_open_in A top u = 1 /\ (hl_IN A x u = 1 /\ ~ hl_IN A y u = 1)) /\ exists v :e 2 :^: A, hl_open_in A top v = 1 /\ (hl_IN A y v = 1 /\ ~ hl_IN A x v = 1))).
Admitted.

// HOL Light: Multivariate/metric.ml:7599 / SEPARATED_IN_UNION   (hash md5:287b449e95210eaef6af7f1e80e25b98)
Theorem hlt_SEPARATED_IN_UNION : forall A:set, A <> Empty -> (forall top :e hl_ty_topology A, forall s t u :e 2 :^: A, hl_separated_in A top s (hl_UNION A t u) = 1 <-> hl_separated_in A top s t = 1 /\ hl_separated_in A top s u = 1) /\ forall top :e hl_ty_topology A, forall s t u :e 2 :^: A, hl_separated_in A top (hl_UNION A s t) u = 1 <-> hl_separated_in A top s u = 1 /\ hl_separated_in A top t u = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:7608 / SEPARATED_IN_UNIONS   (hash md5:0d6fcca1dbbb359b8fc3c165db650686)
Theorem hlt_SEPARATED_IN_UNIONS : forall A:set, A <> Empty -> (forall top :e hl_ty_topology A, forall s :e 2 :^: A, forall u :e 2 :^: (2 :^: A), hl_FINITE (2 :^: A) u = 1 -> (hl_separated_in A top s (hl_UNIONS A u) = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1 /\ forall t :e 2 :^: A, hl_IN (2 :^: A) t u = 1 -> hl_separated_in A top s t = 1)) /\ forall top :e hl_ty_topology A, forall s :e 2 :^: A, forall u :e 2 :^: (2 :^: A), hl_FINITE (2 :^: A) u = 1 -> (hl_separated_in A top (hl_UNIONS A u) s = 1 <-> (forall t :e 2 :^: A, hl_IN (2 :^: A) t u = 1 -> hl_separated_in A top s t = 1) /\ hl_SUBSET A s (hl_topspace A top) = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:7621 / SEPARATED_IN_DIFFS   (hash md5:370f7abb9c797ee11be23731802d5223)
Theorem hlt_SEPARATED_IN_DIFFS : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_open_in A top s = 1 /\ hl_open_in A top t = 1 \/ hl_closed_in A top s = 1 /\ hl_closed_in A top t = 1 -> hl_separated_in A top (hl_DIFF A s t) (hl_DIFF A t s) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:7641 / SEPARATION_CLOSED_IN_UNION_GEN   (hash md5:13094122ebd92de7e5792a2ffade5d51)
Theorem hlt_SEPARATION_CLOSED_IN_UNION_GEN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_separated_in A top s t = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1 /\ (hl_SUBSET A t (hl_topspace A top) = 1 /\ (hl_DISJOINT A s t = 1 /\ (hl_closed_in A (hl_subtopology A top (hl_UNION A s t)) s = 1 /\ hl_closed_in A (hl_subtopology A top (hl_UNION A s t)) t = 1))).
Admitted.

// HOL Light: Multivariate/metric.ml:7652 / SEPARATION_OPEN_IN_UNION_GEN   (hash md5:13341d532079adae8c99ad99c8a36b34)
Theorem hlt_SEPARATION_OPEN_IN_UNION_GEN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_separated_in A top s t = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1 /\ (hl_SUBSET A t (hl_topspace A top) = 1 /\ (hl_DISJOINT A s t = 1 /\ (hl_open_in A (hl_subtopology A top (hl_UNION A s t)) s = 1 /\ hl_open_in A (hl_subtopology A top (hl_UNION A s t)) t = 1))).
Admitted.

// HOL Light: Multivariate/metric.ml:7668 / SEPARATED_IN_FULL   (hash md5:1b4b70dd86a5303c02f8527ce6b6b32a)
Theorem hlt_SEPARATED_IN_FULL : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_UNION A s t = hl_topspace A top -> (hl_separated_in A top s t = 1 <-> hl_DISJOINT A s t = 1 /\ (hl_closed_in A top s = 1 /\ (hl_open_in A top s = 1 /\ (hl_closed_in A top t = 1 /\ hl_open_in A top t = 1)))).
Admitted.

// HOL Light: Multivariate/metric.ml:7683 / HOMEOMORPHIC_MAP_SEPARATION   (hash md5:4be4c3bbe10f0e98ea0e6088173af299)
Theorem hlt_HOMEOMORPHIC_MAP_SEPARATION : forall A B:set, A <> Empty -> B <> Empty -> forall f :e B :^: A, forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall s t :e 2 :^: A, hl_homeomorphic_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (hl_SUBSET A s (hl_topspace A top) = 1 /\ hl_SUBSET A t (hl_topspace A top) = 1) -> (hl_separated_in B top' (hl_IMAGE A B f s) (hl_IMAGE A B f t) = 1 <-> hl_separated_in A top s t = 1).
