// HOL Light: Multivariate/metric.ml:9785 / PERFECT_MAP_RESTRICTION   (hash md5:df6e20a04047c6701ac942806e0172fe)
Theorem hlt_PERFECT_MAP_RESTRICTION : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, forall u :e 2 :^: A, forall v :e 2 :^: B, hl_perfect_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_GSPEC A (fun GEN_PVAR_1580 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_1580 (if hl_IN A x (hl_topspace A top) = 1 /\ hl_IN B (f x) v = 1 then 1 else 0) x = 1 then 1 else 0) = u -> hl_perfect_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top u) (hl_subtopology B top' v)) f = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:9794 / PERFECT_MAP_FROM_COMPOSITION_LEFT   (hash md5:50aab6f8a484c516569b45ec2b8fae6f)
Theorem hlt_PERFECT_MAP_FROM_COMPOSITION_LEFT : forall A B C:set, A <> Empty -> B <> Empty -> C <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall top'' :e hl_ty_topology C, forall f :e B :^: A, forall g :e C :^: B, hl_perfect_map A C (hl_pair (hl_ty_topology A) (hl_ty_topology C) top top'') (hl_o B C A g f) = 1 /\ (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ (hl_continuous_map B C (hl_pair (hl_ty_topology B) (hl_ty_topology C) top' top'') g = 1 /\ hl_IMAGE A B f (hl_topspace A top) = hl_topspace B top')) -> hl_perfect_map B C (hl_pair (hl_ty_topology B) (hl_ty_topology C) top' top'') g = 1.
