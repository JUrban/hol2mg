Theorem hlt_COMPACT_CLOSURE_OF_EQ_BOLZANO_WEIERSTRASS : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall s :e 2 :^: A, hl_compact_in A (hl_mtopology A m) (hl_closure_of A (hl_mtopology A m) s) = 1 <-> forall t :e 2 :^: A, hl_INFINITE A t = 1 /\ (hl_SUBSET A t s = 1 /\ hl_SUBSET A t (hl_mspace A m) = 1) -> ~ hl_derived_set_of A (hl_mtopology A m) t = hl_EMPTY A.
