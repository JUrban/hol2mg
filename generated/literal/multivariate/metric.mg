// HOL Light: Multivariate/metric.ml:14418 / SEPARATED_BETWEEN_FRONTIER_OF_EQ   (hash md5:ba7695a9edaa476ae98e8b3fce577b30)
Theorem hlt_SEPARATED_BETWEEN_FRONTIER_OF_EQ : forall A:set, A <> Empty -> (forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_separated_between A top s t = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1 /\ (hl_DISJOINT A s t = 1 /\ hl_separated_between A top (hl_frontier_of A top s) t = 1)) /\ forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_separated_between A top s t = 1 <-> hl_SUBSET A t (hl_topspace A top) = 1 /\ (hl_DISJOINT A s t = 1 /\ hl_separated_between A top s (hl_frontier_of A top t) = 1).
