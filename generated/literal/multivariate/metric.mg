Admitted.

// HOL Light: Multivariate/metric.ml:15426 / OPEN_NEIGHBOURHOOD_BASE_OF   (hash md5:e9dcb7764fc48b3f4ffba9f260609e8c)
Theorem hlt_OPEN_NEIGHBOURHOOD_BASE_OF : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall P :e 2 :^: (2 :^: A), (forall s :e 2 :^: A, P s = 1 -> hl_open_in A top s = 1) -> (hl_neighbourhood_base_of A P top = 1 <-> forall w :e 2 :^: A, forall x :e A, hl_open_in A top w = 1 /\ hl_IN A x w = 1 -> exists u :e 2 :^: A, P u = 1 /\ (hl_IN A x u = 1 /\ hl_SUBSET A u w = 1)).
Admitted.

// HOL Light: Multivariate/metric.ml:15435 / OPEN_IN_TOPOLOGY_NEIGHBOURHOOD_BASE_UNIQUE   (hash md5:06d66c229739e40293fe6ffecc5f3c29)
Theorem hlt_OPEN_IN_TOPOLOGY_NEIGHBOURHOOD_BASE_UNIQUE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall b :e 2 :^: (2 :^: A), hl_open_in A top = hl_UNION_OF A (hl_ARBITRARY A) b <-> (forall u :e 2 :^: A, hl_IN (2 :^: A) u b = 1 -> hl_open_in A top u = 1) /\ hl_neighbourhood_base_of A b top = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:15444 / NEIGHBOURHOOD_BASE_OF_OPEN_SUBSET   (hash md5:57f775d2ec2fd0b29116ffda5577753f)
Theorem hlt_NEIGHBOURHOOD_BASE_OF_OPEN_SUBSET : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall P :e 2 :^: (2 :^: A), forall s :e 2 :^: A, hl_neighbourhood_base_of A P top = 1 /\ hl_open_in A top s = 1 -> hl_neighbourhood_base_of A P (hl_subtopology A top s) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:15459 / NEIGHBOURHOOD_BASE_AT_TOPOLOGY_BASE   (hash md5:826cebaf1a21a9ca285870a98d9ead2c)
Theorem hlt_NEIGHBOURHOOD_BASE_AT_TOPOLOGY_BASE : forall A:set, A <> Empty -> forall P :e 2 :^: (2 :^: A), forall top :e hl_ty_topology A, forall b :e 2 :^: (2 :^: A), forall x :e A, hl_open_in A top = hl_UNION_OF A (hl_ARBITRARY A) b -> (hl_neighbourhood_base_at A x P top = 1 <-> forall w :e 2 :^: A, hl_IN (2 :^: A) w b = 1 /\ hl_IN A x w = 1 -> exists u v :e 2 :^: A, hl_open_in A top u = 1 /\ (P v = 1 /\ (hl_IN A x u = 1 /\ (hl_SUBSET A u v = 1 /\ hl_SUBSET A v w = 1)))).
Admitted.

// HOL Light: Multivariate/metric.ml:15475 / NEIGHBOURHOOD_BASE_OF_TOPOLOGY_BASE   (hash md5:3bed7848e9514e4d8bc7fbd0aeefb132)
Theorem hlt_NEIGHBOURHOOD_BASE_OF_TOPOLOGY_BASE : forall A:set, A <> Empty -> forall P :e 2 :^: (2 :^: A), forall top :e hl_ty_topology A, forall b :e 2 :^: (2 :^: A), hl_open_in A top = hl_UNION_OF A (hl_ARBITRARY A) b -> (hl_neighbourhood_base_of A P top = 1 <-> forall w :e 2 :^: A, forall x :e A, hl_IN (2 :^: A) w b = 1 /\ hl_IN A x w = 1 -> exists u v :e 2 :^: A, hl_open_in A top u = 1 /\ (P v = 1 /\ (hl_IN A x u = 1 /\ (hl_SUBSET A u v = 1 /\ hl_SUBSET A v w = 1)))).
Admitted.

// HOL Light: Multivariate/metric.ml:15492 / NEIGHBOURHOOD_BASE_AT_UNLOCALIZED   (hash md5:e34dde8b56c87eff2507069bd9a87feb)
Theorem hlt_NEIGHBOURHOOD_BASE_AT_UNLOCALIZED : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall P :e 2 :^: (2 :^: A), forall x :e A, (forall s t :e 2 :^: A, P s = 1 /\ (hl_open_in A top t = 1 /\ (hl_IN A x t = 1 /\ hl_SUBSET A t s = 1)) -> P t = 1) -> (hl_neighbourhood_base_at A x P top = 1 <-> hl_IN A x (hl_topspace A top) = 1 -> exists u v :e 2 :^: A, hl_open_in A top u = 1 /\ (P v = 1 /\ (hl_IN A x u = 1 /\ (hl_SUBSET A u v = 1 /\ hl_SUBSET A v (hl_topspace A top) = 1)))).
Admitted.

// HOL Light: Multivariate/metric.ml:15511 / NEIGHBOURHOOD_BASE_OF_UNLOCALIZED   (hash md5:dc9def7f9f8924e139017603736fcf11)
Theorem hlt_NEIGHBOURHOOD_BASE_OF_UNLOCALIZED : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall P :e 2 :^: (2 :^: A), (forall s t :e 2 :^: A, P s = 1 /\ (hl_open_in A top t = 1 /\ (~ t = hl_EMPTY A /\ hl_SUBSET A t s = 1)) -> P t = 1) -> (hl_neighbourhood_base_of A P top = 1 <-> forall x :e A, hl_IN A x (hl_topspace A top) = 1 -> exists u v :e 2 :^: A, hl_open_in A top u = 1 /\ (P v = 1 /\ (hl_IN A x u = 1 /\ (hl_SUBSET A u v = 1 /\ hl_SUBSET A v (hl_topspace A top) = 1)))).
Admitted.

// HOL Light: Multivariate/metric.ml:15526 / NEIGHBOURHOOD_BASE_AT_DISCRETE_TOPOLOGY   (hash md5:736346c94eca7c219b8d16ce50733f3b)
Theorem hlt_NEIGHBOURHOOD_BASE_AT_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall P :e 2 :^: (2 :^: A), forall u :e 2 :^: A, forall x :e A, hl_neighbourhood_base_at A x P (hl_discrete_topology A u) = 1 <-> hl_IN A x u = 1 -> P (hl_INSERT A x (hl_EMPTY A)) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:15542 / NEIGHBOURHOOD_BASE_OF_DISCRETE_TOPOLOGY   (hash md5:c4e397604b98cd1b5e4c6bb3f3bb102f)
Theorem hlt_NEIGHBOURHOOD_BASE_OF_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall P :e 2 :^: (2 :^: A), forall u :e 2 :^: A, hl_neighbourhood_base_of A P (hl_discrete_topology A u) = 1 <-> forall x :e A, hl_IN A x u = 1 -> P (hl_INSERT A x (hl_EMPTY A)) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:15550 / NEIGHBOURHOOD_BASE_AT_WITH_SUBSET   (hash md5:4936d227ba6b4ce6c09298f47d3cddc1)
Theorem hlt_NEIGHBOURHOOD_BASE_AT_WITH_SUBSET : forall A:set, A <> Empty -> forall P :e 2 :^: (2 :^: A), forall top :e hl_ty_topology A, forall u :e 2 :^: A, forall x :e A, hl_open_in A top u = 1 /\ hl_IN A x u = 1 -> (hl_neighbourhood_base_at A x P top = 1 <-> hl_neighbourhood_base_at A x (fun t :e 2 :^: A => if hl_SUBSET A t u = 1 /\ P t = 1 then 1 else 0) top = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:15562 / NEIGHBOURHOOD_BASE_OF_WITH_SUBSET   (hash md5:5022e5e183b0c2a40e2eadb0991824a8)
Theorem hlt_NEIGHBOURHOOD_BASE_OF_WITH_SUBSET : forall A:set, A <> Empty -> forall P :e 2 :^: (2 :^: A), forall top :e hl_ty_topology A, hl_neighbourhood_base_of A P top = 1 <-> hl_neighbourhood_base_of A (fun t :e 2 :^: A => if hl_SUBSET A t (hl_topspace A top) = 1 /\ P t = 1 then 1 else 0) top = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:15574 / SECOND_COUNTABLE_NEIGHBOURHOOD_BASE_ALT   (hash md5:934340e7527e6f694968d49694868bde)
Theorem hlt_SECOND_COUNTABLE_NEIGHBOURHOOD_BASE_ALT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_second_countable A top = 1 <-> exists b :e 2 :^: (2 :^: A), hl_COUNTABLE (2 :^: A) b = 1 /\ ((forall v :e 2 :^: A, hl_IN (2 :^: A) v b = 1 -> hl_open_in A top v = 1) /\ hl_neighbourhood_base_of A b top = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:15582 / FIRST_COUNTABLE_NEIGHBOURHOOD_BASE_ALT   (hash md5:50d8651e9c2c60331a63d081e8328ab9)
Theorem hlt_FIRST_COUNTABLE_NEIGHBOURHOOD_BASE_ALT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_first_countable A top = 1 <-> forall x :e A, hl_IN A x (hl_topspace A top) = 1 -> exists b :e 2 :^: (2 :^: A), hl_COUNTABLE (2 :^: A) b = 1 /\ ((forall v :e 2 :^: A, hl_IN (2 :^: A) v b = 1 -> hl_open_in A top v = 1) /\ hl_neighbourhood_base_at A x b top = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:15596 / SECOND_COUNTABLE_NEIGHBOURHOOD_BASE   (hash md5:5d41792cb392c73c80dea6afc2538362)
Theorem hlt_SECOND_COUNTABLE_NEIGHBOURHOOD_BASE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_second_countable A top = 1 <-> exists b :e 2 :^: (2 :^: A), hl_COUNTABLE (2 :^: A) b = 1 /\ hl_neighbourhood_base_of A b top = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:15616 / FIRST_COUNTABLE_NEIGHBOURHOOD_BASE   (hash md5:0969b2be9592711d3b979f00c0e24883)
Theorem hlt_FIRST_COUNTABLE_NEIGHBOURHOOD_BASE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_first_countable A top = 1 <-> forall x :e A, hl_IN A x (hl_topspace A top) = 1 -> exists b :e 2 :^: (2 :^: A), hl_COUNTABLE (2 :^: A) b = 1 /\ hl_neighbourhood_base_at A x b top = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:15643 / t0_space   (hash md5:75487e4bb922d31a0470f589d330c269)
Theorem hlt_t0_space_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_t0_space A top = 1 <-> forall x y :e A, hl_IN A x (hl_topspace A top) = 1 /\ (hl_IN A y (hl_topspace A top) = 1 /\ ~ x = y) -> exists u :e 2 :^: A, hl_open_in A top u = 1 /\ ~ (hl_IN A x u = 1 <-> hl_IN A y u = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:15648 / T0_SPACE_EXPANSIVE   (hash md5:73dec082e450b6f304877a8ff03b2d1f)
Theorem hlt_T0_SPACE_EXPANSIVE : forall A:set, A <> Empty -> forall top top' :e hl_ty_topology A, hl_topspace A top' = hl_topspace A top /\ (forall u :e 2 :^: A, hl_open_in A top u = 1 -> hl_open_in A top' u = 1) -> hl_t0_space A top = 1 -> hl_t0_space A top' = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:15654 / T1_IMP_T0_SPACE   (hash md5:97b322ffabf99c9eb8a95b02f9d6237e)
Theorem hlt_T1_IMP_T0_SPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_t1_space A top = 1 -> hl_t0_space A top = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:15658 / T1_EQ_SYMMETRIC_T0_SPACE_ALT   (hash md5:b828e87c10aa320e172d414cb8d992d5)
Theorem hlt_T1_EQ_SYMMETRIC_T0_SPACE_ALT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_t1_space A top = 1 <-> hl_t0_space A top = 1 /\ forall x y :e A, hl_IN A x (hl_topspace A top) = 1 /\ hl_IN A y (hl_topspace A top) = 1 -> (hl_IN A x (hl_closure_of A top (hl_INSERT A y (hl_EMPTY A))) = 1 <-> hl_IN A y (hl_closure_of A top (hl_INSERT A x (hl_EMPTY A))) = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:15673 / T1_EQ_SYMMETRIC_T0_SPACE   (hash md5:b2199eb44d95e346ec8aa3f75b3282e8)
Theorem hlt_T1_EQ_SYMMETRIC_T0_SPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_t1_space A top = 1 <-> hl_t0_space A top = 1 /\ forall x y :e A, hl_IN A x (hl_closure_of A top (hl_INSERT A y (hl_EMPTY A))) = 1 <-> hl_IN A y (hl_closure_of A top (hl_INSERT A x (hl_EMPTY A))) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:15689 / HAUSDORFF_IMP_T0_SPACE   (hash md5:b0c79a1d5021e5c16a41d6ce27c266e1)
Theorem hlt_HAUSDORFF_IMP_T0_SPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_hausdorff_space A top = 1 -> hl_t0_space A top = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:15693 / T0_SPACE   (hash md5:bf61a2c5f7221affd61d55e5a8c11e73)
Theorem hlt_T0_SPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_t0_space A top = 1 <-> forall x y :e A, hl_IN A x (hl_topspace A top) = 1 /\ (hl_IN A y (hl_topspace A top) = 1 /\ ~ x = y) -> exists c :e 2 :^: A, hl_closed_in A top c = 1 /\ ~ (hl_IN A x c = 1 <-> hl_IN A y c = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:15700 / HOMEOMORPHIC_T0_SPACE   (hash md5:1b58fb64785632e6513055c190411f7d)
Theorem hlt_HOMEOMORPHIC_T0_SPACE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_homeomorphic_space A B top top' = 1 -> (hl_t0_space A top = 1 <-> hl_t0_space B top' = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:15725 / T0_SPACE_CLOSURE_OF_SING   (hash md5:ec4f0d9498dfd79459e48e2570cc029f)
Theorem hlt_T0_SPACE_CLOSURE_OF_SING : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_t0_space A top = 1 <-> forall x y :e A, hl_IN A x (hl_topspace A top) = 1 /\ (hl_IN A y (hl_topspace A top) = 1 /\ hl_closure_of A top (hl_INSERT A x (hl_EMPTY A)) = hl_closure_of A top (hl_INSERT A y (hl_EMPTY A))) -> x = y.
Admitted.

// HOL Light: Multivariate/metric.ml:15736 / T0_SPACE_DISCRETE_TOPOLOGY   (hash md5:087b975031ba23d9fbd26e987c0e78a3)
Theorem hlt_T0_SPACE_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall s :e 2 :^: A, hl_t0_space A (hl_discrete_topology A s) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:15742 / T0_SPACE_SUBTOPOLOGY   (hash md5:dd2e1dcab073abc6fc969c399567b4da)
Theorem hlt_T0_SPACE_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall u :e 2 :^: A, hl_t0_space A top = 1 -> hl_t0_space A (hl_subtopology A top u) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:15749 / T0_SPACE_RETRACTION_MAP_IMAGE   (hash md5:30da8af58ba19c93d993f6c30e879945)
Theorem hlt_T0_SPACE_RETRACTION_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall r :e B :^: A, hl_retraction_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') r = 1 /\ hl_t0_space A top = 1 -> hl_t0_space B top' = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:15755 / T0_SPACE_PROD_TOPOLOGY   (hash md5:3928e92d8eab67a96a6fdf383544a87a)
Theorem hlt_T0_SPACE_PROD_TOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, hl_t0_space (A :*: B) (hl_prod_topology A B top1 top2) = 1 <-> hl_topspace (A :*: B) (hl_prod_topology A B top1 top2) = hl_EMPTY (A :*: B) \/ hl_t0_space A top1 = 1 /\ hl_t0_space B top2 = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:15770 / T0_SPACE_PRODUCT_TOPOLOGY   (hash md5:16cc95f8c3a9db88a8d32dc5662dcf43)
Theorem hlt_T0_SPACE_PRODUCT_TOPOLOGY : forall A K:set, A <> Empty -> K <> Empty -> forall tops :e hl_ty_topology A :^: K, forall k :e 2 :^: K, hl_t0_space (A :^: K) (hl_product_topology K A k tops) = 1 <-> hl_topspace (A :^: K) (hl_product_topology K A k tops) = hl_EMPTY (A :^: K) \/ forall i :e K, hl_IN K i k = 1 -> hl_t0_space A (tops i) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:15802 / kolmogorov_quotient   (hash md5:843f46a52c55f951ab9966744efbda40)
Theorem hlt_kolmogorov_quotient_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_kolmogorov_quotient A top = fun x :e A => hl_select A (fun y :e A => if forall u :e 2 :^: A, hl_open_in A top u = 1 -> (hl_IN A y u = 1 <-> hl_IN A x u = 1) then 1 else 0).
Admitted.

// HOL Light: Multivariate/metric.ml:15806 / KOLMOGOROV_QUOTIENT_IN_OPEN   (hash md5:b4d1103df9308501a5dcaf3ad3823b75)
Theorem hlt_KOLMOGOROV_QUOTIENT_IN_OPEN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall u :e 2 :^: A, forall x :e A, hl_open_in A top u = 1 -> (hl_IN A (hl_kolmogorov_quotient A top x) u = 1 <-> hl_IN A x u = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:15811 / KOLMOGOROV_QUOTIENT_IN_TOPSPACE   (hash md5:2b18abfdfb7313050ce901e8e17a1a26)
Theorem hlt_KOLMOGOROV_QUOTIENT_IN_TOPSPACE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall x :e A, hl_IN A (hl_kolmogorov_quotient A top x) (hl_topspace A top) = 1 <-> hl_IN A x (hl_topspace A top) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:15815 / KOLMOGOROV_QUOTIENT_IN_CLOSED   (hash md5:983c4c036479f755e39e0fabd0680cbe)
Theorem hlt_KOLMOGOROV_QUOTIENT_IN_CLOSED : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall c :e 2 :^: A, forall x :e A, hl_closed_in A top c = 1 -> (hl_IN A (hl_kolmogorov_quotient A top x) c = 1 <-> hl_IN A x c = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:15821 / CONTINUOUS_MAP_KOLMOGOROV_QUOTIENT   (hash md5:bf1e029a01e0f806a083d08184e6ad8e)
Theorem hlt_CONTINUOUS_MAP_KOLMOGOROV_QUOTIENT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_continuous_map A A (hl_pair (hl_ty_topology A) (hl_ty_topology A) top top) (hl_kolmogorov_quotient A top) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:15830 / OPEN_MAP_KOLMOGOROV_QUOTIENT_EXPLICIT   (hash md5:dd138798623b50c491056e1c43bcd279)
Theorem hlt_OPEN_MAP_KOLMOGOROV_QUOTIENT_EXPLICIT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall u :e 2 :^: A, hl_open_in A top u = 1 -> hl_IMAGE A A (hl_kolmogorov_quotient A top) u = hl_INTER A (hl_IMAGE A A (hl_kolmogorov_quotient A top) (hl_topspace A top)) u.
Admitted.

// HOL Light: Multivariate/metric.ml:15839 / OPEN_MAP_KOLMOGOROV_QUOTIENT_GEN   (hash md5:88c9fced5328e2746042a884c30ca7a0)
Theorem hlt_OPEN_MAP_KOLMOGOROV_QUOTIENT_GEN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_open_map A A (hl_pair (hl_ty_topology A) (hl_ty_topology A) (hl_subtopology A top s) (hl_subtopology A top (hl_IMAGE A A (hl_kolmogorov_quotient A top) s))) (hl_kolmogorov_quotient A top) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:15851 / OPEN_MAP_KOLMOGOROV_QUOTIENT   (hash md5:240c90a71615d81e76c0a0e65ac98a78)
Theorem hlt_OPEN_MAP_KOLMOGOROV_QUOTIENT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_open_map A A (hl_pair (hl_ty_topology A) (hl_ty_topology A) top (hl_subtopology A top (hl_IMAGE A A (hl_kolmogorov_quotient A top) (hl_topspace A top)))) (hl_kolmogorov_quotient A top) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:15861 / CLOSED_MAP_KOLMOGOROV_QUOTIENT_EXPLICIT   (hash md5:4ca4bc4a6f783888d10ca870d7baa038)
Theorem hlt_CLOSED_MAP_KOLMOGOROV_QUOTIENT_EXPLICIT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall u :e 2 :^: A, hl_closed_in A top u = 1 -> hl_IMAGE A A (hl_kolmogorov_quotient A top) u = hl_INTER A (hl_IMAGE A A (hl_kolmogorov_quotient A top) (hl_topspace A top)) u.
Admitted.

// HOL Light: Multivariate/metric.ml:15870 / CLOSED_MAP_KOLMOGOROV_QUOTIENT_GEN   (hash md5:9abe466a4c73069cf5db4f2c36fdab3c)
Theorem hlt_CLOSED_MAP_KOLMOGOROV_QUOTIENT_GEN : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_closed_map A A (hl_pair (hl_ty_topology A) (hl_ty_topology A) (hl_subtopology A top s) (hl_subtopology A top (hl_IMAGE A A (hl_kolmogorov_quotient A top) s))) (hl_kolmogorov_quotient A top) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:15882 / CLOSED_MAP_KOLMOGOROV_QUOTIENT   (hash md5:1f787d826aced464e1c45609bdfe5ca9)
Theorem hlt_CLOSED_MAP_KOLMOGOROV_QUOTIENT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_closed_map A A (hl_pair (hl_ty_topology A) (hl_ty_topology A) top (hl_subtopology A top (hl_IMAGE A A (hl_kolmogorov_quotient A top) (hl_topspace A top)))) (hl_kolmogorov_quotient A top) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:15892 / QUOTIENT_MAP_KOLMOGOROV_QUOTIENT_GEN   (hash md5:6b5dcbcc86c11b76329ab8ef36449398)
