// HOL Light: Multivariate/metric.ml:26052 / LOCALLY_CONNECTED_SPACE_PRODUCT_TOPOLOGY   (hash md5:677b7bc153ae200975fe92905cb98b59)
Theorem hlt_LOCALLY_CONNECTED_SPACE_PRODUCT_TOPOLOGY : forall A K:set, A <> Empty -> K <> Empty -> forall tops :e hl_ty_topology A :^: K, forall k :e 2 :^: K, hl_locally_connected_space (A :^: K) (hl_product_topology K A k tops) = 1 <-> hl_topspace (A :^: K) (hl_product_topology K A k tops) = hl_EMPTY (A :^: K) \/ hl_FINITE K (hl_GSPEC K (fun GEN_PVAR_2039 :e K => if exists i :e K, hl_SETSPEC K GEN_PVAR_2039 (if hl_IN K i k = 1 /\ ~ hl_connected_space A (tops i) = 1 then 1 else 0) i = 1 then 1 else 0)) = 1 /\ forall i :e K, hl_IN K i k = 1 -> hl_locally_connected_space A (tops i) = 1.
Admitted.

