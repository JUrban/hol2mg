Theorem hlt_monotone_map_thm : forall A B:set, A <> Empty -> B <> Empty -> forall top' :e hl_ty_topology B, forall top :e hl_ty_topology A, forall f :e B :^: A, hl_monotone_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 <-> hl_SUBSET B (hl_IMAGE A B f (hl_topspace A top)) (hl_topspace B top') = 1 /\ forall y :e B, hl_IN B y (hl_topspace B top') = 1 -> hl_connected_in A top (hl_GSPEC A (fun GEN_PVAR_1699 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_1699 (if hl_IN A x (hl_topspace A top) = 1 /\ f x = y then 1 else 0) x = 1 then 1 else 0)) = 1.
