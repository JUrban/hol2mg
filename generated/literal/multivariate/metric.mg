Theorem hlt_CONNECTED_SPACE_TOPSPACE_EMPTY : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, hl_topspace A top = hl_EMPTY A -> hl_connected_space A top = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:13214 / CONNECTED_IN_SING   (hash md5:9285b4c7587ea70eb0601ebe52b336f1)
Theorem hlt_CONNECTED_IN_SING : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall a :e A, hl_connected_in A top (hl_INSERT A a (hl_EMPTY A)) = 1 <-> hl_IN A a (hl_topspace A top) = 1.
Admitted.

