// HOL Light: Multivariate/metric.ml:2966 / OPEN_MAP_INTO_SUBTOPOLOGY   (hash md5:1ce7fe13f33c1446614e973a195b3c40)
Theorem hlt_OPEN_MAP_INTO_SUBTOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, forall s :e 2 :^: B, hl_open_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_SUBSET B (hl_IMAGE A B f (hl_topspace A top)) s = 1 -> hl_open_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top (hl_subtopology B top' s)) f = 1.
