// HOL Light: Multivariate/metric.ml:20455 / TOTALLY_BOUNDED_IN_SEQUENTIALLY   (hash md5:866d768aa6d504ac7ff253690a2d3225)
Theorem hlt_TOTALLY_BOUNDED_IN_SEQUENTIALLY : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall s :e 2 :^: A, hl_totally_bounded_in A m s = 1 <-> hl_SUBSET A s (hl_mspace A m) = 1 /\ forall x :e A :^: omega, (forall n :e omega, hl_IN A (x n) s = 1) -> exists r :e omega :^: omega, (forall m1 n :e omega, hl_lt m1 n = 1 -> hl_lt (r m1) (r n) = 1) /\ hl_cauchy_in A m (hl_o omega A omega x r) = 1.
Admitted.

