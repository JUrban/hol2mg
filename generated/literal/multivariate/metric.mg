// HOL Light: Multivariate/metric.ml:3738 / OPEN_IN_PROD_TOPOLOGY_ALT   (hash md5:785579415be69897c90720494f806863)
Theorem hlt_OPEN_IN_PROD_TOPOLOGY_ALT : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, forall s :e 2 :^: (A :*: B), hl_open_in (A :*: B) (hl_prod_topology A B top1 top2) s = 1 <-> forall x :e A, forall y :e B, hl_IN (A :*: B) (hl_pair A B x y) s = 1 -> exists u :e 2 :^: A, exists v :e 2 :^: B, hl_open_in A top1 u = 1 /\ (hl_open_in B top2 v = 1 /\ (hl_IN A x u = 1 /\ (hl_IN B y v = 1 /\ hl_SUBSET (A :*: B) (hl_CROSS A B u v) s = 1))).
