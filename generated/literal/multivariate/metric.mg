// HOL Light: Multivariate/metric.ml:13314 / CONNECTED_IN_SEPARATION   (hash md5:c196651b1b09de3106690f7e70b24c60)
Theorem hlt_CONNECTED_IN_SEPARATION : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_connected_in A top s = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1 /\ ~ exists c1 c2 :e 2 :^: A, hl_UNION A c1 c2 = s /\ (~ c1 = hl_EMPTY A /\ (~ c2 = hl_EMPTY A /\ (hl_INTER A c1 (hl_closure_of A top c2) = hl_EMPTY A /\ hl_INTER A c2 (hl_closure_of A top c1) = hl_EMPTY A))).
Admitted.

// HOL Light: Multivariate/metric.ml:13314 / CONNECTED_IN_SEPARATION_ALT   (hash md5:5f0f67524e5de385b0cd65a7ca8cdb45)
Theorem hlt_CONNECTED_IN_SEPARATION_ALT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_connected_in A top s = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1 /\ ~ exists c1 c2 :e 2 :^: A, hl_SUBSET A s (hl_UNION A c1 c2) = 1 /\ (~ hl_INTER A c1 s = hl_EMPTY A /\ (~ hl_INTER A c2 s = hl_EMPTY A /\ (hl_INTER A c1 (hl_closure_of A top c2) = hl_EMPTY A /\ hl_INTER A c2 (hl_closure_of A top c1) = hl_EMPTY A))).
