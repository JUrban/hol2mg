Theorem hlt_MCOMPLETE_FIP : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, hl_mcomplete A m = 1 <-> forall f :e 2 :^: (2 :^: A), (forall c :e 2 :^: A, hl_IN (2 :^: A) c f = 1 -> hl_closed_in A (hl_mtopology A m) c = 1) /\ ((forall e1 :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) e1 = 1 -> exists c :e 2 :^: A, exists a :e A, hl_IN (2 :^: A) c f = 1 /\ hl_SUBSET A c (hl_mcball A m (hl_pair A R a e1)) = 1) /\ (forall f' :e 2 :^: (2 :^: A), hl_FINITE (2 :^: A) f' = 1 /\ hl_SUBSET (2 :^: A) f' f = 1 -> ~ hl_INTERS A f' = hl_EMPTY A)) -> ~ hl_INTERS A f = hl_EMPTY A.
Admitted.

// HOL Light: Multivariate/metric.ml:20320 / MCOMPLETE_FIP_SING   (hash md5:6c8a8e5f4c0915d5708daf07eccc11a7)
Theorem hlt_MCOMPLETE_FIP_SING : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, hl_mcomplete A m = 1 <-> forall f :e 2 :^: (2 :^: A), (forall c :e 2 :^: A, hl_IN (2 :^: A) c f = 1 -> hl_closed_in A (hl_mtopology A m) c = 1) /\ ((forall e1 :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) e1 = 1 -> exists c :e 2 :^: A, exists a :e A, hl_IN (2 :^: A) c f = 1 /\ hl_SUBSET A c (hl_mcball A m (hl_pair A R a e1)) = 1) /\ (forall f' :e 2 :^: (2 :^: A), hl_FINITE (2 :^: A) f' = 1 /\ hl_SUBSET (2 :^: A) f' f = 1 -> ~ hl_INTERS A f' = hl_EMPTY A)) -> exists l :e A, hl_IN A l (hl_mspace A m) = 1 /\ hl_INTERS A f = hl_INSERT A l (hl_EMPTY A).
Admitted.

// HOL Light: Multivariate/metric.ml:20356 / MCOMPLETE_UNION   (hash md5:27b4d3550782b5d59929e244d5c7995d)
Theorem hlt_MCOMPLETE_UNION : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall s t :e 2 :^: A, hl_mcomplete A (hl_submetric A m s) = 1 /\ hl_mcomplete A (hl_submetric A m t) = 1 -> hl_mcomplete A (hl_submetric A m (hl_UNION A s t)) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:20379 / MCOMPLETE_UNIONS   (hash md5:d21922d71475f3e98ef34b4dc338c776)
Theorem hlt_MCOMPLETE_UNIONS : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall s :e 2 :^: (2 :^: A), hl_FINITE (2 :^: A) s = 1 /\ (forall t :e 2 :^: A, hl_IN (2 :^: A) t s = 1 -> hl_mcomplete A (hl_submetric A m t) = 1) -> hl_mcomplete A (hl_submetric A m (hl_UNIONS A s)) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:20388 / MCOMPLETE_INTERS   (hash md5:e9d596e6cb44907fe1681086e7753bf0)
Theorem hlt_MCOMPLETE_INTERS : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall s :e 2 :^: (2 :^: A), hl_FINITE (2 :^: A) s = 1 /\ (~ s = hl_EMPTY (2 :^: A) /\ (forall t :e 2 :^: A, hl_IN (2 :^: A) t s = 1 -> hl_mcomplete A (hl_submetric A m t) = 1)) -> hl_mcomplete A (hl_submetric A m (hl_INTERS A s)) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:20409 / MCOMPLETE_INTER   (hash md5:5a21f7b53f34db9ff21c8bc3eb5633fc)
Theorem hlt_MCOMPLETE_INTER : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall s t :e 2 :^: A, hl_mcomplete A (hl_submetric A m s) = 1 /\ hl_mcomplete A (hl_submetric A m t) = 1 -> hl_mcomplete A (hl_submetric A m (hl_INTER A s t)) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:20422 / totally_bounded_in   (hash md5:d64b909c826ff10b867e44bc4892c28d)
Theorem hlt_totally_bounded_in_thm : forall A:set, A <> Empty -> forall s :e 2 :^: A, forall m :e hl_ty_metric A, hl_totally_bounded_in A m s = 1 <-> forall e1 :e R, hl_real_lt (hl_real_of_num (hl_NUMERAL hl_zero)) e1 = 1 -> exists k :e 2 :^: A, hl_FINITE A k = 1 /\ (hl_SUBSET A k s = 1 /\ hl_SUBSET A s (hl_UNIONS A (hl_GSPEC (2 :^: A) (fun GEN_PVAR_1875 :e 2 :^: A => if exists x :e A, hl_SETSPEC (2 :^: A) GEN_PVAR_1875 (hl_IN A x k) (hl_mball A m (hl_pair A R x e1)) = 1 then 1 else 0))) = 1).
Admitted.

