Theorem hlt_MINIMAL_TOPOLOGY_BASE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall P :e 2 :^: (2 :^: A), (forall s :e 2 :^: A, P s = 1 -> hl_open_in A top s = 1) /\ (forall s t :e 2 :^: A, P s = 1 /\ P t = 1 -> P (hl_INTER A s t) = 1) -> forall s :e 2 :^: A, hl_open_in A (hl_topology A (hl_UNION_OF A (hl_ARBITRARY A) P)) s = 1 -> hl_open_in A top s = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:802 / OPEN_IN_TOPOLOGY_BASE_UNIQUE   (hash md5:099221e3468b02ca651dfbf214043456)
Theorem hlt_OPEN_IN_TOPOLOGY_BASE_UNIQUE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall B :e 2 :^: (2 :^: A), hl_open_in A top = hl_UNION_OF A (hl_ARBITRARY A) B <-> (forall v :e 2 :^: A, hl_IN (2 :^: A) v B = 1 -> hl_open_in A top v = 1) /\ forall u :e 2 :^: A, forall x :e A, hl_open_in A top u = 1 /\ hl_IN A x u = 1 -> exists v :e 2 :^: A, hl_IN (2 :^: A) v B = 1 /\ (hl_IN A x v = 1 /\ hl_SUBSET A v u = 1).
Admitted.

// HOL Light: Multivariate/metric.ml:821 / TOPOLOGY_BASE_UNIQUE   (hash md5:ba6c0c0a771386109f1f31c8ad8c3a0b)
Theorem hlt_TOPOLOGY_BASE_UNIQUE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall P :e 2 :^: (2 :^: A), (forall s :e 2 :^: A, P s = 1 -> hl_open_in A top s = 1) /\ (forall u :e 2 :^: A, forall x :e A, hl_open_in A top u = 1 /\ hl_IN A x u = 1 -> exists b :e 2 :^: A, P b = 1 /\ (hl_IN A x b = 1 /\ hl_SUBSET A b u = 1)) -> hl_topology A (hl_UNION_OF A (hl_ARBITRARY A) P) = top.
Admitted.

// HOL Light: Multivariate/metric.ml:830 / TOPOLOGY_BASES_EQ   (hash md5:949ef947bc6ad03fa64255030ebc5c0b)
Theorem hlt_TOPOLOGY_BASES_EQ : forall A:set, A <> Empty -> forall P Q :e 2 :^: (2 :^: A), (forall u :e 2 :^: A, forall x :e A, P u = 1 /\ hl_IN A x u = 1 -> exists v :e 2 :^: A, Q v = 1 /\ (hl_IN A x v = 1 /\ hl_SUBSET A v u = 1)) /\ (forall v :e 2 :^: A, forall x :e A, Q v = 1 /\ hl_IN A x v = 1 -> exists u :e 2 :^: A, P u = 1 /\ (hl_IN A x u = 1 /\ hl_SUBSET A u v = 1)) -> hl_topology A (hl_UNION_OF A (hl_ARBITRARY A) P) = hl_topology A (hl_UNION_OF A (hl_ARBITRARY A) Q).
