Theorem hlt_PROPER_MAP_RESTRICTION : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, forall u :e 2 :^: A, forall v :e 2 :^: B, hl_proper_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_GSPEC A (fun GEN_PVAR_1563 :e A => if exists x :e A, hl_SETSPEC A GEN_PVAR_1563 (if hl_IN A x (hl_topspace A top) = 1 /\ hl_IN B (f x) v = 1 then 1 else 0) x = 1 then 1 else 0) = u -> hl_proper_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top u) (hl_subtopology B top' v)) f = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:9438 / PROPER_MAP_IN_SUBTOPOLOGY   (hash md5:644789be9b02af36f49f5a64f2be3ef1)
Theorem hlt_PROPER_MAP_IN_SUBTOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall s :e 2 :^: B, forall f :e B :^: A, hl_closed_in B top' s = 1 -> (hl_proper_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top (hl_subtopology B top' s)) f = 1 <-> hl_proper_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_SUBSET B (hl_IMAGE A B f (hl_topspace A top)) s = 1).
