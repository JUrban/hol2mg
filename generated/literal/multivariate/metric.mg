Theorem hlt_OPEN_IN_SUBTOPOLOGY_UNION : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s t u :e 2 :^: A, hl_open_in A (hl_subtopology A top t) s = 1 /\ hl_open_in A (hl_subtopology A top u) s = 1 -> hl_open_in A (hl_subtopology A top (hl_UNION A t u)) s = 1.
