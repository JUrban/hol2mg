// HOL Light: Multivariate/metric.ml:14297 / SEPARATED_BETWEEN_UNION   (hash md5:b102831c23a6ddd70cc29ec0caa9b3e5)
Theorem hlt_SEPARATED_BETWEEN_UNION : forall A:set, A <> Empty -> (forall top :e hl_ty_topology A, forall s t u :e 2 :^: A, hl_separated_between A top s (hl_UNION A t u) = 1 <-> hl_separated_between A top s t = 1 /\ hl_separated_between A top s u = 1) /\ forall top :e hl_ty_topology A, forall s t u :e 2 :^: A, hl_separated_between A top (hl_UNION A s t) u = 1 <-> hl_separated_between A top s u = 1 /\ hl_separated_between A top t u = 1.
