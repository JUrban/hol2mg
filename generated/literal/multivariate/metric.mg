Theorem hlt_HOMOTOPIC_WITH_TRANS : forall A B:set, A <> Empty -> B <> Empty -> forall P :e 2 :^: (B :^: A), forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f g h :e B :^: A, hl_homotopic_with A B P (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f g = 1 /\ hl_homotopic_with A B P (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') g h = 1 -> hl_homotopic_with A B P (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f h = 1.
