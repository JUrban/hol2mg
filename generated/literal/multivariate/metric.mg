// HOL Light: Multivariate/metric.ml:22212 / PATH_CONNECTED_SPACE_RETRACTION_MAP_IMAGE   (hash md5:9695336dd393dc89489d81aaad442915)
Theorem hlt_PATH_CONNECTED_SPACE_RETRACTION_MAP_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall r :e B :^: A, hl_retraction_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') r = 1 /\ hl_path_connected_space A top = 1 -> hl_path_connected_space B top' = 1.
