Theorem hlt_INTERIOR_OF_EQ_EMPTY_COMPLEMENT : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_interior_of A top s = hl_EMPTY A <-> hl_closure_of A top (hl_DIFF A (hl_topspace A top) s) = hl_topspace A top.
