// HOL Light: Multivariate/metric.ml:31835 / CONTINUOUS_MAP_ON_INTERMEDIATE_CLOSURE_OF   (hash md5:41f0727a9cc6b63f549f78e646f948e6)
Theorem hlt_CONTINUOUS_MAP_ON_INTERMEDIATE_CLOSURE_OF : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, forall s t :e 2 :^: A, hl_regular_space B top' = 1 /\ (hl_SUBSET A t (hl_closure_of A top s) = 1 /\ (forall x :e A, hl_IN A x t = 1 -> hl_limit B A top' f (f x) (hl_within A (hl_atpointof A top x) s) = 1)) -> hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top t) top') f = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:31879 / CONTINUOUS_MAP_ON_INTERMEDIATE_CLOSURE_OF_EQ   (hash md5:b79e55dfab08cd23ad7783edb46961cc)
Theorem hlt_CONTINUOUS_MAP_ON_INTERMEDIATE_CLOSURE_OF_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, forall s t :e 2 :^: A, hl_regular_space B top' = 1 /\ (hl_SUBSET A s t = 1 /\ hl_SUBSET A t (hl_closure_of A top s) = 1) -> (hl_continuous_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) (hl_subtopology A top t) top') f = 1 <-> forall x :e A, hl_IN A x t = 1 -> hl_limit B A top' f (f x) (hl_within A (hl_atpointof A top x) s) = 1).
