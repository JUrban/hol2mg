// HOL Light: Multivariate/metric.ml:5996 / RETRACTION_MAPS_EQ   (hash md5:2990232fecbf67482cadbad271234c0a)
Theorem hlt_RETRACTION_MAPS_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f f' :e B :^: A, forall g g' :e A :^: B, (forall x :e A, hl_IN A x (hl_topspace A top) = 1 -> f x = f' x) /\ ((forall x :e B, hl_IN B x (hl_topspace B top') = 1 -> g x = g' x) /\ hl_retraction_maps A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') (hl_pair (B :^: A) (A :^: B) f g) = 1) -> hl_retraction_maps A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') (hl_pair (B :^: A) (A :^: B) f' g') = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:6009 / SECTION_MAP_EQ   (hash md5:c4f3871419a14720512c58079a54e7e6)
Theorem hlt_SECTION_MAP_EQ : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f g :e B :^: A, (forall x :e A, hl_IN A x (hl_topspace A top) = 1 -> f x = g x) /\ hl_section_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 -> hl_section_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') g = 1.
