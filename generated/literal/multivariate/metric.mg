// HOL Light: Multivariate/metric.ml:3801 / INTERIOR_OF_CROSS   (hash md5:3b919f405b4a90ba4c76c2985fb4fa98)
Theorem hlt_INTERIOR_OF_CROSS : forall A B:set, A <> Empty -> B <> Empty -> forall top1 :e hl_ty_topology A, forall top2 :e hl_ty_topology B, forall s :e 2 :^: A, forall t :e 2 :^: B, hl_interior_of (A :*: B) (hl_prod_topology A B top1 top2) (hl_CROSS A B s t) = hl_CROSS A B (hl_interior_of A top1 s) (hl_interior_of B top2 t).
