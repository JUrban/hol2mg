// HOL Light: Multivariate/metric.ml:11726 / MBALL_SUBSET   (hash md5:5f8f0360e2b8dcfe1ea3c3f4f3aa6257)
Theorem hlt_MBALL_SUBSET : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall x y :e A, forall a b :e R, hl_IN A y (hl_mspace A m) = 1 /\ hl_real_le (hl_real_add (hl_mdist A m (hl_pair A A x y)) a) b = 1 -> hl_SUBSET A (hl_mball A m (hl_pair A R x a)) (hl_mball A m (hl_pair A R y b)) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:11736 / DISJOINT_MBALL   (hash md5:2a1778d41ac0c8fb0a8db29b9b30d818)
Theorem hlt_DISJOINT_MBALL : forall A:set, A <> Empty -> forall m :e hl_ty_metric A, forall x x' :e A, forall r r' :e R, hl_real_le (hl_real_add r r') (hl_mdist A m (hl_pair A A x x')) = 1 -> hl_DISJOINT A (hl_mball A m (hl_pair A R x r)) (hl_mball A m (hl_pair A R x' r')) = 1.
