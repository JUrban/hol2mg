Theorem hlt_SEPARATED_BETWEEN_CLOSURE_OF_EQ : forall A:set, A <> Empty -> (forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_separated_between A top s t = 1 <-> hl_SUBSET A s (hl_topspace A top) = 1 /\ hl_separated_between A top (hl_closure_of A top s) t = 1) /\ forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_separated_between A top s t = 1 <-> hl_SUBSET A t (hl_topspace A top) = 1 /\ hl_separated_between A top s (hl_closure_of A top t) = 1.
