Theorem hlt_OPEN_IN_SUBBASE : forall A:set, A <> Empty -> forall B :e 2 :^: (2 :^: A), forall u s :e 2 :^: A, hl_open_in A (hl_topology A (hl_UNION_OF A (hl_ARBITRARY A) (hl_relative_to A (hl_INTERSECTION_OF A (hl_FINITE (2 :^: A)) B) u))) s = 1 <-> hl_UNION_OF A (hl_ARBITRARY A) (hl_relative_to A (hl_INTERSECTION_OF A (hl_FINITE (2 :^: A)) B) u) s = 1.
