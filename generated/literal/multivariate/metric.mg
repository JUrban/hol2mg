Theorem hlt_PROPER_MAP_INTO_SUBTOPOLOGY : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, forall f :e B :^: A, forall c :e 2 :^: B, hl_proper_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top top') f = 1 /\ hl_SUBSET B (hl_IMAGE A B f (hl_topspace A top)) c = 1 -> hl_proper_map A B (hl_pair (hl_ty_topology A) (hl_ty_topology B) top (hl_subtopology B top' c)) f = 1.
