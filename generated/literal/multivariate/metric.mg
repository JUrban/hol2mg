Theorem hlt_COMPLETELY_REGULAR_SPACE_DISCRETE_TOPOLOGY : forall A:set, A <> Empty -> forall u :e 2 :^: A, hl_completely_regular_space A (hl_discrete_topology A u) = 1.
Admitted.

// HOL Light: Multivariate/metric.ml:24936 / COMPLETELY_REGULAR_SPACE_SUBTOPOLOGY   (hash md5:bd950a2ba893ee67cc3f582b47e08bdc)
Theorem hlt_COMPLETELY_REGULAR_SPACE_SUBTOPOLOGY : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_completely_regular_space A top = 1 -> hl_completely_regular_space A (hl_subtopology A top s) = 1.
