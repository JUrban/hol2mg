Theorem hlt_CONNECTED_COMPONENT_OF_UNIQUE : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall c :e 2 :^: A, forall x :e A, hl_IN A x c = 1 /\ (hl_connected_in A top c = 1 /\ (forall c' :e 2 :^: A, hl_IN A x c' = 1 /\ hl_connected_in A top c' = 1 -> hl_SUBSET A c' c = 1)) -> hl_connected_component_of A top x = c.
