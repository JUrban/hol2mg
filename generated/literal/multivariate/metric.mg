// HOL Light: Multivariate/metric.ml:14394 / SEPARATED_BETWEEN_CLOSURE_OF   (hash md5:b24d7152c46606ab3b621f805827a5a5)
Theorem hlt_SEPARATED_BETWEEN_CLOSURE_OF : forall A:set, A <> Empty -> (forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_SUBSET A s (hl_topspace A top) = 1 -> (hl_separated_between A top (hl_closure_of A top s) t = 1 <-> hl_separated_between A top s t = 1)) /\ forall top :e hl_ty_topology A, forall s t :e 2 :^: A, hl_SUBSET A t (hl_topspace A top) = 1 -> (hl_separated_between A top s (hl_closure_of A top t) = 1 <-> hl_separated_between A top s t = 1).
Admitted.

