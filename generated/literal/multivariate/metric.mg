// HOL Light: Multivariate/metric.ml:14483 / connected_component_of   (hash md5:0a7ddcb66f15db32eed243cf2494b120)
Theorem hlt_connected_component_of_thm : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall x y :e A, hl_connected_component_of A top x y = 1 <-> exists t :e 2 :^: A, hl_connected_in A top t = 1 /\ (hl_IN A x t = 1 /\ hl_IN A y t = 1).
