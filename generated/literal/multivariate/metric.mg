Theorem hlt_CLOSURE_OF_SUBSET_INTER : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall s :e 2 :^: A, hl_SUBSET A (hl_INTER A (hl_topspace A top) s) (hl_closure_of A top s) = 1.
