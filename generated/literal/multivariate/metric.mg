// HOL Light: Multivariate/metric.ml:13226 / CONNECTED_IN_UNIONS   (hash md5:32fb8a4def87f964439d6c78acd409eb)
Theorem hlt_CONNECTED_IN_UNIONS : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall u :e 2 :^: (2 :^: A), (forall s :e 2 :^: A, hl_IN (2 :^: A) s u = 1 -> hl_connected_in A top s = 1) /\ ~ hl_INTERS A u = hl_EMPTY A -> hl_connected_in A top (hl_UNIONS A u) = 1.
