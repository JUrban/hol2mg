Theorem hlt_CONNECTED_COMPONENT_OF_EQ_OVERLAP : forall A:set, A <> Empty -> forall top :e hl_ty_topology A, forall x y :e A, hl_connected_component_of A top x = hl_connected_component_of A top y <-> ~ hl_IN A x (hl_topspace A top) = 1 /\ ~ hl_IN A y (hl_topspace A top) = 1 \/ ~ hl_INTER A (hl_connected_component_of A top x) (hl_connected_component_of A top y) = hl_EMPTY A.
