// HOL Light: Multivariate/metric.ml:29729 / HOMOTOPY_EQUIVALENT_SPACE_CONTRACTIBILITY   (hash md5:b04109840672249a668c78031505dd7a)
Theorem hlt_HOMOTOPY_EQUIVALENT_SPACE_CONTRACTIBILITY : forall A B:set, A <> Empty -> B <> Empty -> forall top :e hl_ty_topology A, forall top' :e hl_ty_topology B, hl_homotopy_equivalent_space A B top top' = 1 -> (hl_contractible_space A top = 1 <-> hl_contractible_space B top' = 1).
