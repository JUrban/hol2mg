// HOL Light: iterate.ml:1852 / NSUM_OFFSET   (hash md5:f5c432302f5cab438911f27eb17e7655)
// not bridged: 
Theorem NSUM_OFFSET : forall p :e omega, forall f:set -> set, (forall x :e omega, f x :e omega) -> forall m n :e omega, finsum {i :e omega | m + p <= i /\ i <= n + p} f = finsum {i :e omega | m <= i /\ i <= n} (fun i:set => f (i + p)).
Admitted.

// HOL Light: iterate.ml:1857 / NSUM_OFFSET_0   (hash md5:44309fb952465264a9681df86e23d463)
