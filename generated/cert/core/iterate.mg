// HOL Light: iterate.ml:1897 / CONG_NSUM   (hash md5:6dca1630a965c35bdb7639f08ad4cb94)
// not bridged: 
Theorem CONG_NSUM : forall A:set, A <> Empty -> forall n :e omega, forall f:set -> set, (forall x :e A, f x :e omega) -> forall g:set -> set, (forall x :e A, g x :e omega) -> forall s c= A, finite s /\ (forall x :e A, x :e s -> exists q1 q2 :e omega, f x + n * q1 = g x + n * q2) -> exists q1 q2 :e omega, finsum s f + n * q1 = finsum s g + n * q2.
Admitted.

// HOL Light: iterate.ml:1923 / CARD_UNIONS_IMAGE   (hash md5:5d430c768ca9536456e51355c5591b70)
// not bridged: 
Theorem CARD_UNIONS_IMAGE : forall A K:set, A <> Empty -> K <> Empty -> forall f :e Power A :^: K, forall s c= K, finite s /\ ((forall t :e K, t :e s -> finite (f t)) /\ (forall t u :e K, t :e s /\ (u :e s /\ ~ t = u) -> f t :/\: f u = Empty)) -> finite_cardinality (Union {f x | x :e s}) = finsum s (fun i:set => finite_cardinality (f i)).
Admitted.

// HOL Light: iterate.ml:1939 / CARD_UNIONS   (hash md5:b4da9d18c124538b8ac870ad0cddaa2a)
// not bridged: 
Theorem CARD_UNIONS : forall A:set, A <> Empty -> forall s c= Power A, finite s /\ ((forall t c= A, t :e s -> finite t) /\ (forall t u c= A, t :e s /\ (u :e s /\ ~ t = u) -> t :/\: u = Empty)) -> finite_cardinality (Union s) = finsum s (fun x:set => finite_cardinality x).
Admitted.

// HOL Light: iterate.ml:1984 / sum   (hash md5:0d4e918739420e483788a227f7a5b020)
// not bridged: 
Theorem sum : forall A:set, A <> Empty -> forall x c= A, forall x0:set -> set, (forall x1 :e A, x0 x1 :e R) -> finsum x x0 = iterate_op R (fun a:set => fun b:set => a + b) x x0.
Admitted.

