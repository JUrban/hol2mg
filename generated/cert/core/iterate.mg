Theorem NSUM_REFLECT : forall x:set -> set, (forall x :e omega, x x :e omega) -> forall m n :e omega, finsum {i :e omega | m <= i /\ i <= n} x = if n < m then 0 else finsum {i :e omega | 0 <= i /\ i <= minus_nat n m} (fun i:set => x (minus_nat n i)).
