// HOL Light: iterate.ml:1445 / NSUM_SING   (hash md5:ac2360492e0196f4108855de3f6639f9)
// not bridged: 
Theorem NSUM_SING : forall A:set, forall f:set -> set, (forall x :e A, f x :e omega) -> forall x :e A, finsum {x} f = f x.
Admitted.

// HOL Light: iterate.ml:1449 / NSUM_DELTA   (hash md5:aef13638e5823a68dd8d88505629ddca)
// not bridged: 
Theorem NSUM_DELTA : forall A:set, forall b :e omega, forall s c= A, forall a :e A, finsum s (fun x:set => if x = a then b else 0) = if a :e s then b else 0.
Admitted.

// HOL Light: iterate.ml:1454 / NSUM_SWAP   (hash md5:bbf82ad215a6fe69a4be7b58478ff5fb)
// not bridged: 
Theorem NSUM_SWAP : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set -> set, (forall x :e A, forall y :e B, f x y :e omega) -> forall s c= A, forall t c= B, finite s /\ finite t -> finsum s (fun i:set => finsum t (f i)) = finsum t (fun j:set => finsum s (fun i:set => f i j)).
Admitted.

// HOL Light: iterate.ml:1462 / NSUM_IMAGE   (hash md5:ef243858263d36ef360c0182220f4c57)
// not bridged: 
Theorem NSUM_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e B, g x :e omega) -> forall s c= A, (forall x y :e A, x :e s /\ (y :e s /\ f x = f y) -> x = y) -> finsum {f x | x :e s} g = finsum s (fun x:set => g (f x)).
Admitted.

