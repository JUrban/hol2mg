Theorem SUM_PAIR : forall f:set -> set, (forall x :e omega, f x :e R) -> forall m n :e omega, finsum {i :e omega | 2 * m <= i /\ i <= 2 * n + 1} f = finsum {i :e omega | m <= i /\ i <= n} (fun i:set => f (2 * i) + f (2 * i + 1)).
exact (SUM_PAIR_bridge hlt_SUM_PAIR).
Admitted.

