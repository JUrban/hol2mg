Theorem SUM_SUBSET_SIMPLE : forall A:set, A <> Empty -> forall u v c= A, forall f:set -> set, (forall x :e A, f x :e R) -> finite v /\ (u c= v /\ (forall x :e A, x :e v :\: u -> 0 <= f x)) -> finsum u f <= finsum v f.
