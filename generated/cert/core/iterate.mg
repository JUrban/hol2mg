Theorem SUM_OFFSET_0 : forall f:set -> set, (forall x :e omega, f x :e R) -> forall m n :e omega, m <= n -> finsum {i :e omega | m <= i /\ i <= n} f = finsum {i :e omega | 0 <= i /\ i <= minus_nat n m} (fun i:set => f (i + m)).
Admitted.

