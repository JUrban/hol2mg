Theorem CHOICE_UNPAIR_THM : forall A B:set, A <> Empty -> B <> Empty -> forall P:set -> set -> prop, choose_in (A :*: B) (fun x:set => P (x 0) (x 1)) = choose_in (A :*: B) (fun p:set => P (p 0) (p 1)).
exact (CHOICE_UNPAIR_THM_bridge hlt_CHOICE_UNPAIR_THM).
Admitted.

