Theorem REAL_COMPLETE : forall P:set -> prop, (exists x :e R, P x) /\ (exists M :e R, forall x :e R, P x -> x <= M) -> exists M :e R, (forall x :e R, P x -> x <= M) /\ forall M' :e R, (forall x :e R, P x -> x <= M') -> M <= M'.
