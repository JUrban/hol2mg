Theorem hl_IND_SUC_unfold : hl_IND_SUC = hl_select (omega :^: omega) (fun f :e omega :^: omega => if exists z :e omega, (forall x1 x2 :e omega, f x1 = f x2 <-> x1 = x2) /\ forall x :e omega, ~ f x = z then 1 else 0).
prove hl_select (omega :^: omega) (fun f :e omega :^: omega => if exists z :e omega, (forall x1 x2 :e omega, f x1 = f x2 <-> x1 = x2) /\ forall x :e omega, ~ f x = z then 1 else 0) = hl_select (omega :^: omega) (fun f :e omega :^: omega => if exists z :e omega, (forall x1 x2 :e omega, f x1 = f x2 <-> x1 = x2) /\ forall x :e omega, ~ f x = z then 1 else 0). exact (fun q H => H).
Qed.

Theorem hl_IND_0_unfold : hl_IND_0 = hl_select omega (fun z :e omega => if (forall x1 x2 :e omega, hl_IND_SUC x1 = hl_IND_SUC x2 <-> x1 = x2) /\ forall x :e omega, ~ hl_IND_SUC x = z then 1 else 0).
