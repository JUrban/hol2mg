Theorem REAL_POS_EQ_SQUARE : forall x :e R, 0 <= x <-> exists y :e R, y ^ 2 = x.
exact (REAL_POS_EQ_SQUARE_bridge hlt_REAL_POS_EQ_SQUARE).
Admitted.

