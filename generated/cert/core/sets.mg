// HOL Light: sets.ml:4838 / SUP_APPROACH   (hash md5:32183111dabd69ee6a7e3910e3fd2bc5)
// not bridged: 
Theorem SUP_APPROACH : forall s c= R, forall c :e R, ~ s = Empty /\ ((exists b :e R, forall x :e R, x :e s -> x <= b) /\ c < sup s) -> exists x :e R, x :e s /\ c < x.
Admitted.

// HOL Light: sets.ml:4849 / REAL_MAX_SUP   (hash md5:84d1c01e26b91a687b52852d378103a7)
// not bridged: 
Theorem REAL_MAX_SUP : forall x y :e R, (if x <= y then y else x) = sup {x,y}.
Admitted.

// HOL Light: sets.ml:4855 / inf   (hash md5:b6e4351d5c7f0c88c6789029373b4145)
