Theorem IMAGE_INTERS : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall s c= Power A, ~ s = Empty /\ (forall x y :e A, x :e Union s /\ (y :e Union s /\ f x = f y) -> x = y) -> {f x | x :e {x :e A | forall Y :e s, x :e Y}} = {x :e B | forall Y :e {{x0 :e B | x0 :e {f x0 | x0 :e x}} | x :e s}, x :e Y}.
Admitted.

// HOL Light: sets.ml:1124 / DIFF_INTERS   (hash md5:1b981d0416c085dfe5b79a1ed5963e59)
// not bridged: 
Theorem DIFF_INTERS : forall A:set, A <> Empty -> forall u c= A, forall s c= Power A, u :\: {x :e A | forall Y :e s, x :e Y} = Union {u :\: t | t :e Power A, t :e s}.
Admitted.

// HOL Light: sets.ml:1128 / INTERS_UNIONS   (hash md5:bcf1ee77aebb105cb94a64ab89650f78)
// not bridged: 
Theorem INTERS_UNIONS : forall A:set, forall s c= Power A, {x :e A | forall Y :e s, x :e Y} = A :\: Union {A :\: t | t :e Power A, t :e s}.
Admitted.

// HOL Light: sets.ml:1132 / UNIONS_INTERS   (hash md5:32f705243a2b8b95bf4a96857a23a8e3)
// not bridged: 
Theorem UNIONS_INTERS : forall A:set, A <> Empty -> forall s c= Power A, Union s = A :\: {x :e A | forall Y :e {A :\: t | t :e Power A, t :e s}, x :e Y}.
Admitted.

// HOL Light: sets.ml:1138 / UNIONS_DIFF   (hash md5:8211692ff749b519f90092160738d4b7)
// not bridged: 
Theorem UNIONS_DIFF : forall A:set, A <> Empty -> forall s c= Power A, forall t c= A, Union s :\: t = Union {x :\: t | x :e Power A, x :e s}.
Admitted.

// HOL Light: sets.ml:1142 / DIFF_UNIONS   (hash md5:b33b9d9272dfa5a4334061e6d3f37bce)
// not bridged: 
Theorem DIFF_UNIONS : forall A:set, forall u c= A, forall s c= Power A, u :\: Union s = u :/\: {x :e A | forall Y :e {u :\: t | t :e Power A, t :e s}, x :e Y}.
Admitted.

// HOL Light: sets.ml:1146 / DIFF_UNIONS_NONEMPTY   (hash md5:d45650d2375bf668fabb1e4eca1a34b8)
// not bridged: 
Theorem DIFF_UNIONS_NONEMPTY : forall A:set, forall u c= A, forall s c= Power A, ~ s = Empty -> u :\: Union s = {x :e A | forall Y :e {u :\: t | t :e Power A, t :e s}, x :e Y}.
Admitted.

// HOL Light: sets.ml:1150 / INTERS_OVER_UNIONS   (hash md5:d938b398ae983c87c5dc3d8bc9f6d29c)
// not bridged: 
Theorem INTERS_OVER_UNIONS : forall A B:set, A <> Empty -> B <> Empty -> forall f :e Power (Power B) :^: A, forall s c= A, {x :e B | forall Y :e {Union (f x) | x :e A, x :e s}, x :e Y} = Union {{x :e B | forall Y :e {g x | x :e A, x :e s}, x :e Y} | g :e Power B :^: A, forall x :e A, x :e s -> g x :e f x}.
Admitted.

// HOL Light: sets.ml:1160 / INTER_INTERS   (hash md5:ab8c4062cd2eb7a5514eb545251f7a4e)
// not bridged: 
Theorem INTER_INTERS : forall A:set, A <> Empty -> (forall f c= Power A, forall s c= A, s :/\: {x :e A | forall Y :e f, x :e Y} = if f = Empty then s else {x :e A | forall Y :e {s :/\: t | t :e Power A, t :e f}, x :e Y}) /\ forall f c= Power A, forall s c= A, {x :e A | forall Y :e f, x :e Y} :/\: s = if f = Empty then s else {x :e A | forall Y :e {t :/\: s | t :e Power A, t :e f}, x :e Y}.
Admitted.

// HOL Light: sets.ml:1171 / UNIONS_OVER_INTERS   (hash md5:d2f3cf119ce82229bdad4cfa17039121)
// not bridged: 
Theorem UNIONS_OVER_INTERS : forall A B:set, A <> Empty -> B <> Empty -> forall f :e Power (Power B) :^: A, forall s c= A, Union {{x0 :e B | forall Y :e f x, x0 :e Y} | x :e A, x :e s} = {x :e B | forall Y :e {Union {g x | x :e A, x :e s} | g :e Power B :^: A, forall x :e A, x :e s -> g x :e f x}, x :e Y}.
Admitted.

// HOL Light: sets.ml:1182 / UNIONS_EQ_INTERS   (hash md5:ebf6d0cf4e052aba1a3c81c9fe98b0c4)
// not bridged: 
Theorem UNIONS_EQ_INTERS : forall A:set, A <> Empty -> forall f c= Power A, Union f = {x :e A | forall Y :e f, x :e Y} <-> exists s c= A, f = {s}.
Admitted.

// HOL Light: sets.ml:1188 / EXISTS_UNIQUE_UNIONS_INTERS   (hash md5:46af7a769cd97265067d44e0ec6c13f5)
// not bridged: 
Theorem EXISTS_UNIQUE_UNIONS_INTERS : forall A:set, A <> Empty -> forall P:set -> prop, (exists s c= A, P s /\ forall y c= A, P y -> y = s) <-> Union {s :e Power A | P s} = {x :e A | forall Y :e {s :e Power A | P s}, x :e Y}.
Admitted.

