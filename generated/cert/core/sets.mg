Theorem FORALL_FINITE_SUBSET_IMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall P:set -> prop, forall f:set -> set, (forall x :e A, f x :e B) -> forall s c= A, (forall t c= B, finite t /\ t c= {f x | x :e s} -> P t) <-> forall t c= A, finite t /\ t c= s -> P {f x | x :e t}.
exact (FORALL_FINITE_SUBSET_IMAGE_bridge hlt_FORALL_FINITE_SUBSET_IMAGE).
Admitted.

