Theorem SUBSET_CROSS : forall A B:set, forall s c= A, forall t c= B, forall s' c= A, forall t' c= B, s :*: t c= s' :*: t' <-> s = Empty \/ (t = Empty \/ s c= s' /\ t c= t').
exact (SUBSET_CROSS_bridge hlt_SUBSET_CROSS).
Admitted.

