Theorem CROSS_UNION : forall A B:set, (forall s c= A, forall t u c= B, s :*: t :\/: u = (s :*: t) :\/: (s :*: u)) /\ forall s t c= A, forall u c= B, s :\/: t :*: u = (s :*: u) :\/: (t :*: u).
