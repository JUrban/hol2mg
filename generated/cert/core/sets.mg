// HOL Light: sets.ml:1019 / IMAGE_CONST   (hash md5:5bd033ca0cefa6e81dcee950bc92e648)
// not bridged: 
Theorem IMAGE_CONST : forall A B:set, forall s c= A, forall c :e B, {c | x :e s} = if s = Empty then Empty else {c}.
Admitted.

