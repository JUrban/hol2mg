// HOL Light: sets.ml:2156 / HAS_SIZE_UNIONS   (hash md5:54b9e9d907c386ddc13af3e1c6528b64)
// not bridged: 
Theorem HAS_SIZE_UNIONS : forall A B:set, A <> Empty -> B <> Empty -> forall s c= A, forall t :e Power B :^: A, forall m n :e omega, equip s m /\ ((forall x :e A, x :e s -> equip (t x) n) /\ (forall x y :e A, x :e s /\ (y :e s /\ ~ x = y) -> t x :/\: t y = Empty)) -> equip (Union {t x | x :e A, x :e s}) (m * n).
Admitted.

