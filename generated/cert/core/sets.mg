Theorem PAIRWISE_IMAGE : forall A B:set, B <> Empty -> forall s c= A, forall r:set -> set -> prop, forall f:set -> set, (forall x :e A, f x :e B) -> ((forall x y :e {f x | x :e s}, x <> y -> r x y) <-> forall x y :e s, x <> y -> ~ f x = f y -> r (f x) (f y)).
Admitted.

