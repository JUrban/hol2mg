Theorem SURJECTIVE_PREIMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> ((forall k:set -> prop, exists t c= B, forall x :e A, x :e {x0 :e A | f x0 :e t} <-> k x) <-> forall x y :e A, f x = f y -> x = y).
