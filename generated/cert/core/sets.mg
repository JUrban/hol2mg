Theorem CROSS_EQ : forall A B:set, forall s s' c= A, forall t t' c= B, s :*: t = s' :*: t' <-> (s = Empty \/ t = Empty) /\ (s' = Empty \/ t' = Empty) \/ s = s' /\ t = t'.
exact (CROSS_EQ_bridge hlt_CROSS_EQ).
Admitted.

// HOL Light: sets.ml:2836 / IMAGE_FST_CROSS   (hash md5:ff17513908d72f5496747e8878a74074)
// not bridged: 
Theorem IMAGE_FST_CROSS : forall A B:set, A <> Empty -> forall s c= A, forall t c= B, {x 0 | x :e s :*: t} = if t = Empty then Empty else s.
Admitted.

// HOL Light: sets.ml:2844 / IMAGE_SND_CROSS   (hash md5:3ff9aa130550c3e8fdd039a71a207439)
// not bridged: 
Theorem IMAGE_SND_CROSS : forall A B:set, B <> Empty -> forall s c= A, forall t c= B, {x 1 | x :e s :*: t} = if s = Empty then Empty else t.
Admitted.

// HOL Light: sets.ml:2852 / IMAGE_PAIRED_CROSS   (hash md5:eb8ac6ae7e9e25f1d1b7df3311c1479e)
// not bridged: 
Theorem IMAGE_PAIRED_CROSS : forall A B C D:set, B <> Empty -> D <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e C, g x :e D) -> forall s c= A, forall t c= C, {(f (p 0),g (p 1)) | p :e s :*: t} = {f x | x :e s} :*: {g x | x :e t}.
Admitted.

