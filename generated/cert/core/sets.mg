// HOL Light: sets.ml:1992 / CARD   (hash md5:cc7fbff62e27fc719e56bd33ba6af05a)
// not bridged: 
Theorem CARD : forall A:set, A <> Empty -> forall s c= A, finite_cardinality s = set_foldr (fun x:set => fun n:set => ordsucc n) s 0.
Admitted.

// HOL Light: sets.ml:1995 / CARD_CLAUSES   (hash md5:b98042a9307e6eb5805ab458d8192980)
// not bridged: 
Theorem CARD_CLAUSES : forall A:set, finite_cardinality Empty = 0 /\ forall x :e A, forall s c= A, finite s -> finite_cardinality (SetAdjoin s x) = if x :e s then finite_cardinality s else ordsucc (finite_cardinality s).
Admitted.

// HOL Light: sets.ml:2003 / CARD_UNION   (hash md5:dec93797888a7880b4682d0323169b96)
// not bridged: 
Theorem CARD_UNION : forall A:set, A <> Empty -> forall s t c= A, finite s /\ (finite t /\ s :/\: t = Empty) -> finite_cardinality (s :\/: t) = finite_cardinality s + finite_cardinality t.
Admitted.

// HOL Light: sets.ml:2029 / CARD_DELETE   (hash md5:5d90e52e98cf466fb041e9213dda453a)
// not bridged: 
Theorem CARD_DELETE : forall A:set, forall x :e A, forall s c= A, finite s -> finite_cardinality (s :\: {x}) = if x :e s then minus_nat (finite_cardinality s) 1 else finite_cardinality s.
Admitted.

// HOL Light: sets.ml:2039 / CARD_UNION_EQ   (hash md5:f11091f2efcd011c5160b24c75d16853)
// not bridged: 
Theorem CARD_UNION_EQ : forall A:set, A <> Empty -> forall s t u c= A, finite u /\ (s :/\: t = Empty /\ s :\/: t = u) -> finite_cardinality s + finite_cardinality t = finite_cardinality u.
Admitted.

// HOL Light: sets.ml:2045 / CARD_DIFF   (hash md5:e21ff818fc024a6fec3f64a99e1466c0)
// not bridged: 
Theorem CARD_DIFF : forall A:set, A <> Empty -> forall s t c= A, finite s /\ t c= s -> finite_cardinality (s :\: t) = minus_nat (finite_cardinality s) (finite_cardinality t).
Admitted.

