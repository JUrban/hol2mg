Theorem DISJOINT_CROSS : forall A B:set, forall s c= A, forall t c= B, forall s' c= A, forall t' c= B, (s :*: t) :/\: (s' :*: t') = Empty <-> s :/\: s' = Empty \/ t :/\: t' = Empty.
exact (DISJOINT_CROSS_bridge hlt_DISJOINT_CROSS).
