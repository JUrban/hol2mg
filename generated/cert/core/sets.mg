Theorem CROSS_MONO : forall A B:set, forall s c= A, forall t c= B, forall s' c= A, forall t' c= B, s c= s' /\ t c= t' -> s :*: t c= s' :*: t'.
exact (CROSS_MONO_bridge hlt_CROSS_MONO).
Admitted.

