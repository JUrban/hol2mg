Theorem INJECTIVE_PREIMAGE : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> ((forall t t' c= B, {x :e A | f x :e t} = {x :e A | f x :e t'} -> t = t') <-> {f x | x :e A} = B).
