Theorem EXISTS_SUBSET_UNION : forall A:set, A <> Empty -> forall P:set -> prop, forall t u c= A, (exists s c= A, s c= t :\/: u /\ P s) <-> exists t' u' c= A, t' c= t /\ (u' c= u /\ P (t' :\/: u')).
exact (EXISTS_SUBSET_UNION_bridge hlt_EXISTS_SUBSET_UNION).
Admitted.

