Theorem ISUM_GROUP : forall A B:set, A <> Empty -> B <> Empty -> forall f:set -> set, (forall x :e A, f x :e B) -> forall g:set -> set, (forall x :e A, g x :e int) -> forall s c= A, forall t c= B, finite s /\ {f x | x :e s} c= t -> finsum t (fun y:set => finsum {x :e A | x :e s /\ f x = y} g) = finsum s g.
exact (ISUM_GROUP_bridge hlt_ISUM_GROUP).
Admitted.

