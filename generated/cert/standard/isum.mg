Theorem ISUM_CASES : forall A:set, A <> Empty -> forall s c= A, forall P:set -> prop, forall f:set -> set, (forall x :e A, f x :e int) -> forall g:set -> set, (forall x :e A, g x :e int) -> finite s -> finsum s (fun x:set => if P x then f x else g x) = finsum {x :e A | x :e s /\ P x} f + finsum {x :e A | x :e s /\ ~ P x} g.
exact (ISUM_CASES_bridge hlt_ISUM_CASES).
Admitted.

