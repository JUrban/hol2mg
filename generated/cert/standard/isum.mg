Theorem ISUM_PARTIAL_SUC : forall f:set -> set, (forall x :e omega, f x :e int) -> forall g:set -> set, (forall x :e omega, g x :e int) -> forall m n :e omega, finsum {i :e omega | m <= i /\ i <= n} (fun k:set => f k * (g (k + 1) + - g k)) = if m <= n then (f (n + 1) * g (n + 1) + - f m * g m) + - finsum {i :e omega | m <= i /\ i <= n} (fun k:set => g (k + 1) * (f (k + 1) + - f k)) else 0.
exact (ISUM_PARTIAL_SUC_bridge hlt_ISUM_PARTIAL_SUC).
Admitted.

