Theorem ISUM_ISUM_RESTRICT : forall A B:set, A <> Empty -> B <> Empty -> forall R0:set -> set -> prop, forall f:set -> set -> set, (forall x :e A, forall y :e B, f x y :e int) -> forall s c= A, forall t c= B, finite s /\ finite t -> finsum s (fun x:set => finsum {y :e B | y :e t /\ R0 x y} (f x)) = finsum t (fun y:set => finsum {x :e A | x :e s /\ R0 x y} (fun x:set => f x y)).
exact (ISUM_ISUM_RESTRICT_bridge hlt_ISUM_ISUM_RESTRICT).
