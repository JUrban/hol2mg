Theorem ARITH_EXP : (forall m n :e omega, m ^ n = m ^ n) /\ (0 ^ 0 = 1 /\ ((forall m :e omega, (2 * m) ^ 0 = 1) /\ ((forall m :e omega, (2 * m + 1) ^ 0 = 1) /\ ((forall n :e omega, 0 ^ (2 * n) = 0 ^ n * 0 ^ n) /\ ((forall m n :e omega, (2 * m) ^ (2 * n) = (2 * m) ^ n * (2 * m) ^ n) /\ ((forall m n :e omega, (2 * m + 1) ^ (2 * n) = (2 * m + 1) ^ n * (2 * m + 1) ^ n) /\ ((forall n :e omega, 0 ^ (2 * n + 1) = 0) /\ ((forall m n :e omega, (2 * m) ^ (2 * n + 1) = (2 * m) * (2 * m) ^ n * (2 * m) ^ n) /\ forall m n :e omega, (2 * m + 1) ^ (2 * n + 1) = (2 * m + 1) * (2 * m + 1) ^ n * (2 * m + 1) ^ n)))))))).
exact (ARITH_EXP_bridge hlt_ARITH_EXP).
Admitted.

