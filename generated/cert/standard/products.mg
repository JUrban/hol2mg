Theorem NPRODUCT_PAIR : forall f:set -> set, (forall x :e omega, f x :e omega) -> forall m n :e omega, finprod {i :e omega | 2 * m <= i /\ i <= 2 * n + 1} f = finprod {i :e omega | m <= i /\ i <= n} (fun i:set => f (2 * i) * f (2 * i + 1)).
exact (NPRODUCT_PAIR_bridge hlt_NPRODUCT_PAIR).
Admitted.

