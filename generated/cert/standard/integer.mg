Theorem INT_DIVIDES_FACT_PRIME : forall p :e int, 1 < abs_SNo p /\ (forall x :e int, divides_int x p -> abs_SNo x = 1 \/ abs_SNo x = abs_SNo p) -> forall n :e omega, divides_int p (factorial n) <-> abs_SNo p <= n.
