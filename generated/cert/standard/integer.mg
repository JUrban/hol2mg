// not bridged: 
Theorem INT_PRIME_IMP_NZ : forall p :e int, 1 < abs_SNo p /\ (forall x :e int, divides_int x p -> abs_SNo x = 1 \/ abs_SNo x = abs_SNo p) -> ~ p = 0.
Admitted.

