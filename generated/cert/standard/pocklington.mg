Theorem CONG_SUB_CASES : forall x y n :e omega, (exists q1 q2 :e omega, x + n * q1 = y + n * q2) <-> (x <= y -> (exists q1 q2 :e omega, minus_nat y x + n * q1 = 0 + n * q2)) /\ (~ x <= y -> exists q1 q2 :e omega, minus_nat x y + n * q1 = 0 + n * q2).
exact (CONG_SUB_CASES_bridge hlt_CONG_SUB_CASES).
Admitted.

