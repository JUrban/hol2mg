// HOL Light: Library/prime.ml:1241 / index_def   (hash md5:6bd37732135c5f62978cb78e7e809cbc)
// not bridged: 
Theorem index_def : forall p n :e omega, prime_index p n = if p <= 1 \/ n = 0 then 0 else finite_cardinality {j :e omega | 1 <= j /\ divides_nat (p ^ j) n}.
Admitted.

// HOL Light: Library/prime.ml:1245 / INDEX_0   (hash md5:8458285aff94b6e0856e5107e77c3670)
// not bridged: 
Theorem INDEX_0 : forall p :e omega, prime_index p 0 = 0.
Admitted.

// HOL Light: Library/prime.ml:1249 / PRIMEPOW_DIVIDES_INDEX   (hash md5:b2f1fed15cecc4d94b26449a07b55b8b)
// not bridged: 
Theorem PRIMEPOW_DIVIDES_INDEX : forall n p k :e omega, divides_nat (p ^ k) n <-> n = 0 \/ (p = 1 \/ k <= prime_index p n).
Admitted.

// HOL Light: Library/prime.ml:1268 / LE_INDEX   (hash md5:8c7b7c31c978f70110be3af719c88180)
// not bridged: 
Theorem LE_INDEX : forall n p k :e omega, k <= prime_index p n <-> (n = 0 \/ p = 1 -> k = 0) /\ divides_nat (p ^ k) n.
Admitted.

