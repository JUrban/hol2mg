Theorem hl_set_of_list_in : forall A:set, A <> Empty -> hl_set_of_list A :e 2 :^: A :^: finseq A.
exact hl_set_of_list_in_lit.
Qed.

Theorem hl_set_of_list_spec : forall A:set, A <> Empty -> (exists g :e 2 :^: A :^: finseq A, g (hl_NIL A) = hl_EMPTY A /\ forall h :e A, forall t :e finseq A, g (hl_CONS A h t) = hl_INSERT A h (g t)) -> hl_set_of_list A (hl_NIL A) = hl_EMPTY A /\ (forall h :e A, forall t :e finseq A, hl_set_of_list A (hl_CONS A h t) = hl_INSERT A h (hl_set_of_list A t)) /\ hl_set_of_list A :e 2 :^: A :^: finseq A.
