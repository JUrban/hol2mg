Theorem CARD_ADD_SYMDIFF_INTER : forall A:set, A <> Empty -> forall s t c= A, finite s /\ finite t -> finite_cardinality s + finite_cardinality t = finite_cardinality ((s :\: t) :\/: (t :\: s)) + 2 * finite_cardinality (s :/\: t).
