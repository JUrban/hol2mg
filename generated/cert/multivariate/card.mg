Theorem CARD_EQ_FUNSPACE : forall A B:set, A <> Empty -> B <> Empty -> forall s c= A, forall t c= B, forall k:set -> set, (forall x :e A, k x :e B) -> equip {f :e B :^: A | {f x | x :e s} c= t /\ {x :e A | ~ f x = k x} c= s} {f :e B :^: A | (forall x :e s, f x :e t) /\ forall x :e A, ~ x :e s -> f x = choose_in B (fun y:set => False)}.
Admitted.

// HOL Light: Library/card.ml:3184 / CARTESIAN_PRODUCT_CONST   (hash md5:b98a12fe1c17316fab9cd123880b44f3)
// not bridged: 
Theorem CARTESIAN_PRODUCT_CONST : forall A B:set, A <> Empty -> B <> Empty -> forall s c= A, forall t c= B, {f :e A :^: B | (forall i :e t, f i :e {x0 :e A | x0 :e s}) /\ forall i :e B, ~ i :e t -> f i = choose_in A (fun y:set => False)} = {f :e A :^: B | (forall x :e t, f x :e s) /\ forall x :e B, ~ x :e t -> f x = choose_in A (fun y:set => False)}.
Admitted.

