Theorem EQ_C_BIJECTIONS_SUBSETS_LT : forall A B:set, A <> Empty -> B <> Empty -> forall s s' c= A, forall t t' c= B, s' c= s /\ (t' c= t /\ (infinite s -> atleastp s' s /\ ~ equip s' s)) -> (equip s t /\ equip s' t' <-> exists f:set -> set, (forall x :e A, f x :e B) /\ exists g:set -> set, (forall x :e B, g x :e A) /\ ((forall x :e A, x :e s -> f x :e t /\ g (f x) = x) /\ ((forall y :e B, y :e t -> g y :e s /\ f (g y) = y) /\ ({f x | x :e s'} = t' /\ {g x | x :e t'} = s')))).
exact (EQ_C_BIJECTIONS_SUBSETS_LT_bridge hlt_EQ_C_BIJECTIONS_SUBSETS_LT).
