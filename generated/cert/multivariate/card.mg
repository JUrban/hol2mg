Theorem FINITE_CARTESIAN_PRODUCT : forall A K:set, A <> Empty -> K <> Empty -> forall s :e Power A :^: K, forall k c= K, finite {f :e A :^: K | (forall i :e k, f i :e s i) /\ forall i :e K, ~ i :e k -> f i = choose_in A (fun y:set => False)} <-> {f :e A :^: K | (forall i :e k, f i :e s i) /\ forall i :e K, ~ i :e k -> f i = choose_in A (fun y:set => False)} = Empty \/ finite {i :e K | i :e k /\ ~ exists a :e A, s i c= {a}} /\ forall i :e K, i :e k -> finite (s i).
exact (FINITE_CARTESIAN_PRODUCT_bridge hlt_FINITE_CARTESIAN_PRODUCT).
Admitted.

