Theorem CARD_EQ_RESTRICTED_FUNSPACE_INFINITE : forall A B:set, A <> Empty -> B <> Empty -> forall s c= A, forall t c= B, forall k:set -> set, (forall x :e A, k x :e B) -> infinite s /\ (~ (exists a :e B, t c= {a}) /\ {k x | x :e s} c= t) -> equip {f :e B :^: A | {f x | x :e s} c= t /\ ({x :e A | ~ f x = k x} c= s /\ finite {x :e A | ~ f x = k x})} (s :*: t).
