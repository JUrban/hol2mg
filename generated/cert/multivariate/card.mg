Theorem COUNTABLE_RESTRICTED_FUNSPACE : forall A B:set, A <> Empty -> B <> Empty -> forall s c= A, forall t c= B, forall k:set -> set, (forall x :e A, k x :e B) -> countable s /\ countable t -> countable {f :e B :^: A | {f x | x :e s} c= t /\ ({x :e A | ~ f x = k x} c= s /\ finite {x :e A | ~ f x = k x})}.
exact (COUNTABLE_RESTRICTED_FUNSPACE_bridge hlt_COUNTABLE_RESTRICTED_FUNSPACE).
Admitted.

