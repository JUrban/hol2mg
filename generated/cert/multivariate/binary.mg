Theorem BINARYSUM_DIV : forall k :e omega, forall s c= omega, finite s -> div_nat (finsum s (fun j:set => 2 ^ j)) (2 ^ k) = finsum s (fun j:set => if j < k then 0 else 2 ^ minus_nat j k).
exact (BINARYSUM_DIV_bridge hlt_BINARYSUM_DIV).
Admitted.

