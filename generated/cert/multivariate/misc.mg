// HOL Light:  / FROM_INTER_NUMSEG_GEN   (hash md5:1aeb6524a0f578414b334f234e462152)
// not bridged: 
Theorem FROM_INTER_NUMSEG_GEN : forall k m n :e omega, from k :/\: {i :e omega | m <= i /\ i <= n} = if m < k then {i :e omega | k <= i /\ i <= n} else {i :e omega | m <= i /\ i <= n}.
