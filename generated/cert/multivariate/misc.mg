Theorem SUSLIN_INTERS : forall A:set, A <> Empty -> forall C f c= Power A, countable f /\ (~ f = Empty /\ (forall s c= A, s :e f -> s :e suslin A C)) -> {x :e A | forall Y :e f, x :e Y} :e suslin A C.
Admitted.

// HOL Light:  / SUSLIN_MONO   (hash md5:8b5949a55064ed369cfdf17bd4178213)
// not bridged: 
Theorem SUSLIN_MONO : forall A:set, A <> Empty -> forall C D c= Power A, forall s c= A, (forall t c= A, t :e C -> t :e D) /\ s :e suslin A C -> s :e suslin A D.
Admitted.

// HOL Light:  / SUSLIN_REGULAR   (hash md5:9a44c644b4971a28237f380fa3dbad84)
// not bridged: 
Theorem SUSLIN_REGULAR : forall A:set, A <> Empty -> forall u c= Power A, (forall c c= Power A, finite c /\ (~ c = Empty /\ c c= u) -> {x :e A | forall Y :e c, x :e Y} :e u) -> suslin A u = {suslin_operation A (fun x:set => fun x0:set => x0 :e f x) | f :e Power A :^: finseq omega, (forall l :e finseq omega, ~ l = seq_nil -> f l :e u) /\ forall s:set -> set, (forall x :e omega, s x :e omega) -> forall m n :e omega, 1 <= m /\ m <= n -> f (seq_mk n s) c= f (seq_mk m s)}.
Admitted.

