Theorem COUNTABLE_LOCAL_MINIMA : forall f:set -> set, (forall x :e R, f x :e R) -> countable {f x | x :e R, exists d :e R, 0 < d /\ forall x' :e R, abs_SNo (x' + - x) < d -> f x <= f x'}.
exact (COUNTABLE_LOCAL_MINIMA_bridge hlt_COUNTABLE_LOCAL_MINIMA).
Admitted.

