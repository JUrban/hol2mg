Theorem STRICTLY_DECREASING_ALT : forall P:set -> prop, forall f:set -> set, (forall x :e R, f x :e R) -> ((forall x y :e R, P x /\ (P y /\ x < y) -> f y < f x) <-> (forall x y :e R, P x /\ (P y /\ x <= y) -> f y <= f x) /\ forall x y :e R, P x /\ (P y /\ f x = f y) -> x = y).
exact (STRICTLY_DECREASING_ALT_bridge hlt_STRICTLY_DECREASING_ALT).
Admitted.

